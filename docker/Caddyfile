# =============================================================================
# Snakk — Caddy Reverse Proxy Configuration
# =============================================================================
# Copy this file to /etc/caddy/Caddyfile on your server.
# Replace "snakk.example.com" with your actual domain.
# Caddy automatically provisions HTTPS certificates via Let's Encrypt.
#
# After editing:
#   sudo systemctl reload caddy

snakk.example.com {
    # Grafana monitoring (password protected)
    # Generate hash: caddy hash-password --plaintext yourpassword
    handle /grafana/* {
        basicauth {
            admin {$GRAFANA_BASICAUTH_HASH:JDJhJDE0JDlFMEdnNWxhLkNlMC9ZNjVMQmY3NU9KNEhPTUlRVTJJbDdDSE5hOGpFNnVSY0dNUUhL}
        }
        reverse_proxy localhost:3000
    }

    reverse_proxy localhost:17000

    # Security headers
    header {
        X-Content-Type-Options nosniff
        X-Frame-Options SAMEORIGIN
        Referrer-Policy strict-origin-when-cross-origin
        -Server
    }

    # Logging
    log {
        output file /var/log/caddy/snakk.log
        format json
    }
}
