{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "panels": [
    {
      "type": "row",
      "id": 100,
      "title": "Test run summary",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "Active VUs",
      "description": "Current concurrent virtual users emitted by k6.",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 1 },
      "id": 1,
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "thresholds" } } },
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "max(k6_vus)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "Total iterations",
      "description": "Sum of completed scenario iterations.",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 1 },
      "id": 2,
      "fieldConfig": { "defaults": { "unit": "short" } },
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(k6_iterations_total)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "Total HTTP requests",
      "description": "Sum of HTTP requests issued by k6 (all named endpoints).",
      "gridPos": { "h": 6, "w": 6, "x": 12, "y": 1 },
      "id": 3,
      "fieldConfig": { "defaults": { "unit": "short" } },
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(k6_http_reqs_total)",
          "refId": "A"
        }
      ]
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "Transport-level RST rate (gateway bug — informational)",
      "description": "Share of k6 requests that saw a TCP reset / status=0. The snakk gateway sends Connection: close + RST after every full response, so this stays near 100% until that's fixed. Use the Application failure rate panel for the real success signal.",
      "gridPos": { "h": 4, "w": 12, "x": 0, "y": 31 },
      "id": 11,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "color": { "mode": "thresholds" },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "blue", "value": null }
            ]
          }
        }
      },
      "options": { "legend": { "displayMode": "list", "placement": "bottom" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum(rate(k6_http_req_failed_occurred_total[$__rate_interval])) / sum(rate(k6_http_reqs_total[$__rate_interval]))",
          "legendFormat": "RST rate",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "App failures by status (Counter)",
      "description": "Count of checkOk() failures broken down by reported HTTP status. status=0 means the app body sentinel didn't match (often gateway RST swallowing the response — but only counts if `ok()` failed).",
      "gridPos": { "h": 4, "w": 12, "x": 12, "y": 31 },
      "id": 12,
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (status, name) (rate(k6_app_failures_total[$__rate_interval]))",
          "legendFormat": "{{name}} (status {{status}})",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "Application failure rate",
      "description": "Share of iterations where the response failed our app-level check (status mismatch OR body did not contain the expected sentinel). Driven by `lib/metrics.js#checkOk`. This is the real success signal — transport-level RSTs from the gateway bug don't count here.",
      "gridPos": { "h": 6, "w": 6, "x": 18, "y": 1 },
      "id": 4,
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              { "color": "green", "value": null },
              { "color": "yellow", "value": 0.05 },
              { "color": "red", "value": 0.10 }
            ]
          }
        }
      },
      "type": "stat",
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (sum(rate(k6_app_ok_occurred_total[1m])) / sum(rate(k6_app_ok_total[1m])))",
          "refId": "A"
        }
      ]
    },
    {
      "type": "row",
      "id": 101,
      "title": "Per-endpoint latency + throughput",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 7 },
      "collapsed": false
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "Request rate by named endpoint",
      "description": "k6 requests/sec, broken down by `name` tag (set in lib/endpoints.js).",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "id": 5,
      "fieldConfig": { "defaults": { "unit": "reqps", "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (name) (rate(k6_http_reqs_total[$__rate_interval]))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "p95 latency by endpoint",
      "description": "95th percentile request duration by `name` tag.",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "id": 6,
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (name, le) (rate(k6_http_req_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "{{name}} p95",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "Application failure rate by endpoint",
      "description": "App-level failure share per `name` tag. Driven by checkOk()'s `app_ok` Rate metric — captures real protocol/content failures, not the gateway RST bug. Sustained nonzero on any endpoint = investigate.",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 16 },
      "id": 7,
      "fieldConfig": { "defaults": { "unit": "percentunit", "color": { "mode": "palette-classic" } } },
      "options": { "legend": { "displayMode": "table", "placement": "right" } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "1 - (sum by (name) (rate(k6_app_ok_occurred_total[$__rate_interval])) / sum by (name) (rate(k6_app_ok_total[$__rate_interval])))",
          "legendFormat": "{{name}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "p99 latency (all endpoints)",
      "description": "99th percentile across the whole test. Useful tail-latency view.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 16 },
      "id": 8,
      "fieldConfig": { "defaults": { "unit": "ms", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(k6_http_req_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.95, sum by (le) (rate(k6_http_req_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p95",
          "refId": "B"
        },
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(k6_http_req_duration_milliseconds_bucket[$__rate_interval])))",
          "legendFormat": "p50",
          "refId": "C"
        }
      ],
      "type": "timeseries"
    },
    {
      "type": "row",
      "id": 102,
      "title": "Iteration metrics",
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "Iteration rate by scenario",
      "description": "Iterations/sec per scenario (`mixed.js` uses 4 sub-scenarios).",
      "gridPos": { "h": 7, "w": 12, "x": 0, "y": 24 },
      "id": 9,
      "fieldConfig": { "defaults": { "unit": "ops", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (scenario) (rate(k6_iterations_total[$__rate_interval]))",
          "legendFormat": "{{scenario}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    },
    {
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "title": "VUs over time",
      "description": "Concurrent virtual users by scenario. Confirms ramp/hold/drain shape.",
      "gridPos": { "h": 7, "w": 12, "x": 12, "y": 24 },
      "id": 10,
      "fieldConfig": { "defaults": { "unit": "short", "color": { "mode": "palette-classic" } } },
      "targets": [
        {
          "datasource": { "type": "prometheus", "uid": "prometheus" },
          "expr": "sum by (scenario) (k6_vus)",
          "legendFormat": "{{scenario}}",
          "refId": "A"
        }
      ],
      "type": "timeseries"
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "tags": ["snakk", "loadtest", "k6"],
  "templating": { "list": [] },
  "time": { "from": "now-30m", "to": "now" },
