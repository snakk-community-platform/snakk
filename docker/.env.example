# =============================================================================
# Snakk Docker Configuration
# =============================================================================
# Copy this file to .env and update the values before running:
#   cp .env.example .env
#   docker compose up -d

# REQUIRED: PostgreSQL password
# Used by both the postgres container and the snakk services.
# Choose a strong password — this is your database credential.
POSTGRES_PASSWORD=changeme

# Port to expose on the host (Gateway entry point)
# Caddy reverse proxy should point to this port.
SNAKK_PORT=17000

# OPTIONAL: Grafana admin password (only needed when using --profile monitoring)
GRAFANA_ADMIN_PASSWORD=changeme
