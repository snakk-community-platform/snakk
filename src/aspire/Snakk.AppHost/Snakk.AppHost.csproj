<Project Sdk="Microsoft.NET.Sdk">

  <Sdk Name="Aspire.AppHost.Sdk" Version="13.1.1" />

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <IsAspireHost>true</IsAspireHost>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.9" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.9" />
    <!-- Pin to patched version to override vulnerable transitive 2.5.192 from KubernetesClient (GHSA-hv8m-jj95-wg3x) -->
    <PackageReference Include="MessagePack" Version="2.5.302" />
    <PackageReference Include="MessagePack.Annotations" Version="2.5.302" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\services\Snakk.Api\Snakk.Api.csproj" />
    <ProjectReference Include="..\..\services\Snakk.Gateway\Snakk.Gateway.csproj" />
    <ProjectReference Include="..\..\services\Snakk.PublicApi\Snakk.PublicApi.csproj" />
    <ProjectReference Include="..\..\services\Snakk.Realtime\Snakk.Realtime.csproj" />
    <ProjectReference Include="..\..\services\Snakk.Worker\Snakk.Worker.csproj" />
    <ProjectReference Include="..\..\apps\Snakk.Setup\Snakk.Setup.csproj" />
    <ProjectReference Include="..\..\apps\Snakk.Web\Snakk.Web.csproj" />
    <ProjectReference Include="..\..\apps\Snakk.Auth\Snakk.Auth.csproj" />
    <ProjectReference Include="..\..\apps\Snakk.Admin\Snakk.Admin.csproj" />
  </ItemGroup>

</Project>
