@page
@model Snakk.Auth.Pages.ResetPasswordModel
@{
    ViewData["Title"] = "Reset Password";
}

<div class="min-h-screen flex flex-col lg:flex-row">
    <!-- Brand Panel -->
    <div class="auth-brand-panel lg:w-[45%] xl:w-[50%] flex items-center justify-center px-8 py-12 lg:py-0 shrink-0">
        <div class="auth-brand-content text-center lg:text-left">
            <div class="auth-brand-wordmark">snakk</div>
            <p class="auth-brand-tagline mt-3 mx-auto lg:mx-0">
                Where communities come together to discuss, share, and connect.
            </p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-panel flex-1 px-6 py-12 lg:py-0">
        <div class="auth-form-card p-8">
            @if (Model.TokenMissing)
            {
                <div class="text-center">
                    <h1 class="text-xl font-bold tracking-tight mb-3">Invalid reset link</h1>
                    <p class="text-base-content/60 text-sm mb-6">
                        This password reset link is missing or invalid.
                    </p>
                    <a href="/auth/forgot-password" class="auth-btn-primary inline-block">Request a new link</a>
                </div>
            }
            else
            {
                <h1 class="text-xl font-bold tracking-tight text-center mb-2">Set a new password</h1>
                <p class="text-center text-sm text-base-content/60 mb-8">
                    Your new password must be at least 8 characters and include uppercase, lowercase, a number, and a special character.
                </p>

                @if (!string.IsNullOrEmpty(Model.ErrorMessage))
                {
                    <div class="auth-alert-error mb-6">@Model.ErrorMessage
                        @if (Model.ErrorMessage.Contains("expired") || Model.ErrorMessage.Contains("invalid", StringComparison.OrdinalIgnoreCase))
                        {
                            <span> <a href="/auth/forgot-password" class="underline">Request a new link.</a></span>
                        }
                    </div>
                }

                <form method="post" class="space-y-4">
                    <input type="hidden" asp-for="Input.Token" />

                    <div>
                        <label class="auth-label" asp-for="Input.NewPassword">New password</label>
                        <input asp-for="Input.NewPassword" type="password" class="auth-input" placeholder="New password" autofocus />
                        <span asp-validation-for="Input.NewPassword" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <div>
                        <label class="auth-label" asp-for="Input.ConfirmPassword">Confirm new password</label>
                        <input asp-for="Input.ConfirmPassword" type="password" class="auth-input" placeholder="Confirm new password" />
                        <span asp-validation-for="Input.ConfirmPassword" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <button type="submit" class="auth-btn-primary">Reset password</button>
                </form>

                <p class="text-center mt-6 text-sm text-base-content/50">
                    <a href="/auth/login" class="auth-link">Back to sign in</a>
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script>
    (function () {
        var form = document.querySelector('form');
        if (!form) return;
        form.addEventListener('submit', function (e) {
            if (e.defaultPrevented) return;
            var btn = form.querySelector('button[type="submit"]');
            if (!btn) return;
            btn.disabled = true;
            btn.textContent = 'Resetting…';
        });
    }());
    </script>
}
