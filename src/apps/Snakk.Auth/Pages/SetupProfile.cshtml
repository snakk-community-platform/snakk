@page "/setup-profile"
@model Snakk.Auth.Pages.SetupProfileModel
@{
    ViewData["Title"] = "Setup Your Profile";
}

<div class="min-h-screen flex flex-col lg:flex-row">
    <!-- Brand Panel -->
    <div class="auth-brand-panel lg:w-[45%] xl:w-[50%] flex items-center justify-center px-8 py-12 lg:py-0 shrink-0">
        <div class="auth-brand-content text-center lg:text-left">
            <div class="auth-brand-wordmark">snakk</div>
            <p class="auth-brand-tagline mt-3 mx-auto lg:mx-0">
                Almost there. Pick a name and you're in.
            </p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-panel flex-1 px-6 py-12 lg:py-0">
        <div class="auth-form-card p-8">
            <div class="text-center mb-8">
                <h1 class="text-xl font-bold tracking-tight">Set up your profile</h1>
                <p class="text-sm text-base-content/50 mt-2">Choose how you want to appear.</p>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert-error mb-6">@Model.ErrorMessage</div>
            }

            <form method="post" class="space-y-4">
                <div>
                    <label class="auth-label" asp-for="Input.DisplayName">Display Name</label>
                    <input asp-for="Input.DisplayName" class="auth-input" placeholder="Choose your display name" />
                    <span asp-validation-for="Input.DisplayName" class="text-error text-xs mt-1 block"></span>
                    <p class="text-xs text-base-content/40 mt-1.5">This is how others will see you. You can change it later.</p>
                </div>

                <div class="pt-2">
                    <div class="text-sm font-medium mb-2">Adult content</div>
                    <p class="text-xs text-base-content/50 mb-2">
                        Some communities and discussions are tagged 18+. Choose whether you want to see them. You can change this later in settings.
                    </p>
                    <div class="flex flex-col gap-2">
                        <label class="flex items-start gap-2 cursor-pointer text-sm">
                            <input type="radio" asp-for="Input.AllowAdultContent" value="true" class="auth-radio mt-0.5" />
                            <span>Allow adult content (I am 18 or older)</span>
                        </label>
                        <label class="flex items-start gap-2 cursor-pointer text-sm">
                            <input type="radio" asp-for="Input.AllowAdultContent" value="false" class="auth-radio mt-0.5" />
                            <span>Hide adult content</span>
                        </label>
                    </div>
                    <span asp-validation-for="Input.AllowAdultContent" class="text-error text-xs mt-1 block"></span>
                </div>

                <button type="submit" class="auth-btn-primary">
                    Continue
                </button>
            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
