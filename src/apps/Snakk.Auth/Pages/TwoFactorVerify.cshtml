@page
@model Snakk.Auth.Pages.TwoFactorVerifyModel
@{
    ViewData["Title"] = "Two-Factor Authentication";
}

<div class="min-h-screen flex flex-col lg:flex-row">
    <!-- Brand Panel -->
    <div class="auth-brand-panel lg:w-[45%] xl:w-[50%] flex items-center justify-center px-8 py-12 lg:py-0 shrink-0">
        <div class="auth-brand-content text-center lg:text-left">
            <div class="auth-brand-wordmark">snakk</div>
            <p class="auth-brand-tagline mt-3 mx-auto lg:mx-0">
                Where communities come together to discuss, share, and connect.
            </p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-panel flex-1 px-6 py-12 lg:py-0">
        <div class="auth-form-card p-8">
            <h1 class="text-xl font-bold tracking-tight text-center mb-2">Two-factor authentication</h1>
            <p class="text-sm text-base-content/60 text-center mb-8">
                Enter the 6-digit code from your authenticator app
            </p>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert-error mb-6">@Model.ErrorMessage</div>
            }

            <form method="post" id="totp-form" class="space-y-4">
                <input type="hidden" name="Email" value="@Model.Email" />
                <input type="hidden" name="ReturnUrl" value="@Model.ReturnUrl" />
                <input type="hidden" name="Provider" value="@Model.Provider" />
                <input type="hidden" asp-for="Input.Code" id="totp-code-hidden" />

                <div id="totp-digit-section">
                    <div class="flex gap-2 justify-center">
                        <input type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code"
                               class="totp-digit input text-center font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" autofocus />
                        <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                               class="totp-digit input text-center font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                        <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                               class="totp-digit input text-center font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                        <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                               class="totp-digit input text-center font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                        <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                               class="totp-digit input text-center font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                        <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                               class="totp-digit input text-center font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                    </div>
                </div>

                <div id="backup-code-section" style="display:none">
                    <input type="text" id="backup-code-input"
                           class="auth-input text-center text-lg tracking-widest"
                           placeholder="xxxx-xxxx"
                           autocomplete="off" />
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="Input.TrustDevice" type="checkbox" class="auth-checkbox w-4 h-4 rounded" />
                    <label asp-for="Input.TrustDevice" class="text-sm text-base-content/60 cursor-pointer select-none">
                        Don't ask again on this device for 30 days
                    </label>
                </div>

                <button type="submit" id="totp-submit-btn" class="auth-btn-primary">
                    Verify
                </button>
            </form>

            <p class="text-center mt-4">
                <button type="button" id="toggle-backup-btn" class="text-xs text-base-content/40 underline hover:text-base-content/60">
                    Use a backup code instead
                </button>
            </p>

            <p class="text-center mt-2 text-sm text-base-content/50">
                <a href="/auth/login?returnUrl=@Model.ReturnUrl" class="auth-link">Back to sign in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@(ViewContext.HttpContext.Items["csp-nonce"] as string)">
    (function () {
        'use strict';

        var autoSubmit = @(string.IsNullOrEmpty(Model.ErrorMessage) ? "true" : "false");

        var form    = document.getElementById('totp-form');
        var hidden  = document.getElementById('totp-code-hidden');
        var digits  = Array.from(document.querySelectorAll('.totp-digit'));
        var digitSection  = document.getElementById('totp-digit-section');
        var backupSection = document.getElementById('backup-code-section');
        var backupInput   = document.getElementById('backup-code-input');
        var toggleBtn     = document.getElementById('toggle-backup-btn');

        var inBackupMode = false;

        function getDigitValue() {
            return digits.map(function (d) { return d.value; }).join('');
        }

        function allFilled() {
            return digits.every(function (d) { return d.value.length === 1; });
        }

        function tryAutoSubmit() {
            if (autoSubmit && allFilled()) {
                autoSubmit = false;
                hidden.value = getDigitValue();
                form.submit();
            }
        }

        digits.forEach(function (input, i) {
            input.addEventListener('keydown', function (e) {
                if (e.key === 'Backspace' && !input.value && i > 0) {
                    digits[i - 1].value = '';
                    digits[i - 1].focus();
                    e.preventDefault();
                    return;
                }
                if (!/^\d$/.test(e.key) && !['Backspace', 'Delete', 'Tab', 'ArrowLeft', 'ArrowRight'].includes(e.key)) {
                    e.preventDefault();
                }
            });

            input.addEventListener('input', function () {
                input.value = input.value.replace(/\D/g, '').slice(0, 1);
                if (input.value && i < digits.length - 1) {
                    digits[i + 1].focus();
                }
                tryAutoSubmit();
            });

            input.addEventListener('paste', function (e) {
                e.preventDefault();
                var pasted = (e.clipboardData || window.clipboardData).getData('text').replace(/\D/g, '').slice(0, 6 - i);
                pasted.split('').forEach(function (d, j) {
                    if (digits[i + j]) digits[i + j].value = d;
                });
                var nextEmpty = digits.findIndex(function (d) { return !d.value; });
                (digits[nextEmpty === -1 ? digits.length - 1 : nextEmpty]).focus();
                tryAutoSubmit();
            });

            input.addEventListener('focus', function () { input.select(); });
        });

        form.addEventListener('submit', function (e) {
            if (inBackupMode) {
                hidden.value = backupInput.value.trim().replace(/\s/g, '');
            } else {
                hidden.value = getDigitValue();
            }
            if (!hidden.value) {
                e.preventDefault();
            }
        });

        toggleBtn.addEventListener('click', function () {
            inBackupMode = !inBackupMode;
            if (inBackupMode) {
                digitSection.style.display = 'none';
                backupSection.style.display = '';
                toggleBtn.textContent = 'Use authenticator code instead';
                backupInput.focus();
            } else {
                backupSection.style.display = 'none';
                digitSection.style.display = '';
                toggleBtn.textContent = 'Use a backup code instead';
                digits[0].focus();
            }
        });
    })();
    </script>
}
