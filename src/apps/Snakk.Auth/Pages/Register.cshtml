@page
@model Snakk.Auth.Pages.RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="w-full max-w-md mx-auto">
    <div class="bg-white rounded-2xl shadow-2xl p-10">
        <div class="text-center mb-8">
            <h1 class="text-5xl mb-2">🏔️ Snakk</h1>
            <p class="text-gray-500 text-lg">Create your account</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="bg-red-50 border border-red-200 text-red-800 px-4 py-3 rounded-lg mb-5 text-sm">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="mb-6">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="mb-5">
                <label asp-for="Input.DisplayName" class="block font-semibold text-gray-700 mb-2 text-sm">Display Name</label>
                <input asp-for="Input.DisplayName" class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg text-base focus:outline-none focus:border-snakk-purple transition-colors" />
                <span asp-validation-for="Input.DisplayName" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <div class="mb-5">
                <label asp-for="Input.Email" class="block font-semibold text-gray-700 mb-2 text-sm">Email</label>
                <input asp-for="Input.Email" type="email" class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg text-base focus:outline-none focus:border-snakk-purple transition-colors" />
                <span asp-validation-for="Input.Email" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <div class="mb-5">
                <label asp-for="Input.Password" class="block font-semibold text-gray-700 mb-2 text-sm">Password</label>
                <input asp-for="Input.Password" type="password" class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg text-base focus:outline-none focus:border-snakk-purple transition-colors" />
                <span asp-validation-for="Input.Password" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <div class="mb-5">
                <label asp-for="Input.ConfirmPassword" class="block font-semibold text-gray-700 mb-2 text-sm">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="w-full px-4 py-3 border-2 border-gray-200 rounded-lg text-base focus:outline-none focus:border-snakk-purple transition-colors" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-red-600 text-xs mt-1 block"></span>
            </div>

            <button type="submit" class="w-full bg-gradient-to-r from-snakk-purple to-snakk-purple-dark text-white font-semibold py-3 px-6 rounded-lg hover:-translate-y-0.5 hover:shadow-lg transition-all duration-200">
                Create Account
            </button>
        </form>

        <div class="flex items-center my-6 text-gray-400 text-sm">
            <div class="flex-1 h-px bg-gray-200"></div>
            <span class="px-4">OR</span>
            <div class="flex-1 h-px bg-gray-200"></div>
        </div>

        <div class="flex flex-col gap-3">
            <a href="/OAuth/Challenge?provider=Google&returnUrl=@Model.ReturnUrl" class="flex items-center justify-center gap-2 bg-white border-2 border-gray-200 text-gray-700 font-semibold py-3 px-6 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-colors">
                <span class="text-xl">🔵</span> Sign up with Google
            </a>
            <a href="/OAuth/Challenge?provider=GitHub&returnUrl=@Model.ReturnUrl" class="flex items-center justify-center gap-2 bg-white border-2 border-gray-200 text-gray-700 font-semibold py-3 px-6 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-colors">
                <span class="text-xl">⚫</span> Sign up with GitHub
            </a>
            <a href="/OAuth/Challenge?provider=Discord&returnUrl=@Model.ReturnUrl" class="flex items-center justify-center gap-2 bg-white border-2 border-gray-200 text-gray-700 font-semibold py-3 px-6 rounded-lg hover:border-gray-300 hover:bg-gray-50 transition-colors">
                <span class="text-xl">💜</span> Sign up with Discord
            </a>
        </div>

        <div class="text-center mt-6 text-gray-500 text-sm">
            Already have an account? <a href="/Login?returnUrl=@Model.ReturnUrl" class="text-snakk-purple font-semibold hover:underline">Sign in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
