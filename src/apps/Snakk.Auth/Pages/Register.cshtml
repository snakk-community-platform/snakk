@page
@model Snakk.Auth.Pages.RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="min-h-screen flex flex-col lg:flex-row">
    <!-- Brand Panel -->
    <div class="auth-brand-panel lg:w-[45%] xl:w-[50%] flex items-center justify-center px-8 py-12 lg:py-0 shrink-0">
        <div class="auth-brand-content text-center lg:text-left">
            <div class="auth-brand-wordmark">snakk</div>
            <p class="auth-brand-tagline mt-3 mx-auto lg:mx-0">
                Where communities come together to discuss, share, and connect.
            </p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-panel flex-1 px-6 py-12 lg:py-0">
        <div class="auth-form-card p-8">
            <h1 class="text-xl font-bold tracking-tight text-center mb-8">Create your account</h1>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert-error mb-6">@Model.ErrorMessage</div>
            }

            @if (Model.HasAnyOAuth)
            {
                <!-- OAuth -->
                <div class="flex flex-col gap-2.5">
                    @if (Model.HasGoogle)
                    {
                        <a href="/auth/oauth/Google/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            Sign up with Google
                        </a>
                    }
                    @if (Model.HasGitHub)
                    {
                        <a href="/auth/oauth/GitHub/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth">
                            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                            </svg>
                            Sign up with GitHub
                        </a>
                    }
                    @if (Model.HasDiscord)
                    {
                        <a href="/auth/oauth/Discord/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth">
                            <svg viewBox="0 0 24 24" fill="#5865F2" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                            </svg>
                            Sign up with Discord
                        </a>
                    }
                </div>

                <div class="auth-divider my-6">or continue with email</div>
            }

            <!-- Registration Form -->
            <form method="post" class="space-y-4">
                <input type="hidden" asp-for="ReturnUrl" />

                <div>
                    <label class="auth-label" asp-for="Input.DisplayName">Display Name</label>
                    <input asp-for="Input.DisplayName" class="auth-input" placeholder="How others will see you" />
                    <span asp-validation-for="Input.DisplayName" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="auth-label" asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" type="email" class="auth-input" placeholder="you@example.com" />
                    <span asp-validation-for="Input.Email" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="auth-label" asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" type="password" class="auth-input" placeholder="At least 8 characters" />
                    <span asp-validation-for="Input.Password" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="auth-label" asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="auth-input" placeholder="Repeat your password" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-error text-xs mt-1 block"></span>
                </div>

                @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
                {
                    <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-theme="auto"></div>
                }

                <button type="submit" class="auth-btn-primary">
                    Create Account
                </button>
            </form>

            <p class="text-center mt-6 text-sm text-base-content/50">
                Already have an account? <a href="/auth/login?returnUrl=@Model.ReturnUrl" class="auth-link">Sign in</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}
