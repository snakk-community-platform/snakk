@page
@model Snakk.Auth.Pages.RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="auth-container">
    <div class="auth-card">
        <div class="auth-header">
            <h1>Snakk</h1>
            <p>Create your account</p>
        </div>

        @if (!string.IsNullOrEmpty(Model.ErrorMessage))
        {
            <div class="alert alert-error">
                @Model.ErrorMessage
            </div>
        }

        <form method="post" class="auth-form">
            <input type="hidden" asp-for="ReturnUrl" />

            <div class="form-group">
                <label asp-for="Input.DisplayName">Display Name</label>
                <input asp-for="Input.DisplayName" class="form-control" />
                <span asp-validation-for="Input.DisplayName" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Email">Email</label>
                <input asp-for="Input.Email" type="email" class="form-control" />
                <span asp-validation-for="Input.Email" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.Password">Password</label>
                <input asp-for="Input.Password" type="password" class="form-control" />
                <span asp-validation-for="Input.Password" class="text-danger"></span>
            </div>

            <div class="form-group">
                <label asp-for="Input.ConfirmPassword">Confirm Password</label>
                <input asp-for="Input.ConfirmPassword" type="password" class="form-control" />
                <span asp-validation-for="Input.ConfirmPassword" class="text-danger"></span>
            </div>

            <button type="submit" class="btn btn-primary btn-block">
                Create Account
            </button>
        </form>

        <div class="auth-divider">
            <span>OR</span>
        </div>

        <div class="oauth-buttons">
            <a href="/OAuth/Challenge?provider=Google&returnUrl=@Model.ReturnUrl" class="btn btn-oauth">
                <span>G</span> Sign up with Google
            </a>
            <a href="/OAuth/Challenge?provider=GitHub&returnUrl=@Model.ReturnUrl" class="btn btn-oauth">
                <span>GH</span> Sign up with GitHub
            </a>
            <a href="/OAuth/Challenge?provider=Discord&returnUrl=@Model.ReturnUrl" class="btn btn-oauth">
                <span>DC</span> Sign up with Discord
            </a>
        </div>

        <div class="auth-footer">
            Already have an account? <a href="/Login?returnUrl=@Model.ReturnUrl">Sign in</a>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
