@page
@model Snakk.Auth.Pages.RegisterModel
@{
    ViewData["Title"] = "Create Account";
}

<div class="w-full max-w-xl mx-auto">
    <div class="card bg-base-100 border border-base-300 shadow-sm">
        <div class="card-body p-8">
            <div class="text-center mb-6">
                <h1 class="text-xl font-bold tracking-tight">Create your account</h1>
            </div>

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div role="alert" class="alert alert-error text-sm mb-4">
                    @Model.ErrorMessage
                </div>
            }

            <form method="post" class="space-y-4">
                <input type="hidden" asp-for="ReturnUrl" />

                <div>
                    <label class="label" asp-for="Input.DisplayName">Display Name</label>
                    <input asp-for="Input.DisplayName" class="input input-bordered w-full" />
                    <span asp-validation-for="Input.DisplayName" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="label" asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" type="email" class="input input-bordered w-full" />
                    <span asp-validation-for="Input.Email" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="label" asp-for="Input.Password">Password</label>
                    <input asp-for="Input.Password" type="password" class="input input-bordered w-full" />
                    <span asp-validation-for="Input.Password" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <label class="label" asp-for="Input.ConfirmPassword">Confirm Password</label>
                    <input asp-for="Input.ConfirmPassword" type="password" class="input input-bordered w-full" />
                    <span asp-validation-for="Input.ConfirmPassword" class="text-error text-xs mt-1 block"></span>
                </div>

                <button type="submit" class="btn btn-neutral w-full">
                    Create Account
                </button>
            </form>

            <div class="divider text-xs uppercase tracking-wide">or</div>

            <div class="flex flex-col gap-2">
                <a href="/auth/oauth/challenge?provider=Google&returnUrl=@Model.ReturnUrl" class="btn btn-outline btn-sm w-full">
                    Sign up with Google
                </a>
                <a href="/auth/oauth/challenge?provider=GitHub&returnUrl=@Model.ReturnUrl" class="btn btn-outline btn-sm w-full">
                    Sign up with GitHub
                </a>
                <a href="/auth/oauth/challenge?provider=Discord&returnUrl=@Model.ReturnUrl" class="btn btn-outline btn-sm w-full">
                    Sign up with Discord
                </a>
            </div>

            <div class="text-center mt-4 text-sm text-base-content/60">
                Already have an account? <a href="/auth/login?returnUrl=@Model.ReturnUrl" class="link link-hover font-medium">Sign in</a>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
