@page
@model Snakk.Auth.Pages.ForgotPasswordModel
@{
    ViewData["Title"] = "Forgot Password";
}

<div class="min-h-screen flex flex-col lg:flex-row">
    <!-- Brand Panel -->
    <div class="auth-brand-panel lg:w-[45%] xl:w-[50%] flex items-center justify-center px-8 py-12 lg:py-0 shrink-0">
        <div class="auth-brand-content text-center lg:text-left">
            <div class="auth-brand-wordmark">snakk</div>
            <p class="auth-brand-tagline mt-3 mx-auto lg:mx-0">
                Where communities come together to discuss, share, and connect.
            </p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-panel flex-1 px-6 py-12 lg:py-0">
        <div class="auth-form-card p-8">
            @if (Model.EmailSent)
            {
                <div class="text-center">
                    <div class="text-4xl mb-4">&#x2709;&#xFE0F;</div>
                    <h1 class="text-xl font-bold tracking-tight mb-3">Check your email</h1>
                    <p class="text-base-content/60 text-sm mb-6">
                        If an account with that address exists, we've sent a password reset link. It expires in 1 hour.
                    </p>
                    <p class="text-base-content/50 text-xs mb-6">
                        Didn't receive it? Check your spam folder, or
                        <button type="button" id="resend-toggle" class="auth-link">try again</button>.
                    </p>
                    <form id="resend-form" method="post" class="hidden text-left">
                        <div class="mb-4">
                            <label class="auth-label" for="Input_Email">Email</label>
                            <input asp-for="Input.Email" type="email" class="auth-input" placeholder="you@example.com" />
                        </div>
                        <button type="submit" class="auth-btn-primary">Resend reset link</button>
                    </form>
                    <a href="/auth/login" class="auth-link text-sm">Back to sign in</a>
                </div>
            }
            else
            {
                <h1 class="text-xl font-bold tracking-tight text-center mb-2">Forgot your password?</h1>
                <p class="text-center text-sm text-base-content/60 mb-8">
                    Enter your email and we'll send you a link to reset it.
                </p>

                <form method="post" class="space-y-4">
                    <div>
                        <label class="auth-label" asp-for="Input.Email">Email</label>
                        <input asp-for="Input.Email" type="email" class="auth-input" placeholder="you@example.com" autofocus />
                        <span asp-validation-for="Input.Email" class="text-error text-xs mt-1 block"></span>
                    </div>

                    <button type="submit" class="auth-btn-primary">Send reset link</button>
                </form>

                <p class="text-center mt-6 text-sm text-base-content/50">
                    Remembered it? <a href="/auth/login" class="auth-link">Sign in</a>
                </p>
            }
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    <script nonce="@(ViewContext.HttpContext.Items["csp-nonce"] as string)">
    (function () {
        var toggle = document.getElementById('resend-toggle');
        if (toggle) {
            toggle.addEventListener('click', function () {
                var resendForm = document.getElementById('resend-form');
                if (resendForm) resendForm.classList.toggle('hidden');
            });
        }
        var form = document.querySelector('form:not(#resend-form)');
        if (!form) return;
        form.addEventListener('submit', function (e) {
            if (e.defaultPrevented) return;
            var btn = form.querySelector('button[type="submit"]');
            if (!btn) return;
            btn.disabled = true;
            btn.textContent = 'Sending…';
        });
    }());
    </script>
}
