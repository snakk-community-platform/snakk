@page
@model Snakk.Auth.Pages.LoginModel
@{
    ViewData["Title"] = "Sign In";
}

<div class="min-h-screen flex flex-col lg:flex-row">
    <!-- Brand Panel -->
    <div class="auth-brand-panel lg:w-[45%] xl:w-[50%] flex items-center justify-center px-8 py-12 lg:py-0 shrink-0">
        <div class="auth-brand-content text-center lg:text-left">
            <div class="auth-brand-wordmark">snakk</div>
            <p class="auth-brand-tagline mt-3 mx-auto lg:mx-0">
                Where communities come together to discuss, share, and connect.
            </p>
        </div>
    </div>

    <!-- Form Panel -->
    <div class="auth-form-panel flex-1 px-6 py-12 lg:py-0">
        <div class="auth-form-card p-8">
            <h1 class="text-xl font-bold tracking-tight text-center mb-8">Sign in to Snakk</h1>

            @if (!string.IsNullOrEmpty(Model.SuccessMessage))
            {
                <div class="auth-alert-success mb-6">@Model.SuccessMessage</div>
            }

            @if (!string.IsNullOrEmpty(Model.ErrorMessage))
            {
                <div class="auth-alert-error mb-6">@Model.ErrorMessage</div>
            }

            @if (Model.HasAnyOAuth)
            {
                var oauthCount = (Model.HasGoogle ? 1 : 0) + (Model.HasGitHub ? 1 : 0) + (Model.HasDiscord ? 1 : 0)
                               + (Model.HasFacebook ? 1 : 0) + (Model.HasMicrosoft ? 1 : 0) + (Model.HasSteam ? 1 : 0);
                <!-- OAuth -->
                <div class="@(oauthCount > 2 ? "auth-oauth-grid" : "flex flex-col gap-2.5")">
                    @if (Model.HasGoogle)
                    {
                        <a href="/auth/oauth/Google/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth" data-provider="Google">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M22.56 12.25c0-.78-.07-1.53-.2-2.25H12v4.26h5.92a5.06 5.06 0 01-2.2 3.32v2.77h3.57c2.08-1.92 3.28-4.74 3.28-8.1z" fill="#4285F4"/>
                                <path d="M12 23c2.97 0 5.46-.98 7.28-2.66l-3.57-2.77c-.98.66-2.23 1.06-3.71 1.06-2.86 0-5.29-1.93-6.16-4.53H2.18v2.84C3.99 20.53 7.7 23 12 23z" fill="#34A853"/>
                                <path d="M5.84 14.09c-.22-.66-.35-1.36-.35-2.09s.13-1.43.35-2.09V7.07H2.18C1.43 8.55 1 10.22 1 12s.43 3.45 1.18 4.93l2.85-2.22.81-.62z" fill="#FBBC05"/>
                                <path d="M12 5.38c1.62 0 3.06.56 4.21 1.64l3.15-3.15C17.45 2.09 14.97 1 12 1 7.7 1 3.99 3.47 2.18 7.07l3.66 2.84c.87-2.6 3.3-4.53 6.16-4.53z" fill="#EA4335"/>
                            </svg>
                            <span class="oauth-text-full">Continue with Google</span><span class="oauth-text-short">Google</span>
                        </a>
                    }
                    @if (Model.HasGitHub)
                    {
                        <a href="/auth/oauth/GitHub/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth" data-provider="GitHub">
                            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path d="M12 2C6.477 2 2 6.484 2 12.017c0 4.425 2.865 8.18 6.839 9.504.5.092.682-.217.682-.483 0-.237-.008-.868-.013-1.703-2.782.605-3.369-1.343-3.369-1.343-.454-1.158-1.11-1.466-1.11-1.466-.908-.62.069-.608.069-.608 1.003.07 1.531 1.032 1.531 1.032.892 1.53 2.341 1.088 2.91.832.092-.647.35-1.088.636-1.338-2.22-.253-4.555-1.113-4.555-4.951 0-1.093.39-1.988 1.029-2.688-.103-.253-.446-1.272.098-2.65 0 0 .84-.27 2.75 1.026A9.564 9.564 0 0112 6.844a9.59 9.59 0 012.504.337c1.909-1.296 2.747-1.027 2.747-1.027.546 1.379.202 2.398.1 2.651.64.7 1.028 1.595 1.028 2.688 0 3.848-2.339 4.695-4.566 4.943.359.309.678.92.678 1.855 0 1.338-.012 2.419-.012 2.747 0 .268.18.58.688.482A10.019 10.019 0 0022 12.017C22 6.484 17.522 2 12 2z"/>
                            </svg>
                            <span class="oauth-text-full">Continue with GitHub</span><span class="oauth-text-short">GitHub</span>
                        </a>
                    }
                    @if (Model.HasDiscord)
                    {
                        <a href="/auth/oauth/Discord/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth" data-provider="Discord">
                            <svg viewBox="0 0 24 24" fill="#5865F2" xmlns="http://www.w3.org/2000/svg">
                                <path d="M20.317 4.37a19.791 19.791 0 00-4.885-1.515.074.074 0 00-.079.037c-.21.375-.444.864-.608 1.25a18.27 18.27 0 00-5.487 0 12.64 12.64 0 00-.617-1.25.077.077 0 00-.079-.037A19.736 19.736 0 003.677 4.37a.07.07 0 00-.032.027C.533 9.046-.32 13.58.099 18.057a.082.082 0 00.031.057 19.9 19.9 0 005.993 3.03.078.078 0 00.084-.028c.462-.63.874-1.295 1.226-1.994a.076.076 0 00-.041-.106 13.107 13.107 0 01-1.872-.892.077.077 0 01-.008-.128 10.2 10.2 0 00.372-.292.074.074 0 01.077-.01c3.928 1.793 8.18 1.793 12.062 0a.074.074 0 01.078.01c.12.098.246.198.373.292a.077.077 0 01-.006.127 12.299 12.299 0 01-1.873.892.077.077 0 00-.041.107c.36.698.772 1.362 1.225 1.993a.076.076 0 00.084.028 19.839 19.839 0 006.002-3.03.077.077 0 00.032-.054c.5-5.177-.838-9.674-3.549-13.66a.061.061 0 00-.031-.03zM8.02 15.33c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.956 2.418-2.157 2.418zm7.975 0c-1.183 0-2.157-1.085-2.157-2.419 0-1.333.956-2.419 2.157-2.419 1.21 0 2.176 1.096 2.157 2.42 0 1.333-.946 2.418-2.157 2.418z"/>
                            </svg>
                            <span class="oauth-text-full">Continue with Discord</span><span class="oauth-text-short">Discord</span>
                        </a>
                    }
                    @if (Model.HasFacebook)
                    {
                        <a href="/auth/oauth/Facebook/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth" data-provider="Facebook">
                            <svg viewBox="0 0 24 24" fill="#1877F2" xmlns="http://www.w3.org/2000/svg">
                                <path d="M24 12.073C24 5.406 18.627 0 12 0S0 5.406 0 12.073C0 18.1 4.388 23.094 10.125 24v-8.437H7.078v-3.49h3.047V9.41c0-3.025 1.792-4.697 4.533-4.697 1.312 0 2.686.236 2.686.236v2.97h-1.513c-1.491 0-1.956.93-1.956 1.886v2.267h3.328l-.532 3.49h-2.796V24C19.612 23.094 24 18.1 24 12.073z"/>
                            </svg>
                            <span class="oauth-text-full">Continue with Facebook</span><span class="oauth-text-short">Facebook</span>
                        </a>
                    }
                    @if (Model.HasMicrosoft)
                    {
                        <a href="/auth/oauth/Microsoft/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth" data-provider="Microsoft">
                            <svg viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg">
                                <path d="M0 0h11.5v11.5H0z" fill="#F25022"/>
                                <path d="M12.5 0H24v11.5H12.5z" fill="#7FBA00"/>
                                <path d="M0 12.5h11.5V24H0z" fill="#00A4EF"/>
                                <path d="M12.5 12.5H24V24H12.5z" fill="#FFB900"/>
                            </svg>
                            <span class="oauth-text-full">Continue with Microsoft</span><span class="oauth-text-short">Microsoft</span>
                        </a>
                    }
                    @if (Model.HasSteam)
                    {
                        <a href="/auth/oauth/Steam/challenge?returnUrl=@Model.ReturnUrl" class="auth-btn-oauth" data-provider="Steam">
                            <svg viewBox="0 0 24 24" fill="currentColor" xmlns="http://www.w3.org/2000/svg">
                                <path d="M11.979 0C5.678 0 .511 4.86.022 11.037l6.432 2.658c.545-.371 1.203-.59 1.912-.59.063 0 .125.004.188.006l2.861-4.142V8.91c0-2.495 2.028-4.524 4.524-4.524 2.494 0 4.524 2.031 4.524 4.527s-2.03 4.525-4.524 4.525h-.105l-4.076 2.911c0 .052.004.105.004.159 0 1.875-1.515 3.396-3.39 3.396-1.635 0-3.016-1.173-3.331-2.727L.436 15.27C1.862 20.307 6.486 24 11.979 24c6.627 0 11.999-5.373 11.999-12S18.605 0 11.979 0zM7.54 18.21l-1.473-.61c.262.543.714.999 1.314 1.25 1.297.539 2.793-.076 3.332-1.375.263-.63.264-1.319.005-1.949s-.75-1.121-1.377-1.383c-.624-.26-1.29-.249-1.878-.03l1.523.63c.956.4 1.409 1.5 1.009 2.455-.397.957-1.497 1.41-2.455 1.012H7.54zm11.415-9.303c0-1.662-1.353-3.015-3.015-3.015-1.665 0-3.015 1.353-3.015 3.015 0 1.665 1.35 3.015 3.015 3.015 1.663 0 3.015-1.35 3.015-3.015zm-5.273-.005c0-1.252 1.013-2.266 2.265-2.266 1.249 0 2.266 1.014 2.266 2.266 0 1.251-1.017 2.265-2.266 2.265-1.252 0-2.265-1.014-2.265-2.265z"/>
                            </svg>
                            <span class="oauth-text-full">Continue with Steam</span><span class="oauth-text-short">Steam</span>
                        </a>
                    }
                </div>
            }

            @if (Model.PasskeysEnabled)
            {
            <!-- Passkey button (hidden by JS if WebAuthn unavailable) -->
            <div class="flex flex-col gap-2.5 @(Model.HasAnyOAuth ? "mt-2.5" : "")">
                <button id="passkey-btn" type="button" class="auth-btn-oauth" data-provider="passkey" style="display:none">
                    <img src="/icons/passkey.svg" class="w-5 h-5 shrink-0" aria-hidden="true" alt="">
                    Sign in with passkey
                </button>
            </div>
            <p id="passkey-error" class="text-error text-sm text-center mt-2 hidden"></p>
            }

            <div class="auth-divider my-6">or continue with email</div>

            <!-- Email/Password Form -->
            <form method="post" class="space-y-4">
                <input type="hidden" asp-for="ReturnUrl" />
                <input type="hidden" asp-for="Input.ReturnUrl" />

                <div>
                    <label class="auth-label" asp-for="Input.Email">Email</label>
                    <input asp-for="Input.Email" type="email" class="auth-input" placeholder="you@example.com" />
                    <span asp-validation-for="Input.Email" class="text-error text-xs mt-1 block"></span>
                </div>

                <div>
                    <div class="flex items-center justify-between mb-1">
                        <label class="auth-label" asp-for="Input.Password">Password</label>
                        <a href="/auth/forgot-password" class="text-xs auth-link">Forgot password?</a>
                    </div>
                    <input asp-for="Input.Password" type="password" class="auth-input" placeholder="Your password" />
                    <span asp-validation-for="Input.Password" class="text-error text-xs mt-1 block"></span>
                </div>

                <div class="flex items-center gap-2">
                    <input asp-for="Input.RememberMe" type="checkbox" class="auth-checkbox w-4 h-4 rounded" />
                    <label asp-for="Input.RememberMe" class="text-sm text-base-content/60 cursor-pointer select-none">Remember me</label>
                </div>

                @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
                {
                    <div class="cf-turnstile" data-sitekey="@Model.TurnstileSiteKey" data-theme="auto"></div>
                }

                <button type="submit" class="auth-btn-primary">
                    Sign In
                </button>
            </form>

            <p class="text-center mt-6 text-sm text-base-content/50">
                Don't have an account? <a href="/auth/register?returnUrl=@Model.ReturnUrl" class="auth-link">Create one</a>
            </p>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
    @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
    <script>
    (function () {
        var form = document.querySelector('form');
        if (!form) return;
        form.addEventListener('submit', function (e) {
            if (e.defaultPrevented) return;
            var btn = form.querySelector('button[type="submit"]');
            if (!btn) return;
            btn.disabled = true;
            btn.classList.add('loading');
            btn.textContent = 'Signing in…';
        });
    }());
    </script>
    <script>
    (function () {
        'use strict';
        var STORAGE_KEY = 'snakk:lastOAuthProvider';
        var allBtns = Array.from(document.querySelectorAll('.auth-btn-oauth[data-provider]'));

        var last;
        try { last = localStorage.getItem(STORAGE_KEY); } catch (e) {}
        if (!last) return;

        var lastUsedBtn = allBtns.find(function (b) { return b.dataset.provider === last; });
        if (!lastUsedBtn) return;

        var badge = document.createElement('span');
        badge.className = 'auth-badge-last-used';
        badge.textContent = 'Last used';
        lastUsedBtn.appendChild(badge);

        var oauthBtns = allBtns.filter(function (b) { return b.dataset.provider !== 'passkey'; });
        var toHide = last === 'passkey'
            ? oauthBtns
            : oauthBtns.filter(function (b) { return b !== lastUsedBtn; });

        if (toHide.length === 0) return;

        var oauthGrid = lastUsedBtn.closest('.auth-oauth-grid');
        if (oauthGrid) {
            oauthGrid.classList.remove('auth-oauth-grid');
            oauthGrid.classList.add('flex', 'flex-col', 'gap-2.5');
        }

        toHide.forEach(function (b) { b.style.display = 'none'; });

        var divider = document.querySelector('.auth-divider');
        if (!divider) return;

        var moreBtn = document.createElement('button');
        moreBtn.type = 'button';
        moreBtn.className = 'w-full text-center text-sm text-base-content/40 hover:text-base-content/70 py-1.5 transition-colors cursor-pointer';
        moreBtn.textContent = 'More sign-in options';
        divider.insertAdjacentElement('beforebegin', moreBtn);

        moreBtn.addEventListener('click', function () {
            toHide.forEach(function (b) { b.style.display = ''; });
            if (oauthGrid) {
                oauthGrid.classList.remove('flex', 'flex-col', 'gap-2.5');
                oauthGrid.classList.add('auth-oauth-grid');
            }
            moreBtn.remove();
        });
    }());
    </script>
    @if (Model.PasskeysEnabled)
    {
    <script>
    (function () {
        'use strict';

        var passkeyBtn = document.getElementById('passkey-btn');
        var passkeyError = document.getElementById('passkey-error');
        if (!passkeyBtn) return;

        if (!window.PublicKeyCredential) return; // WebAuthn not supported

        passkeyBtn.style.display = '';

        function base64urlToBuffer(base64url) {
            if (!base64url) return null;
            var base64 = base64url.replace(/-/g, '+').replace(/_/g, '/');
            var padded = base64.padEnd(base64.length + (4 - base64.length % 4) % 4, '=');
            var binary = atob(padded);
            var bytes = new Uint8Array(binary.length);
            for (var i = 0; i < binary.length; i++) bytes[i] = binary.charCodeAt(i);
            return bytes.buffer;
        }

        function bufferToBase64url(buffer) {
            if (!buffer) return null;
            var bytes = new Uint8Array(buffer);
            var binary = '';
            for (var i = 0; i < bytes.length; i++) binary += String.fromCharCode(bytes[i]);
            return btoa(binary).replace(/\+/g, '-').replace(/\//g, '_').replace(/=/g, '');
        }

        function prepareGetOptions(optionsJson) {
            var opts = JSON.parse(optionsJson);
            opts.challenge = base64urlToBuffer(opts.challenge);
            if (opts.allowCredentials) {
                opts.allowCredentials = opts.allowCredentials.map(function (c) {
                    return { id: base64urlToBuffer(c.id), type: c.type, transports: c.transports };
                });
            }
            return opts;
        }

        function serializeAssertion(assertion) {
            return JSON.stringify({
                id: assertion.id,
                rawId: bufferToBase64url(assertion.rawId),
                type: assertion.type,
                response: {
                    authenticatorData: bufferToBase64url(assertion.response.authenticatorData),
                    clientDataJSON: bufferToBase64url(assertion.response.clientDataJSON),
                    signature: bufferToBase64url(assertion.response.signature),
                    userHandle: assertion.response.userHandle ? bufferToBase64url(assertion.response.userHandle) : null
                }
            });
        }

        passkeyBtn.addEventListener('click', function () {
            passkeyBtn.disabled = true;
            passkeyBtn.textContent = 'Waiting for passkey…';
            if (passkeyError) { passkeyError.textContent = ''; passkeyError.classList.add('hidden'); }

            var email = (document.querySelector('input[name="Input.Email"]') || {}).value || '';
            var returnUrl = new URLSearchParams(window.location.search).get('returnUrl') || '/';

            fetch('/auth/passkey/begin-login', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ email: email || null })
            })
            .then(function (res) {
                if (!res.ok) throw new Error('Could not start passkey login');
                return res.json();
            })
            .then(function (beginData) {
                var options = prepareGetOptions(beginData.optionsJson);
                return navigator.credentials.get({ publicKey: options })
                    .then(function (assertion) {
                        return fetch('/auth/passkey/complete-login', {
                            method: 'POST',
                            headers: { 'Content-Type': 'application/json' },
                            body: JSON.stringify({
                                challengeId: beginData.challengeId,
                                assertionResponseJson: serializeAssertion(assertion),
                                returnUrl: returnUrl
                            })
                        });
                    });
            })
            .then(function (res) {
                if (!res.ok) {
                    return res.json().catch(function () { return {}; }).then(function (err) {
                        throw new Error(err.error || 'Passkey verification failed');
                    });
                }
                return res.json();
            })
            .then(function (data) {
                if (data.twoFactorRequired) {
                    window.location.href = '/auth/twofactorverify?email='
                        + encodeURIComponent(data.email)
                        + '&returnUrl=' + encodeURIComponent(returnUrl)
                        + '&provider=passkey';
                    return;
                }
                try { localStorage.setItem('snakk:lastOAuthProvider', 'passkey'); } catch (e) {}
                window.location.href = data.redirectUrl || '/';
            })
            .catch(function (err) {
                passkeyBtn.disabled = false;
                passkeyBtn.textContent = 'Sign in with passkey';
                if (err && err.name === 'NotAllowedError') return; // user cancelled
                if (passkeyError) {
                    passkeyError.textContent = (err && err.message) || 'Passkey login failed. Please try again.';
                    passkeyError.classList.remove('hidden');
                }
            });
        });
    }());
    </script>
    }
}
