@page "/post-login"
@model Snakk.Web.Pages.PostLoginModel
@{
    Layout = null;
}<!DOCTYPE html>
<html>
<head><meta charset="utf-8"></head>
<body>
<script>
@if (Model.SafeProvider != null)
{
<text>try { localStorage.setItem('snakk:lastOAuthProvider', @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SafeProvider))); } catch(e) {}</text>
}
window.location.replace(@Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.SafeTo)));
</script>
</body>
</html>
