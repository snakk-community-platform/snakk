@using Snakk.Web.Helpers
@using Snakk.Web.Services
@using Snakk.Web.Pages.ViewModels
@using static Snakk.Web.Helpers.DisplayHelper
@model SearchModel
@{
    var hasQuery = !string.IsNullOrEmpty(Model.Q);
}

@if (Model.HasSearchError)
{
    <div class="clean-card">
        <div class="empty-state-simple">
            <h3>Search is currently unavailable</h3>
            <p>Please try again in a moment</p>
        </div>
    </div>
}
else if (Model.SearchType == "discussion")
{
    @if (Model.Discussions == null || !Model.Discussions.Items.Any())
    {
        <div class="clean-card">
            <div class="empty-state-simple">
                @if (hasQuery)
                {
                    <h3>No discussions found</h3>
                    <p>Try adjusting your search</p>
                }
                else
                {
                    <h3>Enter a search term</h3>
                    <p>Use the search bar above to find discussions</p>
                }
            </div>
        </div>
    }
    else
    {
        @if (Model.IsScrollAppend)
        {
            @foreach (var discussion in Model.Discussions.Items)
            {
                @await Html.PartialAsync("Shared/_DiscussionCard", new DiscussionListItemVM(
                    discussion,
                    ShowCommunity: true,
                    Community: Model.Community,
                    ShowHub: true,
                    ShowSpace: true,
                    ShowPath: true))
            }
            @if (Model.Discussions.HasMoreItems && Model.Discussions.Offset + Model.Discussions.PageSize < Model.MaxOffset)
            {
                var nextUrl = Model.BuildSearchUrl(Model.Q, Model.AuthorPublicId, Model.SearchType, Model.Discussions.Offset + Model.Discussions.PageSize, Model.DateRange);
                <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this"
                     class="flex justify-center py-4">
                    <span class="loading loading-spinner loading-sm"></span>
                </div>
            }
            else
            {
                <partial name="Shared/_EndOfScroll" />
            }
        }
        else
        {
            <div id="discussions-container">
                @foreach (var discussion in Model.Discussions.Items)
                {
                    @await Html.PartialAsync("Shared/_DiscussionCard", new DiscussionListItemVM(
                        discussion,
                        ShowCommunity: true,
                        Community: Model.Community,
                        ShowHub: true,
                        ShowSpace: true,
                        ShowPath: true))
                }
                @if (Model.Discussions.HasMoreItems && Model.Discussions.Offset + Model.Discussions.PageSize < Model.MaxOffset)
                {
                    var nextUrl = Model.BuildSearchUrl(Model.Q, Model.AuthorPublicId, Model.SearchType, Model.Discussions.Offset + Model.Discussions.PageSize, Model.DateRange);
                    <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this"
                         class="flex justify-center py-4">
                        <span class="loading loading-spinner loading-sm"></span>
                    </div>
                }
            </div>
        }
    }
}
else if (Model.SearchType == "post")
{
    @if (Model.Posts == null || !Model.Posts.Items.Any())
    {
        <div class="clean-card">
            <div class="empty-state-simple">
                @if (hasQuery)
                {
                    <h3>No posts found</h3>
                    <p>Try adjusting your search</p>
                }
                else
                {
                    <h3>Enter a search term</h3>
                    <p>Use the search bar above to find posts</p>
                }
            </div>
        </div>
    }
    else
    {
        @if (Model.IsScrollAppend)
        {
            @foreach (var post in Model.Posts.Items)
            {
                var discussionUrl = SnakkUrlHelper.Discussion(
                    Model.Community,
                    post.Hub?.Slug ?? "",
                    post.Space?.Slug ?? "",
                    SnakkUrlHelper.DiscussionSlugId(post.DiscussionSlug, post.DiscussionPublicId));
                var postUrl = $"{discussionUrl}#post-{post.PublicId}";

                <article class="sn-card">
                    <div class="sn-card-header">
                        <img src="@post.Author.AvatarMicroUrl" alt=""
                             class="sn-card-avatar" width="20" height="20" loading="lazy" decoding="async" />
                        <a href="@SnakkUrlHelper.UserProfile(post.Author.PublicId)"
                           class="sn-card-author">@post.Author.DisplayName</a>
                        <span class="sn-card-dot">&middot;</span>
                        <time class="sn-card-time" datetime="@(post.CreatedAt?.ToDateTime().ToString("o"))">
                            @FormatRelativeTime(post.CreatedAt?.ToDateTime())
                        </time>
                        <span class="sn-card-path">
                            <a href="@discussionUrl" class="sn-card-path-link">@post.DiscussionTitle</a>
                            @if (!string.IsNullOrEmpty(post.Hub?.Name))
                            {
                                <span class="sn-card-path-sep">&rsaquo;</span>
                                <span class="sn-card-path-link">@post.Hub.Name</span>
                            }
                        </span>
                    </div>
                    @if (!string.IsNullOrEmpty(post.ContentHighlight))
                    {
                        <div class="prose prose-sm max-w-none px-4 pt-1 pb-2 sn-post-preview" style="color: var(--text-secondary)">
                            @Html.Raw(post.ContentHighlight)
                        </div>
                    }
                    <div class="px-4 pb-3 flex justify-end">
                        <a href="@postUrl" class="text-xs font-medium" style="color: var(--link-primary)">
                            View post &rarr;
                        </a>
                    </div>
                </article>
            }
            @if (Model.Posts.HasMoreItems && Model.Posts.Offset + Model.Posts.PageSize < Model.MaxOffset)
            {
                var nextUrl = Model.BuildSearchUrl(Model.Q, Model.AuthorPublicId, Model.SearchType, Model.Posts.Offset + Model.Posts.PageSize, Model.DateRange);
                <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this"
                     class="flex justify-center py-4">
                    <span class="loading loading-spinner loading-sm"></span>
                </div>
            }
            else
            {
                <partial name="Shared/_EndOfScroll" />
            }
        }
        else
        {
            <div id="posts-container">
                @foreach (var post in Model.Posts.Items)
                {
                    var discussionUrl = SnakkUrlHelper.Discussion(
                        Model.Community,
                        post.Hub?.Slug ?? "",
                        post.Space?.Slug ?? "",
                        SnakkUrlHelper.DiscussionSlugId(post.DiscussionSlug, post.DiscussionPublicId));
                    var postUrl = $"{discussionUrl}#post-{post.PublicId}";

                    <article class="sn-card">
                        <div class="sn-card-header">
                            <img src="@post.Author.AvatarMicroUrl" alt=""
                                 class="sn-card-avatar" width="20" height="20" loading="lazy" decoding="async" />
                            <a href="@SnakkUrlHelper.UserProfile(post.Author.PublicId)"
                               class="sn-card-author">@post.Author.DisplayName</a>
                            <span class="sn-card-dot">&middot;</span>
                            <time class="sn-card-time" datetime="@(post.CreatedAt?.ToDateTime().ToString("o"))">
                                @FormatRelativeTime(post.CreatedAt?.ToDateTime())
                            </time>
                            <span class="sn-card-path">
                                <a href="@discussionUrl" class="sn-card-path-link">@post.DiscussionTitle</a>
                                @if (!string.IsNullOrEmpty(post.Hub?.Name))
                                {
                                    <span class="sn-card-path-sep">&rsaquo;</span>
                                    <span class="sn-card-path-link">@post.Hub.Name</span>
                                }
                            </span>
                        </div>
                        @if (!string.IsNullOrEmpty(post.ContentHighlight))
                        {
                            <div class="prose prose-sm max-w-none px-4 pt-1 pb-2 sn-post-preview" style="color: var(--text-secondary)">
                                @Html.Raw(post.ContentHighlight)
                            </div>
                        }
                        <div class="px-4 pb-3 flex justify-end">
                            <a href="@postUrl" class="text-xs font-medium" style="color: var(--link-primary)">
                                View post &rarr;
                            </a>
                        </div>
                    </article>
                }
                @if (Model.Posts.HasMoreItems && Model.Posts.Offset + Model.Posts.PageSize < Model.MaxOffset)
                {
                    var nextUrl = Model.BuildSearchUrl(Model.Q, Model.AuthorPublicId, Model.SearchType, Model.Posts.Offset + Model.Posts.PageSize, Model.DateRange);
                    <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this"
                         class="flex justify-center py-4">
                        <span class="loading loading-spinner loading-sm"></span>
                    </div>
                }
            </div>
        }
    }
}
