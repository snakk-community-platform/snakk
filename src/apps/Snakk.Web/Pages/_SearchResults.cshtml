@using Snakk.Web.Helpers
@using Snakk.Web.Services
@using Snakk.Web.Pages.ViewModels
@using static Snakk.Web.Helpers.DisplayHelper
@model SearchModel
@{
    var hasQuery = !string.IsNullOrEmpty(Model.Q);
}

@if (Model.HasSearchError)
{
    <div class="sn-clean-card">
        <div class="empty-state-simple">
            <h3>Search is currently unavailable</h3>
            <p>Please try again in a moment</p>
        </div>
    </div>
}
else if (Model.SearchType == "discussion")
{
    @if (Model.Discussions == null || !Model.Discussions.Items.Any())
    {
        <div class="sn-clean-card">
            <div class="empty-state-simple">
                @if (hasQuery)
                {
                    <h3>No discussions found</h3>
                    <p>Try adjusting your search</p>
                }
                else
                {
                    <h3>Enter a search term</h3>
                    <p>Use the search bar above to find discussions</p>
                }
            </div>
        </div>
    }
    else
    {
        @if (Model.IsScrollAppend)
        {
            @foreach (var discussion in Model.Discussions.Items)
            {
                @await Html.PartialAsync("Shared/_DiscussionCard", new DiscussionListItemVM(
                    discussion,
                    ShowCommunity: true,
                    Community: Model.Community,
                    ShowHub: true,
                    ShowSpace: true,
                    ShowPath: true))
            }
            @if (Model.Discussions.HasMoreItems && Model.Discussions.Offset + Model.Discussions.PageSize < Model.MaxOffset)
            {
                var nextUrl = Model.BuildSearchUrl(Model.Q, Model.AuthorPublicId, Model.SearchType, Model.Discussions.Offset + Model.Discussions.PageSize, Model.DateRange);
                <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this"
                     class="sn-search-load-sentinel">
                    <span class="sn-spinner sn-loading-sm"></span>
                </div>
            }
            else
            {
                <partial name="Shared/_EndOfScroll" />
            }
        }
        else
        {
            <div id="discussions-container">
                @foreach (var discussion in Model.Discussions.Items)
                {
                    @await Html.PartialAsync("Shared/_DiscussionCard", new DiscussionListItemVM(
                        discussion,
                        ShowCommunity: true,
                        Community: Model.Community,
                        ShowHub: true,
                        ShowSpace: true,
                        ShowPath: true))
                }
                @if (Model.Discussions.HasMoreItems && Model.Discussions.Offset + Model.Discussions.PageSize < Model.MaxOffset)
                {
                    var nextUrl = Model.BuildSearchUrl(Model.Q, Model.AuthorPublicId, Model.SearchType, Model.Discussions.Offset + Model.Discussions.PageSize, Model.DateRange);
                    <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this"
                         class="sn-search-load-sentinel">
                        <span class="sn-spinner sn-loading-sm"></span>
                    </div>
                }
            </div>
        }
    }
}
else if (Model.SearchType == "post")
{
    @if (Model.Posts == null || !Model.Posts.Items.Any())
    {
        <div class="sn-clean-card">
            <div class="empty-state-simple">
                @if (hasQuery)
                {
                    <h3>No posts found</h3>
                    <p>Try adjusting your search</p>
                }
                else
                {
                    <h3>Enter a search term</h3>
                    <p>Use the search bar above to find posts</p>
                }
            </div>
        </div>
    }
    else
    {
        @if (Model.IsScrollAppend)
        {
            @foreach (var post in Model.Posts.Items)
            {
                @await Html.PartialAsync("Shared/_PostCard", PostListItemVM.FromSearchResult(post))
            }
            @if (Model.Posts.HasMoreItems && Model.Posts.Offset + Model.Posts.PageSize < Model.MaxOffset)
            {
                var nextUrl = Model.BuildSearchUrl(Model.Q, Model.AuthorPublicId, Model.SearchType, Model.Posts.Offset + Model.Posts.PageSize, Model.DateRange);
                <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this"
                     class="sn-search-load-sentinel">
                    <span class="sn-spinner sn-loading-sm"></span>
                </div>
            }
            else
            {
                <partial name="Shared/_EndOfScroll" />
            }
        }
        else
        {
            <div id="posts-container">
                @foreach (var post in Model.Posts.Items)
                {
                    @await Html.PartialAsync("Shared/_PostCard", PostListItemVM.FromSearchResult(post))
                }
                @if (Model.Posts.HasMoreItems && Model.Posts.Offset + Model.Posts.PageSize < Model.MaxOffset)
                {
                    var nextUrl = Model.BuildSearchUrl(Model.Q, Model.AuthorPublicId, Model.SearchType, Model.Posts.Offset + Model.Posts.PageSize, Model.DateRange);
                    <div hx-get="@nextUrl" hx-trigger="revealed" hx-swap="outerHTML" hx-target="this"
                         class="sn-search-load-sentinel">
                        <span class="sn-spinner sn-loading-sm"></span>
                    </div>
                }
            </div>
        }
    }
}
