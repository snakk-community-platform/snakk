@page "/c/{communitySlug}/h/{hubSlug}/{spaceSlug}/{slugWithId}"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@using static Snakk.Web.Helpers.DiscussionTypeHelper
@model Snakk.Web.Pages.Discussions.DetailModel

@{
    ViewData["Title"] = Model.Discussion?.Title ?? T.Pages.DiscTitleFallback;
}

@section LeftColumn {
    <partial name="Shared/_LeftSidebar" />
}


@section Meta {
    @if (Model.Discussion != null && Model.Space is not { IsRestricted: true })
    {
        var siteBase = ViewData["SiteBase"] as string
            ?? $"{ViewContext.HttpContext.Request.Scheme}://{ViewContext.HttpContext.Request.Host}";
        var path = ViewContext.HttpContext.Request.Path.ToString();

        var firstPost = Model.Posts?.Items?.FirstOrDefault();
        var contentIsAdult = Model.Discussion.IsAdult || Model.Space?.IsAdultOnly == true;
        var description = contentIsAdult
            ? T.Pages.DiscAdultOgDescription
            : firstPost != null
                ? (firstPost.Content.Length > 160 ? firstPost.Content.Substring(0, 157) + "..." : firstPost.Content)
                : Model.Discussion!.Title;
        var url = $"{siteBase}{path}";
        var authorAvatar = firstPost?.Author?.AvatarUrl;
        var authorName = firstPost?.Author?.DisplayName ?? T.Pages.DiscAnonymous;
        ViewData["CanonicalUrl"] = url;

        // For Images-type discussions use the first image's medium URL as og:image
        var firstImg = Model.Discussion.Type == "Images" && Model.ImagesItems.Count > 0 ? Model.ImagesItems[0] : null;
        var ogImageUrl = firstImg != null
            ? (firstImg.HasMediumThumbnailUrl ? firstImg.MediumThumbnailUrl : firstImg.Url)
            : (string.IsNullOrEmpty(authorAvatar) ? null : $"{siteBase}{authorAvatar}");
        var ogImageW = firstImg != null && firstImg.HasMediumThumbnailWidth ? firstImg.MediumThumbnailWidth : (firstImg?.Width ?? 0);
        var ogImageH = firstImg != null && firstImg.HasMediumThumbnailHeight ? firstImg.MediumThumbnailHeight : (firstImg?.Height ?? 0);
        var ogImageAlt = firstImg != null ? Model.Discussion!.Title : authorName;

        <meta name="description" content="@description" />

        <!-- Open Graph -->
        <meta property="og:title" content="@Model.Discussion!.Title" />
        <meta property="og:description" content="@description" />
        <meta property="og:type" content="article" />
        <meta property="og:url" content="@url" />
        @if (!contentIsAdult && ogImageUrl != null)
        {
            <meta property="og:image" content="@ogImageUrl" />
            <meta property="og:image:alt" content="@ogImageAlt" />
            @if (ogImageW > 0 && ogImageH > 0)
            {
                <meta property="og:image:width" content="@ogImageW" />
                <meta property="og:image:height" content="@ogImageH" />
            }
        }
        <meta property="article:published_time" content="@Model.Discussion.CreatedAt.ToDateTime().ToString("O")" />
        <meta property="article:author" content="@authorName" />
        @if (Model.Discussion.LastActivityAt is not null)
        {
            <meta property="article:modified_time" content="@Model.Discussion.LastActivityAt.ToDateTime().ToString("O")" />
        }

        <!-- Twitter Card -->
        <meta name="twitter:card" content="@(firstImg != null ? "summary_large_image" : "summary")" />
        <meta name="twitter:title" content="@Model.Discussion!.Title" />
        <meta name="twitter:description" content="@description" />
        @if (!contentIsAdult && ogImageUrl != null)
        {
            <meta name="twitter:image" content="@ogImageUrl" />
        }

        <!-- JSON-LD Structured Data -->
        <script type="application/ld+json">
            {
            "@@context": "https://schema.org",
            "@@type": "DiscussionForumPosting",
            "headline": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Discussion!.Title)),
            "url": "@url",
            "datePublished": "@Model.Discussion.CreatedAt.ToDateTime().ToString("O")",
            "author": {
            "@@type": "Person",
            "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(firstPost?.Author?.DisplayName ?? T.Pages.DiscAnonymous))
            },
            "interactionStatistic": {
            "@@type": "InteractionCounter",
            "interactionType": "https://schema.org/CommentAction",
            "userInteractionCount": @(Model.Posts?.Items?.Count ?? 0)
            },
            "isPartOf": {
            "@@type": "WebPage",
            "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Space?.Name ?? Model.SpaceSlug))
            }
            }
        </script>

        <!-- oEmbed Discovery -->
        <link rel="alternate" type="application/json+oembed"
              href="/oembed?url=@Uri.EscapeDataString(url)"
              title="@Html.Encode(Model.Discussion!.Title)" />

        <!-- Breadcrumb Schema -->
        <script type="application/ld+json">
            {
            "@@context": "https://schema.org",
            "@@type": "BreadcrumbList",
            "itemListElement": [
            {
            "@@type": "ListItem",
            "position": 1,
            "name": "@T.Pages.DiscBreadcrumbHome",
            "item": "@($"{siteBase}/")"
            },
            {
            "@@type": "ListItem",
            "position": 2,
            "name": "@T.Pages.DiscBreadcrumbHubs",
            "item": "@($"{siteBase}/hubs")"
            },
            {
            "@@type": "ListItem",
            "position": 3,
            "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Hub?.Name ?? Model.HubSlug)),
            "item": "@($"{siteBase}{SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)}")"
            },
            {
            "@@type": "ListItem",
            "position": 4,
            "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Space?.Name ?? Model.SpaceSlug)),
            "item": "@($"{siteBase}{SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug)}")"
            },
            {
            "@@type": "ListItem",
            "position": 5,
            "name": @Html.Raw(System.Text.Json.JsonSerializer.Serialize(Model.Discussion!.Title))
            }
            ]
            }
        </script>
    }
}

<!-- Center Column -->
<div class="sn-center">

    @if (Model.Discussion != null && Model.Space != null)
    {
        <div class="sn-breadcrumb-bar sn-breadcrumb-bar--colored" style="background-image: @SpaceGradient(Model.Space.PublicId, 45)">
            @if (Model.ShowCommunityInBreadcrumb)
            {
                <a href="/c/@Model.Community.CommunitySlug" class="sn-badge sn-badge-ghost sn-badge-sm"
                   data-popup-type="community"
                   data-popup-id="@Model.CommunityDetail?.PublicId"
                   data-popup-name="@(Model.Community.CommunityName ?? Model.Community.CommunitySlug)">@(Model.Community.CommunityName ?? Model.Community.CommunitySlug)</a>
                <span class="sn-page-labels-sep">›</span>
            }
            else if (!Model.Community.IsMultiCommunityEnabled)
            {
                <a href="/c" class="sn-badge sn-badge-ghost sn-badge-sm"
                   data-popup-type="community"
                   data-popup-id="@Model.CommunityDetail?.PublicId"
                   data-popup-name="@(Model.Community.CommunityName ?? Model.Community.CommunitySlug)">@(Model.Community.CommunityName ?? Model.Community.CommunitySlug)</a>
                <span class="sn-page-labels-sep">›</span>
            }
            <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)" class="sn-badge sn-badge-ghost sn-badge-sm"
               data-popup-type="hub"
               data-popup-id="@Model.Hub?.PublicId"
               data-popup-name="@Model.Hub?.Name">@(Model.Hub?.Name ?? Model.HubSlug)</a>
            <span class="sn-page-labels-sep">›</span>
            <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug)" class="sn-badge sn-badge-ghost sn-badge-sm"
               data-popup-type="space"
               data-popup-id="@Model.Space?.PublicId"
               data-popup-name="@Model.Space?.Name">@(Model.Space?.Name ?? Model.SpaceSlug)</a>
        </div>
    }

    @if (Model.AdultGateState == Snakk.Web.Services.AdultContentState.NeedsPrompt)
    {
        <partial name="_AdultContentGate" />
    }
    else if (Model.AdultGateState == Snakk.Web.Services.AdultContentState.Hidden)
    {
        <partial name="_AdultContentHidden" />
    }
    else if (Model.Discussion != null)
    {
        @if (Model.IsDiscussionDeleted)
        {
            <div class="sn-alert sn-alert-warning sn-mx-4 sn-mt-4" role="alert">
                <span class="sn-icon icon-trash" style="width:18px;height:18px" aria-hidden="true"></span>
                <span>@T.Pages.ModDeletedDiscussionBanner</span>
            </div>
        }

        <header class="sn-discussion-header" style="background-image: @SpaceGradient(Model.Space?.PublicId)">

            <!-- Realtime context — JS reads these to subscribe to the correct groups -->
            <div id="page-context"
                 data-discussion-id="@Model.Discussion.PublicId"
                 data-space-id="@Model.Space?.PublicId"
                 hidden></div>

                @{
                    var firstPostItem = Model.Posts?.Items?.FirstOrDefault(p => p.IsFirstPost);
                }

                <!-- Author + Time row -->
                <div class="sn-discussion-byline">
                        @if (firstPostItem != null)
                        {
                            @if (!firstPostItem.Author.IsDeleted)
                            {
                                <img src="@firstPostItem.Author.AvatarThumbnailUrl"
                                     alt="@firstPostItem.Author.DisplayName"
                                     width="24" height="24"
                                     class="sn-rounded-full sn-shadow-layered"
                                     decoding="async" />
                                <a href="@SnakkUrlHelper.UserProfile(firstPostItem.Author.Slug)"
                                   class="sn-font-medium sn-hover\:underline"
                                   data-popup-type="user"
                                   data-popup-id="@firstPostItem.Author.PublicId"
                                   data-popup-name="@firstPostItem.Author.DisplayName">@firstPostItem.Author.DisplayName</a>
                            }
                            else
                            {
                                <span class="sn-deleted">@firstPostItem.Author.DisplayName</span>
                            }
                            @if (firstPostItem.Author.Role == "admin")
                            {
                                <span class="sn-badge sn-badge-error sn-badge-xs">@T.Pages.DiscBadgeAdmin</span>
                            }
                            else if (firstPostItem.Author.Role == "mod")
                            {
                                <span class="sn-badge sn-badge-info sn-badge-xs">@T.Pages.DiscBadgeMod</span>
                            }
                        }
                        <span class="sn-discussion-header-sep">·</span>
                        <time class="sn-discussion-header-time" datetime="@Model.Discussion.CreatedAt.ToDateTime().ToString("O")">
                            @FormatRelativeTime(Model.Discussion.CreatedAt.ToDateTime())
                        </time>
                        @if (Model.Discussion.IsPinned)
                        {
                            <span class="sn-badge sn-badge-primary sn-badge-xs">@T.Pages.DiscBadgePinned</span>
                        }
                        @if (Model.Discussion!.IsLocked)
                        {
                            <span class="sn-badge sn-badge-warning sn-badge-xs">@T.Pages.DiscBadgeLocked</span>
                        }
                        <div id="viewer-presence" class="sn-hidden sn-flex sn-items-center sn-gap-0\.5"></div>

                        <!-- Actions — pushed right -->
                        <div class="sn-discussion-header-actions">
                            @if (Model.IsAuthenticated)
                            {
                                <div class="sn-dropdown">
                                    <button type="button" class="sn-btn sn-btn-ghost sn-btn-xs sn-btn-square" aria-label="@T.Pages.DiscAriaDiscussionOptions"
                                            popovertarget="sn-disc-opts">
                                        <span class="icon icon-dots-horizontal sn-h-4 sn-w-4" aria-hidden="true"></span>
                                    </button>
                                    <ul id="sn-disc-opts" popover class="sn-dropdown-panel sn-menu sn-w-48">
                                        <li>
                                            <button id="mute-discussion-btn" data-action="toggle-mute-discussion" data-discussion-id="@Model.Discussion.PublicId" class="sn-text-sm">
                                                <span class="icon icon-volume-off sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                <span id="mute-text">@T.Pages.DiscMuteDiscussion</span>
                                            </button>
                                        </li>
                                        @if (firstPostItem != null)
                                        {
                                            <li>
                                                <button hx-get="/bff/posts/@firstPostItem.PublicId/history"
                                                        hx-target="#history-modal-content"
                                                        hx-swap="innerHTML"
                                                        data-modal-open="history_modal"
                                                        class="sn-text-sm">
                                                    @T.Pages.DiscHistory
                                                </button>
                                            </li>
                                            @if (Model.CurrentUserId == firstPostItem.Author.PublicId)
                                            {
                                                <li><button data-action="edit-post" data-post-id="@firstPostItem.PublicId" data-user-id="@Model.CurrentUserId" class="sn-text-sm">@T.Pages.DiscEdit</button></li>
                                                <li>
                                                    <button hx-delete="/bff/posts/@firstPostItem.PublicId"
                                                            hx-target="#post-@firstPostItem.PostNumber"
                                                            hx-swap="outerHTML"
                                                            hx-confirm="@T.Pages.DiscDeleteConfirm"
                                                            class="sn-text-sm sn-text-error">
                                                        @T.Pages.DiscDelete
                                                    </button>
                                                </li>
                                            }
                                            @if (Model.CurrentUserId != firstPostItem.Author.PublicId)
                                            {
                                                <li>
                                                    <button data-action="open-report-modal" data-report-type="post" data-report-id="@firstPostItem.PublicId" data-report-label="@T.Pages.DiscReportThisPost" class="sn-text-sm sn-text-error">
                                                        @T.Pages.DiscReportPost
                                                    </button>
                                                </li>
                                            }
                                        }
                                        <li>
                                            <button data-action="open-report-modal" data-report-type="discussion" data-report-id="@Model.Discussion.PublicId" data-report-label="@Model.Discussion!.Title" class="sn-text-sm sn-text-error">
                                                <span class="icon icon-exclamation-triangle sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                @T.Pages.DiscReportDiscussion
                                            </button>
                                        </li>
                                    </ul>
                                </div>
                            }
                        </div>
                    </div>

                    <!-- Title + OP reactions -->
                    <div class="sn-discussion-title-row">
                        <div id="discussion-title-container"
                             class="sn-discussion-title-container sn-flex-1 sn-min-w-0"
                             data-discussion-id="@Model.Discussion.PublicId"
                             data-current-title="@Model.Discussion!.Title">
                        <h1 class="sn-text-xl sn-font-bold">
                            @if (!string.IsNullOrEmpty(Model.Discussion.Type) && Model.Discussion.Type != "Standard")
                            {
                                var (icon, label, cssClass) = GetTypeBadge(Model.Discussion.Type);
                                <span class="sn-card-type-badge sn-shadow-layered @cssClass">@icon @label</span>
                            }
                            @Model.Discussion!.Title
                        </h1>
                        @if (firstPostItem != null && Model.CurrentUserId == firstPostItem.Author.PublicId && !Model.Discussion!.IsLocked)
                        {
                            <button data-action="edit-discussion-title"
                                    class="sn-btn sn-btn-ghost sn-btn-xs sn-btn-square sn-shrink-0 sn-mt-1"
                                    aria-label="Edit discussion title">
                                <span class="icon icon-pencil sn-h-4 sn-w-4" aria-hidden="true"></span>
                            </button>
                        }
                        </div>
                        @if (firstPostItem != null)
                        {
                            <partial name="_PostReactions" model="@(new PostReactionsVM(
                                PostPublicId: firstPostItem.PublicId,
                                Counts: (firstPostItem.Reactions?.Counts?.Counts ?? new Google.Protobuf.Collections.MapField<string, int>()).ToDictionary(k => k.Key, k => k.Value),
                                MyReactions: (firstPostItem.Reactions?.UserReactions?.Reactions ?? Enumerable.Empty<string>()).ToList(),
                                IsOp: true,
                                IsAuthenticated: Model.IsAuthenticated,
                                IsLocked: Model.Discussion!.IsLocked))" />
                        }
                    </div>

                @* Type-specific widgets — server-rendered *@

                @if (Model.Discussion.Type == "Question" && Model.QuestionStatus is not null && Model.QuestionStatus.IsSolved)
                {
                    <div class="type-widget-container">
                        <div class="type-widget-solved">
                            <span>✅ @T.Pages.DiscSolved</span>
                        </div>
                    </div>
                }

                @if (Model.Discussion.Type == "Link" && Model.LinkInfo is not null)
                {
                    var linkDomain = Model.LinkInfo.HasDomain ? Model.LinkInfo.Domain : new Uri(Model.LinkInfo.Url).Host;
                    var linkImageSrc = Model.LinkInfo.HasImagePathUrl ? Model.LinkInfo.ImagePathUrl
                                     : Model.LinkInfo.HasImageUrl ? Model.LinkInfo.ImageUrl
                                     : null;
                    var linkTarget = Model.LinkInfo.IsInternal ? null : "_blank";
                    var linkRel = Model.LinkInfo.IsInternal ? null : "nofollow noopener noreferrer";
                    <div class="type-widget-container" id="link-preview-container"
                         data-oembed-html="@Model.LinkInfo.OembedHtml"
                         data-domain="@linkDomain"
                         data-prompt-body="@T.Pages.DiscEmbedPromptBody"
                         data-prompt-yes="@T.Pages.DiscEmbedPromptYes"
                         data-prompt-no="@T.Pages.DiscEmbedPromptNo"
                         data-prompt-remember="@T.Pages.DiscEmbedPromptRemember"
                         data-denied-message="@T.Pages.DiscEmbedDeniedMessage"
                         data-denied-settings="@T.Pages.DiscEmbedDeniedSettings">
                        <div class="sn-link-preview-card">
                            @if (linkImageSrc is not null)
                            {
                                var linkBlur = Model.LinkInfo.HasBlurDataUri ? Model.LinkInfo.BlurDataUri : null;
                                var hasSize = Model.LinkInfo.HasImageWidth && Model.LinkInfo.ImageWidth > 0;
                                var frameStyle = hasSize
                                    ? $"aspect-ratio: {Model.LinkInfo.ImageWidth} / {Model.LinkInfo.ImageHeight}; max-width: {Model.LinkInfo.ImageWidth}px;"
                                    : "";
                                var blurBgVal = linkBlur != null ? $"url({linkBlur})" : $"url({linkImageSrc})";
                                <a href="@Model.LinkInfo.Url" target="@linkTarget" rel="@linkRel" class="link-preview-banner-link" tabindex="-1" aria-hidden="true">
                                    <div class="sn-images-preview link-preview-banner" style="--blur-bg:@blurBgVal">
                                        <div class="sn-images-frame"@(frameStyle != "" ? $" style=\"{frameStyle}\"" : "")>
                                            <div class="sn-images-slide-wrapper"@(linkBlur != null ? $" style=\"--blur:url({linkBlur})\"" : "")>
                                                @if (linkBlur != null && hasSize)
                                                {
                                                    <div class="sn-images-lqip" style="aspect-ratio: @Model.LinkInfo.ImageWidth / @Model.LinkInfo.ImageHeight"></div>
                                                }
                                                <img src="@linkImageSrc" alt="" class="sn-images-slide" loading="lazy" decoding="async" data-blur-up />
                                            </div>
                                        </div>
                                    </div>
                                </a>
                            }
                            else
                            {
                                <a href="@Model.LinkInfo.Url" target="@linkTarget" rel="@linkRel" class="link-preview-banner-link" tabindex="-1" aria-hidden="true">
                                    <div class="link-preview-banner link-preview-banner--empty">
                                        <span class="icon icon-link-chain"></span>
                                    </div>
                                </a>
                            }
                            <div class="link-preview-content">
                                @if (Model.LinkInfo.IsInternal)
                                {
                                    <a href="@Model.LinkInfo.Url" class="sn-link-preview-title">@(Model.LinkInfo.HasTitle ? Model.LinkInfo.Title : Model.LinkInfo.Url)</a>
                                }
                                else
                                {
                                    <a href="@Model.LinkInfo.Url" target="_blank" rel="nofollow noopener noreferrer" class="sn-link-preview-title">@(Model.LinkInfo.HasTitle ? Model.LinkInfo.Title : Model.LinkInfo.Url)</a>
                                }
                                @if (Model.LinkInfo.HasDescription)
                                {
                                    <p class="sn-link-preview-description">@Model.LinkInfo.Description</p>
                                }
                                <span class="sn-link-preview-domain">
                                    @if (!Model.LinkInfo.IsInternal)
                                    {
                                        <span class="icon icon-external-link" style="width:12px;height:12px" aria-hidden="true"></span>
                                    }
                                    @(Model.LinkInfo.IsInternal ? T.Pages.DiscInternalLink : linkDomain)
                                </span>
                            </div>
                        </div>
                    </div>
                }

                @if (Model.Discussion.Type == "Debate" && Model.DebateInfo is not null)
                {
                    var debatePositions = Model.DebateInfo.Positions.OrderBy(p => p.Index).ToList();
                    var debateTotalPosts = debatePositions.Sum(p => p.PostCount);
                    var debateColors = new[] { "var(--link-primary)", "oklch(0.6 0.18 15)", "oklch(0.6 0.15 50)" };

                    <div class="type-widget-container">
                        <div class="sn-debate-distribution">
                            @for (var i = 0; i < debatePositions.Count; i++)
                            {
                                var p = debatePositions[i];
                                var pct = debateTotalPosts > 0 ? Math.Max((int)Math.Round(p.PostCount * 100.0 / debateTotalPosts), 5) : 100 / debatePositions.Count;
                                <div class="debate-position-bar" style="width:@(pct)%;background:@debateColors[Math.Min(i, debateColors.Length - 1)]"
                                     title="@string.Format(T.Pages.DiscPositionPostsPattern, p.Label, p.PostCount)"></div>
                            }
                        </div>
                        <div class="sn-debate-legend">
                            @for (var i = 0; i < debatePositions.Count; i++)
                            {
                                var p = debatePositions[i];
                                <span class="debate-legend-item">
                                    <span class="debate-legend-color" style="background:@debateColors[Math.Min(i, debateColors.Length - 1)]"></span>
                                    @p.Label (@p.PostCount)
                                </span>
                            }
                        </div>
                    </div>
                }

                @if (Model.Discussion.Type == "Iama" && Model.IamaInfo is not null)
                {
                    var iama = Model.IamaInfo;
                    var isOp = Model.CurrentUserId != null && firstPostItem != null
                        && Model.CurrentUserId == firstPostItem.Author.PublicId;
                    var iamaPhaseClass = iama.Phase switch
                    {
                        0 => "sn-iama-phase--announced",
                        1 => "sn-iama-phase--live",
                        2 => "sn-iama-phase--closed",
                        3 => "sn-iama-phase--archived",
                        _ => ""
                    };
                    var iamaPhaseLabel = iama.Phase switch
                    {
                        0 => T.IamaPhase.Announced,
                        1 => T.IamaPhase.Live,
                        2 => T.IamaPhase.Closed,
                        3 => T.IamaPhase.Archived,
                        _ => ""
                    };
                    var iamaPhaseDesc = iama.Phase switch
                    {
                        0 => T.IamaPhase.AnnouncedDesc,
                        1 => T.IamaPhase.LiveDesc,
                        2 => T.IamaPhase.ClosedDesc,
                        3 => T.IamaPhase.ArchivedDesc,
                        _ => ""
                    };

                    <div class="type-widget-container sn-iama-widget">
                        <div class="@iamaPhaseClass">
                            <div class="sn-iama-phase-header">
                                <span class="sn-iama-phase-label">
                                    @if (iama.Phase == 1) { <span class="sn-iama-live-dot" aria-hidden="true"></span> }
                                    @iamaPhaseLabel
                                </span>
                                @if (isOp && iama.Phase == 1)
                                {
                                    <button type="button" class="sn-btn sn-btn-sm sn-btn-ghost sn-iama-end-btn"
                                            data-discussion-id="@Model.Discussion.PublicId"
                                            data-confirm-label="@T.Iama.EndConfirmBtn">
                                        @T.Iama.EndSession
                                    </button>
                                }
                            </div>
                            <p class="sn-iama-phase-desc">@iamaPhaseDesc</p>

                            <div class="sn-iama-widget-dates">
                            @if (iama.ActualStartedAtUtc != null)
                            {
                                <div class="sn-iama-date-row">
                                    <span class="sn-iama-date-label">@T.Iama.Started</span>
                                    <time datetime="@iama.ActualStartedAtUtc.ToDateTime().ToString("o")">
                                        @FormatFullDateTime(iama.ActualStartedAtUtc.ToDateTime())
                                    </time>
                                </div>
                            }
                            else if (iama.ScheduledStartUtc != null)
                            {
                                <div class="sn-iama-date-row-group">
                                    <div class="sn-iama-date-row">
                                        <span class="sn-iama-date-label">@T.Iama.Starts</span>
                                        <time datetime="@iama.ScheduledStartUtc.ToDateTime().ToString("o")">
                                            @FormatFullDateTime(iama.ScheduledStartUtc.ToDateTime())
                                        </time>
                                    </div>
                                    @if (iama.Phase == 0 && iama.ScheduledStartUtc.ToDateTime() > DateTime.UtcNow)
                                    {
                                        <span class="sn-iama-countdown" data-countdown-to="@iama.ScheduledStartUtc.ToDateTime().ToString("o")"><span class="countdown sn-font-mono">
                                            <span data-unit="days" style="--value:0;">0</span>d
                                            <span data-unit="hours" style="--value:0;">0</span>h
                                            <span data-unit="minutes" style="--value:0;">0</span>m
                                            <span data-unit="seconds" style="--value:0;">0</span>s
                                        </span></span>
                                    }
                                </div>
                            }

                            @if (iama.ActualEndedAtUtc != null)
                            {
                                <div class="sn-iama-date-row">
                                    <span class="sn-iama-date-label">@T.Iama.Ended</span>
                                    <time datetime="@iama.ActualEndedAtUtc.ToDateTime().ToString("o")">
                                        @FormatFullDateTime(iama.ActualEndedAtUtc.ToDateTime())
                                    </time>
                                </div>
                            }
                            else if (iama.ScheduledEndUtc != null)
                            {
                                <div class="sn-iama-date-row-group">
                                    <div class="sn-iama-date-row">
                                        <span class="sn-iama-date-label">@T.Iama.Ends</span>
                                        <time datetime="@iama.ScheduledEndUtc.ToDateTime().ToString("o")">
                                            @FormatFullDateTime(iama.ScheduledEndUtc.ToDateTime())
                                        </time>
                                    </div>
                                    @if (iama.Phase == 1 && iama.ScheduledEndUtc.ToDateTime() > DateTime.UtcNow)
                                    {
                                        <span class="sn-iama-countdown" data-countdown-to="@iama.ScheduledEndUtc.ToDateTime().ToString("o")"><span class="countdown sn-font-mono">
                                            <span data-unit="days" style="--value:0;">0</span>d
                                            <span data-unit="hours" style="--value:0;">0</span>h
                                            <span data-unit="minutes" style="--value:0;">0</span>m
                                            <span data-unit="seconds" style="--value:0;">0</span>s
                                        </span></span>
                                    }
                                </div>
                            }
                        </div>
                        </div>

                        @if (iama.HasVerificationNoteHtml || !string.IsNullOrWhiteSpace(iama.VerificationNote))
                        {
                            <div class="sn-iama-verification">
                                <span class="sn-iama-verification-label">@T.Iama.Verification</span>
                                @if (iama.HasVerificationNoteHtml)
                                {
                                    <div class="sn-iama-verification-text sn-prose sn-prose-sm sn-max-w-none">@Html.SanitizedRaw(iama.VerificationNoteHtml)</div>
                                }
                                else
                                {
                                    <p class="sn-iama-verification-text">@iama.VerificationNote</p>
                                }
                            </div>
                        }
                    </div>
                }

                @if (Model.Discussion.Type == "Guide")
                {
                    <div id="guide-toc-container" class="type-widget-container"></div>
                }

                @* Poll widget — rendered client-side via JS *@
                @if (Model.Discussion.Type == "Poll")
                {
                    <div id="poll-container"
                         data-discussion-id="@Model.Discussion.PublicId"
                         data-authenticated="@(Model.IsAuthenticated ? "true" : "false")"
                         class="poll-widget">
                        <div class="poll-skeleton">
                            <div class="poll-skeleton-option"></div>
                            <div class="poll-skeleton-option"></div>
                            <div class="poll-skeleton-option"></div>
                        </div>
                    </div>
                }

                @* Images — server-rendered outside .prose so layout CSS works *@
                @if (Model.Discussion.Type == "Images" && Model.ImagesItems.Count > 0)
                {
                    var layout = Model.ImagesLayout ?? "grid";
                    var isSpoiler = Model.ImagesIsSpoiler;

                    // Helpers to pair the chosen source URL with its actual dimensions so <img width/height>
                    // prevents CLS and respects the real aspect ratio of whichever variant is rendered.
                    (string Url, int W, int H) pickOriginal(Snakk.Protos.Discussion.ImagesImageProto img) =>
                        (img.Url, img.Width, img.Height);

                    (string Url, int W, int H) pickThumb(Snakk.Protos.Discussion.ImagesImageProto img) =>
                        img.HasThumbnailUrl && img.HasThumbnailWidth && img.HasThumbnailHeight
                            ? (img.ThumbnailUrl, img.ThumbnailWidth, img.ThumbnailHeight)
                            : pickOriginal(img);

                    (string Url, int W, int H) pickMedium(Snakk.Protos.Discussion.ImagesImageProto img) =>
                        img.HasMediumThumbnailUrl && img.HasMediumThumbnailWidth && img.HasMediumThumbnailHeight
                            ? (img.MediumThumbnailUrl, img.MediumThumbnailWidth, img.MediumThumbnailHeight)
                            : pickOriginal(img);

                    <div class="images-display type-widget-container @(isSpoiler ? "images-spoiler" : "")" data-discussion-id="@Model.Discussion.PublicId">
                        @if (layout == "carousel")
                        {
                            var firstCarouselImg = Model.ImagesItems[0];
                            var (_, firstCarouselW, firstCarouselH) = pickOriginal(firstCarouselImg);
                            var carouselOuterStyle = firstCarouselImg.HasBlurDataUri ? $"--blur-bg: url({firstCarouselImg.BlurDataUri});" : "";
                            var carouselFrameStyle = firstCarouselW > 0 && firstCarouselH > 0
                                ? $"aspect-ratio: {firstCarouselW} / {firstCarouselH}; max-width: {firstCarouselW}px;"
                                : "";
                            <div class="images-display-framed" style="@carouselOuterStyle">
                                <div class="gup-carousel" id="images-carousel" style="@carouselFrameStyle">
                                    <div class="gup-carousel-track" id="images-carousel-track">
                                        @for (var i = 0; i < Model.ImagesItems.Count; i++)
                                        {
                                            var img = Model.ImagesItems[i];
                                            var isFirst = i == 0;
                                            var isAdjacent = i == 1;
                                            var (src, w, h) = (isFirst || isAdjacent) ? pickOriginal(img) : pickThumb(img);
                                            var carouselSrcset = (isFirst || isAdjacent) ? SnakkImageHelper.Srcset(img) : null;
                                            var blurStyle = img.HasBlurDataUri
                                                ? $"background-image:url({img.BlurDataUri});background-size:cover;background-position:center"
                                                : "";
                                            <div class="images-upload-item" data-index="@i" style="@blurStyle">
                                                @if (isSpoiler && img.HasBlurDataUri)
                                                {
                                                    <img src="@img.BlurDataUri" data-deferred-src="@src" data-full="@img.Url" width="@w" height="@h" alt=""
                                                         decoding="async" class="images-blur-up" data-blur-up />
                                                }
                                                else
                                                {
                                                    <img src="@src"
                                                    @if (carouselSrcset != null)
                                                    {
                                                        <text>srcset="@carouselSrcset" sizes="@SnakkImageHelper.DefaultSizes"</text>
                                                    }
                                                         data-full="@img.Url" width="@w" height="@h" alt="" loading="@(isFirst ? "eager" : "lazy")"@(isFirst ? " fetchpriority=\"high\"" : "")
                                                         decoding="async" class="images-blur-up" data-blur-up />
                                                }
                                            </div>
                                        }
                                    </div>
                                    @if (Model.ImagesItems.Count > 1)
                                    {
                                        <button type="button" class="gup-carousel-arrow gup-carousel-prev" id="gup-prev"><span class="icon icon-chevron-left" style="width:18px;height:18px" aria-hidden="true"></span></button>
                                        <button type="button" class="gup-carousel-arrow gup-carousel-next" id="gup-next"><span class="icon icon-chevron-right" style="width:18px;height:18px" aria-hidden="true"></span></button>
                                        <span class="gup-carousel-counter" id="images-carousel-counter">1 / @Model.ImagesItems.Count</span>
                                    }
                                </div>
                            </div>
                        }
                        else if (layout == "hero")
                        {
                            <div class="gup-hero">
                                @{
                                    var heroFirst = Model.ImagesItems[0];
                                    var (heroSrc0, heroW0, heroH0) = pickOriginal(heroFirst);
                                    var heroSrcset = SnakkImageHelper.Srcset(heroFirst);
                                    var heroOuterStyle = heroFirst.HasBlurDataUri ? $"--blur-bg: url({heroFirst.BlurDataUri});" : "";
                                    var heroFrameStyle = heroW0 > 0 && heroH0 > 0
                                        ? $"aspect-ratio: {heroW0} / {heroH0}; max-width: {heroW0}px;"
                                        : "";
                                }
                                @* Frame only wraps the first (main) image. The secondary grid
                       below is unaffected so per-cell blur + grid layout remain intact. *@
                                <div class="images-display-framed gup-hero-main" style="@heroOuterStyle">
                                    <div class="images-upload-item" style="@heroFrameStyle">
                                        @if (isSpoiler && heroFirst.HasBlurDataUri)
                                        {
                                            <img src="@heroFirst.BlurDataUri" data-deferred-src="@heroSrc0" data-full="@heroFirst.Url" width="@heroW0" height="@heroH0" alt=""
                                                 decoding="async" class="images-blur-up" data-blur-up />
                                        }
                                        else
                                        {
                                            <img src="@heroSrc0"
                                            @if (heroSrcset != null)
                                            {
                                                <text>srcset="@heroSrcset" sizes="@SnakkImageHelper.DefaultSizes"</text>
                                            }
                                                 data-full="@heroFirst.Url" width="@heroW0" height="@heroH0" alt=""
                                                 decoding="async" class="images-blur-up" data-blur-up />
                                        }
                                    </div>
                                </div>
                                @if (Model.ImagesItems.Count > 1)
                                {
                                    <div class="gup-hero-grid">
                                        @for (var i = 1; i < Model.ImagesItems.Count; i++)
                                        {
                                            var img = Model.ImagesItems[i];
                                            var (heroSrc, heroW, heroH) = pickThumb(img);
                                            <div class="images-upload-item"
                                                 style="@(img.HasBlurDataUri ? $"background-image:url({img.BlurDataUri});background-size:cover;background-position:center" : "")">
                                                @if (isSpoiler && img.HasBlurDataUri)
                                                {
                                                    <img src="@img.BlurDataUri" data-deferred-src="@heroSrc" data-full="@img.Url" width="@heroW" height="@heroH" alt=""
                                                         decoding="async" class="images-blur-up" data-blur-up />
                                                }
                                                else
                                                {
                                                    <img src="@heroSrc" data-full="@img.Url" width="@heroW" height="@heroH" alt="" loading="lazy"
                                                         decoding="async" class="images-blur-up" data-blur-up />
                                                }
                                            </div>
                                        }
                                    </div>
                                }
                            </div>
                        }
                        else if (layout == "compare" && Model.ImagesItems.Count >= 2)
                        {
                            var beforeImg = Model.ImagesItems[0];
                            var afterImg = Model.ImagesItems[1];
                            var (beforeMedium, beforeMW, beforeMH) = pickMedium(beforeImg);
                            var (afterMedium, afterMW, afterMH) = pickMedium(afterImg);
                            var (_, beforeOrigW, beforeOrigH) = pickOriginal(beforeImg);
                            var compareOuterStyle = beforeImg.HasBlurDataUri ? $"--blur-bg: url({beforeImg.BlurDataUri});" : "";
                            var compareFrameStyle = beforeOrigW > 0 && beforeOrigH > 0
                                ? $"aspect-ratio: {beforeOrigW} / {beforeOrigH}; max-width: {beforeOrigW}px;"
                                : beforeMW > 0 && beforeMH > 0
                                    ? $"aspect-ratio: {beforeMW} / {beforeMH}; max-width: {beforeMW}px;"
                                    : "";
                            <div class="images-display-framed" style="@compareOuterStyle">
                                <div class="gup-compare" id="images-compare" style="@compareFrameStyle">
                                    <div class="gup-compare-after images-upload-item"
                                         style="@(afterImg.HasBlurDataUri ? $"background-image:url({afterImg.BlurDataUri});background-size:cover;background-position:center" : "")">
                                        @if (isSpoiler && afterImg.HasBlurDataUri)
                                        {
                                            <img src="@afterImg.BlurDataUri" data-deferred-src="@afterMedium" data-full="@afterImg.Url" width="@afterMW" height="@afterMH" alt="@T.Pages.DiscImgAfter"
                                                 decoding="async" class="images-blur-up" data-blur-up />
                                        }
                                        else
                                        {
                                            <img src="@afterMedium" data-full="@afterImg.Url" width="@afterMW" height="@afterMH" alt="@T.Pages.DiscImgAfter"
                                                 decoding="async" class="images-blur-up" data-blur-up />
                                        }
                                        <span class="gup-compare-label gup-compare-label-after">@T.Pages.DiscImgAfter</span>
                                    </div>
                                    <div class="gup-compare-before images-upload-item"
                                         style="@(beforeImg.HasBlurDataUri ? $"background-image:url({beforeImg.BlurDataUri});background-size:cover;background-position:center" : "")">
                                        @if (isSpoiler && beforeImg.HasBlurDataUri)
                                        {
                                            <img src="@beforeImg.BlurDataUri" data-deferred-src="@beforeMedium" data-full="@beforeImg.Url" width="@beforeMW" height="@beforeMH" alt="@T.Pages.DiscImgBefore"
                                                 decoding="async" class="images-blur-up" data-blur-up />
                                        }
                                        else
                                        {
                                            <img src="@beforeMedium" data-full="@beforeImg.Url" width="@beforeMW" height="@beforeMH" alt="@T.Pages.DiscImgBefore"
                                                 decoding="async" class="images-blur-up" data-blur-up />
                                        }
                                        <span class="gup-compare-label gup-compare-label-before">@T.Pages.DiscImgBefore</span>
                                    </div>
                                    <div class="gup-compare-slider" id="images-compare-slider">
                                        <div class="gup-compare-line"></div>
                                        <div class="gup-compare-handle">
                                            <span class="icon icon-chevron-left" style="width:20px;height:20px" aria-hidden="true"></span>
                                            <span class="icon icon-chevron-right" style="width:20px;height:20px" aria-hidden="true"></span>
                                        </div>
                                    </div>
                                    <button type="button" class="gup-compare-expand" id="images-compare-expand"
                                            data-before-url="@beforeImg.Url"
                                            data-after-url="@afterImg.Url"
                                            data-before-blur="@(beforeImg.HasBlurDataUri ? beforeImg.BlurDataUri : "")"
                                            data-after-blur="@(afterImg.HasBlurDataUri ? afterImg.BlurDataUri : "")"
                                            aria-label="@T.Pages.DiscAriaExpandCompare">
                                        <span class="icon icon-expand-fullscreen sn-w-4 sn-h-4" aria-hidden="true"></span>
                                    </button>
                                </div>
                            </div>
                        }
                        else if (Model.ImagesItems.Count == 1)
                        {
                            @* Single image — frame wrapper holds the blur backdrop, inner
                   item is sized inline to the medium thumbnail's actual
                   rendered dimensions. Mirrors the frontpage carousel pattern. *@
                            var singleImg = Model.ImagesItems[0];
                            var (singleSrc, singleW, singleH) = pickMedium(singleImg);
                            var singleOuterStyle = singleImg.HasBlurDataUri ? $"--blur-bg: url({singleImg.BlurDataUri});" : "";
                            var singleFrameStyle = singleW > 0 && singleH > 0
                                ? $"aspect-ratio: {singleW} / {singleH}; max-width: {singleW}px;"
                                : "";
                            <div class="gup-single images-display-framed" style="@singleOuterStyle">
                                <div class="images-upload-item gup-single-item" style="@singleFrameStyle">
                                    @if (isSpoiler && singleImg.HasBlurDataUri)
                                    {
                                        <img src="@singleImg.BlurDataUri" data-deferred-src="@singleSrc" data-full="@singleImg.Url" width="@singleW" height="@singleH" alt=""
                                             decoding="async" class="images-blur-up" data-blur-up />
                                    }
                                    else
                                    {
                                        <img src="@singleSrc" data-full="@singleImg.Url" width="@singleW" height="@singleH" alt=""
                                             decoding="async" class="images-blur-up" data-blur-up />
                                    }
                                </div>
                            </div>
                        }
                        else
                        {
                            @* Grid / Masonry / Justified — all use the same item structure *@
                            <div class="gup-@layout">
                                @for (var i = 0; i < Model.ImagesItems.Count; i++)
                                {
                                    var img = Model.ImagesItems[i];
                                    var (gridSrc, gridW, gridH) = pickThumb(img);
                                    <div class="images-upload-item"
                                         style="@(img.HasBlurDataUri ? $"background-image:url({img.BlurDataUri});background-size:cover;background-position:center" : "")">
                                        @if (isSpoiler && img.HasBlurDataUri)
                                        {
                                            <img src="@img.BlurDataUri" data-deferred-src="@gridSrc" data-full="@img.Url" width="@gridW" height="@gridH" alt=""
                                                 decoding="async" class="images-blur-up" data-blur-up />
                                        }
                                        else
                                        {
                                            <img src="@gridSrc" data-full="@img.Url" width="@gridW" height="@gridH" alt="" loading="lazy"
                                                 decoding="async" class="images-blur-up" data-blur-up />
                                        }
                                    </div>
                                }
                            </div>
                        }

                        @if (layout != "compare")
                        {
                            <button type="button" class="images-expand-btn" id="images-expand-btn" aria-label="@T.Pages.DiscAriaViewFullscreen">
                                <span class="icon icon-expand-fullscreen sn-w-4 sn-h-4" aria-hidden="true"></span>
                            </button>
                        }

                        @if (Model.ImagesIsSpoiler)
                        {
                            <div class="images-spoiler-overlay" id="images-spoiler-overlay">
                                <button type="button" class="sn-images-spoiler-btn" data-action="reveal-spoiler">
                                    <span class="icon icon-eye" style="width:20px;height:20px" aria-hidden="true"></span>
                                    @(Model.ImagesItems.Count != 1 ? T.Pages.DiscRevealImages : T.Pages.DiscRevealImage)
                                </button>
                            </div>
                        }
                    </div>
                }
            </header>
        <div class="sn-center-inner">


            <!-- Locked Thread Banner -->
            @if (Model.Discussion!.IsLocked)
            {
                <div class="sn-mb-4">
                    <div class="sn-bg-warning-subtle sn-border-l-4 sn-border-warning sn-px-4 sn-py-3 sn-rounded">
                        <div class="sn-locked-banner-row">
                            <span class="icon icon-lock-closed sn-h-5 sn-w-5 sn-text-warning" aria-hidden="true"></span>
                            <p class="sn-text-sm sn-font-medium text-warning-content">
                                @T.Pages.DiscLockedBanner
                            </p>
                        </div>
                    </div>
                </div>
            }



            @if (Model.Discussion?.Type == "Iama" && Model.IamaInfo?.OfficialAnswers.Count > 0)
            {
                var qaUrl = Url.Page("/Discussions/Detail",
                    new { hubSlug = Model.HubSlug, spaceSlug = Model.SpaceSlug, slugWithId = Model.SlugWithId, sort = "qa" });
                var chronoUrl = Url.Page("/Discussions/Detail",
                    new { hubSlug = Model.HubSlug, spaceSlug = Model.SpaceSlug, slugWithId = Model.SlugWithId });
                <div class="iama-sort-toggle">
                    @if (Model.Sort == "qa")
                    {
                        <span class="iama-sort-active">@T.Iama.SortQa</span>
                        <a href="@chronoUrl" class="iama-sort-link">@T.Iama.SortChronological</a>
                    }
                    else
                    {
                        <a href="@qaUrl" class="iama-sort-link">@T.Iama.SortQa</a>
                        <span class="iama-sort-active">@T.Iama.SortChronological</span>
                    }
                </div>
            }

            <!-- Posts Container -->
            <div id="posts-container" class="sn-flex sn-flex-col">
                <!-- Load-up sentinel: hidden until entering via #post-N fragment, then shown by JS -->
                <div id="load-up-sentinel" class="sn-hidden">
                    <div id="load-up-indicator" class="sn-hidden sn-py-4 sn-flex sn-justify-center">
                        <span class="sn-spinner sn-loading-sm sn-text-muted"></span>
                    </div>
                </div>
                <!-- DOM-windowing spacer: grows when top chunks are pruned from DOM -->
                <div id="top-spacer" class="posts-spacer" style="height:0" data-end-offset="0" aria-hidden="true"></div>
                @if (Model.Posts != null && Model.Posts.Items.Any())
                {
                    var postList = Model.Posts.Items.ToList();
                    string? previousAuthorId = null;
                    DateTime? previousCreatedAt = null;

                    // For debate discussions: track the last position each author used
                    // so we can render a "position changed" timeline marker above any
                    // post where the author switched sides. Built up incrementally as
                    // we iterate posts in chronological order. Note: this only tracks
                    // positions within the currently-loaded page — switches that
                    // straddle a page boundary won't be detected.
                    var authorLastPosition = new Dictionary<string, int>();
                    var debateColors = new[] { "var(--link-primary)", "oklch(0.6 0.18 15)", "oklch(0.6 0.15 50)" };
                    string DebateColorFor(int positionIndex) =>
                        debateColors[Math.Min(positionIndex, debateColors.Length - 1)];

                    // IAmA: reorder posts depending on sort mode
                    HashSet<string> iamaQuestionIds = [];
                    Dictionary<string, string> iamaAnswerToQuestion = [];
                    List<Snakk.Protos.Post.EnrichedPostInfo> orderedPosts;
                    if (Model.Discussion?.Type == "Iama" && Model.IamaInfo?.OfficialAnswers is { Count: > 0 } iamaOfficialAnswers)
                    {
                        iamaQuestionIds = [..iamaOfficialAnswers.Keys];
                        iamaAnswerToQuestion = iamaOfficialAnswers.DistinctBy(kv => kv.Value).ToDictionary(kv => kv.Value, kv => kv.Key);
                        var postById = postList.DistinctBy(p => p.PublicId).ToDictionary(p => p.PublicId);

                        if (Model.Sort == "qa")
                        {
                            // Q&A sort: all answered pairs first (Q then A), remaining chronological after
                            var emitted = new HashSet<string>();
                            orderedPosts = new List<Snakk.Protos.Post.EnrichedPostInfo>(postList.Count);
                            foreach (var q in postList.Where(p => iamaOfficialAnswers.ContainsKey(p.PublicId)))
                            {
                                if (emitted.Contains(q.PublicId)) continue;
                                orderedPosts.Add(q);
                                emitted.Add(q.PublicId);
                                if (iamaOfficialAnswers.TryGetValue(q.PublicId, out var aId)
                                    && postById.TryGetValue(aId, out var answerPost)
                                    && !emitted.Contains(aId))
                                {
                                    orderedPosts.Add(answerPost);
                                    emitted.Add(aId);
                                }
                            }
                            foreach (var p in postList)
                                if (!emitted.Contains(p.PublicId)) orderedPosts.Add(p);
                        }
                        else
                        {
                            // Chronological with each answer placed immediately after its question
                            var emitted = new HashSet<string>();
                            orderedPosts = new List<Snakk.Protos.Post.EnrichedPostInfo>(postList.Count);
                            foreach (var p in postList)
                            {
                                if (emitted.Contains(p.PublicId)) continue;
                                orderedPosts.Add(p);
                                emitted.Add(p.PublicId);
                                if (iamaOfficialAnswers.TryGetValue(p.PublicId, out var answerId)
                                    && postById.TryGetValue(answerId, out var answerPost)
                                    && !emitted.Contains(answerId))
                                {
                                    orderedPosts.Add(answerPost);
                                    emitted.Add(answerId);
                                }
                            }
                            foreach (var p in postList)
                                if (!emitted.Contains(p.PublicId)) orderedPosts.Add(p);
                        }
                    }
                    else
                    {
                        orderedPosts = postList;
                    }

                    <div data-chunk-offset="0">
                    @for (int i = 0; i < orderedPosts.Count; i++)
                    {
                        var post = orderedPosts[i];
                        var isFirstInThread = i == 0;
                        var isNecro = post.IsNecro;
                        var nextIsNecro = i < orderedPosts.Count - 1 && orderedPosts[i + 1].IsNecro;
                        var isSameAuthorAsPrevious = !isNecro && previousAuthorId == post.Author.PublicId && !isFirstInThread;
                        var isOP = post.IsFirstPost;
                        var hasReplyTo = post.ReplyTo != null;
                        var isModerator = post.Author.Role == "mod" || post.Author.Role == "admin";
                        var isLastPost = i == orderedPosts.Count - 1;
                        var isOwnPost = Model.CurrentUserId == post.Author.PublicId;
                        var hideReplyQuote = isOwnPost && (isLastPost || isSameAuthorAsPrevious);


                        @if (isNecro && previousCreatedAt.HasValue)
                        {
                            <ul class="sn-timeline-vertical sn-mb-4">
                                <li>
                                    <hr class="sn-bg-base-content/20" />
                                    <div class="timeline-middle">
                                        <span class="icon icon-clock-solid sn-w-4 sn-h-4 sn-text-faint" aria-hidden="true"></span>
                                    </div>
                                    <div class="sn-necro-gap-label">
                                        @FormatTimeBetween(previousCreatedAt.Value, post.CreatedAt.ToDateTime())
                                    </div>
                                    <hr class="sn-bg-base-content/20" />
                                </li>
                            </ul>
                        }
                        var isJournalEntry = !isOP && Model.JournalInfo?.EntryPostPublicIds?.Contains(post.PublicId) == true;
                        var isAcceptedAnswer = !isOP && Model.QuestionStatus?.HasAcceptedPostPublicId == true && Model.QuestionStatus.AcceptedPostPublicId == post.PublicId;
                        var debatePositionId = Model.DebateInfo?.PostPositions?.ContainsKey(post.PublicId) == true ? (int?)Model.DebateInfo.PostPositions[post.PublicId] : null;

                        // Detect a position change for this author, relative to their previous post
                        // in the currently-loaded page. When detected, render a timeline marker above
                        // the current post using the same visual language as the necro marker.
                        Snakk.Protos.Discussion.DebatePositionInfo? debatePos = null;
                        Snakk.Protos.Discussion.DebatePositionInfo? debatePrevPos = null;
                        var isPositionChange = false;
                        if (debatePositionId.HasValue && Model.DebateInfo is not null)
                        {
                            debatePos = Model.DebateInfo.Positions.FirstOrDefault(p => p.Id == debatePositionId.Value);
                            if (authorLastPosition.TryGetValue(post.Author.PublicId, out var prevPositionId)
                                && prevPositionId != debatePositionId.Value)
                            {
                                debatePrevPos = Model.DebateInfo.Positions.FirstOrDefault(p => p.Id == prevPositionId);
                                isPositionChange = true;
                            }
                            authorLastPosition[post.Author.PublicId] = debatePositionId.Value;
                        }
                        @if (isPositionChange && debatePrevPos is not null && debatePos is not null)
                        {
                            <ul class="sn-timeline-vertical timeline-position-change">
                                <li>
                                    <hr />
                                    <div class="timeline-middle">
                                        <span class="icon icon-exclamation-triangle-solid sn-w-4 sn-h-4" aria-hidden="true"></span>
                                    </div>
                                    <div class="timeline-end sn-text-xs sn-uppercase sn-tracking-wide">
                                        @string.Format(T.Pages.DiscPositionChangePattern, post.Author.DisplayName, debatePrevPos.Label, debatePos.Label)
                                    </div>
                                    <hr />
                                </li>
                            </ul>
                        }

                        <article id="post-@post.PostNumber"
                                 class="post-item sn-post-article sn-post-layout @(isOP ? "sn-first-post" : "") @(isModerator ? "sn-moderator-post" : "") @(isSameAuthorAsPrevious ? "sn-same-author" : "") @(!isFirstInThread && !isSameAuthorAsPrevious ? "sn-new-author" : "") @(nextIsNecro ? "sn-before-necro" : "") @(isJournalEntry ? "journal-entry" : "") @(isAcceptedAnswer ? "accepted-answer" : "")"
                                 data-author-id="@post.Author.PublicId"
                                 data-post-id="@post.PublicId"
                                 data-public-id="@post.PublicId"
                                 data-post-number="@post.PostNumber"
                                 data-created-at="@post.CreatedAt.ToDateTime().ToString("O")"
                                 role="article"
                                 aria-label="@string.Format(T.Pages.DiscAriaPostBy, post.PostNumber, post.Author.DisplayName)">

                            @if (!isOP)
                            {
                                <!-- Left Pane: Avatar + Username -->
                                <aside class="sn-post-author-pane">
                                    @if (!isSameAuthorAsPrevious)
                                    {
                                        @if (post.Author.IsDeleted)
                                        {
                                            <div class="sn-post-avatar sn-post-avatar-deleted">
                                                <span class="icon icon-user sn-h-5 sn-w-5" aria-hidden="true"></span>
                                            </div>
                                            <span class="sn-post-author-name sn-deleted">@post.Author.DisplayName</span>
                                        }
                                        else
                                        {
                                            <img src="@post.Author.AvatarThumbnailUrl"
                                                 alt="@post.Author.DisplayName"
                                                 width="48" height="48"
                                                 class="sn-post-avatar sn-shadow-layered"
                                                 decoding="async"
                                            @(i >= 10 ? "loading=\"lazy\"" : "") />
                                            <a href="@SnakkUrlHelper.UserProfile(post.Author.Slug)"
                                               class="sn-post-author-name"
                                               data-popup-type="user"
                                               data-popup-id="@post.Author.PublicId"
                                               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
                                        }
                                        <div class="sn-post-author-badges">
                                            @if (post.Author.Role == "admin")
                                            {
                                                <span class="sn-badge sn-badge-error sn-badge-xs">@T.Pages.DiscBadgeAdmin</span>
                                            }
                                            else if (post.Author.Role == "mod")
                                            {
                                                <span class="sn-badge sn-badge-info sn-badge-xs">@T.Pages.DiscBadgeMod</span>
                                            }
                                            @if (post.IsOp)
                                            {
                                                <span class="sn-badge sn-badge-primary sn-badge-xs sn-post-badge-op sn-shadow-layered">@T.Pages.DiscBadgeOp</span>
                                            }
                                            @if (post.IsUsersFirstPostInSpace)
                                            {
                                                <span class="sn-badge sn-badge-success sn-badge-xs post-badge-new">@T.Pages.DiscBadgeNew</span>
                                            }
                                            @if (post.IsMilestone)
                                            {
                                                <span class="sn-badge sn-badge-warning sn-badge-xs sn-post-badge-milestone" title="@T.Pages.DiscBadgeMilestone">&#9733;</span>
                                            }
                                        </div>
                                        @if (Model.IsAuthenticated && !post.Author.IsDeleted && !isOwnPost)
                                        {
                                            <button type="button"
                                                    class="sn-post-author-opts sn-subtle-btn"
                                                    popovertarget="sn-author-opts-@post.PublicId"
                                                    aria-label="@T.Pages.DiscAriaAuthorOptions">
                                                <span class="icon icon-dots-horizontal sn-h-4 sn-w-4" aria-hidden="true"></span>
                                            </button>
                                            <ul id="sn-author-opts-@post.PublicId" popover class="sn-dropdown-panel sn-menu sn-w-48">
                                                <li>
                                                    <button type="button"
                                                            data-action="follow-user"
                                                            data-author-id="@post.Author.PublicId"
                                                            data-author-name="@post.Author.DisplayName"
                                                            class="sn-text-sm">
                                                        <span class="icon icon-user-follow sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                        @T.Pages.DiscFollowUser
                                                    </button>
                                                </li>
                                                <li>
                                                    <button type="button"
                                                            data-action="hide-posts-from-user"
                                                            data-author-id="@post.Author.PublicId"
                                                            data-author-name="@post.Author.DisplayName"
                                                            class="sn-text-sm">
                                                        <span class="icon icon-eye-slash sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                        @T.Pages.DiscHideFromUser
                                                    </button>
                                                </li>
                                                @if (Model.IsCurrentUserModerator)
                                                {
                                                    <li>
                                                        <button type="button"
                                                                data-action="mod-ban-user"
                                                                data-author-id="@post.Author.PublicId"
                                                                data-author-name="@post.Author.DisplayName"
                                                                class="sn-text-sm sn-text-error">
                                                            <span class="icon icon-ban sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                            @T.Pages.DiscBanUser
                                                        </button>
                                                    </li>
                                                }
                                            </ul>
                                        }
                                    }
                                </aside>
                            }

                            <!-- Right Pane: Toolbar + Content -->
                            <div class="sn-post-main">
                                <!-- Post Toolbar (hidden for first post — actions moved to header) -->
                                @if (!isOP)
                                {
                                    <div class="sn-post-toolbar">
                                        <div class="sn-post-toolbar-left">
                                            @if (isJournalEntry)
                                            {
                                                <span class="journal-entry-badge">@T.Pages.DiscJournalUpdate</span>
                                            }
                                            @if (isAcceptedAnswer)
                                            {
                                                <span class="accepted-answer-badge">@T.Pages.DiscAcceptedAnswer</span>
                                            }
                                            @if (iamaQuestionIds.Contains(post.PublicId))
                                            {
                                                <span class="iama-answered-badge">@T.Iama.Answered</span>
                                            }
                                            @if (iamaAnswerToQuestion.TryGetValue(post.PublicId, out var iamaLinkedQuestionId))
                                            {
                                                var iamaQuestion = orderedPosts.FirstOrDefault(p => p.PublicId == iamaLinkedQuestionId);
                                                <a class="iama-answer-badge" href="#post-@iamaQuestion?.PostNumber">@T.Iama.AnswerTo #@iamaQuestion?.PostNumber</a>
                                            }
                                            @if (debatePos is not null)
                                            {
                                                <span class="debate-position-badge" style="--badge-color:@DebateColorFor(debatePos.Index)">@debatePos.Label</span>
                                            }
                                            @if (!isOP)
                                            {
                                                @if (isSameAuthorAsPrevious)
                                                {
                                                    <span class="sn-post-author-inline sn-hidden">
                                                        @if (post.Author.IsDeleted)
                                                        {
                                                            <span class="sn-deleted">@post.Author.DisplayName</span>
                                                        }
                                                        else
                                                        {
                                                            <a href="@SnakkUrlHelper.UserProfile(post.Author.Slug)"
                                                               data-popup-type="user"
                                                               data-popup-id="@post.Author.PublicId"
                                                               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
                                                        }
                                                    </span>
                                                }
                                                else
                                                {
                                                    <span class="sn-post-author-inline">
                                                        @if (post.Author.IsDeleted)
                                                        {
                                                            <span class="sn-deleted">@post.Author.DisplayName</span>
                                                        }
                                                        else
                                                        {
                                                            <a href="@SnakkUrlHelper.UserProfile(post.Author.Slug)"
                                                               data-popup-type="user"
                                                               data-popup-id="@post.Author.PublicId"
                                                               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
                                                        }
                                                    </span>
                                                }
                                            }
                                            <span class="sn-post-time">
                                                <time data-timestamp="@post.CreatedAt.ToDateTime().ToString("O")">@Model.FormatRelativeTime(post.CreatedAt.ToDateTime())</time>@if (post.EditedAt != null)
                                                {
                                                    <span class="post-edited"> @T.Pages.DiscEdited</span>
                                                }
                                            </span>
                                            <span aria-hidden="true">·</span>
                                            <span class="sn-post-number">#@post.PostNumber</span>
                                        </div>
                                        <div class="sn-post-toolbar-right">
                                            @if (!isOP && Model.IsAuthenticated)
                                            {
                                                <div class="sn-post-inline-actions" hidden>
                                                    @if (isOwnPost || Model.IsCurrentUserModerator)
                                                    {
                                                        <button hx-get="/bff/posts/@post.PublicId/history"
                                                                hx-target="#history-modal-content"
                                                                hx-swap="innerHTML"
                                                                data-modal-open="history_modal"
                                                                class="sn-btn sn-btn-outline sn-btn-sm sn-post-action-btn"
                                                                title="@T.Pages.DiscHistory"
                                                                aria-label="@T.Pages.DiscHistory">
                                                            <span class="icon icon-clock sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                            @T.Pages.DiscHistory
                                                        </button>
                                                    }
                                                    <button type="button"
                                                            data-action="toggle-save-post"
                                                            data-post-id="@post.PublicId"
                                                            data-saved="false"
                                                            aria-pressed="false"
                                                            class="sn-btn sn-btn-outline sn-btn-sm sn-post-action-btn sn-post-save-btn"
                                                            title="@T.Pages.DiscSaveTitle"
                                                            aria-label="@T.Pages.DiscSavePost">
                                                        <span class="icon icon-bookmark-alt sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                        @T.Pages.DiscSavePost
                                                    </button>
                                                    @if (!isOwnPost)
                                                    {
                                                        <button type="button"
                                                                data-action="open-report-modal"
                                                                data-report-type="post"
                                                                data-report-id="@post.PublicId"
                                                                data-report-label="@T.Pages.DiscReportThisPost"
                                                                class="sn-btn sn-btn-outline sn-btn-sm sn-post-action-btn"
                                                                title="@T.Pages.DiscReportPost"
                                                                aria-label="@T.Pages.DiscReportPost">
                                                            <span class="icon icon-exclamation-triangle sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                            @T.Pages.DiscReportPost
                                                        </button>
                                                    }
                                                    @if (Model.IsCurrentUserModerator)
                                                    {
                                                        <button type="button"
                                                                data-action="mod-delete-post"
                                                                data-post-id="@post.PublicId"
                                                                class="sn-btn sn-btn-outline sn-btn-sm sn-post-action-btn sn-text-error"
                                                                title="@T.Pages.DiscRemovePost"
                                                                aria-label="@T.Pages.DiscRemovePost">
                                                            <span class="icon icon-trash sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                            @T.Pages.DiscRemovePost
                                                        </button>
                                                    }
                                                </div>
                                                <button type="button"
                                                        class="sn-subtle-btn sn-post-opts-toggle"
                                                        data-action="toggle-post-inline-actions"
                                                        aria-label="@T.Pages.DiscAriaPostOptions">
                                                    <span class="icon icon-dots-horizontal sn-h-4 sn-w-4" aria-hidden="true"></span>
                                                </button>
                                            }
                                            <partial name="_PostReactions" model="@(new PostReactionsVM(
                                                PostPublicId: post.PublicId,
                                                Counts: (post.Reactions?.Counts?.Counts ?? new Google.Protobuf.Collections.MapField<string, int>()).ToDictionary(k => k.Key, k => k.Value),
                                                MyReactions: post.Reactions?.UserReactions?.Reactions?.ToList() ?? new List<string>(),
                                                IsOp: false,
                                                IsAuthenticated: Model.IsAuthenticated,
                                                IsLocked: Model.Discussion!.IsLocked))" />
                                        </div>
                                    </div>
                                }

                                <!-- Reply-to Quote Block -->
                                @if (hasReplyTo)
                                {
                                    <div class="sn-post-reply-quote">
                                        <span class="sn-quote-author">@string.Format(T.Pages.DiscQuoteWrotePattern, post.ReplyTo!.AuthorName)</span>
                                        <p class="line-clamp-2 sn-mt-1">@post.ReplyTo!.ContentSnippet</p>
                                    </div>
                                }

                                <!-- Post Content -->
                                <div id="post-content-@post.PublicId"
                                     class="sn-post-body sn-prose sn-prose-content"
                                     data-author-name="@post.Author.DisplayName"
                                     data-raw-content="@(post.Content ?? "")">
                                    @Html.SanitizedRaw(post.RenderedContent)
                                </div>
                            </div>

                        </article>

                        previousAuthorId = post.Author.PublicId;
                        previousCreatedAt = post.CreatedAt.ToDateTime();
                    }
                    </div>

                    <!-- DOM-windowing spacer: grows when bottom chunks are pruned from DOM -->
                    <div id="bottom-spacer" class="posts-spacer" style="height:0" data-start-offset="0" aria-hidden="true"></div>
                    <!-- Endless scroll sentinel -->
                    <div id="scroll-sentinel" class="h-4"></div>
                    <div id="loading-indicator" class="sn-hidden">
                        <!-- Skeleton loaders -->
                        <div class="sn-skeleton-post sn-post-layout">
                            <aside class="sn-post-author-pane">
                                <div class="sn-skeleton sn-w-12 sn-h-12 sn-rounded-full"></div>
                                <div class="sn-skeleton sn-h-3 sn-w-16 sn-mt-2"></div>
                            </aside>
                            <div class="sn-post-main">
                                <div class="sn-skeleton sn-skeleton-line skeleton-width-30"></div>
                                <div class="sn-skeleton sn-skeleton-line sn-mt-3"></div>
                                <div class="sn-skeleton sn-skeleton-line"></div>
                                <div class="sn-skeleton sn-skeleton-line sn-short"></div>
                            </div>
                        </div>
                        <div class="sn-skeleton-post sn-post-layout">
                            <aside class="sn-post-author-pane">
                                <div class="sn-skeleton sn-w-12 sn-h-12 sn-rounded-full"></div>
                                <div class="sn-skeleton sn-h-3 sn-w-14 sn-mt-2"></div>
                            </aside>
                            <div class="sn-post-main">
                                <div class="sn-skeleton sn-skeleton-line skeleton-width-25"></div>
                                <div class="sn-skeleton sn-skeleton-line sn-mt-3"></div>
                                <div class="sn-skeleton sn-skeleton-line sn-short"></div>
                            </div>
                        </div>
                    </div>
                    <div id="end-message" class="@(Model.IsAuthenticated ? "sn-thread-end-message" : "") sn-hidden">
                        @if (!Model.IsAuthenticated)
                        {
                            ViewData["Nudge.Title"] = T.Pages.DiscNudgeJoinTitle;
                            ViewData["Nudge.Body"] = T.Pages.DiscNudgeJoinBody;
                            <partial name="Shared/_RegistrationNudge" />
                        }
                        else
                        {
                            @T.Pages.DiscEndReached
                        }
                    </div>
                    <div id="load-error-message" class="sn-hidden sn-text-center sn-py-8">
                        <div class="sn-load-error-card">
                            <span class="icon icon-exclamation-triangle sn-h-8 sn-w-8 sn-text-error" aria-hidden="true"></span>
                            <p class="sn-text-sm sn-text-error sn-font-medium">@T.Pages.DiscLoadFailed</p>
                            <button data-action="retry-load-posts" class="sn-btn sn-btn-sm sn-btn-primary">
                                <span class="icon icon-refresh sn-h-4 sn-w-4" aria-hidden="true"></span>
                                @T.Pages.DiscRetry
                            </button>
                        </div>
                    </div>
                }
                else
                {
                    <div class="empty-state-simple">
                        <h3>@T.Pages.DiscStartConvHeading</h3>
                        <p>@T.Pages.DiscStartConvBody</p>
                    </div>
                }
            </div>

            <!-- Reply Form -->
            <!-- Realtime lock banner (shown dynamically via SignalR when discussion is locked while viewing) -->
            <div id="discussion-lock-banner" class="sn-mt-8 sn-hidden">
                <div class="sn-clean-card sn-p-6 sn-text-center">
                    <h3 class="sn-font-semibold sn-mb-1">@T.Pages.DiscLockedTitle</h3>
                    <p class="sn-text-sm sn-text-muted">@T.Pages.DiscLockedBody</p>
                </div>
            </div>

            @if (Model.Discussion!.IsLocked)
            {
                <div class="sn-mt-8">
                    <div class="sn-clean-card sn-p-6 sn-text-center">
                        <h3 class="sn-font-semibold sn-mb-1">@T.Pages.DiscLockedTitle</h3>
                        <p class="sn-text-sm sn-text-muted">@T.Pages.DiscLockedBody</p>
                    </div>
                </div>
            }
            else if (Model.IsAuthenticated)
            {
                <!-- Typing indicator — below posts, visible while reading -->
                <div id="typing-indicator" class="sn-typing-indicator sn-hidden"></div>
            }

        </div> <!-- End sn-center-inner -->

        @* Compose drawer + floating button — outside sn-center-inner, fixed to viewport *@
        @if (Model.IsAuthenticated && !Model.Discussion!.IsLocked)
        {
            <div id="compose-drawer" class="sn-compose-drawer" role="dialog" aria-label="@T.Pages.DiscPostReply">
                <div class="sn-compose-drawer-panel">
                    <div class="sn-compose-drawer-header">
                        <div id="reply-context" class="sn-reply-context-bar sn-hidden">
                            <span class="sn-text-sm sn-text-muted">
                                @T.Pages.DiscReplyingToPrefix<span id="reply-context-author" class="sn-font-semibold"></span>
                            </span>
                            <button type="button" data-action="clear-reply-context" class="sn-subtle-btn">
                                @T.Pages.DiscCancel
                            </button>
                        </div>
                        <button type="button" data-action="close-compose" class="sn-subtle-btn sn-ml-auto" aria-label="@T.Pages.DiscClose">
                            <span class="icon icon-chevron-down sn-h-4 sn-w-4" aria-hidden="true"></span>
                        </button>
                    </div>
                    <div class="sn-compose-drawer-body">
                        <div class="sn-composer-area">
                            <form method="post" id="reply-form" hx-boost="false">
                                <input type="hidden" name="ReplyToPostId" id="reply-to-post-id" value="" />
                                <textarea name="PostContent" id="post-content-input" style="display:none"></textarea>
                                <div id="editor-container">
                                    <div class="sn-editor-skeleton">
                                        <div class="sn-editor-skeleton-toolbar">
                                            <div class="sn-skeleton-pill"></div>
                                            <div class="sn-skeleton-pill"></div>
                                            <div class="sn-skeleton-pill"></div>
                                            <div class="sn-skeleton-pill sn-w-6"></div>
                                            <div class="sn-skeleton-pill"></div>
                                            <div class="sn-skeleton-pill"></div>
                                        </div>
                                        <div class="sn-editor-skeleton-body">
                                            <div class="sn-skeleton-line sn-w-3/4"></div>
                                            <div class="sn-skeleton-line sn-w-1/2"></div>
                                            <div class="sn-skeleton-line sn-w-5/6"></div>
                                        </div>
                                    </div>
                                </div>
                                <div id="upload-progress-row" class="sn-upload-progress-row sn-hidden">
                                    <div id="upload-image-chips" class="sn-upload-image-chips"></div>
                                    <span id="upload-status-text" class="sn-upload-status-text"></span>
                                </div>
                                <div class="sn-composer-submit-row">
                                    <button type="submit" id="reply-submit-btn" class="sn-btn sn-btn-primary sn-btn-sm sn-hidden">
                                        <span id="reply-submit-label">@T.Pages.DiscPostReply</span>
                                        <span id="reply-submit-spinner" class="sn-spinner sn-loading-xs sn-hidden"></span>
                                    </button>
                                    <span id="draft-restored-msg" class="sn-text-xs sn-text-faint sn-hidden">@T.Pages.DiscDraftRestored</span>
                                </div>
                            </form>
                        </div>
                    </div>
                </div>
            </div>

            <div id="compose-btn-wrap" class="sn-compose-btn-wrap">
                <button type="button" class="sn-btn sn-btn-primary sn-btn-circle sn-btn-lg sn-compose-btn" data-action="open-compose" aria-label="@T.Pages.DiscPostReply" title="@T.Pages.DiscPostReply">
                    <span class="icon icon-pencil sn-icon--md" aria-hidden="true"></span>
                </button>
            </div>
        }
        @if (Model.Discussion.PostCount > 1 && Model.Posts?.HasMoreItems == true)
        {
            <div id="thread-nav" class="sn-thread-nav sn-hidden">
                <div class="sn-thread-nav-controls">
                    <button class="sn-thread-nav-btn" data-nav="first" title="@T.Pages.DiscTitleFirst" aria-label="@T.Pages.DiscAriaJumpFirst">
                        <span class="icon icon-thread-nav-first sn-w-3\.5 sn-h-3\.5" aria-hidden="true"></span>
                    </button>
                    <button class="sn-thread-nav-btn" data-nav="prev" title="@T.Pages.DiscAriaBack20" aria-label="@T.Pages.DiscAriaBack20">
                        <span class="icon icon-thread-nav-prev sn-w-3\.5 sn-h-3\.5" aria-hidden="true"></span>
                    </button>
                    <div class="sn-thread-nav-position">
                        <input id="thread-nav-input" type="number" class="sn-thread-nav-input" min="1" max="@Model.Discussion.PostCount" value="1" aria-label="@T.Pages.DiscAriaCurrentPost" />
                        <span class="sn-thread-nav-separator">/</span>
                        <span id="thread-nav-total" class="sn-thread-nav-total">@Model.Discussion.PostCount</span>
                    </div>
                    <button class="sn-thread-nav-btn" data-nav="next" title="@T.Pages.DiscAriaForward20" aria-label="@T.Pages.DiscAriaForward20">
                        <span class="icon icon-thread-nav-next sn-w-3\.5 sn-h-3\.5" aria-hidden="true"></span>
                    </button>
                    <button class="sn-thread-nav-btn" data-nav="last" title="@T.Pages.DiscTitleLast" aria-label="@T.Pages.DiscAriaJumpLast">
                        <span class="icon icon-thread-nav-last sn-w-3\.5 sn-h-3\.5" aria-hidden="true"></span>
                    </button>
                </div>
            </div>
        }
    }
    else
    {
        <div class="sn-center-inner">
            <div class="sn-max-w-xl sn-mx-auto empty-state-simple">
                <h3>@T.Pages.DiscNotFoundHeading</h3>
                <p>@T.Pages.DiscNotFoundBody</p>
                <a href="/hubs" class="sn-btn sn-btn-primary sn-btn-sm sn-mt-4">@T.Pages.DiscBackToHubs</a>
            </div>
        </div>
    }

</div> <!-- End sn-center -->
<!-- Right Column -->
@if (!DeviceDetection.IsMobile(HttpContext))
{
<aside class="sn-right">
    @{
        ViewData["RightPane.NewDiscussionUrl"] = Model.Space != null ? "/create?spaceId=" + Model.Space.PublicId : "/create";
        ViewData["RightPane.Actions"] = Model.IsCurrentUserModerator
            ? new[] { "share", "subscribe", "save", "mod-discussion" }
            : new[] { "share", "subscribe", "save" };
        ViewData["RightPane.ModDiscussionId"] = Model.Discussion!.PublicId;
        ViewData["RightPane.ModIsLocked"] = Model.Discussion.IsLocked;
        ViewData["RightPane.ShareUrl"] = Model.CanonicalUrl;
        ViewData["RightPane.ShareTitle"] = Model.Discussion!.Title;
        ViewData["RightPane.ShareIsPublic"] = Model.Space is not { IsRestricted: true };
        ViewData["RightPane.SubscribeAction"] = "toggle-follow-discussion";
        ViewData["RightPane.SubscribeEntityAttr"] = "discussion-id";
        ViewData["RightPane.SubscribeEntityId"] = Model.Discussion.PublicId;
        ViewData["RightPane.SaveDiscussionId"] = Model.Discussion.PublicId;
    }
    <div class="sn-right-sticky">
        <partial name="Shared/_RightActionPane" />
        <div class="sn-right-body">
            @if (Model.SpaceStats != null)
            {
                <div class="sn-right-section">
                    <div class="sn-right-title">
                        <span class="icon icon-chart-bar" aria-hidden="true"></span>
                        @T.Sections.SpaceStats
                    </div>
                    <div class="sn-sidebar-stats">
                        <div class="sn-stats sn-shadow-layered-light">
                            <div class="sn-stat">
                                <div class="sn-stat-title">@T.Pages.DiscStatsDiscussions</div>
                                <div class="sn-stat-value">@FormatCount(Model.SpaceStats.DiscussionCount)</div>
                            </div>
                        </div>
                        <div class="sn-stats sn-shadow-layered-light">
                            <div class="sn-stat">
                                <div class="sn-stat-title">@T.Pages.DiscStatsReplies</div>
                                <div class="sn-stat-value">@FormatCount(Model.SpaceStats.ReplyCount)</div>
                            </div>
                        </div>
                        <div class="sn-stats sn-shadow-layered-light">
                            <div class="sn-stat">
                                <div class="sn-stat-title">@T.Pages.DiscStatsFollowers</div>
                                <div class="sn-stat-value">@FormatCount(Model.SpaceStats.FollowerCount)</div>
                            </div>
                        </div>
                        @if (Model.Space != null)
                        {
                            <div class="sn-stats sn-shadow-layered-light">
                                <div class="sn-stat">
                                    <div class="sn-stat-title">@T.Pages.DiscStatsActivity</div>
                                    <div class="sn-sparkline-container sn-right-sparkline"
                                         data-sparkline-type="space"
                                         data-sparkline-id="@Model.Space.PublicId"
                                         data-sparkline-days="7"></div>
                                </div>
                            </div>
                        }
                    </div>
                </div>
            }
            @if (Model.Space != null)
            {
                <div class="sn-right-section">
                    <div class="sn-right-title">
                        <span class="icon icon-info-circle" aria-hidden="true"></span>
                        @T.Pages.DiscAboutPrefix@Model.Space?.Name
                    </div>
                    @if (!string.IsNullOrEmpty(Model.Space?.Description))
                    {
                        <p class="sn-text-sm sn-mb-3" style="color: var(--text-secondary)">@Model.Space.Description</p>
                    }
                </div>
            }

            @if (Model.Space?.HasRules == true)
            {
                <div class="sn-right-section">
                    <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.Space.Slug)/rules"
                           class="sn-sidebar-nav-link--detail">
                        <span>@T.Pages.DiscSpaceRules</span>
                        <span class="icon icon-chevron-right sn-w-3\.5 sn-h-3\.5 sn-shrink-0" aria-hidden="true"></span>
                    </a>
                    <inline-or-htmx partial="Shared/Sidebar/_SpaceRules"
                                    model="Model.InlineSpaceRules"
                                    htmx-url="/partials/space-rules?spaceId=@Model.Space.PublicId&rev=@Model.Space.RulesRevision">
                        <div class="sn-sidebar-skeleton-list" style="min-height:4rem">
                            <div class="sn-skeleton sn-h-4 sn-w-full"></div>
                            <div class="sn-skeleton sn-h-4 sn-w-5/6"></div>
                            <div class="sn-skeleton sn-h-4 sn-w-4/6"></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }

            @if (Model.Space != null)
            {
                <div class="sn-right-section">
                    <a href="@(SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug))/moderators"
                           class="sn-sidebar-nav-link--detail">
                        <span>@T.Pages.DiscSpaceModerators</span>
                        <span class="sn-sidebar-title-suffix">
                            @if (Model.InlineModerators?.Moderators?.TotalCount is int modCount && modCount > 0)
                            {
                                <span class="sn-text-xs sn-font-normal" style="color: var(--text-tertiary)">(@modCount)</span>
                            }
                            <span class="icon icon-chevron-right sn-w-3\.5 sn-h-3\.5 sn-shrink-0" aria-hidden="true"></span>
                        </span>
                    </a>
                    <inline-or-htmx partial="Shared/Sidebar/_Moderators"
                                    model="Model.InlineModerators"
                                    htmx-url="/partials/moderators?scopeType=Space&scopeId=@Model.Space.PublicId&moderatorsUrl=@(SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug))/moderators&rev=@Model.Space.TeamRevision">
                        <div class="sn-grid sn-grid-cols-8 sn-gap-1">
                            <div class="sn-skeleton sn-rounded-full aspect-square sn-w-full"></div>
                            <div class="sn-skeleton sn-rounded-full aspect-square sn-w-full"></div>
                            <div class="sn-skeleton sn-rounded-full aspect-square sn-w-full"></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }
        </div>
    </div>
</aside>
}

<!-- History Modal -->
<dialog id="history_modal" class="sn-modal">
    <div class="sn-modal-box sn-max-w-2xl">
        <div class="sn-modal-header">
            <h3 class="sn-font-semibold sn-text-lg">@T.Pages.DiscEditHistoryTitle</h3>
            <form method="dialog">
                <button class="sn-subtle-btn">@T.Pages.DiscClose</button>
            </form>
        </div>
        <div id="history-modal-content" class="sn-modal-loading-area">
            <span class="sn-spinner sn-loading-md sn-text-muted"></span>
        </div>
    </div>
    <form method="dialog" class="sn-modal-backdrop-overlay">
        <button>close</button>
    </form>
</dialog>

<!-- Report Modal -->
<dialog id="report_modal" class="sn-modal">
    <div class="sn-modal-box sn-max-w-md">
        <div class="sn-modal-header">
            <h3 class="sn-font-semibold sn-text-lg">@T.Pages.DiscReportContentTitle</h3>
            <form method="dialog">
                <button class="sn-subtle-btn">@T.Pages.DiscClose</button>
            </form>
        </div>
        <p class="sn-modal-description">
            @T.Pages.DiscReportingPrefix<span id="report-target-description" class="sn-font-medium"></span>@T.Pages.DiscReportingSuffix
        </p>
        <form id="report-form" data-submit-action="submit-report">
            <input type="hidden" id="report-type" name="type" value="" />
            <input type="hidden" id="report-target-id" name="targetId" value="" />

            <div class="sn-field sn-mb-4">
                <label class="sn-label">
                    <span class="sn-label-text">@T.Pages.DiscReportReasonLabel <span class="sn-text-error">*</span></span>
                </label>
                <select id="report-reason" name="reasonId" class="sn-select sn-w-full" required>
                    <option value="">@T.Pages.DiscReportSelectReason</option>
                </select>
                <div id="report-reason-description" class="sn-text-xs sn-text-muted sn-mt-1 sn-hidden"></div>
            </div>

            <div class="sn-field sn-mb-4">
                <label class="sn-label">
                    <span class="sn-label-text">@T.Pages.DiscReportAdditional</span>
                </label>
                <textarea id="report-details"
                          name="details"
                          class="sn-textarea sn-w-full"
                          rows="3"
                          placeholder="@T.Pages.DiscReportDetailsPh"></textarea>
            </div>

            <div id="report-error" class="sn-alert sn-alert-error sn-text-sm sn-mb-4 sn-hidden">
                <span id="report-error-message"></span>
            </div>

            <div class="sn-modal-action">
                <button type="button" data-modal-close="report_modal" class="sn-btn sn-btn-ghost">@T.Pages.DiscCancel</button>
                <button type="submit" id="report-submit-btn" class="sn-btn sn-btn-error">
                    <span id="report-submit-text">@T.Pages.DiscSubmitReport</span>
                    <span id="report-submit-loading" class="sn-spinner sn-loading-sm sn-hidden"></span>
                </button>
            </div>
        </form>
    </div>
    <form method="dialog" class="sn-modal-backdrop-overlay">
        <button>close</button>
    </form>
</dialog>

@if (Model.IsCurrentUserModerator)
{
<!-- Mod: Ban User Modal -->
<dialog id="mod_ban_modal" class="sn-modal">
    <div class="sn-modal-box sn-max-w-md">
        <div class="sn-modal-header">
            <h3 class="sn-font-semibold sn-text-lg">Ban User</h3>
            <form method="dialog">
                <button class="sn-subtle-btn">Close</button>
            </form>
        </div>
        <p class="sn-modal-description">
            Banning <strong id="mod-ban-author-name"></strong>
        </p>
        <div class="sn-field sn-mb-3">
            <label class="sn-label"><span class="sn-label-text">Scope</span></label>
            <select id="mod-ban-scope" class="sn-select sn-w-full">
                <option value="space">This space</option>
                <option value="hub">This hub</option>
                <option value="community">This community</option>
                <option value="platform">Platform (global)</option>
            </select>
        </div>
        <div class="sn-field sn-mb-3">
            <label class="sn-label"><span class="sn-label-text">Duration</span></label>
            <select id="mod-ban-type" class="sn-select sn-w-full">
                <option value="Temporary">Temporary</option>
                <option value="Permanent">Permanent</option>
            </select>
        </div>
        <div id="mod-ban-duration-row" class="sn-field sn-mb-3">
            <label class="sn-label"><span class="sn-label-text">Duration (hours)</span></label>
            <input type="number" id="mod-ban-duration-hours" class="sn-input sn-w-full" value="24" min="1" max="8760" />
        </div>
        <div class="sn-field sn-mb-4">
            <label class="sn-label"><span class="sn-label-text">Reason</span></label>
            <textarea id="mod-ban-reason" class="sn-textarea sn-w-full" rows="2" placeholder="Optional reason…"></textarea>
        </div>
        <div id="mod-ban-error" class="sn-alert sn-alert-error sn-text-sm sn-mb-4 sn-hidden"></div>
        <div class="sn-modal-action">
            <button type="button" data-modal-close="mod_ban_modal" class="sn-btn sn-btn-ghost">Cancel</button>
            <button type="button" id="mod-ban-submit" class="sn-btn sn-btn-error">Ban</button>
        </div>
    </div>
    <form method="dialog" class="sn-modal-backdrop-overlay">
        <button>close</button>
    </form>
</dialog>
}

<!-- Reaction Picker -->
<div id="reaction-picker" class="sn-reaction-picker sn-hidden" data-post-id="">
    <div class="sn-grid sn-grid-cols-3 sn-gap-1">
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="Agree" title="@T.Pages.DiscReactionAgree">👍</button>
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="Love" title="@T.Pages.DiscReactionLove">❤️</button>
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="Funny" title="@T.Pages.DiscReactionFunny">😂</button>
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="Thinking" title="@T.Pages.DiscReactionThinking">🤔</button>
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="Watching" title="@T.Pages.DiscReactionWatching">👀</button>
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="Fire" title="@T.Pages.DiscReactionFire">🔥</button>
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="Thanks" title="@T.Pages.DiscReactionThanks">🙏</button>
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="MindBlown" title="@T.Pages.DiscReactionMindBlown">🤯</button>
        <button type="button" class="sn-reaction-picker-btn" data-reaction-type="ShipIt" title="@T.Pages.DiscReactionShipIt">🚀</button>
    </div>
</div>

<!-- Utility Scripts -->
@if (User.Identity?.IsAuthenticated != true)
{
    @* DOMPurify for SnakkUtils.sanitizeHtml on rendered post content. The layout
       already loads it for authenticated users (alongside realtime). *@
    <script id="js-dompurify" hx-preserve src="@SnakkUrlHelper.Js("dompurify.min", isVendor: true)" asp-append-version="true" defer></script>
}
<script src="@SnakkUrlHelper.Js("services/read-history")" defer></script>
@if (User.Identity?.IsAuthenticated == true)
{
    @* Auth-only features: follows/mutes, reply drafts, server-side read state.
       discussion-detail.ts existence-checks all three globals, so omitting the
       scripts for anonymous visitors is safe. CacheManager (follow-cache's base
       class) ships in the layout's auth-bundle, which loads earlier in the DOM. *@
    <script src="@SnakkUrlHelper.Js("services/follow-cache")" defer></script>
    <script src="@SnakkUrlHelper.Js("services/draft-manager")" defer></script>
    <script src="@SnakkUrlHelper.Js("services/read-state-batcher")" defer></script>
}

@if (Model.Discussion?.Type == "Poll")
{
    <script src="@SnakkUrlHelper.Js("components/poll-widget")" asp-append-version="true" defer></script>
}
@if (Model.Discussion?.Type == "Iama")
{
    <script src="@SnakkUrlHelper.Js("components/iama-countdown")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/iama-widget")" asp-append-version="true" defer></script>
}
@* lightbox ships in the layout's app-bundle on every page *@
@if (Model.Discussion?.Type is not "Standard" and not "Poll")
{
    <script src="@SnakkUrlHelper.Js("components/discussion-type-widgets")" asp-append-version="true" defer></script>
}
@* Markdown editor (488KB) — lazy-loaded when reply form enters viewport or user clicks reply/edit *@
<script id="editor-loader-config" type="application/json">{"editorSrc":"@SnakkUrlHelper.Js("components/markdown-editor")"}</script>
<script src="@SnakkUrlHelper.Js("core/editor-loader")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/discussion-detail")" asp-append-version="true" defer></script>
@* Discussion config — parsed by discussion-detail.ts (CSP-safe: type=application/json is not executed) *@
<script type="application/json" id="discussion-page-config">
    @Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
    {
        discussionId = Model.Discussion?.PublicId ?? "",
        isAuthenticated = Model.IsAuthenticated,
        currentUserId = Model.CurrentUserId ?? "",
        isLocked = Model.Discussion?.IsLocked == true,
        spaceId = Model.Space?.PublicId ?? "",
        preferEndlessScroll = true,
        postsCurrentOffset = Model.Posts?.Items?.Count() ?? 0,
        postsHasMoreItems = Model.Posts?.HasMoreItems == true,
        hasCodeBlocks = Model.HasCodeBlocks,
        postCount = Model.Discussion?.PostCount ?? 0,
        displayName = Model.CurrentUserDisplayName ?? "",
        discussionType = Model.Discussion?.Type ?? "",
        spaceSlug = Model.SpaceSlug ?? "",
        hubSlug = Model.HubSlug ?? "",
        hubId = Model.Hub?.PublicId ?? "",
        communityId = Model.CommunityDetail?.PublicId ?? "",
        readHistory = Model.Discussion != null ? new
        {
            discussionPublicId = Model.Discussion.PublicId,
            discussionTitle = Model.Discussion!.Title,
            discussionSlug = Model.SlugWithId.Split('~')[0],
            spacePublicId = Model.Space?.PublicId ?? "",
            spaceSlug = Model.SpaceSlug ?? "",
            spaceName = Model.Space?.Name ?? Model.SpaceSlug ?? "",
            hubPublicId = Model.Hub?.PublicId ?? "",
            hubSlug = Model.HubSlug ?? "",
            hubName = Model.Hub?.Name ?? Model.HubSlug ?? "",
            communityPublicId = Model.CommunityDetail?.PublicId ?? "",
            communitySlug = Model.Community.CommunitySlug ?? "",
            communityName = Model.Community.CommunityName ?? Model.Community.CommunitySlug ?? "",
            isMultiCommunity = Model.Community.IsMultiCommunityEnabled,
            lastActivityAt = (Model.Discussion.LastActivityAt?.ToDateTime() ?? Model.Discussion.CreatedAt.ToDateTime()).ToString("O")
        } : (object?)null,
        officialAnswers = Model.Discussion?.Type == "Iama" && Model.IamaInfo != null
            ? Model.IamaInfo.OfficialAnswers.ToDictionary(kv => kv.Key, kv => kv.Value)
            : (object?)null,
        sort = Model.Sort,
        lastReadPostId = Model.LastReadPostId,
        isModerator = Model.IsCurrentUserModerator
    }, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
</script>
