@page "/settings/account"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Settings.AccountModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Account Settings";

    var settingsAvatarFileName = User.FindFirst("AvatarFileName")?.Value;
    var hasUploadedAvatar = !string.IsNullOrEmpty(settingsAvatarFileName);
    var settingsAvatarUrl = SnakkUrlHelper.UserAvatar(Model.UserId ?? "", avatarFileName: settingsAvatarFileName);
    var settingsGeneratedUrl = SnakkUrlHelper.UserAvatar(Model.UserId ?? "");
}

@section LeftColumn {
<aside class="fp-left">
<div class="fp-left-sticky">
    <partial name="Shared/_SettingsNav" />
</div>
</aside>
}

<!-- Center Column -->
<div class="fp-center">
    <div class="fp-center-inner">
        <div class="fp-settings-content">

            <!-- Avatar -->
            <div id="section-avatar" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Avatar</h3>
                <form id="avatar-upload-form" class="flex flex-col gap-4">
                    <div class="flex items-center gap-4">
                        <div class="avatar avatar-xl shrink-0">
                            <img src="@settingsAvatarUrl"
                                 alt="Your avatar"
                                 width="80" height="80"
                                 id="avatar-preview"
                                 data-generated-url="@settingsGeneratedUrl" />
                        </div>
                        <div class="text-sm" style="color: var(--text-tertiary)">
                            Upload a custom avatar or use the auto-generated one.
                            <br />Supported: JPEG, PNG, WebP. Max 2MB.
                        </div>
                    </div>

                    <input type="file" id="avatar-file" name="avatar"
                           accept="image/jpeg,image/png,image/webp" class="hidden" />

                    <div id="avatar-drop-zone" class="gallery-drop-zone">
                        <div class="gallery-drop-zone-content">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-base-content/30 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            <span class="text-sm text-base-content/50" id="avatar-drop-label">Click or drag an image here</span>
                        </div>
                    </div>

                    <div class="flex gap-2">
                        <button type="submit" class="btn btn-primary btn-sm" id="upload-btn" disabled>
                            Upload Avatar
                        </button>
                        <button type="button"
                                class="btn btn-ghost btn-sm"
                                id="delete-avatar-btn"
                                @(hasUploadedAvatar ? "" : "disabled")>
                            Use Generated
                        </button>
                    </div>
                </form>

                <div id="upload-status" class="mt-3 text-sm hidden"></div>
            </div>

            <!-- Display Name -->
            <div id="section-display-name" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Display Name</h3>
                <div id="display-name-status" class="text-sm mb-3 hidden"></div>

                <form id="display-name-form" asp-page-handler="UpdateDisplayName" class="flex flex-col gap-3">
                    <div>
                        <input type="text"
                               name="displayName"
                               value=""
                               class="input w-full"
                               required
                               minlength="3"
                               maxlength="20"
                               placeholder="Your display name" />
                        <span class="text-xs" style="color: var(--text-tertiary)">3-20 characters. Letters, numbers, spaces, hyphens, underscores.</span>
                    </div>

                    <div id="password-field">
                        <input type="password"
                               name="password"
                               class="input w-full"
                               placeholder="Current password"
                               autocomplete="current-password" />
                        <span class="text-xs" style="color: var(--text-tertiary)">Required to change your display name</span>
                    </div>

                    @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
                    {
                        <div id="turnstile-widget" class="cf-turnstile"
                             data-sitekey="@Model.TurnstileSiteKey"
                             data-theme="auto"
                             data-size="normal"></div>
                    }

                    <div>
                        <button type="submit" class="btn btn-primary btn-sm" id="update-name-btn">
                            Update Display Name
                        </button>
                    </div>
                </form>
            </div>

            <!-- Bio -->
            <div id="section-bio" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Bio</h3>
                <p class="text-sm mb-3" style="color: var(--text-tertiary)">
                    A short description that appears on your profile.
                </p>
                <textarea id="bio-input"
                          class="textarea w-full"
                          rows="3"
                          maxlength="300"
                          placeholder="Tell others a bit about yourself..."></textarea>
                <div class="flex items-center justify-between mt-2">
                    <span class="text-xs" style="color: var(--text-tertiary)"><span id="bio-char-count">0</span>/300</span>
                    <button type="button" class="btn btn-primary btn-sm" id="save-bio-btn">Save Bio</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Right Column -->
<aside class="fp-right">
<div class="fp-right-sticky">
    <!-- Scrollspy -->
    <div class="fp-right-section">
        <div class="fp-right-title">On this page</div>
        <nav class="fp-scrollspy">
            <a href="#section-avatar" class="fp-scrollspy-item active">Avatar</a>
            <a href="#section-display-name" class="fp-scrollspy-item">Display Name</a>
            <a href="#section-bio" class="fp-scrollspy-item">Bio</a>
        </nav>
    </div>

    <!-- Help -->
    <div class="fp-right-section">
        <div class="fp-right-title">Help</div>
        <div class="text-sm" style="color: var(--text-tertiary)">
            <p>Your <strong>avatar</strong> is shown next to your posts and in discussion listings.</p>
            <p class="mt-2">Your <strong>display name</strong> is how others see you. Changing it requires your password.</p>
            <p class="mt-2">Your <strong>bio</strong> appears on your profile page.</p>
        </div>
    </div>
</div>
</aside>

@section Scripts {
    <script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true" defer></script>
    @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
    {
        <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
    }
}
