@page "/settings/account"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Settings.AccountModel
@{
    ViewData["Title"] = T.Settings.TitleAccount;
    ViewData["Nudge.Title"] = T.Settings.NudgeTitleAccess;
    ViewData["Nudge.Body"] = T.Settings.NudgeBodyAccount;

    var settingsAvatarFileName = User.FindFirst("AvatarFileName")?.Value;
    var hasUploadedAvatar = !string.IsNullOrEmpty(settingsAvatarFileName);
    var settingsAvatarUrl = SnakkUrlHelper.UserAvatar(Model.UserId ?? "", avatarFileName: settingsAvatarFileName);
    var settingsGeneratedUrl = SnakkUrlHelper.UserAvatar(Model.UserId ?? "");
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div class="sn-center-inner">
        @if (User.Identity?.IsAuthenticated != true)
        {
            <partial name="Shared/_RegistrationNudge" />
        }
        else
        {
        <h2 class="sn-section-title">
            <span class="icon icon-user" aria-hidden="true"></span>
            @T.Settings.HeadingAccount
        </h2>
        <div class="sn-settings-content">

            <!-- Avatar -->
            <div id="section-avatar" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.AvatarTitle</h3>
                <form id="avatar-upload-form" class="flex flex-col gap-4">
                    <div class="flex items-center gap-4">
                        <div class="avatar avatar-xl shrink-0">
                            <img src="@settingsAvatarUrl"
                                 alt="@T.Settings.AvatarAlt"
                                 width="80" height="80"
                                 id="avatar-preview"
                                 data-generated-url="@settingsGeneratedUrl" />
                        </div>
                        <div class="text-sm" style="color: var(--text-tertiary)">
                            @T.Settings.AvatarHelp
                            <br />@T.Settings.AvatarSupport
                        </div>
                    </div>

                    <input type="file" id="avatar-file" name="avatar"
                           accept="image/jpeg,image/png,image/webp" class="hidden" />

                    <div id="avatar-drop-zone" class="gallery-drop-zone">
                        <div class="gallery-drop-zone-content">
                            <span class="icon icon-photograph h-8 w-8 text-base-content/30 mb-2" aria-hidden="true"></span>
                            <span class="text-sm text-base-content/50" id="avatar-drop-label">@T.Settings.AvatarDropLabel</span>
                        </div>
                    </div>

                    <div class="flex items-center gap-3 flex-wrap">
                        <button type="submit" class="btn btn-primary btn-sm" id="upload-btn" disabled>
                            @T.Settings.AvatarUpload
                        </button>
                        <button type="button"
                                class="btn btn-ghost btn-sm"
                                id="delete-avatar-btn"
                                @(hasUploadedAvatar ? "" : "disabled")>
                            @T.Settings.AvatarUseGenerated
                        </button>
                        <div id="upload-progress-row" class="upload-progress-row hidden">
                            <div id="upload-image-chips" class="upload-image-chips"></div>
                            <span id="upload-status-text" class="upload-status-text"></span>
                        </div>
                    </div>
                </form>

                <div id="upload-status" class="mt-3 text-sm hidden"></div>
            </div>

            <!-- Display Name -->
            <div id="section-display-name" class="sn-settings-section">
                <h3 class="sn-settings-section-title" style="display:flex;justify-content:space-between;align-items:center">
                    <span>@T.Settings.DisplayNameTitle</span>
                    <span class="icon icon-lock-closed w-4 h-4" title="@T.Settings.PrivSudoNote" style="color:var(--text-tertiary);cursor:default" aria-hidden="true"></span>
                </h3>
                <div id="display-name-status" class="text-sm mb-3 hidden"></div>
                <p id="current-display-name" class="text-sm font-medium mb-3"></p>
                <button type="button" class="btn btn-primary btn-sm" id="change-name-btn">
                    @T.Settings.DisplayNameSubmit
                </button>
            </div>

            <!-- Bio -->
            <div id="section-bio" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.BioTitle</h3>
                <p class="text-sm mb-3" style="color: var(--text-tertiary)">
                    @T.Settings.BioHelp
                </p>
                <textarea id="bio-input"
                          class="textarea w-full"
                          rows="3"
                          maxlength="300"
                          placeholder="@T.Settings.BioPlaceholder"></textarea>
                <div class="flex items-center justify-between mt-2">
                    <span class="text-xs" style="color: var(--text-tertiary)"><span id="bio-char-count">0</span>/300</span>
                    <button type="button" class="btn btn-primary btn-sm" id="save-bio-btn">@T.Settings.BioSave</button>
                </div>
            </div>
        </div>
        } @* end IsAuthenticated *@
    </div>
</div>

<!-- Right Column -->
<aside class="sn-right">
<partial name="Shared/_SettingsRightNav" />
</aside>

<!-- Display Name Modal -->
@if (User.Identity?.IsAuthenticated == true)
{
<div id="modal-display-name" class="chart-modal-backdrop" style="display:none" role="dialog" aria-modal="true" aria-labelledby="modal-display-name-title">
    <div class="chart-modal" style="max-width:28rem">
        <div class="chart-modal-header">
            <span id="modal-display-name-title">@T.Settings.DisplayNameTitle</span>
            <button type="button" class="chart-modal-close" id="display-name-modal-cancel-x" aria-label="Close">✕</button>
        </div>
        <div class="chart-modal-body" style="flex-direction:column">
            <input type="text"
                   id="display-name-input"
                   class="input w-full"
                   minlength="3"
                   maxlength="20"
                   placeholder="@T.Settings.DisplayNamePlaceholder"
                   autocomplete="off" />
            <span class="text-xs mt-1" style="color: var(--text-tertiary)">@T.Settings.DisplayNameHelp</span>
            <p id="display-name-modal-status" class="text-sm mt-2 hidden"></p>
        </div>
        <div class="chart-modal-footer">
            <button type="button" class="chart-modal-cancel" id="display-name-modal-cancel">@T.Settings.Priv2faCancelBtn</button>
            <button type="button" class="chart-modal-insert" id="display-name-modal-submit">@T.Settings.DisplayNameSubmit</button>
        </div>
    </div>
</div>
}

<partial name="Shared/_SudoModals" />

<script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true"></script>
