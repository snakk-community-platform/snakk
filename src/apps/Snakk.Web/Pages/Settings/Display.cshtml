@page "/settings/display"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Settings.DisplayModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Display Settings";
}

@section LeftColumn {
<aside class="fp-left">
<div class="fp-left-sticky">
    <partial name="Shared/_SettingsNav" />
</div>
</aside>
}

<!-- Center Column -->
<div class="fp-center">
    <div class="fp-center-inner">
        <div class="fp-settings-content">

            <!-- Timezone -->
            <div id="section-timezone" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Timezone</h3>

                <div class="tz-map-wrapper">
                    <object id="timezone-map-object"
                            class="tz-map-object"
                            data="/svg/world-map.svg"
                            type="image/svg+xml"
                            aria-label="World map — click a country to select its timezone">
                    </object>
                    <div id="tz-map-tooltip" class="tz-map-tooltip hidden"></div>
                </div>

                <select id="timezone-select" name="timezone" class="select w-full">
                    <option value="UTC">UTC</option>
                    <optgroup label="Americas">
                        <option value="America/Adak">Adak (USA)</option>
                        <option value="America/Anchorage">Anchorage (USA)</option>
                        <option value="America/Asuncion">Asuncion (Paraguay)</option>
                        <option value="America/Bogota">Bogota (Colombia)</option>
                        <option value="America/Argentina/Buenos_Aires">Buenos Aires (Argentina)</option>
                        <option value="America/Cancun">Cancun (Mexico)</option>
                        <option value="America/Caracas">Caracas (Venezuela)</option>
                        <option value="America/Cayenne">Cayenne (French Guiana)</option>
                        <option value="America/Chicago">Chicago (USA)</option>
                        <option value="America/Cuiaba">Cuiaba (Brazil)</option>
                        <option value="America/Denver">Denver (USA)</option>
                        <option value="America/Edmonton">Edmonton (Canada)</option>
                        <option value="America/Noronha">Fernando de Noronha (Brazil)</option>
                        <option value="America/Fortaleza">Fortaleza (Brazil)</option>
                        <option value="America/Guatemala">Guatemala City (Guatemala)</option>
                        <option value="America/Guayaquil">Guayaquil (Ecuador)</option>
                        <option value="America/Halifax">Halifax (Canada)</option>
                        <option value="America/Havana">Havana (Cuba)</option>
                        <option value="Pacific/Honolulu">Honolulu (USA)</option>
                        <option value="America/Jamaica">Kingston (Jamaica)</option>
                        <option value="America/La_Paz">La Paz (Bolivia)</option>
                        <option value="America/Lima">Lima (Peru)</option>
                        <option value="America/Los_Angeles">Los Angeles (USA)</option>
                        <option value="America/Manaus">Manaus (Brazil)</option>
                        <option value="America/Mazatlan">Mazatlan (Mexico)</option>
                        <option value="America/Mexico_City">Mexico City (Mexico)</option>
                        <option value="America/Montevideo">Montevideo (Uruguay)</option>
                        <option value="America/New_York">New York (USA)</option>
                        <option value="America/Godthab">Nuuk (Greenland)</option>
                        <option value="America/Panama">Panama City (Panama)</option>
                        <option value="America/Paramaribo">Paramaribo (Suriname)</option>
                        <option value="America/Phoenix">Phoenix (USA, no DST)</option>
                        <option value="America/Regina">Regina (Canada, no DST)</option>
                        <option value="America/Rio_Branco">Rio Branco (Brazil)</option>
                        <option value="America/Santiago">Santiago (Chile)</option>
                        <option value="America/Santo_Domingo">Santo Domingo (Dominican Republic)</option>
                        <option value="America/Sao_Paulo">Sao Paulo (Brazil)</option>
                        <option value="America/St_Johns">St. John's (Canada)</option>
                        <option value="America/Tijuana">Tijuana (Mexico)</option>
                        <option value="America/Toronto">Toronto (Canada)</option>
                        <option value="America/Vancouver">Vancouver (Canada)</option>
                        <option value="America/Winnipeg">Winnipeg (Canada)</option>
                    </optgroup>
                    <optgroup label="Europe">
                        <option value="Europe/Amsterdam">Amsterdam (Netherlands)</option>
                        <option value="Europe/Athens">Athens (Greece)</option>
                        <option value="Atlantic/Azores">Azores (Portugal)</option>
                        <option value="Europe/Berlin">Berlin (Germany)</option>
                        <option value="Europe/Brussels">Brussels (Belgium)</option>
                        <option value="Europe/Bucharest">Bucharest (Romania)</option>
                        <option value="Europe/Budapest">Budapest (Hungary)</option>
                        <option value="Europe/Copenhagen">Copenhagen (Denmark)</option>
                        <option value="Europe/Dublin">Dublin (Ireland)</option>
                        <option value="Europe/Helsinki">Helsinki (Finland)</option>
                        <option value="Europe/Istanbul">Istanbul (Turkey)</option>
                        <option value="Europe/Kiev">Kyiv (Ukraine)</option>
                        <option value="Europe/Lisbon">Lisbon (Portugal)</option>
                        <option value="Europe/London">London (United Kingdom)</option>
                        <option value="Europe/Madrid">Madrid (Spain)</option>
                        <option value="Europe/Moscow">Moscow (Russia)</option>
                        <option value="Europe/Oslo">Oslo (Norway)</option>
                        <option value="Europe/Paris">Paris (France)</option>
                        <option value="Europe/Prague">Prague (Czechia)</option>
                        <option value="Atlantic/Reykjavik">Reykjavik (Iceland)</option>
                        <option value="Europe/Rome">Rome (Italy)</option>
                        <option value="Europe/Stockholm">Stockholm (Sweden)</option>
                        <option value="Europe/Vienna">Vienna (Austria)</option>
                        <option value="Europe/Warsaw">Warsaw (Poland)</option>
                        <option value="Europe/Zurich">Zurich (Switzerland)</option>
                    </optgroup>
                    <optgroup label="Africa">
                        <option value="Africa/Cairo">Cairo (Egypt)</option>
                        <option value="Africa/Casablanca">Casablanca (Morocco)</option>
                        <option value="Africa/Johannesburg">Johannesburg (South Africa)</option>
                        <option value="Africa/Lagos">Lagos (Nigeria)</option>
                        <option value="Africa/Nairobi">Nairobi (Kenya)</option>
                    </optgroup>
                    <optgroup label="Middle East">
                        <option value="Asia/Dubai">Dubai (UAE)</option>
                        <option value="Asia/Jerusalem">Jerusalem (Israel)</option>
                        <option value="Asia/Riyadh">Riyadh (Saudi Arabia)</option>
                        <option value="Asia/Tehran">Tehran (Iran)</option>
                    </optgroup>
                    <optgroup label="Asia">
                        <option value="Asia/Bangkok">Bangkok (Thailand)</option>
                        <option value="Asia/Dhaka">Dhaka (Bangladesh)</option>
                        <option value="Asia/Hong_Kong">Hong Kong (China)</option>
                        <option value="Asia/Jakarta">Jakarta (Indonesia)</option>
                        <option value="Asia/Kolkata">Kolkata (India)</option>
                        <option value="Asia/Seoul">Seoul (South Korea)</option>
                        <option value="Asia/Shanghai">Shanghai (China)</option>
                        <option value="Asia/Singapore">Singapore</option>
                        <option value="Asia/Tokyo">Tokyo (Japan)</option>
                    </optgroup>
                    <optgroup label="Australia & Pacific">
                        <option value="Australia/Brisbane">Brisbane (Australia)</option>
                        <option value="Australia/Melbourne">Melbourne (Australia)</option>
                        <option value="Australia/Perth">Perth (Australia)</option>
                        <option value="Australia/Sydney">Sydney (Australia)</option>
                        <option value="Pacific/Auckland">Auckland (New Zealand)</option>
                    </optgroup>
                </select>
                <span class="text-xs" style="color: var(--text-tertiary)">Click a country on the map, or select directly</span>
            </div>

            <!-- Emoji Skin Tone -->
            <div id="section-skin-tone" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Emoji Skin Tone</h3>
                <div class="flex gap-2" id="skin-tone-picker">
                    <button type="button" class="skin-tone-swatch active" data-tone="" title="Default">👋</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏻" title="Light">👋🏻</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏼" title="Medium-Light">👋🏼</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏽" title="Medium">👋🏽</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏾" title="Medium-Dark">👋🏾</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏿" title="Dark">👋🏿</button>
                </div>
                <span class="text-xs mt-1" style="color: var(--text-tertiary)">Applies to hand and face emojis in the editor</span>
            </div>

            <!-- External Embeds -->
            <div id="section-embeds" class="fp-settings-section">
                <h3 class="fp-settings-section-title">External Embedded Content</h3>
                <p class="text-sm mb-2" style="color: var(--text-tertiary)">
                    When a link discussion points to a supported source, enabling it here will automatically load the embedded content instead of showing a link card.
                </p>
                <div class="flex items-start gap-2 text-xs p-2.5 rounded-lg mb-4" style="color: var(--text-tertiary); background: color-mix(in srgb, var(--sidebar-bg) 30%, transparent);">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 shrink-0 mt-0.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 9v2m0 4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <span>Enabling embeds allows the selected services to set cookies and track your activity through their embedded content. Only enable sources you trust.</span>
                </div>

                <div class="flex flex-col gap-4" id="embed-providers">
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--text-tertiary)">Video</div>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="youtube" />
                                <span class="text-sm">YouTube</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="vimeo" />
                                <span class="text-sm">Vimeo</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="tiktok" />
                                <span class="text-sm">TikTok</span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--text-tertiary)">Social</div>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="twitter" />
                                <span class="text-sm">Twitter / X</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="bluesky" />
                                <span class="text-sm">Bluesky</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="reddit" />
                                <span class="text-sm">Reddit</span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--text-tertiary)">Audio & Music</div>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="spotify" />
                                <span class="text-sm">Spotify</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="soundcloud" />
                                <span class="text-sm">SoundCloud</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="bandcamp" />
                                <span class="text-sm">Bandcamp</span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--text-tertiary)">Streaming</div>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="twitch" />
                                <span class="text-sm">Twitch</span>
                            </label>
                        </div>
                    </div>
                    <div>
                        <div class="text-xs font-semibold uppercase tracking-wider mb-2" style="color: var(--text-tertiary)">Images & Design</div>
                        <div class="flex flex-col gap-2">
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="imgur" />
                                <span class="text-sm">Imgur</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="codepen" />
                                <span class="text-sm">CodePen</span>
                            </label>
                            <label class="flex items-center gap-3 cursor-pointer">
                                <input type="checkbox" class="toggle toggle-sm toggle-primary" data-embed-provider="canva" />
                                <span class="text-sm">Canva</span>
                            </label>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Right Column -->
<aside class="fp-right">
<div class="fp-right-sticky">
    <div class="fp-right-section">
        <div class="fp-right-title">On this page</div>
        <nav class="fp-scrollspy">
            <a href="#section-timezone" class="fp-scrollspy-item active">Timezone</a>
            <a href="#section-skin-tone" class="fp-scrollspy-item">Emoji Skin Tone</a>
            <a href="#section-embeds" class="fp-scrollspy-item">External Embeds</a>
        </nav>
    </div>
    <div class="fp-right-section">
        <div class="fp-right-title">Help</div>
        <div class="text-sm" style="color: var(--text-tertiary)">
            <p>Your <strong>timezone</strong> affects how dates and times are displayed throughout the site.</p>
            <p class="mt-2"><strong>External embeds</strong> allow supported services to load interactive content directly. This may allow those services to track your activity.</p>
        </div>
    </div>
</div>
</aside>

@section Scripts {
    <script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true" defer></script>
    <script src="/js/dist/components/timezone-map.js" defer></script>
}
