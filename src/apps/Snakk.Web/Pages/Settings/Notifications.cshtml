@page "/settings/notifications"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Settings.NotificationsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Notification Settings";
    ViewData["AuthPrompt.Title"] = "Sign in to access settings";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="fp-center">
    <div class="fp-center-inner">
        @if (User.Identity?.IsAuthenticated != true)
        {
            <partial name="Shared/_AuthPrompt" />
        }
        else
        {
        <h2 class="fp-section-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
            </svg>
            Notifications
        </h2>
        <div class="fp-settings-content">

            <!-- Auto-follow -->
            <div id="section-auto-follow" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Auto-follow on Reply</h3>
                <label class="flex items-center gap-4 cursor-pointer">
                    <input type="checkbox"
                           name="autoFollowOnReply"
                           class="toggle toggle-primary" />
                    <span>
                        <span class="font-medium text-sm">Follow discussions automatically</span>
                        <span class="block text-sm" style="color: var(--text-tertiary)">
                            When you post a reply, you will automatically follow that discussion and receive notifications for new replies.
                        </span>
                    </span>
                </label>
            </div>
        </div>
        } @* end IsAuthenticated *@
    </div>
</div>

<!-- Right Column -->
<aside class="fp-right">
<partial name="Shared/_SettingsRightNav" />
</aside>

<script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true"></script>
