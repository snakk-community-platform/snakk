@page "/settings/integrations"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Settings.IntegrationsModel
@{
    ViewData["Title"] = T.Settings.TitleIntegrations;
    ViewData["AuthPrompt.Title"] = T.Settings.NudgeTitleAccess;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div class="sn-center-inner">
        @if (User.Identity?.IsAuthenticated != true)
        {
            <partial name="Shared/_AuthPrompt" />
        }
        else
        {
        <h2 class="sn-section-title">
            <span class="icon icon-puzzle" aria-hidden="true"></span>
            @T.Settings.HeadingIntegrations
        </h2>
        <div class="sn-settings-content">

            <!-- RSS Feeds -->
            <div id="section-rss" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.IntgRssTitle</h3>
                <p class="text-sm mb-4" style="color: var(--text-tertiary)">
                    @T.Settings.IntgRssIntro
                </p>

                <div class="flex flex-col gap-3 text-sm mb-4">
                    <div>
                        <span class="font-medium">@T.Settings.IntgSiteFeed</span>
                        <div class="flex items-center gap-2 mt-1">
                            <input type="text" readonly value="/feed.xml" id="rss-site-url"
                                   class="input input-sm w-full font-mono text-xs" />
                            <button type="button" class="btn btn-ghost btn-sm btn-square shrink-0"
                                    data-action="copy" data-copy-target="rss-site-url" title="@T.Settings.IntgCopy">
                                <span class="icon icon-copy-link h-4 w-4" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                    <p class="text-xs" style="color: var(--text-tertiary)">
                        @T.Settings.IntgFeedsNoteBefore<code>/feed.xml</code>@T.Settings.IntgFeedsNoteAfter
                    </p>
                </div>

                <div style="border-top: 1px solid var(--border-secondary); padding-top: 1rem;">
                    <span class="font-medium text-sm">@T.Settings.IntgTokenTitle</span>
                    <p class="text-xs mt-1 mb-3" style="color: var(--text-tertiary)">
                        @T.Settings.IntgTokenHelp
                    </p>

                    <div id="feed-token-section">
                        <div id="feed-token-empty" class="hidden">
                            <button type="button" class="btn btn-primary btn-sm" id="generate-feed-token-btn">@T.Settings.IntgGenerate</button>
                        </div>
                        <div id="feed-token-active" class="hidden">
                            <div class="flex items-center gap-2 mb-3">
                                <input type="text" readonly id="feed-token-value"
                                       class="input input-sm w-full font-mono text-xs" />
                                <button type="button" class="btn btn-ghost btn-sm btn-square shrink-0"
                                        data-action="copy" data-copy-target="feed-token-value" title="@T.Settings.IntgCopy">
                                    <span class="icon icon-copy-link h-4 w-4" aria-hidden="true"></span>
                                </button>
                            </div>
                            <div class="flex gap-2">
                                <button type="button" class="btn btn-ghost btn-sm" id="regenerate-feed-token-btn">@T.Settings.IntgRegenerate</button>
                                <button type="button" class="btn btn-ghost btn-sm" style="color: var(--text-tertiary)" id="revoke-feed-token-btn">@T.Settings.IntgRevoke</button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            <!-- Discord -->
            <div id="section-discord" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.IntgDiscordTitle</h3>
                <p class="text-sm mb-4" style="color: var(--text-tertiary)">
                    @T.Settings.IntgDiscordIntro
                </p>

                @if (Model.DiscordStatus == "linked")
                {
                    <div class="alert alert-success mb-4 text-sm">@T.Settings.IntgDiscordLinkedSuccess</div>
                }
                else if (Model.DiscordStatus == "error")
                {
                    <div class="alert alert-error mb-4 text-sm">@T.Settings.IntgDiscordLinkError</div>
                }

                <div id="discord-not-linked" class="hidden">
                    <button type="button" class="btn btn-primary btn-sm" id="discord-link-btn">@T.Settings.IntgDiscordConnect</button>
                </div>
                <div id="discord-linked" class="hidden">
                    <p class="text-sm mb-3">
                        <span id="discord-username-display" class="font-medium"></span>
                    </p>
                    <button type="button" class="btn btn-ghost btn-sm" style="color: var(--text-tertiary)" id="discord-unlink-btn">@T.Settings.IntgDiscordDisconnect</button>
                </div>
            </div>
        </div>
        } @* end IsAuthenticated *@
    </div>
</div>

<!-- Right Column -->
<aside class="sn-right">
<partial name="Shared/_SettingsRightNav" />
</aside>

<script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true"></script>
