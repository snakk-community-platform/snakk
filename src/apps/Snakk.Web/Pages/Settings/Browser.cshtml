@page "/settings/browser"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Settings.BrowserModel
@{
    ViewData["Title"] = T.Settings.TitleBrowser;
    ViewData["AuthPrompt.Title"] = T.Settings.NudgeTitleAccess;
}

@section Styles {
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("settings")" asp-append-version="true" />
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div class="sn-center-inner">
        <h2 class="sn-section-title">
            <span class="icon icon-globe" aria-hidden="true"></span>
            @T.Settings.HeadingBrowser
        </h2>
        <div class="sn-settings-content">

            <div class="flex items-start gap-2 text-xs p-2.5 rounded-lg mb-2" style="color: var(--text-tertiary); background: color-mix(in srgb, var(--sidebar-bg) 30%, transparent);">
                <span class="icon icon-display-monitor h-4 w-4 shrink-0 mt-0.5" aria-hidden="true"></span>
                <span>@T.Settings.BrowserDeviceOnly</span>
            </div>

            <!-- Layout -->
            <div id="section-layout" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.BrowserLayoutTitle</h3>
                <div class="flex items-start justify-between gap-6">
                    <div>
                        <p class="text-sm font-medium" style="color: var(--text-primary)">@T.Settings.BrowserStickyTitle</p>
                        <p class="text-xs mt-0.5" style="color: var(--text-tertiary)">@T.Settings.BrowserStickyHelp</p>
                    </div>
                    <select id="pref-sidebar-sticky" class="select select-sm select-bordered shrink-0 mt-0.5">
                        <option value="both">@T.Settings.BrowserStickyBoth</option>
                        <option value="left-only">@T.Settings.BrowserStickyLeftOnly</option>
                        <option value="none">@T.Settings.BrowserStickyNone</option>
                    </select>
                </div>
                <div class="flex items-start justify-between gap-6 mt-4">
                    <div>
                        <p class="text-sm font-medium" style="color: var(--text-primary)">@T.Settings.BrowserContentWidthTitle</p>
                        <p class="text-xs mt-0.5" style="color: var(--text-tertiary)">@T.Settings.BrowserContentWidthHelp</p>
                    </div>
                    <button type="button" id="btn-content-width" class="btn btn-sm btn-outline shrink-0 mt-0.5">
                        @T.Settings.BrowserContentWidthButton
                    </button>
                </div>
            </div>

            <!-- Behavior -->
            <div id="section-behavior" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.BrowserBehaviorTitle</h3>
                <div class="flex flex-col gap-5">
                    <div class="flex items-start justify-between gap-6">
                        <div>
                            <p class="text-sm font-medium" style="color: var(--text-primary)">@T.Settings.BrowserListLayoutTitle</p>
                            <p class="text-xs mt-0.5" style="color: var(--text-tertiary)">@T.Settings.BrowserListLayoutHelp</p>
                        </div>
                        <select id="pref-discussion-list-layout" class="select select-sm select-bordered shrink-0 mt-0.5">
                            <option value="full">@T.Settings.BrowserListLayoutFull</option>
                            <option value="compact">@T.Settings.BrowserListLayoutCompact</option>
                            <option value="none">@T.Settings.BrowserListLayoutNone</option>
                        </select>
                    </div>
                    <label class="flex items-start justify-between gap-6 cursor-pointer">
                        <div>
                            <p class="text-sm font-medium" style="color: var(--text-primary)">@T.Settings.BrowserAnimationsTitle</p>
                            <p class="text-xs mt-0.5" style="color: var(--text-tertiary)">@T.Settings.BrowserAnimationsHelp</p>
                        </div>
                        <input type="checkbox" class="toggle toggle-sm toggle-primary shrink-0 mt-0.5" id="pref-animations" />
                    </label>
                    <label class="flex items-start justify-between gap-6 cursor-pointer">
                        <div>
                            <p class="text-sm font-medium" style="color: var(--text-primary)">@T.Settings.BrowserLinkPreviewLargeTitle</p>
                            <p class="text-xs mt-0.5" style="color: var(--text-tertiary)">@T.Settings.BrowserLinkPreviewLargeHelp</p>
                        </div>
                        <input type="checkbox" class="toggle toggle-sm toggle-primary shrink-0 mt-0.5" id="pref-link-preview-large" />
                    </label>
                </div>
            </div>

            <!-- Emoji Skin Tone -->
            <div id="section-skin-tone" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.BrowserSkinToneTitle</h3>
                <div class="flex gap-2" id="skin-tone-picker">
                    <button type="button" class="skin-tone-swatch active" data-tone="" title="@T.Settings.BrowserSkinDefault">👋</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏻" title="@T.Settings.BrowserSkinLight">👋🏻</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏼" title="@T.Settings.BrowserSkinMediumLight">👋🏼</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏽" title="@T.Settings.BrowserSkinMedium">👋🏽</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏾" title="@T.Settings.BrowserSkinMediumDark">👋🏾</button>
                    <button type="button" class="skin-tone-swatch" data-tone="🏿" title="@T.Settings.BrowserSkinDark">👋🏿</button>
                </div>
                <span class="text-xs mt-1" style="color: var(--text-tertiary)">@T.Settings.BrowserSkinApplies</span>
            </div>

            <!-- External Embeds -->
            <div id="section-embeds" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.BrowserEmbedsTitle</h3>
                <p class="text-sm mb-3" style="color: var(--text-tertiary)">
                    @T.Settings.BrowserEmbedsIntro
                </p>
                <div class="callout-node-view callout-node-info mb-4 text-sm" style="border-left: none;">
                    <span class="callout-node-icon">ℹ️</span>
                    <div class="callout-node-body">@T.Settings.BrowserEmbedsWarning</div>
                </div>

                <div id="embed-providers" class="rounded-lg border border-base-300 overflow-hidden" style="background:var(--bg-tertiary);color:var(--text-primary);">
                    <div class="social-picker-category-divider">@T.Settings.BrowserGroupVideo</div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-youtube-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">YouTube</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="youtube">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-vimeo-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Vimeo</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="vimeo">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-tiktok-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">TikTok</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="tiktok">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>

                    <div class="social-picker-category-divider">@T.Settings.BrowserGroupSocial</div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-twitter-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Twitter / X</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="twitter">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-bluesky-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Bluesky</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="bluesky">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-reddit-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Reddit</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="reddit">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>

                    <div class="social-picker-category-divider">@T.Settings.BrowserGroupAudio</div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-spotify-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Spotify</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="spotify">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-soundcloud-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">SoundCloud</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="soundcloud">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-bandcamp-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Bandcamp</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="bandcamp">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>

                    <div class="social-picker-category-divider">@T.Settings.BrowserGroupStreaming</div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-twitch-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Twitch</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="twitch">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>

                    <div class="social-picker-category-divider">@T.Settings.BrowserGroupImages</div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-imgur-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Imgur</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="imgur">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-codepen-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">CodePen</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="codepen">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                    <div class="sn-device-item">
                        <img src="/icons/embed-canva-color.svg" width="20" height="20" alt="" aria-hidden="true">
                        <div class="sn-device-info"><div class="sn-device-name">Canva</div></div>
                        <select class="select select-sm select-bordered shrink-0" data-embed-provider="canva">
                            <option value="ask">@T.Settings.BrowserEmbedAsk</option>
                            <option value="allow">@T.Settings.BrowserEmbedAllow</option>
                            <option value="deny">@T.Settings.BrowserEmbedDeny</option>
                        </select>
                    </div>
                </div>
            </div>

        </div>
    </div>
</div>

<!-- Content Width Modal -->
<div id="content-width-modal" class="fixed inset-0 hidden" style="z-index: 10000;" aria-modal="true" role="dialog">
    <div id="content-width-backdrop" class="absolute inset-0 bg-black/50"></div>
    <div class="absolute inset-0 flex items-center justify-center p-4 pointer-events-none">
        <div class="relative w-80 rounded-xl shadow-2xl p-6 pointer-events-auto" style="background: var(--bg-secondary);">
            <div class="flex items-start justify-between mb-1">
                <h3 class="font-semibold text-base" style="color: var(--text-primary)">@T.Settings.BrowserContentWidthTitle</h3>
                <button type="button" id="btn-content-width-cancel-x" class="btn btn-ghost btn-xs btn-circle -mt-1 -mr-1">✕</button>
            </div>
            <p class="text-xs mb-5" style="color: var(--text-tertiary)">@T.Settings.BrowserContentWidthHelp</p>
            <div class="flex items-center gap-3 mb-6">
                <span id="pref-content-width-label" class="text-sm tabular-nums shrink-0" style="color: var(--text-secondary); min-width: 4.5rem; text-align: right;">Default</span>
                <input type="range" id="pref-content-width" min="54" max="128" step="1" class="range range-sm range-primary flex-1" />
            </div>
            <div class="flex items-center justify-between">
                <button type="button" id="btn-content-width-reset" class="btn btn-ghost btn-sm">@T.Settings.BrowserContentWidthReset</button>
                <div class="flex gap-2">
                    <button type="button" id="btn-content-width-cancel" class="btn btn-ghost btn-sm">@T.Settings.BrowserContentWidthCancel</button>
                    <button type="button" id="btn-content-width-apply" class="btn btn-primary btn-sm">@T.Settings.BrowserContentWidthApply</button>
                </div>
            </div>
        </div>
    </div>
</div>

<!-- Right Column -->
<aside class="sn-right">
<partial name="Shared/_SettingsRightNav" />
</aside>

<script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true"></script>
