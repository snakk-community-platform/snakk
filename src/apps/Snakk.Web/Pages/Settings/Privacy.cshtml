@page "/settings/privacy"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Settings.PrivacyModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Privacy & Security Settings";
    ViewData["AuthPrompt.Title"] = "Sign in to access settings";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="fp-center">
    <div class="fp-center-inner">
        @if (User.Identity?.IsAuthenticated != true)
        {
            <partial name="Shared/_AuthPrompt" />
        }
        else
        {
        <h2 class="fp-section-title">
            <span class="icon icon-lock-closed" aria-hidden="true"></span>
            Privacy &amp; Security
        </h2>
        <div class="fp-settings-content">

            <!-- Trusted Devices -->
            <div id="section-devices" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Trusted Devices</h3>
                <p class="text-sm mb-4" style="color: var(--text-tertiary)">
                    Devices that have been trusted for this account. Revoking a device will require re-authentication on that device.
                </p>
                <div id="devices-list">
                    <div class="flex justify-center py-4">
                        <span class="loading loading-spinner loading-md"></span>
                    </div>
                </div>
            </div>

            <!-- Email -->
            <div id="section-email" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Email</h3>
                <div class="flex flex-col gap-2 text-sm">
                    <div class="flex items-center gap-2">
                        <span style="color: var(--text-tertiary)">Email</span>
                        <span class="profile-email font-medium"></span>
                        <span class="profile-email-badge badge badge-sm shrink-0"></span>
                    </div>
                    <div class="flex items-center gap-2 profile-oauth-row" style="display: none;">
                        <span style="color: var(--text-tertiary)">Sign in via</span>
                        <span class="capitalize profile-oauth font-medium"></span>
                    </div>
                </div>
            </div>

            <!-- Password -->
            <div id="section-password" class="fp-settings-section">
                <h3 class="fp-settings-section-title">Password</h3>
                <p class="text-sm mb-3" style="color: var(--text-tertiary)">
                    Change your password. You will need your current password to set a new one.
                </p>
                <form id="change-password-form" class="flex flex-col gap-3">
                    <input type="password" name="currentPassword" class="input w-full" placeholder="Current password" autocomplete="current-password" />
                    <input type="password" name="newPassword" class="input w-full" placeholder="New password" autocomplete="new-password" />
                    <input type="password" name="confirmPassword" class="input w-full" placeholder="Confirm new password" autocomplete="new-password" />
                    <div>
                        <button type="submit" class="btn btn-primary btn-sm" id="change-password-btn">Change Password</button>
                    </div>
                </form>
            </div>
        </div>
        } @* end IsAuthenticated *@
    </div>
</div>

<!-- Right Column -->
<aside class="fp-right">
<partial name="Shared/_SettingsRightNav" />
</aside>

<script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true"></script>
