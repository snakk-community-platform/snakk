@page "/me"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@model Snakk.Web.Pages.MeModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "My Contributions";
    ViewData["Description"] = "Your discussions and posts.";
    ViewData["AuthPrompt.Title"] = "Sign in to view your contributions";
    ViewData["AuthPrompt.Message"] = "Start discussions and post replies to see your contributions here.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="fp-center">
    <div class="fp-center-inner">
        @if (!Model.IsAuthenticated)
        {
            <partial name="Shared/_AuthPrompt" />
        }
        else
        {
        <h2 class="fp-section-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
            </svg>
            My Contributions
        </h2>

        <!-- Tabs -->
        <div class="flex gap-1 mb-4 border-b border-subtle">
            <a href="/me?tab=discussions"
               class="px-4 py-2 text-sm font-medium transition-colors @(Model.ActiveTab == "discussions" ? "border-b-2 border-primary text-primary -mb-px" : "text-base-content/60 hover:text-base-content/80")">
                Discussions
            </a>
            <a href="/me?tab=posts"
               class="px-4 py-2 text-sm font-medium transition-colors @(Model.ActiveTab == "posts" ? "border-b-2 border-primary text-primary -mb-px" : "text-base-content/60 hover:text-base-content/80")">
                Posts
            </a>
        </div>

        @if (Model.ActiveTab == "discussions")
        {
            @if (Model.Discussions == null || Model.Discussions.Items.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M8 12h.01M12 12h.01M16 12h.01M21 12c0 4.418-4.03 8-9 8a9.863 9.863 0 01-4.255-.949L3 20l1.395-3.72C3.512 15.042 3 13.574 3 12c0-4.418 4.03-8 9-8s9 3.582 9 8z" />
                    </svg>
                    <p>You haven't started any discussions yet.</p>
                    <p class="mt-1 text-xs opacity-70"><a href="/new" class="underline">Start your first discussion</a></p>
                </div>
            }
            else
            {
                <div class="fp-card-list">
                    @foreach (var discussion in Model.Discussions.Items)
                    {
                        @await Html.PartialAsync("Shared/_DiscussionCard",
                            new DiscussionListItemVM(discussion, Model.ShowCommunityInBreadcrumb, Model.Community))
                    }
                </div>
                @if (Model.Discussions.HasMoreItems)
                {
                    var nextOffset = Model.Offset + Model.Discussions.Items.Count;
                    <div hx-get="/partials/my-discussions?offset=@nextOffset&pageSize=20"
                         hx-trigger="revealed"
                         hx-swap="outerHTML"
                         hx-target="this"
                         hx-push-url="false"
                         class="py-2">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="fp-card" style="opacity: 0.5">
                                <div class="fp-card-header">
                                    <div class="skeleton h-3 w-16 rounded"></div>
                                    <div class="skeleton h-4 w-4 rounded-full"></div>
                                    <div class="skeleton h-3 w-20 rounded"></div>
                                </div>
                                <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                                <div class="fp-card-stats mt-2">
                                    <div class="skeleton h-3 w-24 rounded"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
        else
        {
            @if (Model.Posts == null || Model.Posts.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M7 8h10M7 12h4m1 8l-4-4H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-3l-4 4z" />
                    </svg>
                    <p>You haven't posted any replies yet.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-3">
                    @foreach (var post in Model.Posts)
                    {
                        @await Html.PartialAsync("Shared/_PostListItem", post)
                    }
                </div>
                @if (Model.PostsHasMore)
                {
                    var nextOffset = Model.Offset + Model.Posts.Count;
                    <div hx-get="/partials/my-posts?offset=@nextOffset&pageSize=20"
                         hx-trigger="revealed"
                         hx-swap="outerHTML"
                         hx-target="this"
                         hx-push-url="false"
                         class="py-2">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="clean-card p-4" style="opacity: 0.5">
                                <div class="skeleton h-4 w-3/4 rounded"></div>
                                <div class="skeleton h-3 w-full rounded mt-2"></div>
                                <div class="skeleton h-3 w-2/3 rounded mt-1"></div>
                                <div class="flex items-center gap-2 mt-3">
                                    <div class="skeleton h-5 w-5 rounded-full"></div>
                                    <div class="skeleton h-3 w-20 rounded"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
        } @* end IsAuthenticated *@
    </div>
</div>

<aside class="fp-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<div class="fp-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="fp-right-body">
    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            Site Stats
        </div>
        <div hx-get="/partials/platform-stats?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="grid grid-cols-2 gap-3">
                <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-16"></div></div>
                <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-10"></div></div>
            </div>
        </div>
    </div>

    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            Active Spaces
        </div>
        <div hx-get="/partials/trending-spaces?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
            </div>
        </div>
    </div>

    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Active Contributors
        </div>
        <div hx-get="/partials/trending-contributors?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
            </div>
        </div>
    </div>
    </div>
</div>
</aside>
