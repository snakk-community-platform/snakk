@page "/u/{publicId}"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Shared.Helpers
@using static Snakk.Web.Helpers.DisplayHelper
@model ProfileModel
@{
    ViewData["Title"] = Model.Profile?.DisplayName ?? "User Profile";
}

@section Meta {
    @if (Model.Profile != null)
    {
        var siteBase = ViewData["SiteBase"] as string
            ?? $"{ViewContext.HttpContext.Request.Scheme}://{ViewContext.HttpContext.Request.Host}";
        var path = ViewContext.HttpContext.Request.Path.ToString();
        var url = $"{siteBase}{path}";

        <link rel="alternate" type="application/json+oembed"
              href="/oembed?url=@Uri.EscapeDataString(url)"
              title="@Html.Encode(Model.Profile.DisplayName)" />
    }
}

@section Styles {
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("user-profile")" asp-append-version="true" />
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("discussion-list")" asp-append-version="true" />
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    @* Hero card lives outside .sn-center-inner so it sits flush against the
       sides and top of the center column (no padding around it). *@
    @if (Model.Profile != null)
    {
        <div class="sn-profile-card" style="background-image: @UserGradient(Model.Profile.PublicId)">
            <div class="sn-profile-card-header">
                <img src="@SnakkUrlHelper.UserAvatar(Model.Profile.PublicId, avatarFileName: Model.Profile.HasAvatarFileName ? Model.Profile.AvatarFileName : null)"
                     alt="@Model.Profile.DisplayName"
                     width="80" height="80"
                     class="sn-profile-avatar"
                     decoding="async" />
                <div class="sn-profile-info">
                    <div class="sn-profile-name-row">
                        <h1 class="sn-profile-name">@Model.Profile.DisplayName</h1>
                    </div>
                    @if (Model.Profile.HasBio && !string.IsNullOrWhiteSpace(Model.Profile.Bio))
                    {
                        <p class="sn-profile-bio">@Model.Profile.Bio</p>
                    }
                    <div class="sn-profile-meta">
                        <span class="icon icon-calendar w-3.5 h-3.5" aria-hidden="true"></span>
                        Joined @Model.FormatDate(Model.Profile.JoinedAt?.ToDateTime())
                    </div>
                    @if (Model.SocialLinks is { Count: > 0 })
                    {
                        <div class="sn-profile-social-links flex flex-wrap gap-2 mt-2">
                            @foreach (var link in Model.SocialLinks)
                            {
                                if (link.Url is not null)
                                {
                                    <a href="@link.Url" target="_blank" rel="noopener noreferrer"
                                       class="shadow inline-flex items-center rounded overflow-hidden text-xs font-medium"
                                       style="text-decoration: none; color: var(--text-primary)"
                                       data-platform="@link.Platform"
                                       title="@link.Username">
                                        <span class="sn-social-icon-box flex items-center justify-center"
                                              style="width: 24px; height: 24px; background: var(--surface-secondary); flex-shrink: 0"></span>
                                        <span style="padding: 0 8px; line-height: 24px; background: rgba(255,255,255,0.75); color: #111">@link.DisplayName</span>
                                    </a>
                                }
                                else
                                {
                                    <span class="shadow inline-flex items-center rounded overflow-hidden text-xs font-medium"
                                          style="color: var(--text-secondary)"
                                          data-platform="@link.Platform"
                                          title="@link.Username">
                                        <span class="sn-social-icon-box flex items-center justify-center"
                                              style="width: 24px; height: 24px; background: var(--surface-secondary); flex-shrink: 0"></span>
                                        <span style="padding: 0 8px; line-height: 24px; background: rgba(255,255,255,0.75); color: #111">@link.DisplayName</span>
                                    </span>
                                }
                            }
                        </div>
                    }
                    @if (Model.Profile.HasDiscordUserId && !string.IsNullOrEmpty(Model.Profile.DiscordUserId))
                    {
                        <div class="mt-2">
                            <a href="https://discord.com/users/@Model.Profile.DiscordUserId"
                               target="_blank" rel="noopener noreferrer"
                               class="inline-flex items-center gap-1.5 text-xs px-2.5 py-1 rounded-full font-medium"
                               style="background: #5865F2; color: white; text-decoration: none;">
                                @(Model.Profile.HasDiscordUsername ? Model.Profile.DiscordUsername : Model.Profile.DiscordUserId)
                            </a>
                        </div>
                    }
                </div>
            </div>

            <!-- Stats + Activity Chart — nested inside the profile card hero -->
            <div class="sn-stats-activity-row">
                <div class="sn-stats-wrapper">
                    <div class="stats shadow">
                        <div class="stat">
                            <div class="stat-title">Discussions</div>
                            <div class="stat-value">@FormatCount(Model.Profile.DiscussionCount)</div>
                        </div>
                    </div>
                    <div class="stats shadow">
                        <div class="stat">
                            <div class="stat-title">Replies</div>
                            <div class="stat-value" id="stat-replies">@FormatCount(Model.Profile.ReplyCount)</div>
                        </div>
                    </div>
                    <div class="stats shadow">
                        <div class="stat">
                            <div class="stat-title">Followers</div>
                            <div class="stat-value" id="stat-followers">@FormatCount(Model.Profile.FollowerCount)</div>
                        </div>
                    </div>
                    <div class="stats shadow">
                        <div class="stat">
                            <div class="stat-title">Following</div>
                            <div class="stat-value" id="stat-following">@FormatCount(Model.Profile.FollowingCount)</div>
                        </div>
                    </div>
                    <div class="stats shadow">
                        <div class="stat">
                            <div class="stat-title">Reputation</div>
                            <div class="stat-value" id="stat-reputation">@FormatCount(Model.Profile.ReactionsReceived)</div>
                        </div>
                    </div>
                    <div class="stats shadow">
                        <div class="stat">
                            <div class="stat-title">Total Activity</div>
                            <div class="stat-value">@FormatCount(Model.Profile.DiscussionCount + Model.Profile.ReplyCount)</div>
                        </div>
                    </div>
                </div>
                <div class="sn-activity-chart-wrapper">
                    <div class="sn-activity-chart-title">
                        Activity History
                        <span class="sn-activity-chart-subtitle">Last year</span>
                    </div>
                    <div id="activity-chart-sidebar" class="sn-activity-chart-body">
                        <div class="skeleton h-full w-full rounded"></div>
                    </div>
                </div>
            </div>
        </div>
    }
    <div class="sn-center-inner">
        @if (Model.Profile == null)
        {
            <div class="py-12 text-center text-sm" style="color: var(--text-tertiary)">
                <p>User not found. This profile may have been removed or the link might be incorrect.</p>
                <a href="/" class="btn btn-primary btn-sm mt-4">Back to Home</a>
            </div>
        }
        else
        {

            <!-- Discussions / Top / Posts Tabs -->
            <div class="sn-profile-tabs" role="tablist">
                <button class="sn-profile-tab active" role="tab" aria-selected="true" data-tab="discussions">
                    <span class="icon icon-chat-bubbles h-4 w-4" aria-hidden="true"></span>
                    Discussions
                </button>
                <button class="sn-profile-tab" role="tab" aria-selected="false" data-tab="top">
                    <span class="icon icon-star h-4 w-4" aria-hidden="true"></span>
                    Top
                </button>
                <button class="sn-profile-tab" role="tab" aria-selected="false" data-tab="posts">
                    <span class="icon icon-posts-tab h-4 w-4" aria-hidden="true"></span>
                    Posts
                </button>
            </div>

            <!-- Discussions Tab -->
            <div id="tab-discussions" class="sn-profile-tab-panel">
                <div id="recent-discussions">
                    @if (Model.RecentDiscussions?.Items != null && Model.RecentDiscussions.Items.Any())
                    {
                        <div id="discussions-container">
                            @foreach (var discussion in Model.RecentDiscussions.Items)
                            {
                                @await Html.PartialAsync("Shared/_DiscussionCard",
                                    new DiscussionListItemVM(discussion, true, Model.Community))
                            }
                        </div>
                        @if (Model.RecentDiscussions.HasMoreItems)
                        {
                            <a href="/search?type=discussion&authorId=@Model.Profile!.PublicId" class="sn-show-more">
                                Show more discussions
                                <span class="icon icon-chevron-right-sm w-3.5 h-3.5" aria-hidden="true"></span>
                            </a>
                        }
                    }
                    else
                    {
                        <p class="text-sm" style="color: var(--text-tertiary)">No discussions yet.</p>
                    }
                </div>
            </div>

            <!-- Top Discussions Tab -->
            <div id="tab-top" class="sn-profile-tab-panel" hidden>
                @if (Model.Profile.TopDiscussions.Count > 0)
                {
                    <div class="flex flex-col divide-y" style="border-color: var(--border-secondary)">
                        @foreach (var td in Model.Profile.TopDiscussions)
                        {
                            var tdUrl = $"/c/{td.CommunitySlug}/h/{td.HubSlug}/{td.SpaceSlug}/{td.Slug}";
                            <a href="@tdUrl" class="py-3 first:pt-0 last:pb-0 block hover:opacity-80 transition-opacity">
                                <div class="flex items-center gap-2 text-xs mb-1" style="color: var(--text-tertiary)">
                                    <span>@td.CommunityName</span>
                                    <span>&rsaquo;</span>
                                    <span>@td.HubName</span>
                                    <span>&rsaquo;</span>
                                    <span>@td.SpaceName</span>
                                </div>
                                <p class="text-sm font-medium mb-1">@td.Title</p>
                                <div class="flex items-center gap-4 text-xs" style="color: var(--text-tertiary)">
                                    <span>❤️ @FormatCount(td.ReactionCount)</span>
                                    <span>💬 @FormatCount(td.PostCount)</span>
                                    <span>@Model.FormatDate(td.CreatedAt.ToDateTime())</span>
                                </div>
                            </a>
                        }
                    </div>
                }
                else
                {
                    <p class="text-sm" style="color: var(--text-tertiary)">No top discussions yet.</p>
                }
            </div>

            <!-- Posts Tab -->
            <div id="tab-posts" class="sn-profile-tab-panel" hidden>
                <div id="recent-posts">
                    <div class="flex flex-col gap-3">
                        <div class="skeleton h-20 w-full rounded"></div>
                        <div class="skeleton h-20 w-full rounded"></div>
                        <div class="skeleton h-20 w-full rounded"></div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>

<!-- Right Column -->
<aside class="sn-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
    if (Model.Profile != null)
    {
        ViewData["RightPane.Actions"] = new[] { "feed", "share", "follow-user" };
        ViewData["RightPane.FeedUrl"] = $"/u/{UlidBase62.Encode(Model.Profile.PublicId)}/feed";
        ViewData["RightPane.ShareTitle"] = Model.Profile.DisplayName;
        ViewData["RightPane.ShareIsPublic"] = true;
    }
}
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="sn-right-body">
    @if (Model.Profile != null)
    {
        <!-- Achievements -->
        @if (Model.Profile.Achievements is { Count: > 0 })
        {
            <div class="sn-right-section" id="achievements-section">
                <div class="sn-right-title">Achievements</div>
                <div id="achievements-grid" class="grid grid-cols-3 gap-3">
                    @foreach (var a in Model.Profile.Achievements)
                    {
                        <div class="achievement-item" title="@a.Description">
                            <div class="achievement-icon achievement-tier-@a.Tier.ToString().ToLowerInvariant()">
                                @if (!string.IsNullOrEmpty(a.IconUrl))
                                {
                                    <img src="@a.IconUrl" alt="" width="24" height="24" />
                                }
                                else
                                {
                                    <span class="icon icon-star" aria-hidden="true"></span>
                                }
                            </div>
                            <span class="achievement-name">@a.Name</span>
                        </div>
                    }
                </div>
            </div>
        }

        <!-- Most Active Spaces -->
        @if (Model.Profile.TopSpaces.Count > 0)
        {
            <div class="sn-right-section">
                <div class="sn-right-title">Most Active In</div>
                <div class="flex flex-col gap-1">
                    @foreach (var s in Model.Profile.TopSpaces)
                    {
                        var spaceUrl = $"/c/{s.CommunitySlug}/h/{s.HubSlug}/{s.SpaceSlug}";
                        <a href="@spaceUrl" class="sn-space-item">
                            <img src="@SnakkUrlHelper.SpaceAvatar(s.PublicId, avatarFileName: s.HasSpaceAvatarFileName ? s.SpaceAvatarFileName : null)"
                                 alt="" width="20" height="20" decoding="async" />
                            <span class="truncate">@s.SpaceName</span>
                            <span class="sn-space-count">@s.PostCount</span>
                        </a>
                    }
                </div>
            </div>
        }

        <!-- Recent Activity -->
        <div class="sn-right-section">
            <div class="sn-right-title">Recent Activity</div>
            <div class="text-sm">
                @if (Model.Profile.LastSeenAt != null)
                {
                    <div class="flex items-center gap-2" style="color: var(--text-tertiary)">
                        <span class="icon icon-clock w-3.5 h-3.5" aria-hidden="true"></span>
                        <span>Last seen @Model.GetRelativeTime(Model.Profile.LastSeenAt?.ToDateTime())</span>
                    </div>
                }
                else
                {
                    <span style="color: var(--text-tertiary)">No recent activity</span>
                }
            </div>
        </div>

        <!-- Name History (own profile only) -->
        <div class="sn-right-section hidden" id="name-history-section">
            <div class="sn-right-title">Name History</div>
            <div id="name-history-list"></div>
        </div>
    }
    </div>
</div>
</aside>

@* Inline in page body (not @section Scripts) so HTMX re-executes on swap — #main-content is the swap target, sections are not swapped. *@
@if (Model.Profile != null)
{
    <script type="application/json" id="profile-page-config">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
{
    userId = Model.Profile!.PublicId,
    totalActivity = Model.Profile.DiscussionCount + Model.Profile.ReplyCount,
    daysSinceJoined = (DateTime.UtcNow - Model.Profile!.JoinedAt!.ToDateTime()).Days,
    discussionCount = Model.Profile.DiscussionCount
}, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
    </script>
}
<script src="@SnakkUrlHelper.Js("pages/profile")" asp-append-version="true"></script>
