@page "/u/{publicId}"
@using Snakk.Web.Helpers
@using static Snakk.Web.Helpers.DisplayHelper
@model ProfileModel
@{
    ViewData["Title"] = Model.Profile?.DisplayName ?? "User Profile";
}

@section Meta {
    @if (Model.Profile != null)
    {
        var scheme = ViewContext.HttpContext.Request.Scheme;
        var host = ViewContext.HttpContext.Request.Host.ToString();
        var path = ViewContext.HttpContext.Request.Path.ToString();
        var url = $"{scheme}://{host}{path}";

        <link rel="alternate" type="application/json+oembed"
              href="/oembed?url=@Uri.EscapeDataString(url)"
              title="@Html.Encode(Model.Profile.DisplayName)" />
    }
}

@section Styles {
}

<div class="breadcrumb-bar">
    <nav class="breadcrumb">
        <a href="/">Home</a>
    </nav>
</div>

@if (Model.Profile == null)
{
    <div class="max-w-xl mx-auto">
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>User not found</h3>
                <p>This profile may have been removed or the link might be incorrect.</p>
                <a href="/" class="btn btn-primary btn-sm mt-4">Back to Home</a>
            </div>
        </div>
    </div>
}
else
{
    var daysSinceJoined = (DateTime.UtcNow - Model.Profile!.JoinedAt!.ToDateTime()).Days;
    var totalActivity = Model.Profile.DiscussionCount + Model.Profile.ReplyCount;
    var avgPerDay = daysSinceJoined > 0 ? totalActivity / (double)daysSinceJoined : 0;

    <div class="max-w-[90rem] mx-auto px-4 py-8">
        <!-- Profile Header (full width) -->
        <div class="page-header">
            <div class="flex items-start gap-4">
                <img src="@SnakkUrlHelper.UserAvatar(Model.Profile.PublicId)"
                     alt="@Model.Profile.DisplayName"
                     width="64" height="64"
                     class="w-16 h-16 rounded-full shrink-0" />
                <div class="flex-1 min-w-0">
                    <div class="flex items-center gap-2 flex-wrap">
                        <h1>@Model.Profile.DisplayName</h1>
                        <div id="profile-actions" class="ml-auto">
                            <div class="skeleton h-8 w-24"></div>
                        </div>
                    </div>
                    <div class="flex items-center gap-3 text-sm text-base-content/60 mt-1">
                        <span class="flex items-center gap-1">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z" />
                            </svg>
                            Joined @Model.FormatDate(Model.Profile.JoinedAt?.ToDateTime())
                        </span>
                    </div>
                </div>
            </div>
        </div>

        <div class="flex flex-col lg:flex-row gap-3">
            <!-- Sidebar (renders first on small screens, right column on lg+) -->
            <!-- Sidebar: first on small screens, right column on lg+ -->
            <aside id="sticky-sidebar" class="w-full lg:w-80 xl:w-96 shrink-0 order-first lg:order-last" hx-boost="false">
            <div id="sidebar-inner">
                <!-- Stats -->
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Stats</h3>
                    <div class="grid grid-cols-2 gap-3">
                        <div>
                            <div class="text-lg font-semibold">@FormatCount(Model.Profile.DiscussionCount)</div>
                            <div class="text-xs text-base-content/50">Discussions</div>
                        </div>
                        <div>
                            <div class="text-lg font-semibold" id="stat-replies">@FormatCount(Model.Profile.ReplyCount)</div>
                            <div class="text-xs text-base-content/50">Replies</div>
                        </div>
                        <div>
                            <div class="text-lg font-semibold">@FormatCount(totalActivity)</div>
                            <div class="text-xs text-base-content/50">Total Activity</div>
                        </div>
                        <div>
                            <div class="text-lg font-semibold" id="stat-followers">@FormatCount(Model.Profile.FollowerCount)</div>
                            <div class="text-xs text-base-content/50">Followers</div>
                        </div>
                    </div>
                </div>

                <!-- Achievements -->
                <div class="sidebar-section hidden" id="achievements-section">
                    <h3 class="sidebar-title">Achievements</h3>
                    <div id="achievements-grid" class="grid grid-cols-3 gap-3"></div>
                </div>

                <!-- Membership -->
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Membership</h3>
                    <div class="space-y-2 text-sm">
                        <div class="flex items-center justify-between">
                            <span class="text-base-content/60">Member for</span>
                            <span class="font-medium">@daysSinceJoined days</span>
                        </div>
                        <div class="flex items-center justify-between">
                            <span class="text-base-content/60">Avg. activity</span>
                            <span class="font-medium">~@avgPerDay.ToString("F1")/day</span>
                        </div>
                    </div>
                </div>

                <!-- Recent Activity -->
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Recent Activity</h3>
                    <div class="text-sm">
                        @if (Model.Profile.LastSeenAt != null)
                        {
                            <div class="flex items-center gap-2 text-base-content/60">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-3.5 w-3.5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 8v4l3 3m6-3a9 9 0 11-18 0 9 9 0 0118 0z" />
                                </svg>
                                <span>Last seen @Model.GetRelativeTime(Model.Profile.LastSeenAt?.ToDateTime())</span>
                            </div>
                        }
                        else
                        {
                            <span class="text-base-content/60">No recent activity</span>
                        }
                    </div>
                </div>

                <!-- Name History (own profile only, populated by JS) -->
                <div class="sidebar-section hidden" id="name-history-section">
                    <h3 class="sidebar-title">Name History</h3>
                    <div id="name-history-list"></div>
                </div>

                <!-- Activity History (sidebar, lg+ only) -->
                <div class="sidebar-section hidden lg:block">
                    <h3 class="sidebar-title flex items-center justify-between">
                        Activity History
                        <span class="text-sm font-normal text-base-content/50">Last 30 days</span>
                    </h3>
                    <div id="activity-chart-sidebar">
                        <div class="space-y-3">
                            <div class="skeleton h-32 w-full"></div>
                            <div class="flex justify-center gap-3">
                                <div class="skeleton h-3 w-16"></div>
                                <div class="skeleton h-3 w-16"></div>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            </aside>

            <!-- Main content lists -->
            <div class="flex-1 min-w-0 space-y-4">
                <!-- Activity History (small screens only) -->
                <div class="lg:hidden">
                    <div class="section-header">
                        <span class="section-title">Activity History</span>
                        <span class="text-sm font-normal text-base-content/50">Last 30 days</span>
                    </div>
                    <div class="clean-card">
                        <div id="activity-chart-main" class="p-6">
                            <div class="space-y-3">
                                <div class="skeleton h-48 w-full"></div>
                                <div class="flex justify-center gap-4">
                                    <div class="skeleton h-4 w-24"></div>
                                    <div class="skeleton h-4 w-24"></div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Recent Discussions -->
                <div class="section-header">
                    <span class="section-title">Recent Discussions</span>
                </div>
                <div id="recent-discussions">
                    <div class="clean-card p-4">
                        <div class="space-y-4">
                            <div class="skeleton h-16 w-full"></div>
                            <div class="skeleton h-16 w-full"></div>
                            <div class="skeleton h-16 w-full"></div>
                        </div>
                    </div>
                </div>

                <!-- Recent Posts -->
                <div class="section-header">
                    <span class="section-title">Recent Posts</span>
                </div>
                <div id="recent-posts">
                    <div class="clean-card p-4">
                        <div class="space-y-4">
                            <div class="skeleton h-20 w-full"></div>
                            <div class="skeleton h-20 w-full"></div>
                            <div class="skeleton h-20 w-full"></div>
                        </div>
                    </div>
                </div>
            </div>
        </div>
    </div>
}

@section Scripts {
    <script src="@SnakkUrlHelper.Js("pages/profile")" asp-append-version="true" defer></script>
    @if (Model.Profile != null)
    {
        @* INLINE REASON: Initialization code with Razor syntax for server-side data.
           Passes render-time values to external profile.js. Must stay inline to access @@Model. *@
        <script>
            (function() {
                function init() {
                    var totalActivity = @Model.Profile!.DiscussionCount + @Model.Profile.ReplyCount;
                    var daysSinceJoined = @((DateTime.UtcNow - Model.Profile!.JoinedAt!.ToDateTime()).Days);
                    var discussionCount = @Model.Profile.DiscussionCount;
                    var postCount = @Model.Profile.ReplyCount;

                    initializeProfile('@Model.Profile?.PublicId', {
                        totalActivity: totalActivity,
                        daysSinceJoined: daysSinceJoined,
                        discussionCount: discussionCount,
                        postCount: postCount
                    });
                }
                if (document.readyState === 'loading') {
                    document.addEventListener('DOMContentLoaded', init);
                } else {
                    init();
                }
            })();
        </script>
    }
}
