@page "/hubs"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.Hubs.IndexModel
@inject IConfiguration Configuration
@{
    ViewData["Title"] = "Hubs";
    var apiBaseUrl = Configuration["ApiBaseUrl"] ?? "https://localhost:17100";
}

<div class="breadcrumb-bar">
    <nav class="breadcrumb">
        <a href="/">Home</a>
        @if (Model.ShowCommunityInBreadcrumb)
        {
            <span class="breadcrumb-separator">/</span>
            <a href="/communities">Communities</a>
            <span class="breadcrumb-separator">/</span>
            <a href="/c/@Model.Community.CommunitySlug">@(Model.Community.CommunityName ?? Model.Community.CommunitySlug)</a>
        }
    </nav>
</div>
<div class="max-w-6xl mx-auto px-4 py-8">
    <!-- Page Header with Stats -->
    <div class="page-header">
        <div class="flex flex-col lg:flex-row lg:items-start lg:justify-between gap-4">
            <div>
                <h1>Hubs</h1>
                <p>Browse communities and join the conversation</p>
            </div>
            @if (User.Identity?.IsAuthenticated == true && !string.IsNullOrEmpty(Model.Community.CommunitySlug))
            {
                <div class="flex-shrink-0">
                    <a href="@SnakkUrlHelper.ManageCommunity(Model.Community.CommunitySlug)" class="btn btn-primary">Manage Community</a>
                </div>
            }
            @*
            @if (Model.PlatformStats != null || Model.CommunityStats != null)
            {
                <div class="w-full lg:w-80 flex-shrink-0">
                    <div class="stats-panel">
                        <div class="stats-grid">
                            <div class="stat-item">
                                <span class="stat-value">@Model.SpaceCount</span>
                                <span class="stat-label">Spaces</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-value">@Model.DiscussionCount</span>
                                <span class="stat-label">Discussions</span>
                            </div>
                            <div class="stat-item">
                                <span class="stat-value">@Model.ReplyCount</span>
                                <span class="stat-label">Replies</span>
                            </div>
                        </div>
                    </div>
                </div>
            }
            *@
        </div>
    </div>

    <!-- Two Column Layout -->
    <div class="flex flex-col lg:flex-row gap-6">
        <!-- Left Column: Hubs -->
        <div class="flex-1 min-w-0">
            @if (Model.Hubs?.Items == null || !Model.Hubs.Items.Any())
            {
                <div class="clean-card">
                    <div class="empty-state-simple">
                        <h3>No hubs yet</h3>
                        <p>Hubs are coming soon. Check back later to explore communities.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-4">
                    @foreach (var hub in Model.Hubs.Items)
                    {
                        <a href="@SnakkUrlHelper.Hub(Model.Community, hub.Slug)" class="category-card">
                            <div class="flex items-start gap-3">
                                <img src="@SnakkUrlHelper.HubAvatar(hub.PublicId)" alt="" width="40" height="40" class="w-10 h-10 rounded-full flex-shrink-0" />
                                <div class="flex-1 min-w-0">
                                    <h2 class="category-title">@hub.Name</h2>
                                    @if (!string.IsNullOrEmpty(hub.Description))
                                    {
                                        <p class="category-description line-clamp-2">@hub.Description</p>
                                    }
                                    <div class="entity-stats mt-2">
                                        <span>@hub.SpaceCount spaces</span>
                                        <span class="entity-stats-separator">·</span>
                                        <span>@hub.DiscussionCount discussions</span>
                                        <span class="entity-stats-separator">·</span>
                                        <span>@hub.ReplyCount replies</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>

                @if (Model.Hubs.Offset > 0 || Model.Hubs.HasMoreItems)
                {
                    <div class="flex justify-center gap-2 mt-8">
                        @if (Model.Hubs.Offset > 0)
                        {
                            <a href="/hubs?offset=@(Math.Max(0, Model.Hubs.Offset - Model.Hubs.PageSize))"
                               class="btn btn-ghost btn-sm">
                                Previous
                            </a>
                        }
                        @if (Model.Hubs.HasMoreItems)
                        {
                            <a href="/hubs?offset=@(Model.Hubs.Offset + Model.Hubs.PageSize)"
                               class="btn btn-ghost btn-sm">
                                Next
                            </a>
                        }
                    </div>
                }
            }
        </div>

        <!-- Right Column: Trending -->
        <aside class="w-full lg:w-80 flex-shrink-0" hx-push-url="false">
            @if (Model.ShowTrendingSpaces)
            {
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Trending Spaces</h3>
                    <inline-or-htmx partial="Shared/Sidebar/_TrendingSpaces"
                                     model="Model.InlineTrendingSpaces"
                                     htmx-url="/partials/trending-spaces?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                        <div class="flex flex-col gap-3">
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }

            @if (Model.ShowTrendingDiscussions)
            {
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Trending Discussions</h3>
                    <inline-or-htmx partial="Shared/Sidebar/_TrendingDiscussions"
                                     model="Model.InlineTrendingDiscussions"
                                     htmx-url="/partials/trending-discussions?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                        <div class="flex flex-col gap-3">
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }

            @if (Model.ShowTrendingContributors)
            {
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Trending Contributors</h3>
                    <inline-or-htmx partial="Shared/Sidebar/_TrendingContributors"
                                     model="Model.InlineTrendingContributors"
                                     htmx-url="/partials/trending-contributors?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                        <div class="flex flex-col gap-3">
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }
        </aside>
    </div>
</div>
