@page "/h/{slug}/rules"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.Hubs.RulesModel
@{
    ViewData["Title"] = $"{Model.Hub?.Name} Rules";
    ViewData["Description"] = $"Rules and guidelines for the {Model.Hub?.Name} hub.";
}

@if (Model.Hub == null)
{
    <div class="max-w-xl mx-auto">
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>Hub not found</h3>
                <p>This hub may have been removed or the link might be incorrect.</p>
                <a href="/hubs" class="btn btn-primary btn-sm mt-4">Back to Hubs</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="breadcrumb-bar">
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span class="breadcrumb-separator">/</span>
            @if (Model.ShowCommunityInBreadcrumb && Model.CommunityDetail != null)
            {
                <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)">@Model.CommunityDetail.Name</a>
                <span class="breadcrumb-separator">/</span>
            }
            <a href="@SnakkUrlHelper.Hub(Model.Community, Model.Hub.Slug)">@Model.Hub.Name</a>
            <span class="breadcrumb-separator">/</span>
            <span>Rules</span>
        </nav>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-8">
        <div class="page-header">
            <h1>@Model.Hub.Name Rules</h1>
            @if (!string.IsNullOrEmpty(Model.Hub.Description))
            {
                <p>@Model.Hub.Description</p>
            }
        </div>

        <div class="clean-card">
            @if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
            {
                <div class="empty-state-simple">
                    <p>No rules have been defined for this hub yet.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col divide-y divide-base-200">
                    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
                    {
                        <details class="group py-3 first:pt-0 last:pb-0">
                            <summary class="flex items-center justify-between cursor-pointer text-sm font-medium">
                                <span>@(index + 1). @rule.Title</span>
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24"
                                     fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round"
                                     stroke-linejoin="round"
                                     class="flex-shrink-0 transition-transform group-open:rotate-180">
                                    <polyline points="6 9 12 15 18 9"></polyline>
                                </svg>
                            </summary>
                            <p class="text-sm text-base-content/70 pl-4 pt-2">@rule.Description</p>
                        </details>
                    }
                </div>
            }
        </div>

        <div class="mt-4 flex flex-col gap-2">
            @if (Model.Hub.ParentCommunityHasRules && Model.CommunityDetail != null)
            {
                <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)/rules"
                   class="text-sm hover:text-primary transition-colors">
                    View @Model.CommunityDetail.Name Rules &rarr;
                </a>
            }
            <a href="/rules" class="text-sm hover:text-primary transition-colors">
                View Site Rules &rarr;
            </a>
        </div>
    </div>
}
