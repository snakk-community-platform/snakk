@page "/c/{communitySlug}/h/{slug}/moderators"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.Hubs.ModeratorsModel
@{
    ViewData["Title"] = string.Format(T.Pages.HubModsTitlePattern, Model.Hub?.Name);
    ViewData["Description"] = string.Format(T.Pages.HubModsDescPattern, Model.Hub?.Name);
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@section CenterHeader {
    @if (Model.Hub != null)
    {
        @if (Model.ShowCommunityInBreadcrumb && Model.CommunityDetail != null)
        {
            <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)" class="sn-badge sn-badge-ghost sn-badge-sm">@Model.CommunityDetail.Name</a>
            <span class="sn-page-labels-sep">›</span>
        }
        <a href="@SnakkUrlHelper.Hub(Model.Community, Model.Hub.Slug)" class="sn-badge sn-badge-ghost sn-badge-sm">@Model.Hub.Name</a>
    }
}

@if (Model.Hub == null)
{
    <div class="sn-center">
        <div class="sn-center-inner">
            <partial name="Shared/_EmptyState" model='new EmptyStateVM(T.Pages.HubModsNotFound, T.Pages.HubModsBackToHome, "/")' />
        </div>
    </div>
}
else
{
    <div class="sn-center">
        <div class="sn-center-inner">
            <div class="sn-section-header">
                <h2 class="sn-section-title">
                    <span class="icon icon-user-add" aria-hidden="true"></span>
                    @Model.Hub.Name@T.Pages.HubModsHeadingSuffix
                </h2>
            </div>
            @if (!string.IsNullOrEmpty(Model.Hub.Description))
            {
                <p class="sn-text-sm sn-mb-6" style="color: var(--text-secondary)">@Model.Hub.Description</p>
            }
            else
            {
                <div class="sn-mb-6"></div>
            }

            @if (Model.Moderators == null || Model.Moderators.TotalCount == 0)
            {
                <p class="sn-text-sm" style="color: var(--text-tertiary)">@T.Pages.HubModsEmpty</p>
            }
            else
            {
                <partial name="Shared/_ModeratorGrid" model="Model.Moderators.Groups" />
            }

            <div class="sn-mt-6 sn-pt-4" style="border-top: 1px solid var(--border-secondary)">
                <p class="sn-section-label" style="color: var(--text-tertiary)">@T.Pages.HubModsSeeAlso</p>
                @if (Model.CommunityDetail != null)
                {
                    <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)/moderators"
                       class="sn-sidebar-nav-link--moderators" style="color: var(--text-secondary)">
                        <span>@Model.CommunityDetail.Name@T.Pages.HubModsCommunityModsSuffix</span>
                        <span class="sn-icon icon-chevron-right sn-icon--xs" aria-hidden="true"></span>
                    </a>
                }
                <a href="/moderators" class="sn-sidebar-nav-link--moderators" style="color: var(--text-secondary)">
                    <span>@T.Pages.HubModsSiteMods</span>
                    <span class="sn-icon icon-chevron-right sn-icon--xs" aria-hidden="true"></span>
                </a>
            </div>
        </div>
    </div>

@if (!DeviceDetection.IsMobile(HttpContext))
{
<aside class="sn-right">
<div class="sn-right-sticky">
    <div class="sn-right-section"
         hx-get="/partials/platform-stats?scopeType=platform&scopeId=global"
         hx-trigger="load delay:100ms"
         hx-target="this"
         hx-swap="innerHTML">
        <div class="sn-right-title">
            <span class="icon icon-chart-bar" aria-hidden="true"></span>
            @T.Pages.HubModsSiteStats
        </div>
        <div class="sn-grid sn-grid-cols-2 sn-gap-3">
            <div><div class="sn-skeleton h-5 sn-w-8 sn-mb-1"></div><div class="sn-skeleton h-3 sn-w-16"></div></div>
            <div><div class="sn-skeleton h-5 sn-w-8 sn-mb-1"></div><div class="sn-skeleton h-3 sn-w-10"></div></div>
        </div>
    </div>

    <div class="sn-right-section"
         hx-get="/partials/trending-discussions?scopeType=platform&scopeId=global"
         hx-trigger="load delay:100ms"
         hx-target="this"
         hx-swap="innerHTML">
        <div class="sn-right-title">
            <span class="icon icon-trending-up" aria-hidden="true"></span>
            @T.Pages.HubModsTrending
        </div>
        <div class="sn-skeleton-list--moderators">
            <div class="sn-skeleton-item-row"><div class="sn-skeleton h-8 sn-w-8 sn-shrink-0 sn-rounded-full"></div><div class="sn-flex-1"><div class="sn-skeleton h-3 sn-w-full"></div><div class="sn-skeleton h-3 w-3/4 sn-mt-1"></div></div></div>
            <div class="sn-skeleton-item-row"><div class="sn-skeleton h-8 sn-w-8 sn-shrink-0 sn-rounded-full"></div><div class="sn-flex-1"><div class="sn-skeleton h-3 w-5/6"></div><div class="sn-skeleton h-3 w-2/3 sn-mt-1"></div></div></div>
        </div>
    </div>
</div>
</aside>
}
}
