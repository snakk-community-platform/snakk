@using Snakk.Web.Helpers
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Snakk.Web.Services.ICommunityContext CommunityContext
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
<!DOCTYPE html>
<html lang="en" data-theme="forest">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Snakk</title>

    <!-- SEO Meta Tags -->
    <meta property="og:site_name" content="Snakk" />
    @await RenderSectionAsync("Meta", required: false)
    @if (ViewData["Description"] != null)
    {
        <meta name="description" content="@ViewData["Description"]" />
    }

    <!-- Canonical URL (pages can override via ViewData["CanonicalUrl"]) -->
    <link rel="canonical" href="@(ViewData["CanonicalUrl"] as string ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}")" />
    @if (ViewData["RssFeedUrl"] is string rssFeedUrl)
    {
        <link rel="alternate" type="application/rss+xml" title="@(ViewData["RssFeedTitle"] ?? "RSS Feed")" href="@rssFeedUrl" />
    }
    <link rel="search" type="application/opensearchdescription+xml" title="Snakk" href="/opensearch.xml" />

    <!-- Realtime WebSocket connects same-origin through the gateway — no preconnect needed -->

    <!-- CSRF Token for JavaScript -->
    @{
        var tokens = Antiforgery.GetAndStoreTokens(Context);
    }
    <meta name="csrf-token" content="@tokens.RequestToken" />

    <!-- Preload critical resources — browser starts downloading before parser reaches them -->
    <link rel="preload" href="@SnakkUrlHelper.Css("tailwind", isVendor: true)" as="style" asp-append-version="true" fetchpriority="high" />
    <link rel="preload" href="@SnakkUrlHelper.Css("site")" as="style" asp-append-version="true" fetchpriority="high" />
    <link rel="preload" href="@SnakkUrlHelper.Js("htmx.min", isVendor: true)" as="script" asp-append-version="true" />

    @* INLINE REASON: Must run synchronously before first paint to prevent theme flash (FOUC).
       Reads localStorage preference, resolves auto→system, sets data-theme, and loads dark CSS if needed.
       Full theme.ts is deferred below. *@
    @{
        var darkThemeCssUrl = FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Css("dark-theme", isVendor: true));
    }
    @* <script>
        (function() {
            var p = localStorage.getItem('snakk_theme_preference');
            var isDark = p === 'dark' || ((!p || p === 'auto') && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.setAttribute('data-theme', isDark ? 'dark' : 'lofi');
            if (isDark) { var l = document.createElement('link'); l.id = 'dark-theme-css'; l.rel = 'stylesheet'; l.href = '@Html.Raw(darkThemeCssUrl)'; document.head.appendChild(l); }
        })();
    </script> *@

    <!-- Dark theme CSS URL for dynamic loading by theme.ts -->
    <meta name="dark-theme-css" content="@darkThemeCssUrl" />

    <!-- Tailwind CSS + daisyUI (locally compiled, light theme only — dark loaded on demand) -->
    <link href="@SnakkUrlHelper.Css("tailwind", isVendor: true)" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("site")" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <!-- HTMX + extensions (preload on hover, head merge on SPA nav) -->
    <script src="@SnakkUrlHelper.Js("htmx.min", isVendor: true)" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("htmx-preload", isVendor: true)" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("htmx-head-support", isVendor: true)" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("core/loading-bar")" asp-append-version="true" defer></script>
    <!-- Action delegation (must load before page scripts that register handlers) -->
    <script src="@SnakkUrlHelper.Js("core/actions")" asp-append-version="true" defer></script>
    <!-- Auth (CSRF interceptor) + Theme (full management, toggle, system listener) -->
    <script src="@SnakkUrlHelper.Js("core/auth")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("core/theme")" asp-append-version="true" defer></script>

    <!-- Runtime configuration (read by JS from meta tags — no inline scripts) -->
    <meta name="realtime-service-url" content="@(Configuration["RealtimeServiceUrl"] ?? "/realtime")" />

    <!-- Note: JavaScript only calls /bff/* endpoints for HTTP (Backend-for-Frontend pattern)
         JavaScript connects directly to Snakk.Realtime for WebSocket (no proxy) -->
</head>
<body class="antialiased" hx-boost="true" hx-target="#main-content" hx-swap="innerHTML show:window:top" hx-push-url="true" hx-ext="preload,head-support" preload>
    <div id="loading-bar" class="loading-bar"></div>
    @if (HostEnvironment.IsDevelopment())
    {
        var host = HttpContextAccessor.HttpContext?.Request.Host.ToString() ?? "unknown";
        var communitySlug = CommunityContext.CommunitySlug ?? "null";
        var communityName = CommunityContext.CommunityName;
        var requestPath = HttpContextAccessor.HttpContext?.Request.Path.ToString() ?? "/";
        <div id="snakk-debug-context" class="hidden"
             data-host="@host"
             data-community-slug="@communitySlug"
             data-community-name="@communityName"
             data-is-multi-community="@CommunityContext.IsMultiCommunityEnabled"
             data-is-custom-domain="@CommunityContext.IsCustomDomain"
             data-path="@requestPath"></div>
    }
    <nav class="navbar minimal-nav sticky top-0 z-50">
        <div class="w-full max-w-[90rem] mx-auto px-4 flex items-center gap-4">
            <!-- Brand -->
            <a class="brand-text" href="/">@(CommunityContext.IsCustomDomain && CommunityContext.CommunityName != null ? CommunityContext.CommunityName : "Snakk")</a>

            <!-- Desktop Search -->
            <form method="get" action="/search" class="hidden sm:flex items-center gap-1 flex-1 max-w-md" hx-boost="false" id="search-form">
                <div class="relative flex-1" id="search-wrapper">
                    <button type="submit" class="absolute left-1 top-1/2 -translate-y-1/2 btn btn-ghost btn-xs btn-circle" aria-label="Search">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                        </svg>
                    </button>
                    <input type="text"
                           id="search-input"
                           name="q"
                           placeholder="Search..."
                           class="input input-sm w-full pl-8"
                           autocomplete="off" />

                    <!-- Search Focus Pane -->
                    <div id="search-focus-pane" class="search-focus-pane hidden">
                        <div class="p-4 space-y-4">
                            <!-- Search Type -->
                            <div>
                                <label class="text-sm font-medium mb-2 block">Search Type</label>
                                <div class="join flex-wrap">
                                    <input class="join-item btn btn-sm" type="radio" name="search-type" aria-label="Post" checked />
                                    <input class="join-item btn btn-sm" type="radio" name="search-type" aria-label="Discussion" />
                                    <input class="join-item btn btn-sm" type="radio" name="search-type" aria-label="Space" />
                                    <input class="join-item btn btn-sm" type="radio" name="search-type" aria-label="User" />
                                </div>
                            </div>

                            <!-- Date Range -->
                            <div>
                                <label class="text-sm font-medium mb-2 block">Date Range</label>
                                <div class="join flex-wrap">
                                    <input class="join-item btn btn-sm" type="radio" name="date-range" aria-label="Today" checked />
                                    <input class="join-item btn btn-sm" type="radio" name="date-range" aria-label="Past hour" />
                                    <input class="join-item btn btn-sm" type="radio" name="date-range" aria-label="Past week" />
                                    <input class="join-item btn btn-sm" type="radio" name="date-range" aria-label="Past month" />
                                    <input class="join-item btn btn-sm" type="radio" name="date-range" aria-label="Past year" />
                                    <input class="join-item btn btn-sm" type="radio" name="date-range" aria-label="All time" />
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            </form>

            <!-- Right: Mobile Search + Auth -->
            <div class="flex items-center gap-2 ml-auto">
                <!-- Mobile Search Icon -->
                <a href="/search" class="btn btn-ghost btn-sm btn-square sm:hidden" title="Search">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                        <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M21 21l-6-6m2-5a7 7 0 11-14 0 7 7 0 0114 0z" />
                    </svg>
                </a>
                <div id="auth-nav" class="flex items-center">
                    <partial name="Shared/_AuthNav" />
                </div>
            </div>
        </div>
    </nav>

    @{
        var _tz = Context.Request.Cookies[".Snakk.Pref.Timezone"];
    }
    <meta name="snakk-timezone" content="@(_tz ?? "UTC")" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="current-user-id" content="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
    }
    <script src="@SnakkUrlHelper.Js("components/auth-navbar")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/search-focus")" asp-append-version="true" defer></script>

    <main id="main-content" class="pb-12">
        <div id="page-title" data-title="@ViewData["Title"] - Snakk" class="hidden"></div>
        @RenderBody()
    </main>

    <!-- SignalR Client URL (lazy-loaded by realtime.ts when idle) -->
    <meta name="signalr-src" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("signalr.min", isVendor: true))" />

    @if (HostEnvironment.IsDevelopment())
    {
        <script src="@SnakkUrlHelper.Js("components/debug")" asp-append-version="true" defer></script>
    }

    <!-- Realtime Updates -->
    <script src="@SnakkUrlHelper.Js("services/realtime")" asp-append-version="true" defer></script>

    <!-- Non-critical scripts: URLs for lazy-loader (core/script-loader.ts) -->
    <meta name="lazy-site-js" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("components/site"))" />
    <meta name="lazy-sidebar-js" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("components/sidebar-scrollbar"))" />
    <meta name="lazy-breadcrumb-js" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("components/breadcrumb-title"))" />
    <script src="@SnakkUrlHelper.Js("core/script-loader")" asp-append-version="true" defer></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
