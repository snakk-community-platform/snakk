@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Snakk.Web.Services.ICommunityContext CommunityContext
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var themeCookie = isAuth ? Context.Request.Cookies[AuthCookieHelper.ThemeCookieName] : null;
    var initialTheme = themeCookie == "dark" ? "dark" : "lofi";
}
<!DOCTYPE html>
<html lang="en" data-theme="@initialTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Snakk</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/img/favicon/site.webmanifest" />

    @{
        var canonicalUrl = ViewData["CanonicalUrl"] as string
            ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
        var ogTitle = ViewData["OgTitle"] as string ?? ViewData["Title"] as string ?? "Snakk";
        var ogDescription = ViewData["OgDescription"] as string ?? ViewData["Description"] as string;
        var ogImage = ViewData["OgImage"] as string
            ?? $"{Context.Request.Scheme}://{Context.Request.Host}/img/logo-square.webp";
        var ogType = ViewData["OgType"] as string ?? "website";
    }
    <meta property="og:site_name" content="Snakk" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    @if (!string.IsNullOrEmpty(ogDescription))
    {
        <meta property="og:description" content="@ogDescription" />
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:image" content="@ogImage" />
    @if (!string.IsNullOrEmpty(ogDescription))
    {
        <meta name="twitter:description" content="@ogDescription" />
    }

    <link rel="alternate" type="application/json+oembed"
          href="@($"{Context.Request.Scheme}://{Context.Request.Host}/oembed?url={Uri.EscapeDataString(canonicalUrl)}")"
          title="@ogTitle" />

    @await RenderSectionAsync("Meta", required: false)
    @if (ViewData["Description"] != null)
    {
        <meta name="description" content="@ViewData["Description"]" />
    }

    <link rel="canonical" href="@canonicalUrl" />
    @if (ViewData["RssFeedUrl"] is string rssFeedUrl)
    {
        <link rel="alternate" type="application/rss+xml" title="@(ViewData["RssFeedTitle"] ?? "RSS Feed")" href="@rssFeedUrl" />
    }
    <link rel="search" type="application/opensearchdescription+xml" title="Snakk" href="/opensearch.xml" />

    @{
        var tokens = Antiforgery.GetAndStoreTokens(Context);
    }
    <meta name="csrf-token" content="@tokens.RequestToken" />

    <link rel="preload" href="@SnakkUrlHelper.Css("tailwind", isVendor: true)" as="style" asp-append-version="true" fetchpriority="high" />
    <link rel="preload" href="@SnakkUrlHelper.Css("site")" as="style" asp-append-version="true" fetchpriority="high" />
    <link rel="preload" href="@SnakkUrlHelper.Js("htmx.min", isVendor: true)" as="script" asp-append-version="true" />

    @{
        var darkThemeCssUrl = FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Css("dark-theme", isVendor: true));
    }
    <meta name="dark-theme-css" content="@darkThemeCssUrl" />

    @* INLINE REASON: Must run synchronously before first paint to prevent theme flash (FOUC).
       For authenticated users: server already rendered the correct data-theme from the cookie.
       This script only needs to handle the "auto" case (system dark preference) and inject the
       dark CSS link. For unauthenticated users: always lofi, nothing to do. *@
    <script id="theme-fouc-script" hx-preserve nonce="@(Context.Items["csp-nonce"] as string)">
        (function () {
            try {
                @if (isAuth) {
                <text>
                var p = '@Html.Raw(themeCookie ?? "")';
                var isDark = p === 'dark' || (p === 'auto' && window.matchMedia('(prefers-color-scheme: dark)').matches);
                if (isDark) {
                    document.documentElement.setAttribute('data-theme', 'dark');
                    var l = document.createElement('link');
                    l.id = 'dark-theme-css';
                    l.rel = 'stylesheet';
                    l.href = '@Html.Raw(darkThemeCssUrl)';
                    document.head.appendChild(l);
                }
                </text>
                }
            } catch (e) { }
        })();
    </script>

    <link href="@SnakkUrlHelper.Css("tailwind", isVendor: true)" rel="stylesheet" asp-append-version="true" />
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("site")" asp-append-version="true" />
    @await RenderSectionAsync("Styles", required: false)

    <script id="js-dompurify"    hx-preserve src="@SnakkUrlHelper.Js("dompurify.min", isVendor: true)" asp-append-version="true"></script>
    <script id="js-htmx"         hx-preserve src="@SnakkUrlHelper.Js("htmx.min", isVendor: true)" asp-append-version="true" defer></script>
    <script id="js-htmx-preload" hx-preserve src="@SnakkUrlHelper.Js("htmx-preload", isVendor: true)" asp-append-version="true" defer></script>
    <script id="js-htmx-head"    hx-preserve src="@SnakkUrlHelper.Js("htmx-head-support", isVendor: true)" asp-append-version="true" defer></script>
    <script id="js-loading-bar"  hx-preserve src="@SnakkUrlHelper.Js("core/loading-bar")" asp-append-version="true" defer></script>
    <script id="js-actions"      hx-preserve src="@SnakkUrlHelper.Js("core/actions")" asp-append-version="true" defer></script>
    <script id="js-auth"         hx-preserve src="@SnakkUrlHelper.Js("core/auth")" asp-append-version="true" defer></script>
    <script id="js-theme"        hx-preserve src="@SnakkUrlHelper.Js("core/theme")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("core/prefs")" asp-append-version="true"></script>

    <meta name="realtime-service-url" content="@(Configuration["RealtimeServiceUrl"] ?? "/realtime")" />
</head>
@* GOTCHA: hx-target on <body> inherits to ALL descendants. Any element with hx-get
   inside the body MUST set hx-target="this" (or its own target), otherwise its response
   will replace #main-content and wipe the whole page. Required by hx-boost — boosted
   anchors look up hx-target via inheritance, so we can't disinherit at body level. *@
<body class="antialiased" data-auth="@(isAuth ? "1" : "0")" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML show:window:top" hx-ext="preload,head-support" preload>
    <div id="loading-bar" class="loading-bar"></div>

    @{
        var _tz = Context.Request.Cookies[".Snakk.Pref.Timezone"];
    }
    <meta name="snakk-timezone" content="@(_tz ?? "UTC")" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="current-user-id" content="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
    }
    <script src="@SnakkUrlHelper.Js("components/auth-navbar")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/breadcrumb-title")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/left-sidebar")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/mobile-nav")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/lightbox")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("services/cache-manager")" asp-append-version="true" defer></script>
    @if (isAuth) {
        <script src="@SnakkUrlHelper.Js("core/upload")" asp-append-version="true" defer></script>
        <script src="@SnakkUrlHelper.Js("services/save-cache")" asp-append-version="true" defer></script>
        <script src="@SnakkUrlHelper.Js("components/save")" asp-append-version="true" defer></script>
    }
    <script src="@SnakkUrlHelper.Js("components/share")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/sparkline")" asp-append-version="true" defer></script>

    <!-- 3-column layout -->
    <div class="sn-layout">
        @await RenderSectionAsync("LeftColumn", required: false)
        <!-- Persistent right-column auth header — always present, outside the HTMX swap target -->
        <div class="sn-right-auth-header">
            <div id="auth-nav" class="flex items-center">
                <partial name="Shared/_AuthNav" />
            </div>
        </div>
        <div id="main-content" class="sn-main-body">
            <div class="sn-center-header">
                <div class="sn-search-wrap" id="sn-search-wrap">
                    <span class="icon icon-search sn-search-icon" aria-hidden="true"></span>
                    <input type="search" class="sn-search-input" id="sn-search-input"
                           placeholder="@T.Common.SearchPlaceholder" autocomplete="off" spellcheck="false"
                           aria-label="@T.Common.SearchPlaceholder" />
                    <div class="sn-search-popup" id="sn-search-popup" hidden>
                        <div class="sn-search-popup-row">
                            <span class="sn-search-popup-label">@T.Pages.SearchTypeLabel</span>
                            <div class="join flex-wrap">
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-type" value="post" aria-label="@T.Pages.SearchTypePost" />
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-type" value="discussion" aria-label="@T.Pages.SearchTypeDiscussion" />
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-type" value="space" aria-label="@T.Pages.SearchTypeSpace" />
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-type" value="user" aria-label="@T.Pages.SearchTypeUser" />
                            </div>
                        </div>
                        <div class="sn-search-popup-row">
                            <span class="sn-search-popup-label">@T.Pages.SearchDateLabel</span>
                            <div class="join flex-wrap">
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-date" value="past hour" aria-label="@T.Pages.SearchDatePastHour" />
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-date" value="today" aria-label="@T.Pages.SearchDateToday" />
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-date" value="past week" aria-label="@T.Pages.SearchDatePastWeek" />
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-date" value="past month" aria-label="@T.Pages.SearchDatePastMonth" />
                                <input class="join-item btn btn-sm" type="radio" name="sn-search-date" value="all time" aria-label="@T.Pages.SearchDateAllTime" checked />
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            @{ IgnoreSection("CenterHeader"); }
            @RenderBody()
            @* Synchronous (non-deferred) spoiler-reveal restore. Runs after the main
               content is parsed but before first paint so the spoiler overlay
               doesn't flash on revisit. HTMX re-executes it on swap. *@
            <script src="@SnakkUrlHelper.Js("core/spoiler-restore")" asp-append-version="true"></script>
        </div>
    </div>

    <meta name="signalr-src" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("signalr.min", isVendor: true))" />
    <script src="@SnakkUrlHelper.Js("services/realtime")" asp-append-version="true" defer></script>

    <meta name="lazy-site-js" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("components/site"))" />
    <script src="@SnakkUrlHelper.Js("core/script-loader")" asp-append-version="true" defer></script>

    <partial name="Shared/_MobileTabBar" />

    <script src="@SnakkUrlHelper.Js("components/search-bar")" asp-append-version="true" defer></script>

    <!-- External Link Warning Modal -->
    <dialog id="external-link-modal" class="modal">
        <div class="modal-box max-w-sm">
            <h3 class="text-base font-semibold mb-2">@string.Format(T.ExternalLink.Leaving, CommunityContext.CommunityName ?? "Snakk")</h3>
            <p class="text-sm text-base-content/70 mb-1">
                @T.ExternalLink.Redirecting <strong data-domain></strong>.
            </p>
            <p class="text-sm text-base-content/60 mb-4">
                @T.ExternalLink.Disclaimer
            </p>
            <label class="flex items-center gap-2 cursor-pointer mb-4 text-sm">
                <input type="checkbox" class="toggle toggle-sm toggle-primary" />
                @T.ExternalLink.DontWarn
            </label>
            <div class="flex justify-end gap-2">
                <button type="button" class="btn btn-ghost btn-sm" data-cancel>@T.Common.Cancel</button>
                <a href="#" class="btn btn-primary btn-sm" data-url target="_blank" rel="nofollow noopener noreferrer">@T.Common.ContinueAction</a>
            </div>
        </div>
    </dialog>
    <script src="@SnakkUrlHelper.Js("components/external-link-guard")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/syntax-highlight")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/chart-renderer")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("components/inline-gallery")" asp-append-version="true" defer></script>

    @if (HostEnvironment.IsDevelopment())
    {
        var _profilerIds = ViewContext.HttpContext.RequestServices.GetService<Snakk.Web.Services.ProfilerIdBag>()?.Joined;
        if (_profilerIds != null)
        {
            <meta name="snakk-profiler-ids" content="@_profilerIds" />
        }
        <script src="@SnakkUrlHelper.Js("dev/profiler")" asp-append-version="true" defer></script>
    }
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
