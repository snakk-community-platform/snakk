@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject Microsoft.Extensions.Configuration.IConfiguration Configuration
@inject Snakk.Web.Services.ICommunityContext CommunityContext
@inject IHttpContextAccessor HttpContextAccessor
@inject Microsoft.AspNetCore.Antiforgery.IAntiforgery Antiforgery
@inject Microsoft.AspNetCore.Hosting.IWebHostEnvironment HostEnvironment
@inject Microsoft.AspNetCore.Mvc.ViewFeatures.IFileVersionProvider FileVersionProvider
@{
    var isAuth = User.Identity?.IsAuthenticated == true;
    var themeCookie = isAuth ? Context.Request.Cookies[AuthCookieHelper.ThemeCookieName] : null;
    var initialTheme = themeCookie == "dark" ? "dark" : "lofi";
    var isMessagingEnabled = Configuration.GetValue<bool>("Features:PrivateMessagingEnabled");
}
<!DOCTYPE html>
<html lang="en" data-theme="@initialTheme">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Snakk</title>
    <link rel="apple-touch-icon" sizes="180x180" href="/img/favicon/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/img/favicon/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/img/favicon/favicon-16x16.png" />
    <link rel="manifest" href="/img/favicon/site.webmanifest" />

    @{
        var siteBase = Configuration["WebBaseUrl"]?.TrimEnd('/')
            ?? $"{Context.Request.Scheme}://{Context.Request.Host}";
        ViewData["SiteBase"] = siteBase;
        var canonicalUrl = ViewData["CanonicalUrl"] as string
            ?? $"{siteBase}{Context.Request.Path}";
        var ogTitle = ViewData["OgTitle"] as string ?? ViewData["Title"] as string ?? "Snakk";
        var ogDescription = ViewData["OgDescription"] as string ?? ViewData["Description"] as string;
        var ogImage = ViewData["OgImage"] as string ?? $"{siteBase}/img/logo-square.webp";
        var ogType = ViewData["OgType"] as string ?? "website";
    }
    <meta property="og:site_name" content="Snakk" />
    <meta property="og:title" content="@ogTitle" />
    <meta property="og:url" content="@canonicalUrl" />
    <meta property="og:type" content="@ogType" />
    <meta property="og:image" content="@ogImage" />
    <meta property="og:image:width" content="512" />
    <meta property="og:image:height" content="512" />
    @if (!string.IsNullOrEmpty(ogDescription))
    {
        <meta property="og:description" content="@ogDescription" />
    }
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content="@ogTitle" />
    <meta name="twitter:image" content="@ogImage" />
    @if (!string.IsNullOrEmpty(ogDescription))
    {
        <meta name="twitter:description" content="@ogDescription" />
    }

    <link rel="alternate" type="application/json+oembed"
          href="@($"{siteBase}/oembed?url={Uri.EscapeDataString(canonicalUrl)}")"
          title="@ogTitle" />

    @await RenderSectionAsync("Meta", required: false)
    @if (ViewData["Description"] != null)
    {
        <meta name="description" content="@ViewData["Description"]" />
    }

    <link rel="canonical" href="@canonicalUrl" />
    @if (ViewData["RssFeedUrl"] is string rssFeedUrl)
    {
        <link rel="alternate" type="application/rss+xml" title="@(ViewData["RssFeedTitle"] ?? "RSS Feed")" href="@rssFeedUrl" />
    }
    <link rel="search" type="application/opensearchdescription+xml" title="Snakk" href="/opensearch.xml" />

    @{
        var tokens = Antiforgery.GetAndStoreTokens(Context);
    }
    <meta name="csrf-token" content="@tokens.RequestToken" />

    <link rel="preload" href="@SnakkUrlHelper.Css("tailwind", isVendor: true)" as="style" asp-append-version="true" fetchpriority="high" />
    <link rel="preload" href="@SnakkUrlHelper.Css("site")" as="style" asp-append-version="true" fetchpriority="high" />
    <link rel="preload" href="@SnakkUrlHelper.Js("htmx.min", isVendor: true)" as="script" asp-append-version="true" fetchpriority="high" />

    @{
        var darkThemeCssUrl = FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Css("dark-theme", isVendor: true));
    }
    <meta name="dark-theme-css" content="@darkThemeCssUrl" data-theme="@(themeCookie ?? "")" />

    @* INLINE REASON: Must run synchronously before first paint to prevent theme flash (FOUC).
       For authenticated users: server already rendered the correct data-theme from the cookie.
       This script only needs to handle the "auto" case (system dark preference) and inject the
       dark CSS link. For unauthenticated users: always lofi, nothing to do. *@
    <script id="theme-fouc-script" hx-preserve="true">(function(){try{var m=document.querySelector('meta[name="dark-theme-css"]');var p=m?m.getAttribute('data-theme'):'';var isDark=p==='dark'||(p==='auto'&&window.matchMedia('(prefers-color-scheme: dark)').matches);if(isDark){document.documentElement.setAttribute('data-theme','dark');var l=document.createElement('link');l.id='dark-theme-css';l.rel='stylesheet';l.href=m?m.content:'';document.head.appendChild(l);}}catch(e){}})();</script>

    @* Critical shell CSS inlined — enables correct first paint before full CSS arrives *@
    <partial name="_CriticalCss" />
    @* Full CSS loaded non-blocking: JS converts the preload hints above into stylesheet links.
       onload= attribute on <link> is blocked by CSP script-src — must use a nonced <script>. *@
    <script>document.querySelectorAll('link[rel="preload"][as="style"]').forEach(function(l){var s=document.createElement('link');s.rel='stylesheet';s.href=l.href;document.head.appendChild(s);});</script>
    <noscript>
        <link href="@SnakkUrlHelper.Css("tailwind", isVendor: true)" rel="stylesheet" asp-append-version="true" />
        <link href="@SnakkUrlHelper.Css("site")" rel="stylesheet" asp-append-version="true" />
    </noscript>
    @if (isAuth && isMessagingEnabled)
    {
        var dmWidgetCssUrl = FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Css("dm-widget"));
        @* Non-blocking: DM widget only appears on user action, so late CSS is fine. *@
        <meta name="dm-widget-css" content="@Html.Raw(dmWidgetCssUrl)" />
        <script>(function(){var m=document.querySelector('meta[name="dm-widget-css"]');if(m){var l=document.createElement('link');l.rel='stylesheet';l.href=m.content;document.head.appendChild(l);}})();</script>
        <noscript><link rel="stylesheet" href="@SnakkUrlHelper.Css("dm-widget")" asp-append-version="true" /></noscript>
    }
    @await RenderSectionAsync("Styles", required: false)

    <script id="js-htmx"         hx-preserve="true" src="@SnakkUrlHelper.Js("htmx.min", isVendor: true)" asp-append-version="true" defer></script>
    <script id="js-htmx-head"    hx-preserve="true" src="@SnakkUrlHelper.Js("htmx-head-support", isVendor: true)" asp-append-version="true" defer></script>
    @if (!string.IsNullOrEmpty(Context.Request.Cookies[".Snakk.ReloginHint"]))
    {
        <meta name="snakk-relogin-wrong-password" content="@T.Relogin.ErrorWrongPassword" />
        <meta name="snakk-relogin-generic" content="@T.Relogin.ErrorGeneric" />
        @* relogin-modal only functions when the modal DOM exists, which _ReloginModal
           renders only when this hint cookie is present — gate the script the same way.
           (Not isAuth: an expired session means the user is no longer authenticated.) *@
        <script src="@SnakkUrlHelper.Js("core/relogin-modal")" asp-append-version="true" defer></script>
    }
    <script id="js-head-bundle"  hx-preserve="true" src="@SnakkUrlHelper.Js("bundles/head-bundle")" asp-append-version="true" defer></script>

    @* INLINE REASON: Reads localStorage synchronously before first paint to apply
       layout/animation preferences without a flash. Replaces core/prefs.js external file. *@
    <script>(function(){try{var l=localStorage.getItem('snakk:discussion-list-layout');if(l==='none'){document.documentElement.classList.add('no-discussion-previews');}else if(l!=='full'){document.documentElement.classList.add('discussion-list-compact');}if(localStorage.getItem('snakk:disable-animations')==='true'){document.documentElement.classList.add('no-animations');}if(localStorage.getItem('snakk:link-preview-compact')==='true'){document.documentElement.classList.add('link-preview-compact');}var s=localStorage.getItem('snakk:sidebar-sticky');if(s==='none'){document.documentElement.classList.add('sticky-none');}else if(s!=='both'){document.documentElement.classList.add('sticky-left-only');}var cw=localStorage.getItem('snakk:content-width');if(cw){document.documentElement.style.setProperty('--content-width',cw+'rem');}}catch(e){}})();</script>

    <meta name="realtime-service-url" content="@(Configuration["RealtimeServiceUrl"] ?? "/realtime")" />
    @{
        var socialIconsUrl = FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("data/social-icons"));
        var langIconsUrl = FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("data/lang-icons"));
    }
    <meta name="social-icons-src" content="@socialIconsUrl" />
    <meta name="lang-icons-src" content="@langIconsUrl" />
</head>
@* GOTCHA: hx-target on <body> inherits to ALL descendants. Any element with hx-get
   inside the body MUST set hx-target="this" (or its own target), otherwise its response
   will replace #main-content and wipe the whole page. Required by hx-boost — boosted
   anchors look up hx-target via inheritance, so we can't disinherit at body level. *@
<body class="antialiased" data-auth="@(isAuth ? "1" : "0")" data-messaging="@(isMessagingEnabled ? "1" : "0")" hx-boost="true" hx-target="#main-content" hx-swap="outerHTML show:window:top" hx-ext="head-support">
    <div id="loading-bar" class="loading-bar"></div>

    @{
        var _tz = Context.Request.Cookies[".Snakk.Pref.Timezone"];
    }
    <meta name="snakk-timezone" content="@(_tz ?? "UTC")" />
    @if (User.Identity?.IsAuthenticated == true)
    {
        <meta name="current-user-id" content="@User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value" />
    }
    <script id="js-app-bundle"   hx-preserve src="@SnakkUrlHelper.Js("bundles/app-bundle")" asp-append-version="true" defer></script>
    @if (isAuth) {
        @* auth-bundle (auth-navbar, cache-manager) must precede save-cache below,
           which subclasses CacheManager. Defer scripts execute in document order. *@
        <script id="js-auth-bundle" hx-preserve src="@SnakkUrlHelper.Js("bundles/auth-bundle")" asp-append-version="true" defer></script>
        <script src="@SnakkUrlHelper.Js("core/upload")" asp-append-version="true" defer></script>
        <script src="@SnakkUrlHelper.Js("services/save-cache")" asp-append-version="true" defer></script>
        <script src="@SnakkUrlHelper.Js("components/save")" asp-append-version="true" defer></script>
        @if (isMessagingEnabled)
        {
            <script src="@SnakkUrlHelper.Js("components/dm-widget")" asp-append-version="true" defer></script>
        }
    }
    @* Lazy social icons: injected only when [data-platform] elements are present.
       lang-icons-src meta tag consumed by syntax-highlight (another agent wires it). *@
    <script>(function(){function hydrateSocialIcons(){var icons=window.snakkSocialIcons;if(!icons)return;document.querySelectorAll('[data-platform] .sn-social-icon-box:not([data-si])').forEach(function(box){var el=box.closest('[data-platform]');if(!el)return;var icon=icons[el.dataset.platform];if(!icon)return;box.style.background='#'+icon.hex;box.innerHTML='<svg viewBox="'+icon.viewBox+'" fill="white" style="width:13px;height:13px;display:block">'+icon.inner+'</svg>';box.dataset.si='1';});}function loadAndHydrate(){var meta=document.querySelector('meta[name="social-icons-src"]');if(!meta||!meta.content)return;if(window.snakkSocialIcons){hydrateSocialIcons();return;}var s=document.createElement('script');s.src=meta.content;s.onload=hydrateSocialIcons;document.body.appendChild(s);}function checkAndLoad(){if(document.querySelector('[data-platform]'))loadAndHydrate();}document.addEventListener('DOMContentLoaded',checkAndLoad);document.addEventListener('htmx:afterSettle',checkAndLoad);}());</script>

    @{
        var siteName = CommunityContext.IsCustomDomain && CommunityContext.CommunityName != null
            ? CommunityContext.CommunityName
            : "Snakk";
    }
    <!-- Persistent unified site header — outside the HTMX swap target -->
    <header class="sn-header">
        <div class="sn-header-left">
            <div class="sn-header-left-inner">
                <a href="/" class="sn-left-logo-link">
                    <img src="/img/logo-wide.webp" alt="@siteName" class="sn-left-logo" width="159" height="40" fetchpriority="high" />
                </a>
            </div>
        </div>
        <div class="sn-header-center">
            <button class="sn-nav-hamburger" data-mobile-nav-toggle type="button" aria-label="Menu">
                <span class="icon icon-menu" aria-hidden="true"></span>
            </button>
<div class="sn-header-center-content">
                @if (IsSectionDefined("CenterHeader"))
                {
                    @await RenderSectionAsync("CenterHeader", required: false)
                }
                else
                {
                <div class="sn-search-wrap" id="sn-search-wrap">
                    <span class="icon icon-search sn-search-icon" aria-hidden="true"></span>
                    <div class="sn-filter-pills" aria-hidden="true">
                        <div class="sn-filter-pill-wrap">
                            <button type="button" class="sn-filter-pill" id="sn-pill-type" tabindex="-1">
                                <span class="icon icon-document-text sn-filter-pill-icon" aria-hidden="true"></span>
                                <span id="sn-pill-type-label">@T.Pages.SearchTypePost</span>
                            </button>
                            <div class="sn-filter-dropdown" id="sn-dropdown-type" hidden>
                                <div class="sn-filter-option-list">
                                    <input type="radio" name="sn-search-type-d" id="sn-type-post-d" value="post" />
                                    <label for="sn-type-post-d">@T.Pages.SearchTypePost</label>
                                    <input type="radio" name="sn-search-type-d" id="sn-type-discussion-d" value="discussion" checked />
                                    <label for="sn-type-discussion-d">@T.Pages.SearchTypeDiscussion</label>
                                </div>
                            </div>
                        </div>
                        <div class="sn-filter-pill-wrap">
                            <button type="button" class="sn-filter-pill" id="sn-pill-sort" tabindex="-1">
                                <span class="icon icon-sort sn-filter-pill-icon" aria-hidden="true"></span>
                                <span id="sn-pill-sort-label">@T.Pages.SearchSortNewest</span>
                            </button>
                            <div class="sn-filter-dropdown" id="sn-dropdown-sort" hidden>
                                <div class="sn-filter-option-list">
                                    <input type="radio" name="sn-search-sort-d" id="sn-sort-newest-d" value="newest" checked />
                                    <label for="sn-sort-newest-d">@T.Pages.SearchSortNewest</label>
                                    <input type="radio" name="sn-search-sort-d" id="sn-sort-oldest-d" value="oldest" />
                                    <label for="sn-sort-oldest-d">@T.Pages.SearchSortOldest</label>
                                    <input type="radio" name="sn-search-sort-d" id="sn-sort-popular-d" value="popular" />
                                    <label for="sn-sort-popular-d">@T.Pages.SearchSortPopular</label>
                                    <input type="radio" name="sn-search-sort-d" id="sn-sort-reactions-d" value="reactions" />
                                    <label for="sn-sort-reactions-d">@T.Pages.SearchSortReactions</label>
                                </div>
                            </div>
                        </div>
                        <div class="sn-filter-pill-wrap">
                            <button type="button" class="sn-filter-pill" id="sn-pill-date" tabindex="-1">
                                <span class="icon icon-calendar sn-filter-pill-icon" aria-hidden="true"></span>
                                <span id="sn-pill-date-label">@T.Pages.SearchDateShortWeek</span>
                            </button>
                            <div class="sn-filter-dropdown" id="sn-dropdown-date" hidden>
                                <div class="sn-search-date-slider">
                                    <input type="range" class="range range-xs" id="sn-date-range-d"
                                           min="0" max="5" step="1" value="2"
                                           aria-label="@T.Pages.SearchDateLabel" />
                                    <div class="sn-search-date-ticks" aria-hidden="true">
                                        <span>@T.Pages.SearchDateShortHour</span>
                                        <span>@T.Pages.SearchDateShortToday</span>
                                        <span>@T.Pages.SearchDateShortWeek</span>
                                        <span>@T.Pages.SearchDateShortMonth</span>
                                        <span>@T.Pages.SearchDateShortYear</span>
                                        <span>@T.Pages.SearchDateShortAll</span>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                    <input type="search" class="sn-search-input" id="sn-search-input"
                           placeholder="@T.Common.SearchPlaceholder" autocomplete="off" spellcheck="false"
                           aria-label="@T.Common.SearchPlaceholder" />
                    <div class="sn-search-popup" id="sn-search-popup" hidden>
                        <div class="sn-search-popup-group" id="sn-type-group">
                            <p class="sn-search-popup-group-label">@T.Pages.SearchTypeLabel</p>
                            <div class="sn-search-pills" id="sn-type-pills">
                                <input type="radio" name="sn-search-type" id="sn-type-post" value="post" />
                                <label for="sn-type-post">@T.Pages.SearchTypePost</label>
                                <input type="radio" name="sn-search-type" id="sn-type-discussion" value="discussion" checked />
                                <label for="sn-type-discussion">@T.Pages.SearchTypeDiscussion</label>
                            </div>
                        </div>
                        <div class="sn-search-popup-group" id="sn-sort-group">
                            <p class="sn-search-popup-group-label">@T.Pages.SearchSortLabel</p>
                            <div class="sn-search-pills">
                                <input type="radio" name="sn-search-sort" id="sn-sort-newest" value="newest" checked />
                                <label for="sn-sort-newest">@T.Pages.SearchSortNewest</label>
                                <input type="radio" name="sn-search-sort" id="sn-sort-oldest" value="oldest" />
                                <label for="sn-sort-oldest">@T.Pages.SearchSortOldest</label>
                                <input type="radio" name="sn-search-sort" id="sn-sort-popular" value="popular" />
                                <label for="sn-sort-popular">@T.Pages.SearchSortPopular</label>
                                <input type="radio" name="sn-search-sort" id="sn-sort-reactions" value="reactions" />
                                <label for="sn-sort-reactions">@T.Pages.SearchSortReactions</label>
                            </div>
                        </div>
                        <div class="sn-search-popup-group" id="sn-date-group">
                            <p class="sn-search-popup-group-label">@T.Pages.SearchDateLabel</p>
                            <div class="sn-search-date-slider">
                                <input type="range" class="range range-xs" id="sn-date-range"
                                       min="0" max="5" step="1" value="2"
                                       aria-label="@T.Pages.SearchDateLabel" />
                                <div class="sn-search-date-ticks" aria-hidden="true">
                                    <span>@T.Pages.SearchDateShortHour</span>
                                    <span>@T.Pages.SearchDateShortToday</span>
                                    <span>@T.Pages.SearchDateShortWeek</span>
                                    <span>@T.Pages.SearchDateShortMonth</span>
                                    <span>@T.Pages.SearchDateShortYear</span>
                                    <span>@T.Pages.SearchDateShortAll</span>
                                </div>
                            </div>
                        </div>
                        <div class="sn-search-popup-footer" id="sn-popup-footer">
                            <span class="sn-search-popup-hint"><kbd>↵</kbd> to search</span>
                            <button type="button" class="btn btn-primary btn-xs" id="sn-search-submit">@T.Common.Search</button>
                        </div>
                    </div>
                </div>
                }
            </div>
        </div>
        <div class="sn-header-right">
            <div class="sn-header-right-inner">
                <div id="auth-nav" class="flex items-center">
                    <partial name="Shared/_AuthNav" />
                </div>
            </div>
        </div>
    </header>
    <!-- 3-column layout -->
    <div class="sn-layout">
        @await RenderSectionAsync("LeftColumn", required: false)
        <main id="main-content" class="sn-main-body">
            @RenderBody()
            @* INLINE REASON: Synchronous restore of spoiler/adult-content reveal state
               from sessionStorage before first paint on cold loads. HTMX swaps are
               handled by components/spoiler-restore.ts (app-bundle, htmx:afterSettle) —
               keep the logic in sync with that file. *@
            <script>(function(){'use strict';var kp='snakk:spoiler-revealed:';var sel='.sn-images-spoiler[data-discussion-id],.images-display.images-spoiler[data-discussion-id]';document.querySelectorAll(sel).forEach(function(el){var id=el.dataset.discussionId;if(id&&sessionStorage.getItem(kp+id)==='1')el.classList.add('revealed');});var akp='snakk:adult-revealed:';document.querySelectorAll('.sn-link-card-thumb-adult-blur[data-discussion-id]').forEach(function(el){var id=el.dataset.discussionId;if(!id)return;if(sessionStorage.getItem(akp+id)==='1'){el.classList.add('revealed');var img=el.querySelector('.sn-link-card-img-adult-blur');if(img)img.classList.add('revealed');}});})();</script>
        </main>
    </div>

    <meta name="signalr-src" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("signalr.min", isVendor: true))" />
    <meta name="realtime-worker-src" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("services/realtime-worker"))" />
    @* DOMPurify is scoped to the flows that insert HTML via JS: realtime (auth users,
       here) plus the discussion-detail and profile pages (loaded there for anonymous
       visitors). SnakkUtils.sanitizeHtml FAILS CLOSED (escapes to plain text) when
       DOMPurify is absent, so a missed load degrades rendering, never safety. *@
    @if (isAuth)
    {
        <script id="js-dompurify" hx-preserve src="@SnakkUrlHelper.Js("dompurify.min", isVendor: true)" asp-append-version="true" defer></script>
        <script src="@SnakkUrlHelper.Js("services/realtime")" asp-append-version="true" defer></script>
    }

    <meta name="lazy-site-js" content="@FileVersionProvider.AddFileVersionToPath(Context.Request.PathBase, SnakkUrlHelper.Js("components/site"))" />
    <script src="@SnakkUrlHelper.Js("core/script-loader")" asp-append-version="true" defer></script>

    <partial name="Shared/_MobileTabBar" />

    <!-- External Link Warning Modal -->
    <dialog id="external-link-modal" class="modal">
        <div class="modal-box max-w-sm">
            <h3 class="text-base font-semibold mb-2">@string.Format(T.ExternalLink.Leaving, CommunityContext.CommunityName ?? "Snakk")</h3>
            <p class="text-sm text-base-content/70 mb-1">
                @T.ExternalLink.Redirecting <strong data-domain></strong>.
            </p>
            <p class="text-sm text-base-content/60 mb-4">
                @T.ExternalLink.Disclaimer
            </p>
            <label class="flex items-center gap-2 cursor-pointer mb-4 text-sm">
                <input type="checkbox" class="toggle toggle-sm toggle-primary" />
                @T.ExternalLink.DontWarn
            </label>
            <div class="flex justify-end gap-2">
                <button type="button" class="btn btn-ghost btn-sm" data-cancel>@T.Common.Cancel</button>
                <a href="#" class="btn btn-primary btn-sm" data-url target="_blank" rel="nofollow noopener noreferrer">@T.Common.ContinueAction</a>
            </div>
        </div>
    </dialog>
    <partial name="Shared/_ReloginModal" />
    <script src="@SnakkUrlHelper.Js("core/web-vitals")" asp-append-version="true" defer hx-preserve></script>

    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
