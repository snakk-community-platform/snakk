@using Snakk.Web.Helpers
@if (User.Identity?.IsAuthenticated == true)
{
<!-- Sudo step 1 — password or passkey -->
<div id="modal-sudo-auth" class="sn-modal-backdrop-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="modal-sudo-auth-title">
    <div class="sn-modal" style="max-width:28rem">
        <div class="sn-modal-header">
            <span id="modal-sudo-auth-title">@T.Settings.SudoModalTitle</span>
            <button type="button" class="sn-modal-close" id="sudo-auth-cancel-btn" aria-label="Close">✕</button>
        </div>
        <div class="sn-modal-body" style="flex-direction:column">
            <p class="sn-text-sm sn-mb-3" style="color: var(--text-tertiary)">@T.Settings.SudoModalHelp</p>
            <div id="sudo-passkey-section" class="sn-hidden">
                <button type="button" id="sudo-passkey-btn" class="sn-btn sn-btn-primary sn-w-full sn-mb-2">@T.Settings.SudoPasskeyBtn</button>
                <button type="button" id="sudo-use-password-link" class="sn-sudo-switch-method-link sn-w-full" style="color:var(--text-tertiary)">@T.Settings.SudoUsePasswordLink</button>
            </div>
            <div id="sudo-oauth-section" class="sn-hidden">
                <p class="sn-text-xs sn-mb-2" style="color: var(--text-tertiary)">@T.Settings.SudoOauthLabel</p>
                <div id="sudo-oauth-buttons" class="sn-sudo-oauth-button-list"></div>
            </div>
            <div id="sudo-password-section">
                <form id="sudo-password-form">
                    <input type="password" id="sudo-password" class="sn-input sn-w-full"
                           placeholder="@T.Settings.PrivCurrentPwdPlaceholder" autocomplete="current-password" />
                    <button type="submit" hidden disabled aria-hidden="true"></button>
                </form>
            </div>
            <p id="sudo-auth-status" class="sn-text-sm sn-mt-2 sn-hidden"></p>
        </div>
        <div class="sn-modal-footer">
            <button type="button" class="sn-modal-cancel" id="sudo-auth-cancel-btn-footer">@T.Settings.Priv2faCancelBtn</button>
            <button type="button" class="sn-modal-insert" id="sudo-auth-confirm-btn">@T.Common.ContinueAction</button>
        </div>
    </div>
</div>

<!-- Sudo step 2 — TOTP (shown only when 2FA is enabled) -->
<div id="modal-sudo-totp" class="sn-modal-backdrop-overlay" style="display:none" role="dialog" aria-modal="true" aria-labelledby="modal-sudo-totp-title">
    <div class="sn-modal" style="max-width:28rem">
        <div class="sn-modal-header">
            <span id="modal-sudo-totp-title">@T.Settings.SudoTotpModalTitle</span>
            <button type="button" class="sn-modal-close" id="sudo-totp-cancel-btn" aria-label="Close">✕</button>
        </div>
        <div class="sn-modal-body" style="flex-direction:column">
            <p class="sn-text-sm sn-mb-4" style="color: var(--text-tertiary)">@T.Settings.SudoTotpHelp</p>
            <div id="sudo-totp-inputs" class="sn-totp-digit-row">
                <input type="text" inputmode="numeric" maxlength="1" autocomplete="one-time-code"
                       class="sudo-totp-digit sn-input sn-text-center sn-font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                       class="sudo-totp-digit sn-input sn-text-center sn-font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                       class="sudo-totp-digit sn-input sn-text-center sn-font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                       class="sudo-totp-digit sn-input sn-text-center sn-font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                       class="sudo-totp-digit sn-input sn-text-center sn-font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
                <input type="text" inputmode="numeric" maxlength="1" autocomplete="off"
                       class="sudo-totp-digit sn-input sn-text-center sn-font-mono" style="width:3rem;height:3.5rem;font-size:1.5rem" />
            </div>
            <p id="sudo-totp-status" class="sn-text-sm sn-mt-3 sn-hidden"></p>
        </div>
        <div class="sn-modal-footer">
            <button type="button" class="sn-modal-cancel" id="sudo-totp-cancel-btn-footer">@T.Settings.Priv2faCancelBtn</button>
            <button type="button" class="sn-modal-insert" id="sudo-totp-confirm-btn">@T.Common.ContinueAction</button>
        </div>
    </div>
</div>
}
