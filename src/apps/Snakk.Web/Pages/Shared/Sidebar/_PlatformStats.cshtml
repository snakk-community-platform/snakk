@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.ViewModels.SidebarPlatformStatsVM

<div data-cache-source="@Model.CacheSource">
    <div class="grid grid-cols-2 gap-3">
        <div>
            <div class="text-lg font-semibold">@FormatCount(Model.DiscussionCount)</div>
            <div class="text-xs text-base-content/50">Discussions</div>
        </div>
        <div>
            <div class="text-lg font-semibold">@FormatCount(Model.ReplyCount)</div>
            <div class="text-xs text-base-content/50">Replies</div>
        </div>
    </div>
</div>
