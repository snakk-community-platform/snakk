@model Snakk.Web.Pages.ViewModels.SidebarSiteRulesVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
{
    <p class="text-sm text-base-content/50">No site rules defined yet.</p>
}
else
{
    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
    {
        <details class="group">
            <summary class="flex items-center justify-between cursor-pointer py-2 text-sm font-medium">
                <span>@(index + 1). @rule.Title</span>
                <span class="icon icon-chevron-down w-4 h-4 flex-shrink-0 transition-transform group-open:rotate-180" aria-hidden="true"></span>
            </summary>
            <p class="text-sm text-base-content/70 pl-4 pb-2">@rule.Description</p>
        </details>
    }
}
</div>
