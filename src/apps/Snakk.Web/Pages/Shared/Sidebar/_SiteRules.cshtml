@model Snakk.Web.Pages.ViewModels.SidebarSiteRulesVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
{
    <p class="sn-text-sm sn-text-muted">@T.Sidebar.EmptySiteRules</p>
}
else
{
    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
    {
        <details>
            <summary class="sn-collapse-summary---siterules sn-cursor-pointer">
                <span>@(index + 1). @rule.Title</span>
                <span class="sn-icon icon-chevron-down" aria-hidden="true"></span>
            </summary>
            <p class="sn-rule-description---siterules">@rule.Description</p>
        </details>
    }
}
</div>
