@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.ViewModels.SidebarLatestSpacesVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Spaces?.Items == null || Model.Spaces.Items.Count == 0)
{
    <p class="sidebar-empty">@T.Sidebar.EmptyLatestSpaces</p>
}
else
{
    <ul class="sidebar-list">
        @foreach (var space in Model.Spaces.Items)
        {
            var spaceUrl = SnakkUrlHelper.Space(space.CommunitySlug, Model.Community, space.Hub.Slug, space.Slug);
            var lastPostAt = DateTimeOffset.TryParse(space.LastPostAt, out var dt) ? dt : DateTimeOffset.MinValue;

            <li>
                <a href="@spaceUrl" class="sidebar-link">
                    <img src="@SnakkUrlHelper.SpaceAvatar(space.PublicId)"
                         alt=""
                         width="32" height="32"
                         class="sidebar-avatar" />
                    <span class="sidebar-link-content">
                        <span class="sidebar-link-title">@space.Name</span>
                        <span class="sidebar-link-meta">
                            @if (lastPostAt != DateTimeOffset.MinValue)
                            {
                                <time class="sn-sidebar-badge" datetime="@lastPostAt.ToString("o")" data-relative="true">@lastPostAt.ToString("MMM d")</time>
                            }
                            <span>@space.Hub.Name</span>
                        </span>
                    </span>
                </a>
            </li>
        }
    </ul>
}
</div>
