@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.ViewModels.SidebarTrendingSpacesVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Spaces?.Items == null || Model.Spaces.Items.Count == 0)
{
    <p class="fp-right-empty">No active spaces yet</p>
}
else
{
    <div class="fp-spaces-inline">
        @foreach (var space in Model.Spaces.Items)
        {
            var spaceUrl = SnakkUrlHelper.Space(space.CommunitySlug, Model.Community, space.Hub.Slug, space.Slug);
            <a href="@spaceUrl" class="fp-card-tag" hx-target="#main-content"
               data-popup-type="space" data-popup-id="@space.PublicId" data-popup-name="@space.Name">@space.Name</a>
        }
    </div>
}
</div>
