@model Snakk.Web.Pages.ViewModels.SidebarCommunityRulesVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
{
    <p class="sn-text-sm sn-text-muted">@T.Sidebar.EmptyCommunityRules</p>
}
else
{
    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
    {
        <details>
            <summary class="sn-collapse-summary---communityrules">
                <span>@(index + 1). @rule.Title</span>
                <span class="icon icon-chevron-down sn-w-4 sn-h-4 flex-shrink-0" aria-hidden="true"></span>
            </summary>
            <p class="sn-rule-description---communityrules">@rule.Description</p>
        </details>
    }
}

<div class="sn-community-rules-footer">
    <a href="/rules"
       class="sn-sidebar-nav-link---communityrules">
        <span>@T.Sidebar.SiteRulesLink</span>
        <span class="icon icon-chevron-right sn-w-4 sn-h-4" aria-hidden="true"></span>
    </a>
</div>
</div>
