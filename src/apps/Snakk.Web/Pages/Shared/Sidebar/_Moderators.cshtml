@using Snakk.Web.Helpers
@model Snakk.Web.Pages.ViewModels.SidebarModeratorsVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Moderators == null || Model.Moderators.TotalCount == 0)
{
    <p class="text-sm text-base-content/50">@T.Sidebar.EmptyModerators</p>
}
else
{
    <div class="grid grid-cols-8 gap-1">
        @foreach (var group in Model.Moderators.Groups)
        {
            @foreach (var mod in group.Moderators)
            {
                <a href="@SnakkUrlHelper.UserProfile(mod.Slug)"
                   hx-target="#main-content" hx-swap="outerHTML show:window:top"
                   data-popup-type="user" data-popup-id="@mod.UserPublicId" data-popup-name="@mod.DisplayName">
                    <img src="@SnakkUrlHelper.UserAvatar(mod.UserPublicId)"
                         alt="@mod.DisplayName"
                         class="rounded-full w-full aspect-square object-cover shadow-layered"
                         loading="lazy" decoding="async" />
                </a>
            }
        }
    </div>
}
</div>
