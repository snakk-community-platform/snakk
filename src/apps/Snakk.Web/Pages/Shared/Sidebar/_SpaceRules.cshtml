@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.ViewModels.SidebarSpaceRulesVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
{
    <p class="sn-text-sm sn-text-muted">@T.Sidebar.EmptySpaceRules</p>
}
else
{
    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
    {
        <details>
            <summary class="sn-collapse-summary---spacerules">
                <span>@(index + 1). @rule.Title</span>
                <span class="sn-icon icon-chevron-down" aria-hidden="true"></span>
            </summary>
            <p class="sn-text-sm sn-text-muted sn-pl-4 sn-pb-2">@rule.Description</p>
        </details>
    }
}

<div class="sn-rules-footer-nav">
    @if (Model.ParentHubHasRules && !string.IsNullOrEmpty(Model.HubSlug))
    {
        <a href="@SnakkUrlHelper.Hub(Model.CommunitySlug, Model.Community, Model.HubSlug)/rules"
           class="sn-sidebar-nav-link---spacerules">
            <span>@T.Sidebar.HubRulesLink</span>
            <span class="sn-icon icon-chevron-right" aria-hidden="true"></span>
        </a>
    }
    @if (Model.ParentCommunityHasRules && !string.IsNullOrEmpty(Model.CommunitySlug) && Model.Community.IsMultiCommunityEnabled)
    {
        <a href="/c/@Model.CommunitySlug/rules"
           class="sn-sidebar-nav-link---spacerules">
            <span>@T.Sidebar.CommunityRulesLink</span>
            <span class="sn-icon icon-chevron-right" aria-hidden="true"></span>
        </a>
    }
    <a href="/rules"
       class="sn-sidebar-nav-link---spacerules">
        <span>@T.Sidebar.SiteRulesLink</span>
        <span class="sn-icon icon-chevron-right" aria-hidden="true"></span>
    </a>
</div>
</div>
