@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.ViewModels.SidebarLatestContributorsVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Contributors?.Items == null || Model.Contributors.Items.Count == 0)
{
    <p class="sidebar-empty">@T.Sidebar.EmptyContributors</p>
}
else
{
    <div class="sn-grid sn-grid-cols-8 sn-gap-1">
        @foreach (var contributor in Model.Contributors.Items)
        {
            <a href="@SnakkUrlHelper.UserProfile(contributor.Slug)" title="@contributor.DisplayName"
               hx-target="#main-content" hx-swap="outerHTML show:window:top">
                <img src="@contributor.AvatarThumbnailUrl"
                     alt="@contributor.DisplayName"
                     class="sn-rounded-full sn-w-full aspect-square sn-object-cover"
                     loading="lazy" decoding="async" />
            </a>
        }
    </div>
}
</div>
