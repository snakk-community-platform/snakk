@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.ViewModels.SidebarTrendingContributorsVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Contributors?.Items == null || Model.Contributors.Items.Count == 0)
{
    <p class="sidebar-empty">No contributors today yet</p>
}
else
{
    <ul class="sidebar-list">
        @foreach (var contributor in Model.Contributors.Items)
        {
            <li>
                <a href="@SnakkUrlHelper.UserProfile(contributor.PublicId)" class="sidebar-link">
                    <img src="@contributor.AvatarThumbnailUrl"
                         alt="@contributor.DisplayName"
                         width="32" height="32"
                         class="sidebar-avatar"
                         loading="lazy" decoding="async" />
                    <span class="sidebar-link-content">
                        <span class="sidebar-link-title">@contributor.DisplayName</span>
                        <span class="sidebar-link-meta">
                            <span class="sidebar-badge">@contributor.PostCountToday posts today</span>
                        </span>
                    </span>
                </a>
            </li>
        }
    </ul>
}
</div>
