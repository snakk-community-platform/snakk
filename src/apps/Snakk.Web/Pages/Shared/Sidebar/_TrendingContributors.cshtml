@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.ViewModels.SidebarTrendingContributorsVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Contributors?.Items == null || Model.Contributors.Items.Count == 0)
{
    <p class="fp-right-empty">No active contributors yet</p>
}
else
{
    <div class="fp-trending-list">
        @foreach (var c in Model.Contributors.Items)
        {
            <a href="@SnakkUrlHelper.UserProfile(c.PublicId)" class="fp-trending-contributor" hx-target="#main-content"
               data-popup-type="user" data-popup-id="@c.PublicId" data-popup-name="@c.DisplayName">
                <img src="@c.AvatarThumbnailUrl" alt="" class="fp-avatar-square" width="28" height="28" loading="lazy" decoding="async" />
                <span class="fp-trending-contributor-name">@c.DisplayName</span>
                <span class="fp-card-tag fp-card-tag-light fp-tag-sm">@c.PostCountToday</span>
            </a>
        }
    </div>
}
</div>
