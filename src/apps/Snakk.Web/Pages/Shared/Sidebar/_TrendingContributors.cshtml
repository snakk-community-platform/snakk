@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.ViewModels.SidebarTrendingContributorsVM

<div data-cache-source="@Model.CacheSource">
@if (Model.Contributors?.Items == null || Model.Contributors.Items.Count == 0)
{
    <p class="sn-right-empty">@T.Sidebar.EmptyTrendingContributors</p>
}
else
{
    <div class="sn-grid sn-grid-cols-8 sn-gap-1">
        @foreach (var c in Model.Contributors.Items)
        {
            <a href="@SnakkUrlHelper.UserProfile(c.Slug)"
               hx-target="#main-content" hx-swap="outerHTML show:window:top"
               data-popup-type="user" data-popup-id="@c.PublicId" data-popup-name="@c.DisplayName">
                <img src="@c.AvatarThumbnailUrl" alt="@c.DisplayName"
                     class="sn-rounded-full sn-w-full aspect-square sn-object-cover sn-shadow-layered"
                     width="32" height="32"
                     loading="lazy" decoding="async" />
            </a>
        }
    </div>
}
</div>
