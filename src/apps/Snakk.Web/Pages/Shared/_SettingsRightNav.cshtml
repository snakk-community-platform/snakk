@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool isActive(string page) => currentPage.EndsWith(page, StringComparison.OrdinalIgnoreCase);
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<div class="fp-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="fp-right-body">
    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" />
                <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
            </svg>
            Settings
        </div>
        <nav class="fp-scrollspy">
            <a href="/settings/account" class="fp-scrollspy-item fp-scrollspy-page @(isActive("Account") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
                Public Profile
            </a>
            @if (isActive("Account"))
            {
                <a href="#section-avatar" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Avatar</a>
                <a href="#section-display-name" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Display Name</a>
                <a href="#section-bio" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Bio</a>
            }

            <a href="/settings/display" class="fp-scrollspy-item fp-scrollspy-page @(isActive("Display") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9.75 17L9 20l-1 1h8l-1-1-.75-3M3 13h18M5 17h14a2 2 0 002-2V5a2 2 0 00-2-2H5a2 2 0 00-2 2v10a2 2 0 002 2z" />
                </svg>
                Display
            </a>
            @if (isActive("Display"))
            {
                <a href="#section-timezone" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Timezone</a>
            }

            <a href="/settings/browser" class="fp-scrollspy-item fp-scrollspy-page @(isActive("Browser") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M3.055 11H5a2 2 0 012 2v1a2 2 0 002 2 2 2 0 012 2v2.945M8 3.935V5.5A2.5 2.5 0 0010.5 8h.5a2 2 0 012 2 2 2 0 104 0 2 2 0 012-2h1.064M15 20.488V18a2 2 0 012-2h3.064M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                This Browser
            </a>
            @if (isActive("Browser"))
            {
                <a href="#section-behavior" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Behavior</a>
                <a href="#section-skin-tone" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Emoji Skin Tone</a>
                <a href="#section-embeds" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>External Embeds</a>
            }

            <a href="/settings/privacy" class="fp-scrollspy-item fp-scrollspy-page @(isActive("Privacy") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M12 15v2m-6 4h12a2 2 0 002-2v-6a2 2 0 00-2-2H6a2 2 0 00-2 2v6a2 2 0 002 2zm10-10V7a4 4 0 00-8 0v4h8z" />
                </svg>
                Privacy & Security
            </a>
            @if (isActive("Privacy"))
            {
                <a href="#section-devices" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Trusted Devices</a>
                <a href="#section-email" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Email</a>
                <a href="#section-password" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Password</a>
            }

            <a href="/settings/integrations" class="fp-scrollspy-item fp-scrollspy-page @(isActive("Integrations") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13.828 10.172a4 4 0 00-5.656 0l-4 4a4 4 0 105.656 5.656l1.102-1.101m-.758-4.899a4 4 0 005.656 0l4-4a4 4 0 00-5.656-5.656l-1.1 1.1" />
                </svg>
                Integrations
            </a>
            @if (isActive("Integrations"))
            {
                <a href="#section-rss" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>RSS Feeds</a>
            }

            <a href="/settings/notifications" class="fp-scrollspy-item fp-scrollspy-page @(isActive("Notifications") ? "active" : "")">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                </svg>
                Notifications
            </a>
            @if (isActive("Notifications"))
            {
                <a href="#section-auto-follow" class="fp-scrollspy-item fp-scrollspy-sub" data-scrollspy-link>Auto-follow</a>
            }
        </nav>
    </div>
    </div>
</div>
