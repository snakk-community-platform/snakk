@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool isActive(string page) => currentPage.EndsWith(page, StringComparison.OrdinalIgnoreCase);
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="sn-right-body">
    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-cog" aria-hidden="true"></span>
            @T.Settings.NavGroup
        </div>
        <nav class="sn-scrollspy">
            <a href="/settings/account" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Account") ? "active" : "")">
                <span class="icon icon-user" aria-hidden="true"></span>
                @T.Settings.NavPublicProfile
            </a>
            @if (isActive("Account"))
            {
                <a href="#section-avatar" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavAvatar</a>
                <a href="#section-display-name" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavDisplayName</a>
                <a href="#section-bio" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavBio</a>
            }

            <a href="/settings/display" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Display") ? "active" : "")">
                <span class="icon icon-display-monitor" aria-hidden="true"></span>
                @T.Settings.NavDisplay
            </a>
            @if (isActive("Display"))
            {
                <a href="#section-timezone" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavTimezone</a>
            }

            <a href="/settings/browser" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Browser") ? "active" : "")">
                <span class="icon icon-globe" aria-hidden="true"></span>
                @T.Settings.NavThisBrowser
            </a>
            @if (isActive("Browser"))
            {
                <a href="#section-behavior" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavBehavior</a>
                <a href="#section-skin-tone" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavEmojiSkinTone</a>
                <a href="#section-embeds" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavExternalEmbeds</a>
            }

            <a href="/settings/privacy" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Privacy") ? "active" : "")">
                <span class="icon icon-lock-closed" aria-hidden="true"></span>
                @T.Settings.NavPrivacy
            </a>
            @if (isActive("Privacy"))
            {
                <a href="#section-devices" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavTrustedDevices</a>
                <a href="#section-email" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavEmail</a>
                <a href="#section-password" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavPassword</a>
            }

            <a href="/settings/integrations" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Integrations") ? "active" : "")">
                <span class="icon icon-link-chain" aria-hidden="true"></span>
                @T.Settings.NavIntegrations
            </a>
            @if (isActive("Integrations"))
            {
                <a href="#section-rss" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavRssFeeds</a>
            }

            <a href="/settings/notifications" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Notifications") ? "active" : "")">
                <span class="icon icon-bell" aria-hidden="true"></span>
                @T.Settings.NavNotifications
            </a>
            @if (isActive("Notifications"))
            {
                <a href="#section-auto-follow" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavAutoFollow</a>
                <a href="#section-adult-content" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavAdultContent</a>
            }
        </nav>
    </div>
    </div>
</div>
