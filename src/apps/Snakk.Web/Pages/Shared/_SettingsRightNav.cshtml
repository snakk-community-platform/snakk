@inject Microsoft.Extensions.Configuration.IConfiguration NavConfiguration
@inject Microsoft.Extensions.Options.IOptions<Snakk.Web.Services.OAuthProvidersOptions> NavOAuthOptions
@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool isActive(string page) => currentPage.EndsWith(page, StringComparison.OrdinalIgnoreCase);
    ViewData["RightPane.NewDiscussionUrl"] = "/create";
    var passkeysEnabled = NavConfiguration.GetValue<bool>("Features:PasskeysEnabled", true);
    var twoFactorEnabled = NavConfiguration.GetValue<bool>("Features:TwoFactorEnabled", true);
    var oauthEnabled = NavOAuthOptions.Value.HasAny;
}
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="sn-right-body">
    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="sn-icon icon-cog" aria-hidden="true"></span>
            @T.Settings.NavGroup
        </div>
        <nav class="sn-scrollspy">
            <a href="/my/settings/account" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Account") ? "sn-active" : "")">
                <span class="sn-icon icon-user" aria-hidden="true"></span>
                @T.Settings.NavPublicProfile
            </a>
            @if (isActive("Account"))
            {
                <a href="#section-avatar" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavAvatar</a>
                <a href="#section-display-name" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavDisplayName</a>
                <a href="#section-bio" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavBio</a>
                <a href="#section-social" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.TitleSocial</a>
            }

            <a href="/my/settings/display" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Display") ? "sn-active" : "")">
                <span class="sn-icon icon-display-monitor" aria-hidden="true"></span>
                @T.Settings.NavDisplay
            </a>
            @if (isActive("Display"))
            {
                <a href="#section-timezone" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavTimezone</a>
            }

            <a href="/my/settings/browser" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Browser") ? "sn-active" : "")">
                <span class="sn-icon icon-globe" aria-hidden="true"></span>
                @T.Settings.NavThisBrowser
            </a>
            @if (isActive("Browser"))
            {
                <a href="#section-behavior" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavBehavior</a>
                <a href="#section-skin-tone" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavEmojiSkinTone</a>
                <a href="#section-embeds" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavExternalEmbeds</a>
            }

            <a href="/my/settings/privacy" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Privacy") ? "sn-active" : "")">
                <span class="sn-icon icon-lock-closed" aria-hidden="true"></span>
                @T.Settings.NavPrivacy
            </a>
            @if (isActive("Privacy"))
            {
                <a href="#section-password" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavPassword</a>
                @if (twoFactorEnabled)
                {
                <a href="#two-factor-section" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavTwoFactor</a>
                <a href="#section-devices" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavTrustedDevices</a>
                }
                @if (passkeysEnabled)
                {
                <a href="#section-passkeys" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavPasskeys</a>
                }
                @if (oauthEnabled)
                {
                <a href="#section-connected-accounts" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.ConnAccNav</a>
                }
                <a href="#section-sessions" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavActiveSessions</a>
                <a href="#section-security-log" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavSecurityLog</a>
                <a href="#section-data-export" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.DataExportTitle</a>
                <a href="#section-danger-zone" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link style="color:var(--color-error)">@T.Settings.DangerZoneTitle</a>
            }

            <a href="/my/settings/integrations" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Integrations") ? "sn-active" : "")">
                <span class="sn-icon icon-link-chain" aria-hidden="true"></span>
                @T.Settings.NavIntegrations
            </a>
            @if (isActive("Integrations"))
            {
                <a href="#section-rss" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavRssFeeds</a>
                <a href="#section-discord" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavDiscord</a>
            }

            <a href="/my/settings/notifications" class="sn-scrollspy-item sn-scrollspy-page @(isActive("Notifications") ? "sn-active" : "")">
                <span class="sn-icon icon-bell" aria-hidden="true"></span>
                @T.Settings.NavNotifications
            </a>
            @if (isActive("Notifications"))
            {
                <a href="#section-auto-follow" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavAutoFollow</a>
                <a href="#section-adult-content" class="sn-scrollspy-item sn-scrollspy-sub" data-scrollspy-link>@T.Settings.NavAdultContent</a>
            }
        </nav>
    </div>
    </div>
</div>
