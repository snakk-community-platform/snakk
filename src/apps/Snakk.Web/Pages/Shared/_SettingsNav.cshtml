@{
    var currentPage = ViewContext.RouteData.Values["page"]?.ToString() ?? "";
    bool isActive(string page) => currentPage.EndsWith(page, StringComparison.OrdinalIgnoreCase);
}

<div class="sn-left-inner">
    <div class="sn-settings-header">
        <h2 class="sn-settings-title">Settings</h2>
        <span class="sn-settings-subtitle">User configuration</span>
    </div>

    <nav class="sn-nav">
        <a href="/settings/account" class="sn-nav-item @(isActive("Account") ? "active" : "")">
            <span class="icon icon-user" aria-hidden="true"></span>
            Public Profile
        </a>
        <a href="/settings/display" class="sn-nav-item @(isActive("Display") ? "active" : "")">
            <span class="icon icon-display-monitor" aria-hidden="true"></span>
            Display
        </a>
        <a href="/settings/browser" class="sn-nav-item @(isActive("Browser") ? "active" : "")">
            <span class="icon icon-globe" aria-hidden="true"></span>
            This Browser
        </a>
        <a href="/settings/privacy" class="sn-nav-item @(isActive("Privacy") ? "active" : "")">
            <span class="icon icon-lock-closed" aria-hidden="true"></span>
            Privacy & Security
        </a>
        <a href="/settings/integrations" class="sn-nav-item @(isActive("Integrations") ? "active" : "")">
            <span class="icon icon-link-chain" aria-hidden="true"></span>
            Integrations
        </a>
        <a href="/settings/notifications" class="sn-nav-item @(isActive("Notifications") ? "active" : "")">
            <span class="icon icon-bell" aria-hidden="true"></span>
            Notifications
        </a>
        <a href="/settings/social" class="sn-nav-item @(isActive("Social") ? "active" : "")">
            <span class="icon icon-share" aria-hidden="true"></span>
            Social Links
        </a>
    </nav>
</div>
