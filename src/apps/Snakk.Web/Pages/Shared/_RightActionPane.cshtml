@using Microsoft.Extensions.Options
@using Snakk.Web.Services
@using System.Security.Claims
@inject IOptions<OAuthProvidersOptions> OAuthOptions
@{
    var newDiscussionUrl = ViewData["RightPane.NewDiscussionUrl"] as string ?? "/new";
    var actions = (ViewData["RightPane.Actions"] as string[]) ?? Array.Empty<string>();
    var manageUrl = ViewData["RightPane.ManageUrl"] as string;
    var subscribeAction = ViewData["RightPane.SubscribeAction"] as string ?? "subscribe";
    var subscribeEntityAttr = ViewData["RightPane.SubscribeEntityAttr"] as string ?? "";
    var subscribeEntityId = ViewData["RightPane.SubscribeEntityId"] as string ?? "";
    var saveDiscussionId = ViewData["RightPane.SaveDiscussionId"] as string ?? "";
    var feedUrl = ViewData["RightPane.FeedUrl"] as string ?? "";
    var subscribeAttrHtml = !string.IsNullOrEmpty(subscribeEntityAttr) && !string.IsNullOrEmpty(subscribeEntityId)
        ? $" data-{subscribeEntityAttr}=\"{Html.Encode(subscribeEntityId)}\""
        : "";
    var shareUrl = ViewData["RightPane.ShareUrl"] as string
        ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var shareTitleEsc = Uri.EscapeDataString(ViewData["RightPane.ShareTitle"] as string ?? "");
    var shareUrlEsc   = Uri.EscapeDataString(shareUrl);
    var shareIsPublic = ViewData["RightPane.ShareIsPublic"] is bool sp ? sp : true;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var canManage = isAuth && !string.IsNullOrEmpty(User.FindFirst(ClaimTypes.Role)?.Value);
    var hasActions = actions.Length > 0;

    var oauth       = OAuthOptions.Value;
    var returnUrl   = Uri.EscapeDataString(ViewContext.HttpContext.Request.Path.Value ?? "/");
    var loginUrl    = $"/auth/login?returnUrl={returnUrl}";
    var registerUrl = $"/auth/register?returnUrl={returnUrl}";
    var googleUrl   = $"/auth/oauth/Google/challenge?returnUrl={returnUrl}";
    var githubUrl   = $"/auth/oauth/GitHub/challenge?returnUrl={returnUrl}";
    var discordUrl  = $"/auth/oauth/Discord/challenge?returnUrl={returnUrl}";
}
<div class="fp-right-action-pane">
    <div class="fp-right-action-box">
    <a href="@newDiscussionUrl" class="btn btn-primary btn-sm w-full justify-center">
        <span class="icon @(!isAuth ? "icon-lock-closed" : "icon-new-discussion") w-3.5 h-3.5" aria-hidden="true"></span>
        New Discussion
    </a>
    @if (hasActions)
    {
        <div class="fp-right-action-row">
            @if (actions.Contains("feed") && !string.IsNullOrEmpty(feedUrl))
            {
                <partial name="Shared/_FeedDropdown" model="@feedUrl" />
            }
            @if (actions.Contains("share"))
            {
                <div class="dropdown dropdown-end">
                    <button tabindex="0" class="btn btn-outline btn-sm" aria-label="Share">
                        <span class="icon icon-share w-3.5 h-3.5" aria-hidden="true"></span>
                        <span>Share</span>
                    </button>
                    <ul tabindex="0"
                        class="dropdown-content menu p-1 shadow-lg bg-base-100 border border-subtle rounded-lg w-56 z-200"
                        hx-get="/partials/share-menu?url=@shareUrlEsc&title=@shareTitleEsc&isPublic=@(shareIsPublic ? "true" : "false")"
                        hx-trigger="load"
                        hx-target="this"
                        hx-swap="innerHTML"
                        hx-push-url="false">
                    </ul>
                </div>
            }
            @if (actions.Contains("subscribe"))
            {
                @if (isAuth)
                {
                    <button type="button" class="btn btn-outline btn-sm rp-subscribe-btn" data-action="@subscribeAction" @Html.Raw(subscribeAttrHtml)>
                        <span class="icon icon-bell w-3.5 h-3.5" aria-hidden="true"></span>
                        <span>Subscribe</span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-outline btn-sm" data-modal-open="guest-nudge-modal">
                        <span class="icon icon-lock-closed w-3.5 h-3.5" aria-hidden="true"></span>
                        <span>Subscribe</span>
                    </button>
                }
            }
            @if (actions.Contains("save"))
            {
                @if (isAuth)
                {
                    <button type="button" class="btn btn-outline btn-sm" data-action="toggle-save-discussion" data-discussion-id="@saveDiscussionId" data-saved="false">
                        <span class="icon icon-bookmark w-3.5 h-3.5" aria-hidden="true"></span>
                        <span>Save</span>
                    </button>
                }
                else
                {
                    <button type="button" class="btn btn-outline btn-sm" data-modal-open="guest-nudge-modal">
                        <span class="icon icon-lock-closed w-3.5 h-3.5" aria-hidden="true"></span>
                        <span>Save</span>
                    </button>
                }
            }
            @if (actions.Contains("manage") && !string.IsNullOrEmpty(manageUrl) && canManage)
            {
                <a href="@manageUrl" class="btn btn-outline btn-sm">
                    <span class="icon icon-cog w-3.5 h-3.5" aria-hidden="true"></span>
                    <span>Manage</span>
                </a>
            }
            @if (actions.Contains("clear-history"))
            {
                <button type="button" id="history-clear-btn" class="btn btn-outline btn-sm">
                    <span class="icon icon-trash w-3.5 h-3.5" aria-hidden="true"></span>
                    <span>Clear history</span>
                </button>
            }
        </div>
    }
    </div>
</div>

@if (!isAuth)
{
<dialog id="guest-nudge-modal" class="modal modal-bottom sm:modal-middle">
    <div class="modal-box max-w-sm text-center flex flex-col items-center gap-3">
        <form method="dialog">
            <button class="btn btn-sm btn-circle btn-ghost absolute right-2 top-2">✕</button>
        </form>
        <div class="fp-nudge-icon">
            <span class="icon icon-lock-closed w-6 h-6" aria-hidden="true"></span>
        </div>
        <h3 class="fp-nudge-title">Join the conversation</h3>
        <p class="fp-nudge-body">Create a free account to save and subscribe to discussions.</p>

        @if (oauth.HasAny)
        {
            <div class="fp-nudge-oauth">
                @if (oauth.Google)
                {
                    <a href="@googleUrl" class="fp-nudge-oauth-btn" hx-boost="false">
                        <span class="icon icon-brand-google w-4 h-4" aria-hidden="true"></span>
                        Continue with Google
                    </a>
                }
                @if (oauth.GitHub)
                {
                    <a href="@githubUrl" class="fp-nudge-oauth-btn" hx-boost="false">
                        <span class="icon icon-brand-github w-4 h-4" aria-hidden="true"></span>
                        Continue with GitHub
                    </a>
                }
                @if (oauth.Discord)
                {
                    <a href="@discordUrl" class="fp-nudge-oauth-btn" hx-boost="false">
                        <span class="icon icon-brand-discord w-4 h-4" aria-hidden="true"></span>
                        Continue with Discord
                    </a>
                }
            </div>
            <div class="fp-nudge-divider"><span>or</span></div>
        }

        <a href="@registerUrl" class="btn btn-primary btn-sm w-full" hx-boost="false">Sign up with email</a>
        <p class="fp-nudge-login-link">
            Already have an account? <a href="@loginUrl" hx-boost="false">Log in</a>
        </p>
    </div>
    <form method="dialog" class="modal-backdrop"><button>close</button></form>
</dialog>
}
