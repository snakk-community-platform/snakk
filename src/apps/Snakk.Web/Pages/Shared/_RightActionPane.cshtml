@using Microsoft.Extensions.Options
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@using System.Security.Claims
@inject IOptions<OAuthProvidersOptions> OAuthOptions
@{
    var newDiscussionUrl = ViewData["RightPane.NewDiscussionUrl"] as string ?? "/create";
    var actions = (ViewData["RightPane.Actions"] as string[]) ?? Array.Empty<string>();
    var manageUrl = ViewData["RightPane.ManageUrl"] as string;
    var subscribeAction = ViewData["RightPane.SubscribeAction"] as string ?? "subscribe";
    var subscribeEntityAttr = ViewData["RightPane.SubscribeEntityAttr"] as string ?? "";
    var subscribeEntityId = ViewData["RightPane.SubscribeEntityId"] as string ?? "";
    var saveDiscussionId = ViewData["RightPane.SaveDiscussionId"] as string ?? "";
    var feedUrl = ViewData["RightPane.FeedUrl"] as string ?? "";
    var subscribeAttrHtml = !string.IsNullOrEmpty(subscribeEntityAttr) && !string.IsNullOrEmpty(subscribeEntityId)
        ? $" data-{subscribeEntityAttr}=\"{Html.Encode(subscribeEntityId)}\""
        : "";
    var shareUrl = ViewData["RightPane.ShareUrl"] as string
        ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var shareTitleEsc = Uri.EscapeDataString(ViewData["RightPane.ShareTitle"] as string ?? "");
    var shareUrlEsc   = Uri.EscapeDataString(shareUrl);
    var shareIsPublic = ViewData["RightPane.ShareIsPublic"] is bool sp ? sp : true;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var canManage = isAuth && !string.IsNullOrEmpty(User.FindFirst(ClaimTypes.Role)?.Value);
    var hasActions = actions.Length > 0;
    var isNewPage = Context.Request.Path.StartsWithSegments("/create");

    var oauth       = OAuthOptions.Value;
    var returnUrl   = Uri.EscapeDataString(ViewContext.HttpContext.Request.Path.Value ?? "/");
    var providerCount = (oauth.Google ? 1 : 0) + (oauth.GitHub ? 1 : 0) + (oauth.Discord ? 1 : 0)
                      + (oauth.Facebook ? 1 : 0) + (oauth.Microsoft ? 1 : 0) + (oauth.Steam ? 1 : 0);
    var loginUrl    = $"/auth/login?returnUrl={returnUrl}";
    var registerUrl = $"/auth/register?returnUrl={returnUrl}";
    var googleUrl   = $"/auth/oauth/Google/challenge?returnUrl={returnUrl}";
    var githubUrl   = $"/auth/oauth/GitHub/challenge?returnUrl={returnUrl}";
    var discordUrl  = $"/auth/oauth/Discord/challenge?returnUrl={returnUrl}";
    var facebookUrl  = $"/auth/oauth/Facebook/challenge?returnUrl={returnUrl}";
    var microsoftUrl = $"/auth/oauth/Microsoft/challenge?returnUrl={returnUrl}";
    var steamUrl     = $"/auth/oauth/Steam/challenge?returnUrl={returnUrl}";
}
<div class="sn-right-action-pane">
    <div class="sn-right-action-box">
    @if (!isNewPage)
    {
    <a href="@newDiscussionUrl" id="rp-new-discussion" class="sn-btn sn-btn-primary sn-btn-sm sn-w-full sn-justify-center sn-shadow-layered">
        <span class="sn-icon @(!isAuth ? "icon-lock-closed" : "icon-new-discussion") sn-icon--xs" aria-hidden="true"></span>
        @T.Actions.NewDiscussion
    </a>
    }
    @if (hasActions)
    {
            @if (actions.Contains("feed") && !string.IsNullOrEmpty(feedUrl))
            {
                <partial name="Shared/_FeedDropdown" model="@feedUrl" />
            }
            @if (actions.Contains("share"))
            {
                <div class="sn-dropdown">
                    <button id="share-dropdown-btn" type="button" class="sn-btn sn-btn-outline sn-btn-sm" aria-label="@T.Actions.Share"
                            popovertarget="sn-share-panel"
                            hx-boost="false"
                            hx-get="/partials/share-menu?url=@shareUrlEsc&title=@shareTitleEsc&isPublic=@(shareIsPublic ? "true" : "false")"
                            hx-trigger="click once"
                            hx-target="#sn-share-panel"
                            hx-swap="innerHTML">
                        <span class="sn-icon icon-share sn-icon--xs" aria-hidden="true"></span>
                        <span>@T.Actions.Share</span>
                    </button>
                    <ul id="sn-share-panel" popover class="sn-dropdown-panel sn-menu w-56">
                        <li><span class="sn-text-sm opacity-40 sn-px-2">...</span></li>
                    </ul>
                </div>
            }
            @if (actions.Contains("subscribe"))
            {
                @if (isAuth)
                {
                    <button type="button" class="sn-btn sn-btn-outline sn-btn-sm rp-subscribe-btn" data-action="@subscribeAction" @Html.Raw(subscribeAttrHtml)>
                        <span class="sn-icon icon-bell sn-icon--xs" aria-hidden="true"></span>
                        <span>@T.Actions.Subscribe</span>
                    </button>
                }
                else
                {
                    <button type="button" class="sn-btn sn-btn-outline sn-btn-sm" data-modal-open="guest-nudge-modal">
                        <span class="sn-icon icon-lock-closed sn-icon--xs" aria-hidden="true"></span>
                        <span>@T.Actions.Subscribe</span>
                    </button>
                }
            }
            @if (actions.Contains("save"))
            {
                @if (isAuth)
                {
                    <button type="button" class="sn-btn sn-btn-outline sn-btn-sm" data-action="toggle-save-discussion" data-discussion-id="@saveDiscussionId" data-saved="false">
                        <span class="sn-icon icon-bookmark sn-icon--xs" aria-hidden="true"></span>
                        <span>@T.Actions.Save</span>
                    </button>
                }
                else
                {
                    <button type="button" class="sn-btn sn-btn-outline sn-btn-sm" data-modal-open="guest-nudge-modal">
                        <span class="sn-icon icon-lock-closed sn-icon--xs" aria-hidden="true"></span>
                        <span>@T.Actions.Save</span>
                    </button>
                }
            }
            @if (actions.Contains("follows") && isAuth)
            {
                <a href="/my/follows/spaces" class="sn-btn sn-btn-outline sn-btn-sm">
                    <span class="sn-icon icon-users-group sn-icon--xs" aria-hidden="true"></span>
                    <span>@T.Actions.ManageFollows</span>
                </a>
            }
            @if (actions.Contains("follow-user"))
            {
                <div id="profile-actions">
                    <div class="sn-skeleton sn-h-8 w-24"></div>
                </div>
            }
            @if (actions.Contains("manage") && !string.IsNullOrEmpty(manageUrl) && canManage)
            {
                <a href="@manageUrl" class="sn-btn sn-btn-outline sn-btn-sm">
                    <span class="sn-icon icon-cog sn-icon--xs" aria-hidden="true"></span>
                    <span>@T.Actions.Manage</span>
                </a>
            }
            @if (actions.Contains("mod-discussion") && canManage)
            {
                var modDiscussionId = ViewData["RightPane.ModDiscussionId"] as string ?? "";
                var modIsLocked = ViewData["RightPane.ModIsLocked"] is bool ml && ml;
                <div class="sn-w-full sn-border-t sn-border-subtle sn-pt-2 sn-mt-1 sn-flex sn-gap-2 sn-flex-wrap">
                    <button type="button"
                            data-action="mod-lock-discussion"
                            data-discussion-id="@modDiscussionId"
                            data-is-locked="@modIsLocked.ToString().ToLower()"
                            class="sn-btn sn-btn-outline sn-btn-sm">
                        <span class="sn-icon icon-lock-closed sn-icon--xs" aria-hidden="true"></span>
                        <span>@(modIsLocked ? "Unlock" : "Lock")</span>
                    </button>
                    <button type="button"
                            data-action="mod-delete-discussion"
                            data-discussion-id="@modDiscussionId"
                            class="sn-btn sn-btn-outline sn-btn-sm sn-text-error">
                        <span class="sn-icon icon-trash sn-icon--xs" aria-hidden="true"></span>
                        <span>Remove</span>
                    </button>
                </div>
            }
            @if (actions.Contains("clear-history"))
            {
                <button type="button" id="history-clear-btn" class="sn-btn sn-btn-outline sn-btn-sm">
                    <span class="sn-icon icon-trash sn-icon--xs" aria-hidden="true"></span>
                    <span>@T.Actions.ClearHistory</span>
                </button>
            }
            @if (actions.Contains("mark-all-read"))
            {
                <button type="button" id="unread-mark-read-btn"
                        hx-post="/bff/me/mark-all-read"
                        hx-swap="none"
                        class="sn-btn sn-btn-outline sn-btn-sm">
                    <span class="sn-icon icon-check sn-icon--xs" aria-hidden="true"></span>
                    <span>@T.Pages.UnreadMarkAllRead</span>
                </button>
            }
    }
    </div>
</div>

@if (!isNewPage)
{
@* FAB shown when New Discussion button scrolls out of view (only in non-default sticky modes) *@
<div id="new-discussion-fab" class="fab fab-flower sn-fab-collapsed">
    <a href="@newDiscussionUrl" class="sn-btn sn-btn-circle sn-btn-lg sn-btn-primary" aria-label="@T.Actions.NewDiscussion">
        <span class="sn-icon @(!isAuth ? "icon-lock-closed" : "icon-new-discussion") sn-icon--md" aria-hidden="true"></span>
    </a>
</div>
}

@if (!isAuth)
{
<dialog id="guest-nudge-modal" class="sn-modal">
    <div class="sn-nudge-modal-body">
        <form method="dialog">
            <button class="sn-btn sn-btn-sm sn-btn-circle sn-btn-ghost absolute right-2 top-2">✕</button>
        </form>
        <div class="sn-nudge-icon">
            <span class="sn-icon icon-lock-closed w-6 h-6" aria-hidden="true"></span>
        </div>
        <h3 class="sn-nudge-title">@T.Nudge.Title</h3>
        <p class="sn-nudge-body">@T.Nudge.Body</p>

        @if (oauth.HasAny)
        {
            <div class="sn-nudge-oauth @(providerCount > 2 ? "sn-nudge-oauth--grid" : "")">
                @if (oauth.Google)
                {
                    <a href="@googleUrl" class="sn-nudge-oauth-btn" hx-boost="false" data-provider="Google">
                        <span class="sn-icon icon-brand-google" aria-hidden="true"></span>
                        <span class="oauth-text-full">@T.Nudge.ContinueGoogle</span><span class="oauth-text-short">Google</span>
                    </a>
                }
                @if (oauth.GitHub)
                {
                    <a href="@githubUrl" class="sn-nudge-oauth-btn" hx-boost="false" data-provider="GitHub">
                        <span class="sn-icon icon-brand-github" aria-hidden="true"></span>
                        <span class="oauth-text-full">@T.Nudge.ContinueGitHub</span><span class="oauth-text-short">GitHub</span>
                    </a>
                }
                @if (oauth.Discord)
                {
                    <a href="@discordUrl" class="sn-nudge-oauth-btn" hx-boost="false" data-provider="Discord">
                        <span class="sn-icon icon-brand-discord" aria-hidden="true"></span>
                        <span class="oauth-text-full">@T.Nudge.ContinueDiscord</span><span class="oauth-text-short">Discord</span>
                    </a>
                }
                @if (oauth.Facebook)
                {
                    <a href="@facebookUrl" class="sn-nudge-oauth-btn" hx-boost="false" data-provider="Facebook">
                        <span class="sn-icon icon-brand-facebook" aria-hidden="true"></span>
                        <span class="oauth-text-full">@T.Nudge.ContinueFacebook</span><span class="oauth-text-short">Facebook</span>
                    </a>
                }
                @if (oauth.Microsoft)
                {
                    <a href="@microsoftUrl" class="sn-nudge-oauth-btn" hx-boost="false" data-provider="Microsoft">
                        <span class="sn-icon icon-brand-microsoft" aria-hidden="true"></span>
                        <span class="oauth-text-full">@T.Nudge.ContinueMicrosoft</span><span class="oauth-text-short">Microsoft</span>
                    </a>
                }
                @if (oauth.Steam)
                {
                    <a href="@steamUrl" class="sn-nudge-oauth-btn" hx-boost="false" data-provider="Steam">
                        <span class="sn-icon icon-brand-steam" aria-hidden="true"></span>
                        <span class="oauth-text-full">@T.Nudge.ContinueSteam</span><span class="oauth-text-short">Steam</span>
                    </a>
                }
            </div>
            <div class="sn-nudge-divider"><span>@T.Nudge.Or</span></div>
        }

        <a href="@registerUrl" class="sn-btn sn-btn-primary sn-btn-sm sn-w-full" hx-boost="false">@T.Nudge.SignUpEmail</a>
        <p class="sn-nudge-login-link">
            @T.Nudge.AlreadyAccount <a href="@loginUrl" hx-boost="false">@T.Nudge.LogIn</a>
        </p>
    </div>
    <form method="dialog" class="sn-modal-backdrop-overlay"><button>@T.Nudge.Close</button></form>
</dialog>
}
