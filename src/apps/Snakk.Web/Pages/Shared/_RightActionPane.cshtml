@{
    var newDiscussionUrl = ViewData["RightPane.NewDiscussionUrl"] as string ?? "/new";
    var actions = (ViewData["RightPane.Actions"] as string[]) ?? Array.Empty<string>();
    var manageUrl = ViewData["RightPane.ManageUrl"] as string;
    var subscribeAction = ViewData["RightPane.SubscribeAction"] as string ?? "subscribe";
    var subscribeEntityAttr = ViewData["RightPane.SubscribeEntityAttr"] as string ?? "";
    var subscribeEntityId = ViewData["RightPane.SubscribeEntityId"] as string ?? "";
    var saveDiscussionId = ViewData["RightPane.SaveDiscussionId"] as string ?? "";
    var feedUrl = ViewData["RightPane.FeedUrl"] as string ?? "";
    var subscribeAttrHtml = !string.IsNullOrEmpty(subscribeEntityAttr) && !string.IsNullOrEmpty(subscribeEntityId)
        ? $" data-{subscribeEntityAttr}=\"{Html.Encode(subscribeEntityId)}\""
        : "";
    var shareUrl = ViewData["RightPane.ShareUrl"] as string
        ?? $"{Context.Request.Scheme}://{Context.Request.Host}{Context.Request.Path}";
    var shareTitleEsc = Uri.EscapeDataString(ViewData["RightPane.ShareTitle"] as string ?? "");
    var shareUrlEsc   = Uri.EscapeDataString(shareUrl);
    var shareIsPublic = ViewData["RightPane.ShareIsPublic"] is bool sp ? sp : true;
    var isAuth = User.Identity?.IsAuthenticated == true;
    var hasActions = actions.Length > 0;
}
@if (isAuth || hasActions)
{
<div class="fp-right-action-pane">
    <div class="fp-right-action-box">
    @if (isAuth)
    {
        <a href="@newDiscussionUrl" class="btn btn-primary btn-sm w-full justify-center">
            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2.5">
                <path stroke-linecap="round" stroke-linejoin="round" d="M12 4v16m8-8H4" />
            </svg>
            New Discussion
        </a>
    }
    @if (hasActions)
    {
        <div class="fp-right-action-row">
            @if (actions.Contains("feed") && !string.IsNullOrEmpty(feedUrl))
            {
                <partial name="Shared/_FeedDropdown" model="@feedUrl" />
            }
            @if (actions.Contains("share"))
            {
                <div class="dropdown dropdown-end">
                    <button tabindex="0" class="btn btn-outline btn-sm" aria-label="Share">
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                            <path stroke-linecap="round" stroke-linejoin="round" d="M8.684 13.342C8.886 12.938 9 12.482 9 12c0-.482-.114-.938-.316-1.342m0 2.684a3 3 0 110-2.684m0 2.684l6.632 3.316m-6.632-6l6.632-3.316m0 0a3 3 0 105.367-2.684 3 3 0 00-5.367 2.684zm0 9.316a3 3 0 105.368 2.684 3 3 0 00-5.368-2.684z" />
                        </svg>
                        <span>Share</span>
                    </button>
                    <ul tabindex="0"
                        class="dropdown-content menu p-1 shadow-lg bg-base-100 border border-subtle rounded-lg w-56 z-200"
                        hx-get="/partials/share-menu?url=@shareUrlEsc&title=@shareTitleEsc&isPublic=@(shareIsPublic ? "true" : "false")"
                        hx-trigger="load"
                        hx-target="this"
                        hx-swap="innerHTML"
                        hx-push-url="false">
                    </ul>
                </div>
            }
            @if (actions.Contains("subscribe"))
            {
                <button type="button" class="btn btn-outline btn-sm rp-subscribe-btn" data-action="@subscribeAction" @Html.Raw(subscribeAttrHtml)>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                    </svg>
                    <span>Subscribe</span>
                </button>
            }
            @if (actions.Contains("save"))
            {
                <button type="button" class="btn btn-outline btn-sm" data-action="toggle-save-discussion" data-discussion-id="@saveDiscussionId" data-saved="false">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M5 5a2 2 0 012-2h10a2 2 0 012 2v16l-7-3.5L5 21V5z" />
                    </svg>
                    <span>Save</span>
                </button>
            }
            @if (actions.Contains("manage") && !string.IsNullOrEmpty(manageUrl))
            {
                <a href="@manageUrl" class="btn btn-outline btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M10.325 4.317c.426-1.756 2.924-1.756 3.35 0a1.724 1.724 0 002.573 1.066c1.543-.94 3.31.826 2.37 2.37a1.724 1.724 0 001.065 2.572c1.756.426 1.756 2.924 0 3.35a1.724 1.724 0 00-1.066 2.573c.94 1.543-.826 3.31-2.37 2.37a1.724 1.724 0 00-2.572 1.065c-.426 1.756-2.924 1.756-3.35 0a1.724 1.724 0 00-2.573-1.066c-1.543.94-3.31-.826-2.37-2.37a1.724 1.724 0 00-1.065-2.572c-1.756-.426-1.756-2.924 0-3.35a1.724 1.724 0 001.066-2.573c-.94-1.543.826-3.31 2.37-2.37.996.608 2.296.07 2.572-1.065z" /><path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 11-6 0 3 3 0 016 0z" />
                    </svg>
                    <span>Manage</span>
                </a>
            }
            @if (actions.Contains("clear-history"))
            {
                <button type="button" id="history-clear-btn" class="btn btn-outline btn-sm">
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M19 7l-.867 12.142A2 2 0 0116.138 21H7.862a2 2 0 01-1.995-1.858L5 7m5 4v6m4-6v6m1-10V4a1 1 0 00-1-1h-4a1 1 0 00-1 1v3M4 7h16" />
                    </svg>
                    <span>Clear history</span>
                </button>
            }
        </div>
    }
    </div>
</div>
}
