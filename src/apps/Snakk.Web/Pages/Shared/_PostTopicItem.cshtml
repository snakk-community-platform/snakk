@model Snakk.Web.Pages.ViewModels.PostListItemVM
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@inject ICommunityContext CommunityContext
@{
    var discussionUrl = SnakkUrlHelper.Discussion(
        Model.CommunitySlug, CommunityContext,
        Model.HubSlug, Model.SpaceSlug,
        SnakkUrlHelper.DiscussionSlugId(Model.DiscussionSlug, Model.DiscussionPublicId));
    var postUrl = $"{discussionUrl}#post-{Model.PublicId}";
    var hubLabel = !string.IsNullOrEmpty(Model.HubName) ? Model.HubName : Model.HubSlug;
    var spaceLabel = !string.IsNullOrEmpty(Model.SpaceName) ? Model.SpaceName : Model.SpaceSlug;
}
<div class="topic-item-wrapper">
    <div class="topic-item">
        <div class="topic-content">
            <div class="topic-title">
                <a href="@discussionUrl" class="topic-title-link">@Model.DiscussionTitle</a>
            </div>
            <div class="topic-meta">
                <span class="topic-meta-link">@hubLabel</span>
                <span class="icon icon-chevron-right-sm w-3 h-3" aria-hidden="true"></span>
                <span class="topic-meta-link">@spaceLabel</span>
                <span class="topic-meta-separator">&middot;</span>
                <time data-timestamp="@Model.CreatedAt.ToString("O")">@FormatRelativeTime(Model.CreatedAt)</time>
            </div>
            @if (!string.IsNullOrEmpty(Model.ContentExcerpt))
            {
                @* Auto-encoded: ContentExcerpt is plain text from PlainTextExcerpt (new
                   posts) or a truncated raw-markdown substring (legacy posts). The prior
                   @Html.Raw bypassed encoding and let a post body like `<script>...` reach
                   the DOM via this excerpt — stored XSS on every viewer's saved/reactions
                   page. *@
                <div class="mt-1 text-sm line-clamp-3 sn-post-preview" style="color: var(--text-secondary)">@Model.ContentExcerpt</div>
            }
        </div>
        <a href="@postUrl" class="topic-latest-link" title="View post">
            <span class="icon icon-chevron-down chevron-right" style="width:18px;height:18px" aria-hidden="true"></span>
        </a>
    </div>
</div>
