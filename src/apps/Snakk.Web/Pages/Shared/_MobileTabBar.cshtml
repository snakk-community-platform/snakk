@using System.Security.Claims
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityContext
@inject IConfiguration Configuration
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
    var isMessagingEnabled = Configuration.GetValue<bool>("Features:PrivateMessagingEnabled");
    var path = ViewContext.HttpContext.Request.Path.Value ?? "";

    string Active(string href, bool prefix = false)
    {
        if (prefix) return path.StartsWith(href, StringComparison.OrdinalIgnoreCase) ? " is-active" : "";
        return path == href ? " is-active" : "";
    }

    var isSingleCommunity = !CommunityContext.IsMultiCommunityEnabled;
    var communityHref = isSingleCommunity ? "/c" : "/communities";
    var communityLabel = isSingleCommunity ? T.Nav.Community : T.Nav.Communities;
}
<nav class="sn-tabbar" aria-label="Mobile navigation">
    <a href="/" class="sn-tabbar-item@(Active("/"))" aria-label="@T.Nav.Active">
        <img src="/img/logo-square-sm.webp" alt="" class="sn-tabbar-logo" width="80" height="80" />
    </a>
    <a href="@communityHref" class="sn-tabbar-item@(Active(communityHref, prefix: true))" aria-label="@communityLabel">
        <span class="icon icon-users-group" aria-hidden="true"></span>
    </a>
    <a href="/create" class="sn-tabbar-item sn-tabbar-item--primary@(Active("/create", prefix: true))" aria-label="@T.MobileNav.Post">
        <span class="sn-tabbar-item-icon">
            <span class="icon icon-plus" aria-hidden="true"></span>
        </span>
    </a>
    @if (isAuthenticated)
    {
        var publicId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
        var slug = User.FindFirst("Slug")?.Value;
        var displayName = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
        var emailVerified = User.FindFirst("EmailVerified")?.Value;
        var role = User.FindFirst(ClaimTypes.Role)?.Value;
        var isModerator = !string.IsNullOrEmpty(role);
        var isGlobalAdmin = role == "GlobalAdmin";
        var avatarFileName = User.FindFirst("AvatarFileName")?.Value;
        var avatarThumbnailFileName = User.FindFirst("AvatarThumbnailFileName")?.Value;
        var avatarMicroFileName = User.FindFirst("AvatarMicroFileName")?.Value;
        var avatarUrl = SnakkUrlHelper.UserAvatarThumbnail(publicId, avatarFileName: avatarFileName, avatarThumbnailFileName: avatarThumbnailFileName);
        var avatarMicroUrl = SnakkUrlHelper.UserAvatarMicro(publicId, avatarFileName: avatarFileName, avatarMicroFileName: avatarMicroFileName);

        @if (isMessagingEnabled)
        {
        <!-- DM (Messages) tab -->
        <a href="/messages" class="sn-tabbar-item@(Active("/messages", prefix: true))" aria-label="@T.AuthNav.Messages" hx-boost="false">
            <span class="sn-relative sn-inline-flex">
                <span class="icon icon-chat-bubbles" aria-hidden="true"></span>
                <span class="sn-dm-badge sn-hidden">0</span>
            </span>
        </a>
        }
        <!-- Notification bell -->
        <div class="sn-dropdown sn-flex-1 sn-flex">
            <button type="button" class="sn-tabbar-item sn-flex-1" aria-label="@T.AuthNav.Notifications"
                    popovertarget="sn-mobile-notif-panel">
                <span class="sn-relative sn-inline-flex">
                    <span class="icon icon-bell" aria-hidden="true"></span>
                    <span class="sn-notification-badge sn-hidden">0</span>
                </span>
            </button>
            <div id="sn-mobile-notif-panel" popover class="sn-dropdown-panel sn-dropdown-panel-top sn-w-80 sn-max-h-96 sn-overflow-y-auto">
                <div class="sn-notif-panel-header">
                    <span class="sn-font-semibold">@T.AuthNav.Notifications</span>
                    <button data-action="mark-all-notifications-read" class="sn-text-xs sn-text-primary sn-hover:underline">@T.AuthNav.MarkAllRead</button>
                </div>
                <div class="notification-list sn-p-2">
                    <p class="sn-notif-empty-message">@T.Common.Loading</p>
                </div>
            </div>
        </div>

        <!-- User menu -->
        <div class="sn-dropdown sn-flex-1 sn-flex">
            <button type="button" class="sn-tabbar-item sn-flex-1@(Active("/my/contributions", prefix: true))" aria-label="@T.MobileNav.Me"
                    popovertarget="sn-mobile-user-menu">
                <div class="sn-avatar avatar-sm">
                    <img src="@avatarUrl"
                         srcset="@avatarMicroUrl 26w, @avatarUrl 80w"
                         sizes="43px"
                         alt="@displayName"
                         loading="lazy"
                         width="43" height="43" />
                </div>
            </button>
            <ul id="sn-mobile-user-menu" popover class="sn-dropdown-panel sn-dropdown-panel-top sn-menu sn-w-52">
                <li>
                    <a href="@SnakkUrlHelper.UserProfile(slug)" class="sn-user-menu-card"
                       style="--user-grad: @UserGradient(publicId)">
                        <img src="@avatarUrl" alt="@displayName" class="sn-user-menu-card-avatar" loading="lazy" />
                        <span class="sn-user-menu-card-name">@displayName</span>
                        @if (emailVerified != "True")
                        {
                            <span class="sn-badge sn-badge-warning sn-badge-xs">@T.AuthNav.Unverified</span>
                        }
                    </a>
                </li>
                <li>
                    <a href="/my/settings">
                        <span class="icon icon-cog sn-h-4 sn-w-4" aria-hidden="true"></span>
                        @T.Nav.Settings
                    </a>
                </li>
                <li>
                    <a href="#" data-action="toggle-theme">
                        <span class="icon icon-moon sn-h-4 sn-w-4" aria-hidden="true"></span>
                        @T.AuthNav.ToggleTheme
                    </a>
                </li>
                @if (isModerator)
                {
                    <li><hr class="sn-my-1 sn-border-subtle" /></li>
                    <li>
                        <a href="/moderation">
                            <span class="icon icon-shield-check sn-h-4 sn-w-4" aria-hidden="true"></span>
                            @T.AuthNav.Moderation
                        </a>
                    </li>
                    <li><hr class="sn-my-1 sn-border-subtle" /></li>
                }
                @if (isGlobalAdmin)
                {
                    <li>
                        <a href="/admin" hx-boost="false">
                            <span class="icon icon-cog sn-h-4 sn-w-4" aria-hidden="true"></span>
                            @T.AuthNav.AdminPanel
                        </a>
                    </li>
                    <li><hr class="sn-my-1 sn-border-subtle" /></li>
                }
                <li>
                    <a href="#" data-action="logout">
                        <span class="icon icon-logout sn-h-4 sn-w-4" aria-hidden="true"></span>
                        @T.AuthNav.Logout
                    </a>
                </li>
            </ul>
        </div>
    }
    else
    {
        <a href="/auth/login" class="sn-tabbar-item@(Active("/auth/login", prefix: true))" aria-label="@T.AuthNav.Login" hx-boost="false">
            <span class="icon icon-user" aria-hidden="true"></span>
        </a>
        <a href="/auth/register" class="sn-tabbar-item@(Active("/auth/register", prefix: true))" aria-label="@T.AuthNav.SignUp" hx-boost="false">
            <span class="icon icon-user-add" aria-hidden="true"></span>
        </a>
    }
</nav>
