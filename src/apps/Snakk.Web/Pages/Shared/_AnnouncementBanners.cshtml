@using Snakk.Protos.Announcement
@model IEnumerable<AnnouncementInfo>?

@if (Model != null && Model.Any())
{
    <div class="announcement-banners mb-4">
        @foreach (var announcement in Model)
        {
            var alertClass = announcement.Type switch
            {
                "Critical" => "alert-error",
                "Warning" => "alert-warning",
                _ => "alert-info"
            };

            <div class="alert @alertClass mb-2 announcement-banner"
                 data-announcement-id="@announcement.PublicId"
                 data-dismissible="@announcement.IsDismissible.ToString().ToLower()">
                <div class="flex-1">
                    @if (!string.IsNullOrEmpty(announcement.Title))
                    {
                        <h3 class="font-bold text-sm">@announcement.Title</h3>
                    }
                    <div class="prose prose-sm max-w-none announcement-content">
                        @Html.Raw(announcement.RenderedContent)
                    </div>
                </div>
                @if (announcement.IsDismissible)
                {
                    <button class="btn btn-sm btn-ghost announcement-dismiss self-start shrink-0 ml-auto"
                            onclick="dismissAnnouncement('@announcement.PublicId', this)"
                            aria-label="Dismiss announcement">
                        ✕
                    </button>
                }
            </div>
        }
    </div>

    <script>
        (function() {
            'use strict';

            // Hide already-dismissed announcements on load
            document.querySelectorAll('.announcement-banner[data-dismissible="true"]').forEach(function(banner) {
                var id = banner.getAttribute('data-announcement-id');
                if (localStorage.getItem('announcement-dismissed-' + id)) {
                    banner.style.display = 'none';
                }
            });

            // Global dismiss function
            window.dismissAnnouncement = function(publicId, button) {
                localStorage.setItem('announcement-dismissed-' + publicId, '1');
                var banner = button.closest('.announcement-banner');
                if (banner) banner.style.display = 'none';
            };
        })();
    </script>
}
