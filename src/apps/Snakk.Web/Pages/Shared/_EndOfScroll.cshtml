@* End-of-scroll illustration with search CTA *@
<div class="sn-text-center py-10">
    <img src="/svg/astronaut.svg" width="130" height="110" class="sn-mx-auto sn-mb-4 sn-opacity-30" aria-hidden="true" alt="">
    <p class="sn-end-of-scroll-title">@T.EndOfScroll.Title</p>
    <p class="sn-end-of-scroll-body">@T.EndOfScroll.Body</p>
    <a href="/search" class="sn-btn sn-btn-ghost sn-btn-sm sn-mt-3">
        <span class="sn-icon icon-search sn-mr-1" aria-hidden="true"></span>
        @T.Common.Search
    </a>
</div>
