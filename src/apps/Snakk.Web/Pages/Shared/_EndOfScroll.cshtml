@* End-of-scroll illustration with search CTA *@
<div class="text-center py-10">
    <img src="/svg/astronaut.svg" width="130" height="110" class="mx-auto mb-4 opacity-30" aria-hidden="true" alt="">
    <p class="text-muted text-sm font-medium">@T.EndOfScroll.Title</p>
    <p class="text-muted text-xs mt-1">@T.EndOfScroll.Body</p>
    <a href="/search" class="btn btn-ghost btn-sm mt-3">
        <span class="icon icon-search w-4 h-4 mr-1" aria-hidden="true"></span>
        @T.Common.Search
    </a>
</div>
