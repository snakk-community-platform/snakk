@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using static Snakk.Web.Helpers.DisplayHelper
@using static Snakk.Web.Helpers.DiscussionTypeHelper
@model DiscussionListItemVM
@{
    var discussion = Model.Discussion;
    var baseUrl = Model.ShowCommunity
        ? SnakkUrlHelper.Discussion(
            discussion.Community.Slug,
            Model.Community,
            discussion.Hub.Slug,
            discussion.Space.Slug,
            SnakkUrlHelper.DiscussionSlugId(discussion.Slug, discussion.PublicId))
        : SnakkUrlHelper.Discussion(
            Model.Community,
            discussion.Hub.Slug,
            discussion.Space.Slug,
            SnakkUrlHelper.DiscussionSlugId(discussion.Slug, discussion.PublicId));

    var unreadUrl = $"{baseUrl}?gotoUnread=true";
}

<div class="topic-item-wrapper h-entry">
    <img src="@discussion.Author.AvatarThumbnailUrl"
         alt="@discussion.Author.DisplayName"
         width="40" height="40"
         class="w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"
         loading="lazy" decoding="async" />

    <div class="topic-item">
        <div class="topic-content">
            <div class="topic-title">
                <a href="@baseUrl" class="topic-title-link u-url p-name">@discussion.Title</a>
            </div>
            <div class="topic-meta">
                @if (Model.ShowCommunity)
                {
                    <a href="@SnakkUrlHelper.Community(discussion.Community.Slug, Model.Community)"
                       class="topic-meta-link"
                       data-popup-type="community"
                       data-popup-id="@discussion.Community.PublicId"
                       data-popup-name="@discussion.Community.Name">@discussion.Community.Name</a>
                    @if (Model.ShowHub || Model.ShowSpace)
                    {
                        <span class="icon icon-chevron-right" style="width:12px;height:12px" aria-hidden="true"></span>
                    }
                }
                @{
                    var hubUrl = Model.ShowCommunity
                        ? SnakkUrlHelper.Hub(discussion.Community.Slug, Model.Community, discussion.Hub.Slug)
                        : SnakkUrlHelper.Hub(Model.Community, discussion.Hub.Slug);
                    var spaceUrl = Model.ShowCommunity
                        ? SnakkUrlHelper.Space(discussion.Community.Slug, Model.Community, discussion.Hub.Slug, discussion.Space.Slug)
                        : SnakkUrlHelper.Space(Model.Community, discussion.Hub.Slug, discussion.Space.Slug);
                }
                @if (Model.ShowHub)
                {
                    <a href="@hubUrl"
                       class="topic-meta-link"
                       data-popup-type="hub"
                       data-popup-id="@discussion.Hub.PublicId"
                       data-popup-name="@discussion.Hub.Name">@discussion.Hub.Name</a>
                    @if (Model.ShowSpace)
                    {
                        <span class="icon icon-chevron-right" style="width:12px;height:12px" aria-hidden="true"></span>
                    }
                }
                @if (Model.ShowSpace)
                {
                    <a href="@spaceUrl"
                       class="topic-meta-link"
                       data-popup-type="space"
                       data-popup-id="@discussion.Space.PublicId"
                       data-popup-name="@discussion.Space.Name">@discussion.Space.Name</a>
                }
                @if (Model.ShowCommunity || Model.ShowHub || Model.ShowSpace)
                {
                    <span class="topic-meta-separator">&middot;</span>
                }
                <time class="dt-published" datetime="@(discussion.CreatedAt?.ToDateTime().ToString("o"))">@FormatRelativeTime((discussion.LastActivityAt ?? discussion.CreatedAt)?.ToDateTime())</time>
                <span class="p-author h-card" hidden>@discussion.Author.DisplayName</span>
                @if (!string.IsNullOrEmpty(discussion.Type) && discussion.Type != "Standard")
                {
                    var (icon, label, cssClass) = GetTypeBadge(discussion.Type);
                    <span class="topic-meta-separator">&middot;</span>
                    <span class="@cssClass text-xs">@icon @label</span>
                }
            </div>
        </div>
        <div class="topic-stats hidden sm:flex">
              <div class="topic-stat">
                <div class="topic-stat-icon">
                    <span class="icon icon-emoji-happy" style="width:18px;height:18px" aria-hidden="true"></span>
                </div>
                <div class="topic-stat-value">@discussion.ReactionCount</div>
            </div>
            <div class="topic-stat">
                <div class="topic-stat-icon">
                    <span class="icon icon-chat-square" style="width:18px;height:18px" aria-hidden="true"></span>
                </div>
                <div class="topic-stat-value">@discussion.PostCount</div>
            </div>
        </div>
    </div>
    <button class="preview-btn"
            data-discussion-id="@discussion.PublicId"
            title="Preview first post"
            type="button">
        <span class="icon icon-chevron-down" style="width:18px;height:18px" aria-hidden="true"></span>
    </button>
    <a href="@unreadUrl" class="topic-latest-link" title="Jump to first unread post">
        <span class="icon icon-chevron-down chevron-right" style="width:18px;height:18px" aria-hidden="true"></span>
    </a>
    <div class="discussion-preview hidden" data-discussion-id="@discussion.PublicId">
        <div class="preview-content"></div>
    </div>
</div>
