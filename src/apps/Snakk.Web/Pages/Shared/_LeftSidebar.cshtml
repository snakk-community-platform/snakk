@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityContext
@{
    const string rulesUrl = "/rules";
    const string moderatorsUrl = "/moderators";
    var path = ViewContext.HttpContext.Request.Path.Value ?? "";
    var isGuest = User.Identity?.IsAuthenticated != true;

    string A(string href) => path == href ? " active" : "";
    string AEnd(string suffix) => path.EndsWith(suffix) ? " active" : "";

    var isSingleCommunity = !CommunityContext.IsMultiCommunityEnabled;
    var communityHref = isSingleCommunity ? "/c" : "/communities";
    var communityLabel = isSingleCommunity ? T.Nav.Community : T.Nav.Communities;
}
<aside id="sn-left-drawer" class="sn-left">
<div class="sn-left-sticky">
    <div class="sn-left-inner">
        <nav class="sn-nav">
            <a href="@communityHref" class="sn-nav-item@(A(communityHref))">
                <span class="icon icon-users-group" aria-hidden="true"></span>
                @communityLabel
            </a>
            <div class="sn-nav-group">
            <div class="sn-nav-heading">
                <span class="icon icon-grid-apps" aria-hidden="true"></span>
                @T.Nav.Explore
            </div>
            <a href="/" class="sn-nav-item@(A("/"))">
                <span class="icon icon-home" aria-hidden="true"></span>
                @T.Nav.Active
            </a>
            <a href="/trending" class="sn-nav-item@(A("/trending"))">
                <span class="icon icon-trending-up" aria-hidden="true"></span>
                @T.Nav.Trending
            </a>
            <a href="/top" class="sn-nav-item@(A("/top"))">
                <span class="icon icon-star" aria-hidden="true"></span>
                @T.Nav.Top
            </a>
            <a href="/latest" class="sn-nav-item@(A("/latest"))">
                <span class="icon icon-clock" aria-hidden="true"></span>
                @T.Nav.Latest
            </a>
            <a href="/my-feed" class="sn-nav-item@(A("/my-feed"))">
                <span class="icon icon-rss" aria-hidden="true"></span>
                @T.Nav.MyFeed
                @if (isGuest) { <span class="icon icon-lock-closed sn-nav-lock" aria-hidden="true"></span> }
            </a>
            </div>
            <a href="@rulesUrl" class="sn-nav-item@(AEnd("/rules"))">
                <span class="icon icon-document-text" aria-hidden="true"></span>
                @T.Nav.Rules
            </a>
            <a href="@moderatorsUrl" class="sn-nav-item@(AEnd("/moderators"))">
                <span class="icon icon-shield-check" aria-hidden="true"></span>
                @T.Nav.Moderators
            </a>
            <div class="sn-nav-group">
            <div class="sn-nav-heading">
                <span class="icon icon-library-building" aria-hidden="true"></span>
                @T.Nav.YourLibrary
            </div>
            <a href="/saved" class="sn-nav-item@(A("/saved"))">
                <span class="icon icon-bookmark" aria-hidden="true"></span>
                @T.Nav.Saved
                @if (isGuest) { <span class="icon icon-lock-closed sn-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/me" class="sn-nav-item@(A("/me"))">
                <span class="icon icon-user" aria-hidden="true"></span>
                @T.Nav.MyContributions
                @if (isGuest) { <span class="icon icon-lock-closed sn-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/following" class="sn-nav-item@(A("/following"))">
                <span class="icon icon-bell" aria-hidden="true"></span>
                @T.Nav.Following
                @if (isGuest) { <span class="icon icon-lock-closed sn-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/history" class="sn-nav-item@(A("/history"))">
                <span class="icon icon-clock" aria-hidden="true"></span>
                @T.Nav.History
                @if (isGuest) { <span class="icon icon-lock-closed sn-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/reactions" class="sn-nav-item@(A("/reactions"))">
                <span class="icon icon-emoji-happy" aria-hidden="true"></span>
                @T.Nav.Reactions
                @if (isGuest) { <span class="icon icon-lock-closed sn-nav-lock" aria-hidden="true"></span> }
            </a>
            </div>
        </nav>
        <div class="sn-left-footer">
            <a href="@(isGuest ? "/settings/browser" : "/settings")" class="sn-nav-item">
                <span class="icon icon-cog" aria-hidden="true"></span>
                @T.Nav.Settings
            </a>
            <a href="/help" class="sn-nav-item"><span class="icon icon-question-circle" aria-hidden="true"></span> @T.Nav.Help</a>
            <a href="/privacy" class="sn-nav-item"><span class="icon icon-lock-closed" aria-hidden="true"></span> @T.Nav.PrivacyPolicy</a>
            <a href="/cookies" class="sn-nav-item"><span class="icon icon-info-circle" aria-hidden="true"></span> @T.Nav.Cookies</a>
            <a href="https://github.com/snakk-community-platform/snakk" target="_blank" rel="noopener noreferrer"
               class="block px-3 pt-2 pb-0 text-xs" style="color: var(--text-tertiary)">@T.Footer.PoweredBy</a>
        </div>
    </div>
</div>
</aside>
