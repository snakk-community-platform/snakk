@using Snakk.Web.Helpers
@{
    const string rulesUrl = "/rules";
    const string moderatorsUrl = "/moderators";
    var path = ViewContext.HttpContext.Request.Path.Value ?? "";
    var isGuest = User.Identity?.IsAuthenticated != true;

    string A(string href) => path == href ? " active" : "";
    string AEnd(string suffix) => path.EndsWith(suffix) ? " active" : "";
}
<aside class="fp-left">
<div class="fp-left-sticky">
    <div class="fp-left-inner">
        <nav class="fp-nav">
            <div class="fp-nav-group">
            <div class="fp-nav-heading">
                <span class="icon icon-grid-apps" aria-hidden="true"></span>
                Explore
            </div>
            <a href="/" class="fp-nav-item@(A("/"))">
                <span class="icon icon-home" aria-hidden="true"></span>
                Active
            </a>
            <a href="/trending" class="fp-nav-item@(A("/trending"))">
                <span class="icon icon-trending-up" aria-hidden="true"></span>
                Trending
            </a>
            <a href="/top" class="fp-nav-item@(A("/top"))">
                <span class="icon icon-star" aria-hidden="true"></span>
                Top
            </a>
            <a href="/latest" class="fp-nav-item@(A("/latest"))">
                <span class="icon icon-clock" aria-hidden="true"></span>
                Latest
            </a>
            </div>
            <a href="/communities" class="fp-nav-item@(A("/communities"))">
                <span class="icon icon-users-group" aria-hidden="true"></span>
                Communities
            </a>
            <div class="fp-nav-group">
            <div class="fp-nav-heading">
                <span class="icon icon-library-building" aria-hidden="true"></span>
                Your Library
            </div>
            <a href="/saved" class="fp-nav-item@(A("/saved"))">
                <span class="icon icon-bookmark" aria-hidden="true"></span>
                Saved
                @if (isGuest) { <span class="icon icon-lock-closed fp-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/me" class="fp-nav-item@(A("/me"))">
                <span class="icon icon-user" aria-hidden="true"></span>
                My Contributions
                @if (isGuest) { <span class="icon icon-lock-closed fp-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/following" class="fp-nav-item@(A("/following"))">
                <span class="icon icon-bell" aria-hidden="true"></span>
                Following
                @if (isGuest) { <span class="icon icon-lock-closed fp-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/history" class="fp-nav-item@(A("/history"))">
                <span class="icon icon-clock" aria-hidden="true"></span>
                History
                @if (isGuest) { <span class="icon icon-lock-closed fp-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/reactions" class="fp-nav-item@(A("/reactions"))">
                <span class="icon icon-emoji-happy" aria-hidden="true"></span>
                Reactions
                @if (isGuest) { <span class="icon icon-lock-closed fp-nav-lock" aria-hidden="true"></span> }
            </a>
            </div>
            <a href="@rulesUrl" class="fp-nav-item@(AEnd("/rules"))">
                <span class="icon icon-document-text" aria-hidden="true"></span>
                Rules
            </a>
            <a href="@moderatorsUrl" class="fp-nav-item@(AEnd("/moderators"))">
                <span class="icon icon-shield-check" aria-hidden="true"></span>
                Moderators
            </a>
        </nav>
        <div class="fp-left-footer">
            <a href="/settings" class="fp-nav-item">
                <span class="icon icon-cog" aria-hidden="true"></span>
                Settings
                @if (isGuest) { <span class="icon icon-lock-closed fp-nav-lock" aria-hidden="true"></span> }
            </a>
            <a href="/help" class="fp-nav-item"><span class="icon icon-question-circle" aria-hidden="true"></span> Help</a>
            <a href="/privacy" class="fp-nav-item"><span class="icon icon-lock-closed" aria-hidden="true"></span> Privacy Policy</a>
            <a href="/cookies" class="fp-nav-item"><span class="icon icon-info-circle" aria-hidden="true"></span> Cookies</a>
        </div>
    </div>
</div>
</aside>
