@* Critical above-fold CSS inlined to allow first paint before external stylesheets load.
   Covers: CSS custom properties (both themes), body base, sn-layout grid, sn-header, sn-tabbar.
   Source of truth is the SCSS partials — keep in sync when those change:
     Styles/base/_variables.scss, base/_layout.scss, pages/_layout.scss,
     components/_site-header.scss, components/_mobile-nav.scss *@
<style>
:root{--bg-primary:#F1FAF5;--bg-secondary:#E8F6EF;--bg-tertiary:#FFFFFF;--bg-subtle:#E8EFE8;--border-primary:#DDE5DD;--border-secondary:#E8EFE8;--border-subtle:#C5D1C5;--text-primary:#1B2B24;--text-secondary:#5E6E66;--text-tertiary:#7A8A82;--text-muted:#95A39B;--link-primary:#1F7A5A;--link-hover:#145A41;--nav-bg:#1F7A5A;--nav-text:rgba(255,255,255,0.8);--nav-text-hover:#FFFFFF;--nav-border:#145A41;--breadcrumb-bg:#4CAF7D;--breadcrumb-text:var(--text-secondary);--breadcrumb-border:#3D9A6C;--sidebar-bg:#DDF3E6;--surface-gradient-top:#efefef;--surface-gradient-bottom:#ffffff;--navbar-gradient-top:#e8e8e8;--navbar-gradient-bottom:#ffffff;--sidebar-gradient-mix:#e0e0e0;--divider-hairline:#f0f0f0;--accent-info:#3b82f6;--accent-info-hover:#2563eb;--accent-info-strong:#1d4ed8;--accent-info-outline:#0066cc;--accent-info-bg:#eff6ff;--accent-info-bg-soft:#f0f7ff;--accent-info-bg-tint:#e8f4fd;--accent-warning:#d97706;--accent-warning-strong:#f59e0b;--accent-warning-text:#b45309;--accent-warning-bg:#fef3c7;--accent-danger:#dc2626;--accent-danger-strong:#ef4444;--accent-danger-bg:#fee2e2;--accent-danger-border:#fca5a5;--accent-success:#10b981;--accent-success-text:#047857;--color-base-100:var(--bg-primary);--color-base-200:var(--bg-secondary);--color-base-300:var(--bg-tertiary);--color-base-content:var(--text-primary)}
[data-theme="dark"]{--bg-primary:#0F1A14;--bg-secondary:#010b08;--bg-tertiary:#1A2E26;--bg-subtle:#09130e;--border-primary:#2A4038;--border-secondary:#1E3429;--border-subtle:#3D5A4E;--text-primary:#D8EDE2;--text-secondary:#9AB3A5;--text-tertiary:#7A9488;--text-muted:#5A7568;--link-primary:#3B9A6E;--link-hover:#4CAF7D;--nav-bg:#0A1410;--nav-text:rgba(255,255,255,0.7);--nav-text-hover:#FFFFFF;--nav-border:#1F7A5A;--breadcrumb-bg:#12211A;--breadcrumb-text:rgba(255,255,255,0.7);--breadcrumb-border:#1A3028;--sidebar-bg:#12211A;--surface-gradient-top:#0a1410;--surface-gradient-bottom:#030604;--navbar-gradient-top:#0a1410;--navbar-gradient-bottom:#0F1A14;--sidebar-gradient-mix:#1A2E26;--divider-hairline:#1E3429;--accent-info:#60a5fa;--accent-info-hover:#93c5fd;--accent-info-strong:#93c5fd;--accent-info-outline:#60a5fa;--accent-info-bg:rgba(96,165,250,0.12);--accent-info-bg-soft:rgba(96,165,250,0.06);--accent-info-bg-tint:rgba(96,165,250,0.10);--accent-warning:#c08010;--accent-warning-strong:#d97706;--accent-warning-text:#d97706;--accent-warning-bg:rgba(192,128,16,0.18);--accent-danger:#f87171;--accent-danger-strong:#ef4444;--accent-danger-bg:rgba(239,68,68,0.15);--accent-danger-border:rgba(239,68,68,0.45);--accent-success:#20b57a;--accent-success-text:#20b57a;--color-base-100:var(--bg-primary);--color-base-200:var(--bg-secondary);--color-base-300:var(--bg-tertiary);--color-base-content:var(--text-primary)}
*,*::before,*::after{box-sizing:border-box}
body{min-height:100vh;display:flex;flex-direction:column;padding-top:3.5rem;font-family:-apple-system,BlinkMacSystemFont,"Segoe UI",Roboto,Helvetica,Arial,sans-serif;line-height:1.5;-webkit-font-smoothing:antialiased;-moz-osx-font-smoothing:grayscale;background-color:var(--bg-primary);color:var(--text-primary)}
.sn-layout{display:grid;grid-template-columns:minmax(0,1fr);min-height:100vh}
@@media (min-width:1024px) and (max-width:1249.98px){.sn-layout{grid-template-columns:minmax(0,1fr) 320px}}
@@media (min-width:1250px) and (max-width:1539.98px){.sn-layout{grid-template-columns:256px minmax(640px,var(--content-width,864px)) 320px}}
@@media (min-width:1540px){.sn-layout{grid-template-columns:minmax(256px,1fr) var(--content-width,864px) minmax(320px,1fr)}}
.sn-header{position:fixed;top:0;left:0;right:0;z-index:30;height:3.5rem;display:grid;align-items:center;background:var(--bg-primary);grid-template-columns:1fr}
@@media (min-width:1024px){.sn-header{grid-template-columns:minmax(0,1fr) 320px}}
@@media (min-width:1250px){.sn-header{grid-template-columns:256px minmax(640px,var(--content-width,864px)) 320px}}
@@media (min-width:1540px){.sn-header{grid-template-columns:minmax(256px,1fr) var(--content-width,864px) minmax(320px,1fr)}}
.sn-header-left{display:none;height:100%;justify-content:flex-end;background:var(--bg-secondary)}
@@media (min-width:1250px){.sn-header-left{display:flex}}
.sn-header-center{display:flex;align-items:center;height:100%;padding:0 1.5rem;border-bottom:1px solid var(--border-secondary)}
.sn-header-right{display:none;height:100%;background:linear-gradient(to bottom,color-mix(in srgb,var(--nav-bg) 5%,var(--sidebar-gradient-mix)),var(--bg-secondary) 1.5rem) fixed}
@@media (min-width:1024px){.sn-header-right{display:flex;justify-content:flex-start}}
.sn-tabbar{display:none;position:fixed;left:0;right:0;bottom:0;z-index:80;height:3.5rem;background:var(--bg-primary);border-top:1px solid var(--border-secondary);padding-bottom:env(safe-area-inset-bottom,0)}
@@media (max-width:1023.98px){.sn-tabbar{display:flex}body{padding-bottom:calc(3.5rem + env(safe-area-inset-bottom,0) + 0.75rem)}}
.sn-main-body{display:contents}
@@media (min-width:1024px) and (max-width:1249.98px){.sn-center{grid-column:1}.sn-center-wide{grid-column:1/-1}}
@@media (min-width:1250px){.sn-center{grid-column:2}.sn-center-wide{grid-column:2/-1}}
.sn-right{grid-column:3}
@@media (min-width:1024px) and (max-width:1249.98px){.sn-right{grid-column:2}}
@@media (max-width:1023.98px){.sn-right{display:none}}
.sn-header-left-inner{width:256px;height:100%;display:flex;align-items:center;gap:0.375rem;padding:0 0.5rem}
.sn-header-center-content{flex:1;min-width:0;display:flex;align-items:center;height:100%}
.sn-header-right-inner{width:320px;height:100%;display:flex;align-items:center;justify-content:flex-end;gap:0.25rem;padding:0 1rem}
#auth-nav{display:flex;align-items:center}
.sn-center-inner{padding:1.5rem}
@@media (max-width:1023.98px){.sn-center-inner{padding:1rem}}
#discussions-container,.sn-card-list{display:flex;flex-direction:column;gap:2.5rem}
.sn-card{display:flex;flex-direction:row;gap:0.65rem;position:relative;padding:1.25rem .75rem;margin:-1.25rem -.75rem}
.sn-card~.sn-card{border-top:1px solid var(--border-secondary)}
.sn-card-header{display:flex;align-items:center;gap:0.35rem}
.sn-card-preview{position:relative;z-index:2;margin:0.35rem 0;cursor:pointer}
.sn-card-reply-strip{position:relative;display:flex;align-items:center;gap:0.35rem;margin-top:0.25rem;border-radius:0.375rem;background:var(--bg-secondary);padding:0.5rem}
.sn-left{display:flex;justify-content:flex-end;grid-row:1/-1}
@@media (max-width:1249.98px){.sn-left{position:fixed;top:0;left:0;bottom:0;transform:translateX(-100%)}}
.sn-left-sticky{width:256px;position:sticky;top:3.5rem;height:calc(100vh - 3.5rem);display:flex;flex-direction:column}
.sn-right-sticky{width:320px;position:sticky;top:3.5rem;height:calc(100vh - 3.5rem);display:flex;flex-direction:column;gap:1rem}
</style>
