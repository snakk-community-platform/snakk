@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using static Snakk.Web.Helpers.DisplayHelper
@using static Snakk.Web.Helpers.DiscussionTypeHelper
@model SpaceDiscussionListItemVM
@{
    var discussion = Model.Discussion;
    var baseUrl = SnakkUrlHelper.Discussion(Model.Community, Model.HubSlug, Model.SpaceSlug, SnakkUrlHelper.DiscussionSlugId(discussion.Slug, discussion.PublicId));
    var unreadUrl = $"{baseUrl}?gotoUnread=true";
}

<div class="topic-item-wrapper" data-discussion-id="@discussion.PublicId">
    <img src="@discussion.Author.AvatarThumbnailUrl"
         alt="@discussion.Author.DisplayName"
         width="40" height="40"
         class="w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"
         loading="lazy" decoding="async" />

    <div class="topic-item">
        <div class="topic-content">
            <div class="topic-title">
                <a href="@baseUrl" class="topic-title-link">@discussion.Title</a>
            </div>
            <div class="topic-meta">
                <span>@FormatRelativeTime((discussion.LastActivityAt ?? discussion.CreatedAt)?.ToDateTime())</span>
                @if (discussion.Type is not "" and not "Standard")
                {
                    var (icon, label, cssClass) = GetTypeBadge(discussion.Type);
                    <span class="discussion-type-badge badge-sm @cssClass">@icon @label</span>
                }
            </div>
        </div>
        <div class="topic-stats hidden sm:flex">
            <div class="topic-stat">
                <div class="topic-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                </div>
                <div class="topic-stat-value">@discussion.ReactionCount</div>
            </div>
            <div class="topic-stat">
                <div class="topic-stat-icon">
                    <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path>
                    </svg>
                </div>
                <div class="topic-stat-value" data-stat="post-count">@discussion.PostCount</div>
            </div>
        </div>
    </div>
    <button class="preview-btn"
            data-discussion-id="@discussion.PublicId"
            title="Preview first post"
            type="button">
        <svg xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </button>
    <a href="@unreadUrl" class="topic-latest-link" title="Jump to first unread post">
        <svg class="chevron-right" xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <polyline points="6 9 12 15 18 9"></polyline>
        </svg>
    </a>
    <div class="discussion-preview hidden" data-discussion-id="@discussion.PublicId">
        <div class="preview-content"></div>
    </div>
</div>
