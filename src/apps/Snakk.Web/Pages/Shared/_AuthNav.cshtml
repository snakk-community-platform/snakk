@using System.Security.Claims
@using Snakk.Web.Helpers
@{
    var isAuthenticated = User.Identity?.IsAuthenticated == true;
}
@if (isAuthenticated)
{
    var publicId = User.FindFirst(ClaimTypes.NameIdentifier)?.Value ?? "";
    var displayName = User.FindFirst(ClaimTypes.Name)?.Value ?? "";
    var emailVerified = User.FindFirst("EmailVerified")?.Value;
    var role = User.FindFirst(ClaimTypes.Role)?.Value;
    var isModerator = !string.IsNullOrEmpty(role);
    var isGlobalAdmin = role == "GlobalAdmin";
    var avatarFileName = User.FindFirst("AvatarFileName")?.Value;
    var avatarThumbnailFileName = User.FindFirst("AvatarThumbnailFileName")?.Value;
    var avatarUrl = SnakkUrlHelper.UserAvatarThumbnail(publicId, avatarFileName: avatarFileName, avatarThumbnailFileName: avatarThumbnailFileName);

    <!-- Notification Bell -->
    <div class="dropdown dropdown-end mr-2">
        <label tabindex="0" class="btn btn-ghost btn-sm btn-circle relative">
            <span class="icon icon-bell h-5 w-5" aria-hidden="true"></span>
            <span id="notification-badge" class="notification-badge hidden">0</span>
        </label>
        <div tabindex="0" class="dropdown-content z-[1] mt-3 w-80 max-h-96 overflow-y-auto shadow-lg bg-base-100 border border-subtle rounded-lg">
            <div class="flex items-center justify-between p-3 border-b border-subtle">
                <span class="font-semibold">@T.AuthNav.Notifications</span>
                <button data-action="mark-all-notifications-read" class="text-xs text-primary hover:underline">@T.AuthNav.MarkAllRead</button>
            </div>
            <div id="notification-list" class="p-2">
                <p class="text-sm text-muted text-center py-4">@T.Common.Loading</p>
            </div>
        </div>
    </div>
    <!-- User Menu -->
    <div class="dropdown dropdown-end">
        <label tabindex="0" class="btn btn-ghost btn-sm btn-circle p-0">
            <div class="avatar avatar-sm">
                <img src="@avatarUrl"
                     alt="@displayName"
                     loading="lazy" />
            </div>
        </label>
        <ul tabindex="0" class="mt-3 z-[1] p-2 shadow-lg menu menu-sm dropdown-content bg-base-100 border border-subtle rounded-lg w-52">
            <li>
                <a href="@SnakkUrlHelper.UserProfile(publicId)" class="font-semibold">
                    <span class="icon icon-user h-4 w-4" aria-hidden="true"></span>
                    @displayName
                    @if (emailVerified != "True")
                    {
                        <span class="badge badge-warning badge-xs ml-2">@T.AuthNav.Unverified</span>
                    }
                </a>
            </li>
            <li>
                <a href="/settings">
                    <span class="icon icon-cog h-4 w-4" aria-hidden="true"></span>
                    @T.Nav.Settings
                </a>
            </li>
            <li>
                <a href="#" id="theme-toggle" data-action="toggle-theme">
                    <span class="icon icon-moon h-4 w-4" aria-hidden="true"></span>
                    @T.AuthNav.ToggleTheme
                </a>
            </li>
            @if (isModerator)
            {
                <li><hr class="my-1 border-subtle"/></li>
                <li>
                    <a href="/moderation">
                        <span class="icon icon-shield-check h-4 w-4" aria-hidden="true"></span>
                        @T.AuthNav.Moderation
                    </a>
                </li>
                <li><hr class="my-1 border-subtle"/></li>
            }
            @if (isGlobalAdmin)
            {
                <li>
                    <a href="/admin" hx-boost="false">
                        <span class="icon icon-cog h-4 w-4" aria-hidden="true"></span>
                        @T.AuthNav.AdminPanel
                    </a>
                </li>
                <li><hr class="my-1 border-subtle"/></li>
            }
            <li>
                <a href="#" data-action="logout">
                    <span class="icon icon-logout h-4 w-4" aria-hidden="true"></span>
                    @T.AuthNav.Logout
                </a>
            </li>
        </ul>
    </div>
}
else
{
    <a href="/auth/login" class="btn btn-ghost btn-sm" hx-boost="false">@T.AuthNav.Login</a>
    <a href="/auth/register" class="btn btn-primary btn-sm" hx-boost="false">@T.AuthNav.SignUp</a>
}
