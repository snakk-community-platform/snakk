@for (var i = 0; i < 3; i++)
{
    <div class="sn-card" style="opacity: 0.5">
        <div class="sn-card-header">
            <div class="sn-skeleton h-3 sn-w-16 sn-rounded"></div>
            <div class="sn-skeleton sn-h-4 sn-w-4 sn-rounded-full"></div>
            <div class="sn-skeleton h-3 w-20 sn-rounded"></div>
        </div>
        <div class="sn-skeleton sn-h-4 w-3/4 sn-rounded sn-mt-2"></div>
        <div class="sn-card-stats sn-mt-2">
            <div class="sn-skeleton h-3 w-24 sn-rounded"></div>
        </div>
    </div>
}
