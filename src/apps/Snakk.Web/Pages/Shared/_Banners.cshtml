@using Snakk.Protos.Banner
@model IEnumerable<BannerInfo>?

@if (Model != null && Model.Any())
{
    <div class="banner-banners mb-4">
        @foreach (var banner in Model)
        {
            var alertClass = banner.Type switch
            {
                "Critical" => "alert-error",
                "Warning" => "alert-warning",
                _ => "alert-info"
            };

            <div class="alert @alertClass mb-2 banner-banner"
                 data-banner-id="@banner.PublicId"
                 data-dismissible="@banner.IsDismissible.ToString().ToLower()">
                <div class="flex-1">
                    @if (!string.IsNullOrEmpty(banner.Title))
                    {
                        <h3 class="font-bold text-sm">@banner.Title</h3>
                    }
                    <div class="prose prose-sm max-w-none banner-content">
                        @Html.Raw(banner.RenderedContent)
                    </div>
                </div>
                @if (banner.IsDismissible)
                {
                    <button class="btn btn-sm btn-ghost banner-dismiss self-start shrink-0 ml-auto"
                            onclick="dismissBanner('@banner.PublicId', this)"
                            aria-label="Dismiss banner">
                        ✕
                    </button>
                }
            </div>
        }
    </div>

    <script>
        (function() {
            'use strict';

            // Hide already-dismissed announcements on load
            document.querySelectorAll('.banner-banner[data-dismissible="true"]').forEach(function(banner) {
                var id = banner.getAttribute('data-banner-id');
                if (localStorage.getItem('banner-dismissed-' + id)) {
                    banner.style.display = 'none';
                }
            });

            // Global dismiss function
            window.dismissBanner = function(publicId, button) {
                localStorage.setItem('banner-dismissed-' + publicId, '1');
                var banner = button.closest('.banner-banner');
                if (banner) banner.style.display = 'none';
            };
        })();
    </script>
}
