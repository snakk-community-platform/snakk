@using Snakk.Protos.Banner
@model IEnumerable<BannerInfo>?

@if (Model != null && Model.Any())
{
    <script>
    (function () {
        var dismissed = [];
        for (var i = 0; i < localStorage.length; i++) {
            var k = localStorage.key(i);
            if (k && k.indexOf('banner-dismissed-') === 0 && localStorage.getItem(k)) {
                dismissed.push(k.slice('banner-dismissed-'.length));
            }
        }
        if (dismissed.length) {
            var css = dismissed.map(function (id) {
                return '[data-banner-id="' + id.replace(/"/g, '\\"') + '"] { display: none !important; }';
            }).join('');
            var s = document.createElement('style');
            s.textContent = css;
            document.head.appendChild(s);
        }
    })();
    </script>
    <div class="banner-banners sn-mb-4">
        @foreach (var banner in Model)
        {
            var alertClass = banner.Type switch
            {
                "Critical" => "sn-alert-error",
                "Warning" => "sn-alert-warning",
                _ => "sn-alert-info"
            };

            <div class="sn-alert @alertClass sn-mb-2 banner-banner"
                 data-banner-id="@banner.PublicId"
                 data-dismissible="@banner.IsDismissible.ToString().ToLower()">
                <div class="sn-flex-1">
                    @if (!string.IsNullOrEmpty(banner.Title))
                    {
                        <h3 class="sn-font-bold sn-text-sm">@banner.Title</h3>
                    }
                    <div class="sn-prose sn-prose-sm sn-max-w-none banner-content">
                        @Html.SanitizedRaw(banner.RenderedContent)
                    </div>
                </div>
                @if (banner.IsDismissible)
                {
                    <button class="sn-btn sn-btn-sm sn-btn-ghost banner-dismiss self-start sn-shrink-0 sn-ml-auto"
                            data-action="dismiss-banner"
                            data-banner-id="@banner.PublicId"
                            aria-label="@T.Banners.Dismiss">
                        ✕
                    </button>
                }
            </div>
        }
    </div>

    <script src="/js/dist/components/banners.js" asp-append-version="true" defer></script>
}
