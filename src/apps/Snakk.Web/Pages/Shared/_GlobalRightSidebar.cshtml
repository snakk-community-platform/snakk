<aside class="fp-right">
<div class="fp-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="fp-right-body">

    <div class="fp-right-section">
        <div class="fp-right-title">
            <span class="icon icon-chart-bar" aria-hidden="true"></span>
            Site Stats
        </div>
        <div hx-get="/partials/platform-stats?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex gap-2">
                <div class="flex-1"><div class="skeleton h-6 w-10 mb-1"></div><div class="skeleton h-3 w-16"></div></div>
                <div class="flex-1"><div class="skeleton h-6 w-10 mb-1"></div><div class="skeleton h-3 w-10"></div></div>
            </div>
        </div>
    </div>

    <div class="fp-right-section">
        <div class="fp-right-title">
            <span class="icon icon-archive-layers" aria-hidden="true"></span>
            Active Spaces
        </div>
        <div hx-get="/partials/trending-spaces?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="fp-spaces-inline">
                <div class="skeleton h-5 w-16 rounded"></div>
                <div class="skeleton h-5 w-20 rounded"></div>
                <div class="skeleton h-5 w-14 rounded"></div>
            </div>
        </div>
    </div>

    <div class="fp-right-section">
        <div class="fp-right-title">
            <span class="icon icon-users-group" aria-hidden="true"></span>
            Active Contributors
        </div>
        <div hx-get="/partials/trending-contributors?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="fp-trending-list">
                <div class="fp-trending-contributor" style="opacity:0.4"><div class="skeleton fp-avatar-square" style="width:28px;height:28px"></div><div class="skeleton h-3 w-24 rounded"></div></div>
                <div class="fp-trending-contributor" style="opacity:0.4"><div class="skeleton fp-avatar-square" style="width:28px;height:28px"></div><div class="skeleton h-3 w-20 rounded"></div></div>
            </div>
        </div>
    </div>

    </div>
</div>
</aside>
