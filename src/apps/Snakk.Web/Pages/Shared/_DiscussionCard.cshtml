@using Snakk.Shared.Enums
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@using static Snakk.Web.Helpers.DiscussionTypeHelper
@inject SnakkApiClient ApiClient
@model DiscussionListItemVM
@{
    var discussion = Model.Discussion;
    var adultPreviewMode = discussion.IsAdult
        ? await AdultContentGate.GetAdultPreviewImageModeAsync(Context, ApiClient)
        : AdultPreviewImageModeEnum.Show;
    var blurAdultImages = discussion.IsAdult && adultPreviewMode == AdultPreviewImageModeEnum.Blur;
    var hideAdultImages = discussion.IsAdult && adultPreviewMode == AdultPreviewImageModeEnum.Hide;
    var baseUrl = Model.ShowCommunity
        ? SnakkUrlHelper.Discussion(
            discussion.Community.Slug, Model.Community,
            discussion.Hub.Slug, discussion.Space.Slug,
            SnakkUrlHelper.DiscussionSlugId(discussion.Slug, discussion.PublicId))
        : SnakkUrlHelper.Discussion(
            Model.Community, discussion.Hub.Slug, discussion.Space.Slug,
            SnakkUrlHelper.DiscussionSlugId(discussion.Slug, discussion.PublicId));

    var communityUrl = Model.ShowCommunity
        ? SnakkUrlHelper.Community(discussion.Community.Slug, Model.Community)
        : null;
    var hubUrl = Model.ShowCommunity
        ? SnakkUrlHelper.Hub(discussion.Community.Slug, Model.Community, discussion.Hub.Slug)
        : SnakkUrlHelper.Hub(Model.Community, discussion.Hub.Slug);
    var spaceUrl = Model.ShowCommunity
        ? SnakkUrlHelper.Space(discussion.Community.Slug, Model.Community, discussion.Hub.Slug, discussion.Space.Slug)
        : SnakkUrlHelper.Space(Model.Community, discussion.Hub.Slug, discussion.Space.Slug);

    var replyCount = Math.Max(0, discussion.PostCount - 1);
}

<article class="sn-card h-entry" data-discussion-id="@discussion.PublicId"@if (Model.UnfollowId != null) {<text> data-following-item="discussion" data-id="@Model.UnfollowId"</text>}>
    <div class="sn-card-header">
        @if (Model.ShowUser)
        {
            <img src="@discussion.Author.AvatarMicroUrl" alt="" class="sn-card-avatar" width="20" height="20" loading="lazy" decoding="async" />
            @if (string.IsNullOrEmpty(discussion.Author.PublicId))
            {
                <span class="sn-card-author">@T.Card.DeletedUser</span>
            }
            else
            {
                <a href="@SnakkUrlHelper.UserProfile(discussion.Author.PublicId)" class="sn-card-author p-author h-card"
                   data-popup-type="user"
                   data-popup-id="@discussion.Author.PublicId"
                   data-popup-name="@discussion.Author.DisplayName">@discussion.Author.DisplayName</a>
            }
            <span class="sn-card-dot">&middot;</span>
        }
        <div class="tooltip tooltip-bottom" data-tip="@T.Card.CreatedAt @FormatFullDateTime(discussion.CreatedAt?.ToDateTime())">
            <time class="sn-card-time dt-published"
                  datetime="@(discussion.CreatedAt?.ToDateTime().ToString("o"))">@FormatRelativeTime(discussion.CreatedAt?.ToDateTime())</time>
        </div>
        @{
            var preview = discussion.Preview;
            var pollPreview = preview?.Poll;
            var debatePreview = preview?.Debate;
            var galleryPreview = preview?.Images;
            var linkPreview = preview?.Link;
            var iamaPreview = preview?.Iama;
        }
        @if (discussion.IsAdult)
        {
            <span class="sn-card-type-badge sn-card-type-badge-nsfw" title="@T.Adult.Title">@T.Adult.BadgeNsfw</span>
        }
        @if (!string.IsNullOrEmpty(discussion.Type) && discussion.Type != "Standard")
        {
            var (icon, label, cssClass) = GetTypeBadge(discussion.Type);
            <span class="sn-card-type-badge @cssClass">@icon @label</span>
        }
        @if (Model.ShowPath)
        {
            <span class="sn-card-path">
                @if (Model.ShowCommunity)
                {
                    <a href="@communityUrl" class="sn-card-path-link"
                       data-popup-type="community"
                       data-popup-id="@discussion.Community.PublicId"
                       data-popup-name="@discussion.Community.Name">@discussion.Community.Name</a>
                    <span class="sn-card-path-sep">&rsaquo;</span>
                }
                @if (Model.ShowHub)
                {
                    <a href="@hubUrl" class="sn-card-path-link"
                       data-popup-type="hub"
                       data-popup-id="@discussion.Hub.PublicId"
                       data-popup-name="@discussion.Hub.Name">@discussion.Hub.Name</a>
                    <span class="sn-card-path-sep">&rsaquo;</span>
                }
                <a href="@spaceUrl" class="sn-card-tag sn-card-tag--space"
                   style="--space-grad: @SpaceGradient(discussion.Space.PublicId)"
                   data-popup-type="space"
                   data-popup-id="@discussion.Space.PublicId"
                   data-popup-name="@discussion.Space.Name">@discussion.Space.Name</a>
            </span>
        }
    </div>

    <div class="sn-card-title-row">
        <div class="sn-card-title">
            <a href="@baseUrl" class="u-url p-name">@discussion.Title</a>
        </div>
        <span class="sn-card-stat sn-card-reactions@(discussion.ReactionCount == 0 ? " hidden" : "")">
            <span class="icon icon-badge-check" style="width:16px;height:16px" aria-hidden="true"></span>
            <span data-stat="reaction-count">@discussion.ReactionCount</span>
        </span>
        <a href="@baseUrl" class="sn-card-stat sn-card-comments@(replyCount == 0 ? " hidden" : "")">
            <span class="icon icon-chat-bubble-filled" aria-hidden="true"></span>
            <span data-stat="post-count">@replyCount</span> <span class="sn-card-comments-label">@T.Card.Comments</span>
        </a>
    </div>

    @if (pollPreview != null || debatePreview != null || (galleryPreview != null && galleryPreview.Items.Count > 0) || linkPreview != null || iamaPreview != null)
    {
        <div class="sn-card-preview" data-discussion-url="@baseUrl">
            @if (pollPreview != null && pollPreview.Options.Count > 0)
            {
                var totalVotes = pollPreview.TotalVotes;
                var maxToShow = Math.Min(pollPreview.Options.Count, 4);
                var sortedOptions = pollPreview.Options.OrderByDescending(o => o.VoteCount).ToList();

                @if (pollPreview.IsSecret && (pollPreview.ClosesAt == null || pollPreview.ClosesAt.ToDateTime() > DateTime.UtcNow))
                {
                    <div class="sn-poll-preview">
                        <div class="text-xs text-base-content/50">@T.Card.SecretPoll</div>
                        @if (pollPreview.ClosesAt != null && pollPreview.ClosesAt.ToDateTime() > DateTime.UtcNow)
                        {
                            <div class="sn-iama-countdown" data-countdown-to="@pollPreview.ClosesAt.ToDateTime().ToString("o")">
                                <span class="text-xs text-base-content/40">@T.Card.ClosesIn</span>
                                <span class="countdown font-mono text-sm">
                                    <span data-unit="days" style="--value:0;">0</span>d
                                    <span data-unit="hours" style="--value:0;">0</span>h
                                    <span data-unit="minutes" style="--value:0;">0</span>m
                                    <span data-unit="seconds" style="--value:0;">0</span>s
                                </span>
                            </div>
                        }
                    </div>
                }
                else
                {
                    var fpPollColors = new[] {
                            "oklch(0.55 0.15 155)", "oklch(0.62 0.13 155)",
                            "oklch(0.69 0.11 155)", "oklch(0.55 0.12 200)"
                        };
                    <div class="sn-poll-preview">
                        @for (var i = 0; i < maxToShow; i++)
                        {
                            var option = sortedOptions[i];
                            var pct = totalVotes > 0 ? (int)Math.Round(100.0 * option.VoteCount / totalVotes) : 0;
                            var barColor = fpPollColors[i % fpPollColors.Length];

                            <div class="sn-poll-option" style="--sn-poll-color: @barColor">
                                <div class="sn-poll-label">
                                    <span>@option.Text</span>
                                    <span class="sn-poll-stats">@(pct)% (@option.VoteCount)</span>
                                </div>
                                <div class="sn-poll-row">
                                    <div class="sn-poll-track">
                                        <div class="sn-poll-fill" style="width: 0" data-poll-width="@(pct)%"></div>
                                    </div>
                                </div>
                            </div>
                        }
                        @if (pollPreview.Options.Count > 4)
                        {
                            <span class="sn-poll-more">@string.Format(T.Card.MorePollOptions, pollPreview.Options.Count - 4)</span>
                        }
                    </div>
                }
            }
            @if (debatePreview != null && debatePreview.Positions.Count > 0)
            {
                var totalPosts = debatePreview.Positions.Sum(p => p.PostCount);
                var sortedPositions = debatePreview.Positions.OrderBy(p => p.Index).ToList();
                var debateColors = new[] { "var(--link-primary)", "var(--border-subtle)", "var(--text-tertiary)" };
                var debateEqualPct = (int)Math.Round(100.0 / Math.Max(1, sortedPositions.Count));

                <div class="sn-debate-preview">
                    <div class="sn-debate-bar">
                        @for (var i = 0; i < sortedPositions.Count; i++)
                        {
                            var position = sortedPositions[i];
                            var pct = totalPosts > 0 ? Math.Max(1, (int)Math.Round(100.0 * position.PostCount / totalPosts)) : (int)Math.Round(100.0 / sortedPositions.Count);
                            var color = debateColors[i % debateColors.Length];
                            var isFirst = i == 0;
                            var isLast = i == sortedPositions.Count - 1;
                            var radius = isFirst && isLast ? "0.25rem"
                                : isFirst ? "0.25rem 0 0 0.25rem"
                                : isLast ? "0 0.25rem 0.25rem 0"
                                : "0";

                            <div class="sn-debate-segment"
                                 style="width: @(debateEqualPct)%; background: @color; border-radius: @radius;"
                                 data-debate-width="@(pct)%"
                                 data-position-index="@position.Index"
                                 title="@position.Label: @(totalPosts > 0 ? (int)Math.Round(100.0 * position.PostCount / totalPosts) : 0)%">
                                @if (pct >= 15)
                                {
                                    <span>@position.Label</span>
                                }
                            </div>
                        }
                    </div>
                    <div class="sn-debate-labels">
                        @for (var i = 0; i < sortedPositions.Count; i++)
                        {
                            var position = sortedPositions[i];
                            var pct = totalPosts > 0 ? (int)Math.Round(100.0 * position.PostCount / totalPosts) : 0;
                            var color = debateColors[i % debateColors.Length];

                            <span class="sn-debate-label" data-position-index="@position.Index">
                                <span class="sn-debate-dot" style="background: @color;"></span>
                                @position.Label @(pct)%
                            </span>
                        }
                    </div>
                </div>
            }
            @if (galleryPreview != null && galleryPreview.Items.Count > 0 && !hideAdultImages)
            {
                var images = galleryPreview.Items;
                var gpLayout = galleryPreview.Layout;
                var gpSpoiler = galleryPreview.IsSpoiler || blurAdultImages;
                // Pick the best available source for the carousel slot and report its actual
                // rendered dimensions so the browser can reserve the correct box (no CLS) and
                // respect intrinsic sizing. Prefer medium; fall back to original (never the
                // 300px thumbnail, which is far too small for this slot — originals are already
                // capped at 2048px on upload).
                (string Url, int Width, int Height) bestSrcDim(Snakk.Protos.Discussion.ImagesPreviewItem img)
                {
                    if (img.HasMediumThumbnailUrl && img.HasMediumThumbnailWidth && img.HasMediumThumbnailHeight)
                        return (img.MediumThumbnailUrl, img.MediumThumbnailWidth, img.MediumThumbnailHeight);
                    return (img.Url, img.Width, img.Height);
                }
                string bestSrc(Snakk.Protos.Discussion.ImagesPreviewItem img) => bestSrcDim(img).Url;

                @if (gpLayout == "compare" && images.Count >= 2)
                {
                    var beforeImg = images[0];
                    var afterImg = images[1];
                    var (beforeSrc, beforeW, beforeH) = bestSrcDim(beforeImg);
                    var (afterSrc, afterW, afterH) = bestSrcDim(afterImg);
                    var beforeOrigW = beforeImg.Width > 0 ? beforeImg.Width : beforeW;
                    var beforeOrigH = beforeImg.Height > 0 ? beforeImg.Height : beforeH;
                    var beforeBlur = beforeImg.HasBlurDataUri ? beforeImg.BlurDataUri : "";
                    var afterBlur = afterImg.HasBlurDataUri ? afterImg.BlurDataUri : "";
                    var beforeBg = beforeImg.HasBlurDataUri ? $"background-image:url({beforeBlur});background-size:cover;background-position:center" : "";
                    var afterBg = afterImg.HasBlurDataUri ? $"background-image:url({afterBlur});background-size:cover;background-position:center" : "";
                    // Same sizing pattern as .sn-images-preview: outer is full column
                    // width with the first image's blur as a backdrop, inner frame is
                    // sized to the image's actual dimensions (capped at max-height 600px
                    // in CSS) so the blur bleed shows on sides/top-bottom when the
                    // frame is smaller than the column.
                    var compareOuterStyle = beforeImg.HasBlurDataUri ? $"--blur-bg: url({beforeBlur});" : "";
                    var compareFrameStyle = beforeOrigW > 0 && beforeOrigH > 0
                        ? $"aspect-ratio: {beforeOrigW} / {beforeOrigH}; max-width: {beforeOrigW}px;"
                        : "";

                    <div class="sn-compare-preview @(gpSpoiler ? "sn-images-spoiler" : "")" style="@compareOuterStyle" data-discussion-id="@discussion.PublicId">
                      <div class="sn-compare-frame" style="@compareFrameStyle">
                        <div class="gup-compare sn-compare-widget">
                            @{
                                var afterSrcset = SnakkImageHelper.Srcset(afterImg);
                                var beforeSrcset = SnakkImageHelper.Srcset(beforeImg);
                            }
                            <div class="gup-compare-after images-upload-item" style="@afterBg">
                                @if (gpSpoiler && afterImg.HasBlurDataUri) {
                                    <img src="@afterBlur" data-deferred-src="@afterSrc" data-full="@afterImg.Url" width="@afterW" height="@afterH" alt="After" decoding="async" loading="lazy" />
                                } else {
                                    <img src="@afterSrc"
                                         @if (afterSrcset != null) { <text>srcset="@afterSrcset" sizes="@SnakkImageHelper.DefaultSizes"</text> }
                                         data-full="@afterImg.Url" width="@afterW" height="@afterH" alt="After" decoding="async" loading="lazy" />
                                }
                                <span class="gup-compare-label gup-compare-label-after">@T.Card.After</span>
                            </div>
                            <div class="gup-compare-before images-upload-item" style="@beforeBg">
                                @if (gpSpoiler && beforeImg.HasBlurDataUri) {
                                    <img src="@beforeBlur" data-deferred-src="@beforeSrc" data-full="@beforeImg.Url" width="@beforeW" height="@beforeH" alt="Before" decoding="async" loading="lazy" />
                                } else {
                                    <img src="@beforeSrc"
                                         @if (beforeSrcset != null) { <text>srcset="@beforeSrcset" sizes="@SnakkImageHelper.DefaultSizes"</text> }
                                         data-full="@beforeImg.Url" width="@beforeW" height="@beforeH" alt="Before" decoding="async" loading="lazy" />
                                }
                                <span class="gup-compare-label gup-compare-label-before">@T.Card.Before</span>
                            </div>
                            <div class="gup-compare-slider sn-compare-slider">
                                <div class="gup-compare-line"></div>
                                <div class="gup-compare-handle">
                                    <span class="icon icon-chevron-left" style="width:20px;height:20px" aria-hidden="true"></span>
                                    <span class="icon icon-chevron-right" style="width:20px;height:20px" aria-hidden="true"></span>
                                </div>
                            </div>
                            <button type="button" class="sn-images-expand-btn" aria-label="@T.Card.ViewFullscreen">
                                <span class="icon icon-expand-fullscreen w-3.5 h-3.5" aria-hidden="true"></span>
                            </button>
                        </div>
                        @if (gpSpoiler) {
                            <div class="sn-images-spoiler-overlay">
                                <button type="button" class="images-spoiler-btn sn-spoiler-reveal">
                                    <span class="icon icon-eye w-4 h-4" aria-hidden="true"></span>
                                    @T.Card.RevealImages
                                </button>
                            </div>
                        }
                      </div>
                    </div>
                }
                else
                {
                    var (firstSrc, firstW, firstH) = bestSrcDim(images[0]);
                    var secondSrc = images.Count > 1 ? bestSrc(images[1]) : null;
                    // Outer preview is full-column-width with a blurred backdrop of the
                    // first image. The inner frame is sized to the first image's actual
                    // rendered dimensions (capped at max-height: 600px in CSS), so the
                    // blur bleed only shows on the sides or top/bottom when the frame is
                    // smaller than the column.
                    var firstBlur = images[0].HasBlurDataUri ? images[0].BlurDataUri : null;
                    var outerStyle = firstBlur != null ? $"--blur-bg: url({firstBlur});" : "";
                    var frameStyle = firstW > 0 && firstH > 0
                        ? $"aspect-ratio: {firstW} / {firstH}; max-width: {firstW}px;"
                        : "";

                    <div class="sn-images-preview @(gpSpoiler ? "sn-images-spoiler" : "")" style="@outerStyle" data-image-count="@images.Count" data-discussion-id="@discussion.PublicId">
                      <div class="sn-images-frame" style="@frameStyle">
                        <div class="sn-images-track">
                            @for (var i = 0; i < images.Count; i++)
                            {
                                var img = images[i];
                                var (src, imgW, imgH) = bestSrcDim(img);
                                var blur = img.HasBlurDataUri ? img.BlurDataUri : null;

                                <div class="sn-images-slide-wrapper" style="@(blur != null ? $"--blur:url({blur})" : "")">
                                    @if (blur != null && imgW > 0 && imgH > 0 && !gpSpoiler)
                                    {
                                        <div class="sn-images-lqip" style="aspect-ratio:@imgW/@imgH"></div>
                                    }
                                    @if (gpSpoiler && blur != null)
                                    {
                                        <img class="sn-images-slide"
                                             src="@blur"
                                             data-deferred-src="@src"
                                             data-full="@img.Url"
                                             width="@imgW" height="@imgH"
                                             alt="" decoding="async" loading="lazy" />
                                    }
                                    else if (i == 0)
                                    {
                                        var imgSrcset = SnakkImageHelper.Srcset(img);
                                        <img class="sn-images-slide"
                                             src="@src"
                                             @if (imgSrcset != null) { <text>srcset="@imgSrcset" sizes="@SnakkImageHelper.DefaultSizes"</text> }
                                             data-src="@src"
                                             data-full="@img.Url"
                                             data-loaded="1"
                                             data-blur-up
                                             width="@imgW" height="@imgH"
                                             alt="" decoding="async" loading="@(Model.IsFirst ? "eager" : "lazy")"@(Model.IsFirst ? " fetchpriority=\"high\"" : "") />
                                    }
                                    else
                                    {
                                        <img class="sn-images-slide"
                                             data-src="@src"
                                             data-full="@img.Url"
                                             data-blur-up
                                             width="@imgW" height="@imgH"
                                             alt="" decoding="async" loading="lazy" />
                                    }
                                </div>
                            }
                        </div>
                        @if (images.Count > 1)
                        {
                            <button class="sn-images-btn sn-images-prev" type="button" aria-label="@T.Card.Previous">
                                <span class="icon icon-chevron-left" aria-hidden="true"></span>
                            </button>
                            <button class="sn-images-btn sn-images-next" type="button" aria-label="@T.Card.Next"
                                    @if (secondSrc != null) { <text>data-preload="@secondSrc"</text> }>
                                <span class="icon icon-chevron-right" aria-hidden="true"></span>
                            </button>
                            <span class="sn-images-counter">1 / @images.Count</span>
                        }
                        @if (gpSpoiler)
                        {
                            <div class="sn-images-spoiler-overlay">
                                <button type="button" class="images-spoiler-btn sn-spoiler-reveal">
                                    <span class="icon icon-eye w-4 h-4" aria-hidden="true"></span>
                                    @T.Card.RevealImages
                                </button>
                            </div>
                        }
                      </div>
                      @* Expand button is a direct child of .sn-images-preview (not .sn-images-frame)
                         so it anchors to the full-column-width blur container, not the inner image frame. *@
                      <button type="button" class="sn-images-expand-btn" aria-label="@T.Card.ViewFullscreen">
                          <span class="icon icon-expand-fullscreen w-3.5 h-3.5" aria-hidden="true"></span>
                      </button>
                    </div>
                }
                @if (ViewContext.HttpContext.Items["_fp_carousel_js"] == null)
                {
                    ViewContext.HttpContext.Items["_fp_carousel_js"] = true;
                    <script src="@SnakkUrlHelper.Js("pages/images-carousel")" asp-append-version="true" defer></script>
                }
            }
            @if (iamaPreview != null)
            {
                var iamaPhaseLabel = iamaPreview.Phase switch { 0 => T.IamaPhase.Announced, 1 => T.IamaPhase.Live, 2 => T.IamaPhase.Closed, 3 => T.IamaPhase.Archived, _ => T.IamaPhase.Unknown };
                var iamaPhaseClass = iamaPreview.Phase switch { 0 => "sn-iama-phase--announced", 1 => "sn-iama-phase--live", 2 => "sn-iama-phase--closed", 3 => "sn-iama-phase--archived", _ => "" };
                DateTime? countdownTarget = null;
                if (iamaPreview.Phase == 0 && iamaPreview.ScheduledStartUtc != null)
                    countdownTarget = iamaPreview.ScheduledStartUtc.ToDateTime();
                else if (iamaPreview.Phase == 1 && iamaPreview.ScheduledEndUtc != null)
                    countdownTarget = iamaPreview.ScheduledEndUtc.ToDateTime();

                <div class="sn-iama-preview @iamaPhaseClass">
                    <div class="sn-iama-header">
                        <span class="sn-iama-phase @iamaPhaseClass">@if (iamaPreview.Phase == 1) {<span class="sn-iama-live-dot" aria-hidden="true"></span>}@iamaPhaseLabel</span>
                        @if (iamaPreview.IsVerified)
                        {
                            <span class="sn-iama-verified" title="@T.Card.Verified">
                                <span class="icon icon-verified-check w-3.5 h-3.5" aria-hidden="true"></span>
                                @T.Card.Verified
                            </span>
                        }
                        @if (iamaPreview.OfficialAnswerCount > 0)
                        {
                            <span class="sn-iama-stat">@iamaPreview.OfficialAnswerCount @(iamaPreview.OfficialAnswerCount == 1 ? T.Card.OfficialAnswerOne : T.Card.OfficialAnswerOther)</span>
                        }
                        @if (iamaPreview.BestQuestionCount > 0)
                        {
                            <span class="sn-iama-stat">@iamaPreview.BestQuestionCount @(iamaPreview.BestQuestionCount == 1 ? T.Card.BestQuestionOne : T.Card.BestQuestionOther)</span>
                        }
                        @if (countdownTarget.HasValue && countdownTarget.Value > DateTime.UtcNow)
                        {
                            <span class="sn-iama-countdown" data-countdown-to="@countdownTarget.Value.ToString("o")">
                                <span class="countdown font-mono">
                                    <span data-unit="days" style="--value:0;" aria-live="polite">0</span>d
                                    <span data-unit="hours" style="--value:0;" aria-live="polite">0</span>h
                                    <span data-unit="minutes" style="--value:0;" aria-live="polite">0</span>m
                                    <span data-unit="seconds" style="--value:0;" aria-live="polite">0</span>s
                                </span>
                            </span>
                        }
                    </div>
                </div>
            }
            @if (linkPreview != null)
            {
                var linkThumbSrc = linkPreview.HasImageThumbnailUrl ? linkPreview.ImageThumbnailUrl
                    : linkPreview.HasImagePathUrl ? linkPreview.ImagePathUrl
                    : linkPreview.HasImageUrl ? linkPreview.ImageUrl : null;
                <a href="@linkPreview.Url" target="_blank" rel="nofollow noopener noreferrer" class="sn-link-card">
                    @if (linkThumbSrc != null && !hideAdultImages)
                    {
                        var linkBlur = linkPreview.HasBlurDataUri ? linkPreview.BlurDataUri : null;
                        <div class="sn-link-card-thumb@(blurAdultImages ? " sn-link-card-thumb-adult-blur" : "")"@(linkBlur != null ? $" style=\"--blur:url({linkBlur})\"" : "") data-discussion-id="@discussion.PublicId">
                            @if (linkBlur != null)
                            {
                                <img src="@linkBlur" alt="" aria-hidden="true" class="sn-link-card-lqip" width="64" height="64" />
                            }
                            <img src="@linkThumbSrc" alt="" class="sn-link-card-img@(blurAdultImages ? " sn-link-card-img-adult-blur" : "")" width="64" height="64" loading="lazy" decoding="async" data-blur-up />
                            @if (blurAdultImages)
                            {
                                <div class="sn-link-card-adult-overlay" data-discussion-id="@discussion.PublicId">
                                    <span class="icon icon-eye w-4 h-4" aria-hidden="true"></span>
                                    <span>@T.Settings.AdultPreviewBlurReveal</span>
                                </div>
                            }
                            <span class="sn-link-card-chain-badge">
                                <span class="icon icon-link-chain" aria-hidden="true"></span>
                            </span>
                        </div>
                    }
                    else
                    {
                        <div class="sn-link-card-thumb sn-link-card-thumb--empty" aria-hidden="true">
                            <span class="icon icon-link-chain"></span>
                        </div>
                    }
                    <div class="sn-link-card-content">
                        @if (linkPreview.HasTitle)
                        {
                            <span class="sn-link-card-title">@linkPreview.Title</span>
                        }
                        @if (linkPreview.HasDescription)
                        {
                            <span class="sn-link-card-desc">@linkPreview.Description</span>
                        }
                        <span class="sn-link-card-domain">
                            <span class="icon icon-external-link w-2.5 h-2.5" aria-hidden="true"></span>
                            @(linkPreview.HasDomain ? linkPreview.Domain : linkPreview.Url)
                        </span>
                    </div>
                </a>
            }
        </div>
    }

    <div data-reply-strip>
    @if (discussion.PostCount > 1 && discussion.LastReplier != null)
    {
        var isOp = discussion.LastReplier.PublicId == discussion.Author.PublicId;
        var rawExcerpt = discussion.LastPostExcerpt;
        var excerpt = rawExcerpt?.Length > 100 ? rawExcerpt[..100] + "…" : rawExcerpt;
        <div class="sn-card-reply-strip">
            <a href="@baseUrl#post-@discussion.PostCount" class="sn-card-reply-strip-link" aria-label="@T.Card.JumpToLastReply" tabindex="-1"></a>
            <div class="sn-card-reply-meta">
                @if (!string.IsNullOrEmpty(excerpt))
                {
                    <span class="icon icon-chat-bubble-filled" style="width:1rem;height:1rem" aria-hidden="true"></span>
                    <span class="sn-card-reply-excerpt">"@excerpt"</span>
                    <span class="sn-card-dot">&middot;</span>
                }
                else
                {
                    <span class="icon icon-photograph" style="width:1rem;height:1rem" aria-hidden="true"></span>
                    <span class="sn-card-reply-excerpt opacity-40 italic">@T.Card.ImageOnly</span>
                    <span class="sn-card-dot">&middot;</span>
                }
                <div class="tooltip tooltip-top" data-tip="@T.Card.RepliedAt @FormatFullDateTime(discussion.LastActivityAt?.ToDateTime())">
                    <time class="sn-card-reply-time">@FormatRelativeTime(discussion.LastActivityAt?.ToDateTime())</time>
                </div>
                <img src="@discussion.LastReplier.AvatarMicroUrl" alt="" class="sn-card-reply-avatar" width="16" height="16" loading="lazy" decoding="async" />
                @if (string.IsNullOrEmpty(discussion.LastReplier.PublicId))
                {
                    <span class="sn-card-reply-username">@T.Card.DeletedUser</span>
                }
                else
                {
                    <a href="@SnakkUrlHelper.UserProfile(discussion.LastReplier.PublicId)"
                       class="sn-card-reply-username"
                       data-popup-type="user"
                       data-popup-id="@discussion.LastReplier.PublicId"
                       data-popup-name="@discussion.LastReplier.DisplayName">@discussion.LastReplier.DisplayName</a>
                }
                @if (isOp) { <span class="sn-card-op-badge">OP</span> }
            </div>
        </div>
    }
    </div>
    @if (Model.UnfollowId != null)
    {
        <div class="sn-card-stats">
            <button type="button" class="btn btn-ghost btn-xs ml-auto shrink-0"
                    data-unfollow-type="discussion" data-unfollow-id="@Model.UnfollowId"
                    title="@T.Card.Unsubscribe">
                @T.Card.Subscribed
            </button>
        </div>
    }
</article>
@if (!ViewContext.HttpContext.Items.ContainsKey("iama-countdown-loaded"))
{
    ViewContext.HttpContext.Items["iama-countdown-loaded"] = true;
    <script src="@SnakkUrlHelper.Js("components/iama-countdown")" asp-append-version="true" defer></script>
}
@if (!ViewContext.HttpContext.Items.ContainsKey("card-animations-loaded"))
{
    ViewContext.HttpContext.Items["card-animations-loaded"] = true;
    <script src="@SnakkUrlHelper.Js("components/card-animations")" asp-append-version="true" defer></script>
}
