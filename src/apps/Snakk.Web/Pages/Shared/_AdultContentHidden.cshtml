@* Shown when adult content is hidden because the user previously declined *@
<div class="sn-adult-hidden-container">
    <div class="sn-clean-card">
        <div class="sn-adult-hidden-body">
            <span class="sn-icon icon-eye-slash h-12 w-12 sn-mx-auto sn-text-faint" aria-hidden="true"></span>

            <h2 class="sn-text-lg sn-font-bold">@T.Adult.HiddenTitle</h2>

            <p class="sn-text-sm sn-text-muted">
                @T.Adult.HiddenBody
            </p>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <a href="/my/settings/notifications#section-adult-content" class="sn-btn sn-btn-primary sn-btn-sm">
                    @T.Adult.HiddenSettingsLink
                </a>
            }
            else
            {
                <a href="/" class="sn-btn sn-btn-ghost sn-btn-sm">@T.Common.GoBack</a>
            }
        </div>
    </div>
</div>
