@{
    var title = ViewData["AuthPrompt.Title"] as string ?? T.AuthPrompt.DefaultTitle;
    var message = ViewData["AuthPrompt.Message"] as string ?? T.AuthPrompt.DefaultMessage;
    var returnUrl = ViewData["AuthPrompt.ReturnUrl"] as string ?? ViewContext.HttpContext.Request.Path.Value ?? "";
    var loginUrl = $"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    var registerUrl = $"/auth/register?returnUrl={Uri.EscapeDataString(returnUrl)}";
}
<div class="sn-clean-card sn-p-8 sn-text-center sn-max-w-sm sn-mx-auto mt-8">
    <img src="/img/logo-square.webp" alt="" width="64" height="64" class="sn-mx-auto sn-mb-4 opacity-15" />
    <h3 class="sn-font-semibold sn-mb-1" style="color: var(--text-primary)">@title</h3>
    <p class="sn-text-sm mb-5" style="color: var(--text-secondary)">@message</p>
    <div class="sn-auth-prompt-actions">
        <a href="@loginUrl" class="sn-btn sn-btn-primary sn-btn-sm">@T.Nudge.LogIn</a>
        <span style="color: var(--text-tertiary)">@T.Nudge.Or</span>
        <a href="@registerUrl" class="sn-btn sn-btn-ghost sn-btn-sm">@T.AuthPrompt.SignUp</a>
    </div>
</div>
