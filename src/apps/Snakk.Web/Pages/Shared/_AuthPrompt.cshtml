@{
    var title = ViewData["AuthPrompt.Title"] as string ?? "Sign in to continue";
    var message = ViewData["AuthPrompt.Message"] as string ?? "Log in or create an account to access this page.";
    var returnUrl = ViewData["AuthPrompt.ReturnUrl"] as string ?? ViewContext.HttpContext.Request.Path.Value ?? "";
    var loginUrl = $"/auth/login?returnUrl={Uri.EscapeDataString(returnUrl)}";
    var registerUrl = $"/auth/register?returnUrl={Uri.EscapeDataString(returnUrl)}";
}
<div class="clean-card p-8 text-center max-w-sm mx-auto mt-8">
    <img src="/img/logo-square.webp" alt="" width="64" height="64" class="mx-auto mb-4 opacity-15" />
    <h3 class="font-semibold mb-1" style="color: var(--text-primary)">@title</h3>
    <p class="text-sm mb-5" style="color: var(--text-secondary)">@message</p>
    <div class="flex items-center justify-center gap-3">
        <a href="@loginUrl" class="btn btn-primary btn-sm">Log in</a>
        <span style="color: var(--text-tertiary)">or</span>
        <a href="@registerUrl" class="btn btn-ghost btn-sm">Sign up</a>
    </div>
</div>
