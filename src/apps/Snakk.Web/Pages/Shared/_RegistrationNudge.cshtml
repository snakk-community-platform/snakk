@using Microsoft.Extensions.Options
@using Snakk.Web.Services
@inject IOptions<OAuthProvidersOptions> OAuthOptions
@{
    var oauth = OAuthOptions.Value;
    var title      = ViewData["Nudge.Title"]     as string ?? "Join the conversation";
    var body       = ViewData["Nudge.Body"]      as string ?? "Create a free account to participate.";
    var returnPath = ViewData["Nudge.ReturnUrl"] as string
                     ?? ViewContext.HttpContext.Request.Path.Value ?? "/";
    var returnUrl   = Uri.EscapeDataString(returnPath);
    var loginUrl    = $"/auth/login?returnUrl={returnUrl}";
    var registerUrl = $"/auth/register?returnUrl={returnUrl}";
    var googleUrl   = $"/auth/oauth/Google/challenge?returnUrl={returnUrl}";
    var githubUrl   = $"/auth/oauth/GitHub/challenge?returnUrl={returnUrl}";
    var discordUrl  = $"/auth/oauth/Discord/challenge?returnUrl={returnUrl}";
}
<div class="fp-registration-nudge clean-card">
    <div class="fp-nudge-icon">
        <span class="icon icon-lock-closed w-6 h-6" aria-hidden="true"></span>
    </div>
    <h3 class="fp-nudge-title">@title</h3>
    <p class="fp-nudge-body">@body</p>

    @if (oauth.HasAny)
    {
        <div class="fp-nudge-oauth">
            @if (oauth.Google)
            {
                <a href="@googleUrl" class="fp-nudge-oauth-btn" hx-boost="false">
                    <span class="icon icon-brand-google w-4 h-4" aria-hidden="true"></span>
                    Continue with Google
                </a>
            }
            @if (oauth.GitHub)
            {
                <a href="@githubUrl" class="fp-nudge-oauth-btn" hx-boost="false">
                    <span class="icon icon-brand-github w-4 h-4" aria-hidden="true"></span>
                    Continue with GitHub
                </a>
            }
            @if (oauth.Discord)
            {
                <a href="@discordUrl" class="fp-nudge-oauth-btn" hx-boost="false">
                    <span class="icon icon-brand-discord w-4 h-4" aria-hidden="true"></span>
                    Continue with Discord
                </a>
            }
        </div>
        <div class="fp-nudge-divider"><span>or</span></div>
    }

    <a href="@registerUrl" class="btn btn-primary btn-sm w-full" hx-boost="false">Sign up with email</a>
    <p class="fp-nudge-login-link">
        Already have an account? <a href="@loginUrl" hx-boost="false">Log in</a>
    </p>
</div>
