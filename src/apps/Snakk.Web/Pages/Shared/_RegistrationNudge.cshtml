@using Microsoft.Extensions.Options
@using Snakk.Web.Services
@inject IOptions<OAuthProvidersOptions> OAuthOptions
@{
    var oauth = OAuthOptions.Value;
    var title      = ViewData["Nudge.Title"]     as string ?? T.Nudge.Title;
    var body       = ViewData["Nudge.Body"]      as string ?? T.Nudge.Body;
    var returnPath = ViewData["Nudge.ReturnUrl"] as string
                     ?? ViewContext.HttpContext.Request.Path.Value ?? "/";
    var returnUrl   = Uri.EscapeDataString(returnPath);
    var loginUrl    = $"/auth/login?returnUrl={returnUrl}";
    var registerUrl = $"/auth/register?returnUrl={returnUrl}";
    var googleUrl   = $"/auth/oauth/Google/challenge?returnUrl={returnUrl}";
    var githubUrl   = $"/auth/oauth/GitHub/challenge?returnUrl={returnUrl}";
    var discordUrl  = $"/auth/oauth/Discord/challenge?returnUrl={returnUrl}";
}
<div class="sn-registration-nudge clean-card">
    <div class="sn-nudge-icon">
        <span class="icon icon-lock-closed w-6 h-6" aria-hidden="true"></span>
    </div>
    <h3 class="sn-nudge-title">@title</h3>
    <p class="sn-nudge-body">@body</p>

    <div class="sn-nudge-oauth">
        @if (oauth.Google)
        {
            <a href="@googleUrl" class="sn-nudge-oauth-btn" hx-boost="false">
                <span class="icon icon-brand-google w-4 h-4" aria-hidden="true"></span>
                @T.Nudge.ContinueGoogle
            </a>
        }
        @if (oauth.GitHub)
        {
            <a href="@githubUrl" class="sn-nudge-oauth-btn" hx-boost="false">
                <span class="icon icon-brand-github w-4 h-4" aria-hidden="true"></span>
                @T.Nudge.ContinueGitHub
            </a>
        }
        @if (oauth.Discord)
        {
            <a href="@discordUrl" class="sn-nudge-oauth-btn" hx-boost="false">
                <span class="icon icon-brand-discord w-4 h-4" aria-hidden="true"></span>
                @T.Nudge.ContinueDiscord
            </a>
        }
        <button type="button" class="sn-nudge-oauth-btn" style="display:none"
                data-nudge-passkey data-return-url="@returnPath">
            <span class="icon icon-finger-print w-4 h-4" aria-hidden="true"></span>
            @T.Nudge.ContinuePasskey
        </button>
    </div>
    <p id="nudge-passkey-error" class="text-sm text-error hidden mt-1"></p>
    <div class="sn-nudge-divider" id="nudge-alt-divider"@(oauth.HasAny ? "" : " style=\"display:none\"")><span>@T.Nudge.Or</span></div>

    <a href="@registerUrl" class="btn btn-primary btn-sm w-full" hx-boost="false">@T.Nudge.SignUpEmail</a>
    <p class="sn-nudge-login-link">
        @T.Nudge.AlreadyAccount <a href="@loginUrl" hx-boost="false">@T.Nudge.LogIn</a>
    </p>
</div>
