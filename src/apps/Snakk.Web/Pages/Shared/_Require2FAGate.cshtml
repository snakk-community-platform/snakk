@* 2FA required interstitial — shown when a space/hub/community requires 2FA and the visitor doesn't have it enabled *@
@{
    var returnUrl = ViewBag.ReturnUrl as string ?? Context.Request.Path + Context.Request.QueryString;
}

<div class="sn-gate-page-container mt-16">
    <div class="sn-clean-card">
        <div class="sn-gate-card-body---require2fagate">
            <span class="icon icon-lock-closed h-12 sn-w-12 sn-mx-auto sn-text-warning" aria-hidden="true"></span>

            <h2 class="sn-text-lg sn-font-bold">@T.Require2fa.Title</h2>

            <p class="sn-text-sm sn-text-muted">
                @T.Require2fa.Body
            </p>

            <div class="sn-gate-actions---require2fagate">
                @if (User.Identity?.IsAuthenticated == true)
                {
                    <a href="/my/settings/privacy?returnUrl=@Uri.EscapeDataString(returnUrl)"
                       class="sn-btn sn-btn-primary sn-btn-sm sn-w-full">
                        @T.Require2fa.CtaSetup
                    </a>
                }
                else
                {
                    <a href="/auth/login?returnUrl=@Uri.EscapeDataString(returnUrl)"
                       class="sn-btn sn-btn-primary sn-btn-sm sn-w-full">
                        @T.Require2fa.CtaLogin
                    </a>
                }
            </div>
        </div>
    </div>
</div>
