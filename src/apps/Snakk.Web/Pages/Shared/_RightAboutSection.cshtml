@{
    var title    = ViewData["RightPane.AboutTitle"] as string;
    var desc     = ViewData["RightPane.AboutDescription"] as string;
    var linkText = ViewData["RightPane.AboutLinkText"] as string;
    var linkUrl  = ViewData["RightPane.AboutLinkUrl"] as string;
    if (string.IsNullOrEmpty(title)) return;
}
<div class="sn-right-section">
    <div class="sn-right-title">
        <span class="icon icon-info-circle" aria-hidden="true"></span>
        @title
    </div>
    @if (!string.IsNullOrEmpty(desc))
    {
        <p class="text-sm" style="color: var(--text-secondary)">@desc</p>
    }
    @if (!string.IsNullOrEmpty(linkText) && !string.IsNullOrEmpty(linkUrl))
    {
        <a href="@linkUrl" class="btn btn-outline btn-sm w-full mt-3">@linkText</a>
    }
</div>
