@* Adult content interstitial — shown when accessing adult-only content without opt-in *@
@{
    var returnUrl = ViewBag.ReturnUrl as string ?? Context.Request.Path + Context.Request.QueryString;
}

<div class="max-w-lg mx-auto mt-16 px-4">
    <div class="clean-card">
        <div class="p-8 text-center space-y-4">
            <span class="icon icon-exclamation-triangle h-12 w-12 mx-auto text-warning" aria-hidden="true"></span>

            <h2 class="text-lg font-bold">Adult Content</h2>

            <p class="text-sm text-base-content/60">
                This content has been marked as adults only. You must confirm that you are at least 18 years old to continue.
            </p>

            <div class="flex flex-col gap-2 pt-2">
                <form method="post" action="/bff/adult-confirm">
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="btn btn-primary btn-sm w-full">
                        I am 18 or older — continue
                    </button>
                </form>

                <a href="/" class="btn btn-ghost btn-sm">Go back</a>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <p class="text-xs text-base-content/40 pt-2">
                    You can enable "Show adult content" in <a href="/settings#section-behavior" class="underline">Settings</a> to skip this prompt.
                </p>
            }
        </div>
    </div>
</div>
