@* Adult content interstitial — shown when accessing adult content without an opt-in/out decision *@
@{
    var returnUrl = ViewBag.ReturnUrl as string ?? Context.Request.Path + Context.Request.QueryString;
}

<div class="sn-gate-page-wrapper mt-16">
    <div class="sn-clean-card">
        <div class="sn-gate-card-body">
            <span class="sn-icon icon-exclamation-triangle h-12 w-12 sn-mx-auto sn-text-warning" aria-hidden="true"></span>

            <h2 class="sn-text-lg sn-font-bold">@T.Adult.Title</h2>

            <p class="sn-text-sm sn-text-muted">
                @T.Adult.Body
            </p>

            <div class="sn-gate-actions">
                <form method="post" action="/bff/adult-consent" hx-boost="false">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="sn-btn sn-btn-primary sn-btn-sm sn-w-full">
                        @T.Adult.Confirm
                    </button>
                </form>

                <form method="post" action="/bff/adult-decline" hx-boost="false">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="returnUrl" value="@returnUrl" />
                    <button type="submit" class="sn-btn sn-btn-ghost sn-btn-sm sn-w-full">
                        @T.Adult.Decline
                    </button>
                </form>
            </div>

            @if (User.Identity?.IsAuthenticated == true)
            {
                <p class="sn-gate-hint">
                    @T.Adult.SettingsHintBefore<a href="/my/settings/notifications#section-adult-content" class="underline">@T.Adult.SettingsHintLink</a>@T.Adult.SettingsHintAfter
                </p>
            }
        </div>
    </div>
</div>
