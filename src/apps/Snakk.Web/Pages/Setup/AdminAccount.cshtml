@page
@model Snakk.Web.Pages.Setup.AdminAccountModel

<h2 class="text-xl font-semibold mb-4">Admin Account</h2>
<p class="text-base-content/70 mb-6">Create the first administrator account. This user will have full GlobalAdmin access.</p>

<form method="post" class="space-y-4">
    <div class="form-control">
        <label class="label"><span class="label-text">Email</span></label>
        <input type="email" asp-for="AdminEmail" class="input input-bordered" placeholder="admin@example.com" />
        <span asp-validation-for="AdminEmail" class="text-error text-sm"></span>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Display Name</span></label>
        <input type="text" asp-for="AdminDisplayName" class="input input-bordered" placeholder="Admin" />
        <span asp-validation-for="AdminDisplayName" class="text-error text-sm"></span>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Password</span></label>
        <input type="password" asp-for="AdminPassword" class="input input-bordered" placeholder="Minimum 8 characters" />
        <span asp-validation-for="AdminPassword" class="text-error text-sm"></span>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Confirm Password</span></label>
        <input type="password" asp-for="ConfirmPassword" class="input input-bordered" />
        <span asp-validation-for="ConfirmPassword" class="text-error text-sm"></span>
    </div>

    <div class="divider"></div>

    <div class="flex justify-between">
        <a asp-page="Storage" class="btn btn-ghost">Back</a>
        <button type="submit" class="btn btn-primary">Next</button>
    </div>
</form>
