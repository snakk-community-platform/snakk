@page
@model Snakk.Web.Pages.Setup.InstallModel

<div id="installing" class="text-center space-y-6">
    <div class="text-5xl">
        <span id="status-icon" class="loading loading-spinner loading-lg text-primary"></span>
    </div>
    <h2 id="status-title" class="text-2xl font-bold">Installing Snakk...</h2>
    <p id="status-message" class="text-base-content/70">Writing configuration and setting up the database. This may take a moment.</p>

    <div id="progress-steps" class="text-left max-w-sm mx-auto space-y-2 mt-6">
        <div id="step-config" class="flex items-center gap-2 text-base-content/50">
            <span class="loading loading-spinner loading-xs"></span>
            <span>Writing configuration...</span>
        </div>
        <div id="step-database" class="flex items-center gap-2 text-base-content/30">
            <span class="w-4 h-4 inline-block"></span>
            <span>Running database migrations...</span>
        </div>
        <div id="step-admin" class="flex items-center gap-2 text-base-content/30">
            <span class="w-4 h-4 inline-block"></span>
            <span>Creating admin account...</span>
        </div>
        <div id="step-complete" class="flex items-center gap-2 text-base-content/30">
            <span class="w-4 h-4 inline-block"></span>
            <span>Finalizing setup...</span>
        </div>
    </div>

    <!-- Error display (hidden by default) -->
    <div id="error-display" class="hidden">
        <div class="alert alert-error text-left">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
                <h3 class="font-bold">Installation Failed</h3>
                <p id="error-message" class="text-sm"></p>
            </div>
        </div>
        <a asp-page="Review" class="btn btn-ghost mt-4">Back to Review</a>
    </div>

    <!-- Success display (hidden by default) -->
    <div id="success-display" class="hidden space-y-4">
        <div class="alert alert-success">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M9 12l2 2 4-4m6 2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <span>Setup complete! Your Snakk instance is ready.</span>
        </div>
        <p class="text-base-content/70">
            Services need to restart to apply the new configuration.
            You'll be redirected to the homepage in <span id="countdown">5</span> seconds.
        </p>
        <p class="text-sm text-base-content/50">
            You've been automatically logged in as admin. If the page doesn't load after redirect,
            services may still be restarting — just refresh after a few seconds.
        </p>
    </div>
</div>

<script>
    (function () {
        'use strict';

        // Simulate progress steps visually
        function markStep(id, status) {
            var el = document.getElementById(id);
            if (!el) return;
            var icon = el.querySelector('span:first-child');
            if (status === 'active') {
                el.className = 'flex items-center gap-2 text-base-content';
                icon.className = 'loading loading-spinner loading-xs';
                icon.textContent = '';
            } else if (status === 'done') {
                el.className = 'flex items-center gap-2 text-success';
                icon.className = 'w-4 h-4 inline-block';
                icon.textContent = '\u2713';
            } else if (status === 'error') {
                el.className = 'flex items-center gap-2 text-error';
                icon.className = 'w-4 h-4 inline-block';
                icon.textContent = '\u2717';
            }
        }

        async function runInstall() {
            markStep('step-config', 'active');

            try {
                var token = document.querySelector('input[name="__RequestVerificationToken"]');
                var formData = new FormData();
                if (token) formData.append('__RequestVerificationToken', token.value);

                // Simulate progress (the server does all steps in one call)
                setTimeout(function () { markStep('step-config', 'done'); markStep('step-database', 'active'); }, 1000);
                setTimeout(function () { markStep('step-database', 'done'); markStep('step-admin', 'active'); }, 3000);

                var res = await fetch('/setup/install', {
                    method: 'POST',
                    body: formData
                });
                var text = await res.text();
                if (!res.ok) {
                    throw new Error('Server returned ' + res.status + ': ' + (text.substring(0, 500) || '(empty response)'));
                }
                if (!text) {
                    throw new Error('Server returned empty response (status ' + res.status + ')');
                }
                var data;
                try { data = JSON.parse(text); } catch (e) {
                    throw new Error('Invalid JSON (status ' + res.status + '): ' + text.substring(0, 500));
                }

                if (data.success) {
                    markStep('step-config', 'done');
                    markStep('step-database', 'done');
                    markStep('step-admin', 'done');
                    markStep('step-complete', 'done');

                    document.getElementById('status-icon').className = 'text-5xl';
                    document.getElementById('status-icon').textContent = '\u2705';
                    document.getElementById('status-title').textContent = 'Setup Complete!';
                    document.getElementById('status-message').classList.add('hidden');
                    document.getElementById('progress-steps').classList.add('hidden');
                    document.getElementById('success-display').classList.remove('hidden');

                    // Countdown and redirect
                    var count = 5;
                    var countdownEl = document.getElementById('countdown');
                    var interval = setInterval(function () {
                        count--;
                        countdownEl.textContent = count;
                        if (count <= 0) {
                            clearInterval(interval);
                            window.location.href = '/';
                        }
                    }, 1000);
                } else {
                    // Mark failed step
                    if (data.step === 'database') {
                        markStep('step-config', 'done');
                        markStep('step-database', 'error');
                    } else {
                        markStep('step-config', 'error');
                    }

                    document.getElementById('status-icon').className = 'text-5xl';
                    document.getElementById('status-icon').textContent = '\u274C';
                    document.getElementById('status-title').textContent = 'Installation Failed';
                    document.getElementById('status-message').classList.add('hidden');
                    document.getElementById('progress-steps').classList.add('hidden');
                    document.getElementById('error-message').textContent = data.error || 'An unknown error occurred.';
                    document.getElementById('error-display').classList.remove('hidden');
                }
            } catch (e) {
                document.getElementById('status-icon').className = 'text-5xl';
                document.getElementById('status-icon').textContent = '\u274C';
                document.getElementById('status-title').textContent = 'Installation Failed';
                document.getElementById('status-message').classList.add('hidden');
                document.getElementById('progress-steps').classList.add('hidden');
                document.getElementById('error-message').textContent = e.message;
                document.getElementById('error-display').classList.remove('hidden');
            }
        }

        // Start installation immediately on page load
        runInstall();
    })();
</script>

<!-- Hidden anti-forgery token for the AJAX POST -->
<form id="install-form" style="display:none">
    @Html.AntiForgeryToken()
</form>
