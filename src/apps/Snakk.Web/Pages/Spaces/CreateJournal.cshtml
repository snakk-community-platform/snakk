@page "/create/journal"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewJournalModel
@{
    Layout = "~/Pages/Shared/_NewDiscussionLayout.cshtml";
    ViewData["Title"] = string.Format(T.Pages.SpacesNewJournalTitlePattern, Model.Space?.Name);
    ViewData["NewDiscussion.Crumb"]       = T.Pages.SpacesNewJournalCrumb;
    ViewData["NewDiscussion.Heading"]     = T.Pages.SpacesNewJournalHeading;
    ViewData["NewDiscussion.TitlePh"]     = T.Pages.SpacesNewJournalTitlePh;
    ViewData["NewDiscussion.SubmitLabel"] = T.Pages.SpacesNewJournalSubmit;
}

@section ExtraStyles {
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("type-journal")" asp-append-version="true" />
}

<div class="mt-8 border-t border-base-content/10 pt-6">
    <h3 class="text-sm font-semibold mb-3 text-base-content/70">@T.Pages.SpacesNewJournalHowHeading</h3>
    <div class="text-sm text-base-content/60 space-y-3">
        <p>@T.Pages.SpacesNewJournalIntro</p>
        <div>
            <div class="font-medium text-base-content/70 mb-1">@T.Pages.SpacesNewAfterYouPost</div>
            <ul class="space-y-1 list-disc pl-4">
                <li>@T.Pages.SpacesNewJournalAfter1</li>
                <li>@T.Pages.SpacesNewJournalAfter2</li>
                <li>@T.Pages.SpacesNewJournalAfter3</li>
                <li>@T.Pages.SpacesNewJournalAfter4</li>
            </ul>
        </div>
        <div>
            <div class="font-medium text-base-content/70 mb-1">@T.Pages.SpacesNewJournalGreatLabel</div>
            <ul class="space-y-1 list-disc pl-4">
                <li>@T.Pages.SpacesNewJournalGreat1</li>
                <li>@T.Pages.SpacesNewJournalGreat2</li>
                <li>@T.Pages.SpacesNewJournalGreat3</li>
                <li>@T.Pages.SpacesNewJournalGreat4</li>
                <li>@T.Pages.SpacesNewJournalGreat5</li>
            </ul>
        </div>
    </div>
</div>
