@page "/c/{communitySlug}/h/{hubSlug}/{slug}/rules"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.Spaces.RulesModel
@{
    ViewData["Title"] = string.Format(T.Pages.SpaceRulesTitlePattern, Model.Space?.Name);
    ViewData["Description"] = string.Format(T.Pages.SpaceRulesDescPattern, Model.Space?.Name);
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@section CenterHeader {
    @if (Model.Space != null && Model.Hub != null)
    {
        @if (Model.ShowCommunityInBreadcrumb && Model.CommunityDetail != null)
        {
            <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)" class="badge badge-ghost badge-sm">@Model.CommunityDetail.Name</a>
            <span class="sn-page-labels-sep">›</span>
        }
        <a href="@SnakkUrlHelper.Hub(Model.Community, Model.Hub.Slug)" class="badge badge-ghost badge-sm">@Model.Hub.Name</a>
        <span class="sn-page-labels-sep">›</span>
        <a href="@SnakkUrlHelper.Space(Model.Community, Model.Hub.Slug, Model.Space.Slug)" class="badge badge-ghost badge-sm">@Model.Space.Name</a>
    }
}

@if (Model.Space == null || Model.Hub == null)
{
    <div class="sn-center">
        <div class="sn-center-inner">
            <div class="py-12 text-center text-sm" style="color: var(--text-tertiary)">
                <p>@T.Pages.SpaceModsNotFound</p>
                <a href="/" class="btn btn-primary btn-sm mt-4">@T.Pages.SpaceModsBackToHome</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="sn-center">
        <div class="sn-center-inner">
            <h2 class="sn-section-title">
                <span class="icon icon-shield-check" aria-hidden="true"></span>
                @Model.Space.Name@T.Pages.SpaceRulesHeadingSuffix
            </h2>
            @if (!string.IsNullOrEmpty(Model.Space.Description))
            {
                <p class="text-sm mb-6" style="color: var(--text-secondary)">@Model.Space.Description</p>
            }
            else
            {
                <div class="mb-6"></div>
            }

            @if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
            {
                <p class="text-sm" style="color: var(--text-tertiary)">@T.Pages.SpaceRulesEmpty</p>
            }
            else
            {
                <div class="flex flex-col gap-6">
                    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
                    {
                        <div class="flex gap-4 items-start">
                            <span class="text-5xl font-black leading-none select-none shrink-0 w-14 text-right" style="color: var(--text-primary); opacity: 0.08">@(index + 1)</span>
                            <div class="pt-1 min-w-0">
                                <p class="text-sm font-semibold mb-1" style="color: var(--text-primary)">@rule.Title</p>
                                <p class="text-sm" style="color: var(--text-secondary)">@rule.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="mt-6 pt-4" style="border-top: 1px solid var(--border-secondary)">
                <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--text-tertiary)">@T.Pages.SpaceModsSeeAlso</p>
                @if (Model.Hub.HasRules)
                {
                    <a href="@SnakkUrlHelper.Hub(Model.Community, Model.Hub.Slug)/rules"
                       class="flex items-center justify-between py-1.5 text-sm hover:text-primary transition-colors" style="color: var(--text-secondary)">
                        <span>@Model.Hub.Name@T.Pages.SpaceRulesHubSuffix</span>
                        <span class="icon icon-chevron-right w-3.5 h-3.5" aria-hidden="true"></span>
                    </a>
                }
                @if (Model.Community.IsMultiCommunityEnabled && Model.Hub.ParentCommunityHasRules && Model.CommunityDetail != null)
                {
                    <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)/rules"
                       class="flex items-center justify-between py-1.5 text-sm hover:text-primary transition-colors" style="color: var(--text-secondary)">
                        <span>@Model.CommunityDetail.Name@T.Pages.SpaceRulesCommunitySuffix</span>
                        <span class="icon icon-chevron-right w-3.5 h-3.5" aria-hidden="true"></span>
                    </a>
                }
                <a href="/rules" class="flex items-center justify-between py-1.5 text-sm hover:text-primary transition-colors" style="color: var(--text-secondary)">
                    <span>@T.Pages.SpaceRulesSite</span>
                    <span class="icon icon-chevron-right w-3.5 h-3.5" aria-hidden="true"></span>
                </a>
            </div>
        </div>
    </div>

<aside class="sn-right">
<div class="sn-right-sticky">
    <div class="sn-right-section"
         hx-get="/partials/platform-stats?scopeType=platform&scopeId=global"
         hx-trigger="load"
         hx-target="this"
         hx-swap="innerHTML">
        <div class="sn-right-title">
            <span class="icon icon-chart-bar" aria-hidden="true"></span>
            @T.Pages.SpaceModsSiteStats
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-16"></div></div>
            <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-10"></div></div>
        </div>
    </div>

    <div class="sn-right-section"
         hx-get="/partials/trending-discussions?scopeType=platform&scopeId=global"
         hx-trigger="load"
         hx-target="this"
         hx-swap="innerHTML">
        <div class="sn-right-title">
            <span class="icon icon-trending-up" aria-hidden="true"></span>
            @T.Pages.SpaceModsTrending
        </div>
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
        </div>
    </div>
</div>
</aside>
}
