@page "/c/{communitySlug}/h/{hubSlug}/{slug}/rules"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.Spaces.RulesModel
@{
    ViewData["Title"] = $"{Model.Space?.Name} Space Rules";
    ViewData["Description"] = $"Rules and guidelines for the {Model.Space?.Name} space.";
}

@if (Model.Space == null || Model.Hub == null)
{
    <div class="max-w-xl mx-auto px-4 py-8">
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>Space not found</h3>
                <p>This space may have been removed or the link might be incorrect.</p>
                <a href="/hubs" class="btn btn-primary btn-sm mt-4">Back to Hubs</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="breadcrumb-bar">
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span class="breadcrumb-separator">/</span>
            @if (Model.ShowCommunityInBreadcrumb && Model.CommunityDetail != null)
            {
                <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)">@Model.CommunityDetail.Name</a>
                <span class="breadcrumb-separator">/</span>
            }
            <a href="@SnakkUrlHelper.Hub(Model.Community, Model.Hub.Slug)">@Model.Hub.Name</a>
            <span class="breadcrumb-separator">/</span>
            <a href="@SnakkUrlHelper.Space(Model.Community, Model.Hub.Slug, Model.Space.Slug)">@Model.Space.Name</a>
            <span class="breadcrumb-separator">/</span>
            <span>Rules</span>
        </nav>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-8">
        <div class="page-header">
            <h1>@Model.Space.Name Rules</h1>
            @if (!string.IsNullOrEmpty(Model.Space.Description))
            {
                <p>@Model.Space.Description</p>
            }
        </div>

        <div class="clean-card p-6">
            @if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
            {
                <div class="empty-state-simple">
                    <p>No rules have been defined for this space yet.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col divide-y divide-base-200">
                    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
                    {
                        <div class="py-3 first:pt-0 last:pb-0">
                            <p class="text-sm font-medium mb-1">@(index + 1). @rule.Title</p>
                            <p class="text-sm text-base-content/70 pl-4">@rule.Description</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="clean-card p-4 mt-4">
            <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">See also</p>
            <div class="flex flex-col">
                @if (Model.Hub.HasRules)
                {
                    <a href="@SnakkUrlHelper.Hub(Model.Community, Model.Hub.Slug)/rules"
                       class="flex items-center justify-between py-1.5 text-sm hover:text-primary transition-colors">
                        <span>@Model.Hub.Name Hub Rules</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                }
                @if (Model.Hub.ParentCommunityHasRules && Model.CommunityDetail != null)
                {
                    <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)/rules"
                       class="flex items-center justify-between py-1.5 text-sm hover:text-primary transition-colors">
                        <span>@Model.CommunityDetail.Name Community Rules</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                }
                <a href="/rules" class="flex items-center justify-between py-1.5 text-sm hover:text-primary transition-colors">
                    <span>Site Rules</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </div>
}
