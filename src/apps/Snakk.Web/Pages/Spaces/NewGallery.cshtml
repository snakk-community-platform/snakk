@page "/new/gallery"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewGalleryModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"New Images — {Model.Space?.Name}";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@if (Model.Space == null) { <div class="empty-state-simple"><h3>Space not found</h3></div> return; }

<div class="fp-center">
    <div class="breadcrumb-bar">
        <nav class="breadcrumb">
            <a href="/">Home</a>
            @if (Model.ShowCommunityInBreadcrumb) { <span class="breadcrumb-separator">/</span><a href="/c/@Model.CommunitySlug">@(Model.CommunityDetail?.Name ?? Model.CommunitySlug)</a> }
            <span class="breadcrumb-separator">/</span>
            <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)">@(Model.Hub?.Name ?? Model.HubSlug)</a>
            <span class="breadcrumb-separator">/</span>
            <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug)">@Model.Space.Name</a>
            <span class="breadcrumb-separator">/</span>
            <a href="/new?spaceId=@Model.SpaceId">New</a>
            <span class="breadcrumb-separator">/</span>
            <span>Images</span>
        </nav>
    </div>
    <div class="fp-center-inner">
        <div class="max-w-3xl py-8">
            <h1 class="text-xl font-semibold mb-6">New Images</h1>

            @if (!string.IsNullOrEmpty(Model.CreateError)) { <div class="alert alert-error text-sm mb-4">@Model.CreateError</div> }

            <form method="post" id="new-discussion-form" hx-boost="false">
                <input type="hidden" name="SpaceId" value="@Model.SpaceId" />
                <div class="space-y-4">
                    <input type="text" name="NewTitle" id="new-discussion-title" value="@Model.NewTitle"
                           class="input w-full text-lg" required maxlength="200" placeholder="Images title" autofocus />

                    <!-- Layout picker (hidden until 2+ images) -->
                    <div id="images-layout-section" class="images-layout-section images-layout-section-hidden">
                        <div class="text-sm font-medium mb-2">Layout</div>
                        <div class="flex gap-3" id="images-layout-picker">
                            <label class="images-layout-option images-layout-active" data-layout="masonry">
                                <input type="radio" name="ImagesLayout" value="masonry" checked class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-masonry"><div></div><div></div><div></div></div>
                                </div>
                                <span class="text-xs mt-1">Masonry</span>
                            </label>
                            <label class="images-layout-option" data-layout="grid">
                                <input type="radio" name="ImagesLayout" value="grid" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-grid"><div></div><div></div><div></div><div></div></div>
                                </div>
                                <span class="text-xs mt-1">Grid</span>
                            </label>
                            <label class="images-layout-option" data-layout="justified">
                                <input type="radio" name="ImagesLayout" value="justified" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-justified"><div></div><div></div><div></div></div>
                                </div>
                                <span class="text-xs mt-1">Justified</span>
                            </label>
                            <label class="images-layout-option" data-layout="carousel">
                                <input type="radio" name="ImagesLayout" value="carousel" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-carousel"><span>&#8249;</span><div></div><span>&#8250;</span></div>
                                </div>
                                <span class="text-xs mt-1">Carousel</span>
                            </label>
                            <label class="images-layout-option" data-layout="hero">
                                <input type="radio" name="ImagesLayout" value="hero" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-hero"><div class="glp-hero-big"></div><div class="glp-hero-row"><div></div><div></div><div></div></div></div>
                                </div>
                                <span class="text-xs mt-1">Hero</span>
                            </label>
                            <label class="images-layout-option" data-layout="compare" id="images-layout-compare" style="display:none">
                                <input type="radio" name="ImagesLayout" value="compare" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-compare"><div></div><div class="glp-compare-line"></div><div></div></div>
                                </div>
                                <span class="text-xs mt-1">Compare</span>
                            </label>
                        </div>
                        <div id="images-layout-hint" class="images-layout-hint hidden">You can now choose a layout</div>
                    </div>

                    <!-- Image upload area + live preview -->
                    <div>
                        <div class="text-sm font-medium mb-2">Images</div>

                        <!-- Live preview (hidden when empty, switches between grid/carousel) -->
                        <div id="images-preview" class="images-upload-preview hidden"></div>

                        <!-- Drop zone -->
                        <div id="images-drop-zone" class="gallery-drop-zone">
                            <input type="file" id="images-file-input" accept="image/*" multiple class="hidden" />
                            <div class="gallery-drop-zone-content">
                                <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-base-content/30 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                </svg>
                                <span class="text-sm text-base-content/50">Click or drag images here</span>
                                <span class="text-xs text-base-content/30 mt-1">JPEG, PNG, GIF, WebP — max 5MB each</span>
                            </div>
                        </div>

                        <!-- Hidden inputs container (populated by JS) -->
                        <div id="images-hidden-inputs"></div>
                    </div>

                    <!-- Spoiler toggle -->
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" name="ImagesIsSpoiler" value="true" class="toggle toggle-primary toggle-sm" />
                        <span>
                            <span class="font-medium text-sm">Spoiler</span>
                            <span class="block text-xs text-base-content/50">Images are blurred until the viewer clicks to reveal them.</span>
                        </span>
                    </label>

                    <!-- Description editor -->
                    <div>
                        <div class="text-sm font-medium mb-2">Description (optional)</div>
                        <textarea name="NewContent" id="new-discussion-content" style="display:none">@Model.NewContent</textarea>

                        <div id="editor-container" data-hide-image="true" data-placeholder="Add captions or context for your images...">
                            <div class="editor-skeleton"><div class="editor-skeleton-toolbar"><div class="skeleton-pill"></div><div class="skeleton-pill"></div><div class="skeleton-pill"></div></div><div class="editor-skeleton-body" style="min-height:150px"><div class="skeleton-line w-3/4"></div><div class="skeleton-line w-1/2"></div></div></div>
                        </div>
                    </div>

                    <div class="flex items-center justify-between">
                        <a href="/new?spaceId=@Model.SpaceId" class="btn btn-ghost btn-sm">Back</a>
                        <button type="submit" id="new-discussion-submit" class="btn btn-primary btn-sm hidden">Create Images</button>
                    </div>
                </div>
            </form>

            <div class="mt-8 border-t border-base-content/10 pt-6">
                <h3 class="text-sm font-semibold mb-3 text-base-content/70">How images work</h3>
                <div class="text-sm text-base-content/60 space-y-3">
                    <p>Upload images and see a live preview in your chosen layout. Switch between grid and carousel at any time.</p>
                    <div>
                        <div class="font-medium text-base-content/70 mb-1">After you post</div>
                        <ul class="space-y-1 list-disc pl-4">
                            <li>Images display in your chosen layout</li>
                            <li>Others can reply and discuss your images</li>
                        </ul>
                    </div>
                    <div>
                        <div class="font-medium text-base-content/70 mb-1">Tips</div>
                        <ul class="space-y-1 list-disc pl-4">
                            <li>Drag and drop multiple images at once</li>
                            <li>Supported: JPEG, PNG, GIF, WebP — max 5MB each</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="@SnakkUrlHelper.Js("components/markdown-editor")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/new-discussion")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/gallery-upload")" asp-append-version="true" defer></script>
