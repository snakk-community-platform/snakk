@page "/new/gallery"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewGalleryModel
@{
    Layout = "_Layout";
    ViewData["Title"] = string.Format(T.Pages.SpacesNewGalleryTitlePattern, Model.Space?.Name);
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@section CenterHeader {
    @if (Model.ShowCommunityInBreadcrumb)
    {
        <a href="/c/@Model.CommunitySlug" class="badge badge-ghost badge-sm">@(Model.CommunityDetail?.Name ?? Model.CommunitySlug)</a>
        <span class="sn-page-labels-sep">›</span>
    }
    @if (Model.Space != null)
    {
        <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)" class="badge badge-ghost badge-sm">@(Model.Hub?.Name ?? Model.HubSlug)</a>
        <span class="sn-page-labels-sep">›</span>
        <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug)" class="badge badge-ghost badge-sm">@Model.Space.Name</a>
        <span class="sn-page-labels-sep">›</span>
        <a href="/new?spaceId=@Model.SpaceId" class="badge badge-ghost badge-sm">@T.Pages.SpacesNewCrumbNew</a>
        <span class="sn-page-labels-sep">›</span>
        <span class="badge badge-ghost badge-sm">@T.Pages.SpacesNewGalleryCrumb</span>
    }
}

@if (User.Identity?.IsAuthenticated != true) {
    { ViewData["AuthPrompt.Title"] = T.Pages.SpacesNewAuthPrompt; }
    <div class="sn-center"><div class="sn-center-inner"><partial name="Shared/_AuthPrompt" /></div></div>
    return;
}
@if (Model.Space == null) { <div class="empty-state-simple"><h3>@T.Pages.SpacesNewSpaceNotFound</h3></div> return; }

<div class="sn-center">
    <div class="sn-center-inner">
        <div class="max-w-3xl py-8">
            <h1 class="text-xl font-semibold mb-6">@T.Pages.SpacesNewGalleryHeading</h1>

            @if (!string.IsNullOrEmpty(Model.CreateError)) { <div class="alert alert-error text-sm mb-4">@Model.CreateError</div> }

            <form method="post" id="new-discussion-form" hx-boost="false">
                <input type="hidden" name="SpaceId" value="@Model.SpaceId" />
                <div class="space-y-4">
                    <input type="text" name="NewTitle" id="new-discussion-title" value="@Model.NewTitle"
                           class="input w-full text-lg" required maxlength="200" placeholder="@T.Pages.SpacesNewGalleryTitlePh" autofocus />

                    <!-- Layout picker (hidden until 2+ images) -->
                    <div id="images-layout-section" class="images-layout-section images-layout-section-hidden">
                        <div class="text-sm font-medium mb-2">@T.Pages.SpacesNewGalleryLayoutLabel</div>
                        <div class="flex flex-wrap gap-3" id="images-layout-picker">
                            <label class="images-layout-option images-layout-active" data-layout="masonry">
                                <input type="radio" name="ImagesLayout" value="masonry" checked class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-masonry"><div></div><div></div><div></div></div>
                                </div>
                                <span class="text-xs mt-1">@T.Pages.SpacesNewGalleryMasonry</span>
                            </label>
                            <label class="images-layout-option" data-layout="grid">
                                <input type="radio" name="ImagesLayout" value="grid" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-grid"><div></div><div></div><div></div><div></div></div>
                                </div>
                                <span class="text-xs mt-1">@T.Pages.SpacesNewGalleryGrid</span>
                            </label>
                            <label class="images-layout-option" data-layout="justified">
                                <input type="radio" name="ImagesLayout" value="justified" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-justified"><div></div><div></div><div></div></div>
                                </div>
                                <span class="text-xs mt-1">@T.Pages.SpacesNewGalleryJustified</span>
                            </label>
                            <label class="images-layout-option" data-layout="carousel">
                                <input type="radio" name="ImagesLayout" value="carousel" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-carousel"><span>&#8249;</span><div></div><span>&#8250;</span></div>
                                </div>
                                <span class="text-xs mt-1">@T.Pages.SpacesNewGalleryCarousel</span>
                            </label>
                            <label class="images-layout-option" data-layout="hero">
                                <input type="radio" name="ImagesLayout" value="hero" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-hero"><div class="glp-hero-big"></div><div class="glp-hero-row"><div></div><div></div><div></div></div></div>
                                </div>
                                <span class="text-xs mt-1">@T.Pages.SpacesNewGalleryHero</span>
                            </label>
                            <label class="images-layout-option" data-layout="compare" id="images-layout-compare" style="display:none">
                                <input type="radio" name="ImagesLayout" value="compare" class="hidden" />
                                <div class="images-layout-preview">
                                    <div class="glp glp-compare"><div></div><div class="glp-compare-line"></div><div></div></div>
                                </div>
                                <span class="text-xs mt-1">@T.Pages.SpacesNewGalleryCompare</span>
                            </label>
                        </div>
                        <div id="images-layout-hint" class="images-layout-hint hidden">@T.Pages.SpacesNewGalleryLayoutHint</div>
                    </div>

                    <!-- Image upload area + live preview -->
                    <div>
                        <div class="text-sm font-medium mb-2">@T.Pages.SpacesNewGalleryImagesLabel</div>

                        <!-- Live preview (hidden when empty, switches between grid/carousel) -->
                        <div id="images-preview" class="images-upload-preview hidden"></div>

                        <!-- Drop zone -->
                        <div id="images-drop-zone" class="gallery-drop-zone">
                            <input type="file" id="images-file-input" accept="image/*" multiple class="hidden" />
                            <div class="gallery-drop-zone-content">
                                <span class="icon icon-photograph h-8 w-8 text-base-content/30 mb-2" aria-hidden="true"></span>
                                <span class="text-sm text-base-content/50">@T.Pages.SpacesNewGalleryDropText</span>
                                <span class="text-xs text-base-content/30 mt-1">@T.Pages.SpacesNewGalleryDropHint</span>
                            </div>
                        </div>

                        <span id="images-count" class="text-xs text-base-content/40 mt-1 block"></span>

                        <!-- Hidden inputs container (populated by JS) -->
                        <div id="images-hidden-inputs"></div>
                    </div>

                    <!-- Spoiler toggle -->
                    <label class="flex items-center gap-3 cursor-pointer">
                        <input type="checkbox" name="ImagesIsSpoiler" value="true" class="toggle toggle-primary toggle-sm" />
                        <span>
                            <span class="font-medium text-sm">@T.Pages.SpacesNewGallerySpoiler</span>
                            <span class="block text-xs text-base-content/50">@T.Pages.SpacesNewGallerySpoilerDesc</span>
                        </span>
                    </label>

                    <!-- Description editor -->
                    <div>
                        <div class="text-sm font-medium mb-2">@T.Pages.SpacesNewGalleryDescLabel</div>
                        <textarea name="NewContent" id="new-discussion-content" style="display:none">@Model.NewContent</textarea>

                        <div id="editor-container" data-hide-image="true" data-placeholder="@T.Pages.SpacesNewGalleryEditorPh">
                            <div class="editor-skeleton"><div class="editor-skeleton-toolbar"><div class="skeleton-pill"></div><div class="skeleton-pill"></div><div class="skeleton-pill"></div></div><div class="editor-skeleton-body" style="min-height:150px"><div class="skeleton-line w-3/4"></div><div class="skeleton-line w-1/2"></div></div></div>
                        </div>
                    </div>

                    <partial name="_NewDiscussionAdultToggle" model="Model.Space" />

                    <div class="flex items-center justify-between">
                        <a href="/new?spaceId=@Model.SpaceId" class="btn btn-ghost btn-sm">@T.Pages.SpacesNewBack</a>
                        <button type="submit" id="new-discussion-submit" class="btn btn-primary btn-sm hidden">@T.Pages.SpacesNewGallerySubmit</button>
                    </div>
                </div>
            </form>

            <div class="mt-8 border-t border-base-content/10 pt-6">
                <h3 class="text-sm font-semibold mb-3 text-base-content/70">@T.Pages.SpacesNewGalleryHowHeading</h3>
                <div class="text-sm text-base-content/60 space-y-3">
                    <p>@T.Pages.SpacesNewGalleryIntro</p>
                    <div>
                        <div class="font-medium text-base-content/70 mb-1">@T.Pages.SpacesNewAfterYouPost</div>
                        <ul class="space-y-1 list-disc pl-4">
                            <li>@T.Pages.SpacesNewGalleryAfter1</li>
                            <li>@T.Pages.SpacesNewGalleryAfter2</li>
                        </ul>
                    </div>
                    <div>
                        <div class="font-medium text-base-content/70 mb-1">@T.Pages.SpacesNewTips</div>
                        <ul class="space-y-1 list-disc pl-4">
                            <li>@T.Pages.SpacesNewGalleryTip1</li>
                            <li>@T.Pages.SpacesNewGalleryTip2</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Shared/_NewDiscussionSpaceSidebar" model="Model" />

<script src="@SnakkUrlHelper.Js("components/markdown-editor")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/new-discussion")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/gallery-upload")" asp-append-version="true" defer></script>
