@page "/create/debate"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewDebateModel
@{
    Layout = "~/Pages/Shared/_NewDiscussionLayout.cshtml";
    ViewData["Title"] = string.Format(T.Pages.SpacesNewDebateTitlePattern, Model.Space?.Name);
    ViewData["NewDiscussion.Crumb"]        = T.Pages.SpacesNewDebateCrumb;
    ViewData["NewDiscussion.Heading"]      = T.Pages.SpacesNewDebateHeading;
    ViewData["NewDiscussion.TitlePh"]      = T.Pages.SpacesNewDebateTitlePh;
    ViewData["NewDiscussion.SubmitLabel"]  = T.Pages.SpacesNewDebateSubmit;
    ViewData["NewDiscussion.EditorHeight"] = "150px";
}

@section ExtraFormFields {
    <!-- Debate positions -->
    <div class="sn-space-y-3">
        <div class="sn-text-sm sn-font-medium">@T.Pages.SpacesNewDebatePositionsLabel</div>
        <div id="debate-positions-list" class="sn-space-y-2">
            <input type="text" name="DebatePositions" class="sn-input sn-w-full sn-input-sm" placeholder="@T.Pages.SpacesNewDebatePosition1Ph" />
            <input type="text" name="DebatePositions" class="sn-input sn-w-full sn-input-sm" placeholder="@T.Pages.SpacesNewDebatePosition2Ph" />
        </div>
        <button type="button" id="add-debate-position-btn" class="sn-btn sn-btn-ghost sn-btn-xs" data-action="add-debate-position">@T.Pages.SpacesNewDebateAddPosition</button>

        <label class="sn-checkbox-label">
            <input type="checkbox" name="DebateAllowNeutral" value="true" class="sn-checkbox sn-checkbox-sm" />
            @T.Pages.SpacesNewDebateNeutral
        </label>
    </div>
}

@section EditorContainer {
    <textarea name="NewContent" id="new-discussion-content" style="display:none">@Model.NewContent</textarea>
    <div id="editor-container" data-hide-image="true" data-placeholder="@T.Pages.SpacesNewDebateEditorPh">
        <div class="sn-editor-skeleton"><div class="sn-editor-skeleton-toolbar"><div class="sn-skeleton-pill"></div><div class="sn-skeleton-pill"></div><div class="sn-skeleton-pill"></div></div><div class="sn-editor-skeleton-body" style="min-height:150px"><div class="sn-skeleton-line w-3/4"></div><div class="sn-skeleton-line w-1/2"></div></div></div>
    </div>
}

@section ExtraScripts {
    <script src="@SnakkUrlHelper.Js("pages/new-debate")" asp-append-version="true" defer></script>
}

<div class="sn-mt-8 sn-border-t sn-border sn-pt-6">
    <h3 class="sn-section-label--createdebate">@T.Pages.SpacesNewDebateHowHeading</h3>
    <div class="sn-text-sm sn-text-muted sn-space-y-3">
        <p>@T.Pages.SpacesNewDebateIntro</p>
        <div>
            <div class="sn-debate-subsection-label">@T.Pages.SpacesNewAfterYouPost</div>
            <ul class="sn-space-y-1 list-disc sn-pl-4">
                <li>@T.Pages.SpacesNewDebateAfter1</li>
                <li>@T.Pages.SpacesNewDebateAfter2</li>
                <li>@T.Pages.SpacesNewDebateAfter3</li>
                <li>@T.Pages.SpacesNewDebateAfter4</li>
                <li>@T.Pages.SpacesNewDebateAfter5</li>
            </ul>
        </div>
        <div>
            <div class="sn-debate-subsection-label">@T.Pages.SpacesNewDebateFairLabel</div>
            <ul class="sn-space-y-1 list-disc sn-pl-4">
                <li>@T.Pages.SpacesNewDebateFair1</li>
                <li>@T.Pages.SpacesNewDebateFair2</li>
                <li>@T.Pages.SpacesNewDebateFair3</li>
                <li>@T.Pages.SpacesNewDebateFair4</li>
            </ul>
        </div>
    </div>
</div>

