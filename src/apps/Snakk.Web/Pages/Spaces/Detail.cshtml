@page "/h/{hubSlug}/{slug}"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.Spaces.DetailModel
@{
    ViewData["Title"] = Model.Space?.Name ?? "Space";
}

@if (Model.Space == null)
{
    <div class="max-w-xl mx-auto">
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>Space not found</h3>
                <p>This space may have been removed or the link might be incorrect.</p>
                <a href="/hubs" class="btn btn-primary btn-sm mt-4">Back to Hubs</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="breadcrumb-bar">
        <nav class="breadcrumb">
            <a href="/">Home</a>
            @if (Model.ShowCommunityInBreadcrumb)
            {
                <span class="breadcrumb-separator">/</span>
                <a href="/communities">Communities</a>
                <span class="breadcrumb-separator">/</span>
                <a href="/c/@Model.Community.CommunitySlug">@(Model.Community.CommunityName ?? Model.Community.CommunitySlug)</a>
            }
            <span class="breadcrumb-separator">/</span>
            <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)"
               data-popup-type="hub"
               data-popup-id="@Model.Hub?.PublicId"
               data-popup-name="@Model.Hub?.Name">@(Model.Hub?.Name ?? Model.HubSlug)</a>
        </nav>
    </div>
    <div class="max-w-6xl mx-auto px-4 py-8">
        <!-- Two Column Layout -->
        <div class="flex flex-col lg:flex-row gap-6">
            <!-- Left Column: Discussions -->
            <div class="flex-1 min-w-0">
                <!-- Space Header -->
                <div class="page-header">
                    <div class="flex items-start gap-4">
                        <img src="@SnakkUrlHelper.SpaceAvatar(Model.Space.PublicId)" alt="" width="64" height="64" class="w-16 h-16 rounded-full flex-shrink-0" />
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h1>@Model.Space.Name</h1>
                                @if (Model.IsAuthenticated && !string.IsNullOrEmpty(Model.Community.CommunitySlug))
                                {
                                    <a href="@SnakkUrlHelper.ManageSpace(Model.Community, Model.HubSlug, Model.Space.Slug)"
                                       class="btn btn-ghost btn-sm" title="Manage space">
                                        <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                            <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                                            <circle cx="12" cy="12" r="3"></circle>
                                        </svg>
                                    </a>
                                }
                                @if (Model.IsAuthenticated)
                                {
                                    <!-- Follow Button Group -->
                                    <div id="follow-group" class="flex items-center ml-auto">
                                        <button id="follow-toggle-btn"
                                                onclick="toggleFollowSpace('@Model.Space.PublicId')"
                                                class="btn btn-ghost btn-sm rounded-r-none border-r-0 follow-btn">
                                            <svg id="follow-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                                            </svg>
                                            <span id="follow-text">Follow</span>
                                        </button>
                                        <div id="level-toggle" class="btn-group hidden">
                                            <button id="level-discussions-btn"
                                                    onclick="setFollowLevel('DiscussionsOnly')"
                                                    class="btn btn-sm btn-primary rounded-none text-xs px-2">
                                                Discussions
                                            </button>
                                            <button id="level-posts-btn"
                                                    onclick="setFollowLevel('DiscussionsAndPosts')"
                                                    class="btn btn-sm btn-ghost rounded-l-none text-xs px-2">
                                                +Posts
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Space.Description))
                            {
                                <p>@Model.Space.Description</p>
                            }
                        </div>
                    </div>
                </div>
                <div class="section-header">
                    <span class="section-title">Discussions</span>
                </div>

                @if (Model.Discussions?.Items == null || !Model.Discussions.Items.Any())
                {
                    <div class="clean-card">
                        <div class="empty-state-simple py-12">
                            <h3>No discussions yet</h3>
                            <p>Be the first to start a conversation in this space!</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="topic-list" id="discussions-container">
                        @foreach (var discussion in Model.Discussions.Items)
                        {
                            <partial name="Shared/_SpaceDiscussionListItem"
                                     model="new SpaceDiscussionListItemVM(discussion, Model.Community, Model.HubSlug, Model.Slug)" />
                        }

                        @if (Model.PreferEndlessScroll && Model.Discussions.HasMoreItems)
                        {
                            var nextOffset = Model.Discussions.Offset + Model.Discussions.PageSize;

                            <div hx-get="/partials/space-discussions?spaceId=@Model.Space.PublicId&hubSlug=@Model.HubSlug&spaceSlug=@Model.Slug&offset=@nextOffset&pageSize=20"
                                 hx-trigger="revealed"
                                 hx-swap="outerHTML"
                                 hx-target="this"
                                 hx-push-url="false"
                                 class="py-1">
                                <div class="topic-item-wrapper">
                                    <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                    <div class="topic-item flex-1">
                                        <div class="skeleton h-4 w-3/4 mb-2"></div>
                                        <div class="skeleton h-3 w-1/2"></div>
                                    </div>
                                </div>
                                <div class="topic-item-wrapper">
                                    <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                    <div class="topic-item flex-1">
                                        <div class="skeleton h-4 w-2/3 mb-2"></div>
                                        <div class="skeleton h-3 w-2/5"></div>
                                    </div>
                                </div>
                                <div class="topic-item-wrapper">
                                    <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                    <div class="topic-item flex-1">
                                        <div class="skeleton h-4 w-4/5 mb-2"></div>
                                        <div class="skeleton h-3 w-1/3"></div>
                                    </div>
                                </div>
                            </div>
                        }
                        else if (Model.PreferEndlessScroll)
                        {
                            <div class="text-center py-8 text-base-content/50 text-sm">
                                You've reached the end
                            </div>
                        }
                    </div>

                    @if (!Model.PreferEndlessScroll && (Model.Discussions.Offset > 0 || Model.Discussions.HasMoreItems))
                    {
                        <div class="flex justify-center gap-2 mt-8">
                            @if (Model.Discussions.Offset > 0)
                            {
                                <a href="@SnakkUrlHelper.SpaceWithOffset(Model.Community, Model.HubSlug, Model.Slug, Math.Max(0, Model.Discussions.Offset - Model.Discussions.PageSize))"
                                   class="btn btn-ghost btn-sm">
                                    Previous
                                </a>
                            }
                            @if (Model.Discussions.HasMoreItems)
                            {
                                <a href="@SnakkUrlHelper.SpaceWithOffset(Model.Community, Model.HubSlug, Model.Slug, Model.Discussions.Offset + Model.Discussions.PageSize)"
                                   class="btn btn-ghost btn-sm">
                                    Next
                                </a>
                            }
                        </div>
                    }
                }
            </div>

            <!-- Right Column: Sidebar -->
            <aside id="sticky-sidebar" class="w-full lg:w-80 flex-shrink-0" hx-boost="false">
                <!-- Space Info -->
                @if (Model.Space != null)
                {
                    <div class="sidebar-section">
                        <h3 class="sidebar-title">About this Space</h3>
                        @if (!string.IsNullOrEmpty(Model.Space.Description))
                        {
                            <p class="text-sm text-base-content/70 mb-3">@Model.Space.Description</p>
                        }
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <div class="text-lg font-semibold">@FormatCount(Model.Space.DiscussionCount)</div>
                                <div class="text-xs text-base-content/50">Discussions</div>
                            </div>
                            <div>
                                <div class="text-lg font-semibold">@FormatCount(Model.Space.ReplyCount)</div>
                                <div class="text-xs text-base-content/50">Replies</div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Rules -->
                @if (Model.Space?.HasRules == true)
                {
                    <div class="sidebar-section">
                        <h3 class="sidebar-title">Rules</h3>
                        <inline-or-htmx partial="Shared/Sidebar/_SpaceRules"
                                         model="Model.InlineSpaceRules"
                                         htmx-url="/partials/space-rules?spaceId=@Model.Space.PublicId&hubSlug=@Model.HubSlug&communitySlug=@(Model.Community.CommunitySlug ?? "")&parentHubHasRules=@Model.Space.ParentHubHasRules&parentCommunityHasRules=@Model.Space.ParentCommunityHasRules&rev=@Model.Space.RulesRevision">
                            <div class="flex flex-col gap-2">
                                <div class="skeleton h-4 w-full"></div>
                                <div class="skeleton h-4 w-5/6"></div>
                                <div class="skeleton h-4 w-4/6"></div>
                            </div>
                        </inline-or-htmx>
                    </div>
                }

                @if (Model.ShowTrendingDiscussions)
                {
                    <div class="sidebar-section">
                        <h3 class="sidebar-title">Trending Discussions</h3>
                        <inline-or-htmx partial="Shared/Sidebar/_TrendingDiscussions"
                                         model="Model.InlineTrendingDiscussions"
                                         htmx-url="/partials/trending-discussions?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                            <div class="flex flex-col gap-3">
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                            </div>
                        </inline-or-htmx>
                    </div>
                }

                @if (Model.ShowTrendingContributors)
                {
                    <div class="sidebar-section">
                        <h3 class="sidebar-title">Trending Contributors</h3>
                        <inline-or-htmx partial="Shared/Sidebar/_TrendingContributors"
                                         model="Model.InlineTrendingContributors"
                                         htmx-url="/partials/trending-contributors?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                            <div class="flex flex-col gap-3">
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                            </div>
                        </inline-or-htmx>
                    </div>
                }
            </aside>
        </div>
    </div>

@section Styles {
}

@section Scripts {
    @* INLINE REASON: Server-side configuration for follow button functionality.
       Values are page-specific and only known at render time. Cannot be in external .js files.
       Endless scroll is now handled by HTMX (hx-trigger="revealed"). *@
    <script>
    window.SnakkConfig = {
        communityPrefix: '@SnakkUrlHelper.CommunityPrefix(Model.Community)',
        space: {
            publicId: '@Model.Space.PublicId',
            hubSlug: '@Model.HubSlug',
            slug: '@Model.Slug'
        }
    };
    </script>
    <script src="@SnakkUrlHelper.Js("core/utils")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("pages/space-detail")" asp-append-version="true" defer></script>
    }
}
