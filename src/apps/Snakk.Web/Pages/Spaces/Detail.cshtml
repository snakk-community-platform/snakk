@page "/c/{communitySlug}/h/{hubSlug}/{slug}"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@using static Snakk.Web.Helpers.DiscussionTypeHelper
@model Snakk.Web.Pages.Spaces.DetailModel
@{
    ViewData["Title"] = Model.Space?.Name ?? "Space";
    ViewData["Description"] = Model.Space is { IsRestricted: false }
        ? $"{Model.Space.Name} — discussions and topics in this space on Snakk."
        : null;

    if (Model.Space is not null)
    {
        ViewData["RssFeedUrl"] = $"/c/{Model.Community.CommunitySlug}/h/{Model.HubSlug}/{Model.Slug}/feed.xml";
        ViewData["RssFeedTitle"] = $"{Model.Space.Name} — RSS Feed";
    }
}

@section Meta {
    @if (Model.Space is { IsRestricted: false })
    {
        var scheme = ViewContext.HttpContext.Request.Scheme;
        var host = ViewContext.HttpContext.Request.Host.ToString();
        var path = ViewContext.HttpContext.Request.Path.ToString();
        var url = $"{scheme}://{host}{path}";

        <link rel="alternate" type="application/json+oembed"
              href="/oembed?url=@Uri.EscapeDataString(url)"
              title="@Html.Encode(Model.Space.Name)" />
    }
}

@if (Model.Space == null)
{
    <div class="max-w-xl mx-auto">
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>Space not found</h3>
                <p>This space may have been removed or the link might be incorrect.</p>
                <a href="/hubs" class="btn btn-primary btn-sm mt-4">Back to Hubs</a>
            </div>
        </div>
    </div>
}
else
{
    <!-- Realtime context — JS reads these to subscribe to the correct groups -->
    <div id="page-context" data-space-id="@Model.Space.PublicId" data-hub-id="@Model.Hub?.PublicId" data-hub-slug="@Model.HubSlug" data-space-slug="@Model.Slug" hidden></div>

    <div class="breadcrumb-bar">
        <nav class="breadcrumb">
            <a href="/">Home</a>
            @if (Model.ShowCommunityInBreadcrumb)
            {
                <span class="breadcrumb-separator">/</span>
                <a href="/communities">Communities</a>
                <span class="breadcrumb-separator">/</span>
                <a href="/c/@Model.Community.CommunitySlug"
                   data-popup-type="community"
                   data-popup-id="@Model.CommunityDetail?.PublicId"
                   data-popup-name="@(Model.Community.CommunityName ?? Model.Community.CommunitySlug)">@(Model.Community.CommunityName ?? Model.Community.CommunitySlug)</a>
            }
            <span class="breadcrumb-separator">/</span>
            <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)"
               data-popup-type="hub"
               data-popup-id="@Model.Hub?.PublicId"
               data-popup-name="@Model.Hub?.Name">@(Model.Hub?.Name ?? Model.HubSlug)</a>
        </nav>
    </div>
    <div class="max-w-[90rem] mx-auto px-4 py-8">
        <!-- Two Column Layout -->
        <div class="flex flex-col lg:flex-row gap-3">
            <!-- Left Column: Discussions -->
            <div class="flex-1 min-w-0">
                <!-- Space Header -->
                <div class="page-header">
                    <div class="flex items-start gap-4">
                        <img src="@SnakkUrlHelper.SpaceAvatar(Model.Space.PublicId)" alt="" width="64" height="64" class="w-16 h-16 rounded-full shrink-0" />
                        <div class="flex-1 min-w-0">
                            <div class="flex items-center gap-2 flex-wrap">
                                <h1>@Model.Space.Name</h1>
                                <a href="/c/@(Model.Community.CommunitySlug)/h/@(Model.HubSlug)/@(Model.Slug)/feed.xml"
                                   class="btn btn-ghost btn-sm btn-square" title="RSS Feed" target="_blank" rel="noopener">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-orange-500" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
                                    </svg>
                                </a>
                                @if (Model.IsAuthenticated)
                                {
                                    <!-- Follow Button Group -->
                                    <div id="follow-group" class="flex items-center ml-auto">
                                        <button id="follow-toggle-btn"
                                                data-action="toggle-follow-space" data-space-id="@Model.Space.PublicId"
                                                class="btn btn-ghost btn-sm rounded-r-none border-r-0 follow-btn">
                                            <svg id="follow-icon" xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 mr-1" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M15 17h5l-1.405-1.405A2.032 2.032 0 0118 14.158V11a6.002 6.002 0 00-4-5.659V5a2 2 0 10-4 0v.341C7.67 6.165 6 8.388 6 11v3.159c0 .538-.214 1.055-.595 1.436L4 17h5m6 0v1a3 3 0 11-6 0v-1m6 0H9" />
                                            </svg>
                                            <span id="follow-text">Follow</span>
                                        </button>
                                        <div id="level-toggle" class="btn-group hidden">
                                            <button id="level-discussions-btn"
                                                    data-action="set-follow-level" data-level="DiscussionsOnly"
                                                    class="btn btn-sm btn-primary rounded-none text-xs px-2">
                                                Discussions
                                            </button>
                                            <button id="level-posts-btn"
                                                    data-action="set-follow-level" data-level="DiscussionsAndPosts"
                                                    class="btn btn-sm btn-ghost rounded-l-none text-xs px-2">
                                                +Posts
                                            </button>
                                        </div>
                                    </div>
                                }
                            </div>
                            @if (!string.IsNullOrEmpty(Model.Space.Description))
                            {
                                <p>@Model.Space.Description</p>
                            }
                        </div>
                        @if (Model.IsAuthenticated && !string.IsNullOrEmpty(Model.Community.CommunitySlug))
                        {
                            <a href="@SnakkUrlHelper.ManageSpace(Model.Community, Model.HubSlug, Model.Space.Slug)"
                               class="btn btn-primary btn-sm shrink-0" hx-boost="false">
                                <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                                    <circle cx="12" cy="12" r="3"></circle>
                                </svg>
                                Manage
                            </a>
                        }
                    </div>
                </div>

                <partial name="_Banners" model="Model.Banners?.Banners" />

                <div class="section-header flex items-center justify-between">
                    <span class="section-title">Discussions</span>
                    @if (Model.IsAuthenticated)
                    {
                        <a href="@SnakkUrlHelper.NewDiscussion(Model.Community, Model.HubSlug, Model.Slug)"
                           class="btn btn-primary btn-sm">
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4" />
                            </svg>
                            New Discussion
                        </a>
                    }
                </div>

                @if (Model.Discussions?.Items == null || !Model.Discussions.Items.Any())
                {
                    <div class="clean-card">
                        <div class="empty-state-simple py-12">
                            <h3>No discussions yet</h3>
                            <p>Be the first to start a conversation in this space!</p>
                        </div>
                    </div>
                }
                else
                {
                    <div class="topic-list h-feed" id="discussions-container">
                        @foreach (var discussion in Model.Discussions.Items)
                        {
                            <partial name="Shared/_SpaceDiscussionListItem"
                                     model="new SpaceDiscussionListItemVM(discussion, Model.Community, Model.HubSlug, Model.Slug)" />
                        }

                        @if (Model.Discussions.HasMoreItems)
                        {
                            var nextOffset = Model.Discussions.Offset + Model.Discussions.PageSize;

                            <div hx-get="/partials/space-discussions?spaceId=@Model.Space.PublicId&hubSlug=@Model.HubSlug&spaceSlug=@Model.Slug&offset=@nextOffset&pageSize=20"
                                 hx-trigger="revealed"
                                 hx-swap="outerHTML"
                                 hx-target="this"
                                 hx-push-url="false"
                                 class="py-1">
                                <div class="topic-item-wrapper">
                                    <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                    <div class="topic-item flex-1">
                                        <div class="skeleton h-4 w-3/4 mb-2"></div>
                                        <div class="skeleton h-3 w-1/2"></div>
                                    </div>
                                </div>
                                <div class="topic-item-wrapper">
                                    <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                    <div class="topic-item flex-1">
                                        <div class="skeleton h-4 w-2/3 mb-2"></div>
                                        <div class="skeleton h-3 w-2/5"></div>
                                    </div>
                                </div>
                                <div class="topic-item-wrapper">
                                    <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                    <div class="topic-item flex-1">
                                        <div class="skeleton h-4 w-4/5 mb-2"></div>
                                        <div class="skeleton h-3 w-1/3"></div>
                                    </div>
                                </div>
                            </div>
                        }
                        else
                        {
                            <div class="text-center py-8 text-base-content/50 text-sm">
                                You've reached the end
                            </div>
                        }
                    </div>

                }
            </div>

            <!-- Right Column: Sidebar -->
            <aside id="sticky-sidebar" class="w-full lg:w-80 xl:w-96 flex-shrink-0" hx-boost="false">
            <div id="sidebar-inner">
                <!-- Space Info -->
                @if (Model.Space != null)
                {
                    <div class="sidebar-section">
                        <h3 class="sidebar-title">About this Space</h3>
                        @if (!string.IsNullOrEmpty(Model.Space.Description))
                        {
                            <p class="text-sm text-base-content/70 mb-3">@Model.Space.Description</p>
                        }
                        <div class="grid grid-cols-2 gap-3">
                            <div>
                                <div class="text-lg font-semibold">@FormatCount(Model.SpaceStats?.DiscussionCount ?? 0)</div>
                                <div class="text-xs text-base-content/50">Discussions</div>
                            </div>
                            <div>
                                <div class="text-lg font-semibold">@FormatCount(Model.SpaceStats?.ReplyCount ?? 0)</div>
                                <div class="text-xs text-base-content/50">Replies</div>
                            </div>
                        </div>
                    </div>
                }

                <!-- Rules -->
                @if (Model.Space?.HasRules == true)
                {
                    <div class="sidebar-section">
                        <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.Space.Slug)/rules"
                           class="sidebar-title flex items-center justify-between hover:text-primary transition-colors">
                            <span>Rules</span>
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </a>
                        <inline-or-htmx partial="Shared/Sidebar/_SpaceRules"
                                         model="Model.InlineSpaceRules"
                                         htmx-url="/partials/space-rules?spaceId=@Model.Space.PublicId&hubSlug=@Model.HubSlug&communitySlug=@(Model.Community.CommunitySlug ?? "")&parentHubHasRules=@Model.Space.ParentHubHasRules&parentCommunityHasRules=@Model.Space.ParentCommunityHasRules&rev=@Model.Space.RulesRevision">
                            <div class="flex flex-col gap-2">
                                <div class="skeleton h-4 w-full"></div>
                                <div class="skeleton h-4 w-5/6"></div>
                                <div class="skeleton h-4 w-4/6"></div>
                            </div>
                        </inline-or-htmx>
                    </div>
                }

                <!-- Moderators -->
                <div class="sidebar-section">
                    <a href="@(SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.Slug))/moderators"
                       class="sidebar-title flex items-center justify-between hover:text-primary transition-colors">
                        <span>Moderators</span>
                        <span class="flex items-center gap-1">
                            @if (Model.InlineModerators?.Moderators?.TotalCount is int modCount && modCount > 0)
                            {
                                <span class="text-xs text-base-content/50 font-normal">(@modCount)</span>
                            }
                            <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                                 fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                                <polyline points="9 18 15 12 9 6"></polyline>
                            </svg>
                        </span>
                    </a>
                    <inline-or-htmx partial="Shared/Sidebar/_Moderators"
                                     model="Model.InlineModerators"
                                     htmx-url="/partials/moderators?scopeType=Space&scopeId=@Model.Space?.PublicId&moderatorsUrl=@(SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.Slug))/moderators&rev=@Model.Space?.TeamRevision">
                        <div class="flex flex-col gap-2">
                            <div class="flex items-center gap-2"><div class="skeleton h-6 w-6 rounded-full shrink-0"></div><div class="skeleton h-3 w-24"></div></div>
                            <div class="flex items-center gap-2"><div class="skeleton h-6 w-6 rounded-full shrink-0"></div><div class="skeleton h-3 w-20"></div></div>
                            <div class="flex items-center gap-2"><div class="skeleton h-6 w-6 rounded-full shrink-0"></div><div class="skeleton h-3 w-28"></div></div>
                        </div>
                    </inline-or-htmx>
                </div>

                @if (Model.ShowTrendingDiscussions)
                {
                    <div class="sidebar-section">
                        <h3 class="sidebar-title">Trending Discussions</h3>
                        <inline-or-htmx partial="Shared/Sidebar/_TrendingDiscussions"
                                         model="Model.InlineTrendingDiscussions"
                                         htmx-url="/partials/trending-discussions?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                            <div class="flex flex-col gap-3">
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                            </div>
                        </inline-or-htmx>
                    </div>
                }

                @if (Model.ShowTrendingContributors)
                {
                    <div class="sidebar-section">
                        <h3 class="sidebar-title">Trending Contributors</h3>
                        <inline-or-htmx partial="Shared/Sidebar/_TrendingContributors"
                                         model="Model.InlineTrendingContributors"
                                         htmx-url="/partials/trending-contributors?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                            <div class="flex flex-col gap-3">
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                            </div>
                        </inline-or-htmx>
                    </div>
                }
            </div>
            </aside>
        </div>
    </div>

@section Styles {
}

@section Scripts {
    <script type="application/json" id="space-page-config">@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new { communityPrefix = SnakkUrlHelper.CommunityPrefix(Model.Community), space = new { publicId = Model.Space!.PublicId, hubSlug = Model.HubSlug, slug = Model.Slug } }))</script>
    <script src="@SnakkUrlHelper.Js("core/utils")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("pages/space-detail")" asp-append-version="true" defer></script>
    }
}
