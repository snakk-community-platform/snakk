@page "/new/question"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewQuestionModel
@{
    Layout = "~/Pages/Shared/_NewDiscussionLayout.cshtml";
    ViewData["Title"] = string.Format(T.Pages.SpacesNewQuestionTitlePattern, Model.Space?.Name);
    ViewData["NewDiscussion.Crumb"]       = T.Pages.SpacesNewQuestionCrumb;
    ViewData["NewDiscussion.Heading"]     = T.Pages.SpacesNewQuestionHeading;
    ViewData["NewDiscussion.TitlePh"]     = T.Pages.SpacesNewQuestionTitlePh;
    ViewData["NewDiscussion.SubmitLabel"] = T.Pages.SpacesNewQuestionSubmit;
}

@section ExtraStyles {
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("type-question")" asp-append-version="true" />
}

<div class="mt-8 border-t border-base-content/10 pt-6">
    <h3 class="text-sm font-semibold mb-3 text-base-content/70">@T.Pages.SpacesNewQuestionHowHeading</h3>
    <div class="text-sm text-base-content/60 space-y-3">
        <p>@T.Pages.SpacesNewQuestionIntro</p>
        <div>
            <div class="font-medium text-base-content/70 mb-1">@T.Pages.SpacesNewAfterYouPost</div>
            <ul class="space-y-1 list-disc pl-4">
                <li>@T.Pages.SpacesNewQuestionAfter1</li>
                <li>@T.Pages.SpacesNewQuestionAfter2</li>
                <li>@T.Pages.SpacesNewQuestionAfter3</li>
                <li>@T.Pages.SpacesNewQuestionAfter4</li>
            </ul>
        </div>
        <div>
            <div class="font-medium text-base-content/70 mb-1">@T.Pages.SpacesNewQuestionWritingLabel</div>
            <ul class="space-y-1 list-disc pl-4">
                <li>@T.Pages.SpacesNewQuestionWriting1</li>
                <li>@T.Pages.SpacesNewQuestionWriting2</li>
                <li>@T.Pages.SpacesNewQuestionWriting3</li>
                <li>@T.Pages.SpacesNewQuestionWriting4</li>
            </ul>
        </div>
    </div>
</div>
