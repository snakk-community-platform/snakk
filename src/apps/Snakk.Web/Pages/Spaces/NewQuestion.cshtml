@page "/new/question"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewQuestionModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"New Question — {Model.Space?.Name}";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@if (Model.Space == null) { <div class="empty-state-simple"><h3>Space not found</h3></div> return; }

<div class="fp-center">
    <div class="fp-center-inner">
        <div class="breadcrumb-bar">
            <nav class="breadcrumb">
                <a href="/">Home</a>
                @if (Model.ShowCommunityInBreadcrumb) { <span class="breadcrumb-separator">/</span><a href="/c/@Model.CommunitySlug">@(Model.CommunityDetail?.Name ?? Model.CommunitySlug)</a> }
                <span class="breadcrumb-separator">/</span>
                <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)">@(Model.Hub?.Name ?? Model.HubSlug)</a>
                <span class="breadcrumb-separator">/</span>
                <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug)">@Model.Space.Name</a>
                <span class="breadcrumb-separator">/</span>
                <a href="/new?spaceId=@Model.SpaceId">New</a>
                <span class="breadcrumb-separator">/</span>
                <span>Question</span>
            </nav>
        </div>

        <div class="max-w-3xl py-8">
            <h1 class="text-xl font-semibold mb-6">Ask a Question</h1>

            @if (!string.IsNullOrEmpty(Model.CreateError)) { <div class="alert alert-error text-sm mb-4">@Model.CreateError</div> }

            <form method="post" id="new-discussion-form" hx-boost="false">
                <input type="hidden" name="SpaceId" value="@Model.SpaceId" />
                <div class="space-y-4">
                    <input type="text" name="NewTitle" id="new-discussion-title" autofocus value="@Model.NewTitle"
                           class="input w-full text-lg" required maxlength="200" placeholder="What's your question?" />

                    <textarea name="NewContent" id="new-discussion-content" style="display:none">@Model.NewContent</textarea>

                    <div id="editor-container" data-hide-image="true">
                        <div class="editor-skeleton"><div class="editor-skeleton-toolbar"><div class="skeleton-pill"></div><div class="skeleton-pill"></div><div class="skeleton-pill"></div></div><div class="editor-skeleton-body" style="min-height:250px"><div class="skeleton-line w-3/4"></div><div class="skeleton-line w-1/2"></div></div></div>
                    </div>

                    <div class="flex items-center justify-between">
                        <a href="/new?spaceId=@Model.SpaceId" class="btn btn-ghost btn-sm">Back</a>
                        <button type="submit" id="new-discussion-submit" class="btn btn-primary btn-sm hidden">Ask Question</button>
                    </div>
                </div>
            </form>

            <div class="mt-8 border-t border-base-content/10 pt-6">
                <h3 class="text-sm font-semibold mb-3 text-base-content/70">How questions work</h3>
                <div class="text-sm text-base-content/60 space-y-3">
                    <p>Questions are designed for getting answers. The community replies, and you can mark the best answer as the accepted solution.</p>
                    <div>
                        <div class="font-medium text-base-content/70 mb-1">After you post</div>
                        <ul class="space-y-1 list-disc pl-4">
                            <li>Others post answers in chronological order</li>
                            <li>You can mark one answer as "accepted"</li>
                            <li>The question shows a "Solved" badge once resolved</li>
                            <li>Others can still reply after it's solved</li>
                        </ul>
                    </div>
                    <div>
                        <div class="font-medium text-base-content/70 mb-1">Writing a good question</div>
                        <ul class="space-y-1 list-disc pl-4">
                            <li>Be specific — describe the problem clearly</li>
                            <li>Include what you've already tried</li>
                            <li>Add relevant details and context</li>
                            <li>Use code blocks, screenshots, or examples</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<script src="@SnakkUrlHelper.Js("components/markdown-editor")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/new-discussion")" asp-append-version="true" defer></script>
