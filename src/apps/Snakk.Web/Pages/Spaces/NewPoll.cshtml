@page "/new/poll"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.Spaces.NewPollModel
@{ ViewData["Title"] = $"New Poll — {Model.Space?.Name}"; }

@if (Model.Space == null) { <div class="empty-state-simple"><h3>Space not found</h3></div> return; }

<div class="breadcrumb-bar">
    <nav class="breadcrumb">
        <a href="/">Home</a>
        @if (Model.ShowCommunityInBreadcrumb) { <span class="breadcrumb-separator">/</span><a href="/c/@Model.CommunitySlug">@(Model.CommunityDetail?.Name ?? Model.CommunitySlug)</a> }
        <span class="breadcrumb-separator">/</span>
        <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)">@(Model.Hub?.Name ?? Model.HubSlug)</a>
        <span class="breadcrumb-separator">/</span>
        <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug)">@Model.Space.Name</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/new?spaceId=@Model.SpaceId" hx-boost="false">New</a>
        <span class="breadcrumb-separator">/</span>
        <span>Poll</span>
    </nav>
</div>

<div class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-xl font-semibold mb-6">Create a Poll</h1>

    @if (!string.IsNullOrEmpty(Model.CreateError)) { <div class="alert alert-error text-sm mb-4">@Model.CreateError</div> }

    <form method="post" id="new-discussion-form" hx-boost="false">
        <input type="hidden" name="SpaceId" value="@Model.SpaceId" />
        <div class="space-y-4">
            <input type="text" name="NewTitle" id="new-discussion-title" autofocus value="@Model.NewTitle"
                   class="input w-full text-lg" required maxlength="200" placeholder="Poll question" />

            <!-- Poll options -->
            <div class="space-y-3">
                <div class="text-sm font-medium">Poll Options</div>
                <div id="poll-options-list" class="space-y-2">
                    <input type="text" name="PollOptions" class="input w-full input-sm" placeholder="Option 1" />
                    <input type="text" name="PollOptions" class="input w-full input-sm" placeholder="Option 2" />
                </div>
                <button type="button" class="btn btn-ghost btn-xs" data-action="add-poll-option">+ Add option</button>

                <div class="flex flex-wrap gap-4 mt-2">
                    <label class="flex items-center gap-2 text-sm cursor-pointer">
                        <input type="checkbox" name="PollAllowMultiple" value="true" class="checkbox checkbox-sm" />
                        Allow multiple choices
                    </label>
                    <label class="flex items-center gap-2 text-sm cursor-pointer">
                        <input type="checkbox" name="PollAllowChangeVote" value="true" class="checkbox checkbox-sm" />
                        Allow changing vote
                    </label>
                </div>
                <div>
                    <label class="text-sm text-base-content/70">Close date (optional)</label>
                    <input type="datetime-local" name="PollClosesAt" class="input input-sm w-full max-w-xs mt-1" />
                </div>
            </div>

            <textarea name="NewContent" id="new-discussion-content" style="display:none">@Model.NewContent</textarea>

            <div id="editor-container" data-hide-image="true" data-placeholder="Add context or details about your poll (optional)...">
                <div class="editor-skeleton"><div class="editor-skeleton-toolbar"><div class="skeleton-pill"></div><div class="skeleton-pill"></div><div class="skeleton-pill"></div></div><div class="editor-skeleton-body" style="min-height:150px"><div class="skeleton-line w-3/4"></div><div class="skeleton-line w-1/2"></div></div></div>
            </div>

            <div class="flex items-center justify-between">
                <a href="/new?spaceId=@Model.SpaceId" class="btn btn-ghost btn-sm" hx-boost="false">Back</a>
                <button type="submit" id="new-discussion-submit" class="btn btn-primary btn-sm hidden">Create Poll</button>
            </div>
        </div>
    </form>

    <div class="mt-8 border-t border-base-content/10 pt-6">
        <h3 class="text-sm font-semibold mb-3 text-base-content/70">How polls work</h3>
        <div class="text-sm text-base-content/60 space-y-3">
            <p>Polls let the community vote on a question. Results update in real time as votes come in.</p>
            <div>
                <div class="font-medium text-base-content/70 mb-1">After you post</div>
                <ul class="space-y-1 list-disc pl-4">
                    <li>A results bar appears at the top of the discussion</li>
                    <li>Members vote by clicking an option</li>
                    <li>Votes are anonymous — no public voter list</li>
                    <li>The poll closes automatically on the end date (if set)</li>
                </ul>
            </div>
            <div>
                <div class="font-medium text-base-content/70 mb-1">Tips</div>
                <ul class="space-y-1 list-disc pl-4">
                    <li>Keep options clear and mutually exclusive</li>
                    <li>2-6 options works best for engagement</li>
                    <li>Use the description to provide context</li>
                    <li>Set an end date for time-sensitive polls</li>
                </ul>
            </div>
        </div>
    </div>
</div>

<script src="@SnakkUrlHelper.Js("components/markdown-editor")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/new-discussion")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/new-poll")" asp-append-version="true" defer></script>
