@page "/new/poll"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewPollModel
@{
    ViewData["Title"] = string.Format(T.Pages.SpacesNewPollTitlePattern, Model.Space?.Name);
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@section CenterHeader {
    @if (Model.ShowCommunityInBreadcrumb)
    {
        <a href="/c/@Model.CommunitySlug" class="badge badge-ghost badge-sm">@(Model.CommunityDetail?.Name ?? Model.CommunitySlug)</a>
        <span class="sn-page-labels-sep">›</span>
    }
    @if (Model.Space != null)
    {
        <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)" class="badge badge-ghost badge-sm">@(Model.Hub?.Name ?? Model.HubSlug)</a>
        <span class="sn-page-labels-sep">›</span>
        <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug)" class="badge badge-ghost badge-sm">@Model.Space.Name</a>
        <span class="sn-page-labels-sep">›</span>
        <a href="/new?spaceId=@Model.SpaceId" class="badge badge-ghost badge-sm">@T.Pages.SpacesNewCrumbNew</a>
        <span class="sn-page-labels-sep">›</span>
        <span class="badge badge-ghost badge-sm">@T.Pages.SpacesNewPollCrumb</span>
    }
}

@if (User.Identity?.IsAuthenticated != true) {
    { ViewData["AuthPrompt.Title"] = T.Pages.SpacesNewAuthPrompt; }
    <div class="sn-center"><div class="sn-center-inner"><partial name="Shared/_AuthPrompt" /></div></div>
    return;
}
@if (Model.Space == null) { <div class="empty-state-simple"><h3>@T.Pages.SpacesNewSpaceNotFound</h3></div> return; }

<div class="sn-center">
    <div class="sn-center-inner">
        <div class="max-w-3xl py-8">
            <h1 class="text-xl font-semibold mb-6">@T.Pages.SpacesNewPollHeading</h1>

            @if (!string.IsNullOrEmpty(Model.CreateError)) { <div class="alert alert-error text-sm mb-4">@Model.CreateError</div> }

            <form method="post" id="new-discussion-form" hx-boost="false">
                <input type="hidden" name="SpaceId" value="@Model.SpaceId" />
                <div class="space-y-4">
                    <input type="text" name="NewTitle" id="new-discussion-title" autofocus value="@Model.NewTitle"
                           class="input w-full text-lg" required maxlength="200" placeholder="@T.Pages.SpacesNewPollTitlePh" />

                    <!-- Poll options -->
                    <div class="space-y-3">
                        <div class="text-sm font-medium">@T.Pages.SpacesNewPollOptionsLabel</div>
                        <div id="poll-options-list" class="space-y-2">
                            <input type="text" name="PollOptions" class="input w-full input-sm" placeholder="@T.Pages.SpacesNewPollOption1Ph" />
                            <input type="text" name="PollOptions" class="input w-full input-sm" placeholder="@T.Pages.SpacesNewPollOption2Ph" />
                        </div>
                        <button type="button" class="btn btn-ghost btn-xs" data-action="add-poll-option">@T.Pages.SpacesNewPollAddOption</button>

                        <div class="text-sm font-medium mt-4 mb-2">@T.Pages.SpacesNewPollSettingsLabel</div>
                        <div class="flex flex-col gap-2">
                            <div class="clean-card p-3">
                                <label class="flex items-center gap-3 cursor-pointer">
                                    <input type="checkbox" name="PollAllowMultiple" value="true" class="toggle toggle-primary toggle-sm" />
                                    <span>
                                        <span class="font-medium text-sm">@T.Pages.SpacesNewPollMultiple</span>
                                        <span class="block text-xs" style="color: var(--text-tertiary)">@T.Pages.SpacesNewPollMultipleDesc</span>
                                    </span>
                                </label>
                            </div>
                            <div class="clean-card p-3">
                                <label class="flex items-center gap-3 cursor-pointer">
                                    <input type="checkbox" name="PollAllowChangeVote" value="true" class="toggle toggle-primary toggle-sm" />
                                    <span>
                                        <span class="font-medium text-sm">@T.Pages.SpacesNewPollChange</span>
                                        <span class="block text-xs" style="color: var(--text-tertiary)">@T.Pages.SpacesNewPollChangeDesc</span>
                                    </span>
                                </label>
                            </div>
                            <div class="clean-card p-3">
                                <label class="flex items-center gap-3 cursor-pointer">
                                    <input type="checkbox" name="PollSecret" value="true" class="toggle toggle-primary toggle-sm" />
                                    <span>
                                        <span class="font-medium text-sm">@T.Pages.SpacesNewPollSecret</span>
                                        <span class="block text-xs" style="color: var(--text-tertiary)">@T.Pages.SpacesNewPollSecretDesc</span>
                                    </span>
                                </label>
                            </div>
                            <div class="clean-card p-3">
                                <label class="flex items-center gap-3 cursor-pointer">
                                    <input type="checkbox" name="PollIsSegmented" value="true" class="toggle toggle-primary toggle-sm" id="poll-segmented-check" />
                                    <span>
                                        <span class="font-medium text-sm">@T.Pages.SpacesNewPollGroup</span>
                                        <span class="block text-xs" style="color: var(--text-tertiary)">@T.Pages.SpacesNewPollGroupDesc</span>
                                    </span>
                                </label>
                                <div id="segment-fields" class="hidden mt-3 ml-11 space-y-2">
                                    <div>
                                        <label class="text-xs font-medium" style="color: var(--text-secondary)">@T.Pages.SpacesNewPollGroupQ</label>
                                        <input type="text" name="PollSegmentLabel" class="input input-sm w-full" placeholder="@T.Pages.SpacesNewPollGroupQPh" />
                                    </div>
                                    <div class="flex gap-2">
                                        <div class="flex-1">
                                            <label class="text-xs font-medium" style="color: var(--text-secondary)">@T.Pages.SpacesNewPollGroupA</label>
                                            <input type="text" name="PollSegmentOptionA" class="input input-sm w-full" placeholder="@T.Pages.SpacesNewPollGroupAPh" />
                                        </div>
                                        <div class="flex-1">
                                            <label class="text-xs font-medium" style="color: var(--text-secondary)">@T.Pages.SpacesNewPollGroupB</label>
                                            <input type="text" name="PollSegmentOptionB" class="input input-sm w-full" placeholder="@T.Pages.SpacesNewPollGroupBPh" />
                                        </div>
                                    </div>
                                </div>
                            </div>
                            <div class="clean-card p-3">
                                <label class="flex items-center gap-3 cursor-pointer">
                                    <input type="checkbox" class="toggle toggle-primary toggle-sm" id="poll-close-date-check" />
                                    <span>
                                        <span class="font-medium text-sm">@T.Pages.SpacesNewPollCloseDate</span>
                                        <span class="block text-xs" style="color: var(--text-tertiary)">@T.Pages.SpacesNewPollCloseDateDesc</span>
                                    </span>
                                </label>
                                <div id="close-date-field" class="hidden mt-3 ml-11">
                                    <input type="datetime-local" name="PollClosesAt" class="input input-sm w-full max-w-xs" />
                                </div>
                            </div>
                        </div>
                    </div>

                    <textarea name="NewContent" id="new-discussion-content" style="display:none">@Model.NewContent</textarea>

                    <div id="editor-container" data-hide-image="true" data-placeholder="@T.Pages.SpacesNewPollEditorPh">
                        <div class="editor-skeleton"><div class="editor-skeleton-toolbar"><div class="skeleton-pill"></div><div class="skeleton-pill"></div><div class="skeleton-pill"></div></div><div class="editor-skeleton-body" style="min-height:150px"><div class="skeleton-line w-3/4"></div><div class="skeleton-line w-1/2"></div></div></div>
                    </div>

                    <partial name="_NewDiscussionAdultToggle" model="Model.Space" />

                    <div class="flex items-center justify-between">
                        <a href="/new?spaceId=@Model.SpaceId" class="btn btn-ghost btn-sm">@T.Pages.SpacesNewBack</a>
                        <button type="submit" id="new-discussion-submit" class="btn btn-primary btn-sm hidden">@T.Pages.SpacesNewPollSubmit</button>
                    </div>
                </div>
            </form>

            <div class="mt-8 border-t border-base-content/10 pt-6">
                <h3 class="text-sm font-semibold mb-3 text-base-content/70">@T.Pages.SpacesNewPollHowHeading</h3>
                <div class="text-sm text-base-content/60 space-y-3">
                    <p>@T.Pages.SpacesNewPollIntro</p>
                    <div>
                        <div class="font-medium text-base-content/70 mb-1">@T.Pages.SpacesNewAfterYouPost</div>
                        <ul class="space-y-1 list-disc pl-4">
                            <li>@T.Pages.SpacesNewPollAfter1</li>
                            <li>@T.Pages.SpacesNewPollAfter2</li>
                            <li>@T.Pages.SpacesNewPollAfter3</li>
                            <li>@T.Pages.SpacesNewPollAfter4</li>
                        </ul>
                    </div>
                    <div>
                        <div class="font-medium text-base-content/70 mb-1">@T.Pages.SpacesNewTips</div>
                        <ul class="space-y-1 list-disc pl-4">
                            <li>@T.Pages.SpacesNewPollTip1</li>
                            <li>@T.Pages.SpacesNewPollTip2</li>
                            <li>@T.Pages.SpacesNewPollTip3</li>
                            <li>@T.Pages.SpacesNewPollTip4</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Shared/_NewDiscussionSpaceSidebar" model="Model" />

<script src="@SnakkUrlHelper.Js("components/markdown-editor")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/new-discussion")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/new-poll")" asp-append-version="true" defer></script>
