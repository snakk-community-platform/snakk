@page "/create/link"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewLinkModel
@{
    Layout = "~/Pages/Shared/_NewDiscussionLayout.cshtml";
    ViewData["Title"] = string.Format(T.Pages.SpacesNewLinkTitlePattern, Model.Space?.Name);
    ViewData["NewDiscussion.Crumb"]        = T.Pages.SpacesNewLinkCrumb;
    ViewData["NewDiscussion.Heading"]      = T.Pages.SpacesNewLinkHeading;
    ViewData["NewDiscussion.TitlePh"]      = T.Pages.SpacesNewLinkTitlePh;
    ViewData["NewDiscussion.SubmitLabel"]  = T.Pages.SpacesNewLinkSubmit;
    ViewData["NewDiscussion.EditorHeight"] = "150px";
}

@section ExtraFormFields {
    <input type="url" name="LinkUrl" value="@Model.LinkUrl"
           class="sn-input sn-w-full" required placeholder="@T.Pages.SpacesNewLinkUrlPh" />
}

<div class="sn-how-to-section">
    <h3 class="sn-section-label--createlink">@T.Pages.SpacesNewLinkHowHeading</h3>
    <div class="sn-how-to-body">
        <p>@T.Pages.SpacesNewLinkIntro</p>
        <div>
            <div class="sn-how-to-sublabel">@T.Pages.SpacesNewAfterYouPost</div>
            <ul class="sn-space-y-1 list-disc sn-pl-4">
                <li>@T.Pages.SpacesNewLinkAfter1</li>
                <li>@T.Pages.SpacesNewLinkAfter2</li>
                <li>@T.Pages.SpacesNewLinkAfter3</li>
            </ul>
        </div>
        <div>
            <div class="sn-how-to-sublabel">@T.Pages.SpacesNewTips</div>
            <ul class="sn-space-y-1 list-disc sn-pl-4">
                <li>@T.Pages.SpacesNewLinkTip1</li>
                <li>@T.Pages.SpacesNewLinkTip2</li>
                <li>@T.Pages.SpacesNewLinkTip3</li>
            </ul>
        </div>
    </div>
</div>

