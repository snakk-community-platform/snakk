@page "/create/guide"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewGuideModel
@{
    ViewData["Title"] = string.Format(T.Pages.SpacesNewGuideTitlePattern, Model.Space?.Name);
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@section CenterHeader {
    @if (Model.ShowCommunityInBreadcrumb)
    {
        <a href="/c/@Model.CommunitySlug" class="sn-badge sn-badge-ghost sn-badge-sm">@(Model.CommunityDetail?.Name ?? Model.CommunitySlug)</a>
        <span class="sn-page-labels-sep">›</span>
    }
    @if (Model.Space != null)
    {
        <a href="@SnakkUrlHelper.Hub(Model.Community, Model.HubSlug)" class="sn-badge sn-badge-ghost sn-badge-sm">@(Model.Hub?.Name ?? Model.HubSlug)</a>
        <span class="sn-page-labels-sep">›</span>
        <a href="@SnakkUrlHelper.Space(Model.Community, Model.HubSlug, Model.SpaceSlug)" class="sn-badge sn-badge-ghost sn-badge-sm">@Model.Space.Name</a>
        <span class="sn-page-labels-sep">›</span>
        <a href="/create?spaceId=@Model.SpaceId" class="sn-badge sn-badge-ghost sn-badge-sm">@T.Pages.SpacesNewCrumbNew</a>
        <span class="sn-page-labels-sep">›</span>
        <span class="sn-badge sn-badge-ghost sn-badge-sm">@T.Pages.SpacesNewGuideCrumb</span>
    }
}

@if (User.Identity?.IsAuthenticated != true) {
    { ViewData["AuthPrompt.Title"] = T.Pages.SpacesNewAuthPrompt; }
    <div class="sn-center"><div class="sn-center-inner"><partial name="Shared/_AuthPrompt" /></div></div>
    return;
}
@if (Model.Space == null) { <div class="empty-state-simple"><h3>@T.Pages.SpacesNewSpaceNotFound</h3></div> return; }

<div class="sn-center">
    <div class="sn-center-inner">
        <div class="max-w-3xl sn-py-8">
            <h1 class="sn-page-heading">@T.Pages.SpacesNewGuideHeading</h1>

            @if (!string.IsNullOrEmpty(Model.CreateError)) { <div class="sn-alert sn-alert-error sn-text-sm sn-mb-4">@Model.CreateError</div> }

            <form method="post" id="new-discussion-form" hx-boost="false">
                <input type="hidden" name="SpaceId" value="@Model.SpaceId" />
                <div class="sn-space-y-4">
                    <input type="text" name="NewTitle" id="new-discussion-title" autofocus value="@Model.NewTitle"
                           class="sn-input sn-w-full sn-text-lg" required maxlength="200" placeholder="@T.Pages.SpacesNewGuideTitlePh" />

                    <textarea name="NewContent" id="new-discussion-content" style="display:none">@Model.NewContent</textarea>

                    <div id="editor-container" data-hide-image="true">
                        <div class="sn-editor-skeleton"><div class="sn-editor-skeleton-toolbar"><div class="sn-skeleton-pill"></div><div class="sn-skeleton-pill"></div><div class="sn-skeleton-pill"></div></div><div class="sn-editor-skeleton-body" style="min-height:300px"><div class="sn-skeleton-line w-3/4"></div><div class="sn-skeleton-line w-1/2"></div></div></div>
                    </div>

                    <partial name="_NewDiscussionAdultToggle" model="Model.Space" />

                    <div class="sn-form-actions-row--createguide">
                        <a href="/create?spaceId=@Model.SpaceId" class="sn-btn sn-btn-ghost sn-btn-sm">@T.Pages.SpacesNewBack</a>
                        <button type="submit" id="new-discussion-submit" class="sn-btn sn-btn-primary sn-btn-sm sn-hidden">@T.Pages.SpacesNewGuideSubmit</button>
                    </div>
                </div>
            </form>

            <div class="sn-guide-tips-section">
                <h3 class="sn-section-label--createguide">@T.Pages.SpacesNewGuideHowHeading</h3>
                <div class="sn-guide-tips-body">
                    <p>@T.Pages.SpacesNewGuideIntro</p>
                    <div>
                        <div class="sn-guide-tips-sublabel">@T.Pages.SpacesNewAfterYouPost</div>
                        <ul class="sn-space-y-1 list-disc sn-pl-4">
                            <li>@T.Pages.SpacesNewGuideAfter1</li>
                            <li>@T.Pages.SpacesNewGuideAfter2</li>
                            <li>@T.Pages.SpacesNewGuideAfter3</li>
                        </ul>
                    </div>
                    <div>
                        <div class="sn-guide-tips-sublabel">@T.Pages.SpacesNewGuideStructLabel</div>
                        <ul class="sn-space-y-1 list-disc sn-pl-4">
                            <li>@T.Pages.SpacesNewGuideStruct1</li>
                            <li>@T.Pages.SpacesNewGuideStruct2</li>
                            <li>@T.Pages.SpacesNewGuideStruct3</li>
                            <li>@T.Pages.SpacesNewGuideStruct4</li>
                            <li>@T.Pages.SpacesNewGuideStruct5</li>
                        </ul>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>

<partial name="Shared/_NewDiscussionSpaceSidebar" model="Model" />

<script src="@SnakkUrlHelper.Js("components/markdown-editor")" asp-append-version="true" defer></script>
<script src="@SnakkUrlHelper.Js("pages/new-discussion")" asp-append-version="true" defer></script>
