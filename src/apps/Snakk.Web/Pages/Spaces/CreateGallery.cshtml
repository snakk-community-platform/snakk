@page "/create/gallery"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.Spaces.NewGalleryModel
@{
    Layout = "~/Pages/Shared/_NewDiscussionLayout.cshtml";
    ViewData["Title"] = string.Format(T.Pages.SpacesNewGalleryTitlePattern, Model.Space?.Name);
    ViewData["NewDiscussion.Crumb"]        = T.Pages.SpacesNewGalleryCrumb;
    ViewData["NewDiscussion.Heading"]      = T.Pages.SpacesNewGalleryHeading;
    ViewData["NewDiscussion.TitlePh"]      = T.Pages.SpacesNewGalleryTitlePh;
    ViewData["NewDiscussion.SubmitLabel"]  = T.Pages.SpacesNewGallerySubmit;
    ViewData["NewDiscussion.EditorHeight"] = "150px";
}

@section ExtraFormFields {
    <!-- Images section -->
    <div>
        <!-- Inline image picker (mounted by gallery-new.ts) -->
        <div id="images-picker-container"></div>

        <!-- Spoiler toggle (shown always, below picker) -->
        <label class="sn-gallery-spoiler-toggle">
            <input type="checkbox" name="ImagesIsSpoiler" value="true" class="sn-toggle sn-toggle-primary sn-toggle-sm" />
            <span>
                <span class="sn-font-medium sn-text-sm">@T.Pages.SpacesNewGallerySpoiler</span>
                <span class="sn-gallery-spoiler-desc">@T.Pages.SpacesNewGallerySpoilerDesc</span>
            </span>
        </label>

        <!-- Layout submitted via hidden input (synced by JS from widget onChange) -->
        <input type="hidden" name="ImagesLayout" id="images-layout-hidden" value="masonry" />

        <!-- Hidden image URL inputs (populated at submit by JS) -->
        <div id="images-hidden-inputs"></div>
    </div>
}

@section EditorContainer {
    <!-- Description editor -->
    <div>
        <div class="sn-field-label">@T.Pages.SpacesNewGalleryDescLabel</div>
        <textarea name="NewContent" id="new-discussion-content" style="display:none">@Model.NewContent</textarea>

        <div id="editor-container" data-hide-image="true" data-placeholder="@T.Pages.SpacesNewGalleryEditorPh">
            <div class="sn-editor-skeleton"><div class="sn-editor-skeleton-toolbar"><div class="sn-skeleton-pill"></div><div class="sn-skeleton-pill"></div><div class="sn-skeleton-pill"></div></div><div class="sn-editor-skeleton-body" style="min-height:150px"><div class="sn-skeleton-line w-3/4"></div><div class="sn-skeleton-line w-1/2"></div></div></div>
        </div>
    </div>
}

@section SubmitRow {
    <div class="sn-submit-row">
        <div id="upload-progress-row" class="sn-upload-progress-row sn-hidden">
            <div id="upload-image-chips" class="sn-upload-image-chips"></div>
            <span id="upload-status-text" class="sn-upload-status-text"></span>
        </div>
        <button type="submit" id="new-discussion-submit" class="sn-btn sn-btn-primary sn-btn-sm sn-hidden">
            <span id="new-discussion-submit-label">@T.Pages.SpacesNewGallerySubmit</span>
            <span id="new-discussion-submit-spinner" class="sn-spinner sn-loading-xs sn-hidden"></span>
        </button>
    </div>
}

@section ExtraScripts {
    <script src="@SnakkUrlHelper.Js("pages/gallery-new")" asp-append-version="true" defer></script>
}

<div class="sn-mt-8 sn-border-t sn-border sn-pt-6">
    <h3 class="sn-section-label--creategallery">@T.Pages.SpacesNewGalleryHowHeading</h3>
    <div class="sn-gallery-howto-body">
        <p>@T.Pages.SpacesNewGalleryIntro</p>
        <div>
            <div class="sn-gallery-howto-subheading">@T.Pages.SpacesNewAfterYouPost</div>
            <ul class="sn-space-y-1 list-disc sn-pl-4">
                <li>@T.Pages.SpacesNewGalleryAfter1</li>
                <li>@T.Pages.SpacesNewGalleryAfter2</li>
            </ul>
        </div>
        <div>
            <div class="sn-gallery-howto-subheading">@T.Pages.SpacesNewTips</div>
            <ul class="sn-space-y-1 list-disc sn-pl-4">
                <li>@T.Pages.SpacesNewGalleryTip1</li>
                <li>@T.Pages.SpacesNewGalleryTip2</li>
            </ul>
        </div>
    </div>
</div>

