@page
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@using static Snakk.Web.Helpers.DiscussionTypeHelper
@model LatestModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Latest Discussions";
    ViewData["Description"] = "Browse the newest discussions on Snakk — ordered by when they were created, not when they last got a reply.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="fp-center">
    <div class="fp-center-inner">
        <h2 class="fp-section-title">
            <span class="icon icon-clock" aria-hidden="true"></span>
            Latest Discussions
        </h2>

        @if (Model.LatestDiscussions?.Items == null || !Model.LatestDiscussions.Items.Any())
        {
            <div class="py-12 text-center text-sm" style="color: var(--text-tertiary)">
                <p>No discussions yet. Be the first to start a conversation!</p>
            </div>
        }
        else
        {
            <div id="discussions-container" class="h-feed">
                @foreach (var discussion in Model.LatestDiscussions.Items)
                {
                    @await Html.PartialAsync("Shared/_DiscussionCard",
                        new DiscussionListItemVM(discussion, Model.ShowCommunityInDiscussionList, Model.Community))
                }

                @if (Model.LatestDiscussions.HasMoreItems && Model.NextCursor != null)
                {
                    var communityParam = Model.SidebarScopeType == "community" ? $"&communityId={Model.SidebarScopeId}" : "";

                    <div hx-get="/partials/discussions?sort=new&cursor=@Model.NextCursor&pageSize=20@(communityParam)"
                         hx-trigger="revealed"
                         hx-swap="outerHTML"
                         hx-target="this"
                         hx-push-url="false"
                         class="py-2">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="fp-card" style="opacity: 0.5">
                                <div class="fp-card-header">
                                    <div class="skeleton h-3 w-16 rounded"></div>
                                    <div class="skeleton h-4 w-4 rounded-full"></div>
                                    <div class="skeleton h-3 w-20 rounded"></div>
                                </div>
                                <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                                <div class="fp-card-stats mt-2">
                                    <div class="skeleton h-3 w-24 rounded"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Right Column -->
<aside class="fp-right">
<div class="fp-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="fp-right-body">
    <div class="fp-right-section">
        <div class="fp-right-title">
            <span class="icon icon-chart-bar" aria-hidden="true"></span>
            Site Stats
        </div>
        @if (Model.InlinePlatformStats != null)
        {
            <div class="flex gap-2">
                <div class="stats shadow flex-1">
                    <div class="stat">
                        <div class="stat-title">Discussions</div>
                        <div class="stat-value">@FormatCount(Model.InlinePlatformStats.DiscussionCount)</div>
                    </div>
                </div>
                <div class="stats shadow flex-1">
                    <div class="stat">
                        <div class="stat-title">Replies</div>
                        <div class="stat-value">@FormatCount(Model.InlinePlatformStats.ReplyCount)</div>
                    </div>
                </div>
            </div>
        }
    </div>

    <div class="fp-right-section">
        <div class="fp-right-title">
            <span class="icon icon-archive-layers" aria-hidden="true"></span>
            Latest Spaces
        </div>
        @if (Model.InlineLatestSpaces?.Spaces?.Items?.Count > 0)
        {
            <div class="fp-spaces-inline">
                @foreach (var space in Model.InlineLatestSpaces.Spaces.Items)
                {
                    <a href="@SnakkUrlHelper.Space(space.CommunitySlug, Model.Community, space.Hub.Slug, space.Slug)"
                       class="fp-card-tag"
                       data-popup-type="space" data-popup-id="@space.PublicId" data-popup-name="@space.Name">@space.Name</a>
                }
            </div>
        }
        else
        {
            <p class="fp-right-empty">No active spaces yet</p>
        }
    </div>

    <div class="fp-right-section">
        <div class="fp-right-title">
            <span class="icon icon-users-group" aria-hidden="true"></span>
            Latest Contributors
        </div>
        @if (Model.InlineLatestContributors?.Contributors?.Items?.Count > 0)
        {
            <div class="fp-trending-list">
                @foreach (var c in Model.InlineLatestContributors.Contributors.Items)
                {
                    var contribLastPostAt = DateTime.TryParse(c.LastPostAt, out var contribParsed) ? contribParsed.ToString("MMM d") : "";
                    <a href="@SnakkUrlHelper.UserProfile(c.PublicId)" class="fp-trending-contributor"
                       data-popup-type="user" data-popup-id="@c.PublicId" data-popup-name="@c.DisplayName">
                        <img src="@c.AvatarMicroUrl" alt="" class="fp-avatar-square" width="28" height="28" />
                        <span class="fp-trending-contributor-name">@c.DisplayName</span>
                        <time class="fp-card-tag fp-card-tag-light fp-tag-sm" datetime="@c.LastPostAt" data-relative="true">@contribLastPostAt</time>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="fp-right-empty">No recent contributors yet</p>
        }
    </div>
    </div>
</div>
</aside>

@section Scripts {
    @if (Model.LatestDiscussions?.Items != null && Model.LatestDiscussions.Items.Any())
    {
        <script src="@SnakkUrlHelper.Js("pages/frontpage-discussions")" asp-append-version="true" defer></script>
    }
}
