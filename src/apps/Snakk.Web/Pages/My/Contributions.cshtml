@page "/my/contributions/{tab?}"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@model Snakk.Web.Pages.My.ContributionsModel
@{
    ViewData["Title"] = T.Pages.MeTitle;
    ViewData["Description"] = "Your discussions and posts.";
    ViewData["Nudge.Title"] = T.Pages.MeNudgeTitle;
    ViewData["Nudge.Body"] = T.Pages.MeNudgeBody;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="sn-center">
    <div class="sn-center-inner">
        @if (!Model.IsAuthenticated)
        {
            <partial name="Shared/_RegistrationNudge" />
        }
        else
        {
        <div class="sn-section-header">
        <h2 class="sn-section-title">
            <span class="icon icon-user" aria-hidden="true"></span>
            @T.Pages.MeHeading
        </h2>

        <!-- Tabs -->
        <div class="sn-tabs">
            <a href="/my/contributions/discussions" class="sn-tab @(Model.ActiveTab == "discussions" ? "active" : "")">
                @T.Pages.MeTabDiscussions
            </a>
            <a href="/my/contributions/posts" class="sn-tab @(Model.ActiveTab == "posts" ? "active" : "")">
                @T.Pages.MeTabPosts
            </a>
        </div>
        </div>
        <p class="sn-section-description">@T.Pages.MeDescription</p>

        @if (Model.ActiveTab == "discussions")
        {
            @if (Model.Discussions == null || Model.Discussions.Items.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-chat-bubbles h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>@T.Pages.MeEmptyDiscussions</p>
                    <p class="mt-1 text-xs opacity-70"><a href="/create" class="underline">@T.Pages.MeEmptyDiscussionsLink</a></p>
                </div>
            }
            else
            {
                <div class="sn-card-list">
                    @foreach (var discussion in Model.Discussions.Items)
                    {
                        @await Html.PartialAsync("Shared/_DiscussionCard",
                            new DiscussionListItemVM(discussion, Model.ShowCommunityInBreadcrumb, Model.Community, ShowStats: true, HideInlineStats: true))
                    }
                </div>
                @if (Model.Discussions.HasMoreItems)
                {
                    var nextOffset = Model.Offset + Model.Discussions.Items.Count;
                    <div hx-get="/partials/my-discussions?offset=@nextOffset&pageSize=20"
                         hx-trigger="revealed once"
                         hx-swap="outerHTML"
                         hx-target="this"
                         hx-push-url="false"
                         class="py-2">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="sn-card" style="opacity: 0.5">
                                <div class="sn-card-header">
                                    <div class="skeleton h-3 w-16 rounded"></div>
                                    <div class="skeleton h-4 w-4 rounded-full"></div>
                                    <div class="skeleton h-3 w-20 rounded"></div>
                                </div>
                                <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                                <div class="sn-card-stats mt-2">
                                    <div class="skeleton h-3 w-24 rounded"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
        else
        {
            @if (Model.Posts == null || Model.Posts.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-chat-alt h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>@T.Pages.MeEmptyPosts</p>
                </div>
            }
            else
            {
                <div class="sn-card-list">
                    @foreach (var post in Model.Posts)
                    {
                        @await Html.PartialAsync("Shared/_PostCard", post)
                    }
                    @if (Model.PostsHasMore)
                    {
                        var nextOffset = Model.Offset + Model.Posts.Count;
                        <div hx-get="/partials/my-posts?offset=@nextOffset&pageSize=20"
                             hx-trigger="revealed once"
                             hx-swap="outerHTML"
                             hx-target="this"
                             hx-push-url="false">
                            @for (var i = 0; i < 3; i++)
                            {
                                <div class="sn-card" style="opacity: 0.5">
                                    <div class="sn-card-header">
                                        <div class="skeleton h-4 w-4 rounded-full"></div>
                                        <div class="skeleton h-3 w-20 rounded"></div>
                                        <div class="skeleton h-3 w-16 rounded"></div>
                                    </div>
                                    <div class="skeleton h-4 w-3/4 rounded mt-1"></div>
                                    <div class="skeleton h-3 w-full rounded mt-1"></div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
        } @* end IsAuthenticated *@
    </div>
</div>

<aside class="sn-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/create";
    ViewData["RightPane.AboutTitle"] = T.Pages.MeAboutTitle;
    ViewData["RightPane.AboutDescription"] = T.Pages.MeAboutDesc;
}
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="sn-right-body">
    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-chart-bar" aria-hidden="true"></span>
            @T.Sections.SiteStats
        </div>
        <div hx-get="/partials/platform-stats?scopeType=platform&scopeId=global"
             hx-trigger="load delay:100ms"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="grid grid-cols-2 gap-3">
                <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-16"></div></div>
                <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-10"></div></div>
            </div>
        </div>
    </div>

    <partial name="Shared/_RightAboutSection" />

    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-archive-layers" aria-hidden="true"></span>
            @T.Sections.ActiveSpaces
        </div>
        <div hx-get="/partials/trending-spaces?scopeType=platform&scopeId=global"
             hx-trigger="load delay:100ms"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
            </div>
        </div>
    </div>

    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-users-group" aria-hidden="true"></span>
            @T.Sections.ActiveContributors
        </div>
        <div hx-get="/partials/trending-contributors?scopeType=platform&scopeId=global"
             hx-trigger="load delay:100ms"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
            </div>
        </div>
    </div>
    </div>
</div>
</aside>
