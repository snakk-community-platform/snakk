@page "/my/follows/{tab?}"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.My.FollowsModel
@{
    ViewData["Title"] = T.Pages.FollowingTitle;
    ViewData["Description"] = "Spaces, discussions and people you follow.";
    ViewData["Nudge.Title"] = T.Pages.FollowingNudgeTitle;
    ViewData["Nudge.Body"] = T.Pages.FollowingNudgeBody;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="sn-center">
    <div class="sn-center-inner">
        @if (!Model.IsAuthenticated)
        {
            <partial name="Shared/_RegistrationNudge" />
        }
        else
        {
        <div class="sn-section-header">
        <h2 class="sn-section-title">
            <span class="icon icon-heart" aria-hidden="true"></span>
            @T.Pages.FollowingHeading
        </h2>

        <!-- Tabs -->
        <div class="sn-tabs">
            <a href="/my/follows/discussions" class="sn-tab @(Model.ActiveTab == "discussions" ? "active" : "")">
                @T.Pages.FollowingTabDiscussions
                @if (Model.DiscussionCount > 0) { <span class="badge badge-sm badge-ghost ml-1">@Model.DiscussionCount</span> }
            </a>
            <a href="/my/follows/spaces" class="sn-tab @(Model.ActiveTab == "spaces" ? "active" : "")">
                @T.Pages.FollowingTabSpaces
                @if (Model.SpaceCount > 0) { <span class="badge badge-sm badge-ghost ml-1">@Model.SpaceCount</span> }
            </a>
            <a href="/my/follows/users" class="sn-tab @(Model.ActiveTab == "users" ? "active" : "")">
                @T.Pages.FollowingTabPeople
                @if (Model.UserCount > 0) { <span class="badge badge-sm badge-ghost ml-1">@Model.UserCount</span> }
            </a>
        </div>
        </div>
        <p class="sn-section-description">@T.Pages.FollowingDescription</p>

        @if (Model.ActiveTab == "spaces")
        {
            @if (Model.Spaces.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-archive-layers h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>@T.Pages.FollowingEmptySpaces</p>
                    <p class="mt-1 text-xs opacity-70">@T.Pages.FollowingEmptySpacesHint</p>
                </div>
            }
            else
            {
                <div class="sn-card-list">
                    @foreach (var space in Model.Spaces)
                    {
                        <div class="sn-card sn-card--has-side" data-following-item="space" data-id="@space.PublicId">
                            <div class="sn-card-side">
                                <button type="button" class="sn-card-side-btn sn-card-side-btn--full"
                                        data-unfollow-type="space" data-unfollow-id="@space.PublicId"
                                        title="@T.Card.Remove">
                                    <span class="icon icon-trash w-3 h-3" aria-hidden="true"></span>
                                    @T.Card.Remove
                                </button>
                            </div>
                            <div class="sn-card-body">
                                <div class="sn-space-list-banner" style="background-image: @SpaceGradient(space.PublicId)">
                                    <img src="@space.AvatarUrl" alt="" width="34" height="34"
                                         class="sn-space-list-avatar" loading="lazy" decoding="async" />
                                    <a href="@space.Href" class="sn-space-list-name"
                                       data-popup-type="space" data-popup-id="@space.PublicId" data-popup-name="@space.Name">@space.Name</a>
                                </div>
                                <div class="sn-space-list-body">
                                    @if (!string.IsNullOrEmpty(space.Description))
                                    {
                                        <p class="sn-space-list-desc">@space.Description</p>
                                    }
                                    <div class="sn-space-list-stat-row">
                                        <div class="sn-community-stat-pill">
                                            <span class="sn-community-stat-value">@DisplayHelper.FormatCount(space.DiscussionCount)</span>
                                            <span class="sn-community-stat-label">@T.Pages.FollowingTopicsLabel</span>
                                        </div>
                                        <div class="sn-community-stat-pill">
                                            <span class="sn-community-stat-value">@DisplayHelper.FormatCount(space.ReplyCount)</span>
                                            <span class="sn-community-stat-label">@T.Pages.FollowingRepliesLabel</span>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        else if (Model.ActiveTab == "discussions")
        {
            @if (Model.DiscussionCount == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-chat-bubbles h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>@T.Pages.FollowingEmptyDiscussions</p>
                    <p class="mt-1 text-xs opacity-70">@T.Pages.FollowingEmptyDiscussionsHint</p>
                </div>
            }
            else
            {
                <div class="sn-card-list">
                    @foreach (var discussion in Model.FirstDiscussions)
                    {
                        var followedAt = Model.FollowTimestamps.TryGetValue(discussion.PublicId, out var ft) ? (DateTime?)ft : null;
                        @await Html.PartialAsync("Shared/_DiscussionCard",
                            new DiscussionListItemVM(discussion, Model.ShowCommunityInBreadcrumb, Model.Community, UnfollowId: discussion.PublicId, FollowedAt: followedAt,
                                UnreadCount: discussion.HasUnreadPostCount ? discussion.UnreadPostCount : (int?)null))
                    }
                    @if (Model.DiscussionsHasMore)
                    {
                        <div hx-get="/partials/following-discussions?offset=@Model.DiscussionsNextOffset&pageSize=10"
                             hx-trigger="revealed once"
                             hx-swap="outerHTML"
                             hx-target="this"
                             hx-push-url="false"
                             class="py-2">
                            @for (var i = 0; i < 3; i++)
                            {
                                <div class="sn-card" style="opacity: 0.5">
                                    <div class="sn-card-header">
                                        <div class="skeleton h-3 w-16 rounded"></div>
                                        <div class="skeleton h-4 w-4 rounded-full"></div>
                                        <div class="skeleton h-3 w-20 rounded"></div>
                                    </div>
                                    <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                                    <div class="sn-card-stats mt-2">
                                        <div class="skeleton h-3 w-24 rounded"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else if (Model.FirstDiscussions.Any())
                    {
                        <partial name="Shared/_EndOfScroll" />
                    }
                </div>
            }
        }
        else
        {
            @if (Model.Users.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-users-group h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>@T.Pages.FollowingEmptyPeople</p>
                    <p class="mt-1 text-xs opacity-70">@T.Pages.FollowingEmptyPeopleHint</p>
                </div>
            }
            else
            {
                <div class="sn-mod-list-grid">
                    @foreach (var user in Model.Users)
                    {
                        <div class="sn-mod-list-card" data-following-item="user" data-id="@user.PublicId">
                            <div class="sn-mod-list-banner" style="background-image: @UserGradient(user.PublicId)">
                                <img src="@user.AvatarUrl" alt="" width="34" height="34"
                                     class="sn-mod-list-avatar" loading="lazy" decoding="async" />
                                <a href="@user.Href" class="sn-mod-list-name"
                                   data-popup-type="user" data-popup-id="@user.PublicId" data-popup-name="@user.DisplayName">@user.DisplayName</a>
                                <button class="btn btn-ghost btn-xs ml-auto shrink-0"
                                        style="color: oklch(0.7 0.15 60)"
                                        data-unfollow-type="user" data-unfollow-id="@user.PublicId"
                                        title="@T.Pages.FollowingUnfollow">
                                    <span class="icon icon-user w-3 h-3" aria-hidden="true"></span>
                                    @T.Pages.FollowingUnfollow
                                </button>
                            </div>
                            <div class="sn-mod-list-body">
                                <span class="text-xs" style="color: var(--text-tertiary)">@DisplayHelper.FormatCount(user.FollowerCount) @T.Pages.FollowingFollowersSuffix</span>
                            </div>
                        </div>
                    }
                </div>
            }
        }
        } @* end IsAuthenticated *@
    </div>
</div>

@{
    ViewData["RightPane.NewDiscussionUrl"] = "/create";
    ViewData["RightPane.AboutTitle"] = T.Pages.FollowingAboutTitle;
    ViewData["RightPane.AboutDescription"] = T.Pages.FollowingAboutDesc;
}
<vc:global-right-sidebar />

@section Scripts {
<script src="@SnakkUrlHelper.Js("pages/following")" asp-append-version="true"></script>
}
