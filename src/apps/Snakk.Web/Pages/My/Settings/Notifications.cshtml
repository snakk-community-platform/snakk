@page "/my/settings/notifications"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.My.Settings.NotificationsModel
@{
    Layout = "~/Pages/Shared/_SettingsLayout.cshtml";
    ViewData["Title"] = T.Settings.TitleNotifications;
    ViewData["AuthPrompt.Title"] = T.Settings.NudgeTitleAccess;
    ViewData["Settings.Icon"] = "icon-bell";
    ViewData["Settings.Heading"] = T.Settings.HeadingNotifications;
}

            <!-- Auto-follow -->
            <div id="section-auto-follow" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.NotifAutoFollowTitle</h3>
                <label class="sn-settings-toggle-label">
                    <input type="checkbox"
                           name="autoFollowOnReply"
                           class="sn-toggle sn-toggle-primary" />
                    <span>
                        <span class="sn-font-medium sn-text-sm">@T.Settings.NotifAutoFollowLabel</span>
                        <span class="sn-block sn-text-sm" style="color: var(--text-tertiary)">
                            @T.Settings.NotifAutoFollowHelp
                        </span>
                    </span>
                </label>
            </div>

            <!-- Adult content -->
            <div id="section-adult-content" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.AdultContentTitle</h3>
                <p class="sn-text-sm sn-mb-3" style="color: var(--text-tertiary)">
                    @T.Settings.AdultContentHelp
                </p>
                <div class="sn-settings-option-list">
                    <label class="sn-settings-option-row">
                        <input type="radio" name="allowAdultContent" value="ask" class="sn-radio sn-radio-primary sn-mt-0\.5" />
                        <span class="sn-text-sm">
                            <span class="sn-font-medium">@T.Settings.AdultContentAskTitle</span>
                            <span class="sn-block" style="color: var(--text-tertiary)">@T.Settings.AdultContentAskHelp</span>
                        </span>
                    </label>
                    <label class="sn-settings-option-row">
                        <input type="radio" name="allowAdultContent" value="allow" class="sn-radio sn-radio-primary sn-mt-0\.5" />
                        <span class="sn-text-sm">
                            <span class="sn-font-medium">@T.Settings.AdultContentAllowTitle</span>
                            <span class="sn-block" style="color: var(--text-tertiary)">@T.Settings.AdultContentAllowHelp</span>
                        </span>
                    </label>
                    <label class="sn-settings-option-row">
                        <input type="radio" name="allowAdultContent" value="hide" class="sn-radio sn-radio-primary sn-mt-0\.5" />
                        <span class="sn-text-sm">
                            <span class="sn-font-medium">@T.Settings.AdultContentHideTitle</span>
                            <span class="sn-block" style="color: var(--text-tertiary)">@T.Settings.AdultContentHideHelp</span>
                        </span>
                    </label>
                </div>
            </div>

            <!-- Adult preview image mode -->
            <div id="section-adult-preview-image" class="sn-settings-section">
                <h3 class="sn-settings-section-title">@T.Settings.AdultImagePreviewTitle</h3>
                <p class="sn-text-sm sn-mb-3" style="color: var(--text-tertiary)">
                    @T.Settings.AdultImagePreviewHelp
                </p>
                <div class="sn-settings-option-list">
                    <label class="sn-settings-option-row">
                        <input type="radio" name="adultPreviewImageMode" value="show" class="sn-radio sn-radio-primary sn-mt-0\.5" />
                        <span class="sn-text-sm">
                            <span class="sn-font-medium">@T.Settings.AdultImagePreviewShowTitle</span>
                            <span class="sn-block" style="color: var(--text-tertiary)">@T.Settings.AdultImagePreviewShowHelp</span>
                        </span>
                    </label>
                    <label class="sn-settings-option-row">
                        <input type="radio" name="adultPreviewImageMode" value="blur" class="sn-radio sn-radio-primary sn-mt-0\.5" />
                        <span class="sn-text-sm">
                            <span class="sn-font-medium">@T.Settings.AdultImagePreviewBlurTitle</span>
                            <span class="sn-block" style="color: var(--text-tertiary)">@T.Settings.AdultImagePreviewBlurHelp</span>
                        </span>
                    </label>
                    <label class="sn-settings-option-row">
                        <input type="radio" name="adultPreviewImageMode" value="hide" class="sn-radio sn-radio-primary sn-mt-0\.5" />
                        <span class="sn-text-sm">
                            <span class="sn-font-medium">@T.Settings.AdultImagePreviewHideTitle</span>
                            <span class="sn-block" style="color: var(--text-tertiary)">@T.Settings.AdultImagePreviewHideHelp</span>
                        </span>
                    </label>
                </div>
            </div>
<script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true"></script>
