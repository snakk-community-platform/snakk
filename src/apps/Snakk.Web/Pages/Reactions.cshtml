@page "/reactions"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.Partials
@model Snakk.Web.Pages.ReactionsModel
@{
    ViewData["Title"] = T.Pages.ReactionsTitle;
    ViewData["Description"] = "Discussions and posts you have reacted to.";
    ViewData["Nudge.Title"] = T.Pages.ReactionsNudgeTitle;
    ViewData["Nudge.Body"] = T.Pages.ReactionsNudgeBody;

    var isDiscussionsTab = Model.Tab != "posts";
    var partialUrl = isDiscussionsTab
        ? $"/partials/reacted-discussions?offset={Model.NextOffset}&pageSize=10"
        : $"/partials/reacted-posts?offset={Model.NextOffset}&pageSize=10";
}

@section Styles {
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("discussion-list")" asp-append-version="true" />
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="sn-center">
    <div class="sn-center-inner">
        @if (!Model.IsAuthenticated)
        {
            <partial name="Shared/_RegistrationNudge" />
        }
        else
        {
            <h2 class="sn-section-title">
                <span class="icon icon-emoji-happy" aria-hidden="true"></span>
                @T.Pages.ReactionsHeading
            </h2>

            <div class="flex border-b mb-4" style="border-color: var(--border-subtle)">
                <a href="/reactions"
                   class="px-4 py-2 text-sm font-medium border-b-2 -mb-px @(isDiscussionsTab ? "" : "border-transparent hover:underline")"
                   style="@(isDiscussionsTab ? "border-color: var(--color-primary); color: var(--color-primary)" : "color: var(--text-muted)")">
                    @T.Pages.ReactionsTabDiscussions
                </a>
                <a href="/reactions?tab=posts"
                   class="px-4 py-2 text-sm font-medium border-b-2 -mb-px @(!isDiscussionsTab ? "" : "border-transparent hover:underline")"
                   style="@(!isDiscussionsTab ? "border-color: var(--color-primary); color: var(--color-primary)" : "color: var(--text-muted)")">
                    @T.Pages.ReactionsTabPosts
                </a>
            </div>

            var hasItems = isDiscussionsTab ? Model.Discussions.Any() : Model.Items.Any();
            @if (!hasItems)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-emoji-happy h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>@T.Pages.ReactionsEmpty</p>
                    <p class="mt-1 text-xs opacity-70">
                        @(isDiscussionsTab ? T.Pages.ReactionsEmptyHintD : T.Pages.ReactionsEmptyHintP)
                    </p>
                </div>
            }
            else if (isDiscussionsTab)
            {
                <div id="discussions-container" class="h-feed">
                    @foreach (var pair in Model.Discussions)
                    {
                        <div class="sn-reaction-strip">
                            <span class="sn-reaction-emoji">@pair.Reaction.ReactionEmoji</span>
                            <span class="sn-reaction-time">
                                <time data-timestamp="@pair.Reaction.ReactedAt.ToString("O")">@DisplayHelper.FormatRelativeTime(pair.Reaction.ReactedAt)</time>
                            </span>
                        </div>
                        @await Html.PartialAsync("Shared/_DiscussionCard",
                            new Snakk.Web.Pages.ViewModels.DiscussionListItemVM(pair.Discussion, ShowCommunity: true, Model.Community))
                    }

                    @if (Model.HasMoreItems)
                    {
                        <div hx-get="@partialUrl"
                             hx-trigger="revealed once"
                             hx-swap="outerHTML"
                             hx-target="this"
                             hx-push-url="false"
                             class="py-2">
                            @for (var i = 0; i < 3; i++)
                            {
                                <div class="sn-card" style="opacity: 0.5">
                                    <div class="sn-card-header">
                                        <div class="skeleton h-3 w-16 rounded"></div>
                                        <div class="skeleton h-4 w-4 rounded-full"></div>
                                        <div class="skeleton h-3 w-20 rounded"></div>
                                    </div>
                                    <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                                    <div class="sn-card-stats mt-2">
                                        <div class="skeleton h-3 w-24 rounded"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <partial name="Shared/_EndOfScroll" />
                    }
                </div>
            }
            else
            {
                <div class="topic-list">
                    @foreach (var item in Model.Items)
                    {
                        <div class="sn-reaction-strip">
                            <span class="sn-reaction-emoji">@item.ReactionEmoji</span>
                            <span class="sn-reaction-time">
                                <time data-timestamp="@item.ReactedAt.ToString("O")">@DisplayHelper.FormatRelativeTime(item.ReactedAt)</time>
                            </span>
                        </div>
                        @await Html.PartialAsync("Shared/_PostTopicItem", item.ToPostListItem())
                    }

                    @if (Model.HasMoreItems)
                    {
                        <div hx-get="@partialUrl"
                             hx-trigger="revealed once"
                             hx-swap="outerHTML"
                             hx-target="this"
                             hx-push-url="false"
                             class="py-2">
                            @for (var i = 0; i < 3; i++)
                            {
                                <div class="topic-item-wrapper" style="opacity: 0.5">
                                    <div class="topic-item">
                                        <div class="topic-content">
                                            <div class="skeleton h-4 w-3/4 rounded"></div>
                                            <div class="skeleton h-3 w-1/3 rounded mt-1"></div>
                                            <div class="skeleton h-3 w-full rounded mt-2"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <partial name="Shared/_EndOfScroll" />
                    }
                </div>
            }
        }
    </div>
</div>

<aside class="sn-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
    ViewData["RightPane.AboutTitle"] = T.Pages.ReactionsAboutTitle;
    ViewData["RightPane.AboutDescription"] = T.Pages.ReactionsAboutDesc;
}
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="sn-right-body">
    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-chart-bar" aria-hidden="true"></span>
            @T.Sections.SiteStats
        </div>
        <div hx-get="/partials/platform-stats?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="grid grid-cols-2 gap-3">
                <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-16"></div></div>
                <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-10"></div></div>
            </div>
        </div>
    </div>

    <partial name="Shared/_RightAboutSection" />

    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-archive-layers" aria-hidden="true"></span>
            @T.Sections.ActiveSpaces
        </div>
        <div hx-get="/partials/trending-spaces?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
            </div>
        </div>
    </div>

    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-users-group" aria-hidden="true"></span>
            @T.Sections.ActiveContributors
        </div>
        <div hx-get="/partials/trending-contributors?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
            </div>
        </div>
    </div>
    </div>
</div>
</aside>
