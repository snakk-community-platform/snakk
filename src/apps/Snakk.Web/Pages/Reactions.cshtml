@page "/reactions"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.Partials
@model Snakk.Web.Pages.ReactionsModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Reactions";
    ViewData["Description"] = "Posts you have reacted to.";
    ViewData["AuthPrompt.Title"] = "Sign in to view your reactions";
    ViewData["AuthPrompt.Message"] = "Posts you react to will appear here.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="fp-center">
    <div class="fp-center-inner">
        @if (!Model.IsAuthenticated)
        {
            <partial name="Shared/_AuthPrompt" />
        }
        else
        {
            <h2 class="fp-section-title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                </svg>
                Reactions
            </h2>

            @if (!Model.Items.Any())
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <svg xmlns="http://www.w3.org/2000/svg" class="h-10 w-10 mx-auto mb-3 opacity-30" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="1.5">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                    </svg>
                    <p>No reactions yet.</p>
                    <p class="mt-1 text-xs opacity-70">Posts you react to will appear here.</p>
                </div>
            }
            else
            {
                <div style="display:flex;flex-direction:column;gap:1.5rem">
                    @foreach (var post in Model.Items)
                    {
                        var discussionUrl = SnakkUrlHelper.Discussion(
                            post.CommunitySlug, Model.Community,
                            post.HubSlug, post.SpaceSlug,
                            SnakkUrlHelper.DiscussionSlugId(post.DiscussionSlug, post.DiscussionPublicId));
                        var postUrl = $"{discussionUrl}#post-{post.PublicId}";
                        var avatarUrl = SnakkUrlHelper.UserAvatar(post.AuthorPublicId, avatarFileName: post.AuthorAvatarFileName);

                        <div class="clean-card p-4">
                            <div class="flex items-center gap-2 mb-2">
                                <span class="text-base">@post.ReactionEmoji</span>
                                <span class="text-xs" style="color: var(--text-tertiary)">
                                    <time data-timestamp="@post.ReactedAt.ToString("O")">@DisplayHelper.FormatRelativeTime(post.ReactedAt)</time>
                                </span>
                            </div>
                            <a href="@discussionUrl" class="text-sm font-semibold hover:underline" style="color: var(--text-primary)">
                                @post.DiscussionTitle
                            </a>
                            @if (!string.IsNullOrEmpty(post.ContentExcerpt))
                            {
                                <p class="text-sm mt-1 line-clamp-3" style="color: var(--text-secondary)">@post.ContentExcerpt</p>
                            }
                            <div class="flex items-center gap-2 mt-2">
                                <img src="@avatarUrl" alt="" width="20" height="20" class="w-5 h-5 rounded-full" loading="lazy" decoding="async" />
                                <a href="/u/@post.AuthorPublicId" class="text-xs hover:underline" style="color: var(--text-tertiary)">@post.AuthorDisplayName</a>
                                <a href="@postUrl" class="ml-auto text-xs" style="color: var(--link-primary)">View post &rarr;</a>
                            </div>
                        </div>
                    }

                    @if (Model.HasMoreItems)
                    {
                        <div hx-get="/partials/reacted-posts?offset=@Model.NextOffset&pageSize=10"
                             hx-trigger="revealed"
                             hx-swap="outerHTML"
                             hx-target="this"
                             hx-push-url="false"
                             class="py-2">
                            @for (var i = 0; i < 2; i++)
                            {
                                <div class="clean-card p-4" style="opacity: 0.5">
                                    <div class="skeleton h-3 w-24 rounded mb-2"></div>
                                    <div class="skeleton h-4 w-3/4 rounded"></div>
                                    <div class="skeleton h-3 w-full rounded mt-2"></div>
                                    <div class="flex items-center gap-2 mt-3">
                                        <div class="skeleton h-5 w-5 rounded-full"></div>
                                        <div class="skeleton h-3 w-20 rounded"></div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <partial name="Shared/_EndOfScroll" />
                    }
                </div>
            }
        }
    </div>
</div>

<aside class="fp-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<div class="fp-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="fp-right-body">
    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            Site Stats
        </div>
        <div hx-get="/partials/platform-stats?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="grid grid-cols-2 gap-3">
                <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-16"></div></div>
                <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-10"></div></div>
            </div>
        </div>
    </div>

    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M19 11H5m14 0a2 2 0 012 2v6a2 2 0 01-2 2H5a2 2 0 01-2-2v-6a2 2 0 012-2m14 0V9a2 2 0 00-2-2M5 11V9a2 2 0 012-2m0 0V5a2 2 0 012-2h6a2 2 0 012 2v2M7 7h10" /></svg>
            Active Spaces
        </div>
        <div hx-get="/partials/trending-spaces?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
            </div>
        </div>
    </div>

    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0z" /></svg>
            Active Contributors
        </div>
        <div hx-get="/partials/trending-contributors?scopeType=platform&scopeId=global"
             hx-trigger="load"
             hx-target="this"
             hx-swap="innerHTML">
            <div class="flex flex-col gap-3">
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
            </div>
        </div>
    </div>
    </div>
</div>
</aside>
