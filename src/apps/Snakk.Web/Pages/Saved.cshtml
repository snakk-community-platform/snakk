@page "/saved"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@model Snakk.Web.Pages.SavedModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Saved";
    ViewData["Description"] = "Your saved discussions and posts.";
    ViewData["Nudge.Title"] = "Sign in to save discussions";
    ViewData["Nudge.Body"] = "Bookmark discussions and posts to find them here.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="fp-center">
    <div class="fp-center-inner">
        @if (!Model.IsAuthenticated)
        {
            <partial name="Shared/_RegistrationNudge" />
        }
        else
        {
        <h2 class="fp-section-title">
            <span class="icon icon-bookmark-alt" aria-hidden="true"></span>
            Saved
        </h2>

        <!-- Tabs -->
        <div class="flex gap-1 mb-4 border-b border-subtle">
            <a href="/saved?tab=discussions"
               class="px-4 py-2 text-sm font-medium transition-colors @(Model.ActiveTab == "discussions" ? "border-b-2 border-primary text-primary -mb-px" : "text-base-content/60 hover:text-base-content/80")">
                Discussions
                @if (Model.DiscussionCount > 0)
                {
                    <span class="badge badge-sm badge-ghost ml-1">@Model.DiscussionCount</span>
                }
            </a>
            <a href="/saved?tab=posts"
               class="px-4 py-2 text-sm font-medium transition-colors @(Model.ActiveTab == "posts" ? "border-b-2 border-primary text-primary -mb-px" : "text-base-content/60 hover:text-base-content/80")">
                Posts
                @if (Model.PostCount > 0)
                {
                    <span class="badge badge-sm badge-ghost ml-1">@Model.PostCount</span>
                }
            </a>
        </div>

        @if (Model.ActiveTab == "discussions")
        {
            @if (Model.SavedDiscussions == null || Model.SavedDiscussions.Items.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-bookmark h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>No saved discussions yet.</p>
                    <p class="mt-1 text-xs opacity-70">Bookmark discussions to find them here.</p>
                </div>
            }
            else
            {
                <div class="fp-card-list">
                    @foreach (var discussion in Model.SavedDiscussions.Items)
                    {
                        @await Html.PartialAsync("Shared/_DiscussionCard",
                            new DiscussionListItemVM(discussion, Model.ShowCommunityInBreadcrumb, Model.Community))
                    }
                </div>
                @if (Model.SavedDiscussions.HasMoreItems)
                {
                    var nextOffset = Model.Offset + Model.SavedDiscussions.Items.Count;
                    <div hx-get="/partials/saved-discussions?offset=@nextOffset&pageSize=20"
                         hx-trigger="revealed"
                         hx-swap="outerHTML"
                         hx-target="this"
                         hx-push-url="false"
                         class="py-2">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="fp-card" style="opacity: 0.5">
                                <div class="fp-card-header">
                                    <div class="skeleton h-3 w-16 rounded"></div>
                                    <div class="skeleton h-4 w-4 rounded-full"></div>
                                    <div class="skeleton h-3 w-20 rounded"></div>
                                </div>
                                <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                                <div class="fp-card-stats mt-2">
                                    <div class="skeleton h-3 w-24 rounded"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
        else
        {
            @if (Model.SavedPosts == null || Model.SavedPosts.Items.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-bookmark h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>No saved posts yet.</p>
                    <p class="mt-1 text-xs opacity-70">Bookmark posts to find them here.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col gap-3">
                    @foreach (var post in Model.SavedPosts.Items)
                    {
                        @await Html.PartialAsync("Shared/_PostListItem", PostListItemVM.FromSavedPost(post))
                    }
                </div>
                @if (Model.SavedPosts.HasMoreItems)
                {
                    var nextOffset = Model.Offset + Model.SavedPosts.Items.Count;
                    <div hx-get="/partials/saved-posts?offset=@nextOffset&pageSize=20"
                         hx-trigger="revealed"
                         hx-swap="outerHTML"
                         hx-target="this"
                         hx-push-url="false"
                         class="py-2">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="clean-card p-4" style="opacity: 0.5">
                                <div class="skeleton h-4 w-3/4 rounded"></div>
                                <div class="skeleton h-3 w-full rounded mt-2"></div>
                                <div class="skeleton h-3 w-2/3 rounded mt-1"></div>
                                <div class="flex items-center gap-2 mt-3">
                                    <div class="skeleton h-5 w-5 rounded-full"></div>
                                    <div class="skeleton h-3 w-20 rounded"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
        } @* end IsAuthenticated *@
    </div>
</div>

@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<partial name="Shared/_GlobalRightSidebar" />
