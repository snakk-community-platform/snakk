@page "/saved"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@model Snakk.Web.Pages.SavedModel
@{
    ViewData["Title"] = T.Pages.SavedTitle;
    ViewData["Description"] = "Your saved discussions and posts.";
    ViewData["Nudge.Title"] = T.Pages.SavedNudgeTitle;
    ViewData["Nudge.Body"] = T.Pages.SavedNudgeBody;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="sn-center">
    <div class="sn-center-inner">
        @if (!Model.IsAuthenticated)
        {
            <partial name="Shared/_RegistrationNudge" />
        }
        else
        {
        <h2 class="sn-section-title">
            <span class="icon icon-bookmark-alt" aria-hidden="true"></span>
            @T.Pages.SavedHeading
        </h2>

        <!-- Tabs -->
        <div class="sn-tabs mb-4">
            <a href="/saved?tab=discussions" class="sn-tab @(Model.ActiveTab == "discussions" ? "active" : "")">
                @T.Pages.SavedTabDiscussions
                @if (Model.DiscussionCount > 0) { <span class="badge badge-sm badge-ghost ml-1">@Model.DiscussionCount</span> }
            </a>
            <a href="/saved?tab=posts" class="sn-tab @(Model.ActiveTab == "posts" ? "active" : "")">
                @T.Pages.SavedTabPosts
                @if (Model.PostCount > 0) { <span class="badge badge-sm badge-ghost ml-1">@Model.PostCount</span> }
            </a>
        </div>

        @if (Model.ActiveTab == "discussions")
        {
            @if (Model.SavedDiscussions == null || Model.SavedDiscussions.Items.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-bookmark h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>@T.Pages.SavedEmptyDiscussions</p>
                    <p class="mt-1 text-xs opacity-70">@T.Pages.SavedEmptyDiscussionsHint</p>
                </div>
            }
            else
            {
                <div class="sn-card-list">
                    @foreach (var discussion in Model.SavedDiscussions.Items)
                    {
                        @await Html.PartialAsync("Shared/_DiscussionCard",
                            new DiscussionListItemVM(discussion, Model.ShowCommunityInBreadcrumb, Model.Community))
                    }
                </div>
                @if (Model.SavedDiscussions.HasMoreItems)
                {
                    var nextOffset = Model.Offset + Model.SavedDiscussions.Items.Count;
                    <div hx-get="/partials/saved-discussions?offset=@nextOffset&pageSize=20"
                         hx-trigger="revealed once"
                         hx-swap="outerHTML"
                         hx-target="this"
                         hx-push-url="false"
                         class="py-2">
                        @for (var i = 0; i < 3; i++)
                        {
                            <div class="sn-card" style="opacity: 0.5">
                                <div class="sn-card-header">
                                    <div class="skeleton h-3 w-16 rounded"></div>
                                    <div class="skeleton h-4 w-4 rounded-full"></div>
                                    <div class="skeleton h-3 w-20 rounded"></div>
                                </div>
                                <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                                <div class="sn-card-stats mt-2">
                                    <div class="skeleton h-3 w-24 rounded"></div>
                                </div>
                            </div>
                        }
                    </div>
                }
            }
        }
        else
        {
            @if (Model.SavedPosts == null || Model.SavedPosts.Items.Count == 0)
            {
                <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
                    <span class="icon icon-bookmark h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                    <p>@T.Pages.SavedEmptyPosts</p>
                    <p class="mt-1 text-xs opacity-70">@T.Pages.SavedEmptyPostsHint</p>
                </div>
            }
            else
            {
                <div class="topic-list">
                    @foreach (var post in Model.SavedPosts.Items)
                    {
                        @await Html.PartialAsync("Shared/_PostTopicItem", PostListItemVM.FromSavedPost(post))
                    }
                    @if (Model.SavedPosts.HasMoreItems)
                    {
                        var nextOffset = Model.Offset + Model.SavedPosts.Items.Count;
                        <div hx-get="/partials/saved-posts?offset=@nextOffset&pageSize=20"
                             hx-trigger="revealed once"
                             hx-swap="outerHTML"
                             hx-target="this"
                             hx-push-url="false">
                            @for (var i = 0; i < 3; i++)
                            {
                                <div class="topic-item-wrapper" style="opacity: 0.5">
                                    <div class="topic-item">
                                        <div class="topic-content">
                                            <div class="skeleton h-4 w-3/4 rounded"></div>
                                            <div class="skeleton h-3 w-1/3 rounded mt-1"></div>
                                            <div class="skeleton h-3 w-full rounded mt-2"></div>
                                        </div>
                                    </div>
                                </div>
                            }
                        </div>
                    }
                </div>
            }
        }
        } @* end IsAuthenticated *@
    </div>
</div>

@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
    ViewData["RightPane.AboutTitle"] = T.Pages.SavedHeading;
    ViewData["RightPane.AboutDescription"] = T.Pages.SavedAboutDesc;
}
<partial name="Shared/_GlobalRightSidebar" />
