@page "/new"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.NewDiscussionModel
@{
    Layout = "_Layout";
    ViewData["Title"] = T.Pages.NewDiscussionTitle;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@if (User.Identity?.IsAuthenticated != true) {
    ViewData["Nudge.Title"] = T.Pages.NewDiscussionNudgeTitle;
    ViewData["Nudge.Body"] = T.Pages.NewDiscussionNudgeBody;
    <div class="sn-center"><div class="sn-center-inner"><partial name="Shared/_RegistrationNudge" /></div></div>
    return;
}

<div class="sn-center">
    <div class="sn-center-inner">
        <div class="max-w-3xl py-8">
            <h1 class="text-xl font-semibold mb-6">@T.Pages.NewDiscussionHeading</h1>

            <!-- Space Selector -->
            <div class="mb-6">
                <label class="text-sm font-medium text-base-content/70 mb-2 block">@T.Pages.NewDiscussionSpaceLabel <span class="text-error">*</span></label>
                <div id="space-selector"
                     class="relative"
                     data-scope-hub-id="@(Model.ScopeHubId ?? "")"
                     data-scope-community-id="@(Model.ScopeCommunityId ?? "")"
                     data-scope-hub-name="@(Model.ScopeHubName ?? "")"
                     data-scope-community-name="@(Model.ScopeCommunityName ?? "")"
                     data-preselected-space-id="@(Model.PreselectedSpaceId ?? "")">
                    <div>
                        <input type="text"
                               id="space-search-input"
                               class="input w-full"
                               placeholder="@T.Pages.NewDiscussionSearchPh"
                               autocomplete="off" />
                        <input type="hidden" id="selected-space-id" />
                        <input type="hidden" id="selected-space-slug" />
                        <input type="hidden" id="selected-hub-slug" />
                        <input type="hidden" id="selected-community-slug" />
                    </div>

                    <!-- Dropdown -->
                    <div id="space-dropdown" class="absolute z-50 w-full mt-1 bg-base-100 border border-base-content/10 rounded-lg shadow-lg max-h-64 overflow-y-auto hidden">
                    </div>
                </div>
            </div>

            <!-- Type Picker (shown after space is selected) -->
            <div id="type-picker-section" class="hidden">
                <p class="text-sm text-base-content/60 mb-4">@T.Pages.NewDiscussionTypePrompt</p>
                <div class="grid grid-cols-1 sm:grid-cols-2 gap-3" id="type-cards">
                </div>
            </div>

            <div class="mt-6">
                <button type="button" class="btn btn-ghost btn-sm" data-action="go-back">@T.Pages.NewDiscussionCancel</button>
            </div>
        </div>
    </div>
</div>

@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<partial name="Shared/_GlobalRightSidebar" />

<script src="@SnakkUrlHelper.Js("pages/new-discussion-entry")" asp-append-version="true"></script>
