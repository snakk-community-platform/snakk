@page "/help/{slug?}"
@model HelpModel
@{
    ViewData["Title"] = Model.ArticleTitle + T.Pages.HelpTitleSuffix;
}

@section Styles {
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("help")" asp-append-version="true" />
}

@section LeftColumn {
    <partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div id="help-main" class="sn-center-inner">
        <h2 class="sn-section-title">
            <span class="icon icon-question-circle" aria-hidden="true"></span>
            @T.Pages.HelpHeading
        </h2>
        <article class="help-content">
            <h1>@Model.ArticleTitle</h1>
            <div class="prose">
                @Html.Raw(Model.RenderedHtml)
            </div>
        </article>
    </div>
</div>

<!-- Right Column -->
<aside class="sn-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="sn-right-body">
    <div class="sn-right-section">
        <div class="sn-right-title">@T.Pages.HelpCenterTitle</div>
        <nav id="help-sidebar-nav" class="help-sidebar">
            @foreach (var s in Model.Sections)
            {
                <div class="help-section">
                    <div class="help-section-title">@s.Title</div>
                    @foreach (var article in s.Items)
                    {
                        <a href="/help/@article.Slug"
                           hx-get="/help/@article.Slug"
                           hx-target="#help-main"
                           hx-select="#help-main"
                           hx-select-oob="#help-sidebar-nav"
                           hx-swap="outerHTML"
                           hx-push-url="true"
                           class="help-nav-item @(article.Slug == Model.Slug ? "help-nav-active" : "")">
                            @article.Title
                        </a>
                    }
                </div>
            }
        </nav>
    </div>
    </div>
</div>
</aside>
