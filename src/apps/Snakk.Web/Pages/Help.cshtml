@page "/help/{slug?}"
@model HelpModel
@{
    ViewData["Title"] = Model.ArticleTitle + T.Pages.HelpTitleSuffix;
}

@section LeftColumn {
    <partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div id="help-main" class="sn-center-inner">
        <div class="sn-section-header">
            <h2 class="sn-section-title">
                <span class="icon icon-question-circle" aria-hidden="true"></span>
                @T.Pages.HelpHeading
            </h2>
        </div>
        <article class="sn-help-content">
            @if (!string.IsNullOrEmpty(Model.SectionTitle))
            {
                <div class="sn-help-article-category">@Model.SectionTitle</div>
            }
            <h1>@Model.ArticleTitle</h1>
            <div class="sn-prose">
                @Html.SanitizedRaw(Model.RenderedHtml)
            </div>
        </article>
        @if (Model.PrevArticle is not null || Model.NextArticle is not null)
        {
            <nav class="sn-help-article-nav" aria-label="@T.Pages.HelpArticleNav">
                <div>
                    @if (Model.PrevArticle is not null)
                    {
                        <a href="/help/@Model.PrevArticle.Slug"
                           hx-get="/help/@Model.PrevArticle.Slug"
                           hx-target="#help-main"
                           hx-select="#help-main"
                           hx-select-oob="#help-sidebar-nav"
                           hx-swap="outerHTML"
                           hx-push-url="true"
                           class="sn-help-article-nav-link">
                            <span class="sn-help-article-nav-label">← @T.Pages.HelpPrev</span>
                            <span class="sn-help-article-nav-title">@Model.PrevArticle.Title</span>
                        </a>
                    }
                </div>
                <div>
                    @if (Model.NextArticle is not null)
                    {
                        <a href="/help/@Model.NextArticle.Slug"
                           hx-get="/help/@Model.NextArticle.Slug"
                           hx-target="#help-main"
                           hx-select="#help-main"
                           hx-select-oob="#help-sidebar-nav"
                           hx-swap="outerHTML"
                           hx-push-url="true"
                           class="sn-help-article-nav-link sn-help-article-nav-link--next">
                            <span class="sn-help-article-nav-label">@T.Pages.HelpNext →</span>
                            <span class="sn-help-article-nav-title">@Model.NextArticle.Title</span>
                        </a>
                    }
                </div>
            </nav>
        }
    </div>
</div>

<!-- Right Column -->
@if (!DeviceDetection.IsMobile(HttpContext))
{
<aside class="sn-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/create";
}
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="sn-right-body">
    @if (Model.TableOfContents.Count > 1)
    {
        <div class="sn-right-section">
            <div class="sn-right-title">@T.Pages.HelpInThisArticle</div>
            <nav class="sn-help-toc">
                @foreach (var (id, text) in Model.TableOfContents)
                {
                    <a href="#@id" class="sn-help-toc-item">@text</a>
                }
            </nav>
        </div>
    }
    <div class="sn-right-section">
        <div class="sn-right-title">@T.Pages.HelpCenterTitle</div>
        <nav id="help-sidebar-nav" class="sn-help-sidebar">
            @foreach (var s in Model.Sections)
            {
                <div class="sn-help-section">
                    <div class="sn-help-section-title">@s.Title</div>
                    @foreach (var article in s.Items)
                    {
                        <a href="/help/@article.Slug"
                           hx-get="/help/@article.Slug"
                           hx-target="#help-main"
                           hx-select="#help-main"
                           hx-select-oob="#help-sidebar-nav"
                           hx-swap="outerHTML"
                           hx-push-url="true"
                           class="sn-help-nav-item @(article.Slug == Model.Slug ? "sn-help-nav-active" : "")">
                            @article.Title
                        </a>
                    }
                </div>
            }
        </nav>
    </div>
    </div>
</div>
</aside>
}
