@page "/partials/share-menu"
@model Snakk.Web.Pages.Partials.ShareMenuModel
@{
    Layout = null;
    var eu = Uri.EscapeDataString(Model.ShareUrl);
    var et = Uri.EscapeDataString(Model.Title);
    var ewt = Uri.EscapeDataString($"{Model.Title} {Model.ShareUrl}");
}

<li>
    <button class="sn-text-sm" data-action="copy-discussion-link" data-discussion-url="@Model.ShareUrl">
        <span class="sn-icon icon-copy-link" aria-hidden="true"></span>
        @T.Pages.ShareCopyLink
    </button>
</li>
@if (Model.IsPublic)
{
<li>
    <a href="https://x.com/intent/tweet?url=@eu&text=@et" target="_blank" rel="noopener noreferrer" class="sn-text-sm">
        <span class="sn-icon icon-brand-x" aria-hidden="true"></span>
        @T.Pages.ShareX
    </a>
</li>
<li>
    <a href="https://www.reddit.com/submit?url=@eu&title=@et" target="_blank" rel="noopener noreferrer" class="sn-text-sm">
        <span class="sn-icon icon-brand-reddit" aria-hidden="true"></span>
        @T.Pages.ShareReddit
    </a>
</li>
<li>
    <a href="https://www.facebook.com/sharer/sharer.php?u=@eu" target="_blank" rel="noopener noreferrer" class="sn-text-sm">
        <span class="sn-icon icon-brand-facebook" aria-hidden="true"></span>
        @T.Pages.ShareFacebook
    </a>
</li>
<li>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url=@eu" target="_blank" rel="noopener noreferrer" class="sn-text-sm">
        <span class="sn-icon icon-brand-linkedin" aria-hidden="true"></span>
        @T.Pages.ShareLinkedIn
    </a>
</li>
<li>
    <a href="https://wa.me/?text=@ewt" target="_blank" rel="noopener noreferrer" class="sn-text-sm">
        <span class="sn-icon icon-brand-whatsapp" aria-hidden="true"></span>
        @T.Pages.ShareWhatsApp
    </a>
</li>
<li>
    <a href="https://t.me/share/url?url=@eu&text=@et" target="_blank" rel="noopener noreferrer" class="sn-text-sm">
        <span class="sn-icon icon-brand-telegram" aria-hidden="true"></span>
        @T.Pages.ShareTelegram
    </a>
</li>
<li>
    <a href="https://news.ycombinator.com/submitlink?u=@eu&t=@et" target="_blank" rel="noopener noreferrer" class="sn-text-sm">
        <span class="sn-icon icon-brand-hackernews" aria-hidden="true"></span>
        @T.Pages.ShareHackerNews
    </a>
</li>
<li>
    <a href="mailto:?subject=@et&body=@eu" class="sn-text-sm">
        <span class="sn-icon icon-email" aria-hidden="true"></span>
        @T.Pages.ShareEmail
    </a>
</li>
}
