@page "/partials/share-menu"
@model Snakk.Web.Pages.Partials.ShareMenuModel
@{
    Layout = null;
    var eu = Uri.EscapeDataString(Model.ShareUrl);
    var et = Uri.EscapeDataString(Model.Title);
    var ewt = Uri.EscapeDataString($"{Model.Title} {Model.ShareUrl}");
}

<li>
    <button class="text-sm" data-action="copy-discussion-link" data-discussion-url="@Model.ShareUrl">
        <span class="icon icon-copy-link h-4 w-4" aria-hidden="true"></span>
        Copy link
    </button>
</li>
@if (Model.IsPublic)
{
<li>
    <a href="https://x.com/intent/tweet?url=@eu&text=@et" target="_blank" rel="noopener noreferrer" class="text-sm">
        <span class="icon icon-brand-x h-4 w-4" aria-hidden="true"></span>
        Share on X
    </a>
</li>
<li>
    <a href="https://www.reddit.com/submit?url=@eu&title=@et" target="_blank" rel="noopener noreferrer" class="text-sm">
        <span class="icon icon-brand-reddit h-4 w-4" aria-hidden="true"></span>
        Share on Reddit
    </a>
</li>
<li>
    <a href="https://www.facebook.com/sharer/sharer.php?u=@eu" target="_blank" rel="noopener noreferrer" class="text-sm">
        <span class="icon icon-brand-facebook h-4 w-4" aria-hidden="true"></span>
        Share on Facebook
    </a>
</li>
<li>
    <a href="https://www.linkedin.com/sharing/share-offsite/?url=@eu" target="_blank" rel="noopener noreferrer" class="text-sm">
        <span class="icon icon-brand-linkedin h-4 w-4" aria-hidden="true"></span>
        Share on LinkedIn
    </a>
</li>
<li>
    <a href="https://wa.me/?text=@ewt" target="_blank" rel="noopener noreferrer" class="text-sm">
        <span class="icon icon-brand-whatsapp h-4 w-4" aria-hidden="true"></span>
        Share on WhatsApp
    </a>
</li>
<li>
    <a href="https://t.me/share/url?url=@eu&text=@et" target="_blank" rel="noopener noreferrer" class="text-sm">
        <span class="icon icon-brand-telegram h-4 w-4" aria-hidden="true"></span>
        Share on Telegram
    </a>
</li>
<li>
    <a href="https://news.ycombinator.com/submitlink?u=@eu&t=@et" target="_blank" rel="noopener noreferrer" class="text-sm">
        <span class="icon icon-brand-hackernews h-4 w-4" aria-hidden="true"></span>
        Hacker News
    </a>
</li>
<li>
    <a href="mailto:?subject=@et&body=@eu" class="text-sm">
        <span class="icon icon-email h-4 w-4" aria-hidden="true"></span>
        Send via Email
    </a>
</li>
}
