@page "/partials/space-discussions"
@using Snakk.Web.Pages.ViewModels
@model Snakk.Web.Pages.Partials.SpaceDiscussionsModel
@{
    Layout = null;
}

@foreach (var discussion in Model.Items)
{
    <partial name="Shared/_SpaceDiscussionListItem"
             model="new SpaceDiscussionListItemVM(discussion, Model.Community, Model.HubSlug, Model.SpaceSlug)" />
}

@if (Model.HasMoreItems && Model.NextCursor != null && Model.NextOffset < Model.MaxOffset)
{
    <div hx-get="/partials/space-discussions?spaceId=@Model.SpaceId&cursor=@Model.NextCursor&offset=@Model.NextOffset&pageSize=20@(Model.TypeFilter.HasValue ? $"&typeFilter={Model.TypeFilter}" : "")"
         hx-trigger="revealed once"
         hx-swap="outerHTML"
         hx-target="this"
         hx-push-url="false"
         class="sn-py-1">
        <div class="sn-topic-item-wrapper">
            <div class="sn-skeleton sn-avatar sn-shrink-0 sn-mr-2 sn-hidden sm:block"></div>
            <div class="sn-topic-item sn-flex-1">
                <div class="sn-skeleton sn-h-4 w-3/4 sn-mb-2"></div>
                <div class="sn-skeleton h-3 w-1/2"></div>
            </div>
        </div>
        <div class="sn-topic-item-wrapper">
            <div class="sn-skeleton sn-avatar sn-shrink-0 sn-mr-2 sn-hidden sm:block"></div>
            <div class="sn-topic-item sn-flex-1">
                <div class="sn-skeleton sn-h-4 w-2/3 sn-mb-2"></div>
                <div class="sn-skeleton h-3 w-2/5"></div>
            </div>
        </div>
        <div class="sn-topic-item-wrapper">
            <div class="sn-skeleton sn-avatar sn-shrink-0 sn-mr-2 sn-hidden sm:block"></div>
            <div class="sn-topic-item sn-flex-1">
                <div class="sn-skeleton sn-h-4 w-4/5 sn-mb-2"></div>
                <div class="sn-skeleton h-3 w-1/3"></div>
            </div>
        </div>
    </div>
}
else if (Model.Items.Any())
{
    <partial name="Shared/_EndOfScroll" />
}
