@page "/partials/space-discussions"
@using Snakk.Web.Pages.ViewModels
@model Snakk.Web.Pages.Partials.SpaceDiscussionsModel
@{
    Layout = null;
}

@foreach (var discussion in Model.Items)
{
    <partial name="Shared/_SpaceDiscussionListItem"
             model="new SpaceDiscussionListItemVM(discussion, Model.Community, Model.HubSlug, Model.SpaceSlug)" />
}

@if (Model.HasMoreItems && Model.NextCursor != null)
{
    <div hx-get="/partials/space-discussions?spaceId=@Model.SpaceId&cursor=@Model.NextCursor&pageSize=20@(Model.TypeFilter.HasValue ? $"&typeFilter={Model.TypeFilter}" : "")"
         hx-trigger="revealed"
         hx-swap="outerHTML"
         hx-target="this"
         hx-push-url="false"
         class="py-1">
        <div class="topic-item-wrapper">
            <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
            <div class="topic-item flex-1">
                <div class="skeleton h-4 w-3/4 mb-2"></div>
                <div class="skeleton h-3 w-1/2"></div>
            </div>
        </div>
        <div class="topic-item-wrapper">
            <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
            <div class="topic-item flex-1">
                <div class="skeleton h-4 w-2/3 mb-2"></div>
                <div class="skeleton h-3 w-2/5"></div>
            </div>
        </div>
        <div class="topic-item-wrapper">
            <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
            <div class="topic-item flex-1">
                <div class="skeleton h-4 w-4/5 mb-2"></div>
                <div class="skeleton h-3 w-1/3"></div>
            </div>
        </div>
    </div>
}
else if (Model.Items.Any())
{
    <partial name="Shared/_EndOfScroll" />
}
