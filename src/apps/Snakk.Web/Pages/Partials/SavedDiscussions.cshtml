@page "/partials/saved-discussions"
@using Snakk.Web.Pages.ViewModels
@model Snakk.Web.Pages.Partials.SavedDiscussionsModel
@{
    Layout = null;
}

@foreach (var discussion in Model.Items)
{
    @await Html.PartialAsync("Shared/_DiscussionCard",
        new DiscussionListItemVM(discussion, Model.ShowCommunity, Model.Community, UnsaveId: discussion.PublicId,
            SavedAt: discussion.SavedAt?.ToDateTime(),
            UnreadCount: discussion.HasUnreadPostCount ? discussion.UnreadPostCount : (int?)null))
}

@if (Model.HasMoreItems)
{
    <div hx-get="/partials/saved-discussions?offset=@Model.NextOffset&pageSize=20"
         hx-trigger="revealed once"
         hx-swap="outerHTML"
         hx-target="this"
         hx-push-url="false"
         class="sn-py-2">
        <partial name="Shared/_DiscussionSkeleton" />
    </div>
}
else if (Model.Offset > 0)
{
    <partial name="Shared/_EndOfScroll" />
}
