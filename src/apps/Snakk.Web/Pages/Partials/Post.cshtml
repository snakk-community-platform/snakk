@page "/partials/post"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Partials.PostModel
@{
    Layout = null;
    var post = Model.Post!;
    var isOP = post.IsFirstPost;
    var isModerator = post.Author.Role == "mod" || post.Author.Role == "admin";
    var isOwnPost = Model.CurrentUserId == post.Author.PublicId;
    var hasReplyTo = post.ReplyTo != null;
    var reactionCounts = post.Reactions?.Counts?.Counts ?? new Google.Protobuf.Collections.MapField<string, int>();
    var hasReactions = reactionCounts.Any(kvp => kvp.Value > 0);
    var reactionEmojis = new Dictionary<string, string>
    {
        ["Agree"] = "👍", ["Love"] = "❤️", ["Funny"] = "😂",
        ["Thinking"] = "🤔", ["Watching"] = "👀", ["Fire"] = "🔥",
        ["Thanks"] = "🙏", ["MindBlown"] = "🤯", ["ShipIt"] = "🚀"
    };
    var myReactions = post.Reactions?.UserReactions?.Reactions?.ToList() ?? new List<string>();
}
<article id="post-@post.PostNumber"
         class="post-item post-article post-layout group @(isOP ? "first-post" : "") @(isModerator ? "moderator-post" : "") new-author"
         data-author-id="@post.Author.PublicId"
         data-post-id="@post.PublicId"
         data-post-number="@post.PostNumber"
         data-created-at="@post.CreatedAt.ToDateTime().ToString("O")"
         role="article"
         aria-label="Post @post.PostNumber by @post.Author.DisplayName">

    @if (!isOP)
    {
    <!-- Left Pane: Avatar + Username -->
    <aside class="post-author-pane">
        @if (post.Author.IsDeleted)
        {
            <div class="post-avatar post-avatar-deleted">
                <svg xmlns="http://www.w3.org/2000/svg" class="h-5 w-5" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                    <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z" />
                </svg>
            </div>
            <span class="post-author-name deleted">@post.Author.DisplayName</span>
        }
        else
        {
            <img src="@SnakkUrlHelper.UserAvatar(post.Author.PublicId)"
                 alt="@post.Author.DisplayName"
                 width="48" height="48"
                 class="post-avatar" />
            <a href="@SnakkUrlHelper.UserProfile(post.Author.PublicId)"
               class="post-author-name"
               data-popup-type="user"
               data-popup-id="@post.Author.PublicId"
               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
        }
        <div class="post-author-badges">
            @if (post.Author.Role == "admin")
            {
                <span class="badge badge-error badge-xs">Admin</span>
            }
            else if (post.Author.Role == "mod")
            {
                <span class="badge badge-info badge-xs">Mod</span>
            }
            @if (post.IsOp)
            {
                <span class="badge badge-primary badge-xs post-badge-op">OP</span>
            }
            @if (post.IsUsersFirstPostInSpace)
            {
                <span class="badge badge-success badge-xs post-badge-new">New</span>
            }
            @if (post.IsMilestone)
            {
                <span class="badge badge-warning badge-xs post-badge-milestone" title="Milestone post">&#9733;</span>
            }
        </div>
    </aside>
    }

    <!-- Right Pane: Toolbar + Content -->
    <div class="post-main">
        <!-- Post Toolbar -->
        <div class="post-toolbar">
            <div class="post-toolbar-left">
                @if (!isOP)
                {
                    <span class="post-author-inline">
                        @if (post.Author.IsDeleted)
                        {
                            <span class="deleted">@post.Author.DisplayName</span>
                        }
                        else
                        {
                            <a href="/u/@post.Author.PublicId"
                               data-popup-type="user"
                               data-popup-id="@post.Author.PublicId"
                               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
                        }
                    </span>
                }
                <span class="post-time">
                    <time data-timestamp="@post.CreatedAt.ToDateTime().ToString("O")">@Model.FormatRelativeTime(post.CreatedAt.ToDateTime())</time>@if (post.EditedAt != null)
                    {
                        <span class="post-edited"> (edited)</span>
                    }
                </span>
            </div>
            <div class="post-toolbar-right">
                @if (!Model.IsDiscussionLocked && Model.IsAuthenticated && !isOwnPost)
                {
                    <div class="hidden group-hover:flex items-center gap-1">
                    <button onclick="replyToPost('@post.PublicId', '@post.Author.DisplayName')"
                            class="subtle-btn"
                            aria-label="Reply to @post.Author.DisplayName">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M3 10h10a8 8 0 018 8v2M3 10l6 6m-6-6l6-6" />
                        </svg>
                        Reply
                    </button>
                    <button onclick="quotePost('@post.PublicId', '@Model.EscapeForJs(post.Content)', '@post.Author.DisplayName')"
                            class="subtle-btn"
                            aria-label="Quote post by @post.Author.DisplayName">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor" aria-hidden="true">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 10h.01M12 10h.01M16 10h.01M9 16H5a2 2 0 01-2-2V6a2 2 0 012-2h14a2 2 0 012 2v8a2 2 0 01-2 2h-5l-5 5v-5z" />
                        </svg>
                        Quote
                    </button>
                    </div>
                }
                <div class="flex items-center gap-2 text-base text-muted @(Model.IsAuthenticated && !Model.IsDiscussionLocked ? "cursor-pointer" : "")"
                     id="reactions-@post.PublicId"
                     data-reaction-counts="@System.Text.Json.JsonSerializer.Serialize(reactionCounts.ToDictionary(k => k.Key, k => k.Value))"
                     data-my-reactions="@System.Text.Json.JsonSerializer.Serialize(myReactions)"
                     @if (Model.IsAuthenticated && !Model.IsDiscussionLocked)
                     {
                         <text>onclick="event.preventDefault(); event.stopPropagation(); toggleReactionPicker('@post.PublicId'); return false;"</text>
                     }
                     aria-label="@(Model.IsAuthenticated ? "Add reaction to post" : "Reactions")">
                    @foreach (var kvp in reactionCounts.Where(c => c.Value > 0))
                    {
                        var emoji = reactionEmojis.GetValueOrDefault(kvp.Key, "?");
                        var isActive = myReactions.Contains(kvp.Key);
                        <span data-type="@kvp.Key" class="@(isActive ? "active" : "")">@emoji @kvp.Value</span>
                    }
                    @if (!hasReactions && !Model.IsDiscussionLocked && Model.IsAuthenticated)
                    {
                        <span class="hidden group-hover:inline" data-reaction-placeholder>
                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M14.828 14.828a4 4 0 01-5.656 0M9 10h.01M15 10h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
                            </svg>
                        </span>
                    }
                </div>
                <div class="dropdown dropdown-end">
                    <button tabindex="0" class="subtle-btn" aria-label="Post options">
                        <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M5 12h.01M12 12h.01M19 12h.01M6 12a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0zm7 0a1 1 0 11-2 0 1 1 0 012 0z" />
                        </svg>
                    </button>
                    <ul tabindex="0" class="dropdown-content menu p-1 shadow-lg bg-base-100 border border-subtle rounded-lg w-48 z-20">
                        <li>
                            <button hx-get="/api/posts/@post.PublicId/history"
                                    hx-target="#history-modal-content"
                                    hx-swap="innerHTML"
                                    onclick="history_modal.showModal()"
                                    class="text-sm">
                                History
                            </button>
                        </li>
                        @if (Model.IsAuthenticated && Model.CurrentUserId == post.Author.PublicId)
                        {
                            <li><button onclick="editPost('@post.PublicId', '@Model.CurrentUserId')" class="text-sm">Edit</button></li>
                            <li>
                                <button hx-delete="/api/posts/@post.PublicId?userId=@Model.CurrentUserId"
                                        hx-target="#post-@post.PostNumber"
                                        hx-swap="outerHTML"
                                        hx-confirm="Are you sure you want to delete this post?"
                                        class="text-sm text-error">
                                    Delete
                                </button>
                            </li>
                        }
                        @if (Model.IsAuthenticated && Model.CurrentUserId != post.Author.PublicId)
                        {
                            <li>
                                <button onclick="hidePostsFromUser('@post.Author.PublicId', '@post.Author.DisplayName')" class="text-sm">
                                    Hide posts from user
                                </button>
                            </li>
                            <li>
                                <button onclick="openReportModal('post', '@post.PublicId', 'this post')" class="text-sm text-error">
                                    Report post
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Reply-to Quote Block -->
        @if (hasReplyTo)
        {
            <div class="editorial-quote block mb-4 text-sm">
                <span class="quote-author">@post.ReplyTo!.AuthorName wrote:</span>
                <p class="line-clamp-2 mt-1">@post.ReplyTo!.ContentSnippet</p>
            </div>
        }

        <!-- Post Content -->
        <div id="post-content-@post.PublicId"
             class="prose prose-content flex flex-col gap-4 leading-6"
             data-author-name="@post.Author.DisplayName">
            @Html.Raw(post.RenderedContent)
        </div>
    </div>

</article>
