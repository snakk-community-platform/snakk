@page "/partials/post"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Partials.PostModel
@{
    Layout = null;
    var post = Model.Post!;
    var isOP = post.IsFirstPost;
    var isModerator = post.Author.Role == "mod" || post.Author.Role == "admin";
    var isOwnPost = Model.CurrentUserId == post.Author.PublicId;
    var hasReplyTo = post.ReplyTo != null;
}
<article id="post-@post.PostNumber"
         class="post-item sn-post-article sn-post-layout @(isOP ? "sn-first-post" : "") @(isModerator ? "sn-moderator-post" : "") sn-new-author"
         data-author-id="@post.Author.PublicId"
         data-post-id="@post.PublicId"
         data-is-first-post="@(isOP ? "true" : "false")"
         data-post-number="@post.PostNumber"
         data-created-at="@post.CreatedAt.ToDateTime().ToString("O")"
         role="article"
         aria-label="@string.Format(T.Pages.DiscAriaPostBy, post.PostNumber, post.Author.DisplayName)">

    @if (!isOP)
    {
    <!-- Left Pane: Avatar + Username -->
    <aside class="sn-post-author-pane">
        @if (post.Author.IsDeleted)
        {
            <div class="sn-post-avatar sn-post-avatar-deleted">
                <span class="sn-icon icon-user sn-icon--md" aria-hidden="true"></span>
            </div>
            <span class="sn-post-author-name sn-deleted">@post.Author.DisplayName</span>
        }
        else
        {
            <img src="@post.Author.AvatarThumbnailUrl"
                 alt="@post.Author.DisplayName"
                 width="48" height="48"
                 class="sn-post-avatar sn-shadow-layered"
                 loading="lazy" decoding="async" />
            <a href="@SnakkUrlHelper.UserProfile(post.Author.Slug)"
               class="sn-post-author-name"
               data-popup-type="user"
               data-popup-id="@post.Author.PublicId"
               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
        }
        <div class="sn-post-author-badges">
            @if (post.Author.Role == "admin")
            {
                <span class="sn-badge sn-badge-error sn-badge-xs">@T.Pages.DiscBadgeAdmin</span>
            }
            else if (post.Author.Role == "mod")
            {
                <span class="sn-badge sn-badge-info sn-badge-xs">@T.Pages.DiscBadgeMod</span>
            }
            @if (post.IsOp)
            {
                    <span class="sn-badge sn-badge-primary sn-badge-xs sn-post-badge-op sn-shadow-layered">@T.Pages.DiscBadgeOp</span>
            }
            @if (post.IsUsersFirstPostInSpace)
            {
                    <span class="sn-badge sn-badge-success sn-badge-xs post-badge-new sn-shadow-layered">@T.Pages.DiscBadgeNew</span>
            }
            @if (post.IsMilestone)
            {
                    <span class="sn-badge sn-badge-warning sn-badge-xs sn-post-badge-milestone sn-shadow-layered" title="@T.Pages.DiscBadgeMilestone">&#9733;</span>
            }
        </div>
    </aside>
    }

    <!-- Right Pane: Toolbar + Content -->
    <div class="sn-post-main">
        <!-- Post Toolbar -->
        <div class="sn-post-toolbar">
            <div class="sn-post-toolbar-left">
                @if (!isOP)
                {
                    <span class="sn-post-author-inline">
                        @if (post.Author.IsDeleted)
                        {
                            <span class="sn-deleted">@post.Author.DisplayName</span>
                        }
                        else
                        {
                            <a href="/u/@post.Author.PublicId"
                               data-popup-type="user"
                               data-popup-id="@post.Author.PublicId"
                               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
                        }
                    </span>
                }
                <span class="sn-post-time">
                    <time data-timestamp="@post.CreatedAt.ToDateTime().ToString("O")">@Model.FormatRelativeTime(post.CreatedAt.ToDateTime())</time>@if (post.EditedAt != null)
                    {
                        <span class="post-edited"> @T.Pages.DiscEdited</span>
                    }
                </span>
                <span aria-hidden="true">·</span>
                <span class="sn-post-number">#@post.PostNumber</span>
            </div>
            <div class="sn-post-toolbar-right">
                @if (!Model.IsDiscussionLocked && Model.IsAuthenticated && !isOwnPost)
                {
                    <div class="sn-post-hover-actions">
                    <button data-action="reply-to-post"
                            data-post-id="@post.PublicId"
                            data-author-name="@post.Author.DisplayName"
                            class="sn-subtle-btn"
                            aria-label="@string.Format(T.Pages.DiscAriaReplyTo, post.Author.DisplayName)">
                        <span class="sn-icon icon-reply" aria-hidden="true"></span>
                        @T.Pages.DiscReply
                    </button>
                    <button data-action="quote-post"
                            data-post-id="@post.PublicId"
                            data-content="@post.Content"
                            data-author-name="@post.Author.DisplayName"
                            class="sn-subtle-btn"
                            aria-label="@string.Format(T.Pages.DiscAriaQuotePost, post.Author.DisplayName)">
                        <span class="sn-icon icon-chat-square" aria-hidden="true"></span>
                        @T.Pages.DiscQuote
                    </button>
                    </div>
                }
                <partial name="_PostReactions" model="@(new PostReactionsVM(
                    PostPublicId: post.PublicId,
                    Counts: (post.Reactions?.Counts?.Counts ?? new Google.Protobuf.Collections.MapField<string, int>()).ToDictionary(k => k.Key, k => k.Value),
                    MyReactions: post.Reactions?.UserReactions?.Reactions?.ToList() ?? new List<string>(),
                    IsOp: false,
                    IsAuthenticated: Model.IsAuthenticated,
                    IsLocked: Model.IsDiscussionLocked))" />
                <div class="sn-dropdown">
                    <button type="button" class="sn-subtle-btn" aria-label="@T.Pages.DiscAriaPostOptions"
                            popovertarget="sn-post-opts-@(post.PublicId)">
                        <span class="sn-icon icon-dots-horizontal" aria-hidden="true"></span>
                    </button>
                    <ul id="sn-post-opts-@(post.PublicId)" popover class="sn-dropdown-panel sn-menu w-48">
                        <li>
                            <button type="button"
                                    data-action="expand-post"
                                    data-post-id="@post.PublicId"
                                    class="sn-text-sm">
                                @T.Pages.DiscExpandPost
                            </button>
                        </li>
                        <li>
                            <button hx-get="/bff/posts/@post.PublicId/history"
                                    hx-target="#history-modal-content"
                                    hx-swap="innerHTML"
                                    data-modal-open="history_modal"
                                    class="sn-text-sm">
                                @T.Pages.DiscHistory
                            </button>
                        </li>
                        @if (Model.IsAuthenticated)
                        {
                            <li>
                                <button type="button"
                                        data-action="toggle-save-post"
                                        data-post-id="@post.PublicId"
                                        data-saved="false"
                                        aria-pressed="false"
                                        title="@T.Pages.DiscSaveTitle"
                                        class="sn-text-sm sn-post-save-btn">
                                    <span class="sn-icon icon-bookmark-alt" aria-hidden="true"></span>
                                    @T.Pages.DiscSavePost
                                </button>
                            </li>
                        }
                        @if (Model.IsAuthenticated && Model.CurrentUserId == post.Author.PublicId)
                        {
                            <li><button data-action="edit-post" data-post-id="@post.PublicId" data-user-id="@Model.CurrentUserId" class="sn-text-sm">@T.Pages.DiscEdit</button></li>
                            <li>
                                <button hx-delete="/bff/posts/@post.PublicId"
                                        hx-target="#post-@post.PostNumber"
                                        hx-swap="outerHTML"
                                        hx-confirm="@T.Pages.DiscDeleteConfirm"
                                        class="sn-text-sm sn-text-error">
                                    @T.Pages.DiscDelete
                                </button>
                            </li>
                        }
                        @if (Model.IsAuthenticated && Model.CurrentUserId != post.Author.PublicId)
                        {
                            <li>
                                <button data-action="hide-posts-from-user" data-author-id="@post.Author.PublicId" data-author-name="@post.Author.DisplayName" class="sn-text-sm">
                                    @T.Pages.DiscHideFromUser
                                </button>
                            </li>
                            <li>
                                <button data-action="open-report-modal" data-report-type="post" data-report-id="@post.PublicId" data-report-label="@T.Pages.DiscReportThisPost" class="sn-text-sm sn-text-error">
                                    @T.Pages.DiscReportPost
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Reply-to Quote Block -->
        @if (hasReplyTo)
        {
            <div class="sn-editorial-quote sn-block sn-mb-4 sn-text-sm">
                <span class="sn-quote-author">@string.Format(T.Pages.DiscQuoteWrotePattern, post.ReplyTo!.AuthorName)</span>
                <p class="line-clamp-2 mt-1">@post.ReplyTo!.ContentSnippet</p>
            </div>
        }

        <!-- Post Content -->
        <div id="post-content-@post.PublicId"
             class="sn-prose sn-prose-content sn-post-content leading-6"
             data-author-name="@post.Author.DisplayName"
             data-raw-content="@(post.Content ?? "")">
            @Html.SanitizedRaw(post.RenderedContent)
        </div>
    </div>

</article>
