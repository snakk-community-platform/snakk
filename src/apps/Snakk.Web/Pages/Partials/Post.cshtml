@page "/partials/post"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Partials.PostModel
@{
    Layout = null;
    var post = Model.Post!;
    var isOP = post.IsFirstPost;
    var isModerator = post.Author.Role == "mod" || post.Author.Role == "admin";
    var isOwnPost = Model.CurrentUserId == post.Author.PublicId;
    var hasReplyTo = post.ReplyTo != null;
    var reactionCounts = post.Reactions?.Counts?.Counts ?? new Google.Protobuf.Collections.MapField<string, int>();
    var hasReactions = reactionCounts.Any(kvp => kvp.Value > 0);
    var reactionEmojis = new Dictionary<string, string>
    {
        ["Agree"] = "👍", ["Love"] = "❤️", ["Funny"] = "😂",
        ["Thinking"] = "🤔", ["Watching"] = "👀", ["Fire"] = "🔥",
        ["Thanks"] = "🙏", ["MindBlown"] = "🤯", ["ShipIt"] = "🚀"
    };
    var myReactions = post.Reactions?.UserReactions?.Reactions?.ToList() ?? new List<string>();
}
<article id="post-@post.PostNumber"
         class="post-item post-article post-layout group @(isOP ? "first-post" : "") @(isModerator ? "moderator-post" : "") new-author"
         data-author-id="@post.Author.PublicId"
         data-post-id="@post.PublicId"
         data-is-first-post="@(isOP ? "true" : "false")"
         data-post-number="@post.PostNumber"
         data-created-at="@post.CreatedAt.ToDateTime().ToString("O")"
         role="article"
         aria-label="@string.Format(T.Pages.DiscAriaPostBy, post.PostNumber, post.Author.DisplayName)">

    @if (!isOP)
    {
    <!-- Left Pane: Avatar + Username -->
    <aside class="post-author-pane">
        @if (post.Author.IsDeleted)
        {
            <div class="post-avatar post-avatar-deleted">
                <span class="icon icon-user h-5 w-5" aria-hidden="true"></span>
            </div>
            <span class="post-author-name deleted">@post.Author.DisplayName</span>
        }
        else
        {
            <img src="@post.Author.AvatarThumbnailUrl"
                 alt="@post.Author.DisplayName"
                 width="48" height="48"
                 class="post-avatar"
                 loading="lazy" decoding="async" />
            <a href="@SnakkUrlHelper.UserProfile(post.Author.PublicId)"
               class="post-author-name"
               data-popup-type="user"
               data-popup-id="@post.Author.PublicId"
               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
        }
        <div class="post-author-badges">
            @if (post.Author.Role == "admin")
            {
                <span class="badge badge-error badge-xs">@T.Pages.DiscBadgeAdmin</span>
            }
            else if (post.Author.Role == "mod")
            {
                <span class="badge badge-info badge-xs">@T.Pages.DiscBadgeMod</span>
            }
            @if (post.IsOp)
            {
                <span class="badge badge-primary badge-xs post-badge-op">@T.Pages.DiscBadgeOp</span>
            }
            @if (post.IsUsersFirstPostInSpace)
            {
                <span class="badge badge-success badge-xs post-badge-new">@T.Pages.DiscBadgeNew</span>
            }
            @if (post.IsMilestone)
            {
                <span class="badge badge-warning badge-xs post-badge-milestone" title="@T.Pages.DiscBadgeMilestone">&#9733;</span>
            }
        </div>
    </aside>
    }

    <!-- Right Pane: Toolbar + Content -->
    <div class="post-main">
        <!-- Post Toolbar -->
        <div class="post-toolbar">
            <div class="post-toolbar-left">
                @if (!isOP)
                {
                    <span class="post-author-inline">
                        @if (post.Author.IsDeleted)
                        {
                            <span class="deleted">@post.Author.DisplayName</span>
                        }
                        else
                        {
                            <a href="/u/@post.Author.PublicId"
                               data-popup-type="user"
                               data-popup-id="@post.Author.PublicId"
                               data-popup-name="@post.Author.DisplayName">@post.Author.DisplayName</a>
                        }
                    </span>
                }
                <span class="post-time">
                    <time data-timestamp="@post.CreatedAt.ToDateTime().ToString("O")">@Model.FormatRelativeTime(post.CreatedAt.ToDateTime())</time>@if (post.EditedAt != null)
                    {
                        <span class="post-edited"> @T.Pages.DiscEdited</span>
                    }
                </span>
            </div>
            <div class="post-toolbar-right">
                @if (!Model.IsDiscussionLocked && Model.IsAuthenticated && !isOwnPost)
                {
                    <div class="hidden group-hover:flex items-center gap-1">
                    <button data-action="reply-to-post"
                            data-post-id="@post.PublicId"
                            data-author-name="@post.Author.DisplayName"
                            class="subtle-btn"
                            aria-label="@string.Format(T.Pages.DiscAriaReplyTo, post.Author.DisplayName)">
                        <span class="icon icon-reply h-4 w-4" aria-hidden="true"></span>
                        @T.Pages.DiscReply
                    </button>
                    <button data-action="quote-post"
                            data-post-id="@post.PublicId"
                            data-content="@post.Content"
                            data-author-name="@post.Author.DisplayName"
                            class="subtle-btn"
                            aria-label="@string.Format(T.Pages.DiscAriaQuotePost, post.Author.DisplayName)">
                        <span class="icon icon-chat-square h-4 w-4" aria-hidden="true"></span>
                        @T.Pages.DiscQuote
                    </button>
                    </div>
                }
                <div class="flex items-center gap-2 text-base text-muted @(Model.IsAuthenticated && !Model.IsDiscussionLocked ? "cursor-pointer" : "")"
                     id="reactions-@post.PublicId"
                     data-reaction-counts="@System.Text.Json.JsonSerializer.Serialize(reactionCounts.ToDictionary(k => k.Key, k => k.Value))"
                     data-my-reactions="@System.Text.Json.JsonSerializer.Serialize(myReactions)"
                     @if (Model.IsAuthenticated && !Model.IsDiscussionLocked)
                     {
                         <text>data-action="toggle-reaction-picker" data-post-id="@post.PublicId"</text>
                     }
                     aria-label="@(Model.IsAuthenticated ? T.Pages.DiscAriaReactionAdd : T.Pages.DiscAriaReactions)">
                    @foreach (var kvp in reactionCounts.Where(c => c.Value > 0))
                    {
                        var emoji = reactionEmojis.GetValueOrDefault(kvp.Key, "?");
                        var isActive = myReactions.Contains(kvp.Key);
                        <span data-type="@kvp.Key" class="@(isActive ? "active" : "")"><span class="sn-reaction-icon">@emoji</span> @kvp.Value</span>
                    }
                    @if (!hasReactions && !Model.IsDiscussionLocked && Model.IsAuthenticated)
                    {
                        <span class="hidden group-hover:inline" data-reaction-placeholder>
                            <span class="icon icon-badge-check h-4 w-4" aria-hidden="true"></span>
                        </span>
                    }
                </div>
                <div class="dropdown dropdown-end">
                    <button tabindex="0" class="subtle-btn" aria-label="@T.Pages.DiscAriaPostOptions">
                        <span class="icon icon-dots-horizontal h-4 w-4" aria-hidden="true"></span>
                    </button>
                    <ul tabindex="0" class="dropdown-content menu p-1 shadow-lg bg-base-100 border border-subtle rounded-lg w-48 z-20">
                        <li>
                            <button type="button"
                                    data-action="expand-post"
                                    data-post-id="@post.PublicId"
                                    class="text-sm">
                                @T.Pages.DiscExpandPost
                            </button>
                        </li>
                        <li>
                            <button hx-get="/bff/posts/@post.PublicId/history"
                                    hx-target="#history-modal-content"
                                    hx-swap="innerHTML"
                                    data-modal-open="history_modal"
                                    class="text-sm">
                                @T.Pages.DiscHistory
                            </button>
                        </li>
                        @if (Model.IsAuthenticated)
                        {
                            <li>
                                <button type="button"
                                        data-action="toggle-save-post"
                                        data-post-id="@post.PublicId"
                                        data-saved="false"
                                        aria-pressed="false"
                                        title="@T.Pages.DiscSaveTitle"
                                        class="text-sm post-save-btn">
                                    <span class="icon icon-bookmark-alt h-4 w-4" aria-hidden="true"></span>
                                    @T.Pages.DiscSavePost
                                </button>
                            </li>
                        }
                        @if (Model.IsAuthenticated && Model.CurrentUserId == post.Author.PublicId)
                        {
                            <li><button data-action="edit-post" data-post-id="@post.PublicId" data-user-id="@Model.CurrentUserId" class="text-sm">@T.Pages.DiscEdit</button></li>
                            <li>
                                <button hx-delete="/bff/posts/@post.PublicId"
                                        hx-target="#post-@post.PostNumber"
                                        hx-swap="outerHTML"
                                        hx-confirm="@T.Pages.DiscDeleteConfirm"
                                        class="text-sm text-error">
                                    @T.Pages.DiscDelete
                                </button>
                            </li>
                        }
                        @if (Model.IsAuthenticated && Model.CurrentUserId != post.Author.PublicId)
                        {
                            <li>
                                <button data-action="hide-posts-from-user" data-author-id="@post.Author.PublicId" data-author-name="@post.Author.DisplayName" class="text-sm">
                                    @T.Pages.DiscHideFromUser
                                </button>
                            </li>
                            <li>
                                <button data-action="open-report-modal" data-report-type="post" data-report-id="@post.PublicId" data-report-label="@T.Pages.DiscReportThisPost" class="text-sm text-error">
                                    @T.Pages.DiscReportPost
                                </button>
                            </li>
                        }
                    </ul>
                </div>
            </div>
        </div>

        <!-- Reply-to Quote Block -->
        @if (hasReplyTo)
        {
            <div class="editorial-quote block mb-4 text-sm">
                <span class="quote-author">@string.Format(T.Pages.DiscQuoteWrotePattern, post.ReplyTo!.AuthorName)</span>
                <p class="line-clamp-2 mt-1">@post.ReplyTo!.ContentSnippet</p>
            </div>
        }

        <!-- Post Content -->
        <div id="post-content-@post.PublicId"
             class="prose prose-content flex flex-col gap-4 leading-6"
             data-author-name="@post.Author.DisplayName"
             data-raw-content="@(post.Content ?? "")">
            @Html.SanitizedRaw(post.RenderedContent)
        </div>
    </div>

</article>
