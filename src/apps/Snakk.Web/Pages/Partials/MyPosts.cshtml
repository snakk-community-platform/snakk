@page "/partials/my-posts"
@model Snakk.Web.Pages.Partials.MyPostsModel
@{
    Layout = null;
}

@foreach (var post in Model.Items)
{
    @await Html.PartialAsync("Shared/_PostTopicItem", post)
}

@if (Model.HasMoreItems)
{
    <div hx-get="/partials/my-posts?offset=@Model.NextOffset&pageSize=20"
         hx-trigger="revealed once"
         hx-swap="outerHTML"
         hx-target="this"
         hx-push-url="false">
        @for (var i = 0; i < 3; i++)
        {
            <div class="topic-item-wrapper" style="opacity: 0.5">
                <div class="topic-item">
                    <div class="topic-content">
                        <div class="skeleton h-4 w-3/4 rounded"></div>
                        <div class="skeleton h-3 w-1/3 rounded mt-1"></div>
                        <div class="skeleton h-3 w-full rounded mt-2"></div>
                    </div>
                </div>
            </div>
        }
    </div>
}
else if (Model.Items.Any() && Model.Offset > 0)
{
    <partial name="Shared/_EndOfScroll" />
}
