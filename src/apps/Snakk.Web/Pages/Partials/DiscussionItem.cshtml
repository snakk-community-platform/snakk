@page "/partials/discussion-item"
@using Snakk.Web.Helpers
@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.Partials.DiscussionItemModel
@{
    Layout = null;
    var discussion = Model.Discussion!;
    var baseUrl = SnakkUrlHelper.Discussion(Model.Community, Model.HubSlug, Model.SpaceSlug, SnakkUrlHelper.DiscussionSlugId(discussion.Slug, discussion.PublicId));
    var unreadUrl = $"{baseUrl}?gotoUnread=true";
}

<div class="topic-item-wrapper" data-discussion-id="@discussion.PublicId">
    <img src="@SnakkUrlHelper.UserAvatar(Model.AuthorId)"
         alt="@Model.AuthorName"
         width="40" height="40"
         class="w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block" />

    <div class="topic-item">
        <div class="topic-content">
            <div class="topic-title">
                <a href="@baseUrl" class="topic-title-link">@discussion.Title</a>
            </div>
            <div class="topic-meta">
                <span>@FormatRelativeTime((discussion.LastActivityAt ?? discussion.CreatedAt)?.ToDateTime())</span>
            </div>
        </div>
        <div class="topic-stats hidden sm:flex">
            <div class="topic-stat">
                <div class="topic-stat-icon">
                    <span class="icon icon-badge-check" style="width:18px;height:18px" aria-hidden="true"></span>
                </div>
                <div class="topic-stat-value">0</div>
            </div>
            <div class="topic-stat">
                <div class="topic-stat-icon">
                    <span class="icon icon-chat-square" style="width:18px;height:18px" aria-hidden="true"></span>
                </div>
                <div class="topic-stat-value" data-stat="post-count">@discussion.PostCount</div>
            </div>
        </div>
    </div>
    <button class="preview-btn"
            data-discussion-id="@discussion.PublicId"
            title="@T.Pages.PartialPreviewFirstPost"
            type="button">
        <span class="icon icon-chevron-down" style="width:18px;height:18px" aria-hidden="true"></span>
    </button>
    <a href="@unreadUrl" class="topic-latest-link" title="@T.Pages.PartialJumpToUnread">
        <span class="icon icon-chevron-down chevron-right" style="width:18px;height:18px" aria-hidden="true"></span>
    </a>
    <div class="discussion-preview hidden" data-discussion-id="@discussion.PublicId">
        <div class="preview-content"></div>
    </div>
</div>
