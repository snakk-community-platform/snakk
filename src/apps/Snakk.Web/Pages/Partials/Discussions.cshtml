@page "/partials/discussions"
@using Snakk.Web.Pages.ViewModels
@model Snakk.Web.Pages.Partials.DiscussionsModel
@{
    Layout = null;
}

@foreach (var discussion in Model.Items)
{
    @await Html.PartialAsync("Shared/_FrontpageDiscussionCard",
        new DiscussionListItemVM(discussion, Model.ShowCommunity, Model.Community, Model.ShowHub, Model.ShowSpace))
}

@if (Model.HasMoreItems && Model.NextCursor != null)
{
    <div hx-get="/partials/discussions?cursor=@Model.NextCursor&pageSize=20@(Model.CommunityId != null ? $"&communityId={Model.CommunityId}" : "")@(Model.HubId != null ? $"&hubId={Model.HubId}" : "")@(Model.HideCommunity ? "&hideCommunity=true" : "")@(Model.HideHub ? "&hideHub=true" : "")"
         hx-trigger="revealed"
         hx-swap="outerHTML"
         hx-target="this"
         hx-push-url="false"
         class="py-2">
        @for (var i = 0; i < 3; i++)
        {
            <div class="fp-card" style="opacity: 0.5">
                <div class="fp-card-header">
                    <div class="skeleton h-3 w-16 rounded"></div>
                    <div class="skeleton h-4 w-4 rounded-full"></div>
                    <div class="skeleton h-3 w-20 rounded"></div>
                </div>
                <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                <div class="fp-card-stats mt-2">
                    <div class="skeleton h-3 w-24 rounded"></div>
                </div>
            </div>
        }
    </div>
}
else if (Model.Items.Any())
{
    <partial name="Shared/_EndOfScroll" />
}
