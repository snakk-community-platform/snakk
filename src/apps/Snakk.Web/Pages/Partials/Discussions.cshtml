@page "/partials/discussions"
@using Snakk.Web.Pages.ViewModels
@model Snakk.Web.Pages.Partials.DiscussionsModel
@{
    Layout = null;
}

@foreach (var discussion in Model.Items)
{
    @await Html.PartialAsync("Shared/_DiscussionCard",
        new DiscussionListItemVM(discussion, Model.ShowCommunity, Model.Community, Model.ShowHub, Model.ShowSpace))
}

@if (Model.HasMoreItems && (Model.NextCursor != null || Model.Sort == "trending" || Model.Sort == "new"))
{
    var communityParam = Model.CommunityId != null ? $"&communityId={Model.CommunityId}" : "";
    var nextUrl = Model.Sort == "trending"
        ? $"/partials/discussions?sort=trending&offset={Model.NextOffset}&pageSize=20{communityParam}"
        : Model.Sort == "new"
            ? $"/partials/discussions?sort=new&cursor={Model.NextCursor}&pageSize=20{communityParam}"
            : Model.Sort == "my-feed"
                ? $"/partials/discussions?sort=my-feed&cursor={Model.NextCursor}&pageSize=20"
                : $"/partials/discussions?cursor={Model.NextCursor}&pageSize=20{communityParam}{(Model.HubId != null ? $"&hubId={Model.HubId}" : "")}{(Model.SpaceId != null ? $"&spaceId={Model.SpaceId}" : "")}{(Model.HideCommunity ? "&hideCommunity=true" : "")}{(Model.HideHub ? "&hideHub=true" : "")}";
    <div hx-get="@nextUrl"
         hx-trigger="revealed"
         hx-swap="outerHTML"
         hx-target="this"
         hx-push-url="false"
         class="py-2">
        @for (var i = 0; i < 3; i++)
        {
            <div class="sn-card" style="opacity: 0.5">
                <div class="sn-card-header">
                    <div class="skeleton h-3 w-16 rounded"></div>
                    <div class="skeleton h-4 w-4 rounded-full"></div>
                    <div class="skeleton h-3 w-20 rounded"></div>
                </div>
                <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                <div class="sn-card-stats mt-2">
                    <div class="skeleton h-3 w-24 rounded"></div>
                </div>
            </div>
        }
    </div>
}
else if (Model.Items.Any() && Model.Offset > 0)
{
    <partial name="Shared/_EndOfScroll" />
}
