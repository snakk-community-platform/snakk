@page "/partials/following-discussions"
@using Snakk.Web.Pages.ViewModels
@model Snakk.Web.Pages.Partials.FollowingDiscussionsModel
@{
    Layout = null;
}

@foreach (var discussion in Model.Items)
{
    var followedAt = Model.FollowTimestamps.TryGetValue(discussion.PublicId, out var ft) ? (DateTime?)ft : null;
    @await Html.PartialAsync("Shared/_DiscussionCard",
        new DiscussionListItemVM(discussion, Model.ShowCommunity, Model.Community, UnfollowId: discussion.PublicId, FollowedAt: followedAt,
            UnreadCount: discussion.HasUnreadPostCount ? discussion.UnreadPostCount : (int?)null))
}

@if (Model.HasMoreItems)
{
    <div hx-get="/partials/following-discussions?offset=@Model.NextOffset&pageSize=10"
         hx-trigger="revealed once"
         hx-swap="outerHTML"
         hx-target="this"
         hx-push-url="false"
         class="sn-py-2">
        <partial name="Shared/_DiscussionSkeleton" />
    </div>
}
else if (Model.Offset > 0)
{
    <partial name="Shared/_EndOfScroll" />
}
