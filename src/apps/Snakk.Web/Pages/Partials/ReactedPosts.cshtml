@page "/partials/reacted-posts"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Partials.ReactedPostsModel
@{
    Layout = null;
}

@if (!Model.Items.Any())
{
    <div class="text-sm py-8 text-center" style="color: var(--text-tertiary)">
        <span class="icon icon-emoji-happy h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
        <p>@T.Pages.ReactedNone</p>
        <p class="mt-1 text-xs opacity-70">@T.Pages.ReactedNoneHint</p>
    </div>
}
else
{
    @foreach (var post in Model.Items)
    {
        <div class="sn-reaction-strip">
            <span class="sn-reaction-emoji">@post.ReactionEmoji</span>
            <span class="sn-reaction-time">
                <time data-timestamp="@post.ReactedAt.ToString("O")">@DisplayHelper.FormatRelativeTime(post.ReactedAt)</time>
            </span>
        </div>
        @await Html.PartialAsync("Shared/_PostTopicItem", post.ToPostListItem())
    }

    @if (Model.HasMoreItems)
    {
        <div hx-get="/partials/reacted-posts?offset=@Model.NextOffset&pageSize=10"
             hx-trigger="revealed"
             hx-swap="outerHTML"
             hx-target="this"
             hx-push-url="false"
             class="py-2">
            @for (var i = 0; i < 2; i++)
            {
                <div class="topic-item-wrapper" style="opacity: 0.5">
                    <div class="topic-item">
                        <div class="topic-content">
                            <div class="skeleton h-4 w-3/4 rounded"></div>
                            <div class="skeleton h-3 w-1/3 rounded mt-1"></div>
                            <div class="skeleton h-3 w-full rounded mt-2"></div>
                        </div>
                    </div>
                </div>
            }
        </div>
    }
    else if (Model.Offset > 0)
    {
        <partial name="Shared/_EndOfScroll" />
    }
}
