@page "/partials/reacted-posts"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Partials.ReactedPostsModel
@{
    Layout = null;
}

@if (!Model.Items.Any())
{
    <div class="sn-text-sm sn-py-8 sn-text-center" style="color: var(--text-tertiary)">
        <span class="sn-icon icon-emoji-happy sn-icon--xl sn-mx-auto sn-mb-3 sn-opacity-30" aria-hidden="true"></span>
        <p>@T.Pages.ReactedNone</p>
        <p class="sn-mt-1 sn-text-xs opacity-70">@T.Pages.ReactedNoneHint</p>
    </div>
}
else
{
    @foreach (var post in Model.Items)
    {
        @await Html.PartialAsync("Shared/_PostCard", post.ToPostListItem())
    }

    @if (Model.HasMoreItems)
    {
        <div hx-get="/partials/reacted-posts?offset=@Model.NextOffset&pageSize=10"
             hx-trigger="revealed once"
             hx-swap="outerHTML"
             hx-target="this"
             hx-push-url="false"
             class="sn-py-2">
            @for (var i = 0; i < 2; i++)
            {
                <div class="sn-card" style="opacity: 0.5">
                    <div class="sn-card-header">
                        <div class="sn-skeleton sn-h-4 sn-w-4 sn-rounded-full"></div>
                        <div class="sn-skeleton sn-h-3 sn-w-20 sn-rounded"></div>
                        <div class="sn-skeleton sn-h-3 sn-w-16 sn-rounded"></div>
                    </div>
                    <div class="sn-skeleton sn-h-4 w-3/4 sn-rounded sn-mt-1"></div>
                    <div class="sn-skeleton sn-h-3 sn-w-full sn-rounded sn-mt-1"></div>
                </div>
            }
        </div>
    }
    else if (Model.Offset > 0)
    {
        <partial name="Shared/_EndOfScroll" />
    }
}
