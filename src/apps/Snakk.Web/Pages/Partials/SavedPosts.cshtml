@page "/partials/saved-posts"
@model Snakk.Web.Pages.Partials.SavedPostsModel
@{
    Layout = null;
}

@foreach (var post in Model.Items)
{
    @await Html.PartialAsync("Shared/_PostCard", post with { UnsaveId = post.PublicId })
}

@if (Model.HasMoreItems)
{
    <div hx-get="/partials/saved-posts?offset=@Model.NextOffset&pageSize=20"
         hx-trigger="revealed once"
         hx-swap="outerHTML"
         hx-target="this"
         hx-push-url="false">
        @for (var i = 0; i < 3; i++)
        {
            <div class="sn-card" style="opacity: 0.5">
                <div class="sn-card-header">
                    <div class="sn-skeleton sn-h-4 sn-w-4 sn-rounded-full"></div>
                    <div class="sn-skeleton h-3 w-20 sn-rounded"></div>
                    <div class="sn-skeleton h-3 w-16 sn-rounded"></div>
                </div>
                <div class="sn-skeleton sn-h-4 w-3/4 sn-rounded sn-mt-1"></div>
                <div class="sn-skeleton h-3 sn-w-full sn-rounded sn-mt-1"></div>
            </div>
        }
    </div>
}
else if (Model.Items.Any())
{
    <partial name="Shared/_EndOfScroll" />
}
