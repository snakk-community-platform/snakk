@page
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@using static Snakk.Web.Helpers.DiscussionTypeHelper
@model IndexModel
@{
    ViewData["Title"] = T.Pages.IndexTitle;
    ViewData["Description"] = "Snakk, a community discussion platform. Browse discussions, join communities, and connect with others.";
    ViewData["RssFeedUrl"] = "/feed.xml";
    ViewData["RssFeedTitle"] = T.Pages.LatestHeading;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div class="sn-center-inner">
        <h2 class="sn-section-title">
            <span class="icon icon-chat-bubbles" aria-hidden="true"></span>
            @T.Pages.IndexHeading
        </h2>

        @if (Model.RecentDiscussions?.Items == null || !Model.RecentDiscussions.Items.Any())
        {
            <partial name="Shared/_EmptyState" model="new EmptyStateVM(T.Pages.IndexEmpty)" />
        }
        else
        {
            <div id="discussions-container" class="h-feed">
                @{ var indexCardIndex = 0; }
                @foreach (var discussion in Model.RecentDiscussions.Items)
                {
                    @await Html.PartialAsync("Shared/_DiscussionCard",
                        new DiscussionListItemVM(discussion, Model.ShowCommunityInDiscussionList, Model.Community, IsFirst: indexCardIndex++ == 0))
                }

                @if (Model.RecentDiscussions.HasMoreItems && Model.RecentDiscussions.HasNextCursor)
                {
                    var nextCursor = Model.RecentDiscussions.NextCursor;
                    var communityParam = Model.SidebarScopeType == "community" ? $"&communityId={Model.SidebarScopeId}" : "";

                    <div hx-get="/partials/discussions?cursor=@nextCursor&pageSize=20@(communityParam)"
                         hx-trigger="revealed once"
                         hx-swap="outerHTML"
                         hx-target="this"
                         hx-push-url="false"
                         class="py-2">
                        <partial name="Shared/_DiscussionSkeleton" />
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Right Column -->
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
    ViewData["RightPane.AboutTitle"] = T.Pages.IndexAboutTitle;
    ViewData["RightPane.AboutDescription"] = T.Pages.IndexAboutDesc;
}
<partial name="Shared/_GlobalRightSidebar" />

@section Scripts {
    <script src="@SnakkUrlHelper.Js("components/discussion-preview")" asp-append-version="true" defer></script>
    <script src="@SnakkUrlHelper.Js("pages/frontpage")" asp-append-version="true" defer></script>
    @if (Model.RecentDiscussions?.Items != null && Model.RecentDiscussions.Items.Any())
    {
        <script src="@SnakkUrlHelper.Js("pages/frontpage-discussions")" asp-append-version="true" defer></script>
    }
}
