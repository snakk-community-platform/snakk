@page
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Moderation.ReportsModel
@{
    ViewData["Title"] = T.Pages.ModReportsTitle;
}


@section CenterHeader {
    <a href="/moderation" class="sn-badge sn-badge-ghost sn-badge-sm">@T.Pages.ModCrumb</a>
}

<div class="sn-max-w-5xl sn-mx-auto sn-px-4 sn-py-8">
    <!-- Page Header -->
    <div class="page-header">
        <h1>@T.Pages.ModReportsHeading</h1>
        <p>@T.Pages.ModReportsSubtitle</p>
    </div>

    <!-- Filters -->
    <div class="sn-mod-filter-bar">
        <a href="@Model.BuildUrl(null)" class="sn-btn sn-btn-sm @(string.IsNullOrEmpty(Model.Status) ? "sn-btn-primary" : "sn-btn-ghost")">
            @T.Pages.ModReportsFilterAll
        </a>
        <a href="@Model.BuildUrl("Pending")" class="sn-btn sn-btn-sm @(Model.Status == "Pending" ? "sn-btn-warning" : "sn-btn-ghost")">
            @T.Pages.ModReportsFilterPending
        </a>
        <a href="@Model.BuildUrl("Resolved")" class="sn-btn sn-btn-sm @(Model.Status == "Resolved" ? "sn-btn-success" : "sn-btn-ghost")">
            @T.Pages.ModReportsFilterResolved
        </a>
        <a href="@Model.BuildUrl("Dismissed")" class="sn-btn sn-btn-sm @(Model.Status == "Dismissed" ? "sn-btn-ghost sn-btn-active" : "sn-btn-ghost")">
            @T.Pages.ModReportsFilterDismissed
        </a>
    </div>

    <!-- Reports List -->
    @if (Model.Reports?.Items == null || !Model.Reports.Items.Any())
    {
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>@T.Pages.ModReportsNoneTitle</h3>
                <p>@(string.IsNullOrEmpty(Model.Status) ? T.Pages.ModReportsNoneAll : string.Format(T.Pages.ModReportsNoneFiltered, Model.Status.ToLower()))</p>
            </div>
        </div>
    }
    else
    {
        <div class="sn-space-y-4">
            @foreach (var report in Model.Reports.Items)
            {
                <a href="/moderation/reports/@report.PublicId" class="clean-card sn-block sn-hover:shadow-md transition-shadow">
                    <div class="sn-report-card-layout">
                        <img src="@SnakkUrlHelper.UserAvatar(report.ReporterUserPublicId)"
                             alt="@report.ReporterUserDisplayName"
                             width="40" height="40"
                             class="sn-avatar flex-shrink-0" />
                        <div class="sn-flex-1 sn-min-w-0">
                            <div class="sn-report-badge-row">
                                <span class="sn-badge @Model.GetStatusBadgeClass(report.Status) sn-badge-sm">@report.Status</span>
                                @if (!string.IsNullOrEmpty(report.ReasonName))
                                {
                                    <span class="sn-badge sn-badge-outline sn-badge-sm">@report.ReasonName</span>
                                }
                                @if (report.CommentCount > 0)
                                {
                                    <span class="sn-badge sn-badge-ghost sn-badge-sm">
                                        <span class="sn-icon icon-chat-bubbles h-3 w-3 sn-mr-1" aria-hidden="true"></span>
                                        @report.CommentCount
                                    </span>
                                }
                            </div>

                            <div class="sn-text-sm sn-mb-2">
                                <span class="sn-font-medium">@report.ReporterUserDisplayName</span>
                                <span class="sn-text-muted">@T.Pages.ModReportsReported</span>
                                @if (!string.IsNullOrEmpty(report.ReportedUserDisplayName))
                                {
                                    <span class="sn-font-medium sn-text-error">@report.ReportedUserDisplayName</span>
                                }
                                else if (!string.IsNullOrEmpty(report.ReportedPostContentSnippet))
                                {
                                    <span class="sn-text-muted">@T.Pages.ModReportsAPost</span>
                                    <span class="sn-italic">"@report.ReportedPostContentSnippet"</span>
                                }
                                else if (!string.IsNullOrEmpty(report.ReportedDiscussionTitle))
                                {
                                    <span class="sn-text-muted">@T.Pages.ModReportsADiscussion</span>
                                    <span class="sn-font-medium">"@report.ReportedDiscussionTitle"</span>
                                }
                            </div>

                            @if (!string.IsNullOrEmpty(report.Details))
                            {
                                <div class="sn-text-sm sn-text-muted sn-mb-2 line-clamp-2">@report.Details</div>
                            }

                            <div class="sn-report-meta-row">
                                <span>@T.Pages.ModReportsReportedPrefix@Model.GetRelativeTime(report.CreatedAt)</span>
                                @if (!string.IsNullOrEmpty(report.SpaceName))
                                {
                                    <span>@T.Pages.ModReportsIn @report.SpaceName</span>
                                }
                                else if (!string.IsNullOrEmpty(report.HubName))
                                {
                                    <span>@T.Pages.ModReportsIn @report.HubName</span>
                                }
                                else if (!string.IsNullOrEmpty(report.CommunityName))
                                {
                                    <span>@T.Pages.ModReportsIn @report.CommunityName</span>
                                }
                                @if (report.ResolvedAt.HasValue && !string.IsNullOrEmpty(report.ResolvedByUserDisplayName))
                                {
                                    <span>@T.Pages.ModReportsResolvedByPrefix @report.ResolvedByUserDisplayName @Model.GetRelativeTime(report.ResolvedAt.Value)</span>
                                }
                            </div>
                        </div>
                        <span class="sn-icon icon-chevron-right sn-icon--md sn-text-muted flex-shrink-0" aria-hidden="true"></span>
                    </div>
                </a>
            }
        </div>

        @* Pagination *@
        @if (Model.Offset > 0 || Model.Reports.HasMoreItems)
        {
            <div class="sn-pagination-row--reports">
                @if (Model.Offset > 0)
                {
                    <a href="@Model.BuildUrl(Model.Status, Math.Max(0, Model.Offset - Model.PageSize))" class="sn-btn sn-btn-ghost sn-btn-sm">
                        @T.Pages.ModReportsPrevious
                    </a>
                }
                @if (Model.Reports.HasMoreItems)
                {
                    <a href="@Model.BuildUrl(Model.Status, Model.Offset + Model.PageSize)" class="sn-btn sn-btn-ghost sn-btn-sm">
                        @T.Pages.ModReportsNext
                    </a>
                }
            </div>
        }
    }
</div>
