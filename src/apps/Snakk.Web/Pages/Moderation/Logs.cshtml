@page
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Moderation.LogsModel
@{
    ViewData["Title"] = T.Pages.ModLogsTitle;
}


@section CenterHeader {
    <a href="/moderation" class="sn-badge sn-badge-ghost sn-badge-sm">@T.Pages.ModCrumb</a>
}

<div class="sn-max-w-5xl sn-mx-auto sn-px-4 sn-py-8">
    <!-- Page Header -->
    <div class="page-header">
        <h1>@T.Pages.ModLogsHeading</h1>
        <p>@T.Pages.ModLogsSubtitle</p>
    </div>

    <!-- Filters -->
    <div class="clean-card sn-mb-6">
        <form method="get" class="sn-log-filter-row">
            <div class="sn-flex-1 min-w-[200px]">
                <input type="text"
                       name="communityId"
                       value="@Model.CommunityId"
                       placeholder="@T.Pages.ModLogsCommunityIdPh"
                       class="sn-input sn-input-sm sn-w-full" />
            </div>
            <div class="sn-flex-1 min-w-[200px]">
                <input type="text"
                       name="hubId"
                       value="@Model.HubId"
                       placeholder="@T.Pages.ModLogsHubIdPh"
                       class="sn-input sn-input-sm sn-w-full" />
            </div>
            <div class="sn-flex-1 min-w-[200px]">
                <input type="text"
                       name="spaceId"
                       value="@Model.SpaceId"
                       placeholder="@T.Pages.ModLogsSpaceIdPh"
                       class="sn-input sn-input-sm sn-w-full" />
            </div>
            <button type="submit" class="sn-btn sn-btn-sm sn-btn-primary">@T.Pages.ModLogsFilterBtn</button>
            <a href="/moderation/logs" class="sn-btn sn-btn-sm sn-btn-ghost">@T.Pages.ModLogsClearBtn</a>
        </form>
    </div>

    <!-- Logs List -->
    @if (Model.Logs?.Items == null || !Model.Logs.Items.Any())
    {
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>@T.Pages.ModLogsNoneTitle</h3>
                <p>@T.Pages.ModLogsNoneBody</p>
            </div>
        </div>
    }
    else
    {
        <div class="clean-card">
            <div class="overflow-x-auto">
                <table class="table table-zebra">
                    <thead>
                        <tr>
                            <th>@T.Pages.ModLogsThTime</th>
                            <th>@T.Pages.ModLogsThActor</th>
                            <th>@T.Pages.ModLogsThAction</th>
                            <th>@T.Pages.ModLogsThTarget</th>
                            <th>@T.Pages.ModLogsThLocation</th>
                            <th>@T.Pages.ModLogsThDetails</th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var log in Model.Logs.Items)
                        {
                            <tr class="hover">
                                <td class="sn-log-timestamp-cell">
                                    <span title="@log.CreatedAt.ToString("yyyy-MM-dd HH:mm:ss UTC")">
                                        @Model.GetRelativeTime(log.CreatedAt)
                                    </span>
                                </td>
                                <td>
                                    <div class="sn-actor-identity">
                                        <img src="@SnakkUrlHelper.UserAvatar(log.ActorUserPublicId)"
                                             alt="@log.ActorUserDisplayName"
                                             width="24" height="24"
                                             class="w-6 h-6 sn-rounded-full" />
                                        <a href="@SnakkUrlHelper.UserProfile(log.ActorUserPublicId)" class="sn-link sn-link-hover sn-text-sm">@log.ActorUserDisplayName</a>
                                    </div>
                                </td>
                                <td>
                                    <span class="sn-badge @Model.GetActionBadgeClass(log.Action) sn-badge-sm">
                                        @Model.GetActionDisplayName(log.Action)
                                    </span>
                                </td>
                                <td class="sn-text-sm">
                                    @if (!string.IsNullOrEmpty(log.TargetUserDisplayName))
                                    {
                                        <a href="@SnakkUrlHelper.UserProfile(log.TargetUserPublicId ?? "")" class="sn-link sn-link-hover">@log.TargetUserDisplayName</a>
                                    }
                                    else if (!string.IsNullOrEmpty(log.TargetDiscussionTitle))
                                    {
                                        <span class="sn-truncate max-w-[150px] sn-inline-block" title="@log.TargetDiscussionTitle">
                                            @(log.TargetDiscussionTitle.Length > 30 ? log.TargetDiscussionTitle.Substring(0, 30) + "..." : log.TargetDiscussionTitle)
                                        </span>
                                    }
                                    else if (!string.IsNullOrEmpty(log.TargetPostPublicId))
                                    {
                                        <span class="sn-text-muted">@T.Pages.ModLogsPost</span>
                                    }
                                    else
                                    {
                                        <span class="sn-text-muted">-</span>
                                    }
                                </td>
                                <td class="sn-text-xs sn-text-muted">
                                    @if (!string.IsNullOrEmpty(log.SpaceName))
                                    {
                                        @log.SpaceName
                                    }
                                    else if (!string.IsNullOrEmpty(log.HubName))
                                    {
                                        @log.HubName
                                    }
                                    else if (!string.IsNullOrEmpty(log.CommunityName))
                                    {
                                        @log.CommunityName
                                    }
                                    else
                                    {
                                        <span>@T.Pages.ModLogsGlobal</span>
                                    }
                                </td>
                                <td class="sn-text-xs sn-text-muted max-w-[200px]">
                                    @if (!string.IsNullOrEmpty(log.Details))
                                    {
                                        <span title="@log.Details">@(log.Details.Length > 50 ? log.Details.Substring(0, 50) + "..." : log.Details)</span>
                                    }
                                    @if (!string.IsNullOrEmpty(log.Reason))
                                    {
                                        <span class="sn-italic" title="@log.Reason">@(log.Reason.Length > 50 ? log.Reason.Substring(0, 50) + "..." : log.Reason)</span>
                                    }
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        @* Pagination *@
        @if (Model.Offset > 0 || Model.Logs.HasMoreItems)
        {
            <div class="sn-pagination-row--logs">
                @if (Model.Offset > 0)
                {
                    <a href="@Model.BuildUrl(Math.Max(0, Model.Offset - Model.PageSize))" class="sn-btn sn-btn-ghost sn-btn-sm">
                        @T.Pages.ModLogsPrevious
                    </a>
                }
                @if (Model.Logs.HasMoreItems)
                {
                    <a href="@Model.BuildUrl(Model.Offset + Model.PageSize)" class="sn-btn sn-btn-ghost sn-btn-sm">
                        @T.Pages.ModLogsNext
                    </a>
                }
            </div>
        }
    }
</div>
