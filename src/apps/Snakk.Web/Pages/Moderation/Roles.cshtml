@page
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Moderation.RolesModel
@{
    ViewData["Title"] = T.Pages.ModRolesTitle;
}


@section CenterHeader {
    <a href="/moderation" class="sn-badge sn-badge-ghost sn-badge-sm">@T.Pages.ModCrumb</a>
}

<div class="sn-max-w-4xl sn-mx-auto sn-px-4 sn-py-8">
    <!-- Page Header -->
    <div class="page-header">
        <h1>@T.Pages.ModRolesHeading</h1>
        <p>@T.Pages.ModRolesSubtitle</p>
    </div>

    <!-- Search User -->
    <div class="clean-card sn-mb-6">
        <form method="get" class="sn-flex sn-gap-3">
            <div class="sn-flex-1">
                <input type="text"
                       name="userId"
                       value="@Model.UserId"
                       placeholder="@T.Pages.ModRolesSearchPh"
                       class="sn-input sn-w-full" />
            </div>
            <button type="submit" class="sn-btn sn-btn-primary">@T.Pages.ModRolesSearchBtn</button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.UserId) && Model.UserProfile != null)
    {
        <!-- User Info -->
        <div class="clean-card sn-mb-6">
            <div class="sn-mod-user-identity">
                <img src="@SnakkUrlHelper.UserAvatar(Model.UserProfile.PublicId)"
                     alt="@Model.UserProfile.DisplayName"
                     width="64" height="64"
                     class="sn-avatar-xl" />
                <div class="sn-flex-1">
                    <h2 class="sn-text-xl sn-font-bold">@Model.UserProfile.DisplayName</h2>
                    <p class="sn-text-muted sn-text-sm">@T.Pages.ModRolesUserIdLabel @Model.UserProfile.PublicId</p>
                </div>
                @if (Model.CanAdminister)
                {
                    <button data-modal-open="assign-modal" class="sn-btn sn-btn-primary sn-btn-sm">
                        <span class="sn-icon icon-plus" aria-hidden="true"></span>
                        @T.Pages.ModRolesAssignBtn
                    </button>
                }
            </div>
        </div>
    }

    <!-- Roles List -->
    <div class="clean-card">
        <h2 class="sn-roles-list-heading">
            @if (!string.IsNullOrEmpty(Model.UserId))
            {
                @T.Pages.ModRolesForUserPrefix@(Model.UserProfile?.DisplayName ?? Model.UserId)
            }
            else
            {
                @T.Pages.ModRolesMyRoles
            }
        </h2>

        @if (Model.Roles == null || !Model.Roles.Any())
        {
            <div class="sn-roles-empty-state">
                <p>@T.Pages.ModRolesNoneFound</p>
            </div>
        }
        else
        {
            <div class="sn-space-y-3">
                @foreach (var role in Model.Roles.Where(r => r.RevokedAt == null).OrderBy(r => r.Role))
                {
                    <div class="sn-role-item">
                        <div class="sn-role-item-user">
                            <img src="@SnakkUrlHelper.UserAvatar(role.UserPublicId)"
                                 alt="@role.UserDisplayName"
                                 width="40" height="40"
                                 class="sn-avatar" />
                            <div>
                                <div class="sn-role-item-name-row">
                                    <span class="sn-font-medium">@role.UserDisplayName</span>
                                    <span class="sn-badge @Model.GetRoleBadgeClass(role.Role) sn-badge-sm">@Model.GetRoleDisplayName(role.Role)</span>
                                </div>
                                <div class="sn-text-xs sn-text-muted">
                                    @if (!string.IsNullOrEmpty(role.CommunityName))
                                    {
                                        <span>@role.CommunityName</span>
                                    }
                                    else if (!string.IsNullOrEmpty(role.HubName))
                                    {
                                        <span>@role.HubName</span>
                                    }
                                    else if (!string.IsNullOrEmpty(role.SpaceName))
                                    {
                                        <span>@role.SpaceName</span>
                                    }
                                    else if (role.Role == "GlobalAdmin")
                                    {
                                        <span>@T.Pages.ModRolesPlatformWide</span>
                                    }
                                    <span class="sn-mx-1">·</span>
                                    <span>@T.Pages.ModRolesAssignedByPrefix @role.AssignedByUserDisplayName @Model.GetRelativeTime(role.AssignedAt)</span>
                                </div>
                            </div>
                        </div>
                        @if (Model.CanAdminister)
                        {
                            <form method="post" asp-page-handler="Revoke"
                                  data-submit-action="confirm-revoke-role" data-confirm-message="@T.Pages.ModRolesRevokeConfirm">
                                <input type="hidden" name="roleId" value="@role.PublicId" />
                                <input type="hidden" name="userId" value="@role.UserPublicId" />
                                <button type="submit" class="sn-btn sn-btn-ghost sn-btn-sm sn-text-error">
                                    @T.Pages.ModRolesRevokeBtn
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>

            @* Show revoked roles if any *@
            @if (Model.Roles.Where(r => r.RevokedAt != null).Any())
            {
                var revokedRoles = Model.Roles.Where(r => r.RevokedAt != null).ToList();
                <div class="sn-mt-6">
                    <h3 class="sn-section-label--roles">@T.Pages.ModRolesRevokedHeading</h3>
                    <div class="sn-space-y-2">
                        @foreach (var role in revokedRoles.OrderByDescending(r => r.RevokedAt))
                        {
                            <div class="sn-role-item--revoked">
                                <div class="sn-role-item-user">
                                    <div>
                                        <span class="sn-badge sn-badge-ghost sn-badge-sm">@Model.GetRoleDisplayName(role.Role)</span>
                                        <span class="sn-role-scope-label">
                                            @if (!string.IsNullOrEmpty(role.CommunityName))
                                            {
                                                @role.CommunityName
                                            }
                                            else if (!string.IsNullOrEmpty(role.HubName))
                                            {
                                                @role.HubName
                                            }
                                            else if (!string.IsNullOrEmpty(role.SpaceName))
                                            {
                                                @role.SpaceName
                                            }
                                        </span>
                                    </div>
                                </div>
                                <span class="sn-text-xs sn-text-muted">@T.Pages.ModRolesRevokedPrefix@(role.RevokedAt.HasValue ? Model.GetRelativeTime(role.RevokedAt.Value) : "")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    @if (Model.CanAdminister && !string.IsNullOrEmpty(Model.UserId))
    {
        <!-- Assign Role Modal -->
        <dialog id="assign-modal" class="sn-modal">
            <div class="sn-modal-box">
                <h3 class="sn-font-bold sn-text-lg">@T.Pages.ModRolesAssignModalTitle</h3>
                <p class="sn-py-2 sn-text-muted">@string.Format(T.Pages.ModRolesAssignModalPrompt, Model.UserProfile?.DisplayName ?? T.Pages.ModRolesAssignModalUserFallback)</p>
                <form method="post" asp-page-handler="Assign">
                    <input type="hidden" name="AssignRequest.TargetUserId" value="@Model.UserId" />

                    <div class="sn-field sn-mb-4">
                        <label class="sn-label">
                            <span class="sn-label-text">@T.Pages.ModRolesRoleTypeLabel</span>
                        </label>
                        <select name="AssignRequest.RoleType" class="sn-select sn-w-full">
                            <option value="SpaceMod">@T.Pages.ModRolesOptionSpaceMod</option>
                            <option value="HubMod">@T.Pages.ModRolesOptionHubMod</option>
                            <option value="CommunityMod">@T.Pages.ModRolesOptionCommunityMod</option>
                            <option value="CommunityAdmin">@T.Pages.ModRolesOptionCommunityAdmin</option>
                        </select>
                    </div>

                    <div class="sn-field sn-mb-4">
                        <label class="sn-label">
                            <span class="sn-label-text">@T.Pages.ModRolesScopeLabel</span>
                        </label>
                        <input type="text" name="AssignRequest.CommunityId" placeholder="@T.Pages.ModRolesCommunityIdPh" class="sn-input sn-w-full sn-mb-2" />
                        <input type="text" name="AssignRequest.HubId" placeholder="@T.Pages.ModRolesHubIdPh" class="sn-input sn-w-full sn-mb-2" />
                        <input type="text" name="AssignRequest.SpaceId" placeholder="@T.Pages.ModRolesSpaceIdPh" class="sn-input sn-w-full" />
                        <label class="sn-label">
                            <span class="sn-label-text-alt sn-text-muted">@T.Pages.ModRolesScopeHelp</span>
                        </label>
                    </div>

                    <div class="sn-modal-action">
                        <button type="button" data-modal-close="assign-modal" class="sn-btn sn-btn-ghost">@T.Pages.ModRolesCancel</button>
                        <button type="submit" class="sn-btn sn-btn-primary">@T.Pages.ModRolesAssignBtn</button>
                    </div>
                </form>
            </div>
            <form method="dialog" class="sn-modal-backdrop-overlay">
                <button>@T.Pages.ModRolesClose</button>
            </form>
        </dialog>
    }
</div>
