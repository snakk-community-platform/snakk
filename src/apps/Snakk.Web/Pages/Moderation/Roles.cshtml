@page
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Moderation.RolesModel
@{
    ViewData["Title"] = T.Pages.ModRolesTitle;
}


@section CenterHeader {
    <a href="/moderation" class="badge badge-ghost badge-sm">@T.Pages.ModCrumb</a>
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Page Header -->
    <div class="page-header">
        <h1>@T.Pages.ModRolesHeading</h1>
        <p>@T.Pages.ModRolesSubtitle</p>
    </div>

    <!-- Search User -->
    <div class="clean-card mb-6">
        <form method="get" class="flex gap-3">
            <div class="flex-1">
                <input type="text"
                       name="userId"
                       value="@Model.UserId"
                       placeholder="@T.Pages.ModRolesSearchPh"
                       class="input w-full" />
            </div>
            <button type="submit" class="btn btn-primary">@T.Pages.ModRolesSearchBtn</button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.UserId) && Model.UserProfile != null)
    {
        <!-- User Info -->
        <div class="clean-card mb-6">
            <div class="flex items-center gap-4">
                <img src="@SnakkUrlHelper.UserAvatar(Model.UserProfile.PublicId)"
                     alt="@Model.UserProfile.DisplayName"
                     width="64" height="64"
                     class="w-16 h-16 rounded-full" />
                <div class="flex-1">
                    <h2 class="text-xl font-bold">@Model.UserProfile.DisplayName</h2>
                    <p class="text-muted text-sm">@T.Pages.ModRolesUserIdLabel @Model.UserProfile.PublicId</p>
                </div>
                @if (Model.CanAdminister)
                {
                    <button data-modal-open="assign-modal" class="btn btn-primary btn-sm">
                        <span class="icon icon-plus h-4 w-4" aria-hidden="true"></span>
                        @T.Pages.ModRolesAssignBtn
                    </button>
                }
            </div>
        </div>
    }

    <!-- Roles List -->
    <div class="clean-card">
        <h2 class="text-lg font-semibold mb-4">
            @if (!string.IsNullOrEmpty(Model.UserId))
            {
                @T.Pages.ModRolesForUserPrefix@(Model.UserProfile?.DisplayName ?? Model.UserId)
            }
            else
            {
                @T.Pages.ModRolesMyRoles
            }
        </h2>

        @if (Model.Roles == null || !Model.Roles.Any())
        {
            <div class="text-center py-8 text-muted">
                <p>@T.Pages.ModRolesNoneFound</p>
            </div>
        }
        else
        {
            <div class="space-y-3">
                @foreach (var role in Model.Roles.Where(r => r.RevokedAt == null).OrderBy(r => r.Role))
                {
                    <div class="flex items-center justify-between p-4 rounded-lg border border-base-300 hover:bg-base-200 transition-colors">
                        <div class="flex items-center gap-3">
                            <img src="@SnakkUrlHelper.UserAvatar(role.UserPublicId)"
                                 alt="@role.UserDisplayName"
                                 width="40" height="40"
                                 class="w-10 h-10 rounded-full" />
                            <div>
                                <div class="flex items-center gap-2 mb-1">
                                    <span class="font-medium">@role.UserDisplayName</span>
                                    <span class="badge @Model.GetRoleBadgeClass(role.Role) badge-sm">@Model.GetRoleDisplayName(role.Role)</span>
                                </div>
                                <div class="text-xs text-muted">
                                    @if (!string.IsNullOrEmpty(role.CommunityName))
                                    {
                                        <span>@role.CommunityName</span>
                                    }
                                    else if (!string.IsNullOrEmpty(role.HubName))
                                    {
                                        <span>@role.HubName</span>
                                    }
                                    else if (!string.IsNullOrEmpty(role.SpaceName))
                                    {
                                        <span>@role.SpaceName</span>
                                    }
                                    else if (role.Role == "GlobalAdmin")
                                    {
                                        <span>@T.Pages.ModRolesPlatformWide</span>
                                    }
                                    <span class="mx-1">·</span>
                                    <span>@T.Pages.ModRolesAssignedByPrefix @role.AssignedByUserDisplayName @Model.GetRelativeTime(role.AssignedAt)</span>
                                </div>
                            </div>
                        </div>
                        @if (Model.CanAdminister)
                        {
                            <form method="post" asp-page-handler="Revoke"
                                  data-submit-action="confirm-revoke-role" data-confirm-message="@T.Pages.ModRolesRevokeConfirm">
                                <input type="hidden" name="roleId" value="@role.PublicId" />
                                <input type="hidden" name="userId" value="@role.UserPublicId" />
                                <button type="submit" class="btn btn-ghost btn-sm text-error">
                                    @T.Pages.ModRolesRevokeBtn
                                </button>
                            </form>
                        }
                    </div>
                }
            </div>

            @* Show revoked roles if any *@
            @if (Model.Roles.Where(r => r.RevokedAt != null).Any())
            {
                var revokedRoles = Model.Roles.Where(r => r.RevokedAt != null).ToList();
                <div class="mt-6">
                    <h3 class="text-sm font-semibold text-muted uppercase tracking-wide mb-3">@T.Pages.ModRolesRevokedHeading</h3>
                    <div class="space-y-2">
                        @foreach (var role in revokedRoles.OrderByDescending(r => r.RevokedAt))
                        {
                            <div class="flex items-center justify-between p-3 rounded-lg bg-base-200 opacity-60">
                                <div class="flex items-center gap-3">
                                    <div>
                                        <span class="badge badge-ghost badge-sm">@Model.GetRoleDisplayName(role.Role)</span>
                                        <span class="text-xs text-muted ml-2">
                                            @if (!string.IsNullOrEmpty(role.CommunityName))
                                            {
                                                @role.CommunityName
                                            }
                                            else if (!string.IsNullOrEmpty(role.HubName))
                                            {
                                                @role.HubName
                                            }
                                            else if (!string.IsNullOrEmpty(role.SpaceName))
                                            {
                                                @role.SpaceName
                                            }
                                        </span>
                                    </div>
                                </div>
                                <span class="text-xs text-muted">@T.Pages.ModRolesRevokedPrefix@(role.RevokedAt.HasValue ? Model.GetRelativeTime(role.RevokedAt.Value) : "")</span>
                            </div>
                        }
                    </div>
                </div>
            }
        }
    </div>

    @if (Model.CanAdminister && !string.IsNullOrEmpty(Model.UserId))
    {
        <!-- Assign Role Modal -->
        <dialog id="assign-modal" class="modal">
            <div class="modal-box">
                <h3 class="font-bold text-lg">@T.Pages.ModRolesAssignModalTitle</h3>
                <p class="py-2 text-muted">@string.Format(T.Pages.ModRolesAssignModalPrompt, Model.UserProfile?.DisplayName ?? T.Pages.ModRolesAssignModalUserFallback)</p>
                <form method="post" asp-page-handler="Assign">
                    <input type="hidden" name="AssignRequest.TargetUserId" value="@Model.UserId" />

                    <div class="form-control mb-4">
                        <label class="label">
                            <span class="label-text">@T.Pages.ModRolesRoleTypeLabel</span>
                        </label>
                        <select name="AssignRequest.RoleType" class="select w-full">
                            <option value="SpaceMod">@T.Pages.ModRolesOptionSpaceMod</option>
                            <option value="HubMod">@T.Pages.ModRolesOptionHubMod</option>
                            <option value="CommunityMod">@T.Pages.ModRolesOptionCommunityMod</option>
                            <option value="CommunityAdmin">@T.Pages.ModRolesOptionCommunityAdmin</option>
                        </select>
                    </div>

                    <div class="form-control mb-4">
                        <label class="label">
                            <span class="label-text">@T.Pages.ModRolesScopeLabel</span>
                        </label>
                        <input type="text" name="AssignRequest.CommunityId" placeholder="@T.Pages.ModRolesCommunityIdPh" class="input w-full mb-2" />
                        <input type="text" name="AssignRequest.HubId" placeholder="@T.Pages.ModRolesHubIdPh" class="input w-full mb-2" />
                        <input type="text" name="AssignRequest.SpaceId" placeholder="@T.Pages.ModRolesSpaceIdPh" class="input w-full" />
                        <label class="label">
                            <span class="label-text-alt text-muted">@T.Pages.ModRolesScopeHelp</span>
                        </label>
                    </div>

                    <div class="modal-action">
                        <button type="button" data-modal-close="assign-modal" class="btn btn-ghost">@T.Pages.ModRolesCancel</button>
                        <button type="submit" class="btn btn-primary">@T.Pages.ModRolesAssignBtn</button>
                    </div>
                </form>
            </div>
            <form method="dialog" class="modal-backdrop">
                <button>@T.Pages.ModRolesClose</button>
            </form>
        </dialog>
    }
</div>
