@page
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Moderation.IndexModel
@{
    ViewData["Title"] = T.Pages.ModIndexTitle;
}


<div class="max-w-[90rem] sn-mx-auto sn-px-4 sn-py-8">
    <!-- Page Header -->
    <div class="page-header">
        <h1>@T.Pages.ModIndexHeading</h1>
        <p>@T.Pages.ModIndexSubtitle</p>
    </div>

    <!-- Quick Stats -->
    <div class="sn-grid sn-grid-cols-2 sn-md:grid-cols-4 sn-gap-4 sn-mb-6">
        <div class="clean-card sn-text-center">
            <div class="sn-text-3xl sn-font-bold sn-text-primary">@Model.PendingReportCount</div>
            <div class="sn-text-sm sn-text-muted">@T.Pages.ModIndexPendingReports</div>
        </div>
        <div class="clean-card sn-text-center">
            <div class="sn-text-3xl sn-font-bold">@(Model.MyRoles?.Count() ?? 0)</div>
            <div class="sn-text-sm sn-text-muted">@T.Pages.ModIndexActiveRoles</div>
        </div>
        <div class="clean-card sn-text-center">
            <a href="/moderation/reports" class="sn-btn sn-btn-primary sn-btn-sm">@T.Pages.ModIndexViewReports</a>
        </div>
        <div class="clean-card sn-text-center">
            <a href="/moderation/logs" class="sn-btn sn-btn-ghost sn-btn-sm">@T.Pages.ModIndexViewLogs</a>
        </div>
    </div>

    <div class="sn-grid sn-md:grid-cols-3 sn-gap-3">
        <!-- My Roles -->
        <div class="sn-md:col-span-1">
            <div class="clean-card">
                <h2 class="sn-text-lg sn-font-semibold sn-mb-4">@T.Pages.ModIndexMyRoles</h2>
                @if (Model.MyRoles == null || !Model.MyRoles.Any())
                {
                    <p class="sn-text-muted sn-text-sm">@T.Pages.ModIndexNoActiveRoles</p>
                }
                else
                {
                    <div class="sn-space-y-3">
                        @foreach (var role in Model.MyRoles)
                        {
                            <div class="sn-mod-role-row">
                                <div>
                                    <span class="sn-badge @Model.GetRoleBadgeClass(role.Role) sn-badge-sm">@Model.GetRoleDisplayName(role.Role)</span>
                                    @if (!string.IsNullOrEmpty(role.CommunityName))
                                    {
                                        <div class="sn-text-xs sn-text-muted sn-mt-1">@role.CommunityName</div>
                                    }
                                    else if (!string.IsNullOrEmpty(role.HubName))
                                    {
                                        <div class="sn-text-xs sn-text-muted sn-mt-1">@role.HubName</div>
                                    }
                                    else if (!string.IsNullOrEmpty(role.SpaceName))
                                    {
                                        <div class="sn-text-xs sn-text-muted sn-mt-1">@role.SpaceName</div>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Quick Links -->
            <div class="clean-card sn-mt-4">
                <h2 class="sn-text-lg sn-font-semibold sn-mb-4">@T.Pages.ModIndexQuickLinks</h2>
                <nav class="sn-space-y-2">
                    <a href="/moderation/reports" class="sn-block sn-p-2 sn-hover:bg-base-200 sn-rounded-lg sn-transition-colors">
                        <div class="sn-icon-label-row">
                            <span class="sn-icon icon-exclamation-triangle sn-icon--md sn-text-warning" aria-hidden="true"></span>
                            @T.Pages.ModIndexReports
                            @if (Model.PendingReportCount > 0)
                            {
                                <span class="sn-badge sn-badge-warning sn-badge-sm">@Model.PendingReportCount</span>
                            }
                        </div>
                    </a>
                    <a href="/moderation/bans" class="sn-block sn-p-2 sn-hover:bg-base-200 sn-rounded-lg sn-transition-colors">
                        <div class="sn-icon-label-row">
                            <span class="sn-icon icon-ban sn-icon--md sn-text-error" aria-hidden="true"></span>
                            @T.Pages.ModIndexBans
                        </div>
                    </a>
                    <a href="/moderation/roles" class="sn-block sn-p-2 sn-hover:bg-base-200 sn-rounded-lg sn-transition-colors">
                        <div class="sn-icon-label-row">
                            <span class="sn-icon icon-users-group sn-icon--md sn-text-info" aria-hidden="true"></span>
                            @T.Pages.ModIndexRoles
                        </div>
                    </a>
                    <a href="/moderation/logs" class="sn-block sn-p-2 sn-hover:bg-base-200 sn-rounded-lg sn-transition-colors">
                        <div class="sn-icon-label-row">
                            <span class="sn-icon icon-clipboard-list sn-icon--md text-secondary" aria-hidden="true"></span>
                            @T.Pages.ModIndexAuditLog
                        </div>
                    </a>
                </nav>
            </div>
        </div>

        <!-- Recent Activity -->
        <div class="sn-md:col-span-2">
            <!-- Pending Reports -->
            <div class="clean-card sn-mb-4">
                <div class="sn-card-section-header">
                    <h2 class="sn-text-lg sn-font-semibold">@T.Pages.ModIndexPendingReports</h2>
                    <a href="/moderation/reports" class="sn-text-sm sn-text-primary sn-hover:underline">@T.Pages.ModIndexViewAll</a>
                </div>
                @if (Model.PendingReports?.Items == null || !Model.PendingReports.Items.Any())
                {
                    <div class="sn-text-center sn-py-8 sn-text-muted">
                        <span class="sn-icon icon-check-circle sn-h-12 sn-w-12 sn-mx-auto sn-mb-2 sn-opacity-50" aria-hidden="true"></span>
                        <p>@T.Pages.ModIndexNoPendingReports</p>
                    </div>
                }
                else
                {
                    <div class="sn-space-y-3">
                        @foreach (var report in Model.PendingReports.Items.Take(5))
                        {
                            <a href="/moderation/reports/@report.PublicId" class="sn-block sn-p-3 sn-hover:bg-base-200 sn-rounded-lg sn-transition-colors sn-border sn-border-base-300">
                                <div class="sn-mod-report-row">
                                    <img src="@SnakkUrlHelper.UserAvatar(report.ReporterUserPublicId)"
                                         alt="@report.ReporterUserDisplayName"
                                         width="32" height="32"
                                         class="sn-avatar-sm" />
                                    <div class="sn-flex-1 sn-min-w-0">
                                        <div class="sn-icon-label-row">
                                            <span class="sn-font-medium sn-text-sm">@report.ReporterUserDisplayName</span>
                                            <span class="sn-text-xs sn-text-muted">@T.Pages.ModIndexReported</span>
                                            @if (!string.IsNullOrEmpty(report.ReportedUserDisplayName))
                                            {
                                                <span class="sn-text-sm sn-font-medium">@report.ReportedUserDisplayName</span>
                                            }
                                            else if (!string.IsNullOrEmpty(report.ReportedPostContentSnippet))
                                            {
                                                <span class="sn-text-sm">@T.Pages.ModIndexAPost</span>
                                            }
                                            else if (!string.IsNullOrEmpty(report.ReportedDiscussionTitle))
                                            {
                                                <span class="sn-text-sm">@T.Pages.ModIndexADiscussion</span>
                                            }
                                        </div>
                                        @if (!string.IsNullOrEmpty(report.ReasonName))
                                        {
                                            <div class="sn-text-xs sn-text-muted sn-mt-1">@T.Pages.ModIndexReason @report.ReasonName</div>
                                        }
                                        @if (!string.IsNullOrEmpty(report.Details))
                                        {
                                            <div class="sn-text-sm sn-mt-1 sn-text-muted sn-truncate">@report.Details</div>
                                        }
                                        <div class="sn-text-xs sn-text-muted sn-mt-1">@Model.GetRelativeTime(report.CreatedAt)</div>
                                    </div>
                                    <span class="sn-badge sn-badge-warning sn-badge-sm">@T.Pages.ModIndexPendingBadge</span>
                                </div>
                            </a>
                        }
                    </div>
                }
            </div>

            <!-- Recent Activity Log -->
            <div class="clean-card">
                <div class="sn-card-section-header">
                    <h2 class="sn-text-lg sn-font-semibold">@T.Pages.ModIndexRecentActivity</h2>
                    <a href="/moderation/logs" class="sn-text-sm sn-text-primary sn-hover:underline">@T.Pages.ModIndexViewAll</a>
                </div>
                @if (Model.RecentLogs?.Items == null || !Model.RecentLogs.Items.Any())
                {
                    <p class="sn-text-muted sn-text-sm">@T.Pages.ModIndexNoRecentActivity</p>
                }
                else
                {
                    <div class="sn-space-y-3">
                        @foreach (var log in Model.RecentLogs.Items.Take(10))
                        {
                            <div class="sn-mod-log-row">
                                <img src="@SnakkUrlHelper.UserAvatar(log.ActorUserPublicId)"
                                     alt="@log.ActorUserDisplayName"
                                     width="32" height="32"
                                     class="sn-avatar-sm" />
                                <div class="sn-flex-1 sn-min-w-0">
                                    <div class="sn-text-sm">
                                        <span class="sn-font-medium">@log.ActorUserDisplayName</span>
                                        <span class="sn-text-muted">@Model.GetActionDisplayName(log.Action).ToLower()</span>
                                        @if (!string.IsNullOrEmpty(log.TargetUserDisplayName))
                                        {
                                            <span class="sn-font-medium">@log.TargetUserDisplayName</span>
                                        }
                                        @if (!string.IsNullOrEmpty(log.TargetDiscussionTitle))
                                        {
                                            <span class="sn-truncate">"@log.TargetDiscussionTitle"</span>
                                        }
                                    </div>
                                    @if (!string.IsNullOrEmpty(log.SpaceName))
                                    {
                                        <div class="sn-text-xs sn-text-muted">@T.Pages.ModIndexIn @log.SpaceName</div>
                                    }
                                    else if (!string.IsNullOrEmpty(log.HubName))
                                    {
                                        <div class="sn-text-xs sn-text-muted">@T.Pages.ModIndexIn @log.HubName</div>
                                    }
                                    else if (!string.IsNullOrEmpty(log.CommunityName))
                                    {
                                        <div class="sn-text-xs sn-text-muted">@T.Pages.ModIndexIn @log.CommunityName</div>
                                    }
                                </div>
                                <div class="sn-text-xs sn-text-muted sn-whitespace-nowrap">@Model.GetRelativeTime(log.CreatedAt)</div>
                            </div>
                        }
                    </div>
                }
            </div>
        </div>
    </div>
</div>
