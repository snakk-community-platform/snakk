@page
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Moderation.BansModel
@{
    ViewData["Title"] = T.Pages.ModBansTitle;
}

@section CenterHeader {
    <a href="/moderation" class="sn-badge sn-badge-ghost sn-badge-sm">@T.Pages.ModCrumb</a>
}

<div class="max-w-4xl mx-auto px-4 py-8">
    <!-- Page Header -->
    <div class="page-header">
        <h1>@T.Pages.ModBansHeading</h1>
        <p>@T.Pages.ModBansSubtitle</p>
    </div>

    <!-- Search User -->
    <div class="clean-card mb-6">
        <form method="get" class="sn-flex sn-gap-3">
            <div class="sn-flex-1">
                <input type="text"
                       name="userId"
                       value="@Model.UserId"
                       placeholder="@T.Pages.ModBansSearchPh"
                       class="sn-input sn-w-full" />
            </div>
            <button type="submit" class="sn-btn sn-btn-primary">@T.Pages.ModBansSearchBtn</button>
        </form>
    </div>

    @if (!string.IsNullOrEmpty(Model.UserId))
    {
        @if (Model.UserProfile != null)
        {
            <!-- User Info -->
            <div class="clean-card sn-mb-6">
                <div class="sn-mod-user-header">
                    <img src="@SnakkUrlHelper.UserAvatar(Model.UserProfile.PublicId)"
                         alt="@Model.UserProfile.DisplayName"
                         width="64" height="64"
                         class="sn-avatar-xl" />
                    <div class="sn-flex-1">
                        <h2 class="sn-text-xl sn-font-bold">@Model.UserProfile.DisplayName</h2>
                        <p class="sn-text-muted sn-text-sm">@T.Pages.ModBansUserIdLabel @Model.UserProfile.PublicId</p>
                        <p class="sn-text-muted sn-text-sm">@T.Pages.ModBansJoined @Model.GetRelativeTime(Model.UserProfile.JoinedAt?.ToDateTime())</p>
                    </div>
                    @if (Model.CanModerate)
                    {
                        <button data-modal-open="ban-modal" class="sn-btn sn-btn-error sn-btn-sm">
                            <span class="sn-icon icon-ban" aria-hidden="true"></span>
                            @T.Pages.ModBansBanUserBtn
                        </button>
                    }
                </div>
            </div>

            <!-- Bans List -->
            <div class="clean-card">
                <h2 class="sn-section-label--bans">@T.Pages.ModBansHistoryHeading</h2>

                @if (Model.Bans == null || !Model.Bans.Any())
                {
                    <div class="sn-empty-state">
                        <span class="sn-icon icon-check-circle sn-h-12 sn-w-12 sn-mx-auto sn-mb-2 sn-opacity-50" aria-hidden="true"></span>
                        <p>@T.Pages.ModBansNoneFound</p>
                    </div>
                }
                else
                {
                    <div class="sn-space-y-4">
                        @foreach (var ban in Model.Bans.OrderByDescending(b => b.BannedAt))
                        {
                            var isActive = Model.IsActiveBan(ban);
                            <div class="sn-ban-record @(isActive ? "sn-border-error bg-error/5" : "sn-border-base-300")">
                                <div class="sn-ban-record-row">
                                    <div>
                                        <div class="sn-ban-badges-row">
                                            <span class="sn-badge @(isActive ? "sn-badge-error" : "sn-badge-ghost")">
                                                @(isActive ? T.Pages.ModBansActive : ban.UnbannedAt.HasValue ? T.Pages.ModBansLifted : T.Pages.ModBansExpired)
                                            </span>
                                            <span class="sn-badge sn-badge-outline">
                                                @(ban.BanType == "ReadWrite" ? T.Pages.ModBansReadWrite : T.Pages.ModBansWriteOnly)
                                            </span>
                                        </div>
                                        <div class="sn-text-sm sn-space-y-1">
                                            @if (!string.IsNullOrEmpty(ban.SpaceName))
                                            {
                                                <div><span class="sn-text-muted">@T.Pages.ModBansScope</span> @T.Pages.ModBansScopeSpace @ban.SpaceName</div>
                                            }
                                            else if (!string.IsNullOrEmpty(ban.HubName))
                                            {
                                                <div><span class="sn-text-muted">@T.Pages.ModBansScope</span> @T.Pages.ModBansScopeHub @ban.HubName</div>
                                            }
                                            else if (!string.IsNullOrEmpty(ban.CommunityName))
                                            {
                                                <div><span class="sn-text-muted">@T.Pages.ModBansScope</span> @T.Pages.ModBansScopeCommunity @ban.CommunityName</div>
                                            }
                                            else
                                            {
                                                <div><span class="sn-text-muted">@T.Pages.ModBansScope</span> @T.Pages.ModBansScopePlatform</div>
                                            }
                                            @if (!string.IsNullOrEmpty(ban.Reason))
                                            {
                                                <div><span class="sn-text-muted">@T.Pages.ModBansReason</span> @ban.Reason</div>
                                            }
                                            <div>
                                                <span class="sn-text-muted">@T.Pages.ModBansBannedBy</span> @ban.BannedByUserDisplayName
                                                <span class="sn-text-muted">@T.Pages.ModBansOn</span> @Model.FormatRelativeTime(ban.BannedAt)
                                            </div>
                                            @if (ban.ExpiresAt.HasValue)
                                            {
                                                <div><span class="sn-text-muted">@T.Pages.ModBansExpires</span> @Model.FormatRelativeTime(ban.ExpiresAt.Value)</div>
                                            }
                                            else
                                            {
                                                <div><span class="sn-text-muted">@T.Pages.ModBansDuration</span> @T.Pages.ModBansPermanent</div>
                                            }
                                            @if (ban.UnbannedAt.HasValue)
                                            {
                                                <div>
                                                    <span class="sn-text-muted">@T.Pages.ModBansUnbannedBy</span> @ban.UnbannedByUserDisplayName
                                                    <span class="sn-text-muted">@T.Pages.ModBansOn</span> @Model.FormatRelativeTime(ban.UnbannedAt.Value)
                                                </div>
                                            }
                                        </div>
                                    </div>
                                    @if (isActive && Model.CanModerate)
                                    {
                                        <form method="post" asp-page-handler="Unban">
                                            <input type="hidden" name="banId" value="@ban.PublicId" />
                                            <input type="hidden" name="userId" value="@Model.UserId" />
                                            <button type="submit" class="sn-btn sn-btn-ghost sn-btn-sm">@T.Pages.ModBansLiftBtn</button>
                                        </form>
                                    }
                                </div>
                            </div>
                        }
                    </div>
                }
            </div>

            <!-- Ban Modal -->
            <dialog id="ban-modal" class="sn-modal">
                <div class="sn-modal-box">
                    <h3 class="sn-font-bold sn-text-lg">@T.Pages.ModBansModalTitle</h3>
                    <p class="sn-py-2 sn-text-muted">@string.Format(T.Pages.ModBansModalPrompt, Model.UserProfile.DisplayName)</p>
                    <form method="post" asp-page-handler="Ban">
                        <input type="hidden" name="BanRequest.TargetUserId" value="@Model.UserId" />

                        <div class="sn-field sn-mb-4">
                            <label class="sn-label">
                                <span class="sn-label-text">@T.Pages.ModBansTypeLabel</span>
                            </label>
                            <select name="BanRequest.BanType" class="sn-select sn-w-full">
                                <option value="WriteOnly">@T.Pages.ModBansTypeWriteOnly</option>
                                <option value="ReadWrite">@T.Pages.ModBansTypeReadWrite</option>
                            </select>
                        </div>

                        <div class="sn-field sn-mb-4">
                            <label class="sn-label">
                                <span class="sn-label-text">@T.Pages.ModBansScopeLabel</span>
                            </label>
                            <input type="text" name="BanRequest.CommunityId" placeholder="@T.Pages.ModBansCommunityIdPh" class="sn-input sn-w-full sn-mb-2" />
                            <input type="text" name="BanRequest.HubId" placeholder="@T.Pages.ModBansHubIdPh" class="sn-input sn-w-full sn-mb-2" />
                            <input type="text" name="BanRequest.SpaceId" placeholder="@T.Pages.ModBansSpaceIdPh" class="sn-input sn-w-full" />
                        </div>

                        <div class="sn-field sn-mb-4">
                            <label class="sn-label">
                                <span class="sn-label-text">@T.Pages.ModBansReasonLabel</span>
                            </label>
                            <textarea name="BanRequest.Reason" class="sn-textarea sn-w-full" rows="2" placeholder="@T.Pages.ModBansReasonPh"></textarea>
                        </div>

                        <div class="sn-field sn-mb-4">
                            <label class="sn-label">
                                <span class="sn-label-text">@T.Pages.ModBansExpiresLabel</span>
                            </label>
                            <input type="datetime-local" name="BanRequest.ExpiresAt" class="sn-input sn-w-full" />
                        </div>

                        <div class="sn-modal-action">
                            <button type="button" data-modal-close="ban-modal" class="sn-btn sn-btn-ghost">@T.Pages.ModBansCancel</button>
                            <button type="submit" class="sn-btn sn-btn-error">@T.Pages.ModBansBanUserBtn</button>
                        </div>
                    </form>
                </div>
                <form method="dialog" class="sn-modal-backdrop-overlay">
                    <button>@T.Pages.ModBansClose</button>
                </form>
            </dialog>
        }
        else
        {
            <div class="clean-card">
                <div class="empty-state-simple">
                    <h3>@T.Pages.ModBansUserNotFound</h3>
                    <p>@string.Format(T.Pages.ModBansUserNotFoundBody, Model.UserId)</p>
                </div>
            </div>
        }
    }
    else
    {
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>@T.Pages.ModBansSearchUserTitle</h3>
                <p>@T.Pages.ModBansSearchUserBody</p>
            </div>
        </div>
    }
</div>
