@page
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model SearchModel
@{
    ViewData["Title"] = string.IsNullOrEmpty(Model.Q) ? T.Pages.SearchTitle : $"{T.Pages.SearchResultsFor}{Model.Q}";
}

@section Styles {
    <link rel="preload" href="@SnakkUrlHelper.Css("search")" as="style" asp-append-version="true" />
    <script>(function(){var p=document.currentScript.previousElementSibling;if(p){var s=document.createElement('link');s.rel='stylesheet';s.media='print';s.href=p.href;s.onload=function(){this.media='all'};document.head.appendChild(s);}})();</script>
    <noscript><link rel="stylesheet" href="@SnakkUrlHelper.Css("search")" asp-append-version="true" /></noscript>
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div class="sn-search-card">
        <div class="sn-search-card-banner">
            <span class="sn-search-avatar"><span class="icon icon-search" aria-hidden="true"></span></span>
            <h1 class="sn-search-name">
                @if (!string.IsNullOrEmpty(Model.Q))
                {
                    @T.Pages.SearchResultsFor@Model.Q
                }
                else
                {
                    @T.Pages.SearchTitle
                }
            </h1>
        </div>
    </div>

    <div class="sn-center-inner">
        <!-- Results -->
        <h2 class="sn-section-title">
            <span class="icon icon-search" aria-hidden="true"></span>
            @T.Pages.SearchResultsHeading
        </h2>

        <div id="search-results">
            <partial name="_SearchResults" model="Model" />
        </div>
    </div>
</div>

<!-- Right Column -->
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/create";
}
<vc:global-right-sidebar />

@section Scripts {
    <script src="@SnakkUrlHelper.Js("pages/search-page")" asp-append-version="true" defer></script>
}
