@page "/messages"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.Messages.IndexModel
@{
    ViewData["Title"] = T.Pages.MessagesTitle;
    ViewData["Description"] = "Your private conversations.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="sn-center">
    <div class="sn-center-inner">
        <div class="sn-section-header">
            <h2 class="sn-section-title">
                <span class="icon icon-chat-bubbles" aria-hidden="true"></span>
                @T.Pages.MessagesHeading
            </h2>
        </div>

        @if (Model.Conversations.Count == 0)
        {
            <div class="sn-text-sm sn-py-8 sn-text-center" style="color: var(--text-tertiary)">
                <span class="icon icon-chat-bubbles sn-h-10 sn-w-10 sn-mx-auto sn-mb-3 sn-opacity-30" aria-hidden="true"></span>
                <p>@T.Pages.MessagesEmpty</p>
            </div>
        }
        else
        {
            <div class="sn-flex sn-flex-col divide-y divide-subtle" id="dm-conv-list">
                @foreach (var conv in Model.Conversations)
                {
                    var lastMsgAt = conv.LastMessageAt?.ToDateTime() ?? DateTime.UtcNow;
                    var isPinned = conv.IsPinned;
                    <div class="sn-dm-conv-row dm-conv-row"
                         data-conv-id="@conv.PublicId"
                         data-is-pinned="@isPinned.ToString().ToLower()">
                        <a href="/messages/@conv.PublicId"
                           class="sn-dm-conv-link sn-flex-1 sn-min-w-0">
                            <div class="sn-avatar avatar-sm sn-shrink-0">
                                <img src="@SnakkUrlHelper.UserAvatarThumbnail(conv.OtherUser.PublicId, avatarThumbnailFileName: conv.OtherUser.HasAvatarThumbnailFileName ? conv.OtherUser.AvatarThumbnailFileName : null)"
                                     alt="@conv.OtherUser.DisplayName"
                                     loading="lazy" />
                            </div>
                            <div class="sn-flex-1 sn-min-w-0">
                                <div class="sn-dm-conv-name-row">
                                    @if (isPinned)
                                    {
                                        <span class="icon icon-bookmark h-3 w-3 sn-opacity-60 sn-shrink-0" aria-hidden="true"></span>
                                    }
                                    <div class="sn-font-medium sn-text-sm sn-truncate">@conv.OtherUser.DisplayName</div>
                                </div>
                                @if (conv.HasLastMessageExcerpt && !string.IsNullOrEmpty(conv.LastMessageExcerpt))
                                {
                                    <div class="sn-text-xs sn-text-muted sn-truncate sn-mt-0.5">@conv.LastMessageExcerpt</div>
                                }
                            </div>
                            <div class="sn-text-xs sn-text-muted sn-shrink-0">
                                @Model.GetRelativeTime(lastMsgAt)
                            </div>
                        </a>
                        <div class="sn-flex sn-items-center gap-0.5 sn-shrink-0">
                            <button type="button"
                                    class="dm-pin-btn sn-btn sn-btn-ghost sn-btn-xs sn-btn-square"
                                    data-conv-id="@conv.PublicId"
                                    data-is-pinned="@isPinned.ToString().ToLower()"
                                    aria-label="@(isPinned ? "Unpin conversation" : "Pin conversation")"
                                    title="@(isPinned ? "Unpin" : "Pin")">
                                <span class="icon @(isPinned ? "icon-bookmark" : "icon-bookmark-alt") sn-h-3.5 sn-w-3.5" aria-hidden="true"></span>
                            </button>
                            <button type="button"
                                    class="dm-delete-conv-btn sn-btn sn-btn-ghost sn-btn-xs sn-btn-square sn-text-error"
                                    data-conv-id="@conv.PublicId"
                                    aria-label="Delete conversation"
                                    title="Delete conversation">
                                <span class="icon icon-trash sn-h-3.5 sn-w-3.5" aria-hidden="true"></span>
                            </button>
                        </div>
                    </div>
                }
            </div>

            @if (Model.HasMoreItems)
            {
                <div hx-get="/messages?offset=@Model.NextOffset"
                     hx-trigger="revealed once"
                     hx-swap="outerHTML"
                     hx-target="this"
                     hx-push-url="false"
                     class="sn-load-more-indicator">
                    <span class="icon icon-ellipsis-horizontal animate-pulse" aria-hidden="true"></span>
                </div>
            }
        }
    </div>
</div>

<!-- Delete conversation confirmation modal -->
<dialog id="dm-delete-conv-modal" class="sn-modal">
    <div class="sn-modal-box">
        <h3 class="sn-modal-title">Delete conversation</h3>
        <p class="sn-modal-description--index">Choose how to delete this conversation.</p>
        <div class="sn-modal-btn-group">
            <button id="dm-confirm-delete-for-me-btn" class="sn-btn sn-btn-sm sn-btn-outline sn-w-full">
                Delete for me
                <span class="sn-btn-hint">(hides from your view)</span>
            </button>
            <button id="dm-confirm-delete-for-all-btn" class="sn-btn sn-btn-sm sn-btn-error sn-w-full">
                Delete for everyone
                <span class="sn-btn-hint--index">(permanently removes for all)</span>
            </button>
        </div>
        <div class="sn-modal-action sn-mt-4">
            <form method="dialog">
                <button class="sn-btn sn-btn-ghost sn-btn-sm">Cancel</button>
            </form>
        </div>
    </div>
    <form method="dialog" class="sn-modal-backdrop-overlay"><button>close</button></form>
</dialog>

<script src="@SnakkUrlHelper.Js("pages/dm-index")" asp-append-version="true" defer></script>
