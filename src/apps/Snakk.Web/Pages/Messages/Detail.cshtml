@page "/messages/{conversationId}"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@model Snakk.Web.Pages.Messages.DetailModel
@{
    ViewData["Title"] = Model.Conversation != null
        ? $"{T.Pages.MessagesTitle} - {Model.Conversation.OtherUser.DisplayName}"
        : T.Pages.MessagesTitle;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="sn-center">
    <div class="sn-center-inner">
        @if (Model.Conversation == null)
        {
            <p class="sn-text-muted sn-py-8 sn-text-center">Conversation not found.</p>
        }
        else
        {
            <!-- Scoping marker — CSS uses body:has(#dm-detail-page-marker) to apply layout overrides -->
            <div id="dm-detail-page-marker" hidden></div>

            <!-- Hidden data elements -->
            <input type="hidden" id="dm-conversation-id" value="@Model.ConversationId" />
            <input type="hidden" id="dm-current-user-id" value="@Model.CurrentUserPublicId" />

            <!-- Header -->
            <div class="sn-dm-detail-header">
                <a href="/messages" class="sn-btn sn-btn-ghost sn-btn-sm sn-btn-square" aria-label="Back to messages">
                    <span class="icon icon-chevron-left sn-h-4 sn-w-4" aria-hidden="true"></span>
                </a>
                <div class="sn-avatar avatar-sm">
                    <img src="@Model.Conversation.OtherUser.AvatarUrl"
                         alt="@Model.Conversation.OtherUser.DisplayName"
                         loading="lazy" />
                </div>
                <a href="@SnakkUrlHelper.UserProfile(Model.Conversation.OtherUser.Slug)"
                   class="sn-dm-header-username sn-flex-1 sn-min-w-0 sn-truncate">
                    @Model.Conversation.OtherUser.DisplayName
                </a>
                <button id="dm-delete-conv-btn"
                        class="sn-btn sn-btn-ghost sn-btn-sm sn-text-error sn-gap-1 sn-text-xs"
                        aria-label="Delete conversation">
                    <span class="icon icon-trash sn-h-3.5 sn-w-3.5" aria-hidden="true"></span>
                    Delete conversation
                </button>
            </div>

            <!-- Message list -->
            <div id="dm-message-list" class="sn-dm-detail-messages">
                @if (Model.HasMoreMessages)
                {
                    <div class="sn-text-center sn-pb-2">
                        <a href="/messages/@Model.ConversationId?offset=@(Model.Messages.Count)"
                           class="sn-text-xs sn-text-muted sn-hover:underline">
                            Load older messages
                        </a>
                    </div>
                }

                @{
                    string dmPrevSender = "";
                    string dmPrevDate = "";
                    var today = DateTime.UtcNow.Date;
                }
                @if (Model.Messages.Count == 0)
                {
                    <div class="sn-text-sm sn-py-8 sn-text-center" style="color: var(--text-tertiary)">
                        <p>@T.Pages.MessagesDetailEmpty</p>
                    </div>
                }
                else
                {
                    @foreach (var msg in Enumerable.Reverse(Model.Messages))
                    {
                        DateTime.TryParse(msg.CreatedAt, out var msgDt);
                        var msgDateStr = msgDt == default ? "" : msgDt.ToString("yyyy-MM-dd");
                        var needsDateSep = dmPrevDate.Length > 0 && msgDateStr != dmPrevDate;
                        var isFirstInGroup = dmPrevDate.Length == 0 || needsDateSep || dmPrevSender != msg.SenderPublicId;
                        var dateLabel = msgDt.Date == today ? "Today"
                            : msgDt.Date == today.AddDays(-1) ? "Yesterday"
                            : msgDt.ToString("MMMM d");
                        if (needsDateSep || dmPrevDate.Length == 0)
                        {
                            <div class="sn-dm-date-separator"><span>@dateLabel</span></div>
                        }
                        <div id="dm-msg-@msg.PublicId"
                             class="sn-dm-msg-row sn-flex sn-items-center gap-1.5"
                             data-msg-id="@msg.PublicId"
                             data-is-mine="@msg.IsMine.ToString().ToLower()">
                            <input type="checkbox" class="dm-msg-check sn-dm-detail-check" aria-label="Select message" />
                            <div class="sn-dm-bubble @(msg.IsMine ? "dm-bubble--mine" : "dm-bubble--theirs") @(isFirstInGroup ? "sn-dm-bubble--first-in-group" : "") sn-flex-1"
                                 data-sender-public-id="@msg.SenderPublicId"
                                 data-date-str="@msgDateStr">
                                <div class="sn-dm-bubble-body">
                                    <div class="sn-dm-bubble-content">@msg.Content</div>
                                    <span class="sn-dm-bubble-time">@msgDt.ToString("HH:mm")</span>
                                </div>
                            </div>
                        </div>
                        dmPrevSender = msg.SenderPublicId;
                        dmPrevDate = msgDateStr;
                    }
                }
            </div>

            <!-- Delete action pane — appears between messages and compose when messages are checked -->
            <div id="dm-delete-pane" class="sn-dm-detail-delete-pane sn-hidden">
                <span class="sn-text-sm">
                    You have marked <strong id="dm-selected-count">0</strong> messages for deletion
                </span>
                <button id="dm-delete-selected-btn" class="sn-btn sn-btn-error sn-btn-xs">Delete</button>
            </div>

            <!-- Compose area — reuses widget styles -->
            <div class="sn-dm-win-compose sn-dm-detail-compose">
                <textarea id="dm-compose-textarea"
                          class="sn-dm-win-textarea sn-dm-detail-textarea"
                          placeholder="Write a message…"
                          maxlength="2000"
                          rows="1"></textarea>
                <button id="dm-send-btn" class="sn-dm-win-send" disabled aria-label="Send">↑</button>
            </div>

            <!-- Delete confirmation modal -->
            <dialog id="dm-delete-modal" class="sn-modal">
                <div class="sn-modal-box">
                    <h3 id="dm-delete-modal-title" class="sn-modal-title">Delete messages</h3>
                    <p id="dm-delete-modal-desc" class="sn-modal-description--detail">Choose how to delete.</p>
                    <div class="sn-modal-action-list">
                        <button id="dm-delete-for-me-btn" class="sn-btn sn-btn-sm sn-btn-outline sn-w-full">Delete for me</button>
                        <button id="dm-delete-for-all-btn" class="sn-btn sn-btn-sm sn-btn-error sn-w-full">Delete for everyone</button>
                    </div>
                    <div class="sn-modal-action sn-mt-4">
                        <form method="dialog">
                            <button class="sn-btn sn-btn-ghost sn-btn-sm">Cancel</button>
                        </form>
                    </div>
                </div>
                <form method="dialog" class="sn-modal-backdrop-overlay"><button>close</button></form>
            </dialog>
        }
    </div>
</div>

<script src="@SnakkUrlHelper.Js("pages/dm-detail")" asp-append-version="true" defer></script>
