@page
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.TopModel
@{
    ViewData["Title"] = $"{T.Pages.TopHeading} — {Model.PeriodLabel}";
    ViewData["Description"] = "The most popular discussions on Snakk, ranked by reactions and replies.";
}

@section Styles {
    <link rel="stylesheet" href="@SnakkUrlHelper.Css("discussion-list")" asp-append-version="true" />
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div class="sn-center-inner">
        <h2 class="sn-section-title">
            <span class="icon icon-star" aria-hidden="true"></span>
            @T.Pages.TopHeading
        </h2>

        <!-- Period tabs -->
        <div class="flex gap-1 mb-4 border-b border-subtle">
            @{
                var tabs = new[]
                {
                    ("day",      T.Pages.TopTabToday),
                    ("week",     T.Pages.TopTabWeek),
                    ("month",    T.Pages.TopTabMonth),
                    ("year",     T.Pages.TopTabYear),
                    ("all_time", T.Pages.TopTabAllTime),
                };
            }
            @foreach (var (period, label) in tabs)
            {
                var isActive = Model.Period == period;
                <a href="/top?period=@period"
                   class="px-3 py-2 text-sm font-medium whitespace-nowrap transition-colors @(isActive ? "border-b-2 border-primary text-primary -mb-px" : "text-base-content/60 hover:text-base-content/80")">
                    @label
                </a>
            }
        </div>

        @if (Model.TopDiscussions?.Items == null || !Model.TopDiscussions.Items.Any())
        {
            <div class="py-12 text-center text-sm" style="color: var(--text-tertiary)">
                <p>@T.Pages.TopEmpty</p>
            </div>
        }
        else
        {
            <div id="discussions-container" class="h-feed">
                @foreach (var discussion in Model.TopDiscussions.Items)
                {
                    @await Html.PartialAsync("Shared/_DiscussionCard",
                        new DiscussionListItemVM(discussion, Model.ShowCommunityInDiscussionList, Model.Community))
                }

                @if (Model.TopDiscussions.HasMoreItems)
                {
                    var nextOffset = Model.TopDiscussions.Items.Count;
                    <div class="flex justify-center mt-6">
                        <a href="/top?period=@Model.Period&offset=@nextOffset" class="btn btn-ghost btn-sm">@T.Pages.TopLoadMore</a>
                    </div>
                }
            </div>
        }
    </div>
</div>

<!-- Right Column -->
@{
    ViewData["RightPane.AboutTitle"] = T.Pages.TopAboutTitle;
    ViewData["RightPane.AboutDescription"] = T.Pages.TopAboutDesc;
}
<aside class="sn-right">
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="sn-right-body">
    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-chart-bar" aria-hidden="true"></span>
            @T.Sections.SiteStats
        </div>
        @if (Model.InlinePlatformStats != null)
        {
            <div class="sn-sidebar-stats">
                <div class="stats shadow">
                    <div class="stat">
                        <div class="stat-title">@T.Sidebar.StatsDiscussions</div>
                        <div class="stat-value">@FormatCount(Model.InlinePlatformStats.DiscussionCount)</div>
                    </div>
                </div>
                <div class="stats shadow">
                    <div class="stat">
                        <div class="stat-title">@T.Sidebar.StatsReplies</div>
                        <div class="stat-value">@FormatCount(Model.InlinePlatformStats.ReplyCount)</div>
                    </div>
                </div>
                <div class="stats shadow">
                    <div class="stat">
                        <div class="stat-title">@T.Sidebar.StatsActivity</div>
                        <div class="sn-sparkline-container sn-right-sparkline"
                             data-sparkline-type="platform"
                             data-sparkline-days="7"></div>
                    </div>
                </div>
            </div>
        }
    </div>

    <partial name="Shared/_RightAboutSection" />

    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-archive-layers" aria-hidden="true"></span>
            @T.Sections.TopSpaces
        </div>
        @if (Model.InlineTrendingSpaces?.Spaces?.Items?.Count > 0)
        {
            <div class="sn-spaces-inline">
                @foreach (var space in Model.InlineTrendingSpaces.Spaces.Items)
                {
                    <a href="@SnakkUrlHelper.Space(space.CommunitySlug, Model.Community, space.Hub.Slug, space.Slug)"
                       class="sn-card-tag sn-card-tag--space"
                       style="--space-grad: @SpaceGradient(space.PublicId)">@space.Name</a>
                }
            </div>
        }
        else
        {
            <p class="sn-right-empty">@T.Sections.EmptyTopSpaces</p>
        }
    </div>

    <div class="sn-right-section">
        <div class="sn-right-title">
            <span class="icon icon-users-group" aria-hidden="true"></span>
            @T.Sections.TopContributors
        </div>
        @if (Model.InlineTrendingContributors?.Contributors?.Items?.Count > 0)
        {
            <div class="sn-trending-list">
                @foreach (var c in Model.InlineTrendingContributors.Contributors.Items)
                {
                    <a href="@SnakkUrlHelper.UserProfile(c.PublicId)" class="sn-trending-contributor">
                        <img src="@c.AvatarMicroUrl" alt="" class="sn-avatar-square" width="28" height="28" />
                        <span class="sn-trending-contributor-name">@c.DisplayName</span>
                        <span class="sn-card-tag sn-card-tag-light sn-tag-sm">@c.PostCountToday</span>
                    </a>
                }
            </div>
        }
        else
        {
            <p class="sn-right-empty">@T.Sections.EmptyTopContributors</p>
        }
    </div>
    </div>
</div>
</aside>
