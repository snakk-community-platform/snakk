@page "/c/{slug}"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.Communities.DetailModel
@{
    ViewData["Title"] = Model.CommunityDetail?.Name ?? "Community";
    ViewData["Description"] = Model.CommunityDetail is { IsRestricted: false }
        ? $"{Model.CommunityDetail.Name} — {(Model.CommunityDetail.Description ?? "a community on Snakk")}"
        : null;
}

@section Meta {
    @if (Model.CommunityDetail is { IsRestricted: false })
    {
        var scheme = ViewContext.HttpContext.Request.Scheme;
        var host = ViewContext.HttpContext.Request.Host.ToString();
        var path = ViewContext.HttpContext.Request.Path.ToString();
        var url = $"{scheme}://{host}{path}";

        <link rel="alternate" type="application/json+oembed"
              href="/oembed?url=@Uri.EscapeDataString(url)"
              title="@Html.Encode(Model.CommunityDetail.Name)" />
    }
}

<div class="breadcrumb-bar">
    <nav class="breadcrumb">
        <a href="/">Home</a>
        <span class="breadcrumb-separator">/</span>
        <a href="/communities">Communities</a>
    </nav>
</div>
<div class="max-w-[90rem] mx-auto px-4 py-8">
    <!-- Two Column Layout -->
    <div class="flex flex-col lg:flex-row gap-3">
        <!-- Left Column: Hub Cards + Discussion List -->
        <div class="flex-1 min-w-0">
            <!-- Community Header -->
            <div class="page-header">
                <div class="flex items-start gap-4">
                    @if (Model.CommunityDetail != null)
                    {
                        <img src="@SnakkUrlHelper.CommunityAvatar(Model.CommunityDetail.PublicId)" alt="" width="64" height="64" class="w-16 h-16 rounded-full shrink-0" />
                    }
                    <div class="flex-1 min-w-0">
                        <div class="flex items-center gap-2">
                            <h1>@Model.CommunityDetail?.Name</h1>
                            @if (Model.CommunityDetail != null)
                            {
                                <a href="/c/@(Model.Community.CommunitySlug)/feed.xml"
                                   class="btn btn-ghost btn-sm btn-square" title="RSS Feed" target="_blank" rel="noopener">
                                    <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4 text-orange-500" viewBox="0 0 24 24" fill="currentColor">
                                        <path d="M6.18 15.64a2.18 2.18 0 0 1 2.18 2.18C8.36 19 7.38 20 6.18 20C5 20 4 19 4 17.82a2.18 2.18 0 0 1 2.18-2.18M4 4.44A15.56 15.56 0 0 1 19.56 20h-2.83A12.73 12.73 0 0 0 4 7.27V4.44m0 5.66a9.9 9.9 0 0 1 9.9 9.9h-2.83A7.07 7.07 0 0 0 4 12.93V10.1z"/>
                                    </svg>
                                </a>
                            }
                        </div>
                        @if (!string.IsNullOrEmpty(Model.CommunityDetail?.Description))
                        {
                            <p>@Model.CommunityDetail.Description</p>
                        }
                    </div>
                    @if (User.Identity?.IsAuthenticated == true && Model.CommunityDetail != null)
                    {
                        <a href="@SnakkUrlHelper.ManageCommunity(Model.Community)"
                           class="btn btn-primary btn-sm shrink-0" hx-boost="false">
                            <svg xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                <path d="M12.22 2h-.44a2 2 0 0 0-2 2v.18a2 2 0 0 1-1 1.73l-.43.25a2 2 0 0 1-2 0l-.15-.08a2 2 0 0 0-2.73.73l-.22.38a2 2 0 0 0 .73 2.73l.15.1a2 2 0 0 1 1 1.72v.51a2 2 0 0 1-1 1.74l-.15.09a2 2 0 0 0-.73 2.73l.22.38a2 2 0 0 0 2.73.73l.15-.08a2 2 0 0 1 2 0l.43.25a2 2 0 0 1 1 1.73V20a2 2 0 0 0 2 2h.44a2 2 0 0 0 2-2v-.18a2 2 0 0 1 1-1.73l.43-.25a2 2 0 0 1 2 0l.15.08a2 2 0 0 0 2.73-.73l.22-.39a2 2 0 0 0-.73-2.73l-.15-.08a2 2 0 0 1-1-1.74v-.5a2 2 0 0 1 1-1.74l.15-.09a2 2 0 0 0 .73-2.73l-.22-.38a2 2 0 0 0-2.73-.73l-.15.08a2 2 0 0 1-2 0l-.43-.25a2 2 0 0 1-1-1.73V4a2 2 0 0 0-2-2z"></path>
                                <circle cx="12" cy="12" r="3"></circle>
                            </svg>
                            Manage
                        </a>
                    }
                </div>
            </div>

            <partial name="_Banners" model="Model.Banners?.Banners" />

            <!-- Hubs in this Community -->
            @if (Model.Hubs?.Items != null && Model.Hubs.Items.Any())
            {
                <div class="section-header">
                    <span class="section-title">Hubs</span>
                </div>
                <div class="grid gap-4 md:grid-cols-2 mb-6">
                    @foreach (var hub in Model.Hubs.Items)
                    {
                        <a href="@SnakkUrlHelper.Hub(Model.Community, hub.Slug)" class="category-card">
                            <div class="flex items-start gap-3">
                                <img src="@SnakkUrlHelper.HubAvatar(hub.PublicId)" alt="" width="40" height="40" class="w-10 h-10 rounded-full flex-shrink-0" />
                                <div class="flex-1 min-w-0">
                                    <h2 class="category-title"
                                        data-popup-type="hub"
                                        data-popup-id="@hub.PublicId"
                                        data-popup-name="@hub.Name">@hub.Name</h2>
                                    @if (!string.IsNullOrEmpty(hub.Description))
                                    {
                                        <p class="category-description line-clamp-2">@hub.Description</p>
                                    }
                                    <div class="mt-2 flex items-center gap-3 text-xs text-base-content/50">
                                        <span>@FormatCount(hub.DiscussionCount) discussions</span>
                                        <span>@FormatCount(hub.ReplyCount) replies</span>
                                    </div>
                                </div>
                            </div>
                        </a>
                    }
                </div>
            }

            <!-- Recent Discussions -->
            <div class="section-header">
                <span class="section-title">Recent Discussions</span>
            </div>

            @if (Model.RecentDiscussions?.Items == null || !Model.RecentDiscussions.Items.Any())
            {
                <div class="clean-card">
                    <div class="empty-state-simple py-12">
                        <h3>No discussions yet</h3>
                        <p>This community doesn't have any discussions yet.</p>
                    </div>
                </div>
            }
            else
            {
                <div class="topic-list h-feed" id="discussions-container">
                    @foreach (var discussion in Model.RecentDiscussions.Items)
                    {
                        <partial name="Shared/_DiscussionListItem"
                                 model="new DiscussionListItemVM(discussion, false, Model.Community)" />
                    }

                    @if (Model.RecentDiscussions.HasMoreItems)
                    {
                        var nextOffset = Model.RecentDiscussions.Offset + Model.RecentDiscussions.PageSize;

                        <div hx-get="/partials/discussions?offset=@nextOffset&pageSize=20&communityId=@Model.CommunityDetail!.PublicId&hideCommunity=true"
                             hx-trigger="revealed"
                             hx-swap="outerHTML"
                             hx-target="this"
                             hx-push-url="false"
                             class="py-1">
                            <div class="topic-item-wrapper">
                                <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                <div class="topic-item flex-1">
                                    <div class="skeleton h-4 w-3/4 mb-2"></div>
                                    <div class="skeleton h-3 w-1/2"></div>
                                </div>
                            </div>
                            <div class="topic-item-wrapper">
                                <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                <div class="topic-item flex-1">
                                    <div class="skeleton h-4 w-2/3 mb-2"></div>
                                    <div class="skeleton h-3 w-2/5"></div>
                                </div>
                            </div>
                            <div class="topic-item-wrapper">
                                <div class="skeleton w-10 h-10 rounded-full flex-shrink-0 mr-2 hidden sm:block"></div>
                                <div class="topic-item flex-1">
                                    <div class="skeleton h-4 w-4/5 mb-2"></div>
                                    <div class="skeleton h-3 w-1/3"></div>
                                </div>
                            </div>
                        </div>
                    }
                    else
                    {
                        <partial name="Shared/_EndOfScroll" />
                    }
                </div>

            }
        </div>

        <!-- Right Column: Sidebar -->
        <aside id="sticky-sidebar" class="w-full lg:w-80 xl:w-96 flex-shrink-0" hx-boost="false">
        <div id="sidebar-inner">
            <div class="sidebar-section">
                <h3 class="sidebar-title">About this Community</h3>
                @if (!string.IsNullOrEmpty(Model.CommunityDetail?.Description))
                {
                    <p class="text-sm text-base-content/70 mb-3">@Model.CommunityDetail.Description</p>
                }
                <div class="grid grid-cols-2 gap-3">
                    <div>
                        <div class="text-lg font-semibold">@FormatCount(Model.InlineCommunityStats?.DiscussionCount ?? 0)</div>
                        <div class="text-xs text-base-content/50">Discussions</div>
                    </div>
                    <div>
                        <div class="text-lg font-semibold">@FormatCount(Model.InlineCommunityStats?.ReplyCount ?? 0)</div>
                        <div class="text-xs text-base-content/50">Replies</div>
                    </div>
                </div>
            </div>

            @if (Model.CommunityDetail?.HasRules == true)
            {
                <div class="sidebar-section">
                    <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)/rules"
                       class="sidebar-title flex items-center justify-between hover:text-primary transition-colors">
                        <span>Community Rules</span>
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </a>
                    <inline-or-htmx partial="Shared/Sidebar/_CommunityRules"
                                     model="Model.InlineCommunityRules"
                                     htmx-url="/partials/community-rules?communityId=@Model.CommunityDetail.PublicId&rev=@Model.CommunityDetail.RulesRevision">
                        <div class="flex flex-col gap-2">
                            <div class="skeleton h-4 w-full"></div>
                            <div class="skeleton h-4 w-5/6"></div>
                            <div class="skeleton h-4 w-4/6"></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }

            <!-- Moderators -->
            <div class="sidebar-section">
                <a href="@(SnakkUrlHelper.Community(Model.CommunityDetail!.Slug, Model.Community))/moderators"
                   class="sidebar-title flex items-center justify-between hover:text-primary transition-colors">
                    <span>Moderators</span>
                    <span class="flex items-center gap-1">
                        @if (Model.InlineModerators?.Moderators?.TotalCount is int modCount && modCount > 0)
                        {
                            <span class="text-xs text-base-content/50 font-normal">(@modCount)</span>
                        }
                        <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                             fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" class="shrink-0">
                            <polyline points="9 18 15 12 9 6"></polyline>
                        </svg>
                    </span>
                </a>
                <inline-or-htmx partial="Shared/Sidebar/_Moderators"
                                 model="Model.InlineModerators"
                                 htmx-url="/partials/moderators?scopeType=Community&scopeId=@Model.CommunityDetail?.PublicId&moderatorsUrl=@(SnakkUrlHelper.Community(Model.CommunityDetail!.Slug, Model.Community))/moderators&rev=@Model.CommunityDetail?.TeamRevision">
                    <div class="flex flex-col gap-2">
                        <div class="flex items-center gap-2"><div class="skeleton h-6 w-6 rounded-full shrink-0"></div><div class="skeleton h-3 w-24"></div></div>
                        <div class="flex items-center gap-2"><div class="skeleton h-6 w-6 rounded-full shrink-0"></div><div class="skeleton h-3 w-20"></div></div>
                        <div class="flex items-center gap-2"><div class="skeleton h-6 w-6 rounded-full shrink-0"></div><div class="skeleton h-3 w-28"></div></div>
                    </div>
                </inline-or-htmx>
            </div>

            @if (Model.ShowTrendingDiscussions)
            {
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Trending Discussions</h3>
                    <inline-or-htmx partial="Shared/Sidebar/_TrendingDiscussions"
                                     model="Model.InlineTrendingDiscussions"
                                     htmx-url="/partials/trending-discussions?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                        <div class="flex flex-col gap-3">
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }

            @if (Model.ShowTrendingSpaces)
            {
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Trending Spaces</h3>
                    <inline-or-htmx partial="Shared/Sidebar/_TrendingSpaces"
                                     model="Model.InlineTrendingSpaces"
                                     htmx-url="/partials/trending-spaces?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                        <div class="flex flex-col gap-3">
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }

            @if (Model.ShowTrendingContributors)
            {
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Trending Contributors</h3>
                    <inline-or-htmx partial="Shared/Sidebar/_TrendingContributors"
                                     model="Model.InlineTrendingContributors"
                                     htmx-url="/partials/trending-contributors?scopeType=@Model.SidebarScopeType&scopeId=@Model.SidebarScopeId">
                        <div class="flex flex-col gap-3">
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
                            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-1/2 mt-1"></div></div></div>
                        </div>
                    </inline-or-htmx>
                </div>
            }
        </div>
        </aside>
    </div>
</div>

@section Scripts {
    <script src="@SnakkUrlHelper.Js("pages/frontpage")" asp-append-version="true" defer></script>
}
