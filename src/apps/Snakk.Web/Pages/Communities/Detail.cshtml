@page "/c/{slug}"
@using Snakk.Web.Helpers
@using Snakk.Web.Pages.ViewModels
@using Snakk.Web.Services
@using Snakk.Shared.Avatars
@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.Communities.DetailModel
@{
    Layout = "_Layout";
    ViewData["Title"] = Model.CommunityDetail?.Name ?? "Community";
    ViewData["Description"] = Model.CommunityDetail is { IsRestricted: false }
        ? $"{Model.CommunityDetail.Name} — {(Model.CommunityDetail.Description ?? "a community on Snakk")}"
        : null;
}

@section Meta {
    @if (Model.CommunityDetail is { IsRestricted: false })
    {
        var scheme = ViewContext.HttpContext.Request.Scheme;
        var host = ViewContext.HttpContext.Request.Host.ToString();
        var path = ViewContext.HttpContext.Request.Path.ToString();
        var url = $"{scheme}://{host}{path}";

        <link rel="alternate" type="application/json+oembed"
              href="/oembed?url=@Uri.EscapeDataString(url)"
              title="@Html.Encode(Model.CommunityDetail.Name)" />
    }
}

@section LeftColumn {
@{
    ViewData["LeftNav.NewDiscussionUrl"] = "/new?communityId=" + Model.CommunityDetail?.PublicId;
}
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="fp-center">
    @* Hero card lives outside .fp-center-inner so it sits flush against the
       sides of the center column (no padding around it). *@
    @if (Model.CommunityDetail != null)
    {
        <div class="fp-community-card">
            <div class="fp-community-card-banner" style="background-image: @AvatarGenerator.GenerateGradientCss($"community:{Model.CommunityDetail.PublicId}")">
                <img src="@SnakkUrlHelper.CommunityAvatar(Model.CommunityDetail.PublicId, avatarFileName: Model.CommunityDetail.HasAvatarFileName ? Model.CommunityDetail.AvatarFileName : null)"
                     alt="" width="56" height="56"
                     class="fp-community-avatar" decoding="async" />
                <h1 class="fp-community-name">@Model.CommunityDetail.Name</h1>
            </div>
        </div>
    }
    <div class="fp-center-inner">
        <partial name="_Banners" model="Model.Banners?.Banners" />

        <!-- Hub/Space Listing -->
        @if (Model.Hubs?.Items != null && Model.Hubs.Items.Any())
        {
            <div class="space-y-4">
                @foreach (var hub in Model.Hubs.Items)
                {
                    <div class="clean-card overflow-hidden">
                        <!-- Hub header -->
                        <a href="@SnakkUrlHelper.Hub(Model.Community, hub.Slug)"
                           class="flex items-center gap-3 px-4 py-3 bg-base-200/50 border-b border-subtle hover:bg-base-200 transition-colors"
                           data-popup-type="hub" data-popup-id="@hub.PublicId" data-popup-name="@hub.Name">
                            <img src="@SnakkUrlHelper.HubAvatar(hub.PublicId)" alt="" width="28" height="28"
                                 class="w-7 h-7 rounded-full shrink-0" loading="lazy" decoding="async" />
                            <span class="font-semibold text-sm">@hub.Name</span>
                            @if (!string.IsNullOrEmpty(hub.Description))
                            {
                                <span class="text-xs text-base-content/40 hidden sm:inline truncate">— @hub.Description</span>
                            }
                        </a>

                        <!-- Spaces in this hub -->
                        @if (Model.SpacesByHub.TryGetValue(hub.PublicId, out var spaces) && spaces.Items.Any())
                        {
                            @foreach (var space in spaces.Items)
                            {
                                var spaceUrl = SnakkUrlHelper.Space(Model.Community, hub.Slug, space.Slug);
                                var ld = space.LatestDiscussion;

                                <div class="flex items-center gap-3 px-4 py-3 border-b border-subtle last:border-b-0">
                                    <!-- Space avatar -->
                                    <a href="@spaceUrl" class="shrink-0"
                                       data-popup-type="space" data-popup-id="@space.PublicId" data-popup-name="@space.Name">
                                        <img src="@SnakkUrlHelper.SpaceAvatar(space.PublicId, avatarFileName: space.HasAvatarFileName ? space.AvatarFileName : null)" alt="" width="36" height="36"
                                             class="w-9 h-9 rounded-full" loading="lazy" decoding="async" />
                                    </a>

                                    <!-- Space info -->
                                    <div class="flex-1 min-w-0">
                                        <a href="@spaceUrl" class="font-medium text-sm hover:text-primary transition-colors"
                                           data-popup-type="space" data-popup-id="@space.PublicId" data-popup-name="@space.Name">@space.Name</a>
                                        @if (!string.IsNullOrEmpty(space.Description))
                                        {
                                            <p class="text-xs text-base-content/50 truncate">@space.Description</p>
                                        }
                                    </div>

                                    <!-- Stats -->
                                    <div class="hidden sm:flex flex-col items-center shrink-0 w-16 text-center">
                                        <span class="text-sm font-semibold">@FormatCount(space.DiscussionCount)</span>
                                        <span class="text-[10px] text-base-content/40 uppercase">topics</span>
                                    </div>
                                    <div class="hidden sm:flex flex-col items-center shrink-0 w-16 text-center">
                                        <span class="text-sm font-semibold">@FormatCount(space.ReplyCount)</span>
                                        <span class="text-[10px] text-base-content/40 uppercase">replies</span>
                                    </div>

                                    <!-- Latest discussion -->
                                    <div class="hidden md:flex items-center gap-2 shrink-0 w-56 min-w-0">
                                        @if (ld != null)
                                        {
                                            var discussionUrl = SnakkUrlHelper.Discussion(Model.Community, hub.Slug, space.Slug,
                                                SnakkUrlHelper.DiscussionSlugId(ld.Slug, ld.PublicId));

                                            <img src="@SnakkUrlHelper.UserAvatar(ld.AuthorPublicId, avatarFileName: ld.HasAuthorAvatarFileName ? ld.AuthorAvatarFileName : null)"
                                                 alt="" width="24" height="24" class="w-6 h-6 rounded-full shrink-0" loading="lazy" decoding="async" />
                                            <div class="min-w-0">
                                                <a href="@discussionUrl" class="text-xs font-medium truncate block hover:text-primary transition-colors">@ld.Title</a>
                                                <span class="text-[10px] text-base-content/40 block">@(ld.AuthorDisplayName) · @FormatRelativeTime(ld.LastActivityAt?.ToDateTime())</span>
                                            </div>
                                        }
                                        else
                                        {
                                            <span class="text-xs text-base-content/30">No discussions yet</span>
                                        }
                                    </div>
                                </div>
                            }
                        }
                        else
                        {
                            <div class="px-4 py-6 text-center text-sm text-base-content/40">No spaces in this hub yet</div>
                        }
                    </div>
                }
            </div>
        }
        else
        {
            <div class="py-12 text-center text-sm" style="color: var(--text-tertiary)">
                <p>This community doesn't have any hubs or spaces yet.</p>
            </div>
        }
    </div>
</div>

<!-- Right Column -->
<aside class="fp-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new?communityId=" + Model.CommunityDetail?.PublicId;
    ViewData["RightPane.Actions"] = new[] { "feed", "share", "manage" };
    ViewData["RightPane.FeedUrl"] = $"/c/{Model.Community.CommunitySlug}/feed";
    ViewData["RightPane.ShareTitle"] = Model.CommunityDetail?.Name ?? "Community";
    ViewData["RightPane.ShareIsPublic"] = Model.CommunityDetail is not { IsRestricted: true };
    ViewData["RightPane.ManageUrl"] = SnakkUrlHelper.Community(Model.CommunityDetail!.Slug, Model.Community) + "/moderators";
}
<div class="fp-right-sticky">
    <partial name="Shared/_RightActionPane" />
    <div class="fp-right-body">
    <!-- Stats -->
    @if (Model.InlineCommunityStats != null)
    {
        <div class="fp-right-section">
            <div class="flex gap-2">
                <div class="stats shadow flex-1">
                    <div class="stat">
                        <div class="stat-title">Discussions</div>
                        <div class="stat-value">@FormatCount(Model.InlineCommunityStats.DiscussionCount)</div>
                    </div>
                </div>
                <div class="stats shadow flex-1">
                    <div class="stat">
                        <div class="stat-title">Replies</div>
                        <div class="stat-value">@FormatCount(Model.InlineCommunityStats.ReplyCount)</div>
                    </div>
                </div>
            </div>
        </div>
    }

    <!-- About -->
    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" />
            </svg>
            About @Model.CommunityDetail?.Name
        </div>
        @if (!string.IsNullOrEmpty(Model.CommunityDetail?.Description))
        {
            <p class="text-sm mb-3" style="color: var(--text-secondary)">@Model.CommunityDetail.Description</p>
        }
    </div>

    <!-- Community Rules -->
    @if (Model.CommunityDetail?.HasRules == true)
    {
        <div class="fp-right-section">
            <div class="fp-right-title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z" />
                </svg>
                Community Rules
            </div>
            <inline-or-htmx partial="Shared/Sidebar/_CommunityRules"
                             model="Model.InlineCommunityRules"
                             htmx-url="/partials/community-rules?communityId=@Model.CommunityDetail.PublicId&rev=@Model.CommunityDetail.RulesRevision">
                <div class="flex flex-col gap-2">
                    <div class="skeleton h-3 w-3/4"></div>
                    <div class="skeleton h-3 w-2/3"></div>
                    <div class="skeleton h-3 w-1/2"></div>
                </div>
            </inline-or-htmx>
        </div>
    }

    <!-- Moderators -->
    <div class="fp-right-section">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
            </svg>
            Community Moderators
            @if (Model.InlineModerators?.Moderators?.TotalCount is int modCount && modCount > 0)
            {
                <span class="text-xs font-normal" style="color: var(--text-tertiary)">(@modCount)</span>
            }
        </div>
        <inline-or-htmx partial="Shared/Sidebar/_Moderators"
                         model="Model.InlineModerators"
                         htmx-url="/partials/moderators?scopeType=Community&scopeId=@Model.CommunityDetail?.PublicId&moderatorsUrl=@(SnakkUrlHelper.Community(Model.CommunityDetail!.Slug, Model.Community))/moderators&rev=@Model.CommunityDetail?.TeamRevision">
            <div class="flex flex-col gap-2">
                <div class="flex items-center gap-2"><div class="skeleton h-6 w-6 rounded-full shrink-0"></div><div class="skeleton h-3 w-24"></div></div>
                <div class="flex items-center gap-2"><div class="skeleton h-6 w-6 rounded-full shrink-0"></div><div class="skeleton h-3 w-20"></div></div>
            </div>
        </inline-or-htmx>
    </div>

    <!-- Trending -->
    @{
        var hasSpaces = Model.ShowTrendingSpaces && Model.InlineTrendingSpaces?.Spaces?.Items?.Count > 0;
        var hasDiscussions = Model.ShowTrendingDiscussions && Model.InlineTrendingDiscussions?.Discussions?.Items?.Count > 0;
        var hasContributors = Model.ShowTrendingContributors && Model.InlineTrendingContributors?.Contributors?.Items?.Count > 0;
    }
    @if (hasSpaces || hasDiscussions || hasContributors)
    {
        <div class="fp-right-section">
            <div class="fp-right-title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" />
                </svg>
                Trending
            </div>

            @if (hasSpaces)
            {
                <div class="fp-right-subsection">
                    <div class="fp-right-subtitle">Spaces</div>
                    <div class="fp-spaces-inline">
                        @foreach (var space in Model.InlineTrendingSpaces!.Spaces!.Items)
                        {
                            <a href="@SnakkUrlHelper.Space(space.CommunitySlug, Model.Community, space.Hub.Slug, space.Slug)"
                               class="fp-card-tag"
                               data-popup-type="space" data-popup-id="@space.PublicId" data-popup-name="@space.Name">@space.Name</a>
                        }
                    </div>
                </div>
            }

            @if (hasDiscussions)
            {
                <div class="fp-right-subsection">
                    <div class="fp-right-subtitle">Discussions</div>
                    <div class="fp-trending-list">
                        @foreach (var d in Model.InlineTrendingDiscussions!.Discussions!.Items)
                        {
                            var trendUrl = SnakkUrlHelper.Discussion(
                                d.CommunitySlug, Model.Community,
                                d.Hub.Slug,
                                d.Space.Slug,
                                SnakkUrlHelper.DiscussionSlugId(d.Slug, d.PublicId));

                            <a href="@trendUrl" class="fp-trending-discussion">
                                <div class="fp-trending-discussion-header">
                                    <img src="@d.Author.AvatarMicroUrl" alt="" width="16" height="16" loading="lazy" decoding="async" />
                                    <span>@d.Author.DisplayName</span>
                                </div>
                                <div class="fp-trending-discussion-title-row">
                                    <span class="fp-trending-discussion-title">@d.Title</span>
                                    <span class="fp-card-tag fp-card-tag-light fp-tag-sm">
                                        <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="10" height="10">
                                            <path d="M4.913 2.658c2.075-.27 4.19-.408 6.337-.408 2.147 0 4.262.139 6.337.408 1.922.25 3.291 1.861 3.405 3.727a4.403 4.403 0 00-1.032-.211 50.89 50.89 0 00-8.42 0c-2.358.196-4.04 2.19-4.04 4.434v4.286a4.47 4.47 0 002.433 3.984L7.28 21.53A.75.75 0 016 21v-4.03a48.527 48.527 0 01-1.087-.128C2.905 16.58 1.5 14.833 1.5 12.862V6.638c0-1.97 1.405-3.718 3.413-3.979z" />
                                            <path d="M15.75 7.5c-1.376 0-2.739.057-4.086.169C10.124 7.797 9 9.103 9 10.609v4.285c0 1.507 1.128 2.814 2.67 2.94 1.243.102 2.5.157 3.768.165l2.782 2.781a.75.75 0 001.28-.53v-2.39l.33-.026c1.542-.125 2.67-1.433 2.67-2.94v-4.286c0-1.505-1.125-2.811-2.664-2.94A49.392 49.392 0 0015.75 7.5z" />
                                        </svg>
                                        @d.PostCountToday
                                    </span>
                                </div>
                            </a>
                        }
                    </div>
                </div>
            }

            @if (hasContributors)
            {
                <div class="fp-right-subsection">
                    <div class="fp-right-subtitle">Contributors</div>
                    <div class="fp-trending-list">
                        @foreach (var c in Model.InlineTrendingContributors!.Contributors!.Items)
                        {
                            <a href="@SnakkUrlHelper.UserProfile(c.PublicId)" class="fp-trending-contributor"
                               data-popup-type="user" data-popup-id="@c.PublicId" data-popup-name="@c.DisplayName">
                                <img src="@c.AvatarMicroUrl" alt="" class="fp-avatar-square" width="28" height="28" loading="lazy" decoding="async" />
                                <span class="fp-trending-contributor-name">@c.DisplayName</span>
                                <span class="fp-card-tag fp-card-tag-light fp-tag-sm">
                                    <svg xmlns="http://www.w3.org/2000/svg" viewBox="0 0 24 24" fill="currentColor" width="10" height="10">
                                        <path d="M4.913 2.658c2.075-.27 4.19-.408 6.337-.408 2.147 0 4.262.139 6.337.408 1.922.25 3.291 1.861 3.405 3.727a4.403 4.403 0 00-1.032-.211 50.89 50.89 0 00-8.42 0c-2.358.196-4.04 2.19-4.04 4.434v4.286a4.47 4.47 0 002.433 3.984L7.28 21.53A.75.75 0 016 21v-4.03a48.527 48.527 0 01-1.087-.128C2.905 16.58 1.5 14.833 1.5 12.862V6.638c0-1.97 1.405-3.718 3.413-3.979z" />
                                        <path d="M15.75 7.5c-1.376 0-2.739.057-4.086.169C10.124 7.797 9 9.103 9 10.609v4.285c0 1.507 1.128 2.814 2.67 2.94 1.243.102 2.5.157 3.768.165l2.782 2.781a.75.75 0 001.28-.53v-2.39l.33-.026c1.542-.125 2.67-1.433 2.67-2.94v-4.286c0-1.505-1.125-2.811-2.664-2.94A49.392 49.392 0 0015.75 7.5z" />
                                    </svg>
                                    @c.PostCountToday
                                </span>
                            </a>
                        }
                    </div>
                </div>
            }
        </div>
    }
    </div>
</div>
</aside>

@section Scripts {
    <script src="@SnakkUrlHelper.Js("pages/frontpage")" asp-append-version="true" defer></script>
}
