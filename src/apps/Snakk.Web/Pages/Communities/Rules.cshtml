@page "/c/{slug}/rules"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Communities.RulesModel
@{
    ViewData["Title"] = $"{Model.CommunityDetail?.Name} Community Rules";
    ViewData["Description"] = $"Rules and guidelines for {Model.CommunityDetail?.Name}.";
}

@if (Model.CommunityDetail == null)
{
    <div class="max-w-xl mx-auto px-4 py-8">
        <div class="clean-card">
            <div class="empty-state-simple">
                <h3>Community not found</h3>
                <p>This community may have been removed or the link might be incorrect.</p>
                <a href="/communities" class="btn btn-primary btn-sm mt-4">Back to Communities</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="breadcrumb-bar">
        <nav class="breadcrumb">
            <a href="/">Home</a>
            <span class="breadcrumb-separator">/</span>
            <a href="/c/@Model.CommunityDetail.Slug">@Model.CommunityDetail.Name</a>
            <span class="breadcrumb-separator">/</span>
            <span>Community Rules</span>
        </nav>
    </div>

    <div class="max-w-3xl mx-auto px-4 py-8">
        <div class="page-header">
            <h1>@Model.CommunityDetail.Name Community Rules</h1>
            @if (!string.IsNullOrEmpty(Model.CommunityDetail.Description))
            {
                <p>@Model.CommunityDetail.Description</p>
            }
        </div>

        <div class="clean-card p-6">
            @if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
            {
                <div class="empty-state-simple">
                    <p>No rules have been defined for this community yet.</p>
                </div>
            }
            else
            {
                <div class="flex flex-col divide-y divide-base-200">
                    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
                    {
                        <div class="py-3 first:pt-0 last:pb-0">
                            <p class="text-sm font-medium mb-1">@(index + 1). @rule.Title</p>
                            <p class="text-sm text-base-content/70 pl-4">@rule.Description</p>
                        </div>
                    }
                </div>
            }
        </div>

        <div class="clean-card p-4 mt-4">
            <p class="text-xs font-semibold text-base-content/50 uppercase tracking-wide mb-2">See also</p>
            <div class="flex flex-col">
                <a href="/rules" class="flex items-center justify-between py-1.5 text-sm hover:text-primary transition-colors">
                    <span>Site Rules</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24"
                         fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                        <polyline points="9 18 15 12 9 6"></polyline>
                    </svg>
                </a>
            </div>
        </div>
    </div>
}
