@page "/c/{slug}/rules"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.Communities.RulesModel
@{
    Layout = "_Layout";
    ViewData["Title"] = $"{Model.CommunityDetail?.Name} Community Rules";
    ViewData["Description"] = $"Rules and guidelines for {Model.CommunityDetail?.Name}.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

@if (Model.CommunityDetail == null)
{
    <div class="fp-center">
        <div class="fp-center-inner">
            <div class="py-12 text-center text-sm" style="color: var(--text-tertiary)">
                <p>Community not found.</p>
                <a href="/communities" class="btn btn-primary btn-sm mt-4">Back to Communities</a>
            </div>
        </div>
    </div>
}
else
{
    <div class="fp-center">
        <div class="fp-page-labels">
            <a href="@SnakkUrlHelper.Community(Model.CommunityDetail.Slug, Model.Community)" class="badge badge-ghost badge-sm">@Model.CommunityDetail.Name</a>
        </div>
        <div class="fp-center-inner">
            <h2 class="fp-section-title">
                <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                    <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z" />
                </svg>
                @Model.CommunityDetail.Name Community Rules
            </h2>
            @if (!string.IsNullOrEmpty(Model.CommunityDetail.Description))
            {
                <p class="text-sm mb-6" style="color: var(--text-secondary)">@Model.CommunityDetail.Description</p>
            }
            else
            {
                <div class="mb-6"></div>
            }

            @if (Model.Rules?.Rules == null || Model.Rules.Rules.Count == 0)
            {
                <p class="text-sm" style="color: var(--text-tertiary)">No rules have been defined for this community yet.</p>
            }
            else
            {
                <div class="flex flex-col gap-6">
                    @foreach (var (rule, index) in Model.Rules.Rules.Select((r, i) => (r, i)))
                    {
                        <div class="flex gap-4 items-start">
                            <span class="text-5xl font-black leading-none select-none shrink-0 w-14 text-right" style="color: var(--text-primary); opacity: 0.08">@(index + 1)</span>
                            <div class="pt-1 min-w-0">
                                <p class="text-sm font-semibold mb-1" style="color: var(--text-primary)">@rule.Title</p>
                                <p class="text-sm" style="color: var(--text-secondary)">@rule.Description</p>
                            </div>
                        </div>
                    }
                </div>
            }

            <div class="mt-6 pt-4" style="border-top: 1px solid var(--border-secondary)">
                <p class="text-xs font-semibold uppercase tracking-wide mb-2" style="color: var(--text-tertiary)">See also</p>
                <a href="/rules" class="flex items-center justify-between py-1.5 text-sm transition-colors" style="color: var(--text-secondary)" onmouseover="this.style.color='var(--link-primary)'" onmouseout="this.style.color='var(--text-secondary)'">
                    <span>Site Rules</span>
                    <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"></polyline></svg>
                </a>
            </div>
        </div>
    </div>

<aside class="fp-right">
<div class="fp-right-sticky">
    <div class="fp-right-section"
         hx-get="/partials/platform-stats?scopeType=platform&scopeId=global"
         hx-trigger="load"
         hx-target="this"
         hx-swap="innerHTML">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M9 19v-6a2 2 0 00-2-2H5a2 2 0 00-2 2v6a2 2 0 002 2h2a2 2 0 002-2zm0 0V9a2 2 0 012-2h2a2 2 0 012 2v10m-6 0a2 2 0 002 2h2a2 2 0 002-2m0 0V5a2 2 0 012-2h2a2 2 0 012 2v14a2 2 0 01-2 2h-2a2 2 0 01-2-2z" /></svg>
            Site Stats
        </div>
        <div class="grid grid-cols-2 gap-3">
            <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-16"></div></div>
            <div><div class="skeleton h-5 w-8 mb-1"></div><div class="skeleton h-3 w-10"></div></div>
        </div>
    </div>

    <div class="fp-right-section"
         hx-get="/partials/trending-discussions?scopeType=platform&scopeId=global"
         hx-trigger="load"
         hx-target="this"
         hx-swap="innerHTML">
        <div class="fp-right-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2"><path stroke-linecap="round" stroke-linejoin="round" d="M13 7h8m0 0v8m0-8l-8 8-4-4-6 6" /></svg>
            Trending
        </div>
        <div class="flex flex-col gap-3">
            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-full"></div><div class="skeleton h-3 w-3/4 mt-1"></div></div></div>
            <div class="flex items-center gap-3"><div class="skeleton h-8 w-8 shrink-0 rounded-full"></div><div class="flex-1"><div class="skeleton h-3 w-5/6"></div><div class="skeleton h-3 w-2/3 mt-1"></div></div></div>
        </div>
    </div>
</div>
</aside>
}
