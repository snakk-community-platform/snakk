@page "/communities"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.Communities.IndexModel
@{
    ViewData["Title"] = T.Pages.CommunitiesTitle;
    ViewData["Description"] = T.Pages.CommunitiesDesc;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div class="sn-center-inner">
        <div class="sn-section-header">
            <h2 class="sn-section-title">
                <span class="icon icon-users-group" aria-hidden="true"></span>
                @T.Pages.CommunitiesHeading
            </h2>
        </div>

        @if (Model.Communities?.Items == null || !Model.Communities.Items.Any())
        {
            <partial name="Shared/_EmptyState" model="new EmptyStateVM(T.Pages.CommunitiesEmpty)" />
        }
        else
        {
            <div class="sn-community-card-list">
                @foreach (var community in Model.Communities.Items)
                {
                    <a href="/c/@community.Slug" class="sn-community-list-card">
                        <div class="sn-community-list-banner"
                             style="background-image: @CommunityGradient(community.PublicId)">
                            <img src="@SnakkUrlHelper.CommunityAvatar(community.PublicId, avatarFileName: community.HasAvatarFileName ? community.AvatarFileName : null)"
                                 alt="" width="48" height="48"
                                 class="sn-community-list-avatar"
                                 loading="lazy" decoding="async" />
                            <span class="sn-community-list-name">@community.Name</span>
                        </div>
                        <div class="sn-community-list-body">
                            @if (!string.IsNullOrEmpty(community.Description))
                            {
                                <p class="sn-community-description">@community.Description</p>
                            }
                            <div class="sn-community-stat-row">
                                <div class="sn-community-stat-pill">
                                    <span class="sn-community-sn-stat-value">@FormatCount(community.DiscussionCount)</span>
                                    <span class="sn-community-stat-label">@T.Pages.CommunitiesLabelDiscussions</span>
                                </div>
                                <div class="sn-community-stat-pill">
                                    <span class="sn-community-sn-stat-value">@FormatCount(community.ReplyCount)</span>
                                    <span class="sn-community-stat-label">@T.Pages.CommunitiesLabelReplies</span>
                                </div>
                                @if (Model.CommunitySparklineJson.TryGetValue(community.PublicId, out var sparkJson))
                                {
                                    <div class="sn-sparkline-container sn-community-card-sparkline"
                                         data-sparkline-data="@sparkJson"
                                         data-sparkline-metric="postCount"></div>
                                }
                            </div>
                        </div>
                    </a>
                }
            </div>

            @if (Model.Communities.HasMoreItems)
            {
                <div class="sn-pagination-row">
                    <a href="/communities?offset=@(Model.Communities.Offset + Model.Communities.PageSize)"
                       class="sn-btn sn-btn-ghost sn-btn-sm">
                        @T.Pages.CommunitiesLoadMore
                    </a>
                </div>
            }
        }
    </div>
</div>

<!-- Right Column -->
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/create";
    ViewData["RightPane.AboutTitle"] = T.Pages.CommunitiesAboutTitle;
    ViewData["RightPane.AboutDescription"] = T.Pages.CommunitiesAboutDesc;
}
<vc:global-right-sidebar />
