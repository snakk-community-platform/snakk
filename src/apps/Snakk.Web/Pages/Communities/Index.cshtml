@page "/communities"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@using Snakk.Shared.Avatars
@using static Snakk.Web.Helpers.DisplayHelper
@model Snakk.Web.Pages.Communities.IndexModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "Communities";
    ViewData["Description"] = "Browse all communities on Snakk. Find and join communities that match your interests.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="fp-center">
    <div class="fp-center-inner">
        <h2 class="fp-section-title">
            <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2">
                <path stroke-linecap="round" stroke-linejoin="round" d="M17 20h5v-2a3 3 0 00-5.356-1.857M17 20H7m10 0v-2c0-.656-.126-1.283-.356-1.857M7 20H2v-2a3 3 0 015.356-1.857M7 20v-2c0-.656.126-1.283.356-1.857m0 0a5.002 5.002 0 019.288 0M15 7a3 3 0 11-6 0 3 3 0 016 0zm6 3a2 2 0 11-4 0 2 2 0 014 0zM7 10a2 2 0 11-4 0 2 2 0 014 0z" />
            </svg>
            Communities
        </h2>

        @if (Model.Communities?.Items == null || !Model.Communities.Items.Any())
        {
            <div class="py-12 text-center text-sm" style="color: var(--text-tertiary)">
                <p>No communities yet. Check back later!</p>
            </div>
        }
        else
        {
            <div class="fp-community-card-list">
                @foreach (var community in Model.Communities.Items)
                {
                    <a href="/c/@community.Slug" class="fp-community-list-card">
                        <div class="fp-community-list-banner"
                             style="background-image: @AvatarGenerator.GenerateGradientCss($"community:{community.PublicId}")">
                            <img src="@SnakkUrlHelper.CommunityAvatar(community.PublicId, avatarFileName: community.HasAvatarFileName ? community.AvatarFileName : null)"
                                 alt="" width="48" height="48"
                                 class="fp-community-list-avatar"
                                 loading="lazy" decoding="async" />
                            <span class="fp-community-list-name">@community.Name</span>
                        </div>
                        <div class="fp-community-list-body">
                            @if (!string.IsNullOrEmpty(community.Description))
                            {
                                <p class="fp-community-description">@community.Description</p>
                            }
                            <div class="fp-community-stat-row">
                                <div class="fp-community-stat-pill">
                                    <span class="fp-community-stat-value">@FormatCount(community.DiscussionCount)</span>
                                    <span class="fp-community-stat-label">discussions</span>
                                </div>
                                <div class="fp-community-stat-pill">
                                    <span class="fp-community-stat-value">@FormatCount(community.ReplyCount)</span>
                                    <span class="fp-community-stat-label">replies</span>
                                </div>
                            </div>
                        </div>
                    </a>
                }
            </div>

            @if (Model.Communities.HasMoreItems)
            {
                <div class="flex justify-center mt-6">
                    <a href="/communities?offset=@(Model.Communities.Offset + Model.Communities.PageSize)"
                       class="btn btn-ghost btn-sm">
                        Load more
                    </a>
                </div>
            }
        }
    </div>
</div>

<!-- Right Column -->
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<partial name="Shared/_GlobalRightSidebar" />
