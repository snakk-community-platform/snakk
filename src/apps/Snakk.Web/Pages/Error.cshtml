@page
@model ErrorModel
@{
    ViewData["Title"] = T.Pages.ErrorTitle;
}



<div class="sn-error-page-container">
    <div class="page-header">
        <h1>@T.Pages.ErrorHeading</h1>
        <p>@T.Pages.ErrorBody</p>
    </div>

    <div class="sn-clean-card sn-p-6">
        @if (Model.ShowRequestId)
        {
            <p class="sn-error-detail-text">
                @T.Pages.ErrorRequestIdLabel <code class="sn-error-request-id">@Model.RequestId</code>
            </p>
        }
        <p class="sn-error-logged-note">
            @T.Pages.ErrorLoggedNote
        </p>
        <a href="/" class="sn-btn sn-btn-primary sn-btn-sm">@T.Pages.ErrorHomeBtn</a>
    </div>
</div>
