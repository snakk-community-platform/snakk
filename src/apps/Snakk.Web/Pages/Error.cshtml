@page
@model ErrorModel
@{
    ViewData["Title"] = "Error";
}

<div class="breadcrumb-bar">
    <nav class="breadcrumb">
        <a href="/">Home</a>
    </nav>
</div>

<div class="max-w-3xl mx-auto px-4 py-8">
    <div class="page-header">
        <h1>Something went wrong</h1>
        <p>An unexpected error occurred while processing your request.</p>
    </div>

    <div class="clean-card p-6">
        @if (Model.ShowRequestId)
        {
            <p class="text-sm text-base-content/70 mb-4">
                Request ID: <code class="text-xs bg-base-300 px-1.5 py-0.5 rounded">@Model.RequestId</code>
            </p>
        }
        <p class="text-sm text-base-content/70 mb-6">
            This error has been logged. If the issue persists, please try again later.
        </p>
        <a href="/" class="btn btn-primary btn-sm">Go to Home</a>
    </div>
</div>
