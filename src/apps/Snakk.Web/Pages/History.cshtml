@page "/history"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.HistoryModel
@{
    Layout = "_Layout";
    ViewData["Title"] = "History";
    ViewData["Description"] = "Discussions you have recently visited.";
    ViewData["Nudge.Title"] = "Sign in to see your history";
    ViewData["Nudge.Body"] = "Discussions you visit will appear here.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="fp-center">
    <div class="fp-center-inner">
        @if (!Model.IsAuthenticated)
        {
            <partial name="Shared/_RegistrationNudge" />
        }
        else
        {
            <h2 class="fp-section-title">
                <span class="icon icon-clock" aria-hidden="true"></span>
                History
            </h2>

            <div id="history-loading">
                @for (int i = 0; i < 5; i++)
                {
                    <div class="fp-card" style="opacity: 0.5">
                        <div class="fp-card-header">
                            <div class="skeleton h-3 w-16 rounded"></div>
                            <div class="skeleton h-3 w-4 rounded"></div>
                            <div class="skeleton h-3 w-20 rounded"></div>
                        </div>
                        <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                    </div>
                }
            </div>

            <div id="history-empty" class="hidden py-12 text-center text-sm" style="color: var(--text-tertiary)">
                <span class="icon icon-clock h-10 w-10 mx-auto mb-3 opacity-30" aria-hidden="true"></span>
                <p>No history yet.</p>
                <p class="mt-1 text-xs opacity-70">Discussions you visit will appear here.</p>
            </div>

            <div id="history-container" class="hidden"></div>
            <div id="history-sentinel" class="hidden py-4">
                <div class="fp-card" style="opacity: 0.4">
                    <div class="fp-card-header">
                        <div class="skeleton h-3 w-16 rounded"></div>
                        <div class="skeleton h-3 w-20 rounded"></div>
                    </div>
                    <div class="skeleton h-4 w-3/4 rounded mt-2"></div>
                </div>
            </div>
        }
    </div>
</div>

@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
    if (Model.IsAuthenticated)
        ViewData["RightPane.Actions"] = new[] { "clear-history" };
}
<partial name="Shared/_GlobalRightSidebar" />

<script src="@SnakkUrlHelper.Js("components/card-animations")" asp-append-version="true"></script>
<script src="@SnakkUrlHelper.Js("services/read-history")" asp-append-version="true"></script>
<script src="@SnakkUrlHelper.Js("pages/history")" asp-append-version="true"></script>
