@page
@model NotFoundModel
@{
    ViewData["Title"] = "Page Not Found";
}

<style>
    .ghosted-container {
        display: flex;
        flex-direction: column;
        align-items: center;
        justify-content: center;
        min-height: 60vh;
        text-align: center;
        padding: 2rem 1rem;
    }

    /* ── SVG scene ── */
    .ghosted-scene {
        position: relative;
        width: 220px;
        height: 180px;
        margin-bottom: 2rem;
    }

    /* ── Speech bubble ── */
    .bubble-body {
        fill: var(--bg-secondary, #e5e5e5);
        stroke: var(--border-primary, #e0e0e0);
        stroke-width: 2;
    }

    .bubble-tail {
        fill: var(--bg-secondary, #e5e5e5);
        stroke: var(--border-primary, #e0e0e0);
        stroke-width: 2;
    }

    /* Typing dots inside the bubble */
    .typing-dot {
        fill: var(--text-tertiary, #888);
    }

    .typing-dot:nth-child(1) { animation: typingPulse 1.4s 0s infinite ease-in-out; }
    .typing-dot:nth-child(2) { animation: typingPulse 1.4s 0.2s infinite ease-in-out; }
    .typing-dot:nth-child(3) { animation: typingPulse 1.4s 0.4s infinite ease-in-out; }

    @@keyframes typingPulse {
        0%, 60%, 100% { opacity: 0.3; transform: translateY(0); }
        30% { opacity: 1; transform: translateY(-3px); }
    }

    /* Bubble dissolve — fades and drifts upward */
    .bubble-group {
        animation: bubbleDissolve 4s ease-in-out infinite;
        transform-origin: center center;
    }

    @@keyframes bubbleDissolve {
        0%   { opacity: 1; transform: translateY(0) scale(1); }
        60%  { opacity: 1; transform: translateY(0) scale(1); }
        85%  { opacity: 0; transform: translateY(-12px) scale(0.95); }
        95%  { opacity: 0; transform: translateY(-12px) scale(0.95); }
        100% { opacity: 1; transform: translateY(0) scale(1); }
    }

    /* ── Ghost particles — small circles that drift away ── */
    .ghost-particle {
        fill: var(--text-tertiary, #888);
        opacity: 0;
    }

    .ghost-particle:nth-child(1) { animation: particleDrift 4s 2.2s infinite ease-out; }
    .ghost-particle:nth-child(2) { animation: particleDrift 4s 2.4s infinite ease-out; }
    .ghost-particle:nth-child(3) { animation: particleDrift 4s 2.6s infinite ease-out; }
    .ghost-particle:nth-child(4) { animation: particleDrift 4s 2.3s infinite ease-out; }
    .ghost-particle:nth-child(5) { animation: particleDrift 4s 2.5s infinite ease-out; }

    @@keyframes particleDrift {
        0%   { opacity: 0; transform: translate(0, 0) scale(1); }
        10%  { opacity: 0.6; }
        100% { opacity: 0; transform: translate(var(--dx, 20px), var(--dy, -30px)) scale(0); }
    }

    /* ── Read receipt check marks ── */
    .read-receipt {
        margin-top: 0rem;
        animation: receiptAppear 4s infinite ease-in-out;
    }

    .check-mark {
        fill: none;
        stroke: #3b82f6;
        stroke-width: 2.5;
        stroke-linecap: round;
        stroke-linejoin: round;
        stroke-dasharray: 20;
        stroke-dashoffset: 20;
    }

    .check-mark.first  { animation: drawCheck 4s 0.5s infinite ease-in-out; }
    .check-mark.second { animation: drawCheck 4s 0.8s infinite ease-in-out; }

    @@keyframes drawCheck {
        0%, 10%  { stroke-dashoffset: 20; opacity: 0; }
        15%      { opacity: 1; }
        30%, 60% { stroke-dashoffset: 0; opacity: 1; }
        75%      { stroke-dashoffset: 0; opacity: 0.3; }
        85%, 100% { stroke-dashoffset: 20; opacity: 0; }
    }

    @@keyframes receiptAppear {
        0%, 10%  { opacity: 0; }
        20%, 65% { opacity: 1; }
        80%, 100% { opacity: 0; }
    }

    /* ── Typography ── */
    .ghosted-code {
        font-size: 5rem;
        font-weight: 800;
        color: var(--text-tertiary, #888);
        opacity: 0.15;
        line-height: 1;
        margin-bottom: 0.25rem;
        letter-spacing: -0.04em;
    }

    .ghosted-title {
        font-size: 1.75rem;
        font-weight: 700;
        color: var(--text-primary, #1a1a1a);
        margin: 0 0 0.5rem 0;
    }

    .ghosted-subtitle {
        font-size: 1rem;
        color: var(--text-secondary, #666);
        margin: 0 0 2rem 0;
        max-width: 360px;
    }

    .ghosted-home {
        margin-top: 0.5rem;
    }

    /* Reduce motion for accessibility */
    @@media (prefers-reduced-motion: reduce) {
        .bubble-group,
        .ghost-particle,
        .typing-dot,
        .check-mark,
        .read-receipt {
            animation: none !important;
            opacity: 1 !important;
            stroke-dashoffset: 0 !important;
        }
    }
</style>

<div class="breadcrumb-bar">
    <nav class="breadcrumb">
        <a href="/">Home</a>
        <span>404</span>
    </nav>
</div>

<div class="ghosted-container">

    <!-- SVG Scene -->
    <div class="ghosted-scene">
        <svg viewBox="0 0 220 180" xmlns="http://www.w3.org/2000/svg" aria-hidden="true">

            <!-- Ghost particles (fly out when bubble dissolves) -->
            <g class="ghost-particles">
                <circle class="ghost-particle" cx="110" cy="65" r="3" style="--dx: -40px; --dy: -35px;" />
                <circle class="ghost-particle" cx="110" cy="65" r="2" style="--dx: 35px; --dy: -40px;" />
                <circle class="ghost-particle" cx="110" cy="65" r="2.5" style="--dx: -25px; --dy: -50px;" />
                <circle class="ghost-particle" cx="110" cy="65" r="2" style="--dx: 45px; --dy: -25px;" />
                <circle class="ghost-particle" cx="110" cy="65" r="3" style="--dx: -50px; --dy: -20px;" />
            </g>

            <!-- Speech bubble group (dissolves) -->
            <g class="bubble-group">
                <!-- Bubble body -->
                <rect class="bubble-body" x="35" y="20" width="150" height="90" rx="20" ry="20" />

                <!-- Bubble tail -->
                <polygon class="bubble-tail" points="65,108 85,108 60,135"
                         stroke-linejoin="round" />
                <!-- Overlap cover to hide the internal stroke between body and tail -->
                <rect fill="var(--bg-secondary, #e5e5e5)" x="64" y="100" width="23" height="12" />

                <!-- Typing indicator dots -->
                <g>
                    <circle class="typing-dot" cx="90"  cy="65" r="5" />
                    <circle class="typing-dot" cx="110" cy="65" r="5" />
                    <circle class="typing-dot" cx="130" cy="65" r="5" />
                </g>
            </g>

            <!-- Read receipt (double check marks) -->
            <g class="read-receipt" transform="translate(130, 145)">
                <polyline class="check-mark first"  points="0,6 4,10 12,2" />
                <polyline class="check-mark second" points="6,6 10,10 18,2" />
            </g>
        </svg>
    </div>

    <!-- Text content -->
    <div class="ghosted-code">404</div>
    <h1 class="ghosted-title">You've been ghosted.</h1>
    <p class="ghosted-subtitle">This page saw your request and left you on read.</p>

    <a href="/" class="btn btn-primary ghosted-home">Back to safety</a>
</div>
