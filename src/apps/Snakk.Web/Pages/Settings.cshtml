@page "/settings"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.SettingsModel
@{
    ViewData["Title"] = "Profile Settings";
}

<div class="breadcrumb-bar">
    <nav class="breadcrumb">
        <a href="/">Home</a>
    </nav>
</div>

<div class="max-w-[90rem] mx-auto px-4 py-8">
    <!-- Page Header -->
    <div class="page-header">
        <h1>Profile Settings</h1>
        <p>Manage your account and preferences</p>
    </div>

    @if (Model.ErrorMessage != null)
    {
        <div class="alert alert-error mb-6">
            <span>@Model.ErrorMessage</span>
        </div>
    }

    @if (Model.SuccessMessage != null)
    {
        <div class="alert alert-success mb-6">
            <span>@Model.SuccessMessage</span>
        </div>
    }

    <div class="flex gap-6">
        <!-- Left: Scrollspy Nav (hidden on screens below xl) -->
        <nav id="settings-scrollspy" class="hidden xl:block w-48 shrink-0">
            <div class="sticky top-32">
                <ul class="space-y-1 text-sm">
                    <li><a href="#section-avatar" class="settings-nav-item active" data-scrollspy-link>Avatar</a></li>
                    <li><a href="#section-bio" class="settings-nav-item" data-scrollspy-link>Bio</a></li>
                    <li><a href="#section-display-name" class="settings-nav-item" data-scrollspy-link>Display Name</a></li>
                    <li><a href="#section-behavior" class="settings-nav-item" data-scrollspy-link>Behavior</a></li>
                    <li><a href="#section-display" class="settings-nav-item" data-scrollspy-link>Display</a></li>
                    <li><a href="#section-rss" class="settings-nav-item" data-scrollspy-link>RSS Feeds</a></li>
                    <li><a href="#section-devices" class="settings-nav-item" data-scrollspy-link>Devices</a></li>
                </ul>
            </div>
        </nav>

        <!-- Middle: Settings Content -->
        <div class="flex-1 min-w-0">

            <!-- Account info — visible only on small screens (below lg), inline before settings -->
            <div class="lg:hidden mb-6">
                <div class="section-header">
                    <span class="section-title">Account Information</span>
                </div>
                <div class="clean-card">
                    <div class="p-4">
                        <dl class="space-y-3 text-sm">
                            <div class="flex items-center gap-2" id="email-row-mobile">
                                <dt class="text-base-content/60 w-20 shrink-0">Email</dt>
                                <dd class="flex items-center gap-2">
                                    <span class="profile-email truncate"></span>
                                    <span class="profile-email-badge badge badge-sm shrink-0"></span>
                                </dd>
                            </div>
                            <div class="flex items-center gap-2 profile-oauth-row" style="display: none;">
                                <dt class="text-base-content/60 w-20 shrink-0">Sign in</dt>
                                <dd class="capitalize profile-oauth"></dd>
                            </div>
                            <div class="flex items-center gap-2">
                                <dt class="text-base-content/60 w-20 shrink-0">User ID</dt>
                                <dd class="font-mono text-xs truncate profile-userid"></dd>
                            </div>
                        </dl>
                    </div>
                </div>
            </div>
                <!-- Avatar Section -->
                <div id="section-avatar">
                    <div class="section-header">
                        <span class="section-title">Avatar</span>
                    </div>
                    @{
                        var settingsAvatarFileName = User.FindFirst("AvatarFileName")?.Value;
                        var hasUploadedAvatar = !string.IsNullOrEmpty(settingsAvatarFileName);
                        var settingsAvatarUrl = SnakkUrlHelper.UserAvatar(Model.UserId ?? "", avatarFileName: settingsAvatarFileName);
                        var settingsGeneratedUrl = SnakkUrlHelper.UserAvatar(Model.UserId ?? "");
                    }
                    <div class="clean-card mb-6">
                        <div class="p-4">
                            <form id="avatar-upload-form" class="space-y-4">
                                <div class="flex items-center gap-4">
                                    <div class="avatar avatar-xl shrink-0">
                                        <img src="@settingsAvatarUrl"
                                             alt="Your avatar"
                                             width="80" height="80"
                                             id="avatar-preview"
                                             data-generated-url="@settingsGeneratedUrl" />
                                    </div>
                                    <div class="text-sm text-base-content/60">
                                        Upload a custom avatar or use the auto-generated one.
                                        <br />Supported: JPEG, PNG, WebP. Max 2MB.
                                    </div>
                                </div>

                                <input type="file" id="avatar-file" name="avatar"
                                       accept="image/jpeg,image/png,image/webp" class="hidden" />

                                <div id="avatar-drop-zone" class="gallery-drop-zone">
                                    <div class="gallery-drop-zone-content">
                                        <svg xmlns="http://www.w3.org/2000/svg" class="h-8 w-8 text-base-content/30 mb-2" fill="none" viewBox="0 0 24 24" stroke="currentColor">
                                            <path stroke-linecap="round" stroke-linejoin="round" stroke-width="1.5" d="M4 16l4.586-4.586a2 2 0 012.828 0L16 16m-2-2l1.586-1.586a2 2 0 012.828 0L20 14m-6-6h.01M6 20h12a2 2 0 002-2V6a2 2 0 00-2-2H6a2 2 0 00-2 2v12a2 2 0 002 2z" />
                                        </svg>
                                        <span class="text-sm text-base-content/50" id="avatar-drop-label">Click or drag an image here</span>
                                    </div>
                                </div>

                                <div class="flex gap-2">
                                    <button type="submit" class="btn btn-primary btn-sm" id="upload-btn" disabled>
                                        Upload Avatar
                                    </button>
                                    <button type="button"
                                            class="btn btn-ghost btn-sm"
                                            id="delete-avatar-btn"
                                            @(hasUploadedAvatar ? "" : "disabled")>
                                        Use Generated
                                    </button>
                                </div>
                            </form>

                            <div id="upload-status" class="mt-3 text-sm hidden"></div>
                        </div>
                    </div>
                </div>

                <!-- Bio Section -->
                <div id="section-bio">
                    <div class="section-header">
                        <span class="section-title">Bio</span>
                    </div>
                    <div class="clean-card mb-6">
                        <div class="p-4">
                            <p class="text-sm text-base-content/60 mb-3">
                                A short description that appears on your profile.
                            </p>
                            <textarea id="bio-input"
                                      class="textarea w-full"
                                      rows="3"
                                      maxlength="300"
                                      placeholder="Tell others a bit about yourself..."></textarea>
                            <div class="flex items-center justify-between mt-2">
                                <span class="text-xs text-base-content/50"><span id="bio-char-count">0</span>/300</span>
                                <button type="button" class="btn btn-primary btn-sm" id="save-bio-btn">Save Bio</button>
                            </div>
                        </div>
                    </div>
                </div>

                <!-- Display Name Section -->
                <div id="section-display-name">
                    <div class="section-header">
                        <span class="section-title">Display Name</span>
                    </div>
                    <div class="clean-card mb-6">
                        <div class="p-4">
                            <div id="display-name-status" class="text-sm mb-3 hidden"></div>

                            <form id="display-name-form" asp-page-handler="UpdateDisplayName" class="space-y-3">
                                <div class="form-control">
                                    <input type="text"
                                           name="displayName"
                                           value=""
                                           class="input w-full"
                                           required
                                           minlength="3"
                                           maxlength="20"
                                           placeholder="Your display name" />
                                    <label class="label">
                                        <span class="label-text-alt text-base-content/50">3-20 characters. Letters, numbers, spaces, hyphens, underscores.</span>
                                    </label>
                                </div>

                                <div class="form-control" id="password-field">
                                    <input type="password"
                                           name="password"
                                           class="input w-full"
                                           placeholder="Current password"
                                           autocomplete="current-password" />
                                    <label class="label">
                                        <span class="label-text-alt text-base-content/50">Required to change your display name</span>
                                    </label>
                                </div>

                                @if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
                                {
                                    <div id="turnstile-widget" class="cf-turnstile"
                                         data-sitekey="@Model.TurnstileSiteKey"
                                         data-theme="auto"
                                         data-size="normal"></div>
                                }

                                <button type="submit" class="btn btn-primary btn-sm" id="update-name-btn">
                                    Update Display Name
                                </button>
                            </form>
                        </div>
                    </div>
                </div>

                <!-- Behavior -->
                <div id="section-behavior">
                    <div class="section-header">
                        <span class="section-title">Behavior</span>
                    </div>
                    <div class="clean-card">
                        <div class="p-4 space-y-4">
                            <label class="flex items-center gap-4 cursor-pointer">
                                <input type="checkbox"
                                       name="autoFollowOnReply"
                                       class="toggle toggle-primary" />
                                <span>
                                    <span class="font-medium">Auto-follow on reply</span>
                                    <span class="block text-sm text-base-content/50">
                                        Automatically follow discussions when you post a reply.
                                    </span>
                                </span>
                            </label>
                        </div>
                    </div>
                </div>

