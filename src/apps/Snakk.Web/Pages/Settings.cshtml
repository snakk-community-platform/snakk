@page "/settings"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.SettingsModel
@{
    ViewData["Title"] = T.Settings.PageTitle;
    ViewData["AuthPrompt.Title"] = T.Settings.NudgeTitleAccess;
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<!-- Center Column -->
<div class="sn-center">
    <div class="sn-center-inner">
        <partial name="Shared/_AuthPrompt" />
    </div>
</div>

<!-- Right Column -->
<aside class="sn-right">
@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<div class="sn-right-sticky">
    <partial name="Shared/_RightActionPane" />
</div>
</aside>
