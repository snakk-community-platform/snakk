                                <label class="label">
                                    <span class="label-text-alt text-base-content/50">Click a country on the map, or select directly</span>
                                    <button type="button" id="tz-show-all" class="label-text-alt text-base-content/50 hover:text-base-content underline bg-transparent border-0 cursor-pointer p-0 hidden">show all</button>
                                </label>
                            </div>

                            <div class="form-control">
                                <label class="label">
                                    <span class="label-text font-medium">Emoji skin tone</span>
                                </label>
                                <div class="flex gap-2" id="skin-tone-picker">
                                    <button type="button" class="skin-tone-swatch active" data-tone="" title="Default">👋</button>
                                    <button type="button" class="skin-tone-swatch" data-tone="🏻" title="Light">👋🏻</button>
                                    <button type="button" class="skin-tone-swatch" data-tone="🏼" title="Medium-Light">👋🏼</button>
                                    <button type="button" class="skin-tone-swatch" data-tone="🏽" title="Medium">👋🏽</button>
                                    <button type="button" class="skin-tone-swatch" data-tone="🏾" title="Medium-Dark">👋🏾</button>
                                    <button type="button" class="skin-tone-swatch" data-tone="🏿" title="Dark">👋🏿</button>
                                </div>
                                <label class="label">
                                    <span class="label-text-alt text-base-content/50">Applies to hand and face emojis in the editor</span>
                                </label>
                            </div>
                        </div>
                    </div>
                </div>

            <!-- RSS Feeds Section -->
                <div id="section-rss">
                    <div class="section-header">
                        <span class="section-title">RSS Feeds</span>
                    </div>
                    <div class="clean-card mb-6">
                        <div class="p-4">
                            <p class="text-sm text-base-content/60 mb-4">
                                Subscribe to feeds in your favourite RSS reader. Public feeds work without a token.
                            </p>

                            <div class="space-y-3 text-sm mb-4">
                                <div>
                                    <span class="font-medium">Site-wide feed</span>
                                    <div class="flex items-center gap-2 mt-1">
                                        <input type="text" readonly value="/feed.xml" id="rss-site-url"
                                               class="input input-sm w-full font-mono text-xs" />
                                        <button type="button" class="btn btn-ghost btn-sm btn-square shrink-0" onclick="navigator.clipboard.writeText(document.getElementById('rss-site-url').value)" title="Copy">
                                            <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                                        </button>
                                    </div>
                                </div>
                                <p class="text-xs text-base-content/50">
                                    Feeds are also available per hub and space — look for the RSS icon or append <code>/feed.xml</code> to any hub or space URL.
                                </p>
                            </div>

                            <div class="border-t border-subtle pt-4">
                                <span class="font-medium text-sm">Personal feed token</span>
                                <p class="text-xs text-base-content/50 mt-1 mb-3">
                                    Generate a token for authenticated feeds (e.g. your followed discussions). Keep it secret — anyone with the token can read your feeds.
                                </p>

                                <div id="feed-token-section">
                                    <div id="feed-token-empty" class="hidden">
                                        <button type="button" class="btn btn-primary btn-sm" id="generate-feed-token-btn">Generate Token</button>
                                    </div>
                                    <div id="feed-token-active" class="hidden">
                                        <div class="flex items-center gap-2 mb-3">
                                            <input type="text" readonly id="feed-token-value"
                                                   class="input input-sm w-full font-mono text-xs" />
                                            <button type="button" class="btn btn-ghost btn-sm btn-square shrink-0" onclick="navigator.clipboard.writeText(document.getElementById('feed-token-value').value)" title="Copy">
                                                <svg xmlns="http://www.w3.org/2000/svg" class="h-4 w-4" fill="none" viewBox="0 0 24 24" stroke="currentColor"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M8 16H6a2 2 0 01-2-2V6a2 2 0 012-2h8a2 2 0 012 2v2m-6 12h8a2 2 0 002-2v-8a2 2 0 00-2-2h-8a2 2 0 00-2 2v8a2 2 0 002 2z" /></svg>
                                            </button>
                                        </div>
                                        <div class="flex gap-2">
                                            <button type="button" class="btn btn-ghost btn-sm" id="regenerate-feed-token-btn">Regenerate</button>
                                            <button type="button" class="btn btn-ghost btn-sm text-error" id="revoke-feed-token-btn">Revoke</button>
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    </div>
                </div>

            <!-- Trusted Devices Section -->
            <div id="section-devices" class="card bg-base-100 border border-subtle">
                <div class="card-body">
                    <h2 class="card-title text-lg">Trusted Devices</h2>
                    <p class="text-sm text-muted mb-4">Devices that have been trusted for this account. Revoking a device will require re-authentication on that device.</p>
                    <div id="devices-list">
                        <div class="flex justify-center py-4">
                            <span class="loading loading-spinner loading-md text-muted"></span>
                        </div>
                    </div>
                </div>
            </div>
        </div>

        <!-- Right: Account Sidebar (hidden below lg) -->
        <aside class="hidden lg:block w-72 xl:w-80 shrink-0">
            <div class="sticky top-32">
                <div class="sidebar-section">
                    <h3 class="sidebar-title">Account Information</h3>
                    <dl class="space-y-3 text-sm">
                        <div class="flex items-center gap-2">
                            <dt class="text-base-content/60 w-20 shrink-0">Email</dt>
                            <dd class="flex items-center gap-2">
                                <span class="profile-email truncate"></span>
                                <span class="profile-email-badge badge badge-sm shrink-0"></span>
                            </dd>
                        </div>
                        <div class="flex items-center gap-2 profile-oauth-row" style="display: none;">
                            <dt class="text-base-content/60 w-20 shrink-0">Sign in</dt>
                            <dd class="capitalize profile-oauth"></dd>
                        </div>
                        <div class="flex items-center gap-2">
                            <dt class="text-base-content/60 w-20 shrink-0">User ID</dt>
                            <dd class="font-mono text-xs truncate profile-userid"></dd>
                        </div>
                    </dl>
                </div>
            </div>
        </aside>
    </div>
</div>

<script type="application/json" id="settings-page-config">
@Html.Raw(System.Text.Json.JsonSerializer.Serialize(new
{
    turnstileSiteKey = Model.TurnstileSiteKey
}, new System.Text.Json.JsonSerializerOptions { PropertyNamingPolicy = System.Text.Json.JsonNamingPolicy.CamelCase }))
</script>
<script src="@SnakkUrlHelper.Js("pages/settings")" asp-append-version="true" defer></script>
<script src="/js/dist/components/timezone-map.js" defer></script>
@if (!string.IsNullOrEmpty(Model.TurnstileSiteKey))
{
    <script src="https://challenges.cloudflare.com/turnstile/v0/api.js" async defer></script>
}
