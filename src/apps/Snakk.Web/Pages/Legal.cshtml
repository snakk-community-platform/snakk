@page "/legal/{slug}"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.LegalModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="sn-legal-page-wrapper">
    <h1 class="sn-legal-page-title">@Model.Title</h1>
    <p class="sn-legal-version-label">@T.Pages.LegalVersion @Model.VersionNumber</p>

    <div class="sn-prose sn-prose-content sn-max-w-none">
        @Html.SanitizedRaw(Model.Content)
    </div>
</div>
