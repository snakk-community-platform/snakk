@page "/legal/{slug}"
@using Snakk.Web.Helpers
@model Snakk.Web.Pages.LegalModel
@{
    ViewData["Title"] = Model.Title;
}

<div class="max-w-3xl mx-auto px-4 py-8">
    <h1 class="text-2xl font-bold mb-2">@Model.Title</h1>
    <p class="text-xs text-base-content/40 mb-8">Version @Model.VersionNumber</p>

    <div class="prose prose-content max-w-none">
        @Html.Raw(Model.Content)
    </div>
</div>
