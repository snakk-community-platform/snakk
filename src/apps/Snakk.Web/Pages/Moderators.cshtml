@page "/moderators"
@using Snakk.Web.Helpers
@using Snakk.Web.Services
@inject ICommunityContext CommunityCtx
@model Snakk.Web.Pages.ModeratorsModel
@{
    ViewData["Title"] = T.Pages.ModeratorsTitle;
    ViewData["Description"] = "Global administrators and moderators for the platform.";
}

@section LeftColumn {
<partial name="Shared/_LeftSidebar" />
}

<div class="sn-center">
    <div class="sn-center-inner">
        <h2 class="sn-section-title">
            <span class="icon icon-user-add" aria-hidden="true"></span>
            @T.Pages.ModeratorsHeading
        </h2>
        <p class="text-sm mb-6" style="color: var(--text-secondary)">@T.Pages.ModeratorsLead</p>

        @if (Model.Moderators == null || Model.Moderators.TotalCount == 0)
        {
            <p class="text-sm" style="color: var(--text-tertiary)">@T.Pages.ModeratorsEmpty</p>
        }
        else
        {
            @foreach (var group in Model.Moderators.Groups)
            {
                <p class="text-xs font-semibold uppercase tracking-wide mt-6 mb-3" style="color: var(--text-tertiary)">
                    @group.Level
                    @if (!string.IsNullOrEmpty(group.ScopeName))
                    {
                        <span class="font-normal normal-case">(@group.ScopeName)</span>
                    }
                </p>
                <div class="sn-mod-list-grid">
                    @foreach (var mod in group.Moderators)
                    {
                        <a href="@SnakkUrlHelper.UserProfile(mod.UserPublicId)" class="sn-mod-list-card"
                           data-popup-type="user" data-popup-id="@mod.UserPublicId" data-popup-name="@mod.DisplayName">
                            <div class="sn-mod-list-banner"
                                 style="background-image: @UserGradient(mod.UserPublicId)">
                                <img src="@SnakkUrlHelper.UserAvatar(mod.UserPublicId)"
                                     alt="" width="34" height="34"
                                     class="sn-mod-list-avatar"
                                     loading="lazy" decoding="async" />
                                <span class="sn-mod-list-name">@mod.DisplayName</span>
                            </div>
                            <div class="sn-mod-list-body">
                                <span class="badge badge-sm badge-ghost">@FormatRole(mod.Role)</span>
                            </div>
                        </a>
                    }
                </div>
            }
        }
    </div>
</div>

@{
    ViewData["RightPane.NewDiscussionUrl"] = "/new";
}
<partial name="Shared/_GlobalRightSidebar" />

@functions {
    static string FormatRole(string role) => role switch
    {
        "GlobalAdmin" => T.Pages.RoleGlobalAdmin,
        "CommunityAdmin" => T.Pages.RoleCommunityAdmin,
        "CommunityMod" => T.Pages.RoleCommunityMod,
        "HubMod" => T.Pages.RoleHubMod,
        "SpaceMod" => T.Pages.RoleSpaceMod,
        _ => role
    };
}
