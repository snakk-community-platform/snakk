<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release</Configurations>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\core\Snakk.Infrastructure\Snakk.Infrastructure.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="LigerShark.WebOptimizer.Core" Version="3.0.477" />

    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.0" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.16.0" />

    <!-- PostgreSQL (for setup wizard DB connection test) -->
    <PackageReference Include="Npgsql" Version="10.0.0" />
  </ItemGroup>

  <!-- Security: Audit npm packages for vulnerabilities before build -->
  <Target Name="AuditNpmPackages" BeforeTargets="BuildTailwindCSS" Condition="'$(SkipBuildTailwindCSS)' != 'true'">
    <Exec Command="npm audit --audit-level=high" WorkingDirectory="$(ProjectDir)" ContinueOnError="true" />
  </Target>

  <!-- Build Tailwind CSS automatically before build (skip in Docker where CSS is pre-built) -->
  <Target Name="BuildTailwindCSS" BeforeTargets="Build" Condition="'$(SkipBuildTailwindCSS)' != 'true'">
    <Exec Command="npm run build:css" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
