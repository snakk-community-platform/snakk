<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <Configurations>Debug;Release</Configurations>
    <TypeScriptCompileBlocked>true</TypeScriptCompileBlocked>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\..\aspire\Snakk.ServiceDefaults\Snakk.ServiceDefaults.csproj" />
    <ProjectReference Include="..\..\core\Snakk.Infrastructure\Snakk.Infrastructure.csproj" />
    <ProjectReference Include="..\..\core\Snakk.Protos\Snakk.Protos.csproj" />
    <ProjectReference Include="..\..\core\Snakk.Shared\Snakk.Shared.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Fido2.AspNet" Version="4.0.1" />
    <PackageReference Include="HtmlSanitizer" Version="9.0.892" />
    <!-- JWT Authentication -->
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Http.Resilience" Version="10.6.0" />
    <PackageReference Include="Npgsql" Version="10.0.2" />
    <PackageReference Include="prometheus-net.AspNetCore" Version="8.2.1" />
    <PackageReference Include="prometheus-net.DotNetRuntime" Version="4.4.1" />
	<PackageReference Include="SixLabors.ImageSharp" Version="[3.1.12, 4.0.0)" />
    <PackageReference Include="System.IdentityModel.Tokens.Jwt" Version="8.18.0" />

    <!-- gRPC client -->
    <PackageReference Include="Grpc.Net.Client" Version="2.80.0" />
    <PackageReference Include="System.IO.Hashing" Version="10.0.8" />
    <PackageReference Include="Microsoft.Extensions.Caching.StackExchangeRedis" Version="10.0.8" />
  </ItemGroup>

  <!-- Help center articles — .md files aren't auto-included by the Web SDK -->
  <ItemGroup>
    <None Remove="Content\Help\**\*.md" />
    <Content Include="Content\Help\**\*.md" CopyToOutputDirectory="PreserveNewest" />
    <Content Update="Content\Help\**\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Ship locale JSON to the output so LocaleLoader can read them at startup -->
  <ItemGroup>
    <Content Update="Locales\*.json" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

  <!-- Generate Helpers/T.g.cs from Locales/en.json before C# compilation.
       Also validates that every other *.json has the same key set. -->
  <Target Name="GenerateLocaleStrings" BeforeTargets="BeforeCompile;CoreCompile" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec Command="node Locales/gen-strings.mjs" WorkingDirectory="$(ProjectDir)" />
  </Target>

  <!-- Security: Audit npm packages for vulnerabilities before build -->
  <Target Name="AuditNpmPackages" BeforeTargets="BuildFrontend" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec Command="npm audit --audit-level=high" WorkingDirectory="$(ProjectDir)" ContinueOnError="true" />
  </Target>

  <!-- Build all frontend assets (TypeScript, CSS, editor bundle) automatically before build -->
  <Target Name="BuildFrontend" BeforeTargets="Build" Condition="'$(SkipFrontendBuild)' != 'true'">
    <Exec Command="npm run build" WorkingDirectory="$(ProjectDir)" />
  </Target>

</Project>
