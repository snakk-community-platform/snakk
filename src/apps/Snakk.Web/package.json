{
  "name": "snakk.web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:ts && npm run build:css && npm run build:editor && npm run build:prism",
    "build:ts": "tsc && node esbuild.minify.mjs",
    "build:css": "npm run build:tailwind && npm run build:tailwind-dark && npm run build:custom",
    "build:tailwind": "tailwindcss -i ./Styles/input.css -o ./wwwroot/css/vendor/tailwind.css --minify",
    "build:tailwind-dark": "tailwindcss -i ./Styles/dark-input.css -o ./wwwroot/css/vendor/dark-theme.css --minify",
    "build:custom": "sass Styles/site.scss:wwwroot/css/dist/site.css --style=compressed --no-source-map",
    "watch": "npm run watch:ts & npm run watch:css",
    "watch:ts": "tsc --watch",
    "watch:css": "npm run watch:tailwind & npm run watch:tailwind-dark & npm run watch:custom",
    "watch:tailwind": "tailwindcss -i ./Styles/input.css -o ./wwwroot/css/vendor/tailwind.css --watch",
    "watch:tailwind-dark": "tailwindcss -i ./Styles/dark-input.css -o ./wwwroot/css/vendor/dark-theme.css --watch",
    "watch:custom": "sass Styles/site.scss:wwwroot/css/dist/site.css --watch --no-source-map",
    "build:editor": "node esbuild.editor.mjs",
    "build:prism": "node esbuild.prism.mjs",
    "copy:libs": "powershell -Command \"Copy-Item 'node_modules/htmx.org/dist/htmx.min.js' 'wwwroot/js/vendor/htmx.min.js'; Copy-Item 'node_modules/htmx.org/dist/ext/head-support.js' 'wwwroot/js/vendor/htmx-head-support.js'; Copy-Item 'node_modules/prismjs/themes/prism-tomorrow.min.css' 'wwwroot/css/vendor/prism.css'\"",
    "postinstall": "npm run copy:libs && npm run build:editor && npm run build:prism",
    "test": "echo \"Error: no test specified\" && exit 1"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@microsoft/signalr": "^8.0.7",
    "@tailwindcss/cli": "^4.2.2",
    "@types/node": "^22.10.2",
    "daisyui": "^5.0.0",
    "esbuild": "^0.28.0",
    "htmx.org": "^2.0.8",
    "sass": "^1.97.3",
    "typescript": "^6.0.2"
  },
  "dependencies": {
    "@milkdown/kit": "^7.20.0",
    "prismjs": "^1.30.0"
  }
}
