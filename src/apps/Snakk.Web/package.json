{
  "name": "snakk.web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:locales && npm run build:ts && npm run build:bundles && npm run build:css && npm run build:editor && npm run build:prism && npm run build:charts",
    "build:locales": "node Locales/gen-strings.mjs && node Locales/gen-ts.mjs && node gen-social-icons.mjs && node gen-lang-icons.mjs",
    "build:ts": "tsc && node esbuild.minify.mjs",
    "build:bundles": "node esbuild.core.mjs",
    "watch:bundles": "node esbuild.core.mjs --watch",
    "build:css": "npm run build:custom",
    "build:icons": "node hash-icons.mjs",
    "build:custom": "npm run build:icons && sass Styles/dm-widget.scss:wwwroot/css/dist/dm-widget.css Styles/features:wwwroot/css/features --style=compressed --no-source-map",
    "watch": "npm run watch:ts & npm run watch:css",
    "watch:ts": "tsc --watch",
    "watch:css": "npm run watch:custom",
    "watch:custom": "sass Styles/dm-widget.scss:wwwroot/css/dist/dm-widget.css Styles/features:wwwroot/css/features --watch --no-source-map",
    "build:editor": "node esbuild.editor.mjs",
    "build:prism": "node esbuild.prism.mjs",
    "build:charts": "node esbuild.charts.mjs",
    "copy:libs": "node copy-libs.mjs",
    "postinstall": "npm run copy:libs && npm run build:editor && npm run build:prism && npm run build:charts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"npm:dev:*\"",
    "dev:ts": "tsc --watch --preserveWatchOutput",
    "dev:sass": "sass Styles/dm-widget.scss:wwwroot/css/dist/dm-widget.css Styles/features:wwwroot/css/features --watch --no-source-map"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.3",
    "bootstrap-icons": "^1.13.1",
    "concurrently": "^10.0.3",
    "dompurify": "^3.4.11",
    "esbuild": "^0.28.1",
    "htmx-ext-head-support": "^2.0.5",
    "htmx.org": "^2.0.10",
    "sass": "^1.101.0",
    "simple-icons": "^16.23.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@milkdown/kit": "^7.21.2",
    "chart.js": "^4.4.9",
    "prismjs": "^1.30.0"
  }
}
