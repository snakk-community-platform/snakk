{
  "name": "snakk.web",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build": "npm run build:locales && npm run build:ts && npm run build:css && npm run build:editor && npm run build:prism && npm run build:charts",
    "build:locales": "node Locales/gen-strings.mjs && node Locales/gen-ts.mjs && node gen-social-icons.mjs && node gen-lang-icons.mjs",
    "build:ts": "tsc && node esbuild.minify.mjs",
    "build:css": "npm run build:tailwind && npm run build:tailwind-dark && npm run build:custom",
    "build:tailwind": "tailwindcss -i ./Styles/input.css -o ./wwwroot/css/vendor/tailwind.css --minify",
    "build:tailwind-dark": "tailwindcss -i ./Styles/dark-input.css -o ./wwwroot/css/vendor/dark-theme.css --minify",
    "build:icons": "node hash-icons.mjs",
    "build:custom": "npm run build:icons && sass Styles/site.scss:wwwroot/css/dist/site.css Styles/discussion.scss:wwwroot/css/dist/discussion.css Styles/settings.scss:wwwroot/css/dist/settings.css Styles/space.scss:wwwroot/css/dist/space.css Styles/user-profile.scss:wwwroot/css/dist/user-profile.css Styles/type-question.scss:wwwroot/css/dist/type-question.css Styles/type-poll.scss:wwwroot/css/dist/type-poll.css Styles/type-link.scss:wwwroot/css/dist/type-link.css Styles/type-debate.scss:wwwroot/css/dist/type-debate.css Styles/type-journal.scss:wwwroot/css/dist/type-journal.css Styles/type-guide.scss:wwwroot/css/dist/type-guide.css Styles/type-iama.scss:wwwroot/css/dist/type-iama.css Styles/type-images.scss:wwwroot/css/dist/type-images.css Styles/lightbox.scss:wwwroot/css/dist/lightbox.css Styles/editor.scss:wwwroot/css/dist/editor.css Styles/discussion-list.scss:wwwroot/css/dist/discussion-list.css Styles/help.scss:wwwroot/css/dist/help.css Styles/dm-widget.scss:wwwroot/css/dist/dm-widget.css --style=compressed --no-source-map",
    "watch": "npm run watch:ts & npm run watch:css",
    "watch:ts": "tsc --watch",
    "watch:css": "npm run watch:tailwind & npm run watch:tailwind-dark & npm run watch:custom",
    "watch:tailwind": "tailwindcss -i ./Styles/input.css -o ./wwwroot/css/vendor/tailwind.css --watch",
    "watch:tailwind-dark": "tailwindcss -i ./Styles/dark-input.css -o ./wwwroot/css/vendor/dark-theme.css --watch",
    "watch:custom": "sass Styles/site.scss:wwwroot/css/dist/site.css Styles/discussion.scss:wwwroot/css/dist/discussion.css Styles/settings.scss:wwwroot/css/dist/settings.css Styles/space.scss:wwwroot/css/dist/space.css Styles/user-profile.scss:wwwroot/css/dist/user-profile.css Styles/type-question.scss:wwwroot/css/dist/type-question.css Styles/type-poll.scss:wwwroot/css/dist/type-poll.css Styles/type-link.scss:wwwroot/css/dist/type-link.css Styles/type-debate.scss:wwwroot/css/dist/type-debate.css Styles/type-journal.scss:wwwroot/css/dist/type-journal.css Styles/type-guide.scss:wwwroot/css/dist/type-guide.css Styles/type-iama.scss:wwwroot/css/dist/type-iama.css Styles/type-images.scss:wwwroot/css/dist/type-images.css Styles/lightbox.scss:wwwroot/css/dist/lightbox.css Styles/editor.scss:wwwroot/css/dist/editor.css Styles/discussion-list.scss:wwwroot/css/dist/discussion-list.css Styles/help.scss:wwwroot/css/dist/help.css Styles/dm-widget.scss:wwwroot/css/dist/dm-widget.css --watch --no-source-map",
    "build:editor": "node esbuild.editor.mjs",
    "build:prism": "node esbuild.prism.mjs",
    "build:charts": "node esbuild.charts.mjs",
    "copy:libs": "node copy-libs.mjs",
    "postinstall": "npm run copy:libs && npm run build:editor && npm run build:prism && npm run build:charts",
    "test": "echo \"Error: no test specified\" && exit 1",
    "dev": "concurrently \"npm:dev:*\"",
    "dev:ts": "tsc --watch --preserveWatchOutput",
    "dev:tailwind": "tailwindcss -i ./Styles/input.css -o ./wwwroot/css/vendor/tailwind.css --watch",
    "dev:tailwind-dark": "tailwindcss -i ./Styles/dark-input.css -o ./wwwroot/css/vendor/dark-theme.css --watch",
    "dev:sass": "sass Styles/site.scss:wwwroot/css/dist/site.css --watch --no-source-map"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@microsoft/signalr": "^10.0.0",
    "@tailwindcss/cli": "^4.3.0",
    "@types/dompurify": "^3.2.0",
    "@types/node": "^25.9.2",
    "bootstrap-icons": "^1.13.1",
    "concurrently": "^10.0.3",
    "daisyui": "^5.5.20",
    "dompurify": "^3.4.8",
    "esbuild": "^0.28.0",
    "htmx.org": "^2.0.10",
    "sass": "^1.100.0",
    "simple-icons": "^16.22.0",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@milkdown/kit": "^7.21.2",
    "chart.js": "^4.4.9",
    "prismjs": "^1.30.0"
  }
}
