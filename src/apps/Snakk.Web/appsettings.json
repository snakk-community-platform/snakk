{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Snakk": "Information"
    }
  },
  "AllowedHosts": "*",
  "EnableRateLimiting": false,
  "Ui": {
    "Language": "en"
  },
  "Debug": {
    "ShowCommunityDebugPane": false
  },
  "ApiBaseUrl": "https://localhost:17101",
  "RealtimeServiceUrl": "/realtime",
  "Realtime": {
    "JwtKey": "DEV_REALTIME_SECRET_CHANGE_IN_PRODUCTION_MIN32CHARS"
  },
  "Jwt": {
    "SecretKey": "your-secret-key-min-32-characters-change-in-production",
    "Issuer": "Snakk",
    "Audience": "Snakk"
  },
  "Snakk": {
    "DefaultCommunitySlug": "snakk",
    "PrimaryDomains": [
      "localhost",
      "snakk.example.com",
      "snakk.local"
    ],
    "DomainCache": {
      "ExpirationMinutes": 15,
      "NegativeExpirationMinutes": 5
    }
  },
  "FileStorage": {
    "BasePath": "c:\\Snakk\\storage",
    "PublicUrlBase": "/"
  },
  "Features": {
    "MultiCommunityEnabled": true,
    "PasskeysEnabled": true,
    "TwoFactorEnabled": true,
    "PrivateMessagingEnabled": true
  },
  "EndlessScroll": {
    "MaxPages": 10
  },
  "Trending": {
    "FrontPage": {
      "ShowDiscussions": true,
      "ShowSpaces": true,
      "ShowContributors": true
    },
    "HubList": {
      "ShowDiscussions": true,
      "ShowSpaces": true,
      "ShowContributors": true
    },
    "SpaceList": {
      "ShowDiscussions": true,
      "ShowContributors": true
    },
    "DiscussionList": {
      "ShowDiscussions": true,
      "ShowContributors": true
    }
  }
}
