@inject AdminApiClientService ApiService

<FluentCard>
    <FluentStack Orientation="Orientation.Horizontal" Style="justify-content: space-between;">
        <h2>Team</h2>
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => _showAddMod = true)">
            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" /> Add Moderator
        </FluentButton>
    </FluentStack>
</FluentCard>

@if (_showAddMod)
{
    <FluentCard Style="margin-top: 16px;">
        <h3>Add Moderator</h3>
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
            <FluentTextField @bind-Value="_newModUsername" Label="Username" Placeholder="Search for user..." />

            <FluentLabel Weight="FontWeight.Bold">Permissions</FluentLabel>
            <FluentStack Orientation="Orientation.Vertical" Style="gap: 4px;">
                <FluentCheckbox @bind-Value="_permViewDashboard" Label="View Dashboard" />
                <FluentCheckbox @bind-Value="_permManageContent" Label="Manage Content" />
                <FluentCheckbox @bind-Value="_permManageReports" Label="Manage Reports" />
                <FluentCheckbox @bind-Value="_permManageBans" Label="Manage Bans" />
                <FluentCheckbox @bind-Value="_permManageSettings" Label="Manage Settings" />
                <FluentCheckbox @bind-Value="_permManageTeam" Label="Manage Team" />
                <FluentCheckbox @bind-Value="_permManageWebhooks" Label="Manage Webhooks" />
            </FluentStack>

            <FluentStack Orientation="Orientation.Horizontal">
                <FluentButton Appearance="Appearance.Accent" OnClick="@AddModerator">Add</FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => _showAddMod = false)">Cancel</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>
}

<FluentCard Style="margin-top: 16px;">
    <h3>Current Moderators</h3>
    @if (_loading)
    {
        <FluentProgressRing />
    }
    else if (_moderators.Count == 0)
    {
        <p>No moderators assigned to this scope.</p>
    }
    else
    {
        <FluentDataGrid Items="@_moderators.AsQueryable()" Style="width: 100%;">
            <PropertyColumn Property="@(x => x.DisplayName)" Title="Name" />
            <PropertyColumn Property="@(x => x.RoleType)" Title="Role" />
            <PropertyColumn Property="@(x => x.PermissionsSummary)" Title="Permissions" />
            <PropertyColumn Property="@(x => x.AssignedAt)" Title="Since" Format="d" />
            <TemplateColumn Title="Actions">
                <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Lightweight"
                              OnClick="@(() => RemoveModerator(context.RoleId))">
                    Remove
                </FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
    }
</FluentCard>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _showAddMod;
    private string _newModUsername = "";
    private bool _permViewDashboard = true;
    private bool _permManageContent = true;
    private bool _permManageReports = true;
    private bool _permManageBans = true;
    private bool _permManageSettings;
    private bool _permManageTeam;
    private bool _permManageWebhooks;
    private List<ModeratorItem> _moderators = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        await LoadTeam();
    }

    private async Task LoadTeam()
    {
        _loading = true;
        // TODO: Load moderators from API with scope filtering
        _moderators = new();
        _loading = false;
        await Task.CompletedTask;
    }

    private async Task AddModerator()
    {
        // TODO: Call API to add moderator with selected permissions
        _showAddMod = false;
        _newModUsername = "";
        ResetPermissions();
        await LoadTeam();
    }

    private async Task RemoveModerator(string roleId)
    {
        // TODO: Call API to remove moderator
        await LoadTeam();
    }

    private void ResetPermissions()
    {
        _permViewDashboard = true;
        _permManageContent = true;
        _permManageReports = true;
        _permManageBans = true;
        _permManageSettings = false;
        _permManageTeam = false;
        _permManageWebhooks = false;
    }

    private class ModeratorItem
    {
        public string RoleId { get; set; } = "";
        public string DisplayName { get; set; } = "";
        public string RoleType { get; set; } = "";
        public string PermissionsSummary { get; set; } = "";
        public DateTime AssignedAt { get; set; }
    }
}
