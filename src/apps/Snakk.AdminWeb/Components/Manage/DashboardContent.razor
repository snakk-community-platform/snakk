@inject AdminApiClientService ApiService

<FluentCard>
    <h2>@Scope?.ScopeType Dashboard</h2>
    <p>Managing: <strong>@Scope?.ScopeName</strong></p>
</FluentCard>

<FluentStack Orientation="Orientation.Horizontal" Wrap="true" Style="margin-top: 16px; gap: 16px;">
    @if (HasPermission(ManagePermissionEnum.ManageReports))
    {
        <FluentCard Style="flex: 1; min-width: 200px;">
            <FluentIcon Value="@(new Icons.Regular.Size24.Warning())" Color="Color.Warning" />
            <h3>Open Reports</h3>
            <FluentLabel Typo="Typography.H2">@_openReports</FluentLabel>
        </FluentCard>
    }

    @if (HasPermission(ManagePermissionEnum.ManageBans))
    {
        <FluentCard Style="flex: 1; min-width: 200px;">
            <FluentIcon Value="@(new Icons.Regular.Size24.PersonProhibited())" Color="Color.Error" />
            <h3>Active Bans</h3>
            <FluentLabel Typo="Typography.H2">@_activeBans</FluentLabel>
        </FluentCard>
    }

    @if (HasPermission(ManagePermissionEnum.ManageTeam))
    {
        <FluentCard Style="flex: 1; min-width: 200px;">
            <FluentIcon Value="@(new Icons.Regular.Size24.PeopleTeam())" Color="Color.Accent" />
            <h3>Team Members</h3>
            <FluentLabel Typo="Typography.H2">@_teamMembers</FluentLabel>
        </FluentCard>
    }

    <FluentCard Style="flex: 1; min-width: 200px;">
        <FluentIcon Value="@(new Icons.Regular.Size24.History())" Color="Color.Neutral" />
        <h3>Recent Actions</h3>
        <FluentLabel Typo="Typography.H2">@_recentActions</FluentLabel>
    </FluentCard>
</FluentStack>

@if (HasPermission(ManagePermissionEnum.ViewDashboard))
{
    <FluentCard Style="margin-top: 16px;">
        <h3>Recent Moderation Activity</h3>
        @if (_recentLog.Count == 0)
        {
            <p>No recent moderation activity.</p>
        }
        else
        {
            <FluentDataGrid Items="@_recentLog.AsQueryable()" Style="width: 100%;">
                <PropertyColumn Property="@(x => x.ActionType)" Title="Action" />
                <PropertyColumn Property="@(x => x.ActorDisplayName)" Title="By" />
                <PropertyColumn Property="@(x => x.Reason)" Title="Reason" />
                <PropertyColumn Property="@(x => x.CreatedAt)" Title="When" Format="g" />
            </FluentDataGrid>
        }
    </FluentCard>
}

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private int _openReports;
    private int _activeBans;
    private int _teamMembers;
    private int _recentActions;
    private List<ModerationLogEntry> _recentLog = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;

        // TODO: Load real data from API with scope filtering
        // For now, show placeholder values
        _openReports = 0;
        _activeBans = 0;
        _teamMembers = 0;
        _recentActions = 0;
        _recentLog = new();

        await Task.CompletedTask;
    }

    private bool HasPermission(ManagePermissionEnum permission)
    {
        return Scope?.Permissions.Contains(permission) ?? false;
    }

    private class ModerationLogEntry
    {
        public string ActionType { get; set; } = "";
        public string ActorDisplayName { get; set; } = "";
        public string? Reason { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
