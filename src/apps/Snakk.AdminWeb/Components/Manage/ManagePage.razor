@inject ManageScopeService ScopeService
@inject NavigationManager Navigation

@if (_loading)
{
    <FluentProgressRing />
}
else if (_scope == null)
{
    <FluentCard>
        <h2>Access Denied</h2>
        <p>You do not have permission to manage this resource, or it does not exist.</p>
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => Navigation.NavigateTo("/", true))">
            Go Home
        </FluentButton>
    </FluentCard>
}
else
{
    <CascadingValue Value="_scope">
        @ChildContent
    </CascadingValue>
}

@code {
    [Parameter] public string CommunitySlug { get; set; } = "";
    [Parameter] public string? HubSlug { get; set; }
    [Parameter] public string? SpaceSlug { get; set; }
    [Parameter] public RenderFragment? ChildContent { get; set; }

    private ManageScopeDto? _scope;
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        _loading = true;
        _scope = await ScopeService.ResolveScopeAsync(CommunitySlug, HubSlug, SpaceSlug);
        _loading = false;
    }
}
