@using Snakk.Application.DTOs.Management
@using Snakk.Shared.Enums
@inject AdminApiClientService ApiService

<FluentCard>
    <h2>@Scope?.ScopeType Settings</h2>
</FluentCard>

<FluentCard Style="margin-top: 16px;">
    @if (_loading)
    {
        <FluentProgressRing />
    }
    else if (_loadError is not null)
    {
        <FluentMessageBar Title="@_loadError" Intent="MessageIntent.Error" />
    }
    else
    {
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 16px; max-width: 600px;">
            <FluentTextField @bind-Value="_name" Label="Name" />
            <FluentTextArea @bind-Value="_description" Label="Description" Rows="4" />

            @if (Scope?.ScopeType == "Community")
            {
                <FluentSelect @bind-Value="_visibility" TOption="string" Label="Visibility">
                    <FluentOption Value="@("Public")">Public</FluentOption>
                    <FluentOption Value="@("Private")">Private</FluentOption>
                    <FluentOption Value="@("Unlisted")">Unlisted</FluentOption>
                </FluentSelect>
            }

            @if (Scope?.ScopeType == "Space")
            {
                <FluentSelect @bind-Value="_defaultSort" TOption="string" Label="Default Sort">
                    <FluentOption Value="@("latest")">Latest Activity</FluentOption>
                    <FluentOption Value="@("newest")">Newest First</FluentOption>
                    <FluentOption Value="@("oldest")">Oldest First</FluentOption>
                </FluentSelect>

                <div>
                    <FluentLabel Weight="FontWeight.Bold" Style="margin-bottom: 8px;">Allowed Discussion Types</FluentLabel>
                    <FluentStack Orientation="Orientation.Vertical" Style="gap: 8px;">
                        @foreach (var type in Enum.GetValues<DiscussionTypeEnum>())
                        {
                            var t = type;
                            <FluentCheckbox
                                Value="@(_allowedTypes.Contains(t))"
                                ValueChanged="@(v => ToggleType(t, v))"
                                Label="@t.ToString()" />
                        }
                    </FluentStack>
                    @if (_typeError is not null)
                    {
                        <FluentLabel Color="Color.Error" Style="margin-top: 4px;">@_typeError</FluentLabel>
                    }
                </div>
            }

            <FluentButton Appearance="Appearance.Accent" OnClick="@SaveSettings"
                          Disabled="@_saving">
                @if (_saving) { <FluentProgressRing Style="width: 16px; height: 16px;" /> }
                Save Settings
            </FluentButton>

            @if (_saved)
            {
                <FluentMessageBar Title="Settings saved" Intent="MessageIntent.Success" />
            }
            @if (_saveError is not null)
            {
                <FluentMessageBar Title="@_saveError" Intent="MessageIntent.Error" />
            }
        </FluentStack>
    }
</FluentCard>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string _name = "";
    private string _description = "";
    private string _visibility = "Public";
    private string _defaultSort = "latest";
    private HashSet<DiscussionTypeEnum> _allowedTypes = [DiscussionTypeEnum.Standard];
    private string? _loadError;
    private string? _saveError;
    private string? _typeError;

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        _loading = true;
        _loadError = null;

        if (Scope.ScopeType == "Space")
        {
            var settings = await ApiService.GetSpaceSettingsAsync(Scope.ScopePublicId);
            if (settings is not null)
            {
                _name = settings.Name;
                _description = settings.Description ?? "";
                _allowedTypes = settings.AllowedDiscussionTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(settings.AllowedDiscussionTypes)
                    : [DiscussionTypeEnum.Standard];
            }
            else
            {
                _loadError = "Failed to load space settings.";
            }
        }
        else
        {
            _name = Scope.ScopeName;
            _description = "";
        }

        _loading = false;
    }

    private void ToggleType(DiscussionTypeEnum type, bool enabled)
    {
        _typeError = null;

        if (enabled)
        {
            _allowedTypes.Add(type);
        }
        else if (_allowedTypes.Count > 1)
        {
            _allowedTypes.Remove(type);
        }
        else
        {
            _typeError = "At least one discussion type must be enabled.";
        }
    }

    private async Task SaveSettings()
    {
        _saving = true;
        _saved = false;
        _saveError = null;

        if (Scope?.ScopeType == "Space")
        {
            var request = new UpdateSpaceSettingsRequest
            {
                Name = _name,
                Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                AllowedDiscussionTypes = _allowedTypes.ToList()
            };

            var success = await ApiService.UpdateSpaceSettingsAsync(Scope.ScopePublicId, request);

            if (success)
                _saved = true;
            else
                _saveError = "Failed to save settings. Please try again.";
        }

        _saving = false;
    }
}
