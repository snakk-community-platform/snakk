@inject AdminApiClientService ApiService

<FluentCard>
    <h2>Report Reasons</h2>
    <p>Report reasons bubble down the hierarchy: Global → Community → Hub → Space.
    Users will see a combined list of all applicable reasons when reporting content.</p>
</FluentCard>

@* Inherited reasons (read-only) *@
@if (_inheritedReasons.Count > 0)
{
    <FluentCard Style="margin-top: 16px;">
        <h3>Inherited Reasons</h3>
        <p style="color: var(--neutral-foreground-hint); font-size: 14px;">
            These reasons are inherited from parent scopes and cannot be edited here.
        </p>
        <FluentDataGrid Items="@_inheritedReasons.AsQueryable()" Style="width: 100%;">
            <PropertyColumn Property="@(x => x.Name)" Title="Reason" />
            <PropertyColumn Property="@(x => x.Description)" Title="Description" />
            <PropertyColumn Property="@(x => x.SourceScope)" Title="Source" />
            <TemplateColumn Title="Status">
                <FluentBadge Appearance="Appearance.Neutral">Inherited</FluentBadge>
            </TemplateColumn>
        </FluentDataGrid>
    </FluentCard>
}

@* Custom reasons for this scope *@
<FluentCard Style="margin-top: 16px;">
    <FluentStack Orientation="Orientation.Horizontal" Style="justify-content: space-between;">
        <h3>Custom Reasons (This @Scope?.ScopeType)</h3>
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => _showAdd = true)">
            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" /> Add Reason
        </FluentButton>
    </FluentStack>

    @if (_showAdd)
    {
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px; margin-top: 12px; padding: 12px; border: 1px solid var(--neutral-stroke-rest); border-radius: 4px;">
            <FluentTextField @bind-Value="_newReasonName" Label="Reason Name" Placeholder="e.g., Off-topic" />
            <FluentTextArea @bind-Value="_newReasonDescription" Label="Description" Rows="2"
                            Placeholder="Describe when this reason should be used" />
            <FluentStack Orientation="Orientation.Horizontal">
                <FluentButton Appearance="Appearance.Accent" OnClick="@AddReason">Add</FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => _showAdd = false)">Cancel</FluentButton>
            </FluentStack>
        </FluentStack>
    }

    @if (_loading)
    {
        <FluentProgressRing />
    }
    else if (_customReasons.Count == 0)
    {
        <p style="margin-top: 12px;">No custom report reasons for this @Scope?.ScopeType.ToLower().</p>
    }
    else
    {
        <FluentDataGrid Items="@_customReasons.AsQueryable()" Style="width: 100%; margin-top: 12px;">
            <PropertyColumn Property="@(x => x.Name)" Title="Reason" />
            <PropertyColumn Property="@(x => x.Description)" Title="Description" />
            <TemplateColumn Title="Actions">
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Lightweight"
                                  OnClick="@(() => EditReason(context))">
                        Edit
                    </FluentButton>
                    <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Lightweight" Color="Color.Error"
                                  OnClick="@(() => DeleteReason(context.Id))">
                        Delete
                    </FluentButton>
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>
    }
</FluentCard>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _showAdd;
    private string _newReasonName = "";
    private string _newReasonDescription = "";
    private List<ReportReasonItem> _inheritedReasons = new();
    private List<ReportReasonItem> _customReasons = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        await LoadReasons();
    }

    private async Task LoadReasons()
    {
        _loading = true;
        // TODO: Load report reasons from API with bubbling (includeBubbled=true)
        // Separate into inherited (from parent scopes) and custom (this scope)
        _inheritedReasons = new();
        _customReasons = new();
        _loading = false;
        await Task.CompletedTask;
    }

    private async Task AddReason()
    {
        // TODO: Call API to create report reason for this scope
        _showAdd = false;
        _newReasonName = "";
        _newReasonDescription = "";
        await LoadReasons();
    }

    private void EditReason(ReportReasonItem reason)
    {
        // TODO: Show edit dialog
    }

    private async Task DeleteReason(string id)
    {
        // TODO: Call API to delete report reason
        await LoadReasons();
    }

    private class ReportReasonItem
    {
        public string Id { get; set; } = "";
        public string Name { get; set; } = "";
        public string Description { get; set; } = "";
        public string SourceScope { get; set; } = ""; // "Global", "Community", "Hub", "Space"
        public bool IsInherited { get; set; }
    }
}
