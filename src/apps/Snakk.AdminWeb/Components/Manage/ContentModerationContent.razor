@inject AdminApiClientService ApiService

<FluentCard>
    <h2>Content Moderation</h2>
    <p>Review and moderate content within this scope.</p>
</FluentCard>

<FluentCard Style="margin-top: 16px;">
    @if (_loading)
    {
        <FluentProgressRing />
    }
    else if (_flaggedContent.Count == 0)
    {
        <p>No flagged content at this time.</p>
    }
    else
    {
        <FluentDataGrid Items="@_flaggedContent.AsQueryable()" Style="width: 100%;">
            <PropertyColumn Property="@(x => x.ContentType)" Title="Type" />
            <PropertyColumn Property="@(x => x.AuthorName)" Title="Author" />
            <PropertyColumn Property="@(x => x.Preview)" Title="Content Preview" />
            <PropertyColumn Property="@(x => x.ReportCount)" Title="Reports" />
            <PropertyColumn Property="@(x => x.CreatedAt)" Title="Posted" Format="g" />
            <TemplateColumn Title="Actions">
                <FluentStack Orientation="Orientation.Horizontal">
                    <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Accent"
                                  OnClick="@(() => DeleteContent(context.Id, context.ContentType))">
                        Delete
                    </FluentButton>
                    @if (context.ContentType == "Discussion")
                    {
                        <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Lightweight"
                                      OnClick="@(() => LockDiscussion(context.Id))">
                            Lock
                        </FluentButton>
                    }
                </FluentStack>
            </TemplateColumn>
        </FluentDataGrid>
    }
</FluentCard>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private List<FlaggedContentItem> _flaggedContent = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        _loading = true;
        // TODO: Load flagged content from API with scope filtering
        _flaggedContent = new();
        _loading = false;
        await Task.CompletedTask;
    }

    private async Task DeleteContent(string id, string contentType)
    {
        // TODO: Call API to delete content
        await Task.CompletedTask;
    }

    private async Task LockDiscussion(string id)
    {
        // TODO: Call API to lock discussion
        await Task.CompletedTask;
    }

    private class FlaggedContentItem
    {
        public string Id { get; set; } = "";
        public string ContentType { get; set; } = ""; // "Post" or "Discussion"
        public string AuthorName { get; set; } = "";
        public string Preview { get; set; } = "";
        public int ReportCount { get; set; }
        public DateTime CreatedAt { get; set; }
    }
}
