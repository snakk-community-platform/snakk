@inject AdminApiClientService ApiService

<FluentCard>
    <FluentStack Orientation="Orientation.Horizontal" Style="justify-content: space-between;">
        <h2>Bans</h2>
        <FluentButton Appearance="Appearance.Accent" OnClick="@(() => _showNewBan = true)">
            <FluentIcon Value="@(new Icons.Regular.Size16.Add())" /> New Ban
        </FluentButton>
    </FluentStack>
</FluentCard>

@if (_showNewBan)
{
    <FluentCard Style="margin-top: 16px;">
        <h3>Create New Ban</h3>
        <FluentStack Orientation="Orientation.Vertical" Style="gap: 12px;">
            <FluentTextField @bind-Value="_newBanUsername" Label="Username" Placeholder="Search for user..." />
            <FluentTextArea @bind-Value="_newBanReason" Label="Reason" Rows="3" />
            <FluentSelect @bind-Value="_newBanDuration" TOption="string" Label="Duration">
                <FluentOption Value="@("1h")">1 Hour</FluentOption>
                <FluentOption Value="@("24h")">24 Hours</FluentOption>
                <FluentOption Value="@("7d")">7 Days</FluentOption>
                <FluentOption Value="@("30d")">30 Days</FluentOption>
                <FluentOption Value="@("permanent")">Permanent</FluentOption>
            </FluentSelect>
            <FluentStack Orientation="Orientation.Horizontal">
                <FluentButton Appearance="Appearance.Accent" OnClick="@CreateBan">Ban User</FluentButton>
                <FluentButton Appearance="Appearance.Lightweight" OnClick="@(() => _showNewBan = false)">Cancel</FluentButton>
            </FluentStack>
        </FluentStack>
    </FluentCard>
}

<FluentCard Style="margin-top: 16px;">
    <h3>Active Bans</h3>
    @if (_loading)
    {
        <FluentProgressRing />
    }
    else if (_bans.Count == 0)
    {
        <p>No active bans in this scope.</p>
    }
    else
    {
        <FluentDataGrid Items="@_bans.AsQueryable()" Style="width: 100%;">
            <PropertyColumn Property="@(x => x.UserName)" Title="User" />
            <PropertyColumn Property="@(x => x.Reason)" Title="Reason" />
            <PropertyColumn Property="@(x => x.BannedBy)" Title="Banned By" />
            <PropertyColumn Property="@(x => x.BannedAt)" Title="Banned At" Format="g" />
            <PropertyColumn Property="@(x => x.ExpiresAt)" Title="Expires" Format="g" />
            <TemplateColumn Title="Actions">
                <FluentButton Size="ButtonSize.Small" Appearance="Appearance.Lightweight"
                              OnClick="@(() => RevokeBan(context.Id))">
                    Revoke
                </FluentButton>
            </TemplateColumn>
        </FluentDataGrid>
    }
</FluentCard>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _showNewBan;
    private string _newBanUsername = "";
    private string _newBanReason = "";
    private string _newBanDuration = "24h";
    private List<BanItem> _bans = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        await LoadBans();
    }

    private async Task LoadBans()
    {
        _loading = true;
        // TODO: Load bans from API with scope filtering
        _bans = new();
        _loading = false;
        await Task.CompletedTask;
    }

    private async Task CreateBan()
    {
        // TODO: Call API to create ban
        _showNewBan = false;
        _newBanUsername = "";
        _newBanReason = "";
        _newBanDuration = "24h";
        await LoadBans();
    }

    private async Task RevokeBan(string banId)
    {
        // TODO: Call API to revoke ban
        await LoadBans();
    }

    private class BanItem
    {
        public string Id { get; set; } = "";
        public string UserName { get; set; } = "";
        public string Reason { get; set; } = "";
        public string BannedBy { get; set; } = "";
        public DateTime BannedAt { get; set; }
        public DateTime? ExpiresAt { get; set; }
    }
}
