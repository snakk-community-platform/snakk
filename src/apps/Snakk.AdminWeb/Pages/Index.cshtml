@page
@model Snakk.AdminWeb.Pages.IndexModel
@{
    ViewData["Title"] = "Dashboard";
}

<div class="page-header">
    <h1 class="page-title">Dashboard</h1>
    <p class="page-description">Overview of your Snakk platform</p>
</div>

<div class="stats-grid">
    <div class="stat-card">
        <div class="stat-label">Total Users</div>
        <div class="stat-value">@Model.Stats.TotalUsers</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Communities</div>
        <div class="stat-value">@Model.Stats.TotalCommunities</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Total Posts</div>
        <div class="stat-value">@Model.Stats.TotalPosts</div>
    </div>
    <div class="stat-card">
        <div class="stat-label">Pending Reports</div>
        <div class="stat-value">@Model.Stats.PendingReports</div>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Quick Actions</h2>
    </div>
    <div class="flex gap-2">
        <a href="/Communities/Create" class="btn btn-primary">Create Community</a>
        <a href="/Users" class="btn btn-outline">Manage Users</a>
        <a href="/Moderation/Reports" class="btn btn-outline">View Reports</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">Recent Activity</h2>
    </div>
    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Time</th>
                    <th>Activity</th>
                    <th>User</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.RecentActivity.Any())
                {
                    @foreach (var activity in Model.RecentActivity)
                    {
                        <tr>
                            <td>@AdminDisplayHelper.FormatTimeAgo(activity.Timestamp)</td>
                            <td>@activity.Description</td>
                            <td>@activity.Username</td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="3" class="text-center">No recent activity</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
