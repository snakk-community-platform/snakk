@page "{slug}"
@model Snakk.AdminWeb.Pages.Communities.EditModel
@{
    ViewData["Title"] = $"Edit {Model.Name}";
}

<div class="page-header">
    <h1 class="page-title">Edit Community</h1>
    <p class="page-description">Modify community settings</p>
</div>

<div class="card">
    <form method="post">
        <div class="form-group">
            <label for="name" class="form-label">Name *</label>
            <input type="text"
                   id="name"
                   name="name"
                   class="form-input"
                   value="@Model.Name"
                   required
                   autofocus />
        </div>

        <div class="form-group">
            <label for="slug" class="form-label">Slug *</label>
            <input type="text"
                   id="slug"
                   name="slug"
                   class="form-input"
                   value="@Model.Slug"
                   disabled />
            <small style="color: #6b7280; font-size: 0.813rem;">Slug cannot be changed after creation</small>
        </div>

        <div class="form-group">
            <label for="description" class="form-label">Description *</label>
            <textarea id="description"
                      name="description"
                      class="form-textarea"
                      required>@Model.Description</textarea>
        </div>

        <div class="form-group">
            <label for="icon" class="form-label">Icon URL</label>
            <input type="text"
                   id="icon"
                   name="icon"
                   class="form-input"
                   value="@Model.Icon" />
        </div>

        <div class="form-group">
            <label for="banner" class="form-label">Banner URL</label>
            <input type="text"
                   id="banner"
                   name="banner"
                   class="form-input"
                   value="@Model.Banner" />
        </div>

        <div class="form-group">
            <label class="form-label">
                <input type="checkbox" name="isPrivate" @(Model.IsPrivate ? "checked" : "") /> Private Community
            </label>
        </div>

        <div class="form-group">
            <label class="form-label">
                <input type="checkbox" name="isActive" @(Model.IsActive ? "checked" : "") /> Active
            </label>
            <small style="color: #6b7280; font-size: 0.813rem;">Inactive communities are hidden from users</small>
        </div>

        <div class="flex gap-2">
            <button type="submit" class="btn btn-primary">Save Changes</button>
            <a href="/Communities" class="btn btn-outline">Cancel</a>
            <button type="button" class="btn btn-danger" onclick="if(confirmDelete('Are you sure you want to delete this community? This action cannot be undone.')) document.getElementById('deleteForm').submit();" style="margin-left: auto;">
                Delete Community
            </button>
        </div>
    </form>

    <form id="deleteForm" method="post" asp-page-handler="Delete" style="display: none;">
    </form>
</div>
