@page
@model Snakk.AdminWeb.Pages.Communities.IndexModel
@{
    ViewData["Title"] = "Communities";
}

<div class="page-header">
    <div class="flex justify-between items-center">
        <div>
            <h1 class="page-title">Communities</h1>
            <p class="page-description">Manage all communities on the platform</p>
        </div>
        <a href="/Communities/Create" class="btn btn-primary">Create Community</a>
    </div>
</div>

<div class="card">
    <div class="card-header">
        <h2 class="card-title">All Communities (@Model.Communities.Count)</h2>
    </div>

    <div class="table-container">
        <table>
            <thead>
                <tr>
                    <th>Name</th>
                    <th>Slug</th>
                    <th>Members</th>
                    <th>Posts</th>
                    <th>Created</th>
                    <th>Status</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                @if (Model.Communities.Any())
                {
                    @foreach (var community in Model.Communities)
                    {
                        <tr>
                            <td>
                                <div style="font-weight: 600;">@community.Name</div>
                                @if (!string.IsNullOrEmpty(community.Description))
                                {
                                    <div style="font-size: 0.813rem; color: #6b7280;">
                                        @AdminDisplayHelper.TruncateText(community.Description, 60)
                                    </div>
                                }
                            </td>
                            <td><code>@community.Slug</code></td>
                            <td>@AdminDisplayHelper.FormatNumber(community.MemberCount)</td>
                            <td>@AdminDisplayHelper.FormatNumber(community.PostCount)</td>
                            <td>@AdminDisplayHelper.FormatTimeAgo(community.CreatedAt)</td>
                            <td>
                                <span class="badge @(community.IsActive ? "badge-success" : "badge-secondary")">
                                    @(community.IsActive ? "Active" : "Inactive")
                                </span>
                            </td>
                            <td>
                                <div class="flex gap-2">
                                    <a href="/Communities/Details/@community.Slug" class="btn btn-sm btn-outline">View</a>
                                    <a href="/Communities/Edit/@community.Slug" class="btn btn-sm btn-primary">Edit</a>
                                </div>
                            </td>
                        </tr>
                    }
                }
                else
                {
                    <tr>
                        <td colspan="7" class="text-center">No communities found. <a href="/Communities/Create">Create one</a></td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
