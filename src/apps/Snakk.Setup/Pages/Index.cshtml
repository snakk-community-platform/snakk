@page "/setup"
@model Snakk.Setup.Pages.IndexModel

<div class="text-center space-y-6">
    <div class="text-6xl">&#128640;</div>
    <h2 class="text-2xl font-bold">Welcome to Snakk</h2>
    <p class="text-base-content/70 max-w-md mx-auto">
        This wizard will guide you through setting up your Snakk community platform.
        You'll configure your database, site settings, and create your admin account.
    </p>
    <div class="text-sm text-base-content/50 space-y-1">
        <p>What you'll need:</p>
        <ul class="list-disc list-inside text-left max-w-xs mx-auto">
            <li>PostgreSQL database credentials</li>
            <li>Your domain name</li>
            <li>An email for the admin account</li>
        </ul>
    </div>
    <form method="post" class="space-y-4">
        @if (Model.RequiresPassword)
        {
            <div class="form-control max-w-xs mx-auto">
                <input type="password"
                       name="Password"
                       class="input w-full text-center"
                       placeholder="Setup password"
                       required
                       autofocus />
                <label class="label">
                    <span class="label-text-alt text-base-content/50">From the installer output</span>
                </label>
            </div>
            @if (Model.ShowError)
            {
                <p class="text-error text-sm">Incorrect password.</p>
            }
        }
        <button type="submit" class="btn btn-primary btn-lg">Begin Setup</button>
    </form>
</div>
