@page
@model Snakk.Setup.Pages.StorageModel

<h2 class="text-xl font-semibold mb-4">Storage Configuration</h2>
<p class="text-base-content/70 mb-6">Configure where Snakk stores files like avatars and configuration.</p>

<form method="post" class="space-y-4">
    <div class="form-control">
        <label class="label"><span class="label-text">Storage Path</span></label>
        <input type="text" asp-for="AvatarStoragePath" class="input w-full" placeholder="/app/storage" />
        <label class="label"><span class="label-text-alt text-base-content/50">
            Absolute path for file storage. In Docker, this should be a mounted volume (default: /app/storage).
            For local development, use a relative or absolute path.
        </span></label>
        <span asp-validation-for="AvatarStoragePath" class="text-error text-sm"></span>
    </div>

    <div class="alert alert-info">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-current shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <span>This directory will also store the generated <code>appsettings.Production.json</code> configuration file, shared by all services.</span>
    </div>

    <div class="divider"></div>

    <div class="flex justify-between">
        <a asp-page="SiteConfig" class="btn btn-ghost">Back</a>
        <button type="submit" class="btn btn-primary">Next</button>
    </div>
</form>
