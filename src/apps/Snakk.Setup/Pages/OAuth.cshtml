@page "/setup/oauth"
@model Snakk.Setup.Pages.OAuthModel

<h2 class="text-xl font-semibold mb-4">OAuth Providers</h2>
<p class="text-base-content/70 mb-6">
    Configure social login providers. These are all optional — you can skip this step and configure them later.
</p>

<form method="post" class="space-y-6">
    <!-- Google -->
    <div class="collapse collapse-arrow bg-base-200">
        <input type="checkbox" />
        <div class="collapse-title font-medium">Google</div>
        <div class="collapse-content space-y-3">
            <div class="form-control">
                <label class="label"><span class="label-text">Client ID</span></label>
                <input type="text" asp-for="GoogleClientId" class="input input-sm w-full" autocomplete="off" />
            </div>
            <div class="form-control">
                <label class="label"><span class="label-text">Client Secret</span></label>
                <input type="password" asp-for="GoogleClientSecret" class="input input-sm w-full" autocomplete="new-password" />
            </div>
        </div>
    </div>

    <!-- GitHub -->
    <div class="collapse collapse-arrow bg-base-200">
        <input type="checkbox" />
        <div class="collapse-title font-medium">GitHub</div>
        <div class="collapse-content space-y-3">
            <div class="form-control">
                <label class="label"><span class="label-text">Client ID</span></label>
                <input type="text" asp-for="GitHubClientId" class="input input-sm w-full" autocomplete="off" />
            </div>
            <div class="form-control">
                <label class="label"><span class="label-text">Client Secret</span></label>
                <input type="password" asp-for="GitHubClientSecret" class="input input-sm w-full" autocomplete="new-password" />
            </div>
        </div>
    </div>

    <!-- Discord -->
    <div class="collapse collapse-arrow bg-base-200">
        <input type="checkbox" />
        <div class="collapse-title font-medium">Discord</div>
        <div class="collapse-content space-y-3">
            <div class="form-control">
                <label class="label"><span class="label-text">Client ID</span></label>
                <input type="text" asp-for="DiscordClientId" class="input input-sm w-full" autocomplete="off" />
            </div>
            <div class="form-control">
                <label class="label"><span class="label-text">Client Secret</span></label>
                <input type="password" asp-for="DiscordClientSecret" class="input input-sm w-full" autocomplete="new-password" />
            </div>
        </div>
    </div>

    <div class="divider"></div>

    <div class="flex justify-between">
        <a asp-page="Security" class="btn btn-ghost">Back</a>
        <button type="submit" class="btn btn-primary">Next</button>
    </div>
</form>
