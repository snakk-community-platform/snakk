@page "/setup/install"
@model Snakk.Setup.Pages.InstallModel

@Html.AntiForgeryToken()
<div id="installing" class="text-center space-y-6">
    <div class="text-5xl">
        <span id="status-icon" class="loading loading-spinner loading-lg text-primary"></span>
    </div>
    <h2 id="status-title" class="text-2xl font-bold">Installing Snakk...</h2>
    <p id="status-message" class="text-base-content/70">Setting up your Snakk instance. This may take a moment.</p>

    <div id="progress-steps" class="text-left max-w-md mx-auto space-y-2 mt-6">
        <div id="step-config" class="flex items-center gap-2 text-base-content/50">
            <span class="w-4 h-4 inline-block shrink-0"></span>
            <span>Writing configuration...</span>
        </div>
        <div id="step-migrations" class="flex items-center gap-2 text-base-content/30">
            <span class="w-4 h-4 inline-block shrink-0"></span>
            <span>Running database migrations...</span>
        </div>
        <div id="step-admin" class="flex items-center gap-2 text-base-content/30">
            <span class="w-4 h-4 inline-block shrink-0"></span>
            <span>Creating admin account...</span>
        </div>
        <div id="step-seeding" class="flex items-center gap-2 text-base-content/30">
            <span class="w-4 h-4 inline-block shrink-0"></span>
            <span>Seeding test data...</span>
        </div>
        <div id="step-avatars" class="flex items-center gap-2 text-base-content/30">
            <span class="w-4 h-4 inline-block shrink-0"></span>
            <span>Generating avatars...</span>
        </div>
        <div id="step-finalizing" class="flex items-center gap-2 text-base-content/30">
            <span class="w-4 h-4 inline-block shrink-0"></span>
            <span>Finalizing setup...</span>
        </div>
    </div>

    <!-- Live detail from seeder output -->
    <p id="status-detail" class="text-sm text-base-content/40 italic hidden"></p>

    <!-- Error display (hidden by default) -->
    <div id="error-display" class="hidden">
        <div class="alert alert-error text-left">
            <svg xmlns="http://www.w3.org/2000/svg" class="stroke-current shrink-0 h-6 w-6" fill="none" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 14l2-2m0 0l2-2m-2 2l-2-2m2 2l2 2m7-2a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
            <div>
                <h3 class="font-bold">Installation Failed</h3>
                <p id="error-message" class="text-sm"></p>
            </div>
        </div>
        <a asp-page="Review" class="btn btn-ghost mt-4">Back to Review</a>
    </div>

    <!-- Success: redirect to restarting page -->
</div>

<script>
    (function () {
        'use strict';

        var csrfToken = document.querySelector('input[name="__RequestVerificationToken"]').value;
        var stepOrder = ['config', 'migrations', 'admin', 'seeding', 'avatars', 'finalizing'];
        var seedEnabled = false;
        var pollTimer = null;

        function markStep(id, status) {
            var el = document.getElementById('step-' + id);
            if (!el) return;
            var icon = el.querySelector('span:first-child');
            if (status === 'active') {
                el.className = 'flex items-center gap-2 text-base-content';
                icon.className = 'loading loading-spinner loading-xs shrink-0';
                icon.textContent = '';
            } else if (status === 'done') {
                el.className = 'flex items-center gap-2 text-success';
                icon.className = 'w-4 h-4 inline-block shrink-0';
                icon.textContent = '\u2713';
            } else if (status === 'error') {
                el.className = 'flex items-center gap-2 text-error';
                icon.className = 'w-4 h-4 inline-block shrink-0';
                icon.textContent = '\u2717';
            } else if (status === 'hidden') {
                el.classList.add('hidden');
            } else if (status === 'waiting') {
                el.className = 'flex items-center gap-2 text-base-content/30';
                icon.className = 'w-4 h-4 inline-block shrink-0';
                icon.textContent = '';
            }
        }

        function updateSteps(currentStep) {
            var reached = false;
            for (var i = 0; i < stepOrder.length; i++) {
                var s = stepOrder[i];
                // Skip hidden steps
                if (!seedEnabled && (s === 'seeding' || s === 'avatars')) continue;
                if (s === currentStep) {
                    reached = true;
                    markStep(s, 'active');
                } else if (!reached) {
                    markStep(s, 'done');
                } else {
                    markStep(s, 'waiting');
                }
            }
        }

        function showError(message) {
            if (pollTimer) { clearInterval(pollTimer); pollTimer = null; }
            document.getElementById('status-icon').className = 'text-5xl';
            document.getElementById('status-icon').textContent = '\u274C';
            document.getElementById('status-title').textContent = 'Installation Failed';
            document.getElementById('status-message').classList.add('hidden');
            document.getElementById('progress-steps').classList.add('hidden');
            document.getElementById('status-detail').classList.add('hidden');
            document.getElementById('error-message').textContent = message;
            document.getElementById('error-display').classList.remove('hidden');
        }

        async function showSuccess() {
            document.getElementById('status-icon').className = 'loading loading-spinner loading-lg text-success';
            document.getElementById('status-title').textContent = 'Setup Complete!';
            document.getElementById('status-message').textContent = 'Waiting for Snakk to be ready…';
            document.getElementById('status-detail').classList.add('hidden');

            // Poll / until the web app is up, then navigate.
            // The gateway forwards / to the web cluster once setup is done;
            // YARP returns 503 while the cluster is still starting.
            var deadline = Date.now() + 90000;
            while (Date.now() < deadline) {
                await new Promise(function (r) { setTimeout(r, 2000); });
                try {
                    var res = await fetch('/', { method: 'HEAD', cache: 'no-store' });
                    if (res.ok) {
                        window.location.href = '/';
                        return;
                    }
                } catch (e) {
                    // Network error or YARP 503 — keep waiting
                }
            }
            window.location.href = '/';
        }

        async function pollStatus() {
            try {
                var res = await fetch('/setup/install?handler=Status');
                if (!res.ok) return null;
                return await res.json();
            } catch (e) {
                return null;
            }
        }

        async function finalize() {
            try {
                var res = await fetch('/setup/install?handler=Finalize', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': csrfToken }
                });
                if (!res.ok) return false;
                var data = await res.json();
                return data.success;
            } catch (e) {
                return false;
            }
        }

        function startPolling() {
            pollTimer = setInterval(async function () {
                var status = await pollStatus();
                if (!status) return; // Network error, keep polling

                seedEnabled = status.seedEnabled;

                // Hide seeding step if not enabled
                if (!seedEnabled) {
                    markStep('seeding', 'hidden');
                    markStep('avatars', 'hidden');
                }

                if (status.hasError) {
                    clearInterval(pollTimer);
                    pollTimer = null;
                    showError(status.errorMessage || 'An unknown error occurred.');
                    return;
                }

                if (status.isComplete) {
                    clearInterval(pollTimer);
                    pollTimer = null;

                    // Finalize: set JWT cookie + write marker file (triggers service restart)
                    var ok = await finalize();
                    if (!ok) {
                        showError('Failed to finalize setup. Please refresh and try again.');
                        return;
                    }

                    showSuccess();
                    return;
                }

                // Update step indicators
                if (status.step && status.step !== 'idle') {
                    updateSteps(status.step);
                }

                // Show live detail message from seeder output
                if (status.message) {
                    var detailEl = document.getElementById('status-detail');
                    detailEl.textContent = status.message;
                    detailEl.classList.remove('hidden');
                }
            }, 1500);
        }

        async function runInstall() {
            markStep('config', 'active');

            try {
                var res = await fetch('/setup/install', {
                    method: 'POST',
                    headers: { 'RequestVerificationToken': csrfToken }
                });
                if (!res.ok) {
                    showError('Failed to start installation: HTTP ' + res.status);
                    return;
                }
            } catch (e) {
                showError('Failed to start installation: ' + e.message);
                return;
            }

            // Start polling for progress
            startPolling();
        }

        // Start installation immediately on page load
        runInstall();
    })();
</script>
