@page "/setup/testdata"
@model Snakk.Setup.Pages.TestDataModel

<h2 class="text-xl font-semibold mb-4">Test Data</h2>
<p class="text-base-content/70 mb-6">Would you like to populate the database with sample data? This is useful for testing and development.</p>

<form method="post" class="space-y-4">
    <div class="form-control">
        <label class="label cursor-pointer justify-start gap-3">
            <input type="checkbox" asp-for="SeedTestData" class="toggle toggle-primary toggle-lg" />
            <div>
                <span class="label-text font-semibold">Seed test data</span>
                <p class="text-sm text-base-content/50 mt-1">Populate with sample communities, hubs, spaces, discussions, and users</p>
            </div>
        </label>
    </div>

    <div class="alert">
        <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" class="stroke-info shrink-0 w-6 h-6"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M13 16h-1v-4h-1m1-4h.01M21 12a9 9 0 11-18 0 9 9 0 0118 0z" /></svg>
        <div>
            <h3 class="font-bold text-sm">What's included in test data?</h3>
            <ul class="text-sm text-base-content/70 list-disc list-inside mt-1">
                <li>Sample communities with hubs and spaces</li>
                <li>Example discussions with posts and replies</li>
                <li>Test user accounts with various roles</li>
                <li>Sample reactions and follows</li>
            </ul>
        </div>
    </div>

    <div class="divider"></div>

    <div class="flex justify-between">
        <a asp-page="AdminAccount" class="btn btn-ghost">Back</a>
        <button type="submit" class="btn btn-primary">Next</button>
    </div>
</form>
