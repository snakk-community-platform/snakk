@page "/setup/siteconfig"
@model Snakk.Setup.Pages.SiteConfigModel

<h2 class="text-xl font-semibold mb-4">Site Configuration</h2>
<p class="text-base-content/70 mb-6">Configure your community's domain and basic settings.</p>

<form method="post" class="space-y-4">
    <div class="form-control">
        <label class="label"><span class="label-text">Domain</span></label>
        <input type="text" asp-for="Domain" class="input w-full" placeholder="snakk.example.com" />
        <label class="label"><span class="label-text-alt text-base-content/50">The domain where your Snakk instance will be accessible (without https://)</span></label>
        <span asp-validation-for="Domain" class="text-error text-sm"></span>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Site Name</span></label>
        <input type="text" asp-for="SiteName" class="input w-full" placeholder="My Community" />
        <label class="label"><span class="label-text-alt text-base-content/50">Displayed in the browser title and header</span></label>
    </div>

    <div class="form-control">
        <label class="label cursor-pointer justify-start gap-3">
            <input type="checkbox" asp-for="MultiCommunityEnabled" class="toggle toggle-primary" />
            <span class="label-text">Enable Multi-Community Mode</span>
        </label>
        <label class="label"><span class="label-text-alt text-base-content/50">Allow multiple independent communities on this instance</span></label>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Site Timezone</span></label>
        <select asp-for="Timezone" class="select w-full">
            <option value="UTC">UTC</option>
            <optgroup label="Americas">
                <option value="America/New_York">Eastern Time (New York)</option>
                <option value="America/Chicago">Central Time (Chicago)</option>
                <option value="America/Denver">Mountain Time (Denver)</option>
                <option value="America/Los_Angeles">Pacific Time (Los Angeles)</option>
                <option value="America/Anchorage">Alaska Time (Anchorage)</option>
                <option value="Pacific/Honolulu">Hawaii (Honolulu)</option>
                <option value="America/Toronto">Eastern Time (Toronto)</option>
                <option value="America/Vancouver">Pacific Time (Vancouver)</option>
                <option value="America/Sao_Paulo">Brasília (São Paulo)</option>
                <option value="America/Argentina/Buenos_Aires">Argentina (Buenos Aires)</option>
                <option value="America/Mexico_City">Central Time (Mexico City)</option>
            </optgroup>
            <optgroup label="Europe">
                <option value="Europe/London">GMT/BST (London)</option>
                <option value="Europe/Paris">CET (Paris, Berlin, Rome)</option>
                <option value="Europe/Helsinki">EET (Helsinki, Kyiv)</option>
                <option value="Europe/Moscow">Moscow Time</option>
                <option value="Europe/Oslo">CET (Oslo, Stockholm, Copenhagen)</option>
            </optgroup>
            <optgroup label="Asia &amp; Pacific">
                <option value="Asia/Dubai">GST (Dubai)</option>
                <option value="Asia/Kolkata">IST (India)</option>
                <option value="Asia/Bangkok">ICT (Bangkok, Jakarta)</option>
                <option value="Asia/Singapore">SGT (Singapore, Kuala Lumpur)</option>
                <option value="Asia/Shanghai">CST (China, Hong Kong)</option>
                <option value="Asia/Tokyo">JST (Tokyo)</option>
                <option value="Asia/Seoul">KST (Seoul)</option>
                <option value="Australia/Sydney">AEDT (Sydney)</option>
                <option value="Pacific/Auckland">NZDT (Auckland)</option>
            </optgroup>
            <optgroup label="Africa">
                <option value="Africa/Johannesburg">SAST (Johannesburg)</option>
                <option value="Africa/Cairo">EET (Cairo)</option>
                <option value="Africa/Lagos">WAT (Lagos)</option>
            </optgroup>
        </select>
        <label class="label"><span class="label-text-alt text-base-content/50">Default timezone for date display across the site</span></label>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Interface Language</span></label>
        <select asp-for="Language" class="select w-full">
            <option value="en">English</option>
            <option value="nb">Norsk bokmål</option>
        </select>
        <label class="label"><span class="label-text-alt text-base-content/50">Language used for UI chrome (nav, buttons, labels). User-generated content is not translated.</span></label>
    </div>

    <div class="form-control">
        <label class="label"><span class="label-text">Allowed Writing Systems for Display Names</span></label>
        <div class="grid grid-cols-1 sm:grid-cols-2 gap-1 mt-1">
            @foreach (var script in new[] {
                ("Latin",      "A–Z, a–z, æ ø å é ü ñ"),
                ("Cyrillic",   "А Б В а б в (Ru/Ua/Bg)"),
                ("Greek",      "Α Β Γ α β γ"),
                ("Arabic",     "ا ب ت ث"),
                ("Hebrew",     "א ב ג ד"),
                ("Devanagari", "क ख ग घ (Hi)"),
                ("CjkUnified", "一 二 三 中"),
                ("Hiragana",   "あ い う え お"),
                ("Katakana",   "ア イ ウ エ オ"),
                ("Hangul",     "가 나 다 라"),
                ("Thai",       "ก ข ค ง"),
                ("Armenian",   "Ա Բ Գ Դ"),
                ("Georgian",   "ა ბ გ დ")
            })
            {
                <label class="label cursor-pointer justify-start gap-2">
                    <input type="checkbox"
                           name="AllowedDisplayNameScripts"
                           value="@script.Item1"
                           class="checkbox checkbox-sm"
                           @(Model.AllowedDisplayNameScripts.Contains(script.Item1) ? "checked" : "") />
                    <span class="label-text text-sm"><strong>@script.Item1</strong> — @script.Item2</span>
                </label>
            }
        </div>
        <p class="text-sm text-base-content/50 mt-1 px-1">Which writing systems users may use in their display names. Latin covers most European languages including Norwegian. Names must use a single system (no mixing), preventing impersonation attacks. This can be changed later in Admin settings.</p>
    </div>

    <div class="divider"></div>

    <div class="flex justify-between">
        <a asp-page="Database" class="btn btn-ghost">Back</a>
        <button type="submit" class="btn btn-primary">Next</button>
    </div>
</form>
