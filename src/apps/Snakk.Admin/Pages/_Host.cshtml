@page
@addTagHelper *, Microsoft.AspNetCore.Mvc.TagHelpers
@{
    Layout = null;
    var initialToken = HttpContext.Request.Cookies[".Snakk.Auth"] ?? string.Empty;
    var initialRefreshToken = HttpContext.Request.Cookies[".Snakk.Auth.Refresh"] ?? string.Empty;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Snakk Admin</title>
    <base href="/admin/" />

    <!-- MudBlazor CSS -->
    <link href="_content/MudBlazor/MudBlazor.min.css" rel="stylesheet" />
    <link href="css/admin.css" rel="stylesheet" />
    <link href="Snakk.Admin.styles.css" rel="stylesheet" />
</head>
<body>
    <component type="typeof(App)" render-mode="ServerPrerendered" param-InitialToken="@initialToken" param-InitialRefreshToken="@initialRefreshToken" />

    <div id="blazor-error-ui">
        <environment include="Staging,Production">
            An error has occurred. This application may no longer respond until reloaded.
        </environment>
        <environment include="Development">
            An unhandled exception has occurred. See browser dev tools for details.
        </environment>
        <a href="" class="reload">Reload</a>
        <a class="dismiss">🗙</a>
    </div>

    <script src="_framework/blazor.server.js"></script>
    <script src="_content/MudBlazor/MudBlazor.min.js"></script>
    <script src="js/vendor/markdown-editor.js"></script>
    <script src="js/admin-editor.js"></script>
</body>
</html>
