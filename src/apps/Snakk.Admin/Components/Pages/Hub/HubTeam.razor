@page "/c/{CSlug}/h/{HSlug}/team"
@layout Layout.ScopedLayout
@inject ManageService.ManageServiceClient ManageClient
@inject ISnackbar Snackbar
@inject AdminTimezoneService Tz

<PageTitle>Team — Snakk Admin</PageTitle>

@if (Scope is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">Team</MudText>
    <MudText Class="mud-text-secondary mb-6">Moderators for @Scope.HubName.</MudText>

    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" GutterBottom="true">Add Moderator</MudText>
        <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
            <MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@AddMember"
                       Disabled="@string.IsNullOrWhiteSpace(_username)">Add HubMod</MudButton>
        </MudStack>
    </MudPaper>

    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudPaper>
            <MudTable Items="@_team" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>User</MudTh><MudTh>Role</MudTh><MudTh>Assigned</MudTh><MudTh>Source</MudTh><MudTh></MudTh>
                </HeaderContent>
                <NoRecordsContent><MudText Class="pa-4 mud-text-secondary">No moderators.</MudText></NoRecordsContent>
                <RowTemplate Context="m">
                    <MudTd>@m.DisplayName</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small">@m.Role</MudChip></MudTd>
                    <MudTd>@m.AssignedAt</MudTd>
                    <MudTd>@(m.IsInherited ? "Inherited" : "")</MudTd>
                    <MudTd>
                        @if (!m.IsInherited)
                        {
                            <MudIconButton Icon="@Icons.Material.Filled.PersonRemove" Color="Color.Error"
                                           Size="Size.Small" OnClick="@(() => Remove(m))" />
                        }
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string CSlug { get; set; } = "";
    [Parameter] public string HSlug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private string _username = "";
    private List<TeamRow> _team = [];

    private class TeamRow { public string UserPublicId { get; set; } = ""; public string DisplayName { get; set; } = ""; public string Role { get; set; } = ""; public string AssignedAt { get; set; } = ""; public bool IsInherited { get; set; } }

    protected override async Task OnParametersSetAsync()
    {
        if (Scope is null) return;
        _loading = true;
        try
        {
            var r = await ManageClient.GetTeamAsync(new Snakk.Protos.Manage.GetTeamRequest { ScopePublicId = Scope.ScopePublicId, ScopeType = Scope.ScopeType });
            _team = r.Members.Select(m => new TeamRow { UserPublicId = m.RolePublicId, DisplayName = m.UserDisplayName, Role = m.RoleType, AssignedAt = Tz.FormatDateTime(m.AssignedAtTicks), IsInherited = false }).ToList();
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task AddMember()
    {
        try
        {
            await ManageClient.AddTeamMemberAsync(new Snakk.Protos.Manage.AddTeamMemberRequest { ScopePublicId = Scope!.ScopePublicId, ScopeType = Scope.ScopeType, TargetUsername = _username, RoleType = "HubMod" });
            Snackbar.Add($"{_username} added as HubMod.", Severity.Success);
            _username = "";
            await OnParametersSetAsync();
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Remove(TeamRow m)
    {
        try
        {
            await ManageClient.RemoveTeamMemberAsync(new Snakk.Protos.Manage.RemoveTeamMemberRequest { RolePublicId = m.UserPublicId });
            _team.Remove(m);
            Snackbar.Add($"{m.DisplayName} removed.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
