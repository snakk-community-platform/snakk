@page "/c/{Slug}/hubs"
@layout Layout.ScopedLayout
@inject HubService.HubServiceClient HubClient
@inject ISnackbar Snackbar

<PageTitle>Hubs — Snakk Admin</PageTitle>

@if (Scope is null)
{
    <MudProgressLinear Indeterminate="true" />
}
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">Hubs</MudText>
            <MudText Class="mud-text-secondary">Hubs in @Scope.CommunityName.</MudText>
        </div>
    </MudStack>

    @if (_loading)
    {
        <MudProgressLinear Indeterminate="true" />
    }
    else
    {
        <MudPaper>
            <MudTable Items="@_hubs" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Name</MudTh>
                    <MudTh>Slug</MudTh>
                    <MudTh>Spaces</MudTh>
                    <MudTh>Discussions</MudTh>
                    <MudTh></MudTh>
                </HeaderContent>
                <NoRecordsContent>
                    <MudText Class="pa-4 mud-text-secondary">No hubs yet.</MudText>
                </NoRecordsContent>
                <RowTemplate Context="hub">
                    <MudTd>@hub.Name</MudTd>
                    <MudTd><MudText Typo="Typo.body2" Class="mud-text-secondary">@hub.Slug</MudText></MudTd>
                    <MudTd>@hub.SpaceCount</MudTd>
                    <MudTd>@hub.DiscussionCount</MudTd>
                    <MudTd>
                        <MudButton Href="@($"c/{Scope.CommunitySlug}/h/{hub.Slug}")" Variant="Variant.Text" Color="Color.Primary" Size="Size.Small">
                            Manage
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private List<HubInfo> _hubs = [];
    private bool _loading = true;

    protected override async Task OnParametersSetAsync()
    {
        if (Scope is null) return;
        _loading = true;
        try
        {
            var result = await HubClient.ListHubsByCommunityAsync(
                new ListHubsByCommunityRequest { CommunityId = Scope.ScopePublicId, Offset = 0, PageSize = 100 });
            _hubs = [.. result.Items];
        }
        catch (Exception ex) { Snackbar.Add($"Failed to load hubs: {ex.Message}", Severity.Error); }
        finally { _loading = false; }
    }
}
