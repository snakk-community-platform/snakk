@page "/c/{Slug}/report-reasons"
@layout Layout.ScopedLayout
@inject ManageService.ManageServiceClient ManageClient
@inject ISnackbar Snackbar

<PageTitle>Report Reasons — Snakk Admin</PageTitle>

@if (Scope is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">Report Reasons</MudText>
    <MudText Class="mud-text-secondary mb-6">Reasons users can select when reporting content in @Scope.CommunityName.</MudText>

    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                <MudTextField @bind-Value="_newReason" Label="New reason" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@AddReason"
                           Disabled="@string.IsNullOrWhiteSpace(_newReason)">Add</MudButton>
            </MudStack>
        </MudPaper>

        <MudPaper>
            <MudList T="string" Dense="true">
                @foreach (var r in _inherited)
                {
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText>@r</MudText>
                            <MudChip T="string" Size="Size.Small" Color="Color.Default">Inherited</MudChip>
                        </MudStack>
                    </MudListItem>
                    <MudDivider />
                }
                @for (var i = 0; i < _reasons.Count; i++)
                {
                    var reason = _reasons[i];
                    var idx = i;
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText>@reason</MudText>
                            <MudStack Row="true" Spacing="0">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small"
                                               Disabled="@(idx == 0)" OnClick="@(() => { (_reasons[idx], _reasons[idx-1]) = (_reasons[idx-1], _reasons[idx]); })" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small"
                                               Disabled="@(idx == _reasons.Count - 1)" OnClick="@(() => { (_reasons[idx], _reasons[idx+1]) = (_reasons[idx+1], _reasons[idx]); })" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                               Size="Size.Small" OnClick="@(() => _reasons.RemoveAt(idx))" />
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                    <MudDivider />
                }
                @if (_reasons.Count == 0 && _inherited.Count == 0)
                {
                    <MudListItem><MudText Class="mud-text-secondary">No report reasons yet.</MudText></MudListItem>
                }
            </MudList>
        </MudPaper>

        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="@Save" Disabled="@_saving">
            @(_saving ? "Saving..." : "Save")
        </MudButton>
    }
}

@code {
    [Parameter] public string Slug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string _newReason = "";
    private List<string> _reasons = [];
    private List<string> _inherited = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Scope is null) return;
        _loading = true;
        try
        {
            var resp = await ManageClient.GetReportReasonsAsync(
                new Snakk.Protos.Manage.GetReportReasonsRequest { ScopePublicId = Scope.ScopePublicId, ScopeType = Scope.ScopeType });
            _reasons = resp.Reasons.Select(r => r.Name).ToList();
            _inherited = resp.InheritedGroups.SelectMany(g => g.Reasons).Select(r => r.Name).ToList();
        }
        catch { }
        finally { _loading = false; }
    }

    private void AddReason() { _reasons.Add(_newReason.Trim()); _newReason = ""; }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var req = new Snakk.Protos.Manage.UpdateReportReasonsRequest { ScopePublicId = Scope!.ScopePublicId, ScopeType = Scope.ScopeType };
            req.Reasons.AddRange(_reasons.Select(r => new Snakk.Protos.Manage.ReportReasonItem { Name = r }));
            await ManageClient.UpdateReportReasonsAsync(req);
            Snackbar.Add("Report reasons saved.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }
}
