@page "/platform/settings"
@attribute [Authorize(Roles = "GlobalAdmin")]
@using Snakk.Protos.Manage
@using System.Net.Http.Headers
@using System.Text.Json
@inject ManageService.ManageServiceClient ManageClient
@inject IHttpClientFactory HttpClientFactory
@inject CircuitTokenProvider TokenProvider
<PageTitle>Platform Settings - Snakk Admin</PageTitle>

<MudStack Spacing="6">
    <MudStack Spacing="2">
        <MudText Typo="Typo.h4">Platform Settings</MudText>
        <MudText Typo="Typo.body1">Global site-wide configuration</MudText>
    </MudStack>

    <MudPaper Class="pa-4" Style="max-width: 600px;">
        @if (_loading)
        {
            <MudProgressCircular Indeterminate="true" />
        }
        else if (_loadError is not null)
        {
            <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
        }
        else
        {
            <MudStack Spacing="4">
                <MudTextField @bind-Value="_siteName" Label="Site Name" />
                <MudTextField @bind-Value="_siteDescription" Label="Site Description" Lines="3" />

                <MudSelect @bind-Value="_timezone" T="string" Label="Default Timezone"
                           HelperText="Fallback timezone for users who have not set a personal preference">
                    <MudSelectItem Value="@("UTC")">UTC</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---americas")">─── Americas ───</MudSelectItem>
                    <MudSelectItem Value="@("America/New_York")">Eastern Time (New York)</MudSelectItem>
                    <MudSelectItem Value="@("America/Chicago")">Central Time (Chicago)</MudSelectItem>
                    <MudSelectItem Value="@("America/Denver")">Mountain Time (Denver)</MudSelectItem>
                    <MudSelectItem Value="@("America/Los_Angeles")">Pacific Time (Los Angeles)</MudSelectItem>
                    <MudSelectItem Value="@("America/Anchorage")">Alaska Time (Anchorage)</MudSelectItem>
                    <MudSelectItem Value="@("Pacific/Honolulu")">Hawaii (Honolulu)</MudSelectItem>
                    <MudSelectItem Value="@("America/Toronto")">Eastern Time (Toronto)</MudSelectItem>
                    <MudSelectItem Value="@("America/Vancouver")">Pacific Time (Vancouver)</MudSelectItem>
                    <MudSelectItem Value="@("America/Sao_Paulo")">Brasília (São Paulo)</MudSelectItem>
                    <MudSelectItem Value="@("America/Argentina/Buenos_Aires")">Argentina (Buenos Aires)</MudSelectItem>
                    <MudSelectItem Value="@("America/Mexico_City")">Central Time (Mexico City)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---europe")">─── Europe ───</MudSelectItem>
                    <MudSelectItem Value="@("Europe/London")">GMT/BST (London)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Paris")">CET (Paris, Berlin, Rome)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Helsinki")">EET (Helsinki, Kyiv)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Moscow")">Moscow Time</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Oslo")">CET (Oslo, Stockholm, Copenhagen)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---asia")">─── Asia &amp; Pacific ───</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Dubai")">GST (Dubai)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Kolkata")">IST (India)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Bangkok")">ICT (Bangkok, Jakarta)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Singapore")">SGT (Singapore, Kuala Lumpur)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Shanghai")">CST (China, Hong Kong)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Tokyo")">JST (Tokyo)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Seoul")">KST (Seoul)</MudSelectItem>
                    <MudSelectItem Value="@("Australia/Sydney")">AEDT (Sydney)</MudSelectItem>
                    <MudSelectItem Value="@("Pacific/Auckland")">NZDT (Auckland)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---africa")">─── Africa ───</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Johannesburg")">SAST (Johannesburg)</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Cairo")">EET (Cairo)</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Lagos")">WAT (Lagos)</MudSelectItem>
                </MudSelect>

                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1">Registration</MudText>

                <MudSelect @bind-Value="_registrationMode" T="string" Label="Registration Mode">
                    <MudSelectItem Value="@("Open")">Open — anyone can register</MudSelectItem>
                    <MudSelectItem Value="@("InviteOnly")">Invite Only — require invite code</MudSelectItem>
                    <MudSelectItem Value="@("Closed")">Closed — no new registrations</MudSelectItem>
                </MudSelect>

                @if (_registrationMode == "InviteOnly")
                {
                    <MudTextField @bind-Value="_inviteCode" Label="Invite Code"
                                  HelperText="Share this code with users you want to invite. It is never shown publicly."
                                  InputType="@(_showInviteCode ? InputType.Text : InputType.Password)"
                                  Adornment="Adornment.End"
                                  AdornmentIcon="@(_showInviteCode ? Icons.Material.Filled.VisibilityOff : Icons.Material.Filled.Visibility)"
                                  OnAdornmentClick="@(() => _showInviteCode = !_showInviteCode)" />
                }

                <MudDivider Class="my-2" />
                <MudText Typo="Typo.subtitle1">Display Name — Allowed Writing Systems</MudText>
                <MudText Typo="Typo.body2" Class="text-secondary">
                    Which writing systems users may use in their display names.
                    Names must use a single system — mixing is blocked to prevent impersonation attacks.
                </MudText>

                @foreach (var script in _allScripts)
                {
                    <MudCheckBox T="bool"
                                 Value="@_allowedScripts.Contains(script.Key)"
                                 ValueChanged="@(v => ToggleScript(script.Key, v))"
                                 Label="@($"{script.Key} — {script.Value}")" />
                }

                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveSettings"
                           Disabled="@_saving">
                    @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                    Save Settings
                </MudButton>

                @if (_saved)
                {
                    <MudAlert Severity="Severity.Success">Platform settings saved</MudAlert>
                }
                @if (_saveError is not null)
                {
                    <MudAlert Severity="Severity.Error">@_saveError</MudAlert>
                }
            </MudStack>
        }
    </MudPaper>
</MudStack>

@code {
    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string _siteName = "";
    private string _siteDescription = "";
    private string _timezone = "UTC";
    private string _registrationMode = "Open";
    private string _inviteCode = "";
    private bool _showInviteCode;
    private string? _loadError;
    private string? _saveError;

    private HashSet<string> _allowedScripts = ["Latin"];

    // Full content settings stored for round-tripping on save (avoids overwriting other fields)
    private int _postMaxLength = 50000;
    private int _discussionTitleMaxLength = 300;
    private bool _allowMarkdown = true;
    private bool _allowHtml = false;
    private bool _requireModeration = false;

    private static readonly IReadOnlyDictionary<string, string> _allScripts =
        new Dictionary<string, string>
        {
            ["Latin"]      = "A–Z, a–z, æ ø å é ü ñ",
            ["Cyrillic"]   = "А Б В а б в (Ru/Ua/Bg)",
            ["Greek"]      = "Α Β Γ α β γ",
            ["Arabic"]     = "ا ب ت ث",
            ["Hebrew"]     = "א ב ג ד",
            ["Devanagari"] = "क ख ग घ (Hi)",
            ["CjkUnified"] = "一 二 三 中",
            ["Hiragana"]   = "あ い う え お",
            ["Katakana"]   = "ア イ ウ エ オ",
            ["Hangul"]     = "가 나 다 라",
            ["Thai"]       = "ก ข ค ง",
            ["Armenian"]   = "Ա Բ Գ Դ",
            ["Georgian"]   = "ა ბ გ დ",
        };

    private void ToggleScript(string script, bool enabled)
    {
        if (enabled) _allowedScripts.Add(script);
        else _allowedScripts.Remove(script);
        if (_allowedScripts.Count == 0) _allowedScripts.Add("Latin");
    }

    protected override async Task OnInitializedAsync()
    {
        try
        {
            var siteResponse = await ManageClient.GetSiteSettingsAsync(new GetSiteSettingsRequest());
            _siteName = siteResponse.SiteName;
            _siteDescription = siteResponse.HasSiteDescription ? siteResponse.SiteDescription : "";
            _timezone = string.IsNullOrEmpty(siteResponse.Timezone) ? "UTC" : siteResponse.Timezone;

            var regResponse = await ManageClient.GetRegistrationSettingsAsync(new GetRegistrationSettingsRequest());
            _registrationMode = string.IsNullOrEmpty(regResponse.Mode) ? "Open" : regResponse.Mode;
            _inviteCode = regResponse.InviteCode;

            // Load content settings (scripts + other fields for round-tripping) via REST
            var client = HttpClientFactory.CreateClient("SnakkApi");
            using var req = new HttpRequestMessage(HttpMethod.Get, "/admin/settings/content");
            var token = TokenProvider.Token;
            if (!string.IsNullOrEmpty(token))
                req.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            var resp = await client.SendAsync(req);
            if (resp.IsSuccessStatusCode)
            {
                var json = await resp.Content.ReadAsStringAsync();
                using var doc = JsonDocument.Parse(json);
                var root = doc.RootElement;

                if (root.TryGetProperty("postMaxLength", out var p)) _postMaxLength = p.GetInt32();
                if (root.TryGetProperty("discussionTitleMaxLength", out var d)) _discussionTitleMaxLength = d.GetInt32();
                if (root.TryGetProperty("allowMarkdown", out var md)) _allowMarkdown = md.GetBoolean();
                if (root.TryGetProperty("allowHtml", out var html)) _allowHtml = html.GetBoolean();
                if (root.TryGetProperty("requireModeration", out var mod)) _requireModeration = mod.GetBoolean();

                if (root.TryGetProperty("allowedDisplayNameScripts", out var scriptsProp)
                    && scriptsProp.ValueKind == JsonValueKind.Array)
                {
                    _allowedScripts = [.. scriptsProp.EnumerateArray()
                        .Select(e => e.GetString())
                        .Where(s => s is not null)
                        .Select(s => s!)];
                    if (_allowedScripts.Count == 0) _allowedScripts = ["Latin"];
                }
            }
        }
        catch
        {
            _loadError = "Failed to load platform settings.";
        }
        finally
        {
            _loading = false;
        }
    }

    private async Task SaveSettings()
    {
        _saving = true;
        _saved = false;
        _saveError = null;

        try
        {
            var siteRequest = new UpdateSiteSettingsRequest
            {
                SiteName = _siteName,
                SiteDescription = string.IsNullOrWhiteSpace(_siteDescription) ? null : _siteDescription,
                Timezone = string.IsNullOrWhiteSpace(_timezone) ? "UTC" : _timezone
            };

            var siteResponse = await ManageClient.UpdateSiteSettingsAsync(siteRequest);
            if (!siteResponse.Success)
            {
                _saveError = siteResponse.HasErrorMessage ? siteResponse.ErrorMessage : "Failed to save settings. Please try again.";
                return;
            }

            var regRequest = new UpdateRegistrationSettingsRequest
            {
                Mode = _registrationMode,
                InviteCode = _inviteCode ?? ""
            };

            var regResponse = await ManageClient.UpdateRegistrationSettingsAsync(regRequest);
            if (!regResponse.Success)
            {
                _saveError = regResponse.HasErrorMessage ? regResponse.ErrorMessage : "Failed to save registration settings.";
                return;
            }

            // Save content settings via REST (round-trip all fields to avoid overwriting with defaults)
            var scripts = _allowedScripts.Count > 0 ? _allowedScripts : new HashSet<string> { "Latin" };
            var contentPayload = JsonSerializer.Serialize(new
            {
                postMaxLength = _postMaxLength,
                discussionTitleMaxLength = _discussionTitleMaxLength,
                allowMarkdown = _allowMarkdown,
                allowHtml = _allowHtml,
                requireModeration = _requireModeration,
                allowedDisplayNameScripts = scripts.ToArray()
            });
            var client = HttpClientFactory.CreateClient("SnakkApi");
            using var contentReq = new HttpRequestMessage(HttpMethod.Put, "/admin/settings/content");
            var token = TokenProvider.Token;
            if (!string.IsNullOrEmpty(token))
                contentReq.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);
            contentReq.Content = new StringContent(contentPayload, System.Text.Encoding.UTF8, "application/json");
            var contentResp = await client.SendAsync(contentReq);
            if (contentResp.IsSuccessStatusCode)
                _saved = true;
            else
                _saveError = "Failed to save display name script settings.";
        }
        catch
        {
            _saveError = "Failed to save settings. Please try again.";
        }
        finally
        {
            _saving = false;
        }
    }
}
