@page "/c/{CSlug}/h/{HSlug}/{SSlug}/access"
@layout Layout.ScopedLayout
@inject ManageService.ManageServiceClient ManageClient
@inject ISnackbar Snackbar

<PageTitle>Access Control — Snakk Admin</PageTitle>

@if (Scope is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">Access Control</MudText>
    <MudText Class="mud-text-secondary mb-6">Restrict @Scope.SpaceName and set group access.</MudText>

    <MudPaper Class="pa-6 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
            <div>
                <MudText Typo="Typo.h6">Restricted Mode</MudText>
                <MudText Typo="Typo.body2" Class="mud-text-secondary">Only users in approved groups can access this space.</MudText>
            </div>
            <MudSwitch @bind-Value="_restricted" Color="Color.Primary" />
        </MudStack>
    </MudPaper>

    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudPaper>
            <MudTable Items="@_grants" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Group</MudTh><MudTh>Access Level</MudTh><MudTh></MudTh>
                </HeaderContent>
                <NoRecordsContent><MudText Class="pa-4 mud-text-secondary">No groups found.</MudText></NoRecordsContent>
                <RowTemplate Context="g">
                    <MudTd>@g.GroupName</MudTd>
                    <MudTd>
                        <MudSelect Value="@g.AccessLevel" ValueChanged="@((string v) => g.AccessLevel = v)" Variant="Variant.Outlined" Margin="Margin.Dense" Dense="true">
                            <MudSelectItem Value="@("None")">None</MudSelectItem>
                            <MudSelectItem Value="@("Read")">Read</MudSelectItem>
                            <MudSelectItem Value="@("Author")">Author</MudSelectItem>
                            <MudSelectItem Value="@("Write")">Write</MudSelectItem>
                        </MudSelect>
                    </MudTd>
                    <MudTd><MudButton Variant="Variant.Outlined" Size="Size.Small" Color="Color.Primary" OnClick="@(() => Save(g))">Save</MudButton></MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string CSlug { get; set; } = "";
    [Parameter] public string HSlug { get; set; } = "";
    [Parameter] public string SSlug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private bool _restricted; private bool _loading = true;
    private List<GrantRow> _grants = [];
    private class GrantRow { public string GroupPublicId { get; set; } = ""; public string GroupName { get; set; } = ""; public string AccessLevel { get; set; } = "None"; }

    protected override async Task OnParametersSetAsync()
    {
        if (Scope is null) return;
        _loading = true;
        try
        {
            var a = await ManageClient.GetEntityAccessAsync(new Snakk.Protos.Manage.GetEntityAccessRequest { SpacePublicId = Scope.ScopePublicId });
            _restricted = a.IsRestricted;
            _grants = a.Grants.Select(g => new GrantRow { GroupPublicId = g.GroupPublicId, GroupName = g.GroupName, AccessLevel = LevelToString(g.AccessLevel) }).ToList();
        }
        catch { }
        finally { _loading = false; }
    }

    private static string LevelToString(int l) => l switch { 1 => "Read", 2 => "Author", 3 => "Write", _ => "None" };
    private static int LevelToInt(string s) => s switch { "Read" => 1, "Author" => 2, "Write" => 3, _ => 0 };

    private async Task Save(GrantRow g)
    {
        try { await ManageClient.UpsertGroupGrantAsync(new Snakk.Protos.Manage.UpsertGroupGrantRequest { SpacePublicId = Scope!.ScopePublicId, GroupPublicId = g.GroupPublicId, AccessLevel = LevelToInt(g.AccessLevel) }); Snackbar.Add($"{g.GroupName} updated.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
