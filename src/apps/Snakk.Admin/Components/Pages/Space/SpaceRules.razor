@page "/c/{CSlug}/h/{HSlug}/{SSlug}/rules"
@layout Layout.ScopedLayout
@inject ManageService.ManageServiceClient ManageClient
@inject ISnackbar Snackbar

<PageTitle>Rules — Snakk Admin</PageTitle>

@if (Scope is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">Rules</MudText>
    <MudText Class="mud-text-secondary mb-6">Space-specific rules for @Scope.SpaceName.</MudText>

    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        @if (_inherited.Count > 0)
        {
            <MudPaper Class="pa-4 mb-4">
                <MudText Typo="Typo.h6" GutterBottom="true">Inherited from Hub &amp; Community</MudText>
                @foreach (var r in _inherited) { <MudText Typo="Typo.body2" Class="mb-1 mud-text-secondary">• @r</MudText> }
            </MudPaper>
        }

        <MudPaper Class="pa-4 mb-4">
            <MudStack Row="true" Spacing="2" AlignItems="AlignItems.End">
                <MudTextField @bind-Value="_newTitle" Label="Title" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudTextField @bind-Value="_newDesc" Label="Description" Variant="Variant.Outlined" Margin="Margin.Dense" />
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Add" Disabled="@string.IsNullOrWhiteSpace(_newTitle)">Add</MudButton>
            </MudStack>
        </MudPaper>

        <MudPaper>
            <MudList T="string" Dense="true">
                @for (var i = 0; i < _rules.Count; i++)
                {
                    var r = _rules[i]; var idx = i;
                    <MudListItem>
                        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween">
                            <MudText><b>@r.Title</b></MudText>
                            <MudStack Row="true" Spacing="0">
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowUpward" Size="Size.Small" Disabled="@(idx==0)" OnClick="@(()=>{(_rules[idx],_rules[idx-1])=(_rules[idx-1],_rules[idx]);})" />
                                <MudIconButton Icon="@Icons.Material.Filled.ArrowDownward" Size="Size.Small" Disabled="@(idx==_rules.Count-1)" OnClick="@(()=>{(_rules[idx],_rules[idx+1])=(_rules[idx+1],_rules[idx]);})" />
                                <MudIconButton Icon="@Icons.Material.Filled.Delete" Color="Color.Error" Size="Size.Small" OnClick="@(()=>_rules.RemoveAt(idx))" />
                            </MudStack>
                        </MudStack>
                    </MudListItem>
                    <MudDivider />
                }
                @if (_rules.Count == 0) { <MudListItem><MudText Class="mud-text-secondary">No space-specific rules.</MudText></MudListItem> }
            </MudList>
        </MudPaper>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" Class="mt-4" OnClick="@Save" Disabled="@_saving">@(_saving?"Saving...":"Save")</MudButton>
    }
}

@code {
    [Parameter] public string CSlug { get; set; } = "";
    [Parameter] public string HSlug { get; set; } = "";
    [Parameter] public string SSlug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private bool _loading = true; private bool _saving;
    private string _newTitle = ""; private string _newDesc = "";
    private List<(string Title, string Description)> _rules = [];
    private List<string> _inherited = [];

    protected override async Task OnParametersSetAsync()
    {
        if (Scope is null) return;
        _loading = true;
        try
        {
            var r = await ManageClient.GetRulesAsync(new Snakk.Protos.Manage.GetRulesRequest { ScopePublicId = Scope.ScopePublicId, ScopeType = Scope.ScopeType });
            _rules = r.Rules.Select(x => (x.Title, x.Description)).ToList();
            _inherited = r.InheritedGroups.SelectMany(g => g.Rules).Select(x => x.Title).ToList();
        }
        catch { }
        finally { _loading = false; }
    }

    private void Add() { _rules.Add((_newTitle, _newDesc)); _newTitle = ""; _newDesc = ""; }

    private async Task Save()
    {
        _saving = true;
        try
        {
            var req = new Snakk.Protos.Manage.UpdateRulesRequest { ScopePublicId = Scope!.ScopePublicId, ScopeType = Scope.ScopeType };
            req.Rules.AddRange(_rules.Select(r => new Snakk.Protos.Manage.RuleItem { Title = r.Title, Description = r.Description }));
            await ManageClient.UpdateRulesAsync(req);
            Snackbar.Add("Rules saved.", Severity.Success);
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }
}
