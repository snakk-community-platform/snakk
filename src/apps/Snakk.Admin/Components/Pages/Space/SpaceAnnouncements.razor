@page "/c/{CSlug}/h/{HSlug}/{SSlug}/announcements"
@layout Layout.ScopedLayout
@inject ManageService.ManageServiceClient ManageClient
@inject ISnackbar Snackbar

<PageTitle>Announcements — Snakk Admin</PageTitle>

@if (Scope is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">Announcements</MudText>
    <MudText Class="mud-text-secondary mb-6">Create pinned announcement discussions in @Scope.SpaceName.</MudText>

    <MudPaper Class="pa-6">
        <MudText Typo="Typo.h6" GutterBottom="true">New Announcement</MudText>
        <MudTextField @bind-Value="_title" Label="Title" Variant="Variant.Outlined" Class="mb-4" FullWidth="true" />
        <MudPaper Class="pa-3 mb-4" Outlined="true">
            <MudText Typo="Typo.caption" Class="mud-text-secondary mb-2">Content (Markdown)</MudText>
            <MudTextField @bind-Value="_content" Variant="Variant.Text" Lines="8" FullWidth="true"
                          Placeholder="Write your announcement in Markdown..." />
        </MudPaper>
        <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@Create"
                   Disabled="@(string.IsNullOrWhiteSpace(_title) || string.IsNullOrWhiteSpace(_content) || _saving)">
            @(_saving ? "Publishing..." : "Publish Announcement")
        </MudButton>
    </MudPaper>
}

@code {
    [Parameter] public string CSlug { get; set; } = "";
    [Parameter] public string HSlug { get; set; } = "";
    [Parameter] public string SSlug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private string _title = "";
    private string _content = "";
    private bool _saving;

    private async Task Create()
    {
        _saving = true;
        try
        {
            var resp = await ManageClient.CreateAnnouncementDiscussionAsync(
                new Snakk.Protos.Manage.CreateAnnouncementDiscussionRequest
                {
                    SpacePublicId = Scope!.ScopePublicId,
                    Title = _title,
                    Content = _content
                });
            if (resp.Success)
            {
                Snackbar.Add("Announcement published.", Severity.Success);
                _title = "";
                _content = "";
            }
            else
            {
                Snackbar.Add(resp.HasErrorMessage ? resp.ErrorMessage : "Failed to publish.", Severity.Error);
            }
        }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
        finally { _saving = false; }
    }
}
