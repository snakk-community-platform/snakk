@page "/c/{CSlug}/h/{HSlug}/{SSlug}/bans"
@layout Layout.ScopedLayout
@inject ManageService.ManageServiceClient ManageClient
@inject ISnackbar Snackbar
@inject AdminTimezoneService Tz

<PageTitle>Bans — Snakk Admin</PageTitle>

@if (Scope is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudStack Row="true" AlignItems="AlignItems.Center" Class="mb-6" Justify="Justify.SpaceBetween">
        <div>
            <MudText Typo="Typo.h4" GutterBottom="true">Bans</MudText>
            <MudText Class="mud-text-secondary">Bans in @Scope.SpaceName.</MudText>
        </div>
        <MudButton Variant="Variant.Filled" Color="Color.Error" StartIcon="@Icons.Material.Filled.Block" OnClick="@(() => _showCreate = true)">Ban User</MudButton>
    </MudStack>

    @if (_showCreate)
    {
        <MudPaper Class="pa-4 mb-4">
            <MudText Typo="Typo.h6" GutterBottom="true">Create Ban</MudText>
            <MudGrid>
                <MudItem xs="12" md="4"><MudTextField @bind-Value="_username" Label="Username" Variant="Variant.Outlined" Margin="Margin.Dense" /></MudItem>
                <MudItem xs="12" md="3"><MudSelect @bind-Value="_type" Label="Type" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("WriteOnly")">Write-Only</MudSelectItem><MudSelectItem Value="@("ReadWrite")">Full Ban</MudSelectItem></MudSelect></MudItem>
                <MudItem xs="12" md="3"><MudSelect @bind-Value="_duration" Label="Duration" Variant="Variant.Outlined" Margin="Margin.Dense"><MudSelectItem Value="@("1h")">1 Hour</MudSelectItem><MudSelectItem Value="@("24h")">24 Hours</MudSelectItem><MudSelectItem Value="@("7d")">7 Days</MudSelectItem><MudSelectItem Value="@("30d")">30 Days</MudSelectItem><MudSelectItem Value="@("permanent")">Permanent</MudSelectItem></MudSelect></MudItem>
                <MudItem xs="12"><MudTextField @bind-Value="_reason" Label="Reason" Variant="Variant.Outlined" Margin="Margin.Dense" FullWidth="true" /></MudItem>
            </MudGrid>
            <MudStack Row="true" Class="mt-3" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Error" OnClick="@CreateBan" Disabled="@string.IsNullOrWhiteSpace(_username)">Create Ban</MudButton>
                <MudButton Variant="Variant.Outlined" OnClick="@(() => _showCreate = false)">Cancel</MudButton>
            </MudStack>
        </MudPaper>
    }

    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudPaper>
            <MudTable Items="@_bans" Hover="true" Dense="true">
                <HeaderContent><MudTh>User</MudTh><MudTh>Type</MudTh><MudTh>Reason</MudTh><MudTh>Expires</MudTh><MudTh>Source</MudTh><MudTh></MudTh></HeaderContent>
                <NoRecordsContent><MudText Class="pa-4 mud-text-secondary">No bans.</MudText></NoRecordsContent>
                <RowTemplate Context="b">
                    <MudTd>@b.DisplayName</MudTd><MudTd>@b.BanType</MudTd><MudTd>@b.Reason</MudTd>
                    <MudTd>@(b.ExpiresAt ?? "Permanent")</MudTd>
                    <MudTd>@(b.IsInherited ? "Inherited" : "")</MudTd>
                    <MudTd>@if (!b.IsInherited) { <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => Revoke(b))">Revoke</MudButton> }</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string CSlug { get; set; } = "";
    [Parameter] public string HSlug { get; set; } = "";
    [Parameter] public string SSlug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private bool _loading = true; private bool _showCreate;
    private string _username = ""; private string _type = "WriteOnly"; private string _duration = "24h"; private string _reason = "";
    private List<BanRow> _bans = [];
    private class BanRow { public string BanPublicId { get; set; } = ""; public string DisplayName { get; set; } = ""; public string BanType { get; set; } = ""; public string Reason { get; set; } = ""; public string? ExpiresAt { get; set; } public bool IsInherited { get; set; } }

    protected override async Task OnParametersSetAsync()
    {
        if (Scope is null) return;
        _loading = true;
        try { var r = await ManageClient.GetBansAsync(new Snakk.Protos.Manage.GetBansRequest { ScopePublicId = Scope.ScopePublicId, ScopeType = Scope.ScopeType }); _bans = r.Bans.Select(b => new BanRow { BanPublicId = b.PublicId, DisplayName = b.UserDisplayName, BanType = b.BanType, Reason = b.Reason, ExpiresAt = b.HasExpiresAtTicks ? Tz.FormatDateTime(b.ExpiresAtTicks) : null, IsInherited = false }).ToList(); }
        catch { }
        finally { _loading = false; }
    }

    private async Task CreateBan()
    {
        try { var req = new Snakk.Protos.Manage.CreateBanRequest { ScopePublicId = Scope!.ScopePublicId, ScopeType = Scope.ScopeType, TargetUsername = _username, BanType = _type, Reason = _reason }; var exp = DurationToExpiresAt(_duration); if (exp.HasValue) req.ExpiresAtTicks = exp.Value; await ManageClient.CreateBanAsync(req); Snackbar.Add("Banned.", Severity.Success); _showCreate = false; _username = ""; await OnParametersSetAsync(); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private async Task Revoke(BanRow b)
    {
        try { await ManageClient.RevokeBanAsync(new Snakk.Protos.Manage.RevokeBanRequest { BanPublicId = b.BanPublicId }); _bans.Remove(b); Snackbar.Add("Revoked.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }

    private static long? DurationToExpiresAt(string d) => d switch {
        "1h" => DateTime.UtcNow.AddHours(1).Ticks,
        "24h" => DateTime.UtcNow.AddHours(24).Ticks,
        "7d" => DateTime.UtcNow.AddDays(7).Ticks,
        "30d" => DateTime.UtcNow.AddDays(30).Ticks,
        _ => null
    };
}
