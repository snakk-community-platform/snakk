@page "/c/{CSlug}/h/{HSlug}/{SSlug}/reports"
@layout Layout.ScopedLayout
@inject ManageService.ManageServiceClient ManageClient
@inject ISnackbar Snackbar
@inject AdminTimezoneService Tz

<PageTitle>Reports — Snakk Admin</PageTitle>

@if (Scope is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">Reports</MudText>
    <MudText Class="mud-text-secondary mb-6">Reports in @Scope.SpaceName.</MudText>

    <MudPaper Class="pa-3 mb-4">
        <MudStack Row="true" Spacing="1">
            @foreach (var f in new[] { "all", "pending", "resolved", "dismissed" })
            {
                <MudChip T="string" Color="@(_filter == f ? Color.Primary : Color.Default)" Variant="@(_filter == f ? Variant.Filled : Variant.Outlined)" OnClick="@(() => SetFilter(f))">@(char.ToUpper(f[0]) + f[1..])</MudChip>
            }
        </MudStack>
    </MudPaper>

    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudPaper>
            <MudTable Items="@_reports" Hover="true" Dense="true">
                <HeaderContent><MudTh>Target</MudTh><MudTh>Type</MudTh><MudTh>Reason</MudTh><MudTh>Submitted</MudTh><MudTh>Status</MudTh><MudTh></MudTh></HeaderContent>
                <NoRecordsContent><MudText Class="pa-4 mud-text-secondary">No reports.</MudText></NoRecordsContent>
                <RowTemplate Context="r">
                    <MudTd>@r.TargetTitle</MudTd><MudTd>@r.TargetType</MudTd><MudTd>@r.ReasonName</MudTd><MudTd>@r.SubmittedAt</MudTd>
                    <MudTd><MudChip T="string" Size="Size.Small" Color="@(r.Status=="Resolved"?Color.Success:r.Status=="Dismissed"?Color.Default:Color.Warning)">@r.Status</MudChip></MudTd>
                    <MudTd>@if (r.Status == "Pending") { <MudStack Row="true" Spacing="1"><MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Success" OnClick="@(() => Act(r,"Resolve"))">Resolve</MudButton><MudButton Size="Size.Small" Variant="Variant.Outlined" OnClick="@(() => Act(r,"Dismiss"))">Dismiss</MudButton></MudStack> }</MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string CSlug { get; set; } = "";
    [Parameter] public string HSlug { get; set; } = "";
    [Parameter] public string SSlug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private string _filter = "pending"; private bool _loading = true;
    private List<ReportRow> _reports = [];
    private class ReportRow { public string PublicId { get; set; } = ""; public string TargetTitle { get; set; } = ""; public string TargetType { get; set; } = ""; public string ReasonName { get; set; } = ""; public string SubmittedAt { get; set; } = ""; public string Status { get; set; } = ""; }

    private static int FilterToInt(string f) => f switch { "pending" => 1, "resolved" => 2, "dismissed" => 3, _ => 1 };

    private async Task SetFilter(string f) { _filter = f; await Load(); }
    protected override async Task OnParametersSetAsync() => await Load();

    private async Task Load()
    {
        if (Scope is null) return;
        _loading = true;
        try
        {
            var req = new Snakk.Protos.Manage.GetReportsRequest { ScopePublicId = Scope.ScopePublicId, ScopeType = Scope.ScopeType };
            if (_filter != "all") req.StatusFilter = FilterToInt(_filter);
            var r = await ManageClient.GetReportsAsync(req);
            _reports = r.Reports.Select(x => new ReportRow { PublicId = x.PublicId, TargetTitle = x.TargetTitle, TargetType = x.TargetType, ReasonName = x.ReasonName, SubmittedAt = Tz.FormatDateTime(x.CreatedAtTicks), Status = x.Status }).ToList();
        }
        catch { }
        finally { _loading = false; }
    }

    private async Task Act(ReportRow r, string action)
    {
        try { await ManageClient.ResolveReportAsync(new Snakk.Protos.Manage.ResolveReportRequest { ReportPublicId = r.PublicId, Dismiss = action == "Dismiss" }); r.Status = action == "Resolve" ? "Resolved" : "Dismissed"; Snackbar.Add($"{action}d.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
