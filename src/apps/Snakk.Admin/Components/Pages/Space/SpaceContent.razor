@page "/c/{CSlug}/h/{HSlug}/{SSlug}/content"
@layout Layout.ScopedLayout
@inject ManageService.ManageServiceClient ManageClient
@inject ISnackbar Snackbar

<PageTitle>Content Moderation — Snakk Admin</PageTitle>

@if (Scope is null) { <MudProgressLinear Indeterminate="true" /> }
else
{
    <MudText Typo="Typo.h4" GutterBottom="true">Content Moderation</MudText>
    <MudText Class="mud-text-secondary mb-6">Flagged content in @Scope.SpaceName.</MudText>

    @if (_loading) { <MudProgressLinear Indeterminate="true" /> }
    else
    {
        <MudPaper>
            <MudTable Items="@_items" Hover="true" Dense="true">
                <HeaderContent><MudTh>Type</MudTh><MudTh>Preview</MudTh><MudTh>Author</MudTh><MudTh>Reports</MudTh><MudTh></MudTh></HeaderContent>
                <NoRecordsContent><MudText Class="pa-4 mud-text-secondary">No flagged content.</MudText></NoRecordsContent>
                <RowTemplate Context="item">
                    <MudTd>@item.ContentType</MudTd>
                    <MudTd Style="max-width:300px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap;">@item.Preview</MudTd>
                    <MudTd>@item.AuthorName</MudTd><MudTd>@item.ReportCount</MudTd>
                    <MudTd>
                        <MudStack Row="true" Spacing="1">
                            @if (item.ContentType == "Discussion") { <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Warning" OnClick="@(() => Act(item,"Lock"))">Lock</MudButton> }
                            <MudButton Size="Size.Small" Variant="Variant.Outlined" Color="Color.Error" OnClick="@(() => Act(item,"Delete"))">Delete</MudButton>
                        </MudStack>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        </MudPaper>
    }
}

@code {
    [Parameter] public string CSlug { get; set; } = "";
    [Parameter] public string HSlug { get; set; } = "";
    [Parameter] public string SSlug { get; set; } = "";
    [CascadingParameter] public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private List<ContentRow> _items = [];
    private class ContentRow { public string PublicId { get; set; } = ""; public string ContentType { get; set; } = ""; public string Preview { get; set; } = ""; public string AuthorName { get; set; } = ""; public int ReportCount { get; set; } }

    protected override async Task OnParametersSetAsync()
    {
        if (Scope is null) return;
        _loading = true;
        try { var r = await ManageClient.GetFlaggedContentAsync(new Snakk.Protos.Manage.GetFlaggedContentRequest { ScopePublicId = Scope.ScopePublicId, ScopeType = Scope.ScopeType }); _items = r.Items.Select(i => new ContentRow { PublicId = i.PublicId, ContentType = i.ContentType, Preview = i.Preview, AuthorName = i.AuthorDisplayName, ReportCount = i.ReportCount }).ToList(); }
        catch { }
        finally { _loading = false; }
    }

    private async Task Act(ContentRow item, string action)
    {
        try { await ManageClient.ModerateContentAsync(new Snakk.Protos.Manage.ModerateContentRequest { TargetPublicId = item.PublicId, ContentType = item.ContentType, Action = action }); _items.Remove(item); Snackbar.Add($"{action} applied.", Severity.Success); }
        catch (Exception ex) { Snackbar.Add(ex.Message, Severity.Error); }
    }
}
