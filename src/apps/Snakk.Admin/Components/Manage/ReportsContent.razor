@using Snakk.Protos.Manage
@inject ManageService.ManageServiceClient ManageClient

<MudPaper Class="pa-4 d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Reports</MudText>
    <MudSelect Value="_statusFilter" T="string" Style="max-width: 180px;"
               ValueChanged="@(async (string v) => { _statusFilter = v; await OnFilterChanged(); })">
        <MudSelectItem Value="@("all")">All Status</MudSelectItem>
        <MudSelectItem Value="@("pending")">Pending</MudSelectItem>
        <MudSelectItem Value="@("resolved")">Resolved</MudSelectItem>
        <MudSelectItem Value="@("dismissed")">Dismissed</MudSelectItem>
    </MudSelect>
</MudPaper>

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_reports.Count == 0)
    {
        <MudText>No reports found for this scope.</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Striped="true">
            <thead>
                <tr><th>Type</th><th>Target</th><th>Reason</th><th>Reported By</th><th>Status</th><th>When</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var report in _reports)
                {
                    <tr>
                        <td>@report.TargetType</td>
                        <td>@report.TargetTitle</td>
                        <td>@report.ReasonName</td>
                        <td>@report.ReporterDisplayName</td>
                        <td>@report.Status</td>
                        <td>@(new DateTime(report.CreatedAtTicks, DateTimeKind.Utc).ToString("g"))</td>
                        <td>
                            @if (report.Status == "Pending")
                            {
                                <MudStack Row="true" Spacing="1">
                                    <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                               OnClick="@(() => HandleReport(report.PublicId, false))" Disabled="@_saving">
                                        Resolve
                                    </MudButton>
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               OnClick="@(() => HandleReport(report.PublicId, true))" Disabled="@_saving">
                                        Dismiss
                                    </MudButton>
                                </MudStack>
                            }
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private string _statusFilter = "all";
    private bool _loading = true;
    private bool _saving;
    private List<ReportItem> _reports = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        await LoadReports();
    }

    private async Task OnFilterChanged() => await LoadReports();

    private async Task LoadReports()
    {
        _loading = true;

        try
        {
            var request = new GetReportsRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId,
                Offset = 0,
                PageSize = 100
            };

            if (_statusFilter != "all")
            {
                request.StatusFilter = _statusFilter switch
                {
                    "pending" => 1,
                    "resolved" => 2,
                    "dismissed" => 3,
                    _ => 0
                };
            }

            var response = await ManageClient.GetReportsAsync(request, deadline: DateTime.UtcNow.AddSeconds(10));
            _reports = response.Reports.ToList();
        }
        catch
        {
            _reports = new();
        }

        _loading = false;
    }

    private async Task HandleReport(string reportPublicId, bool dismiss)
    {
        _saving = true;

        try
        {
            await ManageClient.ResolveReportAsync(new ResolveReportRequest
            {
                ReportPublicId = reportPublicId,
                Dismiss = dismiss
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            await LoadReports();
        }
        finally
        {
            _saving = false;
        }
    }
}
