@page "/c/{CommunitySlug}/rules"
@page "/c/{CommunitySlug}/h/{HubSlug}/rules"
@page "/c/{CommunitySlug}/h/{HubSlug}/s/{SpaceSlug}/rules"
@layout ManageLayout

<ManagePage CommunitySlug="@CommunitySlug" HubSlug="@HubSlug" SpaceSlug="@SpaceSlug">
    <RulesContent />
</ManagePage>

@code {
    [Parameter] public string CommunitySlug { get; set; } = "";
    [Parameter] public string? HubSlug { get; set; }
    [Parameter] public string? SpaceSlug { get; set; }
}
