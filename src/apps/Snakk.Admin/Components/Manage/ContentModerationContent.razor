@using Snakk.Protos.Manage
@inject ManageService.ManageServiceClient ManageClient

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">Content Moderation</MudText>
    <MudText>Review and moderate flagged content within this scope.</MudText>
</MudPaper>

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_items.Count == 0)
    {
        <MudText>No flagged content at this time.</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Striped="true">
            <thead>
                <tr><th>Type</th><th>Content Preview</th><th>Reports</th><th>Posted</th><th>Actions</th></tr>
            </thead>
            <tbody>
                @foreach (var item in _items)
                {
                    <tr>
                        <td>@item.ContentType</td>
                        <td>@item.Preview</td>
                        <td>@item.ReportCount</td>
                        <td>@(new DateTime(item.CreatedAtTicks, DateTimeKind.Utc).ToString("g"))</td>
                        <td>
                            <MudStack Row="true" Spacing="1">
                                <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                           OnClick="@(() => DeleteContent(item.PublicId, item.ContentType))" Disabled="@_saving">
                                    Delete
                                </MudButton>
                                @if (item.ContentType == "Discussion")
                                {
                                    <MudButton Size="Size.Small" Variant="Variant.Text"
                                               OnClick="@(() => LockDiscussion(item.PublicId))" Disabled="@_saving">
                                        Lock
                                    </MudButton>
                                }
                            </MudStack>
                        </td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private List<FlaggedContentItem> _items = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        await LoadContent();
    }

    private async Task LoadContent()
    {
        _loading = true;

        try
        {
            var response = await ManageClient.GetFlaggedContentAsync(new GetFlaggedContentRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId,
                Offset = 0,
                PageSize = 50
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            _items = response.Items.ToList();
        }
        catch
        {
            _items = new();
        }

        _loading = false;
    }

    private async Task DeleteContent(string publicId, string contentType)
    {
        _saving = true;

        try
        {
            await ManageClient.ModerateContentAsync(new ModerateContentRequest
            {
                TargetPublicId = publicId,
                ContentType = contentType,
                Action = "Delete"
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            await LoadContent();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task LockDiscussion(string publicId)
    {
        _saving = true;

        try
        {
            await ManageClient.ModerateContentAsync(new ModerateContentRequest
            {
                TargetPublicId = publicId,
                ContentType = "Discussion",
                Action = "Lock"
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            await LoadContent();
        }
        finally
        {
            _saving = false;
        }
    }
}
