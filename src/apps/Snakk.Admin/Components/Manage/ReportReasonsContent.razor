@using Snakk.Protos.Manage
@inject ManageService.ManageServiceClient ManageClient

<MudPaper Class="pa-4 d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">@(Scope?.ScopeType) Report Reasons</MudText>
        <MudText Typo="Typo.body2" Style="opacity: 0.7;">
            Report reasons bubble down the hierarchy: Global → Community → Hub → Space.
            Users see a combined list of all applicable reasons when reporting content.
        </MudText>
    </div>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => _showAdd = true)" Disabled="@_saving">
        Add Reason
    </MudButton>
</MudPaper>

@* Inherited reasons (read-only) *@
@foreach (var group in _inheritedGroups)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6">Inherited from @group.SourceScopeType: @group.SourceScopeName</MudText>
        <MudText Typo="Typo.body2" Style="opacity: 0.7;" Class="mb-2">
            These reasons are inherited from a parent scope and cannot be edited here.
        </MudText>
        @for (var i = 0; i < group.Reasons.Count; i++)
        {
            var reason = group.Reasons[i];
            <MudPaper Class="pa-3 mb-2" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudChip T="string" Size="Size.Small">@(i + 1)</MudChip>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">@reason.Name</MudText>
                        <MudText Typo="Typo.body2" Style="opacity: 0.7;">@reason.Description</MudText>
                    </MudStack>
                </MudStack>
            </MudPaper>
        }
    </MudPaper>
}

@* Add reason form *@
@if (_showAdd)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Add New Reason</MudText>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_newReasonName" Label="Reason Name" Placeholder="e.g., Off-topic" />
            <MudTextField @bind-Value="_newReasonDescription" Label="Description" Lines="2"
                          Placeholder="Describe when this reason should be used..." />
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@AddReason" Disabled="@_saving">Add</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => _showAdd = false)">Cancel</MudButton>
            </MudStack>
        </MudStack>
    </MudPaper>
}

@* Custom reasons for this scope *@
<MudPaper Class="pa-4">
    <MudText Typo="Typo.h6" Class="mb-2">Custom Reasons (This @Scope?.ScopeType)</MudText>

    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_reasons.Count == 0)
    {
        <MudText>No custom report reasons for this @Scope?.ScopeType?.ToLower() yet.</MudText>
    }
    else
    {
        @for (var i = 0; i < _reasons.Count; i++)
        {
            var reason = _reasons[i];
            var index = i;
            <MudPaper Class="pa-3 mb-2 d-flex justify-space-between align-center" Outlined="true">
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
                    <MudChip T="string" Size="Size.Small" Color="Color.Primary">@(index + 1)</MudChip>
                    <MudStack Spacing="0">
                        <MudText Typo="Typo.subtitle2">@reason.Name</MudText>
                        <MudText Typo="Typo.body2" Style="opacity: 0.7;">@reason.Description</MudText>
                    </MudStack>
                </MudStack>
                <MudStack Row="true" Spacing="1">
                    @if (index > 0)
                    {
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowUpward"
                                       OnClick="@(() => MoveUp(index))" Disabled="@_saving" />
                    }
                    @if (index < _reasons.Count - 1)
                    {
                        <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.ArrowDownward"
                                       OnClick="@(() => MoveDown(index))" Disabled="@_saving" />
                    }
                    <MudIconButton Size="Size.Small" Icon="@Icons.Material.Filled.Delete" Color="Color.Error"
                                   OnClick="@(() => DeleteReason(index))" Disabled="@_saving" />
                </MudStack>
            </MudPaper>
        }
    }
</MudPaper>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _showAdd;
    private string _newReasonName = "";
    private string _newReasonDescription = "";
    private List<ReportReasonItem> _reasons = new();
    private List<InheritedReportReasonGroup> _inheritedGroups = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        await LoadReasons();
    }

    private async Task LoadReasons()
    {
        _loading = true;

        try
        {
            var response = await ManageClient.GetReportReasonsAsync(new GetReportReasonsRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            _reasons = response.Reasons.ToList();
            _inheritedGroups = response.InheritedGroups.ToList();
        }
        catch
        {
            _reasons = new();
            _inheritedGroups = new();
        }

        _loading = false;
    }

    private async Task SaveReasons()
    {
        _saving = true;

        try
        {
            var request = new UpdateReportReasonsRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId
            };

            for (var i = 0; i < _reasons.Count; i++)
            {
                request.Reasons.Add(new ReportReasonItem
                {
                    Name = _reasons[i].Name,
                    Description = _reasons[i].Description,
                    DisplayOrder = i + 1
                });
            }

            await ManageClient.UpdateReportReasonsAsync(request, deadline: DateTime.UtcNow.AddSeconds(10));
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task AddReason()
    {
        if (string.IsNullOrWhiteSpace(_newReasonName)) return;

        _reasons.Add(new ReportReasonItem
        {
            Name = _newReasonName.Trim(),
            Description = _newReasonDescription.Trim(),
            DisplayOrder = _reasons.Count + 1
        });

        _showAdd = false;
        _newReasonName = "";
        _newReasonDescription = "";
        await SaveReasons();
    }

    private async Task MoveUp(int index)
    {
        if (index <= 0) return;
        (_reasons[index], _reasons[index - 1]) = (_reasons[index - 1], _reasons[index]);
        await SaveReasons();
    }

    private async Task MoveDown(int index)
    {
        if (index >= _reasons.Count - 1) return;
        (_reasons[index], _reasons[index + 1]) = (_reasons[index + 1], _reasons[index]);
        await SaveReasons();
    }

    private async Task DeleteReason(int index)
    {
        _reasons.RemoveAt(index);
        await SaveReasons();
    }
}
