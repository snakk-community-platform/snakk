@using Snakk.Protos.Manage
@inject ManageService.ManageServiceClient ManageClient

<MudPaper Class="pa-4 d-flex justify-space-between align-center mb-4">
    <div>
        <MudText Typo="Typo.h5">Access Control</MudText>
        <MudText Typo="Typo.body2" Style="opacity: 0.7;">
            Restrict access to this @(Scope?.ScopeType?.ToLower() ?? "entity") to specific user groups.
            When restricted, users must belong to an authorized group to read or write here.
        </MudText>
    </div>
</MudPaper>

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @* Restricted toggle *@
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Restriction</MudText>
        <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="3">
            <MudSwitch @bind-Value="_isRestricted" Color="Color.Warning" Label="Restrict access to authorized groups only"
                       Disabled="@_saving" />
            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveRestricted"
                       Disabled="@(_saving || _isRestricted == _savedIsRestricted)">
                Save
            </MudButton>
        </MudStack>
        @if (_isRestricted)
        {
            <MudAlert Severity="Severity.Warning" Class="mt-3" Dense="true">
                Access is restricted. Users not in an authorized group cannot read or write here.
                Moderators and admins bypass this restriction.
            </MudAlert>
        }
    </MudPaper>

    @* Group grants *@
    <MudPaper Class="pa-4 mb-4">
        <MudStack Row="true" AlignItems="AlignItems.Center" Justify="Justify.SpaceBetween" Class="mb-3">
            <MudText Typo="Typo.h6">Authorized Groups</MudText>
        </MudStack>

        @if (_allGroups.Count == 0)
        {
            <MudAlert Severity="Severity.Info" Dense="true">
                No groups exist for this community yet.
                <MudLink Href="@($"{BaseManageUrl}/groups")">Create groups first.</MudLink>
            </MudAlert>
        }
        else
        {
            <MudTable Items="@_allGroups" Hover="true" Dense="true">
                <HeaderContent>
                    <MudTh>Group</MudTh>
                    <MudTh Style="width: 180px;">Access Level</MudTh>
                    <MudTh Style="width: 120px;"></MudTh>
                </HeaderContent>
                <RowTemplate>
                    <MudTd>
                        <MudStack Spacing="0">
                            <MudText Typo="Typo.body1">@context.Name</MudText>
                            @if (!context.IsPublic)
                            {
                                <MudText Typo="Typo.caption" Style="opacity: 0.5;">Private</MudText>
                            }
                        </MudStack>
                    </MudTd>
                    <MudTd>
                        <MudSelect T="int" @bind-Value="@context.AccessLevel" Dense="true"
                                   Disabled="@_saving" Margin="Margin.Dense">
                            <MudSelectItem T="int" Value="0">None</MudSelectItem>
                            <MudSelectItem T="int" Value="1">Read</MudSelectItem>
                            <MudSelectItem T="int" Value="2">Author</MudSelectItem>
                            <MudSelectItem T="int" Value="3">Write</MudSelectItem>
                        </MudSelect>
                    </MudTd>
                    <MudTd>
                        <MudButton Size="Size.Small" Variant="Variant.Filled" Color="Color.Primary"
                                   OnClick="@(() => SaveGrant(context))" Disabled="@_saving">
                            Save
                        </MudButton>
                    </MudTd>
                </RowTemplate>
            </MudTable>
        }
    </MudPaper>

    @if (!string.IsNullOrEmpty(_errorMessage))
    {
        <MudText Color="Color.Error">@_errorMessage</MudText>
    }
}

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private string? _errorMessage;

    private bool _isRestricted;
    private bool _savedIsRestricted;

    private List<GroupGrantRow> _allGroups = [];

    private string BaseManageUrl => Scope != null ? ManageScopeService.GetManageUrl(Scope) : "";

    private class GroupGrantRow
    {
        public required string PublicId { get; init; }
        public required string Name { get; init; }
        public bool IsPublic { get; init; }
        public int AccessLevel { get; set; }
    }

    protected override async Task OnParametersSetAsync()
    {
        if (Scope is null) return;
        await LoadData();
    }

    private async Task LoadData()
    {
        _loading = true;
        _errorMessage = null;
        try
        {
            // Load community groups
            var groupsResponse = await ManageClient.GetCommunityGroupsAsync(
                new GetCommunityGroupsRequest { CommunityId = Scope!.CommunityPublicId },
                deadline: DateTime.UtcNow.AddSeconds(10));

            // Load current access config for this scope
            var accessRequest = BuildAccessRequest();
            var accessResponse = await ManageClient.GetEntityAccessAsync(
                accessRequest,
                deadline: DateTime.UtcNow.AddSeconds(10));

            _isRestricted = accessResponse.IsRestricted;
            _savedIsRestricted = accessResponse.IsRestricted;

            var grantsByGroupId = accessResponse.Grants
                .ToDictionary(g => g.GroupPublicId);

            _allGroups = groupsResponse.Groups.Select(g => new GroupGrantRow
            {
                PublicId = g.PublicId,
                Name = g.Name,
                IsPublic = g.IsPublic,
                AccessLevel = grantsByGroupId.TryGetValue(g.PublicId, out var grant) ? grant.AccessLevel : 0
            }).ToList();
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _loading = false;
        }
    }

    private GetEntityAccessRequest BuildAccessRequest() =>
        Scope!.ScopeType switch
        {
            "Space" => new GetEntityAccessRequest { SpacePublicId = Scope.ScopePublicId },
            "Hub" => new GetEntityAccessRequest { HubPublicId = Scope.ScopePublicId },
            _ => new GetEntityAccessRequest { CommunityPublicId = Scope!.ScopePublicId }
        };

    private async Task SaveRestricted()
    {
        _saving = true;
        _errorMessage = null;
        try
        {
            var request = Scope!.ScopeType switch
            {
                "Space" => new SetEntityRestrictedRequest { IsRestricted = _isRestricted, SpacePublicId = Scope.ScopePublicId },
                "Hub" => new SetEntityRestrictedRequest { IsRestricted = _isRestricted, HubPublicId = Scope.ScopePublicId },
                _ => new SetEntityRestrictedRequest { IsRestricted = _isRestricted, CommunityPublicId = Scope!.ScopePublicId }
            };
            await ManageClient.SetEntityRestrictedAsync(request, deadline: DateTime.UtcNow.AddSeconds(10));
            _savedIsRestricted = _isRestricted;
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task SaveGrant(GroupGrantRow row)
    {
        _saving = true;
        _errorMessage = null;
        try
        {
            if (row.AccessLevel == 0)
            {
                // None — remove the grant if it exists
                var deleteRequest = Scope!.ScopeType switch
                {
                    "Space" => new DeleteGroupGrantRequest { GroupPublicId = row.PublicId, SpacePublicId = Scope.ScopePublicId },
                    "Hub" => new DeleteGroupGrantRequest { GroupPublicId = row.PublicId, HubPublicId = Scope.ScopePublicId },
                    _ => new DeleteGroupGrantRequest { GroupPublicId = row.PublicId, CommunityPublicId = Scope!.ScopePublicId }
                };
                await ManageClient.DeleteGroupGrantAsync(deleteRequest, deadline: DateTime.UtcNow.AddSeconds(10));
            }
            else
            {
                var upsertRequest = Scope!.ScopeType switch
                {
                    "Space" => new Snakk.Protos.Manage.UpsertGroupGrantRequest { GroupPublicId = row.PublicId, AccessLevel = row.AccessLevel, SpacePublicId = Scope.ScopePublicId },
                    "Hub" => new Snakk.Protos.Manage.UpsertGroupGrantRequest { GroupPublicId = row.PublicId, AccessLevel = row.AccessLevel, HubPublicId = Scope.ScopePublicId },
                    _ => new Snakk.Protos.Manage.UpsertGroupGrantRequest { GroupPublicId = row.PublicId, AccessLevel = row.AccessLevel, CommunityPublicId = Scope!.ScopePublicId }
                };
                await ManageClient.UpsertGroupGrantAsync(upsertRequest, deadline: DateTime.UtcNow.AddSeconds(10));
            }
        }
        catch (Exception ex)
        {
            _errorMessage = ex.Message;
        }
        finally
        {
            _saving = false;
        }
    }
}
