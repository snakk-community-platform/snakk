@using Snakk.Shared.Helpers
@using Snakk.Protos.Manage
@using System.Net.Http.Headers
@inject ManageService.ManageServiceClient ManageClient
@inject IHttpClientFactory HttpClientFactory
@inject CircuitTokenProvider TokenProvider

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@Scope?.ScopeType Settings</MudText>
</MudPaper>

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else
    {
        <MudStack Spacing="4" Style="max-width: 600px;">

            @* --- Avatar Section --- *@
            <div>
                <MudText Typo="Typo.subtitle2" Class="mb-2">Avatar</MudText>
                <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="4">
                    <MudAvatar Size="Size.Large" Style="width: 80px; height: 80px;">
                        <MudImage Src="@_currentAvatarUrl" Alt="@($"{Scope?.ScopeName} avatar")"
                                  Width="80" Height="80" ObjectFit="ObjectFit.Cover" />
                    </MudAvatar>
                    <MudStack Spacing="2">
                        <MudFileUpload T="IBrowserFile"
                                       Accept=".jpg,.jpeg,.png,.webp"
                                       MaximumFileCount="1"
                                       OnFilesChanged="OnAvatarFileSelected">
                            <CustomContent>
                                <MudButton Variant="Variant.Outlined"
                                           Color="Color.Primary"
                                           StartIcon="@Icons.Material.Filled.CloudUpload"
                                           Disabled="@_avatarUploading"
                                           OnClick="@context.OpenFilePickerAsync">
                                    Choose Image
                                </MudButton>
                            </CustomContent>
                        </MudFileUpload>
                        @if (_selectedAvatarFile is not null)
                        {
                            <MudText Typo="Typo.caption">@_selectedAvatarFile.Name (@FormatFileSize(_selectedAvatarFile.Size))</MudText>
                        }
                        <MudStack Row="true" Spacing="2">
                            <MudButton Variant="Variant.Filled"
                                       Color="Color.Primary"
                                       OnClick="UploadAvatar"
                                       Disabled="@(_selectedAvatarFile is null || _avatarUploading)"
                                       Size="Size.Small">
                                @if (_avatarUploading)
                                {
                                    <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" />
                                }
                                Upload
                            </MudButton>
                            <MudButton Variant="Variant.Outlined"
                                       Color="Color.Default"
                                       OnClick="DeleteAvatar"
                                       Disabled="@(!_hasUploadedAvatar || _avatarUploading)"
                                       Size="Size.Small">
                                Use Generated
                            </MudButton>
                        </MudStack>
                    </MudStack>
                </MudStack>
                @if (_avatarSuccess is not null)
                {
                    <MudAlert Severity="Severity.Success" Class="mt-2">@_avatarSuccess</MudAlert>
                }
                @if (_avatarError is not null)
                {
                    <MudAlert Severity="Severity.Error" Class="mt-2">@_avatarError</MudAlert>
                }
            </div>

            <MudDivider Class="my-2" />

            <MudTextField @bind-Value="_name" Label="Name" />
            <MudTextField @bind-Value="_description" Label="Description" Lines="4" />

            @if (Scope?.ScopeType == "Community")
            {
                <MudSelect @bind-Value="_visibility" T="string" Label="Visibility">
                    <MudSelectItem Value="@("Public")">Public</MudSelectItem>
                    <MudSelectItem Value="@("Private")">Private</MudSelectItem>
                    <MudSelectItem Value="@("Unlisted")">Unlisted</MudSelectItem>
                </MudSelect>

                <MudSelect @bind-Value="_timezone" T="string" Label="Community Timezone"
                           HelperText="Controls how dates and times display for members of this community">
                    <MudSelectItem Value="@("UTC")">UTC</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---americas")">─── Americas ───</MudSelectItem>
                    <MudSelectItem Value="@("America/New_York")">Eastern Time (New York)</MudSelectItem>
                    <MudSelectItem Value="@("America/Chicago")">Central Time (Chicago)</MudSelectItem>
                    <MudSelectItem Value="@("America/Denver")">Mountain Time (Denver)</MudSelectItem>
                    <MudSelectItem Value="@("America/Los_Angeles")">Pacific Time (Los Angeles)</MudSelectItem>
                    <MudSelectItem Value="@("America/Anchorage")">Alaska Time (Anchorage)</MudSelectItem>
                    <MudSelectItem Value="@("Pacific/Honolulu")">Hawaii (Honolulu)</MudSelectItem>
                    <MudSelectItem Value="@("America/Toronto")">Eastern Time (Toronto)</MudSelectItem>
                    <MudSelectItem Value="@("America/Vancouver")">Pacific Time (Vancouver)</MudSelectItem>
                    <MudSelectItem Value="@("America/Sao_Paulo")">Brasília (São Paulo)</MudSelectItem>
                    <MudSelectItem Value="@("America/Argentina/Buenos_Aires")">Argentina (Buenos Aires)</MudSelectItem>
                    <MudSelectItem Value="@("America/Mexico_City")">Central Time (Mexico City)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---europe")">─── Europe ───</MudSelectItem>
                    <MudSelectItem Value="@("Europe/London")">GMT/BST (London)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Paris")">CET (Paris, Berlin, Rome)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Helsinki")">EET (Helsinki, Kyiv)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Moscow")">Moscow Time</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Oslo")">CET (Oslo, Stockholm, Copenhagen)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---asia")">─── Asia &amp; Pacific ───</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Dubai")">GST (Dubai)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Kolkata")">IST (India)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Bangkok")">ICT (Bangkok, Jakarta)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Singapore")">SGT (Singapore, Kuala Lumpur)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Shanghai")">CST (China, Hong Kong)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Tokyo")">JST (Tokyo)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Seoul")">KST (Seoul)</MudSelectItem>
                    <MudSelectItem Value="@("Australia/Sydney")">AEDT (Sydney)</MudSelectItem>
                    <MudSelectItem Value="@("Pacific/Auckland")">NZDT (Auckland)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---africa")">─── Africa ───</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Johannesburg")">SAST (Johannesburg)</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Cairo")">EET (Cairo)</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Lagos")">WAT (Lagos)</MudSelectItem>
                </MudSelect>
            }

            @if (Scope?.ScopeType is "Community" or "Hub" or "Space")
            {
                var langLabel = Scope.ScopeType == "Community" ? "Primary Language" : "Language Override";
                var langHelper = Scope.ScopeType == "Community"
                    ? "Default language for link previews and content. Hubs and spaces inherit this unless overridden."
                    : _inheritedLanguageCode is not null
                        ? $"Inherited: {Snakk.Shared.Models.SupportedLanguages.GetByCode(_inheritedLanguageCode)?.Name ?? _inheritedLanguageCode}"
                        : "Inherits from parent. Set to override.";

                <MudSelect @bind-Value="_languageCode" T="string" Label="@langLabel"
                           HelperText="@langHelper" Clearable="@(Scope.ScopeType != "Community")">
                    @if (Scope.ScopeType != "Community")
                    {
                        <MudSelectItem Value="@InheritLanguageValue">Inherit from parent</MudSelectItem>
                    }
                    @foreach (var lang in Snakk.Shared.Models.SupportedLanguages.All)
                    {
                        <MudSelectItem Value="@lang.Code">
                            <div class="d-flex align-center gap-2">
                                <img src="/flags/@(lang.FlagCode).svg" style="width:20px;height:15px" alt="" />
                                @lang.Name (@lang.NativeName)
                            </div>
                        </MudSelectItem>
                    }
                </MudSelect>
            }

            @if (Scope?.ScopeType == "Space")
            {
                <MudSelect @bind-Value="_defaultSort" T="string" Label="Default Sort">
                    <MudSelectItem Value="@("latest")">Latest Activity</MudSelectItem>
                    <MudSelectItem Value="@("newest")">Newest First</MudSelectItem>
                    <MudSelectItem Value="@("oldest")">Oldest First</MudSelectItem>
                </MudSelect>

                <MudSwitch @bind-Value="_autoParagraphEnabled"
                           T="bool"
                           Color="Color.Primary"
                           Label="Auto-paragraph walls of text"
                           LabelPlacement="Placement.End" />
                <MudText Typo="Typo.caption" Style="opacity: 0.7;">
                    When enabled, very long single-paragraph posts (&gt;500 chars and &gt;5 sentences)
                    are automatically broken into paragraphs on save. Users can override by typing
                    their own blank lines — explicit paragraph breaks are always preserved.
                </MudText>
            }

            @* Discussion type checkboxes — shown for Community, Hub, and Space *@
            @if (Scope?.ScopeType is "Community" or "Hub" or "Space")
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Allowed Discussion Types</MudText>
                    @if (Scope.ScopeType != "Community")
                    {
                        <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-2"
                                 Style="opacity: 0.6;">
                            Types disabled by the parent @(_parentScopeLabel) cannot be enabled here.
                        </MudText>
                    }
                    <MudStack Spacing="2">
                        @foreach (var type in Enum.GetValues<DiscussionTypeEnum>())
                        {
                            var t = type;
                            var blockedByParent = _parentAllowedTypes.Count > 0 && !_parentAllowedTypes.Contains(t);
                            <MudTooltip Text="@(blockedByParent ? $"Disabled by {_parentScopeLabel}" : "")"
                                        Disabled="@(!blockedByParent)">
                                <MudCheckBox T="bool"
                                    Value="@(_allowedTypes.Contains(t))"
                                    ValueChanged="@(v => ToggleType(t, v))"
                                    Label="@t.ToString()"
                                    Disabled="@blockedByParent" />
                            </MudTooltip>
                        }
                    </MudStack>
                    @if (_typeError is not null)
                    {
                        <MudText Color="Color.Error" Class="mt-1">@_typeError</MudText>
                    }
                </div>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveSettings"
                       Disabled="@_saving">
                @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Save Settings
            </MudButton>

            @if (_saved)
            {
                <MudAlert Severity="Severity.Success">Settings saved</MudAlert>
            }
            @if (_saveError is not null)
            {
                <MudAlert Severity="Severity.Error">@_saveError</MudAlert>
            }
        </MudStack>
    }
</MudPaper>

@code {
#nullable enable
    private static readonly string? InheritLanguageValue = null;

    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string _name = "";
    private string _description = "";
    private string _visibility = "Public";
    private string _defaultSort = "latest";
    private string _timezone = "UTC";
    private bool _autoParagraphEnabled = true;
    private string? _languageCode;
    private string? _inheritedLanguageCode;
    private HashSet<DiscussionTypeEnum> _allowedTypes = [DiscussionTypeEnum.Standard];
    private HashSet<DiscussionTypeEnum> _parentAllowedTypes = [];
    private string _parentScopeLabel = "";
    private string? _loadError;
    private string? _saveError;
    private string? _typeError;

    // Avatar state
    private string _currentAvatarUrl = "";
    private bool _hasUploadedAvatar;
    private IBrowserFile? _selectedAvatarFile;
    private bool _avatarUploading;
    private string? _avatarSuccess;
    private string? _avatarError;

    private const long MaxAvatarSize = 2 * 1024 * 1024; // 2 MB

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        _loading = true;
        _loadError = null;

        if (Scope.ScopeType == "Space")
        {
            try
            {
                var response = await ManageClient.GetSpaceSettingsAsync(
                    new GetSpaceSettingsRequest { SpacePublicId = Scope.ScopePublicId });

                _name = response.Name;
                _description = response.HasDescription ? response.Description : "";
                _languageCode = response.HasLanguageCode ? response.LanguageCode : null;
                _inheritedLanguageCode = response.HasHubLanguageCode ? response.HubLanguageCode
                    : response.HasCommunityLanguageCode ? response.CommunityLanguageCode : null;
                _autoParagraphEnabled = response.AutoParagraphEnabled;
                _allowedTypes = response.AllowedDiscussionTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.AllowedDiscussionTypes.Select(t => (DiscussionTypeEnum)t))
                    : new HashSet<DiscussionTypeEnum>(Enum.GetValues<DiscussionTypeEnum>());
                _parentAllowedTypes = response.ParentAllowedTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.ParentAllowedTypes.Select(t => (DiscussionTypeEnum)t))
                    : [];
                _parentScopeLabel = "hub";
            }
            catch
            {
                _loadError = "Failed to load space settings.";
            }
        }
        else if (Scope.ScopeType == "Hub")
        {
            try
            {
                var response = await ManageClient.GetHubSettingsAsync(
                    new GetHubSettingsRequest { HubPublicId = Scope.ScopePublicId });

                _name = response.Name;
                _description = response.HasDescription ? response.Description : "";
                _languageCode = response.HasLanguageCode ? response.LanguageCode : null;
                _inheritedLanguageCode = response.HasCommunityLanguageCode ? response.CommunityLanguageCode : null;
                _allowedTypes = response.AllowedDiscussionTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.AllowedDiscussionTypes.Select(t => (DiscussionTypeEnum)t))
                    : new HashSet<DiscussionTypeEnum>(Enum.GetValues<DiscussionTypeEnum>());
                _parentAllowedTypes = response.ParentAllowedTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.ParentAllowedTypes.Select(t => (DiscussionTypeEnum)t))
                    : [];
                _parentScopeLabel = "community";
            }
            catch
            {
                _loadError = "Failed to load hub settings.";
            }
        }
        else if (Scope.ScopeType == "Community")
        {
            try
            {
                var response = await ManageClient.GetCommunitySettingsAsync(
                    new GetCommunitySettingsRequest { CommunityPublicId = Scope.ScopePublicId });

                _name = response.Name;
                _description = response.HasDescription ? response.Description : "";
                _timezone = response.HasTimezone ? response.Timezone : "UTC";
                _languageCode = response.HasLanguageCode ? response.LanguageCode : null;
                _inheritedLanguageCode = null; // Community has no parent
                _allowedTypes = response.AllowedDiscussionTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.AllowedDiscussionTypes.Select(t => (DiscussionTypeEnum)t))
                    : new HashSet<DiscussionTypeEnum>(Enum.GetValues<DiscussionTypeEnum>());
                _parentAllowedTypes = []; // Community has no parent
                _parentScopeLabel = "";
            }
            catch
            {
                _loadError = "Failed to load community settings.";
            }
        }
        else
        {
            _name = Scope.ScopeName;
            _description = "";
        }

        // Set avatar URL
        _hasUploadedAvatar = !string.IsNullOrEmpty(Scope.ScopeAvatarUrl);
        _currentAvatarUrl = GetAvatarDisplayUrl();

        _loading = false;
    }

    private string GetAvatarDisplayUrl()
    {
        if (Scope is null) return "";

        // If scope has an avatar URL from the server, use it
        if (!string.IsNullOrEmpty(Scope.ScopeAvatarUrl))
            return Scope.ScopeAvatarUrl;

        // Fall back to generated SVG avatar
        var entityType = Scope.ScopeType switch
        {
            "Community" => AvatarEntityType.Community,
            "Hub" => AvatarEntityType.Hub,
            "Space" => AvatarEntityType.Space,
            _ => AvatarEntityType.Community
        };

        return AvatarHelper.GetAvatarUrl(Scope.ScopePublicId, entityType);
    }

    private void OnAvatarFileSelected(InputFileChangeEventArgs e)
    {
        _avatarSuccess = null;
        _avatarError = null;

        var file = e.File;

        if (file.Size > MaxAvatarSize)
        {
            _avatarError = "File too large. Maximum size is 2 MB.";
            _selectedAvatarFile = null;
            return;
        }

        var allowedTypes = new[] { "image/jpeg", "image/png", "image/webp" };
        if (!allowedTypes.Contains(file.ContentType.ToLowerInvariant()))
        {
            _avatarError = "Invalid file type. Allowed: JPEG, PNG, WebP.";
            _selectedAvatarFile = null;
            return;
        }

        _selectedAvatarFile = file;
    }

    private async Task UploadAvatar()
    {
        if (_selectedAvatarFile is null || Scope is null) return;

        _avatarUploading = true;
        _avatarSuccess = null;
        _avatarError = null;

        try
        {
            var entityType = Scope.ScopeType.ToLowerInvariant();
            var entityId = Scope.ScopePublicId;

            using var content = new MultipartFormDataContent();
            using var browserStream = _selectedAvatarFile.OpenReadStream(MaxAvatarSize);
            var memoryStream = new MemoryStream();
            await browserStream.CopyToAsync(memoryStream);
            memoryStream.Position = 0;
            var streamContent = new StreamContent(memoryStream);
            streamContent.Headers.ContentType = new MediaTypeHeaderValue(_selectedAvatarFile.ContentType);
            content.Add(streamContent, "avatar", _selectedAvatarFile.Name);

            var client = HttpClientFactory.CreateClient("SnakkApi");
            using var request = new HttpRequestMessage(HttpMethod.Post, $"/avatars/upload/{entityType}/{entityId}");

            var token = TokenProvider.Token;
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            request.Content = content;

            var response = await client.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadAsStringAsync();

                // Parse avatarUrl from the JSON response
                try
                {
                    var json = System.Text.Json.JsonDocument.Parse(body);
                    if (json.RootElement.TryGetProperty("avatarUrl", out var urlProp))
                    {
                        _currentAvatarUrl = urlProp.GetString() ?? GetAvatarDisplayUrl();
                        _hasUploadedAvatar = true;
                    }
                }
                catch
                {
                    _currentAvatarUrl = GetAvatarDisplayUrl();
                }

                _avatarSuccess = "Avatar uploaded successfully.";
                _selectedAvatarFile = null;
            }
            else
            {
                var errorBody = await response.Content.ReadAsStringAsync();
                try
                {
                    var json = System.Text.Json.JsonDocument.Parse(errorBody);
                    if (json.RootElement.TryGetProperty("error", out var errorProp))
                        _avatarError = errorProp.GetString() ?? "Upload failed.";
                    else
                        _avatarError = $"Upload failed (HTTP {(int)response.StatusCode}): {errorBody}";
                }
                catch
                {
                    _avatarError = $"Upload failed (HTTP {(int)response.StatusCode}): {errorBody}";
                }
            }
        }
        catch (Exception ex)
        {
            _avatarError = $"Upload failed: {ex.Message}";
        }
        finally
        {
            _avatarUploading = false;
        }
    }

    private async Task DeleteAvatar()
    {
        if (Scope is null) return;

        _avatarUploading = true;
        _avatarSuccess = null;
        _avatarError = null;

        try
        {
            var entityType = Scope.ScopeType.ToLowerInvariant();
            var entityId = Scope.ScopePublicId;

            var client = HttpClientFactory.CreateClient("SnakkApi");
            using var request = new HttpRequestMessage(HttpMethod.Delete, $"/avatars/{entityType}/{entityId}");

            var token = TokenProvider.Token;
            if (!string.IsNullOrEmpty(token))
                request.Headers.Authorization = new AuthenticationHeaderValue("Bearer", token);

            var response = await client.SendAsync(request);

            if (response.IsSuccessStatusCode)
            {
                _hasUploadedAvatar = false;
                _currentAvatarUrl = GetAvatarDisplayUrl();
                _avatarSuccess = "Avatar removed. Using generated avatar.";
                _selectedAvatarFile = null;
            }
            else
            {
                _avatarError = $"Failed to remove avatar (HTTP {(int)response.StatusCode}).";
            }
        }
        catch (Exception ex)
        {
            _avatarError = $"Failed to remove avatar: {ex.Message}";
        }
        finally
        {
            _avatarUploading = false;
        }
    }

    private static string FormatFileSize(long bytes) =>
        bytes switch
        {
            < 1024 => $"{bytes} B",
            < 1024 * 1024 => $"{bytes / 1024.0:F1} KB",
            _ => $"{bytes / (1024.0 * 1024.0):F1} MB"
        };

    private void ToggleType(DiscussionTypeEnum type, bool enabled)
    {
        _typeError = null;

        if (enabled)
        {
            _allowedTypes.Add(type);
        }
        else if (_allowedTypes.Count > 1)
        {
            _allowedTypes.Remove(type);
        }
        else
        {
            _typeError = "At least one discussion type must be enabled.";
        }
    }

    private async Task SaveSettings()
    {
        _saving = true;
        _saved = false;
        _saveError = null;

        if (Scope?.ScopeType == "Space")
        {
            try
            {
                var request = new Snakk.Protos.Manage.UpdateSpaceSettingsRequest
                {
                    SpacePublicId = Scope.ScopePublicId,
                    Name = _name,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                    LanguageCode = _languageCode ?? "",
                    AutoParagraphEnabled = _autoParagraphEnabled
                };

                request.AllowedDiscussionTypes.AddRange(_allowedTypes.Select(t => (int)t));

                var response = await ManageClient.UpdateSpaceSettingsAsync(request);

                if (response.Success)
                    _saved = true;
                else
                    _saveError = response.HasErrorMessage ? response.ErrorMessage : "Failed to save settings. Please try again.";
            }
            catch
            {
                _saveError = "Failed to save settings. Please try again.";
            }
        }
        else if (Scope?.ScopeType == "Hub")
        {
            try
            {
                var request = new Snakk.Protos.Manage.UpdateHubSettingsRequest
                {
                    HubPublicId = Scope.ScopePublicId,
                    Name = _name,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                    LanguageCode = _languageCode ?? ""
                };

                request.AllowedDiscussionTypes.AddRange(_allowedTypes.Select(t => (int)t));

                var response = await ManageClient.UpdateHubSettingsAsync(request);

                if (response.Success)
                    _saved = true;
                else
                    _saveError = response.HasErrorMessage ? response.ErrorMessage : "Failed to save settings. Please try again.";
            }
            catch
            {
                _saveError = "Failed to save settings. Please try again.";
            }
        }
        else if (Scope?.ScopeType == "Community")
        {
            try
            {
                var request = new Snakk.Protos.Manage.UpdateCommunitySettingsRequest
                {
                    CommunityPublicId = Scope.ScopePublicId,
                    Name = _name,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                    Timezone = string.IsNullOrWhiteSpace(_timezone) ? null : _timezone,
                    LanguageCode = _languageCode ?? ""
                };

                request.AllowedDiscussionTypes.AddRange(_allowedTypes.Select(t => (int)t));

                var response = await ManageClient.UpdateCommunitySettingsAsync(request);

                if (response.Success)
                    _saved = true;
                else
                    _saveError = response.HasErrorMessage ? response.ErrorMessage : "Failed to save settings. Please try again.";
            }
            catch
            {
                _saveError = "Failed to save settings. Please try again.";
            }
        }

        _saving = false;
    }
}
