@using Snakk.Application.DTOs.Management
@using Snakk.Shared.Enums
@using Snakk.Protos.Manage
@inject ManageService.ManageServiceClient ManageClient

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5">@Scope?.ScopeType Settings</MudText>
</MudPaper>

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_loadError is not null)
    {
        <MudAlert Severity="Severity.Error">@_loadError</MudAlert>
    }
    else
    {
        <MudStack Spacing="4" Style="max-width: 600px;">
            <MudTextField @bind-Value="_name" Label="Name" />
            <MudTextField @bind-Value="_description" Label="Description" Lines="4" />

            @if (Scope?.ScopeType == "Community")
            {
                <MudSelect @bind-Value="_visibility" T="string" Label="Visibility">
                    <MudSelectItem Value="@("Public")">Public</MudSelectItem>
                    <MudSelectItem Value="@("Private")">Private</MudSelectItem>
                    <MudSelectItem Value="@("Unlisted")">Unlisted</MudSelectItem>
                </MudSelect>

                <MudSelect @bind-Value="_timezone" T="string" Label="Community Timezone"
                           HelperText="Controls how dates and times display for members of this community">
                    <MudSelectItem Value="@("UTC")">UTC</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---americas")">─── Americas ───</MudSelectItem>
                    <MudSelectItem Value="@("America/New_York")">Eastern Time (New York)</MudSelectItem>
                    <MudSelectItem Value="@("America/Chicago")">Central Time (Chicago)</MudSelectItem>
                    <MudSelectItem Value="@("America/Denver")">Mountain Time (Denver)</MudSelectItem>
                    <MudSelectItem Value="@("America/Los_Angeles")">Pacific Time (Los Angeles)</MudSelectItem>
                    <MudSelectItem Value="@("America/Anchorage")">Alaska Time (Anchorage)</MudSelectItem>
                    <MudSelectItem Value="@("Pacific/Honolulu")">Hawaii (Honolulu)</MudSelectItem>
                    <MudSelectItem Value="@("America/Toronto")">Eastern Time (Toronto)</MudSelectItem>
                    <MudSelectItem Value="@("America/Vancouver")">Pacific Time (Vancouver)</MudSelectItem>
                    <MudSelectItem Value="@("America/Sao_Paulo")">Brasília (São Paulo)</MudSelectItem>
                    <MudSelectItem Value="@("America/Argentina/Buenos_Aires")">Argentina (Buenos Aires)</MudSelectItem>
                    <MudSelectItem Value="@("America/Mexico_City")">Central Time (Mexico City)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---europe")">─── Europe ───</MudSelectItem>
                    <MudSelectItem Value="@("Europe/London")">GMT/BST (London)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Paris")">CET (Paris, Berlin, Rome)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Helsinki")">EET (Helsinki, Kyiv)</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Moscow")">Moscow Time</MudSelectItem>
                    <MudSelectItem Value="@("Europe/Oslo")">CET (Oslo, Stockholm, Copenhagen)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---asia")">─── Asia &amp; Pacific ───</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Dubai")">GST (Dubai)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Kolkata")">IST (India)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Bangkok")">ICT (Bangkok, Jakarta)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Singapore")">SGT (Singapore, Kuala Lumpur)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Shanghai")">CST (China, Hong Kong)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Tokyo")">JST (Tokyo)</MudSelectItem>
                    <MudSelectItem Value="@("Asia/Seoul")">KST (Seoul)</MudSelectItem>
                    <MudSelectItem Value="@("Australia/Sydney")">AEDT (Sydney)</MudSelectItem>
                    <MudSelectItem Value="@("Pacific/Auckland")">NZDT (Auckland)</MudSelectItem>
                    <MudSelectItem Disabled="true" Value="@("---africa")">─── Africa ───</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Johannesburg")">SAST (Johannesburg)</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Cairo")">EET (Cairo)</MudSelectItem>
                    <MudSelectItem Value="@("Africa/Lagos")">WAT (Lagos)</MudSelectItem>
                </MudSelect>
            }

            @if (Scope?.ScopeType == "Space")
            {
                <MudSelect @bind-Value="_defaultSort" T="string" Label="Default Sort">
                    <MudSelectItem Value="@("latest")">Latest Activity</MudSelectItem>
                    <MudSelectItem Value="@("newest")">Newest First</MudSelectItem>
                    <MudSelectItem Value="@("oldest")">Oldest First</MudSelectItem>
                </MudSelect>
            }

            @* Discussion type checkboxes — shown for Community, Hub, and Space *@
            @if (Scope?.ScopeType is "Community" or "Hub" or "Space")
            {
                <div>
                    <MudText Typo="Typo.subtitle2" Class="mb-2">Allowed Discussion Types</MudText>
                    @if (Scope.ScopeType != "Community")
                    {
                        <MudText Typo="Typo.caption" Color="Color.Default" Class="mb-2"
                                 Style="opacity: 0.6;">
                            Types disabled by the parent @(_parentScopeLabel) cannot be enabled here.
                        </MudText>
                    }
                    <MudStack Spacing="2">
                        @foreach (var type in Enum.GetValues<DiscussionTypeEnum>())
                        {
                            var t = type;
                            var blockedByParent = _parentAllowedTypes.Count > 0 && !_parentAllowedTypes.Contains(t);
                            <MudTooltip Text="@(blockedByParent ? $"Disabled by {_parentScopeLabel}" : "")"
                                        Disabled="@(!blockedByParent)">
                                <MudCheckBox T="bool"
                                    Value="@(_allowedTypes.Contains(t))"
                                    ValueChanged="@(v => ToggleType(t, v))"
                                    Label="@t.ToString()"
                                    Disabled="@blockedByParent" />
                            </MudTooltip>
                        }
                    </MudStack>
                    @if (_typeError is not null)
                    {
                        <MudText Color="Color.Error" Class="mt-1">@_typeError</MudText>
                    }
                </div>
            }

            <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@SaveSettings"
                       Disabled="@_saving">
                @if (_saving) { <MudProgressCircular Size="Size.Small" Indeterminate="true" Class="mr-2" /> }
                Save Settings
            </MudButton>

            @if (_saved)
            {
                <MudAlert Severity="Severity.Success">Settings saved</MudAlert>
            }
            @if (_saveError is not null)
            {
                <MudAlert Severity="Severity.Error">@_saveError</MudAlert>
            }
        </MudStack>
    }
</MudPaper>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _saved;
    private string _name = "";
    private string _description = "";
    private string _visibility = "Public";
    private string _defaultSort = "latest";
    private string _timezone = "UTC";
    private HashSet<DiscussionTypeEnum> _allowedTypes = [DiscussionTypeEnum.Standard];
    private HashSet<DiscussionTypeEnum> _parentAllowedTypes = [];
    private string _parentScopeLabel = "";
    private string? _loadError;
    private string? _saveError;
    private string? _typeError;

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        _loading = true;
        _loadError = null;

        if (Scope.ScopeType == "Space")
        {
            try
            {
                var response = await ManageClient.GetSpaceSettingsAsync(
                    new GetSpaceSettingsRequest { SpacePublicId = Scope.ScopePublicId });

                _name = response.Name;
                _description = response.HasDescription ? response.Description : "";
                _allowedTypes = response.AllowedDiscussionTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.AllowedDiscussionTypes.Select(t => (DiscussionTypeEnum)t))
                    : new HashSet<DiscussionTypeEnum>(Enum.GetValues<DiscussionTypeEnum>());
                _parentAllowedTypes = response.ParentAllowedTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.ParentAllowedTypes.Select(t => (DiscussionTypeEnum)t))
                    : [];
                _parentScopeLabel = "hub";
            }
            catch
            {
                _loadError = "Failed to load space settings.";
            }
        }
        else if (Scope.ScopeType == "Hub")
        {
            try
            {
                var response = await ManageClient.GetHubSettingsAsync(
                    new GetHubSettingsRequest { HubPublicId = Scope.ScopePublicId });

                _name = response.Name;
                _description = response.HasDescription ? response.Description : "";
                _allowedTypes = response.AllowedDiscussionTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.AllowedDiscussionTypes.Select(t => (DiscussionTypeEnum)t))
                    : new HashSet<DiscussionTypeEnum>(Enum.GetValues<DiscussionTypeEnum>());
                _parentAllowedTypes = response.ParentAllowedTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.ParentAllowedTypes.Select(t => (DiscussionTypeEnum)t))
                    : [];
                _parentScopeLabel = "community";
            }
            catch
            {
                _loadError = "Failed to load hub settings.";
            }
        }
        else if (Scope.ScopeType == "Community")
        {
            try
            {
                var response = await ManageClient.GetCommunitySettingsAsync(
                    new GetCommunitySettingsRequest { CommunityPublicId = Scope.ScopePublicId });

                _name = response.Name;
                _description = response.HasDescription ? response.Description : "";
                _timezone = response.HasTimezone ? response.Timezone : "UTC";
                _allowedTypes = response.AllowedDiscussionTypes.Count > 0
                    ? new HashSet<DiscussionTypeEnum>(response.AllowedDiscussionTypes.Select(t => (DiscussionTypeEnum)t))
                    : new HashSet<DiscussionTypeEnum>(Enum.GetValues<DiscussionTypeEnum>());
                _parentAllowedTypes = []; // Community has no parent
                _parentScopeLabel = "";
            }
            catch
            {
                _loadError = "Failed to load community settings.";
            }
        }
        else
        {
            _name = Scope.ScopeName;
            _description = "";
        }

        _loading = false;
    }

    private void ToggleType(DiscussionTypeEnum type, bool enabled)
    {
        _typeError = null;

        if (enabled)
        {
            _allowedTypes.Add(type);
        }
        else if (_allowedTypes.Count > 1)
        {
            _allowedTypes.Remove(type);
        }
        else
        {
            _typeError = "At least one discussion type must be enabled.";
        }
    }

    private async Task SaveSettings()
    {
        _saving = true;
        _saved = false;
        _saveError = null;

        if (Scope?.ScopeType == "Space")
        {
            try
            {
                var request = new Snakk.Protos.Manage.UpdateSpaceSettingsRequest
                {
                    SpacePublicId = Scope.ScopePublicId,
                    Name = _name,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description
                };

                request.AllowedDiscussionTypes.AddRange(_allowedTypes.Select(t => (int)t));

                var response = await ManageClient.UpdateSpaceSettingsAsync(request);

                if (response.Success)
                    _saved = true;
                else
                    _saveError = response.HasErrorMessage ? response.ErrorMessage : "Failed to save settings. Please try again.";
            }
            catch
            {
                _saveError = "Failed to save settings. Please try again.";
            }
        }
        else if (Scope?.ScopeType == "Hub")
        {
            try
            {
                var request = new Snakk.Protos.Manage.UpdateHubSettingsRequest
                {
                    HubPublicId = Scope.ScopePublicId,
                    Name = _name,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description
                };

                request.AllowedDiscussionTypes.AddRange(_allowedTypes.Select(t => (int)t));

                var response = await ManageClient.UpdateHubSettingsAsync(request);

                if (response.Success)
                    _saved = true;
                else
                    _saveError = response.HasErrorMessage ? response.ErrorMessage : "Failed to save settings. Please try again.";
            }
            catch
            {
                _saveError = "Failed to save settings. Please try again.";
            }
        }
        else if (Scope?.ScopeType == "Community")
        {
            try
            {
                var request = new Snakk.Protos.Manage.UpdateCommunitySettingsRequest
                {
                    CommunityPublicId = Scope.ScopePublicId,
                    Name = _name,
                    Description = string.IsNullOrWhiteSpace(_description) ? null : _description,
                    Timezone = string.IsNullOrWhiteSpace(_timezone) ? null : _timezone
                };

                request.AllowedDiscussionTypes.AddRange(_allowedTypes.Select(t => (int)t));

                var response = await ManageClient.UpdateCommunitySettingsAsync(request);

                if (response.Success)
                    _saved = true;
                else
                    _saveError = response.HasErrorMessage ? response.ErrorMessage : "Failed to save settings. Please try again.";
            }
            catch
            {
                _saveError = "Failed to save settings. Please try again.";
            }
        }

        _saving = false;
    }
}
