@using Snakk.Protos.Manage
@using Snakk.Admin.Services
@inject ManageService.ManageServiceClient ManageClient
@inject AdminTimezoneService Tz

<MudPaper Class="pa-4 d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Moderation Log</MudText>
    <MudSelect Value="_actionFilter" T="string" Style="max-width: 200px;"
               ValueChanged="@(async (string v) => { _actionFilter = v; await OnFilterChanged(); })">
        <MudSelectItem Value="@("all")">All Actions</MudSelectItem>
        <MudSelectItem Value="@("DeletePost")">Delete Post</MudSelectItem>
        <MudSelectItem Value="@("DeleteDiscussion")">Delete Discussion</MudSelectItem>
        <MudSelectItem Value="@("BanUser")">Ban User</MudSelectItem>
        <MudSelectItem Value="@("UnbanUser")">Unban User</MudSelectItem>
        <MudSelectItem Value="@("LockDiscussion")">Lock Discussion</MudSelectItem>
        <MudSelectItem Value="@("ResolveReport")">Resolve Report</MudSelectItem>
        <MudSelectItem Value="@("DismissReport")">Dismiss Report</MudSelectItem>
        <MudSelectItem Value="@("AssignRole")">Assign Role</MudSelectItem>
        <MudSelectItem Value="@("RevokeRole")">Revoke Role</MudSelectItem>
    </MudSelect>
</MudPaper>

<MudPaper Class="pa-4">
    @if (_loading)
    {
        <MudProgressCircular Indeterminate="true" />
    }
    else if (_entries.Count == 0)
    {
        <MudText>No moderation log entries found for this scope.</MudText>
    }
    else
    {
        <MudSimpleTable Dense="true" Hover="true" Striped="true">
            <thead>
                <tr><th>Action</th><th>Moderator</th><th>Target</th><th>Reason</th><th>When</th></tr>
            </thead>
            <tbody>
                @foreach (var entry in _entries)
                {
                    <tr>
                        <td>@entry.ActionType</td>
                        <td>@entry.ActorDisplayName</td>
                        <td>@entry.TargetName</td>
                        <td>@entry.Reason</td>
                        <td>@Tz.FormatDateTime(entry.CreatedAtTicks)</td>
                    </tr>
                }
            </tbody>
        </MudSimpleTable>
    }
</MudPaper>

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private string _actionFilter = "all";
    private bool _loading = true;
    private List<ModerationLogItem> _entries = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        await Tz.EnsureInitializedAsync();
        await LoadLog();
    }

    private async Task OnFilterChanged() => await LoadLog();

    private async Task LoadLog()
    {
        _loading = true;

        try
        {
            var request = new GetModerationLogRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId,
                Offset = 0,
                PageSize = 100
            };

            if (_actionFilter != "all")
                request.ActionFilter = _actionFilter;

            var response = await ManageClient.GetModerationLogAsync(request, deadline: DateTime.UtcNow.AddSeconds(10));
            _entries = response.Entries.ToList();
        }
        catch
        {
            _entries = new();
        }

        _loading = false;
    }
}
