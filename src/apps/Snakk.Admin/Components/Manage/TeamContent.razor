@using Snakk.Protos.Manage
@using Snakk.Admin.Services
@inject ManageService.ManageServiceClient ManageClient
@inject AdminTimezoneService Tz

<MudPaper Class="pa-4 d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Team</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => _showAddMod = true)" Disabled="@_saving">
        Add Moderator
    </MudButton>
</MudPaper>

@if (_showAddMod)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Add Moderator</MudText>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_newModUsername" Label="Username" Placeholder="Exact display name..." />
            <MudSelect @bind-Value="_newModRoleType" T="string" Label="Role">
                @if (Scope?.ScopeType == "Community")
                {
                    <MudSelectItem Value="@("CommunityAdmin")">Community Admin</MudSelectItem>
                    <MudSelectItem Value="@("CommunityMod")">Community Moderator</MudSelectItem>
                }
                else if (Scope?.ScopeType == "Hub")
                {
                    <MudSelectItem Value="@("HubMod")">Hub Moderator</MudSelectItem>
                }
                else if (Scope?.ScopeType == "Space")
                {
                    <MudSelectItem Value="@("SpaceMod")">Space Moderator</MudSelectItem>
                }
            </MudSelect>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@AddModerator" Disabled="@_saving">Add</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => _showAddMod = false)">Cancel</MudButton>
            </MudStack>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Color="Color.Error">@_errorMessage</MudText>
            }
        </MudStack>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @foreach (var group in _inheritedGroups)
    {
        <MudPaper Class="pa-4 mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Secondary" />
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    Inherited from @group.SourceScopeType: @group.SourceScopeName
                </MudText>
            </MudStack>
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr><th>Name</th><th>Role</th><th>Since</th></tr>
                </thead>
                <tbody>
                    @foreach (var member in group.Members)
                    {
                        <tr>
                            <td>@member.UserDisplayName</td>
                            <td>@member.RoleType</td>
                            <td>@Tz.FormatDate(member.AssignedAtTicks)</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">Current Moderators</MudText>
        @if (_members.Count == 0)
        {
            <MudText>No moderators assigned to this scope.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr><th>Name</th><th>Role</th><th>Since</th><th>Actions</th></tr>
                </thead>
                <tbody>
                    @foreach (var member in _members)
                    {
                        <tr>
                            <td>@member.UserDisplayName</td>
                            <td>@member.RoleType</td>
                            <td>@Tz.FormatDate(member.AssignedAtTicks)</td>
                            <td>
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           OnClick="@(() => RemoveModerator(member.RolePublicId))" Disabled="@_saving">
                                    Remove
                                </MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _showAddMod;
    private string _newModUsername = "";
    private string _newModRoleType = "";
    private string? _errorMessage;
    private List<TeamMemberItem> _members = new();
    private List<InheritedTeamGroup> _inheritedGroups = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;

        await Tz.EnsureInitializedAsync();

        _newModRoleType = Scope.ScopeType switch
        {
            "Community" => "CommunityMod",
            "Hub" => "HubMod",
            "Space" => "SpaceMod",
            _ => ""
        };

        await LoadTeam();
    }

    private async Task LoadTeam()
    {
        _loading = true;

        try
        {
            var response = await ManageClient.GetTeamAsync(new GetTeamRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            _members = response.Members.ToList();
            _inheritedGroups = response.InheritedGroups.ToList();
        }
        catch
        {
            _members = new();
            _inheritedGroups = new();
        }

        _loading = false;
    }

    private async Task AddModerator()
    {
        if (string.IsNullOrWhiteSpace(_newModUsername) || string.IsNullOrEmpty(_newModRoleType)) return;

        _saving = true;
        _errorMessage = null;

        try
        {
            var result = await ManageClient.AddTeamMemberAsync(new AddTeamMemberRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId,
                TargetUsername = _newModUsername.Trim(),
                RoleType = _newModRoleType
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            if (!result.Success)
            {
                _errorMessage = result.HasErrorMessage ? result.ErrorMessage : "Failed to add moderator";
                _saving = false;
                return;
            }

            _showAddMod = false;
            _newModUsername = "";
            await LoadTeam();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RemoveModerator(string rolePublicId)
    {
        _saving = true;

        try
        {
            await ManageClient.RemoveTeamMemberAsync(new RemoveTeamMemberRequest
            {
                RolePublicId = rolePublicId
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            await LoadTeam();
        }
        finally
        {
            _saving = false;
        }
    }
}
