@using Snakk.Protos.Manage
@inject ManageService.ManageServiceClient ManageClient

<MudPaper Class="pa-4 mb-4">
    <MudText Typo="Typo.h5" Class="mb-1">Global Broadcast</MudText>
    <MudText Typo="Typo.body2" Style="opacity: 0.7;" Class="mb-4">
        Send a realtime message to all connected users. Use with care — every browser tab receives this instantly.
    </MudText>

    <MudStack Spacing="3">
        <MudSelect @bind-Value="_eventType" Label="Event Type">
            <MudSelectItem Value="@("global-announcement")">Announcement</MudSelectItem>
            <MudSelectItem Value="@("server-shutdown")">Server Shutdown Warning</MudSelectItem>
            <MudSelectItem Value="@("global-alert")">Alert</MudSelectItem>
        </MudSelect>

        <MudTextField @bind-Value="_message"
                      Label="Message"
                      Lines="3"
                      Placeholder="e.g. The server will restart in 5 minutes for maintenance." />

        <MudButton Variant="Variant.Filled"
                   Color="Color.Warning"
                   StartIcon="@Icons.Material.Filled.Campaign"
                   OnClick="SendAsync"
                   Disabled="@(_sending || string.IsNullOrWhiteSpace(_message))">
            Send to All Users
        </MudButton>

        @if (!string.IsNullOrEmpty(_result))
        {
            <MudAlert Severity="@_severity" Dense="true">@_result</MudAlert>
        }
    </MudStack>
</MudPaper>

@code {
    private string _eventType = "global-announcement";
    private string _message = "";
    private bool _sending;
    private string _result = "";
    private Severity _severity = Severity.Success;

    private async Task SendAsync()
    {
        if (string.IsNullOrWhiteSpace(_message)) return;

        _sending = true;
        _result = "";

        try
        {
            await ManageClient.SendGlobalAnnouncementAsync(new SendGlobalAnnouncementRequest
            {
                EventType = _eventType,
                Message = _message
            });

            _result = "Broadcast sent successfully.";
            _severity = Severity.Success;
            _message = "";
        }
        catch (Exception ex)
        {
            _result = $"Failed to send broadcast: {ex.Message}";
            _severity = Severity.Error;
        }
        finally
        {
            _sending = false;
        }
    }
}
