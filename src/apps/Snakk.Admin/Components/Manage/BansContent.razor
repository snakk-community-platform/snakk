@using Snakk.Protos.Manage
@inject ManageService.ManageServiceClient ManageClient

<MudPaper Class="pa-4 d-flex justify-space-between align-center mb-4">
    <MudText Typo="Typo.h5">Bans</MudText>
    <MudButton Variant="Variant.Filled" Color="Color.Primary" StartIcon="@Icons.Material.Filled.Add"
               OnClick="@(() => _showNewBan = true)" Disabled="@_saving">
        New Ban
    </MudButton>
</MudPaper>

@if (_showNewBan)
{
    <MudPaper Class="pa-4 mb-4">
        <MudText Typo="Typo.h6" Class="mb-3">Create New Ban</MudText>
        <MudStack Spacing="3">
            <MudTextField @bind-Value="_newBanUsername" Label="Username" Placeholder="Exact display name..." />
            <MudSelect @bind-Value="_newBanType" T="string" Label="Ban Type">
                <MudSelectItem Value="@("ReadWrite")">Full Ban (Read + Write)</MudSelectItem>
                <MudSelectItem Value="@("WriteOnly")">Write Only (can still read)</MudSelectItem>
            </MudSelect>
            <MudTextField @bind-Value="_newBanReason" Label="Reason" Lines="3" />
            <MudSelect @bind-Value="_newBanDuration" T="string" Label="Duration">
                <MudSelectItem Value="@("1h")">1 Hour</MudSelectItem>
                <MudSelectItem Value="@("24h")">24 Hours</MudSelectItem>
                <MudSelectItem Value="@("7d")">7 Days</MudSelectItem>
                <MudSelectItem Value="@("30d")">30 Days</MudSelectItem>
                <MudSelectItem Value="@("permanent")">Permanent</MudSelectItem>
            </MudSelect>
            <MudStack Row="true" Spacing="2">
                <MudButton Variant="Variant.Filled" Color="Color.Primary" OnClick="@CreateBan" Disabled="@_saving">Ban User</MudButton>
                <MudButton Variant="Variant.Text" OnClick="@(() => _showNewBan = false)">Cancel</MudButton>
            </MudStack>
            @if (!string.IsNullOrEmpty(_errorMessage))
            {
                <MudText Color="Color.Error">@_errorMessage</MudText>
            }
        </MudStack>
    </MudPaper>
}

@if (_loading)
{
    <MudProgressCircular Indeterminate="true" />
}
else
{
    @foreach (var group in _inheritedGroups)
    {
        <MudPaper Class="pa-4 mb-3">
            <MudStack Row="true" AlignItems="AlignItems.Center" Spacing="1" Class="mb-2">
                <MudIcon Icon="@Icons.Material.Filled.AccountTree" Size="Size.Small" Color="Color.Secondary" />
                <MudText Typo="Typo.subtitle2" Color="Color.Secondary">
                    Inherited from @group.SourceScopeType: @group.SourceScopeName
                </MudText>
            </MudStack>
            <MudSimpleTable Dense="true" Hover="true">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Type</th>
                        <th>Reason</th>
                        <th>Banned By</th>
                        <th>Banned At</th>
                        <th>Expires</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ban in group.Bans)
                    {
                        <tr>
                            <td>@ban.UserDisplayName</td>
                            <td>@ban.BanType</td>
                            <td>@ban.Reason</td>
                            <td>@ban.BannedByDisplayName</td>
                            <td>@(new DateTime(ban.BannedAtTicks, DateTimeKind.Utc).ToString("g"))</td>
                            <td>@(ban.HasExpiresAtTicks ? new DateTime(ban.ExpiresAtTicks, DateTimeKind.Utc).ToString("g") : "Permanent")</td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        </MudPaper>
    }

    <MudPaper Class="pa-4">
        <MudText Typo="Typo.h6" Class="mb-2">Active Bans</MudText>
        @if (_bans.Count == 0)
        {
            <MudText>No active bans in this scope.</MudText>
        }
        else
        {
            <MudSimpleTable Dense="true" Hover="true" Striped="true">
                <thead>
                    <tr>
                        <th>User</th>
                        <th>Type</th>
                        <th>Reason</th>
                        <th>Banned By</th>
                        <th>Banned At</th>
                        <th>Expires</th>
                        <th>Actions</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var ban in _bans)
                    {
                        <tr>
                            <td>@ban.UserDisplayName</td>
                            <td>@ban.BanType</td>
                            <td>@ban.Reason</td>
                            <td>@ban.BannedByDisplayName</td>
                            <td>@(new DateTime(ban.BannedAtTicks, DateTimeKind.Utc).ToString("g"))</td>
                            <td>@(ban.HasExpiresAtTicks ? new DateTime(ban.ExpiresAtTicks, DateTimeKind.Utc).ToString("g") : "Permanent")</td>
                            <td>
                                <MudButton Size="Size.Small" Variant="Variant.Text"
                                           OnClick="@(() => RevokeBan(ban.PublicId))" Disabled="@_saving">
                                    Revoke
                                </MudButton>
                            </td>
                        </tr>
                    }
                </tbody>
            </MudSimpleTable>
        }
    </MudPaper>
}

@code {
    [CascadingParameter]
    public ManageScopeDto? Scope { get; set; }

    private bool _loading = true;
    private bool _saving;
    private bool _showNewBan;
    private string _newBanUsername = "";
    private string _newBanType = "ReadWrite";
    private string _newBanReason = "";
    private string _newBanDuration = "24h";
    private string? _errorMessage;
    private List<BanItem> _bans = new();
    private List<InheritedBanGroup> _inheritedGroups = new();

    protected override async Task OnParametersSetAsync()
    {
        if (Scope == null) return;
        await LoadBans();
    }

    private async Task LoadBans()
    {
        _loading = true;

        try
        {
            var response = await ManageClient.GetBansAsync(new GetBansRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            _bans = response.Bans.ToList();
            _inheritedGroups = response.InheritedGroups.ToList();
        }
        catch
        {
            _bans = new();
            _inheritedGroups = new();
        }

        _loading = false;
    }

    private async Task CreateBan()
    {
        if (string.IsNullOrWhiteSpace(_newBanUsername)) return;

        _saving = true;
        _errorMessage = null;

        try
        {
            var request = new CreateBanRequest
            {
                ScopeType = Scope!.ScopeType,
                ScopePublicId = Scope.ScopePublicId,
                TargetUsername = _newBanUsername.Trim(),
                BanType = _newBanType,
                Reason = _newBanReason.Trim()
            };

            if (_newBanDuration != "permanent")
            {
                var expiresAt = DateTime.UtcNow + _newBanDuration switch
                {
                    "1h" => TimeSpan.FromHours(1),
                    "24h" => TimeSpan.FromHours(24),
                    "7d" => TimeSpan.FromDays(7),
                    "30d" => TimeSpan.FromDays(30),
                    _ => TimeSpan.FromHours(24)
                };
                request.ExpiresAtTicks = expiresAt.Ticks;
            }

            var result = await ManageClient.CreateBanAsync(request, deadline: DateTime.UtcNow.AddSeconds(10));

            if (!result.Success)
            {
                _errorMessage = result.HasErrorMessage ? result.ErrorMessage : "Failed to create ban";
                _saving = false;
                return;
            }

            _showNewBan = false;
            _newBanUsername = "";
            _newBanReason = "";
            _newBanDuration = "24h";
            _newBanType = "ReadWrite";
            await LoadBans();
        }
        finally
        {
            _saving = false;
        }
    }

    private async Task RevokeBan(string banPublicId)
    {
        _saving = true;

        try
        {
            await ManageClient.RevokeBanAsync(new RevokeBanRequest
            {
                BanPublicId = banPublicId
            }, deadline: DateTime.UtcNow.AddSeconds(10));

            await LoadBans();
        }
        finally
        {
            _saving = false;
        }
    }
}
