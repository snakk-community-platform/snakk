@using Snakk.Admin.Components
@using Snakk.Admin.Services
@using MudBlazor
@inject CircuitTokenProvider TokenProvider
@inject IHttpContextAccessor HttpContextAccessor
@inject AdminThemeService ThemeService
@implements IDisposable

<MudThemeProvider Theme="_theme" IsDarkMode="@ThemeService.IsDarkMode" />
<MudPopoverProvider />
<MudDialogProvider />
<MudSnackbarProvider />

<CascadingAuthenticationState>
    <Router AppAssembly="@typeof(App).Assembly">
        <Found Context="routeData">
            <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(Layout.MainLayout)">
                <NotAuthorized>
                    @if (context.User.Identity?.IsAuthenticated != true)
                    {
                        <RedirectToLogin />
                    }
                    else
                    {
                        <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
                            <MudIcon Icon="@Icons.Material.Filled.Lock" Size="Size.Large" Color="Color.Error" />
                            <MudText Typo="Typo.h5" Class="mt-4">Access Denied</MudText>
                            <MudText Class="mt-2 mud-text-secondary">You do not have permission to access this page.</MudText>
                            <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6">Go to Dashboard</MudButton>
                        </MudContainer>
                    }
                </NotAuthorized>
            </AuthorizeRouteView>
            <FocusOnNavigate RouteData="@routeData" Selector="h1" />
        </Found>
        <NotFound>
            <PageTitle>Not found</PageTitle>
            <LayoutView Layout="@typeof(Layout.MainLayout)">
                <MudContainer MaxWidth="MaxWidth.Small" Class="mt-16 text-center">
                    <MudIcon Icon="@Icons.Material.Filled.SearchOff" Size="Size.Large" Color="Color.Default" />
                    <MudText Typo="Typo.h5" Class="mt-4">Page Not Found</MudText>
                    <MudButton Href="/" Variant="Variant.Filled" Color="Color.Primary" Class="mt-6">Go to Dashboard</MudButton>
                </MudContainer>
            </LayoutView>
        </NotFound>
    </Router>
</CascadingAuthenticationState>

@code {
    private static readonly MudTheme _theme = new()
    {
        PaletteLight = new PaletteLight
        {
            Primary = "#0078d4",
            PrimaryContrastText = "#ffffff",
            Secondary = "#6b7280",
            AppbarBackground = "#ffffff",
            AppbarText = "#1c1c1e",
            DrawerBackground = "#f6f8fa",
            DrawerText = "#1c1c1e",
            DrawerIcon = "#6b7280",
            Surface = "#ffffff",
            Background = "#f0f2f5",
            TextPrimary = "#1c1c1e",
            TextSecondary = "#6b7280",
            LinesDefault = "#e5e7eb",
            Divider = "#e5e7eb",
        },
        PaletteDark = new PaletteDark
        {
            Primary = "#58a6ff",
            PrimaryContrastText = "#0d1117",
            Secondary = "#8b949e",
            AppbarBackground = "#161b22",
            AppbarText = "#e6edf3",
            DrawerBackground = "#0d1117",
            DrawerText = "#c9d1d9",
            DrawerIcon = "#8b949e",
            Surface = "#161b22",
            Background = "#0d1117",
            TextPrimary = "#e6edf3",
            TextSecondary = "#8b949e",
            LinesDefault = "#30363d",
            Divider = "#21262d",
            ActionDefault = "#8b949e",
            TableHover = "rgba(255,255,255,0.04)",
            TableLines = "#21262d",
            OverlayDark = "rgba(0,0,0,0.7)",
        },
        Typography = new Typography
        {
            Default = new DefaultTypography { FontFamily = ["Inter", "-apple-system", "BlinkMacSystemFont", "Segoe UI", "sans-serif"] },
            H4 = new H4Typography { FontWeight = "600", FontSize = "1.5rem" },
            H5 = new H5Typography { FontWeight = "600" },
            H6 = new H6Typography { FontWeight = "600" },
            Subtitle1 = new Subtitle1Typography { FontWeight = "600" },
        },
        LayoutProperties = new LayoutProperties { DefaultBorderRadius = "6px" },
    };

    protected override void OnInitialized()
    {
        ThemeService.OnChanged += StateHasChanged;

        var httpContext = HttpContextAccessor.HttpContext;
        if (httpContext is null) return;

        var token = httpContext.Request.Cookies[".Snakk.Auth"];
        var refreshToken = httpContext.Request.Cookies[".Snakk.Auth.Refresh"];

        if (!string.IsNullOrEmpty(token))
            TokenProvider.Token = token;
        if (!string.IsNullOrEmpty(refreshToken))
            TokenProvider.RefreshToken = refreshToken;
    }

    public void Dispose() => ThemeService.OnChanged -= StateHasChanged;
}
