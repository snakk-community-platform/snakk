{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "Snakk.Admin": "Debug"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "Enabled": true,
    "Tracing": { "Enabled": true, "SamplingRatio": 1.0 },
    "Metrics": { "Enabled": true },
    "OtlpLogs": { "Enabled": true },
    "Profiling": { "Enabled": true }
  },
  "SnakkApi": {
    "BaseUrl": "https://localhost:17101"
  },
  "FileStorage": {
    "BasePath": "c:\\Snakk\\storage"
  },
  "Jwt": {
    "SecretKey": "your-secret-key-min-32-characters-change-in-production",
    "Issuer": "Snakk",
    "Audience": "Snakk"
  }
}
