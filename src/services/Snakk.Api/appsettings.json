{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "localhost",
  "Cors": {
    "AllowedOrigins": "https://localhost:17110;https://localhost:17112;https://localhost:17111"
  },
  "WebClientUrl": "https://localhost:17110",
  "ConnectionStrings": {
    "DbConnection": "Host=localhost;Database=snakk;Username=snakk;Password=YOUR_PASSWORD_HERE"
  },
  "Jwt": {
    "SecretKey": "your-secret-key-min-32-characters-change-in-production",
    "Issuer": "Snakk",
    "Audience": "Snakk",
    "ExpirationMinutes": 15
  },
  "Authentication": {
    "Google": {
      "ClientId": "YOUR_GOOGLE_CLIENT_ID",
      "ClientSecret": "YOUR_GOOGLE_CLIENT_SECRET"
    },
    "GitHub": {
      "ClientId": "YOUR_GITHUB_CLIENT_ID",
      "ClientSecret": "YOUR_GITHUB_CLIENT_SECRET"
    },
    "Discord": {
      "ClientId": "YOUR_DISCORD_CLIENT_ID",
      "ClientSecret": "YOUR_DISCORD_CLIENT_SECRET"
    }
  },
  "FileStorage": {
    "BasePath": "c:\\Snakk\\storage",
    "PublicUrlBase": "/avatars"
  },
  "AvatarSettings": {
    "DefaultSize": 80,
    "GenerateOnStartup": true,
    "StartupGenerationTimeout": 300000
  },
  "Realtime": {
    "BaseUrl": "https://localhost:17101",
    "ApiKey": "DEV_SECRET_KEY_CHANGE_IN_PRODUCTION"
  },
  "Trending": {
    "LookbackHours": 24
  },
  "PostFlags": {
    "NecroDays": 30,
    "MilestoneThresholds": [100, 500, 1000, 2500, 5000, 10000, 20000, 30000, 40000, 50000]
  }
}
