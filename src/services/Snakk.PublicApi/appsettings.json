{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Observability": {
    "Enabled": true,
    "Tracing": { "Enabled": true, "SamplingRatio": 1.0 },
    "Metrics": { "Enabled": true },
    "OtlpLogs": { "Enabled": true },
    "Profiling": { "Enabled": true }
  },
  "ApiBaseUrl": "https://localhost:17101",
  "Auth": {
    "BaseUrl": "https://localhost:17111/auth"
  },
  "EnableRateLimiting": false
}
