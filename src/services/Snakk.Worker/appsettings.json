{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "ConnectionStrings": {
    "DbConnection": "Host=localhost;Database=snakk;Username=snakk;Password=YOUR_PASSWORD_HERE;Max Auto Prepare=20;Auto Prepare Min Usages=2"
  },
  "FileStorage": {
    "BasePath": "c:\\Snakk\\storage",
    "PublicUrlBase": "/"
  },
  "AvatarSettings": {
    "DefaultSize": 80,
    "GenerateOnStartup": false,
    "StartupGenerationTimeout": 300000
  },
  "Realtime": {
    "BaseUrl": "http://localhost:17103",
    "ApiKey": "dev-secret-key-change-in-production"
  },
  "Activity": {
    "SnapshotIntervalMinutes": 60
  },
  "Trending": {
    "LookbackHours": 8760,
    "SpacesLookbackDays": 7,
    "ContributorsLookbackDays": 7,
    "TargetPostsInWindow": 500,
    "TargetDiscussionsInWindow": 100,
    "MinWindowHours": 6,
    "MaxWindowDays": 30,
    "BufferMultiplier": 1.15
  },
  "Features": {
    "AdaptiveVolumeWindowEnabled": true
  }
}
